              "items": [
                {
                  "text": "1.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nga naba ne siloleelela,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.9",
            "verseOrgIds": [
              "DAN.7.9"
            ]
          }
        }
