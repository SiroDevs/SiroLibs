              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.7",
            "verseOrgIds": [
              "DAN.7.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.3"
              },
              "items": [
                {
                  "text": "Lif. 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "13.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enyuma owa kano, nabona mu malola mu silo, nabona esaang'i eya khane. Yaba eye liuka, eye khuriisia lukali lundi eye kamaani kamakali po. Yaba ne kameeno ke sichuuma niko yarumikhira khulia ne khunyanyakamo biindu ne ebitabulaka mu bitonyi. Bibiasikala yabiswalakilila ne bikele biayo. Yaukhana ne chisaang'i chichiindi che bweeni choosi, mala yaba ne chinjika ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.7",
            "verseOrgIds": [
              "DAN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "Lif. 13.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nga ne naloleelela chinjika echo, nabona lulwiika luluundi lukeekhe lwameelela akari we chichiindi ekhumi echo. Nio lunyoole bubweyaangu bwe khuchoa, bafunakila mu sisina chinjika che bweeni chitaru. Lulwiika luno lwaba ne chimoni nga cho mundu. Lwaba lundi ne kumunwa mala kumunwa okwo kwalomalomanga mu ngila eye sileka.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.8",
            "verseOrgIds": [
              "DAN.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khubuna khwe chisaang'i echo",
          "type": "text"
        }
      ]
    },
