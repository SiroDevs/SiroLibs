          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi nenya khumanya ke chinjika ekhumi khu murwe kwayo ne lulwiika luluundi lulwamela ne lufunaka chinjika chitaru, lwaba ne chimoni ne kumunwa kwe khukhwibonia mu kisuunia. Mala lwalolekhana khukhila chichasie.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.20",
            "verseOrgIds": [
              "DAN.7.20"
            ]
          }
        }
