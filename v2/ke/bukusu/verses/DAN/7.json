    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachiililila khuloleelela sikila naulila kamakhuwa kamakali niko lulwiika olwo lwalomalomaanga ne lwibonia. Ne nga naloleelela, beera esaang'i eyo, kumubili kwayo kwonakibwa mala bakuaana kwosibwe ne kumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisaang'i chichiindi echo chanuulwa bunyali bwacho, ne kakhali bachilekha chichiililile khumenya khu siise ne chindaalo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
    },
