    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bumiinikhi bwe bataambi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we siise babaandu bakali, be siseecha nende be siikhasi, barakikha khukhwilila khu Bayaudi basiaabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.1",
            "verseOrgIds": [
              "NEH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balala baloma bali, “Khuli ne lisaaye likali, khwenya biakhulia bikhuyeeta efwe khumenye.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandi baloma bali, “Khulikho khupa kimisiingo kimikuunda kiefwe ne biluundu bie kimisabibu ne chinju, nio khunyoolemo biakhulia binyala biakhuliinda mu njala.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babaandi baloma bali, “Khwekopile chirupia khuruunge busuuru bwo mwami bwe kimikuunda ne biluundu biefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efwe khuli be kholo ndala nga Bayaudi basiefwe. Babaana befwe bali balayi busa nga bababwe. Ne khulayingililanga babaana befwe khuba banasioobi. Balala khu bakhaana befwe babeele banasioobi khale. Ne se khuli nga khunyala ta sikila kimikuunda kiefwe ne biluundu biefwe bie kimisabibu bili mu bunyali bwe babaandu babaandi.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ne naulila khu kano nakhalala lukali. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Khur. 22.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.35+LEV.25.36+LEV.25.37"
              },
              "items": [
                {
                  "text": "Bal. 25.35-37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "Likh. 23.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nebaasia mala nekiicha bakoosi ne babemeelesi. Nababoolela ndi, “Mulikho mwenya bukhala khukhwama khu bawandaayenywe.” Nabalaangila libuusiana likali. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababoolela ndi, “Efwe nga nilwo khwenyalile, khwasikula bawandaayefwe Bayaudi babakusibwa khu bibala bibiindi. Ne enywe luno mulikho mukusia bawandaayenywe nio bakusibwe khwifwe!” Basila busa ne khuba nende nilio baloma liosi ta.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio naloma ndi, “Nilio mulakholanga se lili lilayi tawe. Se mwenyekhana murie Wele wefwe nio mukhiingilile khukhomwa ne basiku befwe Be Chikholo chichiindi? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khutasa khwako ese ne babasiange ne bakholi base khulikho khubeosia chirupia ne biakhulia. Lekha khubabukulakho bukhala bukali buno. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakoboseleyo endaalo eya luno kimikuunda kiabwe, biluundu bie kimisabibu biabwe, biluundu biabwe bie kimiseituni nesichakha sia miseituni, ne chinju chabwe.” Bakobosiele akhaba chirupia, biakhulia, kimisabibu, endali ne kamafura nibio mwababukulanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio baloma bali, “Khulabakobosiela ne se khulibenyakho siindu tawe. Khulakhola nga nilwo olomile.” Nalaanga basaayi mala nabakhola khukhwechuba khukhola niko balaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio nasiisimula engubo yase niyo niboela munda mala naloma endi, “Wele akhoya asiisimula buli mundu khukhwama munju yewe ne kimilimo kiewe okhabiikha endakaano yewe tawe. Akhoya asisimulwa mala alekhwe busa.” Ne libuusiana lioosi liakobosia lili, “Kabe kario!” Bafumia Wele Omunyali Owa Bioosi. Mala babaandu bakhola nga balaka.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bukhala bwa Nehemia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama mu siise nisio naroborwa khuba omuruki owa Yuda, khukhwama khu mwiiko kwe kamakhumi kibili khukhwola khu mwiiko kwe kamakhumi kataru na kibili nikio Aritashasita abela omwami, balebe base ne samwene se khwaliakho siakhulia sisienyikha khuuba sisiase nga omuruki tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babemeelesi ba baaba ebweeni wase bara busiro khu baandu, ne lundi bababukulakho biakhulia ne endali, khutasa khu bitonyi bie efwesa kamakhumi kane. Akhaba bakholi babwe bamiina babaandu. Ne ese se nakhola ndio ta, sikila naria Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nara kamaani kase koosi mu khwombakha lundi lisiisi, ne se nenya khubukulakho kamaloba tawe. Lundi bakholi base boosi baba mu bwombakhi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi nalisia Bayaudi ne babemeelesi babwe emia ndala ne kamakhumi karaano khutasa khwaabo babecha khwise khukhwama mu kholo chili siimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.17",
            "verseOrgIds": [
              "NEH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli endaalo nabalisia eeyi ndala, kamakheese kamanefu sita, ne chingokho chingali. Ne buli chindaalo likhumi nabakabila endali. Ne kakhaba kario se nasaba biakhulia nibio benyekhana bambelesie nga omuruki tawe. Nakhola ndio sikila babaandu baba ne busiro bukali.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khebulila, Ee Wele Omunyali Owa Bioosi khulwe bulayi bwase koosi niko ekholeele babaandu bano.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
    }
