                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khucha khureera munju eya Wele Omunyali Owa Bioosi, khu basaayi bakholamo kimilimo, akhaba babaana befwe babele, chimoosi chimbele, ne kamameeme kamabele, nga kaandikwa mwilaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
