                  "text": "Likh. 7.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Se khucha khukhwaana ne baakwa bamenyile mu sibala siefwe tawe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
