      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo babara kimiuuri baba omuruki Nehemia okhwa Hakalia, ne Sedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraya, Asaria, ne Yeremia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.2",
            "verseOrgIds": [
              "NEH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pashuri, Amaria, Malichiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.3",
            "verseOrgIds": [
              "NEH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatushi, Shebania, Maluki; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.4",
            "verseOrgIds": [
              "NEH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harimu, Meremoti, Obadia, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.5",
            "verseOrgIds": [
              "NEH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danieli, Kinetioni, ne Baruku. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.6",
            "verseOrgIds": [
              "NEH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshulamu, Abicha, Miyamini; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.7",
            "verseOrgIds": [
              "NEH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maasia, Bilikai, ne Shemaya. Abo nibo ba baaba basaayi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.8",
            "verseOrgIds": [
              "NEH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Balawi baba: Yeshua okhwa Asania, Binui owe khu baana ba Henadadi, ne Kadimieli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.9",
            "verseOrgIds": [
              "NEH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khu balebe babwe baba: Shebania, Hodia, Kelita, Pelaia, ne Hanani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.10",
            "verseOrgIds": [
              "NEH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika, Rehobu, Hashabiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.11",
            "verseOrgIds": [
              "NEH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakuri, Sherebia, Shebania; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.12",
            "verseOrgIds": [
              "NEH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodia, Bani ne Beninu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.13",
            "verseOrgIds": [
              "NEH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babemeelesi be babaandu baba: Paroshi, Pahati-moabu, Elamu, Satu, ne Bani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.14",
            "verseOrgIds": [
              "NEH.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buni, Asigadi, Bebai, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.15",
            "verseOrgIds": [
              "NEH.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya, Bikibai, ne Adini. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.16",
            "verseOrgIds": [
              "NEH.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ateri, Hesekia, Asuri, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.17",
            "verseOrgIds": [
              "NEH.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodia, Hashumu, Besali; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.18",
            "verseOrgIds": [
              "NEH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harifu, Anatoti, Nebai, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.19",
            "verseOrgIds": [
              "NEH.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makipiashi, Meshulamu, ne Hesiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.20",
            "verseOrgIds": [
              "NEH.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshesabeli, Satoki, ne Yadua; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.21",
            "verseOrgIds": [
              "NEH.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelatia, Hanani, Anaya; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.22",
            "verseOrgIds": [
              "NEH.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshea, Hanania, Hashubu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.23",
            "verseOrgIds": [
              "NEH.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haloheshi, Piliha, Shobeki, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.24",
            "verseOrgIds": [
              "NEH.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumu, Hashabina, Maaseya; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.25",
            "verseOrgIds": [
              "NEH.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahia, Hanani, Anani, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.26",
            "verseOrgIds": [
              "NEH.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maluki, Harimu ne Baana.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        }
      ]
    },
    {
