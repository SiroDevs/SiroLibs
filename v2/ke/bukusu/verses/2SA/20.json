                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.10.16"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 10.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omundu abao owe sipoli niye balangaanga bali Sheba okhwa Bikiri. Aaba owe kholo eya Benjamini. Aapa ekhoombi mala aaloma ali, “Efwe se khulikho ne kumukabwa ne Daudi tawe! Se khulikho ne kumukabo no mwana owa Yese tawe. Baisiraeli, buli mundu akobole engo!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Baisiraeli balekha Daudi mala bacha ne Sheba okhwa Bakiri. Ne babaandu ba Yuda nabo baloonda khu mwami wabwe Daudi mu busuubilifu khukhwama Yoritani khukhwola e Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.22"
              },
              "items": [
                {
                  "text": "2 Sam. 16.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi nga ne oola mu lichipi e Yerusalemu, aabukula bakhasi likhumi nibo aamenyia busa nga basaale, nibo aaba ne alekha khuliinda lichipi, mala abara asi we buliindi. Abaelesia nibio benya bioosi, ne kakhali se akonakho nabo tawe. Baba baboe mu bulamu bwabwe bwoosi. Bamenya nga banamulekhwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami aboolela Amasa ali, “Laanga babaandu ba Yuda boosi beche mu ndaalo chitaru, mala wesi okobole nabo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa acha khulaanga babaandu ba Yuda, ne se akobola mu siise nisio omwami amulakilamo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aboolela Abisai ali, “Sheba okhwa Bikiri acha khukhuelesia butinyu bukali khukhila Abusolomu. Bukula babaandu base mala omuloondekho. Akhola ario engila mu ngoba chisire mala aakhureerera butinyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako babaandu ba Yoabu, ne Kereti, ne Bapeleti, alala ne banamae babaandi be kamaani barura e Yerusalemu ne batima ne baloonda khu Sheba okhwa Bikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ne boola khu libaale liboofu lie Kibeoni, Amasa eecha khubakaanila. Yoabu aba efwarire chingubo che liie. Aba areere embalu mu sibaabi siayo aakichwisiilie khu musiipi kwe mu sibuno. Nga ne aba ne alikho acha, embalu yakwa asi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu aboolela Amasa ali, “Oriena, wandaayase?” Mala atiila bunwanwa bwa Amasa ne kumukhono kumuseecha nio amwikwayila. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa se abonakho embalu niyo Yoabu aba ne atiilile mu mukhono kwewe kukuundi tawe. Ne Yoabu amuuna enda mala bie munda biachichukha asi. Amasa afwilao, ne Yoabu se amuuna lundi tawe. Nio Yoabu ne wandaaye Abisai baloonda khu Sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulala khu baandu ba Yoabu eema amubili kwa Amasa mala aloma ali, “Buli yesi yesi ooli owa Yoabu ne Daudi aloonde Yoabu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumubili kwa Amasa kwakona mu mafuki akari we kumuyila. Ne buli mundu owolangao nabona kumubili okwo eemanga. Khwako mulala khu baandu ba Yoabu oyo akukhuruura akurusia khu muyila akuyila mu ndaa mala akubiimbakho engubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we khurusia kumubili khu muyila, buli mundu acha ne Yoabu mu khuloonda khu Sheba okhwa Bikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheba abirira mu kholo cha Isiraeli choosi ne oola khu lukoba lwa Abeli-beti-maaka. Mala babaandu boosi be kholo eya Bikiri babusiana mala bamuloondakho khukhwola mu lukoba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu ba baba ne Yoabu bacha mala babotookhelesia lukoba lwa Betimaka. Bombakha liita lie liloba enje we lisiisi mala bayaba lisiisi asi khulikhola likwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayo omukhasi omukesi mu lukoba owalangila khwisiisi ali, “Rekeeresia, Rekeeresia! Boolela Yoabu eeche ano, nenya ndomalome naye.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu acha mala omukhasi oyo aamureeba ali, “Ewe niwe Yoabu?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu amukobosia ali, “Yee, niise.” Aamuboolela ali, “Rekeeresia elomo eyo mukholi wowo” Yoabu akobosia ali, “Narekereesie.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhasi oyo aloma ali, “Khale balomanga bali, ‘Cha onyoole bukeleki mu lukoba lwa Abeli’ mala bakholanga bario khumala butinyu bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese ndi mulala khu be kumuleembe ne basuubilwa mu Isiraeli. Siina sikila ewe ne wenya khulwonaka? Ewe wenya khubunia kumukabwa kwa Wele Omunyali Owa Bioosi?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu aamukobosia ali, “Se kali kario tawe! Ese se ndibunia namwe nonake lukoba lwenywe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo se buli bung'ali tawe. Ne kakhali omundu mulala olaangwa Sheba okhwa Bikiri, khukhwama mu sibala sie bikulu sia Efuraimu, akalukhaane khu mwami Daudi. Aana omundu yuno yeng'ene ne ese ninyokha mu lukoba.” Omukhasi oyo aamukobosia ali, “khucha khumumwaatila kumurwe kwewe khu ngaaki khwe lisiisi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omukhasi oyo acha ne nganakani eye bukesi niio babaandu be mu lukoba bali. Bakhalaka kumurwe kwa Sheba okhwa Bikiri bakumwaatila Yoabu khwisiisi khu ngaaki. Aapa ekhoombi emanyisia babaandu bewe barure mu lukoba, mala bacha engo. Ne Yoabu akobola e Yerusalemu wo mwami.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babemeelesi ba Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu aba omwimeelesi owe kamae ka Isiraeli koosi. Benaya okhwa Yeoyata aba omwimeelesi owe Bakereti ne Bapeleti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoramu aba omwimeelesi owe kimilimo kie buyingiilifu, Yehoshafati okhwa Ahiludi, aba omuandiki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
