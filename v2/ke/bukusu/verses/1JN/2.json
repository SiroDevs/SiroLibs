            "number": "26",
            "style": "v",
            "sid": "1JN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikho mbandika kano khwinywe khuloondekhana ne nabo balakhakanga khumubea enywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali enywe, Kristo amuelesia luubakho lwa Roho wewe, nga Roho yuno ne asiili mwinywe se mwenyekha omundu okundi khumwekisia tawe. Sikila Roho wewe amwekisianga buli siindu, mala niko ekisianga kali kang'ali, se buli bubeeyi tawe. Fukiilila niko Roho ekisia, nio murame mu bulala ne Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
      ]
    },
