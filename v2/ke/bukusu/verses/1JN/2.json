        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
