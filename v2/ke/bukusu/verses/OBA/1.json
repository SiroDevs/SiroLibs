      },
      "items": [
        {
          "text": "Wele Omunyali Owa Bioosi alaukuuma Edomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bifuno bikila ekholo eya Edomu eukuumwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wele alikhalakila chikholo",
