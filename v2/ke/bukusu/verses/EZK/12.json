              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.23",
            "verseOrgIds": [
              "EZK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Kamalola ke bubeeyi ne bufumu bwe bubeeyi se bilaba mu kholo eya Isiraeli tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ese Omwami WELE khababoolele ne niko mbaboolela kakekholeekhe. Ne khukhiinda se khulabao lundi tawe. Be sileka enywe, nja khukhola niko nalakiilisia, ese nalomile.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        }
      ]
