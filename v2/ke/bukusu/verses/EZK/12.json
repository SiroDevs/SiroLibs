          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana wo mundu lola abo be nju eya Isiraeli bebaasia bali, kamalola niko Esekieli aboone kali khulwe chindaalo chingali chichiicha, ne bung'oosi buliicha khale khukhwama luno: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.27",
            "verseOrgIds": [
              "EZK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako baboolele oli, ese Wele Omunyali Owa Bioosi ndoma ndi, ‘Ne khukhiinda se khulabao lundi tawe. Ne elomo niyo ndoma elekholekha. Ese Omwami WELE nalomile.’ ”",
          "type": "text",
