          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi Wele Omunyali Owa Bioosi amboolela ali, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
              "EZK.12.26"
            ]
          }
        },
        {
          "name": "verse",
