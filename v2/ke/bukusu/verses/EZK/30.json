            "number": "5",
            "style": "v",
            "sid": "EZK 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banamae babaandikwa khukhwama Esopia, Putu, Libia, Arebia sioosi ne Kubu nende abo boosi ba baaba mu bulala bwa Misiri bakhafwiile mwiie.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.5",
            "verseOrgIds": [
              "EZK.30.5"
            ]
          }
        }
      ]
    },
