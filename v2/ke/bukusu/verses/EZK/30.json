          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu ndaalo eyo, nga Misiri ne siliba ne sionakaakwe, kharume barumwa bache khangu barikhirisie Baesopia ne bakherekeekhe tawe. Lilieendekhelela likhabechekho khu ndaalo eye njoli eya Misiri, bona liolile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.9",
            "verseOrgIds": [
              "EZK.30.9"
            ]
          }
        }
