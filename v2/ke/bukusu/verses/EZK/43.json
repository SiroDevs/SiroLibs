                "loc": "EZK.10.3+EZK.10.4"
              },
              "items": [
                {
                  "text": "Esek. 10.3-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.18+EZK.10.19"
              },
              "items": [
                {
