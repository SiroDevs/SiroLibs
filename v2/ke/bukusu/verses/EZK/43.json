              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma wako, omundu oyo, aandeera esilibwa sisialoleelela ebukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.1",
            "verseOrgIds": [
              "EZK.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
