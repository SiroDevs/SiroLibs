              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kobosia embalu mu sibaabi. Ndakhukhalakila abuundu niio wasaalilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.30",
            "verseOrgIds": [
              "EZK.21.30"
            ]
          }
        },
