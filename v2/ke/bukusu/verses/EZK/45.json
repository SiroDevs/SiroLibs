                "loc": "NUM.28.16+NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Khub. 28.16-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Khu ndaalo eya khane eye kumwesi kwe khunyoa, mularakikha ekhoyo eye naikara eye lipasaka. Mu ndaalo saba buli mulala alalia kumukaati kukhalimo limela tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu ndaalo ng'ene eyo, omwami khukhwola aane euunwa nga embosio eye khurusiao bubwoni bwewe nende bwe babaandu boosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
            "verseOrgIds": [
              "EZK.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli khu ndaalo mu ndaalo saba che naikara, alaana chiuunwa saba che chimbosio, ne kamamiiku saba kakhalimo buubi bwosi bwosi tawe khu Wele Omunyali Owa Bioosi mala oosie bioosi. Lundi alaana endurume buli ndaalo nga siianwa sie khurusiao bubwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu buli uunwa nende buli limiiku nilio baanile nga embosio, mulaba ne biianwa bie efa ndala ndala eye siakhulia sisioomu nende ehini ndala eye kamafura khu buli efa eye siakhulia sisioomu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        }
      ]
