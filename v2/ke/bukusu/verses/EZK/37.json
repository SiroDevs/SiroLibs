              "items": [
                {
                  "text": "Lif. 21.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bumenyo bwase bukhabe mu nibo; ne Ese khabe Wele wabwe, ne nibo bakhabe babaandu base. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.27",
            "verseOrgIds": [
