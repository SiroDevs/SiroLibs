          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aana ebio alala ne siianwa siayo sie biakhulia ne biianwa bie khunywa khu chiuunwa, kamamiiku, ne kamameeme, khuloondekhana ne lilaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.21",
            "verseOrgIds": [
              "NUM.29.21"
            ]
          }
        },
        {
