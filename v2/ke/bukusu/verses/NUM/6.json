              "NUM.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.23+ACT.21.24"
              },
              "items": [
                {
                  "text": "Bikh. 21.23-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nono lino nilio lilaka khu munadhiri siise sie khukhwiyaula khwewe ne siweele: Alireerwa amuliango kwe liiema lie kumuse ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala aane siianwa siewe khu Wele Omunyali Owa Bioosi. Siliba, limeeme lie kumwiiko mulala likhalimo libi tawe khulwe siianwa sie khukhwosia, limeeme likhasi lie kumwiiko mulala likhalimo libi tawe khulwe siianwa sie bubwoni, ne limiiku lilala likhalimo libi tawe khulwe siianwa sie kumuleembe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi alirusia endubi ndala eye kimikaati kikhalimo limela tawe, chikeki che bufu bunosie chichakholwa ne kamafura ke chiseituni ne chipisikuuti chikhakholwa ne kamafura ke chiseituni, alala ne siianwa sie biakhulia ne biianwa bie ndali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaayi acha khuaana bioosi ebweeni wa Wele Omunyali Owa Bioosi ne khuaana siianwa sie bubwoni nende sie khukhwosia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi acha khuaana khu Wele Omunyali Owa Bioosi limiiku nga embosio eye siianwa sie kumuleembe ne kimikaati endubi ndala kikhalimo limela tawe. Lundi omusaayi acha khuaana siianwa sie siakhulia nende sie ndali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio munadhiri abeke kumurwe kwewe kumwaule a muliango kwe liiema lie kumuse. Ne lundi akhabukule lichuune lino alimwaate mu mulilo kukwosia siianwa sie kumuleembe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nio musaayi abukule enyama eye siambele eye limiiku ne likho etutuba nende ekeeki ndala ekhalimo limela tawe khukhwama mu ndubi nende episikuuti mala abire mu makhono ko munadhiri. Omusaayi akhakhole ario, omunadhiri ne amalile khubeka lichuune liewe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaayi akhasiaane ebweeni wa Wele Omunyali Owa Bioosi nga siianwa sie khusuta khu Wele Omunyali Owa Bioosi. Siianwa sino sicha khuba sio musaayi alala ne sitindimilo nisio asuta ebweeni wa Wele Omunyali Owa Bioosi nende sietakho siaanilwe. Enyuma wako Omunadhiri anyala anywa endali.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Elio nilio lilaka khu munadhiri okhola sisiechubo. Siianwa siewe khu Wele Omunyali Owa Bioosi siliba khuloondekhana ne sisiechubo siewe nga omunadhiri, khutasa khu siindi siosi siosi nisio anyala aana. Enyekhana olisie sisiechubo siewe khuloondekhana ne lilaka lie bunadhiri nga nilwo echuba.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikhabi che basaayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
