              "NUM.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Balaki aboolela Balamu ali, “Okhabalaama namwe wababiita chikhabi tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali Balamu akobosia Balaki ali, “Se nakhuboolela ndi koosi niko Wele Omunyali Owa Bioosi aloma nenyekhana ekhole?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bung'oosi bwa Balamu bwe khataru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki aboolela Balamu ali, “yiicha khuyile abuundu aandi. Wakana Wele anyala akhufukiilila ewe wandaamila ba Isiraeli khukhwama ebweeneyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Balaki aayila Balamu khu ngaaki khwe sikulu sia Peori sisialoleelela sisiangalaamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
            "verseOrgIds": [
              "NUM.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu amuboolela ali, “Njombakhile anano chi alutare saba mala underere chiuunwa saba ne kamamiiku saba.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki akhola nga ne bamuboolele mala waana euunwa ne limiiku buli khu alutare.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.30",
