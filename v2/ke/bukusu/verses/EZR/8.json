  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "EZR 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babaandu babakobola khukhwama mu mbaambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kali kamasina ke babemeelesi be chinju ne lisaaye liabwe nga baama mu mbaambe mu Babiloni ne Esira mala bakobola Yerusalemu mu biise bie khukhwamiia khwo mwami Aritashasita. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerishoni, wenju eya Fineasi, Danieli, wenju eya Itamari. Hatushi, wenju eya Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakaria, wenju eya Paroshi, ne babaandu be siseecha emia ndala ne kamakhumi karaano ba baandikwa be sikuuka siabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliehoenai okhwa Seraya, wenju eya Pahati-moabu, ne babaandu chimia chibili, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.4",
            "verseOrgIds": [
              "EZR.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shekania okhwa Yahasieli, wenju eya Satu, ne babaandu chimia chitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.5",
            "verseOrgIds": [
              "EZR.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebeti okhwa Yonasani, wenju eya Atini, ne babaandu kamakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.6",
            "verseOrgIds": [
              "EZR.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesiaya okhwa Atalia, wenju eya Elamu, ne babaandu kamakhumi saba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.7",
            "verseOrgIds": [
              "EZR.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabatia okhwa Mikaeli, wenju eya Shefatia, ne babaandu kamakhumi munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.8",
            "verseOrgIds": [
              "EZR.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obadia okhwa Yehieli, wenju eya Yoabu, ne babaandu chimia chibili ne ekhumi na munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelomoti okhwa Yosifia, wenju eya Binui, ne babaandu emia ndala ne kamakhumi sita. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.10",
            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakaria okhwa Bebai, ne babaandu kamakhumi kabili na munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoanani okhwa Hakatani, wenju eya Asikati, ne babaandu emia ndala ne ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifeleti, Yeueli, ne Shemaya abano nibo ba okhwa Atonikamu, ne babaandu kamakhumi sita (bakobola lwa nyuma). ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usi ne Sakuri, wenju eya Bikibai (Sabuti), ne babaandu kamakhumi saba.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esira anyoola Balawi be Lukaangu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababuusia khu luuchi lulwikha mu lukoba lwa Ahava, mala khwapa ekambi ebweeneyo khu ndaalo chitaru. Nga ne namenieelesia babaandu ne basaayi, se nabonamo Balawi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio narumania banaangile Elieseri, ne Arieli, ne Shemaya, ne Elinasani, ne Yaribu, ne Elinatani, ne Nasani, ne Sakaria, ne Meshulamu. Lundi nalaanga Yoyaribu ne Elinasani, babaandu be limanya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaruma khu mwimeelesi Ido, owaba omwimeelesi owe sirekere sie Kasifia, nababoolela niko bakhoyela baboolele Ido ne bawandaaye, baba bakholi be mu Lukaangu mu Kasifia. Benyekha bakhurumire babaandu bakhola munju eya Wele wefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwe kumwalaalo kwa Wele, bakhurumira Sherebia, omundu omukesi, khukhwama munju eya Mahili owe kholo eya Lawi okhwa Isiraeli. Echa ne babaana bewe be siseecha ne bawandaaye boosi alala baba ekhumi na munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi barumania Hasiabia ne Yeshaya be owa Merari, alala ne balebe babwe, boosi alala baba kamakhumi kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khutasakho babayo bakholi be mu Lukaangu chimia chibili ne kamakhumi kabili nibo Daudi ne babemeelesi bewe barobora khuyeeta Balawi. Bano boosi baandikwa kamasina.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esira emeelela babaandu mu lieyimana khulia ne lisaba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio abwenao, a luuchi lwa Ahaba nalaka lilieyimana lie siakhulia, nio khwiboombie fwabeene ebweeni wa Wele wefwe. Khwakhola khurio nio khumusabe niye akhuraangirire khu lukeendo lwefwe mala akhuliinde efwe ne babaana befwe alala ne kimiaandu kiefwe kioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila naba ne chisoni khusaba omwami sipupu sie banamae ne batimia chifarasi khukhuliinda efwe khukhwama khu basiku be khu ngila. Khwaba khwabooleele omwami khuli, “Kumukhono kwa Wele wefwe kuli kumulayi khu boosi bamuyiima niye, ne kamaani ke burafu bwewe kali khu boosi bamwekaana niye.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono khweyimana siakhulia mala khwasaba Wele khulwe khukhuliinda efwe, mala aulila lisaba liefwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Biianwa khulwe Lukaangu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio naulamo basaayi babemeelesi ekhumi na babili: Sherebia, ne Hasiabia, ne balebe babwe ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabapimila efwesa ne esahabu, ne biianwa bie nju eya Wele nibio omwami, bakeleki bewe ne babemeelesi, ne babaandu ba Isiraeli bamala khuaana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabapimila efwesa chitani kamakhumi kabili na chibili ne bibiindu bie efwesa emia ndala ne busiro bwabio bwoola chikiilo kamakhumi saba ne esahabu chikiilo chielefu chitaru ne chimia chine ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "bibuumba bie esahabu kamakhumi kabili busiro bwabio bwoola chikiilo munaane ne bibiindu bibili bie kumukasa bing'enang'ena, bilekhaana ne bukusi bwe bibuumba bie esahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababoolela ndi, “Enywe muli batakatifu ba Wele Omunyali Owa Bioosi, Wele we bakuuka benywe. Akhaba bibiindu bie esahabu ne efwesa bireerwa khu niye nga biianwa bie khukhwirusia bioosi bili bitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biliinde bwitelembefu khukhwola nga ne bipiimilwa ebweeni we basaayi ne Balawi ne babemeelesi be Baisiraeli mu Yerusalemu musiro chenju eya Wele Omunyali Owa Bioosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio basaayi ne Balawi babukula efwesa, ne esahabu, ne bibiindu bibiaba ne bipiimilwe, babireera mu Yerusalemu, mu Lukaangu lwa Wele wefwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likobola mu Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio khwama a luuchi lwa Ahava endaalo eye likhumi na chibili eye kumwesi kunyoa, ne khucha e Yerusalemu. Wele aaba ne nafwe mala akhuliinda khukhwama khu basiku ne naabo ba baaba ne bakhwikhiina khu ngila ne khulikho khucha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwola mu Yerusalemu mala khwaola khu ndaalo chitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio khu ndaalo eya khane, khwacha munju eya Wele, khwapiima busiro bwe efwesa, ne esahabu, ne bibiindu, mala khwabiakanisia omusaayi Meremoti, okhwa Uria. Aaba ne Eliesa okhwa Fineasi ne Balawi babili, Yosabati okhwa Yoshua, ne Noadia okhwa Binui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli siindu siabalwa mala siapiimwa busiro bwasio, mala busiro bwa buli siindu bwaandikwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        }
      ]
    },
