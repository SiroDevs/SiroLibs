          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biise ebio babaandu babakobola khukhwama mu mbaambe, bareera biianwa bie khukhwosia khu Wele owa Isiraeli. Baana chiuunwa ekhumi na chibili khulwe Isiraeli yoosi, kamamiiku kamakhumi tisa na sita, kamameeme kamakhumi saba na saba. Lundi baana chindurume ekhumi na chibili. Bino bioosi baana nga chimbosio che khukhwosia khu Wele Omunyali Owa Bioosi khulwe khukhwetakaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosi babukula ebarwa niyo omwami oyo aabaelesia mala bakielesia babaami bakeekhe ne babemeelesi be sibala sie engelekha we luluuchi lwa Efurati, nio nabo baana buyeeti khu baandu be nju eya Wele.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.36",
            "verseOrgIds": [
              "EZR.8.36"
            ]
          }
        }
