            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13+EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Khur. 12.1-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Babaandu babakobola khukhwama mu mbaambe, bakhola Epasaka khu ndaalo ekhola ekhumi na chine eye kumwesi kunyoa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.19",
            "verseOrgIds": [
              "EZR.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basaayi ne Balawi boosi betakaasa alala, mala boosi baba bamiliiu. Nio beera limeeme lie Epasaka khu babakobola boosi, khulwe Basaayi basiaabwe, ne khu beene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.20",
            "verseOrgIds": [
              "EZR.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baisiraeli boosi babakobola khukhwama mu mbaambe, balia chimbosio ne naabo boosi babalekha chingila chimayaanu che babaandu babaandi babamenyanga mu sibala omwo mala babecha khusaaya Wele Omunyali Owa Bioosi, Wele owe Baisiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.21",
            "verseOrgIds": [
              "EZR.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu ndaalo saba, balia ne busangaafu Naikara eye kumukaati kukhalimo limela tawe. Basangaala lukali sikila Wele Omunyali Owa Bioosi, aba ayuusiisie kumwoyo kwo mwami owa Ashuru khu nibo, nio abayeeta mu mulimo kwabwe kwe khukhwombakha lundi enju eya Wele, Wele owa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.22",
            "verseOrgIds": [
              "EZR.6.22"
            ]
          }
        }
      ]
    }
