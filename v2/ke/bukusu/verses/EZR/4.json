              "EZR.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.1"
              },
              "items": [
                {
                  "text": "Est. 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mu lirakikha lie khukhwamiia khwo mwami Ahasuero, basiku be babaandu bamenyile mu Yuda ne Yerusalemu bakhola etoloondo ne baandika chibarwa chimbi khu baami.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi, mu bwami bwe Aritashasita, Bisilamu, Mitiretati, Tabeeli nende be bulala bwabwe bamuandikila ebarwa. Ebarwa yaandikwa mu Luaramaiki mala yasomwa ne kaluukhasibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhaba Reumu omukhulu owe banamae, ne Simusai omuandiki, aandika ebarwa yino khu mwami Aritashasita khu Yerusalemu ali: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Khukhwama khu Reumu, omukhulu owe banamae, Shimushai, omuandiki owe sibala, khukhwama khu be bulala babasiaabwe, bakhalaki, ne khukhwama khu baami babaandi bakeekhe babamiia, ba Pasha, babaandu be siseecha babaama Erikewi, ba Babiloni, ne babaandu ba Susa (abo nibo babaandu be sibala sia Elamu). ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.9",
            "verseOrgIds": [
              "EZR.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babaandu babaandi nibo omuiinda lundi owe bunyali Asiuribanipali owauuyisia babaandu khukhwama mu chiingo chabwe mala bamenya mu lukoba lwe Samaria ne mu sibala sie engelekha we luluuchi lwa Efurati.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko kamakhuwa kakaandikwa mu barwa eyo, “Khu mwami Aritashasita: bakholi bowo, be lukoongo lwe Mumbo mwe luluuchi lwa Efurati bakhukheesia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwenya omwami omanye oli Bayaudi babeecha ano khukhwama mu bibala biowo bibiindi bachiile mu Yerusalemu. Balikho bombakha lundi lukoba lumayaanu lundi lureengu. Bamalile khung'oona kumusiingi ne balikho bamaliilisia khukhwombakha kamasiisi lundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.12",
            "verseOrgIds": [
              "EZR.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami, lukoba luno lwaba ne lwombakhwa lundi mala kamasiisi kaalwo kawa, babaandu bano bacha khulekha khuruunga busuuru ne chirupia chowo che bubwami chiicha khuboomba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.13",
            "verseOrgIds": [
              "EZR.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila kuli kumulimo kwefwe khuria bubwami bwowo, se khwenya khubone kano ne kekholekha tawe. Niko kakila ne khuandikila omanye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.14",
            "verseOrgIds": [
              "EZR.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako lola mu libiikhilo lie kamaandike niko bakuuka bowo babiikha. Olanyoola oli lukoba luno buli lwoosi luli lureengu lundi lunaanianga babaami. Babaandu balwo buli lwosi bali baandalafu khubamiia. Lino nilio liliakila lukoba lwonakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.15",
            "verseOrgIds": [
              "EZR.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako khuli nang'ali omwami khuli, lukoba luno lwombakhwa lundi ne kamasiisi kaalwo kawa, omwami socha khunyala khwamiia lundi lukoongo lwe Mumbo mwe luluuchi lwa Efurati tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami aruma likobosio lino: “Khu Reumu, omwimeelesi, ne khu Simusai omuandiki owe sibala ne babasiaabwe bamenyile mu Samaria ne mu lukoongo lwe Mumbo mwe luluuchi lwa Efurati, kimileembe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebarwa niyo mwaruma basomeele bulayi bubwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.18",
            "verseOrgIds": [
              "EZR.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narusia kamalaka khumenieelesia, mala ng'ali lianyoolekhaane lili khukhwama khale lukoba lwa Yerusalemu lulobaanga khuulila babaami. Lundi luli lukoba lwe bureengu ne kamatinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.19",
            "verseOrgIds": [
              "EZR.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaami be kamaani baamiia Yerusalemu ne lukoongo lwe Mumbo mwe luluuchi lwa Efurati. Ne lundi babaandu ba Yerusalemu babaruunga busuuru bubwaukhane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako rusia kamalaka babaandu abo balekhe khukhwombakha lundi lukoba khukhwola nga ndusia lilaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khola lino khangu, nio butinyu bwosi bwosi bulekhe khukhwikholekha khu mwami Aritashasita.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
