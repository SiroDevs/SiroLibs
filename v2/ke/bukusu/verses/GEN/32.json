              "type": "text"
            }
          ]
        },
        {
          "text": " Yakobo amureeba ali, “Khusaba, mboolele lisina liowo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
