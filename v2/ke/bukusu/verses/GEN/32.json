            "caller": "#"
          },
          "items": [
            {
              "text": "32.28",
              "type": "text"
            },
            {
              "text": "Isiraeli:",
              "type": "text"
            },
            {
              "text": "lisina lino lilomekha nga lie Lueburania liliekesia lili “arekana ne Wele” namwe “Wele arekana.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ", sikila warekanie Wele ne babaandu mala waulile.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        }
