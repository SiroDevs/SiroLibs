              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nio omundu chana aloma ali, “Lisina liowo se lilaba lundi Yakobo tawe. Ne kakhali lilaba Isiraeli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        },
        {
