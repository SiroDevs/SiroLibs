          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukobosia ali, “Siina sikila ne undeeba lisina liase?” Mala abwenao abiita Yakobo chikhabi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.29"
            ]
          }
        }
      ]
