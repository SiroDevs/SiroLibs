        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yakobo atiuukha abuundu ao lisina ali Penieli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32.30",
              "type": "text"
            },
            {
              "text": "Penieli:",
              "type": "text"
            },
            {
              "text": "lisina lino lilomekha nga lie Lueburania liliekesia lili “mumoni mwa Wele.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Aloma ali, “Sikila mboone Wele moni na moni mala khufwa tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyanga yasoa Yakobo ne alikho arekukha a Penieli ne ayikila sikila endeelwa yatekukha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako, khukhwola endaalo eya luno lisaaye lia Isiraeli se lilichanga enyama eye ndeelwa tawe. Sikila amutiila khu ndeelwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
        }
