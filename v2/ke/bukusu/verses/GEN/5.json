          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Seti aamenya ola kimiiko emia ndala na kiraano asaala Enosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we khusaala Enosi, Seti amenya kimiiko chimia munaane ne saba, mala asaala babaana babaandi be sisoleeli nende be sikhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seti aamenya kimiiko chimia tisa ne kimiiko ekhumi na kibili, mala afwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
            "verseOrgIds": [
              "GEN.5.8"
            ]
