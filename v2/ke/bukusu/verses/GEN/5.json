          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Metusela amenya kimiiko chimia tisa ne kamakhumi sita na tisa mala afwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.27",
            "verseOrgIds": [
              "GEN.5.27"
            ]
          }
        }
