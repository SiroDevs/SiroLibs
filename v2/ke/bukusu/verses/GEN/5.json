              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we khusaala Lameki, Metusela amenya kimiiko chimia saba ne kamakhumi munaane ne kibili mala asaala babaana babaandi be sisoleeli nende be sikhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.26",
            "verseOrgIds": [
              "GEN.5.26"
            ]
          }
        },
        {
          "name": "verse",
