              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we khusaala Noa, Lameki amenya kimiiko chimia chiraano ne kamakhumi tisa na kiraano mala asaala babaana babaandi be sisoleeli nende be sikhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.30",
            "verseOrgIds": [
              "GEN.5.30"
            ]
          }
        },
