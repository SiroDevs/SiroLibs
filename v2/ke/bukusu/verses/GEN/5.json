              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Lameki amenya ola kimiiko emia ndala ne kimiiko kamakhumi munaane na kibili asaala omwana owe sisoleeli, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.28",
            "verseOrgIds": [
              "GEN.5.28"
            ]
          }
        },
        {
