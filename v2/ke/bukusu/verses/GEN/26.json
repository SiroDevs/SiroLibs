          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli Esau ali bukhulu bwe kimiiko kamakhumi kane areera bakhasi babili, Yutiisi omukhaana owa Beeri Omuhiti, ne Basemati omukhaana owa Eloni, Omuhiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhasi abo bakhola limenya lia Isaaka ne Rabeka liaba lie bubeeleli bukali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
            ]
          }
        }
      ]
