        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisaaye lia Shemu nilio lino: Enyuma we kimiiko kibili, khukhwichula khwe kameechi ne khuwele, Shemu aaba ali ne kimiiko emia ndala, mala asaala Arifakisati. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we lisaalwa lia Arifakisati, Shemu amenya kimiiko chimia chiraano mala asaala babaana babaandi basoleeli ne bakhaana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
