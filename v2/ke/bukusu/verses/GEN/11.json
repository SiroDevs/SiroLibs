          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli Tera ali ne bukhulu bwe kimiiko kamakhumi saba asaala Aburamu, Naori ne Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
            "verseOrgIds": [
              "GEN.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisaaye lia Tera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
            "verseOrgIds": [
              "GEN.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisaaye lia Tera nilio lino: Tera aaba raraawe owa Aburamu, Naori ne Harani. Harani aaba raraawe owa Luti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harani anyoa afwa, Tera raraawe ne asiili. Afwila mu sibala nisio asaalilwamo sia Uri sie Bakalitayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala Aburamu ne Naori bareera bakhasi, mukha Aburamu aaba Sarai ne mukha Naori aaba Milika, omukooko owa Harani. Harani aaba raraawe owa Milika ne Isika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
            "verseOrgIds": [
              "GEN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala Sarai aaba omukuumba, se aaba no mwana tawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera abukula Aburamu omwana wewe, ne Luti omwana owa Harani, omwichukhulu wewe, ne Sarai omukhaana wewe, mala auuya nabo barura mu sibala sia Uri sie Bakalitayo bacha mu sibala sia Kanaani, ne nga boola Harani bamenyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera amenya kimiiko chimia chibili ne kiraano mala afwila mu Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
      ]
    }
