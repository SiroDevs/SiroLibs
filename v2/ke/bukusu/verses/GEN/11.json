              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Sela amenya ola bukhulu bwe kimiiko kamakhumi kataru, asaala Eberi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.14",
            "verseOrgIds": [
