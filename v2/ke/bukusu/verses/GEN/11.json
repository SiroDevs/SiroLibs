            "number": "12",
            "style": "v",
            "sid": "GEN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Arifakisati amenya ola bukhulu bwe kimiiko kamakhumi kataru na kiraano asaala Sela, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne enyuma we lisaalwa lia Sela, Arifakisati amenya kimiiko chimia chine na kitaru, mala asaala babaana babaandi basoleeli ne bakhaana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
              "GEN.11.13"
            ]
          }
        }
      ]
