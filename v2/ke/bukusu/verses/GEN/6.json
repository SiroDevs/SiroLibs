            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.26"
              },
              "items": [
                {
                  "text": "Lk. 17.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.20"
              },
              "items": [
                {
                  "text": "1 Pet. 3.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi abona ali bumayaanu bwe babaandu buli bukali khu sibala, ne buli lilibaasia lie chinganakani che kimiooyo kiabwe liaba limayaanu busiele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi esonia sikila abuumba omundu mu sibala mala liamubelesia kumwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele Omunyali Owa Bioosi aloma ali, “Ndabunia babaandu nibo nabuumba barure khu sibala, babaandu ne chisaang'i, ne chisolo ne bimoola ne chinyuni, sikila nisonia ndi nabuumba bioosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali, Wele Omunyali Owa Bioosi asiimisibwa ne Noa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Noa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.5"
              },
              "items": [
                {
                  "text": "2 Pet. 2.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Luno luli lukano lwa Noa. Noa mu selukho yewe aaba omundu omuluungi, okhalimo nende liosi liosi lie khumwikiicha tawe. Aamenya mu busaangi ne Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa aaba ne babaana bataru, Shemu, Hamu ne Chafwesa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.10",
            "verseOrgIds": [
              "GEN.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono babaandu baaba bamayaanu mumoni cha Wele. Sisiayuumba siaba buli abuundu khu sibala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.11",
            "verseOrgIds": [
              "GEN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele abona ali sibala sili simayaanu, sikila babaandu boosi bakhola kamamayaanu mu limenya liabwe khu sibala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.12",
            "verseOrgIds": [
              "GEN.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.12",
            "verseOrgIds": [
              "GEN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala Wele aboolela Noa ali, “Nabisiisie khukhwakamia babaandu boosi, sikila sibala siechusiibwe sisiayuumba khubirira mu nibo. Ndababunia alala ne sibala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.13",
            "verseOrgIds": [
              "GEN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyombakhila emeeli eye kimirongooro kimilayi. Yombakhamo chisiro mala okimaalile embuula mu kari ne enje. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.14",
            "verseOrgIds": [
              "GEN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiombakhe ori: buleeyi bikele chimia chitaru, bukhiikha bikele kamakhumi karaano ne khuniina mungaaki bikele kamakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.15",
            "verseOrgIds": [
              "GEN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yombakhakho lulama ne lekhakho bubweyaangu bubwola sikele silala, mala ore kumuliango mumbafu mwe emeeli. Wombakhemo bisekese bitaru mala bibe ne amukhe ataru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.16",
            "verseOrgIds": [
              "GEN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila nja khureera kameechi kechule khu sibala, khukhwonaka bie bulamu bioosi biili asi we likulu, ne buli siindu sili khu sibala sikhafwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali ndakhola endakaano yase ne nawe mala olengila mu meeli ewe, babaana bowo, omukhasi wowo ne bakhasi be babaana bowo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.18",
            "verseOrgIds": [
              "GEN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olengisia mu meeli buli bie bulamu bibili bibili, siseecha ne siikhasi chingano choosi. Obiliinde bibe bilamu alala ne nawe, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.19",
            "verseOrgIds": [
              "GEN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "khu nyuni khuloondekhana ne lukano lwacho, ne chisaang'i ne chisolo khuloondekhana ne lukano lwacho, ne bimoola khu sibala khuloondekhana ne lukano lwabio, bibili bibili, siseecha ne siikhasi, olengila nabio obiliinde bibe bilamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.20",
            "verseOrgIds": [
              "GEN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi, bukula buli siakhulia, obuunge mu meeli. Silaba siakhulia siowo ne nabio.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.21",
            "verseOrgIds": [
              "GEN.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.7"
              },
              "items": [
                {
                  "text": "Baeb. 11.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Noa akhola buli siindu nisio Wele amulaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.22",
            "verseOrgIds": [
              "GEN.6.22"
            ]
          }
        }
      ]
