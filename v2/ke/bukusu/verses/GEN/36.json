            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nilio lisaaye lia Esau (niye Edomu). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.1",
            "verseOrgIds": [
              "GEN.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.34"
              },
              "items": [
                {
                  "text": "Lir. 26.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Esau ayila bakhaana Bakanaani babe bakhasi bewe. Ada, omukhaana owa Eloni, Omuhiti, Oholibama, omukhaana owa Ana, okhwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36.2",
              "type": "text"
            },
            {
              "text": "okhwa:",
              "type": "text"
            },
            {
              "text": "kamakaluukhasia malala ke khaale kakaluukhasibwa kali okhwa, Lueburania luli omukhaana, namwe omwichukhulu omukhaana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sibeoni, Omuhibi ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.9"
              },
              "items": [
                {
                  "text": "Lir. 28.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ne Basemati, omukhaana owa Ishimaeli, omukooko owa Nabayoti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada asaalila Esau Elifasi, Basemati asaala Reueli, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.4",
            "verseOrgIds": [
              "GEN.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Oholibama asaala Yeushi, Yalamu ne Kora. Bano nibo ba okhwa Esau nibo asaalila mu sibala sia Kanaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau abukula bakhasi bewe, babaana bewe be sisoleeli ne siikhaana nende be munju mwewe boosi, chikhaafu ne bibiaayo, bibiindu nibio aba ne anyoolile mu sibala sia Kanaani, mala auuya acha mu sibala sisiindi, aleeyi khukhwama khu Yakobo wandaaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.6",
            "verseOrgIds": [
              "GEN.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Auuya sikila niye ne wandaaye baba ne kimiaandu kimikali mala kamaayilwe kaboomba mu sibala nisio bamenyangamo nga baakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.7",
            "verseOrgIds": [
              "GEN.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Esau amenya Seiri, mu sibala sie bikulu (Esau niye Edomu).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino lili lisaaye lia Esau kuuka owe Baedomu mu Seiri, sibala sie bikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.9",
            "verseOrgIds": [
              "GEN.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kali kamasina ke babaana ba Esau: Elifasi, omwana owa Ada, mukha Esau, Reueli omwana owa Basemati mukha Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba okhwa Elifasi baba Temani, Omari, Sefo, Katamu ne Kenasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Timuna aaba omukhasi niye Elifasi okhwa Esau aamenyia busa nga omusaale. Timuna asaala Amaleki khu Elifasi). Bano nibo babaana ba Ada mukha Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.12",
            "verseOrgIds": [
              "GEN.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo ba okhwa Reueli: Nahati, Sera, Siama ne Misa. Bano nibo babaana ba Basemati mukha Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo babaana ba Oholibama omukhaana owa Ana, okhwa Sibeoni mukha Esau: Yeushi, Yalamu ne Kora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo bakasa be babaana ba Esau. Babaana ba Elifasi, omubele owa Esau, baaba Temani, Omari, Sefo, Kenasi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.15",
            "verseOrgIds": [
              "GEN.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kora, Katamu ne Amaleki, abano nibo bakasa babaama khu Elifasi mu sibala sia Edomu, babaana ba Ada.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.16",
            "verseOrgIds": [
              "GEN.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.16",
            "verseOrgIds": [
              "GEN.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo ba okhwa Reueli, okhwa Esau: omukasa Nahati, Sera, Siama ne Misa. Bano nibo bakasa babaakukha khu Reueli mu sibala sie Edomu, baba babaana ba Basemati mukha Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo bakasa babaama khu Oholibama mukha Esau, omukhaana owa Ana, Yeushi, Yalamu, ne Kora, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo ba okhwa Esau (niye Edomu) ne bano nibo bakasa babwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.19",
            "verseOrgIds": [
              "GEN.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
