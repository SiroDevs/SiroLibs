              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo ba okhwa Sibeoni: Aya ne Ana. Ana yuno niye owanyoola chisebele che kameechi kamabile mu sichiimi nga aba ne aaya chipunda cha Sibeoni, raraawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
