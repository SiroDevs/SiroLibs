          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo babaana ba Ana: Dishoni, ne omukhaana bali Oholibama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
              "GEN.36.25"
            ]
          }
        },
        {
          "name": "verse",
