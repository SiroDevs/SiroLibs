          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo ba okhwa Siobali: Alibani, Manahati, Ebali, Shefo ne Onamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.23",
            "verseOrgIds": [
              "GEN.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
