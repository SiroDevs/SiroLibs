          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo bakasa babaakukha khu Bahori: Lotani, Siobali, Sibeoni, Ana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
              "GEN.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dishoni, Eseri ne Tishani, bano nibo bakasa babaama khu Bahori khuloondekhana ne kimiliango kiabwe mu sibala sia Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
            "verseOrgIds": [
              "GEN.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babaami ba Edomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
