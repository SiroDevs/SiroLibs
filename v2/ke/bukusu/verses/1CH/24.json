          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahili ne Mushi baaba be lisaaye lia Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
            "verseOrgIds": [
              "1CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yaasia okhwa Merari asaala lundi raraawe owa Beno: Siohamu, Sakuri ne Iburi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahili asaala basoleeli babili, Eliesa ne Kishi, Eliesa se aaba ne basoleeli tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28",
            "verseOrgIds": [
              "1CH.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Kishi asaala omusoleeli mulala bali Yeraimeeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.29",
            "verseOrgIds": [
              "1CH.24.29"
            ]
          }
        }
      ]
