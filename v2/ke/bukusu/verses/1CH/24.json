          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushi asaala basoleeli bataru: Mali, Eteri ne Yeremoti. Bano baba babaana be balawi khuloondekhana ne chinju che bakuuka babwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        }
