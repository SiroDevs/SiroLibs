        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.18",
            "verseOrgIds": [
              "1CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bipupu bie babaandu bano baroborwa khukhola kimilimo mu lukaangu lwa Wele Omunyali Owa Bioosi. Baliinda kamalaka niko baebwa ne kukaawabwe Aruni nga Wele Omunyali Owa Bioosi, Wele owa Isiraeli ne amulaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamasina ke Balawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko kamasina kakaandi ke babaandu babaama khu lisaaye lia Lawi khu baana ba Amuramu, Shebueli. Ne khu baana ba Shubaeli, Yeteya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishiya, owe lisaaye lia Rahabia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.21",
            "verseOrgIds": [
              "1CH.24.21"
            ]
          }
        }
      ]
