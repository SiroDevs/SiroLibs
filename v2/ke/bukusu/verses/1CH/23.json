        },
        {
          "text": " Nga Daudi aaba ne asaakhuluwe lukali, akhola omusoleeli wewe Solomoni aaba omwami owa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        }
