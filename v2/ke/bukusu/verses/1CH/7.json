          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuraimu paapa wabwe abalila khulwe chindaalo chingali, mala bawandaaye becha bamuoleelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.22",
            "verseOrgIds": [
              "1CH.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi Efuraimu aaba ne omukhasi wewe mala asaala omwana omusoleeli. Bamutiuukha bali Beria",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.23",
              "type": "text"
            },
            {
              "text": "Beria:",
              "type": "text"
            },
            {
              "text": "lisina lino lilomekha nga lie Lueburania lilomekha lili “Mu butinyu.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ", sikila butinyu bwaba bwengile munju eya Efuraimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        }
      ]
    },
    {
