          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siomeri wandaaye owa Yafuleti asaala basoleeli bataru: Roika, Yehuba ne Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
