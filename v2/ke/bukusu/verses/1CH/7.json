          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamaloba ne bumenyo bwabwe bwaba Beteli ne chingoba chichasibotookhelela Naarani ebukwe ne Keseri mumbo, ne chingoba chichasibotookhelela. Shekemu ne Aya ne chingoba chacho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.28",
            "verseOrgIds": [
              "1CH.7.28"
            ]
          }
        }
