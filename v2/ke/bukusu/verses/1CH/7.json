            "number": "29",
            "style": "v",
            "sid": "1CH 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ano niio lisaaye lia Yosefu okhwa Yakobo liamenyanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
              "1CH.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisaaye lia Asieri",
          "type": "text"
        }
      ]
    },
    {
