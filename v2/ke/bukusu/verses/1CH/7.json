          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beria asaala basoleeli babili: Heberi ne Malikieli. Malikieli asaala Birisaiti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
          }
        }
