          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaana ba Asieri baba basoleeli bane: Imuna, Ishiba, Ishibi ne Beria. Ne asaala omukhaana mulala yeng'ene niye balaanga bali Sera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
