          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heberi asaala basoleeli bataru: Yafuleti, Shomeri ne Hotamu ne asaala omukhaana mulala bali Siua.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
