          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunjakha che kamaloba ka Manase chabaakho chingoba cha Beti-sheani, Taanachi, Mekido, ne Tori ne birekere bibiaba siimbi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
              "1CH.7.29"
            ]
          }
        }
