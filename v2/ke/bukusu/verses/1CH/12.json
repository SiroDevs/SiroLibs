  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "1CH 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baloondi ba Daudi be khunyoa khukhwama mu kholo eya Benjamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo babaandu babecha khu Daudi e Sikilaki niio aba ne ekisa khu Omwami Saulo okhwa Kishi. Baba babaandu balala be kamaani babamuyeeta mwiie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.1",
            "verseOrgIds": [
              "1CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba basutile buyiingo. Lundi abele banyala khulasa buembo ne khufuruusia kamabaale khusia ne kumukhono kumuluungi namwe ne kumukoota. Baba Babenjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahieseri ne Yoashi baba babemeelesi babwe. Bombi baba ba okhwa Shema khukhwama Kibea. Yesieli ne Peleti ba okhwa Asimabeti. Beraka ne Yehu khukhwama Anatoti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaya khukhwama Kibeoni. Aba owe kamaani lundi omwimeelesi owe banamae kamakhumi Kataru. Lundi babao Yeremia, Yahasieli, Yoanani ne Yosabati khukhwama Ketera, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babao Elusai, Yeremoti, Bealia, Shemaria, ne Siafatia khukhwama Harufi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babao Elikana, Isishia, Asareli Yoeseri ne Yashobeamu owe lisaaye lia Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoela ne Sebatia ba okhwa Yerohamu khukhwama Ketori.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baloondi ba Daudi khukhwama mu kholo eya Kati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu balala khukhwama mu kholo eya Kati bacha niio Daudi aba mu lukoba lusire mu sichiimi. Baba banamae be kamaani, babamanya khu khuupanila chingabo ne kamafumo. Bubweeni bwabwe bwaba oli bubweeni bwe chitalang'i. Baba be chimbilo nga kicheu mu ngulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eseri aba omwimeelesi owe banamae ba Kati, Obadia owe khabili, Eliabu owe khataru. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishumana aba owe khane, Yeremia owe kharaano. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atai owa sita, ne Elieli owa saba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoanani aba owa munaane, Elisabati owa sita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia owe khumi, ne Makibanai owe khumi na mulala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba Kati bano baba banamae bakhulu. Omutiiti mu bwimeelesi khubano bemeelela banamae emia ndala ne omukhulu emeelela banamae eelefu ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo babambukha luluuchi lwa Yoritani mu mwesi kwe khunyoa kwe kumwiiko, siise nisio Luluuchi lwa Yoritani lwechulanga. Batimania abo boosi babamenyanga mu matooma, ebukwe ne mumbo mwe luluuchi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baloondi ba Daudi khukhwama mu kholo eya Benjamini ne Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu khukhwama mu kholo cha Benjamini ne Yuda becha mu Lukoba lusire niio Daudi aaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi arura enje khu bakanila mala aloma ali, “Mwaaba ne mwichile nga basaale khukhunjeeta ese, mwakaanila. Ne mwaba ne mwenya khukhunjongela ese khu basiku base, nakhaba ne khakholile kamabi tawe, Wele owe bakuuka befwe akhoya amanye mala amuelesie kumunaanio.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Roho owa Wele echa khu Amasai, omwimeelesi owe banamae kamakhumi kataru, mala aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baloondi khukhwama mu kholo eya Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banamae balala khukhwama mu kholo eya Manase batubana ne Daudi alala nga aba ne alikho arura ne Bafilisiti khukhupana no mwami Saulo. Ne kakhali Daudi se ayeeta Bafilisiti tawe. Sikila babemeelesi be Bafilisiti bamurakho acha sikila bebaasia bali akhola ario abanjukha mala abachonganila khu Saulo owaba omwami wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.19",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ne ela Sikilaki, bano nibo banamae khukhwama mu kholo eya Manase ba bakobolayo ne Daudi: Atina, Yosabati, Yetiaeli, Mikaili, Yosabati, Elihu, ne Siletai. Buli mulala khu bano aba omwimeelesi owe babaandu eelefu ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.20",
            "verseOrgIds": [
              "1CH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayeeta Daudi khukhupania ne sipupu sie banuuli sikila baba banamae be kamaani lundi banyindaafu. Lundi baba babemeelesi be banamae. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.21",
            "verseOrgIds": [
              "1CH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embi buli ndaalo babaandu bayaakha baambananga ne Daudi khukhwola nga ne aaba ne banamae bakali. Siise sitiiti siri sipupu sie banamae bewe siaba oli sipupu sie banamae ba Wele.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamasina ke bipupu bie banamae ba Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebino nibio bipupu bie banamae babecha khu Daudi e Heburoni. Becha khukaluukhasia bubwami bwa Saulo bwile khu Daudi khuloondekhana ne likhuwa lia Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu be kholo eya Yuda baba ne chingabo ne kamafumo baba babaandu chielefu sita ne chimia munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Simioni babamo banamae chielefu saba ne emia ndala. Baba babaandu be kamaani lundi banyindaafu mwiie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Lawi baba babaandu chielefu chine ne chimia sita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwimeelesi khukhwama mu lisaaye lia Aruni aaba ne babaandu chielefu chitaru ne chimia saba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satoki owaba ne asiili omuele lundi omunyindaafu, aaba ne babemeelesi kamakhumi kabili na babili ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.28",
            "verseOrgIds": [
              "1CH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Benjamini babao babaandu chielefu chitaru. Khukhwola siise sino babaandu bano boosi baba basuubilwa khu nju eya Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.29",
            "verseOrgIds": [
              "1CH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Efuraimu baba banamae chielefu kamakhumi kabili ne chimia munaane. Baba banamae banyindaafu, lundi bamanyikhana mu chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.30",
            "verseOrgIds": [
              "1CH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balala khu be ekholo eya Manase baba banamae chielefu ekhumi ndala ne munaane babaandu babaroborwa bache bamiisie Daudi abe omwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.31",
            "verseOrgIds": [
              "1CH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Isakari baba babemeelesi chimia chibili. Bano nibo ba baaba ne limanyilisia lie kamakhuwa kakeecha. Nibo babamanya nisio Isiraeli ekhoyeele ekhole. Ne balebe babwe boosi baba asi wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.32",
            "verseOrgIds": [
              "1CH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Sebuluni banamae chielefu kamakhumi karaano. Baba banamae balayi lundi banyala barumikhira buli bulwaani. Berusia khuyeeta Daudi ne kumwoyo kwoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.33",
            "verseOrgIds": [
              "1CH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Nafutali banamae babemeelesi eelefu ndala. Baba banamae chielefu kamakhumi kataru na saba basuta bulwaani ne chingabo ne kamafumo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.34",
            "verseOrgIds": [
              "1CH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Dani babamo banamae chielefu kamakhumi kabili na munaane ne chimia sita baberekekha liie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.35",
            "verseOrgIds": [
              "1CH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kholo eya Asieri babamo banamae chielefu kamakhumi kane ba baaba ne berekekhe khucha mwiie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.36",
            "verseOrgIds": [
              "1CH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babao banamae chielefu emia ndala ne kamakhumi kabili ebukwe we luluuchi lwa Yoritani khukhwama mu kholo cha Rubeni Kati, ne babaandi mu kholo eya Manase. Baba ne bulwaani bwoosi bwe liie.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banamae bano boosi baba berekekhe khukhupana liie. Becha Heburoni ne babisiisie khale khukhola Daudi abe omwami owa Isiraeli. Ne lundi babaandu ba Isiraeli babaandi boosi baba ne enganakani ndala eye khukhola Daudi abe omwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamenyayo chindaalo chitaru ne Daudi, ne balia ne khunywa nisio balebe babwe babarekekhera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lundi babaandu babamenya siimbi khukhwama mu kholo che aleeyi nga Isakari, Sebuluni ne Nafutali. Bareera biakhulia, bufu, chinduli, chisabibu chinyomu, endali ne kamafura ke chiseituni, chikhaafu ne kamakheese. Basutila biakhulia bino khu punda, chingamia, chinyumbu, ne chieeyi. Bakhola kano koosi sikila liliekhoya liliabao mu Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
    }
