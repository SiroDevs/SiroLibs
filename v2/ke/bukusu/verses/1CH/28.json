    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamalaka ka Daudi khulwe Lukaangu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi abuusia babemeelesi ba Isiraeli boosi mu Yerusalemu. Babemeelesi bano baba: Babemeelesi be chikholo, babemeelesi be bipupu bibiakholelanga omwami, babemeelesi be banamae chielefu chimia, babemeelesi be kimiaandu, ne basoleeli bo mwami boosi, babemeelesi be lichipi, babaandu be kamaani ne banamae banyindaafu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.1",
            "verseOrgIds": [
              "1CH.28.1"
            ]
          }
        }
      ]
    },
    {
