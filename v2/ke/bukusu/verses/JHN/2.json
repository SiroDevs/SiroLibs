            "sid": "JHN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se enaana omundu yesi yesi amuboleele liiba lie babaandu tawe, sikila niye omwene amanya koosi kaali mu miooyo kiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.25",
