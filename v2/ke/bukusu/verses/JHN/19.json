          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 19:28"
          },
          "items": [
