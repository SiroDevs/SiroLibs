              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio likhuwa liakeenda mu babeeka ba Yesu bali omweeka yuno se alifwa tawe. Kakhaba kario Yesu se aaloma ali omweeka oyo se alifwa tawe tawe, ne kakhali aaloma ali, “Naaba ne nenya amenye khukhwola nga nicha, lilienelio lili siina khwiwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.23",
            "verseOrgIds": [
              "JHN.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
