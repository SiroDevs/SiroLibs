          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.23",
            "verseOrgIds": [
              "JHN.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuno niye omweeka owalomaloma kamakhuwa kano, ne lundi ali niye owa kaandika, mala khu manyile khuli niko aloma kali kang'ali.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.24",
            "verseOrgIds": [
              "JHN.21.24"
            ]
          }
        }
      ]
    },
    {
