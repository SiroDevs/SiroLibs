          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Petero ne amubona areeba Yesu ali, “Omwami ne yuno naye?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amukobosia ali, “Nakheenya niye amenye khukhwola nga ne nicha, lilienelio lili siina khwiwe? Ewe nondekho!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 21:22"
          },
          "items": [
