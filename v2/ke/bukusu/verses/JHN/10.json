                  "text": "Bal. 24.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bakobosia bali, “Se khwenya khu khupa ewe kamabaale sikila bikholwa bilayi tawe, ne kakhali sikila embelekeu yowo! Ewe oli omundu busa, ne olikho owekhola khuba Wele!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.33",
            "verseOrgIds": [
              "JHN.10.33"
            ]
          }
        }
