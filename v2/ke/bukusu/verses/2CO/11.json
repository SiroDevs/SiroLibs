          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala nekhisibwa mu sikono khubirira mu numa eye mwisiisi namwikobakho.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
            "verseOrgIds": [
