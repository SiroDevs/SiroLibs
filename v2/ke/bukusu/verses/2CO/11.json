              "items": [
                {
                  "text": "Bikh. 9.23-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nga naba mu Damasika omuruki owaba aasi wo mwami Areta ara baliindi a bilibwa bambaambe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
