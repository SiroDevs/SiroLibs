        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndi bali khukhwola nebonie, aba nebonesia khulwe bibiindu bibiekesia nga ese ne ndi omutekhele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele lundi Paapa owo Mwami Yesu, lisina liewe lifumisibwa mindali na mindali! Niye amanyile ali se ndikho mbea tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
              "2CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
