            "sid": "2TH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.15+1TH.4.16+1TH.4.17"
              },
              "items": [
                {
                  "text": "1 Bates. 4.15-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Khuloondekhana ne liliicha lio Mwami wefwe Yesu Kristo ne liliebuusia liefwe elala khuba ne naye: Bawandaayefwe, mwikoonjelela. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhaba bakoyanisibwa khangu mu khwibaasia khwenywe, namwe mwayusibwa mu miooyo khulwe khuboolelwa muli Endaalo eyo Mwami yoola khale tawe. Wakana mwibaasia muli khwaboola lino nga khwaba ne khung'oola, namwe ne khwilwacha, namwe muli khwaliandika mu barwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.2",
            "verseOrgIds": [
              "2TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhalekha omundu yesi yesi amubee mu ngila yosi yosi tawe. Sikila Endaalo eyo se liola khuloba Wele khumaliilisi, ne khukhabao ne Omumayaanu owalaamilwa khucha mu nyanja eye kumulilo ne akhabao tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.3",
            "verseOrgIds": [
              "2TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "Dan. 11.36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Esek. 28.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Aliyingania buli olaangwa wele namwe sisiindu siosi siosi nisio basaayanga. Omwene alieniinia angaaki wabio bioosi, lundi akhache ekhale mu Lukaangu lwa Wele, mala elaange khuba Wele.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khaba se mukhebulila tawe? Namuboolela kano koosi nga naba nanywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.5",
            "verseOrgIds": [
              "2TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne siliio sisiindu sikhiingilila kano kalekhe khukhwekholekha luno tawe, mala musimanyile. Mu siise sisialakwa, Omumayaanu oyo akhabonekhe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.6",
            "verseOrgIds": [
              "2TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumayaanu chana ali khale khu milimo, ne kakhali kakewe ako se kalekholekha tawe, khukhwola nga oyo okakhiingililanga ne akharusibweo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.7",
            "verseOrgIds": [
              "2TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.4"
              },
              "items": [
                {
                  "text": "Isa. 11.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne nga arusibwao, Omumayaanu oyo akhabonekhe, ne nga Omwami Yesu ne akheeche, akhamwire ne kumuya khukhwama mukhanwa mwewe ne khumubunia ne khubao khwe liliicha liewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.8",
            "verseOrgIds": [
              "2TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.24"
              },
              "items": [
                {
                  "text": "Mat. 24.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omumayaanu oyo akheeche ne bunyali bwa Sietani ne khukhola kakafuma kamayia koosi ke bubeeyi ne bibiindu bie khuukia, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.9",
            "verseOrgIds": [
              "2TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala arumikhire bubwafuma bubeeyi khwaabo bakhabune. Bakhabune sikila se bakaanila ne khusiima bung'ali nio baonisibwe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.10",
            "verseOrgIds": [
              "2TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Wele abarumira bunyali bwe khubatiimia bubakhole basuubile kaali ke bubeeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.11",
            "verseOrgIds": [
              "2TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhumaliilikha abo boosi babesangaasia mu bwoni ne bakhasuubila bung'ali tawe, ba khakhalakilwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwaroborwa khulwe buonia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwola bawandaayefwe khupile Wele orio mu biise bioosi sikila enywe, enywe nibo Omwami asiima. Sikila Wele amurobora enywe nga be khunyoa muonisibwe ne bunyali bwa Roho, amukhole enywe mube babaandu bewe batakatifu khulwe lisuubila lienywe mu bung'ali. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.13",
            "verseOrgIds": [
              "2TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele amulaanga enywe khu kano khubirira mu Lomo Endayi niyo khwamwilwachila; amulaanga enywe munyoole sitonyi sienywe sie luyali lwo Mwami wefwe Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.14",
            "verseOrgIds": [
              "2TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawandaayefwe nono, yeandalasia ne khuamba bung'ali nibwo khwamwekisia obwo, mulilwacha liefwe ne mu barwa yefwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhoya Omwami wefwe Yesu Kristo omwene ne Wele Paapa wefwe, owakhusiima efwe, akhuelesia litinyilisia lia mindali ne lilieyikina lilayi mu mwalaalo kwewe, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.16",
            "verseOrgIds": [
              "2TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "amutinyilisie kumwoyo ne khumutasa kamaani buli lwoosi mukhole ne khulomaloma kaali kamalayi.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.17",
            "verseOrgIds": [
              "2TH.2.17"
            ]
          }
        }
      ]
    }
  ],
