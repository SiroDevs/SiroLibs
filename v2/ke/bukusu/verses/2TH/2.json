        "style": "s1"
      },
      "items": [
        {
          "text": "Omumayaanu oyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
