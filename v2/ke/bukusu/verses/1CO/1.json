              "1CO.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.1"
              },
              "items": [
                {
                  "text": "Bikh. 18.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Khu kanisa eya Wele eli mu Korinjo, khu boosi balangiilwe babe babaandu ba Wele batakatifu, bali babeewe mu buambaani ne Yesu Kristo, alala ne babaandu boosi buli abuundu basaaya Omwami wefwe Yesu Kristo, Omwami wabwe ne nafwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Paapa wefwe no Mwami Yesu Kristo bamuelesie enywe kumwalaalo ne kumuleembe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikhabi mu Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lwoosi ese khupilanga Wele wase orio sikila enywe khulwe kumwalaalo nikwo amuelesie khubirira mu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwe buambaani bwenywe ne Kristo mwabeele baiinda mu biindu bioosi, mu lilomaloma ne mu bukesi bwoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Burume khu makhuwa ka Kristo bwaandalasiibwe lukali mwinywe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.6",
            "verseOrgIds": [
              "1CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "se mwatambile siianwa sia Roho siosi siosi tawe, nga mulindiililanga lukali Omwami wefwe Yesu Kristo afunulibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi akhamuandalasie khukhwola khu siakamo nio mukhaba ne buubi bwosi bwosi mu ndaalo yo Mwami wefwe Yesu Kristo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
            "verseOrgIds": [
              "1CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele ali omusuubilwa. Ali niye owamulaanga enywe khusaanga no Mwana wewe Yesu Kristo, Omwami wefwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bulomani mu kanisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bunyali bwo Omwami wefwe Yesu Kristo mwikoonjelela enywe mweesi, bawandaayase, mufukiilisiane mu niko muboolana, nio bubwaukhani bulekhe khubao mwinywe. Ambaanila elala, mube ne kamebaasio malala kong'ene, ne sifuno silala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basaale babaandu balala khukhwama munju eya Kuloe, bambooleele ese abuwaanga busa, bali bulomani buli mwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24"
              },
              "items": [
                {
                  "text": "Bikh. 18.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lekha ndome ndi, buli mulala mwinywe alomanga sisiindu sisiaukhaane, mulala alomanga ali, “Ese owa Paulo,” okundi ali, “Ese owa Apolo,” okundi ali, “Ese owa Petero,” ne okundi ali, “Ese owa Kristo” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristo akabukhasiibwe mu bipupu! Aba Paulo niye owamufwiila enywe khu musalaba ku? Enywe mwabatiisibwa nga babeeka ba Paulo ku?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.8"
              },
              "items": [
                {
                  "text": "Bikh. 18.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.29"
              },
              "items": [
                {
                  "text": "19.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.23"
              },
              "items": [
                {
                  "text": "Bar. 16.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ese khupila Wele orio ndi se nabatiisiakho yesi yesi khwinywe tawe ne kakhali Kurisipo ne Kayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se aliio na mulala nono, onyala aaloma ali mwabatiisibwa nga babeeka base tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.15"
              },
              "items": [
                {
                  "text": "1 Bakor. 16.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (Ee ng'ali nabatiisia akhaba Sitefano nende be nju yewe yong'ene ne se khebulila ne nabatiisiakho okundi yesi yesi tawe.) ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristo se aanduma khubatiisia tawe. Aanduma khukhwilwacha Elomo Endayi, mala ndekhe khukilwacha ne ndumikhira lulomo lwe bukesi bwe babaandu, nio kabe ng'ali kali lifwa lia Kristo khu musalaba se linuulwa bunyali bwalio tawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristo niye bunyali ne bukesi bwa Wele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila burume bwe lifwa lia Kristo khu musalaba buli busilu khwaabo balikho ne batiba, ne khwifwe khulikho ne khuonisibwa buli bunyali bwa Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.14"
              },
              "items": [
                {
                  "text": "Isa. 29.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Liiandiko liboolanga lili,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.20",
            "verseOrgIds": [
              "1CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila Wele mu bukesi bwewe akhola lilekhe khunyalikhana khu baandu khu mumanya niye khulwe bukesi bwabwe bubwene tawe. Ne kakhali, khulwe burume nibwo khwilwacha bulaangwa buli “busilu,” Wele abisia khuonia abo basuubila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayaudi benya kamayia nga sisiekesio ne Bakiriki baenja bukesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.22",
            "verseOrgIds": [
              "1CO.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali khwifwe, khwilwacha Kristo owabambwa, burume buno bukhalasia Bayaudi lundi buli busilu khu Be Chikholo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.23",
            "verseOrgIds": [
              "1CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khwaabo nibo Wele alaangile, Bayaudi alala nende Be Chikholo, burume buno buli Kristo, Kristo oli bunyali bwa Wele ne bukesi bwa Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.24",
            "verseOrgIds": [
              "1CO.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila sibonekha khuba busilu bwa Wele sili sie bukesi khukhila bukesi bwo mundu, ne sibonekha khuba butekhele bwa Wele sili sie kamaani khukhila kamaani ko mundu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawandaayase, luno khebulila nga mwaba, nga Wele ne amulaanga. Mu khulola khwo mundu bakeekhe mwinywe mwaba bakesi, namwe be bunyali, namwe babasaalwa munju eye buriaani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.26",
            "verseOrgIds": [
              "1CO.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele mu sifuno siewe arobora nibo sibala sibaasia sili basilu nio aambie bakesi chisoni, lundi arobora nibo sibala sibaasia khuuba batekhele nio aambie be bunyali chisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.27",
            "verseOrgIds": [
              "1CO.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arobora nibio sibala silolela mu bufuumbo ne lifwochola ne sibaasia sili se bili siindu tawe, nio onake nibio sibala sibaasia sili bili ne bukhala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.28",
            "verseOrgIds": [
              "1CO.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kekesia kali se aliio na mulala onyala webonia ebweeni wa Wele tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.29",
            "verseOrgIds": [
              "1CO.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali Wele amureerire enywe mu buambaani ne Yesu Kristo, lundi Wele akholile Kristo khuba bukesi bwefwe. Khulwa niye khukholwa khuba baluungi ebweeni wa Wele, khuba batakatifu ba Wele lundi balekhuule. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.30",
            "verseOrgIds": [
              "1CO.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "Yer. 9.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nono, nga liiandiko liboolanga lili, “Oyo yesi yesi owenya khukhwibonia khukhwola ebonie khu niko Omwami akholile.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.31",
            "verseOrgIds": [
              "1CO.1.31"
            ]
          }
        }
      ]
    }
