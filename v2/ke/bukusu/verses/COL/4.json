              "items": [
                {
                  "text": "Film. 23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kimileembe khukhwama khu Epafura, omusaangi okundi owe mu sipupu sienywe lundi omukholi owa Yesu Kristo. Amusabilanga enywe lukali buli lwoosi nio Wele amukhole enywe mube ne kamaani, nga bakristo baangafu mwisuubila baloonda mu bwichufu lilienya lia Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese samwene nyala narusia buloli bwe kimilimo kiewe mwinywe ne babaandu ba Laotikia ne Hirapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        },
        {
