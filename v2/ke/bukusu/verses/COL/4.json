        },
        {
          "text": " Enywe mu mwaandika bamukholela, kholela bakholi benywe bung'ali, khebulila muli enywe mweesi muli no Mukhoongo wenywe mwikulu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
