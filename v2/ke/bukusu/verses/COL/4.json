            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ba bakesi mu niko mukhola khu baandu bakhasuubila tawe, ne khurumikhira bulayi bubweyaangu bwoosi nibwo muli nabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilomaloma lienywe buli lwoosi likhoya libe lilayi lundi lisiimisia, lundi mumanye nga mukobosia bulayi buli mundu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
    },
    {
