          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
