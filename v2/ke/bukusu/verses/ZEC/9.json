        },
        {
          "text": " Buno nibwo burume bwa Wele Omunyali Owa Bioosi. Wele Omunyali Owa Bioosi abisiisie siiukuumo khu sibala sia Hatiraki ne lukoba lwa Damasika. Chikholo cha Isiraeli ne lukoba luboofu lwa Siria bili bia Wele Omunyali Owa Bioosi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
