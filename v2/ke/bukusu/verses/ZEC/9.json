      },
      "items": [
        {
          "text": "Omwami olibao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likobola lie babaandu ba Wele",
          "type": "text"
        }
      ]
