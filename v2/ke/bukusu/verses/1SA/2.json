              "type": "text"
            }
          ]
        },
        {
          "text": " Hana lundi asaba ne aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
