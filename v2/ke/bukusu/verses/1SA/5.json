        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisanduku lie Ndakaano mu Bafilisiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Bafilisiti ne babukula Lisanduku lie Ndakaano balisuta baliamia e Beneseri baliyila Ashitoti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Bafilisiti lundi babukula Lisanduku lie Ndakaano eya Wele baliyila munju eya Dakoni mala balira embi ne Dakoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga babaandu ba Ashitoti benyokha makhelebeende endaalo eyaloondakho, Dakoni aba akwile mafumala ebweeni we Lisanduku lie ndakaano eya Wele Omunyali Owa Bioosi. Nio babukula Dakoni bamura abuundu wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali nga benyokha makhelebeende endaalo eyaloondakho, lundi Dakoni aba akwile mafumala ebweeni we Lisanduku lie Ndakaano, eya Wele Omunyali Owa Bioosi. Kumurwe kwewe ne kamakhono kewe koombi kaba kakhalikhe kalambaalile muliango. Kumubili kwewe kwong'ene kukwaba ne kuramire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nilio likila basaayi ba Dakoni nende boosi babengilanga munju eya Dakoni, ne bakhemanga a muliango kwa Dakoni e Ashitoti khukhwola luno tawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aelesia babaandu ba Ashitoti kumunaanio. Abarengia mala aelesia nibo nende babaandu ba bamenyanga siimbi nabo butinyu bwe bulwaale bwe khubiimba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.6",
              "type": "text"
            },
            {
              "text": "bulwaale bwe khubiimba:",
              "type": "text"
            },
            {
              "text": "khulekhasia kamabiimba ne bukali bwe chimbeba liekesia lili buno bwaba bulalakho khu bulwaale busalanila khangu nga bwe chimbeba (lola 6.5).",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu ba Ashitoti nga babona bibiindu nga ne bili baloma bali, “Lisanduku lie Ndakaano eya Wele owa Isiraeli se likhoya liarama mwifwe tawe. Sikila kumunaanio kwewe kwabeele kumusiro khwifwe ne khu Dakoni, wele wefwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.7",
            "verseOrgIds": [
              "1SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio barumania mala babuusia alala Babaami be Bafilisiti mala babareeba bali, “Khukhola khuriena ne Lisanduku lie Ndakaano eya Wele owa Isiraeli?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaami bakobosia bali, “Lekha lisanduku lie Ndakaano eya Wele owa Isiraeli liyilwe e Katii.” Nio balibukula baliyila e Katii. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali enyuma we khulireera, kumunaanio kwa Wele Omunyali Owa Bioosi kwaba lundi khu lukoba olwo. Wele Omunyali Owa Bioosi aelesia lukoba olwo lireenga liboofu, aelesia babaandu be lukoba kumunaanio, bakhulu ne batiiti. Bulwaale bwe kamabiimba bwabakwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio bayila Lisanduku lie Ndakaano eya Wele e Ekironi. Ne kakhali nga Lisanduku lie Ndakaano eya Wele ne liecha Ekironi, babaandu ba Ekironi balila ne baloma bali, “Bakhurereere ano Lisanduku lie Ndakaano eya Wele owa Isiraeli, khukhwira efwe ne babaandu befwe!” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio lundi baruma babuusia alala babaami be Bafilisiti boosi mala baloma bali, “Yila Lisanduku lie Ndakaano eya Wele owa Isiraeli, likobole abuundu walio. Nio likhakhwira efwe ne babaandu befwe tawe.” Sikila linikina liboofu lukali liabao mu lukoba lwoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.11",
            "verseOrgIds": [
              "1SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu bakhafwa tawe, babiimba kamabiimba mala biililo bie lukoba bianiina bioola mwikulu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.12",
            "verseOrgIds": [
              "1SA.5.12"
            ]
          }
        }
      ]
    }
  ],
