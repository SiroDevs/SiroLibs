    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biise ebio, Bafilisiti babuusia alala banamae babwe khu khuupana liie ne Isiraeli. Ne Akishi aboolela Daudi ali, “Ewe manya oli ewe ne babaandu bowo mulacha ne banamae base mwiie.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.1",
            "verseOrgIds": [
              "1SA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.1",
            "verseOrgIds": [
              "1SA.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi akobosia Akishi ali, “Bulayi! Ewe okhamanye niko ese omukholi wowo ndinyala khukhola.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akishi aboolela Daudi ali, “Bulayi! Ese ndakhukhola ewe obe omunamae wase ouniinda mu limenya liase lioosi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulo areeba omulakusi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        },
        {
