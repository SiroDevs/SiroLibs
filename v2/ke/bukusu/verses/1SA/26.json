              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Saulo alomalomela Daudi ali, “Ewe oli omubiite chikhabi, mwana wase Daudi. Okhakhole bibiindu bikali mala okhakhile.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
