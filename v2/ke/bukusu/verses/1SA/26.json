          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aananga kumuruuru khu buli mundu khulwe bung'ali bwo mundu oyo ne bubweyikinwa bwewe. Endaalo yino Wele Omunyali Owa Bioosi akhurere ewe mu bunyali bwase. Ne kakhali se ndililekho kumukhono kwase khu muchukhekho kamafura owa Wele Omunyali Owa Bioosi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bulamu bwowo ne bubeele bwe bukhala khwise, Wele Omunyali Owa Bioosi yesi akhoya akhola bulamu bwase bwaba bwe bukhala mala ambonia khukhwama mu butinyu bwoosi!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        }
      ]
