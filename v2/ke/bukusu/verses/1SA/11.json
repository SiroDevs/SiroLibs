          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulo aula Baamoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Nahasi Omuamoni aniina abotookhelesia Yabesi-Kileati. Ne babaandu ba Yabesi baboolela Nahasi bali, “Khola endakaano ne nafwe mala efwe khulakhukholela.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.1",
            "verseOrgIds": [
              "1SA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.1",
            "verseOrgIds": [
              "1SA.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali Nahasi Omuamoni akobosia ali, “Ese ndakhola endakaano ne nanywe khu likhuwa lilala. Murusiemo buli mundu emoni eye kumukhono kumuseecha mala khu lino ndeere chisoni khu Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.2",
            "verseOrgIds": [
              "1SA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.2",
            "verseOrgIds": [
              "1SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basaakhulu ba Yabesi bamuboolela bali, “Khuelesie chindaalo saba che kumuleembe khurume barumwa mu sibala sia Isiraeli sioosi. Ne omundu aaba ne akhalimo onyala aakhusikula efwe tawe, aba nono khuleana fwabene khwiwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.3",
            "verseOrgIds": [
              "1SA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.3",
            "verseOrgIds": [
              "1SA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barumwa nga bacha boola e Kibea niio Saulo amenyanga, baboola kamakhuwa ako babaandu ne barekeeresiisie. Mala boosi barakikha khulila lukali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.4",
            "verseOrgIds": [
              "1SA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.4",
            "verseOrgIds": [
              "1SA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono, Saulo aba alikho aama e mukuunda, enyuma we chieeyi. Ne Saulo areeba ali, “Siina silikho silisia babaandu?” Nio bamuboolela ke babaandu ba Yabesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.5",
            "verseOrgIds": [
              "1SA.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Saulo ne aulila kamakhuwa kano, Roho owa Wele amwichakho ne kamaani mala lirima liamuaamba likali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.6",
            "verseOrgIds": [
              "1SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abukula chieeyi chibili, achibakamo bitonyi bibili mala abiyila ne barumwa mu sibala sia Isiraeli sioosi ne ababoolela ali, “Kano niko kakhekholekhe khu khaafu cho mundu yesi yesi okhaloonda khu Saulo ne Samweli mwiie tawe!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.7",
            "verseOrgIds": [
              "1SA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liria lia Wele Omunyali Owa Bioosi liecha khu baandu, mala boosi barura busa oli omundu mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.7",
            "verseOrgIds": [
              "1SA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo aababuusia alala e Beseki. Baba babaandu chielefu chimia chitaru khukhwama mu Isiraeli. Ne babaandu ba Yuda baba chielefu kamakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.8",
            "verseOrgIds": [
              "1SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio baboolela barumwa babaama Yabesi bali, “Boolela babaandu ba Yabesi-Kileati muli, ‘Muchuli, khukhwola mwiangilwe, mukhabe mwasikulibwe.’ ” Nga barumwa ne bacha baboolela babaandu ba Yabesi, babaandu abo bekhoya lukali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.9",
            "verseOrgIds": [
              "1SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono babaandu ba Yabesi baboolela Nahasi bali, “Muchuli khukheaane khwiwe mala onyala wakhukhola nisio abona oli silayi khwiwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.10",
            "verseOrgIds": [
              "1SA.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.10",
            "verseOrgIds": [
              "1SA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bwasia, Saulo aara babaandu bewe mu bipupu bitaru. Mala becha akari we kambi makhelebeende. Beera Baamoni khukhwola mwiangilwe. Ne babarama basalaanila, buli mundu yeng'ene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.11",
            "verseOrgIds": [
              "1SA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.11",
            "verseOrgIds": [
              "1SA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio, babaandu bareeba Samweli bali, “Naanu ba balomile bali Saulo se aba omwami wefwe tawe? Reera babaandu abo mala khubeere.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.12",
            "verseOrgIds": [
              "1SA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.12",
            "verseOrgIds": [
              "1SA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali Saulo aaloma ali, “Se aliio omundu oleerwa endaalo yino tawe. Sikila endaalo yino eli niyo Wele Omunyali Owa Bioosi asikuliile Isiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.13",
            "verseOrgIds": [
              "1SA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli aaboolela babaandu ali, “Yiicha khuche e Kilikali mala khurakikhisie bubwami.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.14",
            "verseOrgIds": [
              "1SA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio babaandu boosi bacha e Kilikali mala ebweeneyo bakhola Saulo khuuba omwami ebweeni wa Wele Omunyali Owa Bioosi. Lundi ebweeneyo bakhola chimbosio che biianwa bie kumuleembe ebweeni wa Wele Omunyali Owa Bioosi. Mala lundi ebweeneyo Saulo ne Baisiraeli boosi bekhoya lukali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.15",
            "verseOrgIds": [
              "1SA.11.15"
            ]
          }
        }
      ]
    }
  ],
