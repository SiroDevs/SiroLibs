              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila Wele Omunyali Owa Bioosi ambooleele ali, “Mu siise sie kumwiiko mulala khuloondekhana ne khubala khwe kimiiko kio mukholi, luyali lwa Kedari lwoosi luliakama. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.16",
            "verseOrgIds": [
              "ISA.21.16"
            ]
          }
        },
        {
          "name": "verse",
