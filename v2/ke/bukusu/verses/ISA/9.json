              "type": "text"
            }
          ]
        },
        {
          "text": "Mu siise sisiabira Wele areerera sibala sie kholo eya Sebuluni ne kholo eya Nafutali chisoni ne mu siise simaliilisi alireera lukoosi lukali mu bibala bino, khukhwama khu nyanja eya Shamu khukhwola sie ngelekha owa Yoritani, akhaba Kalilaya sisiene nisio baakwa bamenyilemo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wele Omunyali Owa Bioosi aliukuuma Isiraeli",
          "type": "text"
        }
      ]
