              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola sibala sia Babiloni! Bano nibo bachana se baba ba Ashuru tawe. Balekha chisaang'i chebwaakala lukoba lwa Tiro, bombakha chindeleelwa chabwe bosia abuundu wabwe babunia lukoba lwa Tiro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
