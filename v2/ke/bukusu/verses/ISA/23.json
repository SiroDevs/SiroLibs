              "ISA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siise silikho siicha nisio Tiro lucha khwibililwa khulwe kimiiko kamakhumi saba, siise sie bulamu bwo mwami. Nga kimiiko ekio ne kiliwa, kaliekholekhana khu Tiro nga kumwenya kwo omueeyi kuboola kuli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        }
      ]
    },
    {
