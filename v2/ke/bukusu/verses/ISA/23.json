              "ISA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga kimiiko kamakhumi saba ne kiliwa Wele Omunyali Owa Bioosi alikhebulila Tiro mala alilulekhuula lukobole khu bwofuli bwalwo, mala lulikhola bueeyi ne bubwami bwe sibala sioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chirupia nicho lulinyoola khulwe bubwofuli chilireebwa alubeka khulwe khuchiaana khu Wele Omunyali Owa Bioosi. Selulibiikha mwibiikhilo tawe, ne abo basaaya Wele Omunyali Owa Bioosi balirumikhira chirupia chalwo khulwe khukula biakhulia ne chingubo nicho benya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        }
      ]
