          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo nibwo burume nibwo Wele Omunyali Owa Bioosi aana khulwa Moabu mu ndaalo chichabira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne luno Wele Omunyali Owa Bioosi aboola ali, “Mu miiko kitaru nga kimiiko kio mukholi, efuma eya Moabu eliaambwa chisoni, yakhaba ne babaandu bakali balirama batiiti lundi batekhele.”",
          "type": "text",
          "attrs": {
