                "loc": "JER.51.48"
              },
              "items": [
                {
                  "text": "Yer. 51.48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Likulu, sangaala, sikila khukhwonakwa khwalwo! Batakatifu ba Wele, barumwa ne bang'oosi sangaala! Sikila Wele akhalakile omukhasi oyo sikila niko aamukholela enywe!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
