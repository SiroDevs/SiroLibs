        },
        {
          "text": "Se nabona Lukaangu mu lukoba tawe, sikila Lukaangu lwalwo luli Omwami Wele Owanyala bioosi ne Limeeme. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.22",
            "verseOrgIds": [
