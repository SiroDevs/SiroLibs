              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.17"
              },
              "items": [
                {
                  "text": "Isa. 65.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.22"
              },
              "items": [
                {
                  "text": "66.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.13"
              },
              "items": [
                {
                  "text": "2 Pet. 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio, nabona likulu liiya ne sibala siiya. Likulu lie khunyoa ne sibala sie khunyoa biabira, mala enyanja yatambao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.1"
              },
              "items": [
                {
                  "text": "Isa. 52.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.10"
              },
              "items": [
                {
                  "text": "61.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "Lif. 3.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lundi nabona lukoba lutakatifu, nilwo Yerusalemu, luya, ne lwikha khukhwama mwikulu wa Wele, lwefwarire lwerekekhe nga omwea nacha khukhwakanila omuseecha wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "Esek. 37.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.11+LEV.26.12"
              },
              "items": [
                {
                  "text": "Bal. 26.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naulila kumumilo kwe angaaki kumuboofu ne kuloma khukhwama mu ndebe eye bubwami kuli, “Lola! Bumenyo bwa Wele buli mu baandu! Alamenya nabo, mala balaba babaandu bewe. Wele omwene alaba nabo lundi alaba Wele wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "Isa. 25.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.10"
              },
              "items": [
                {
                  "text": "35.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.19"
              },
              "items": [
                {
                  "text": "65.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Alabeeya kamasika koosi sia moni. Lifwa se lilibao lundi tawe, lisooma, namwe khulila namwe buchuuni tawe. Sikila bibiindu bie khaale biabirire.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio, oyo owikhaale khu ndebe eye bubwami aloma ali, “Ne luno ese khola bibiindu bioosi khuba biiya!” Lundi aamboolela ese ali, “Andika kano, sikila kamakhuwa kano kali ka ng'ali, lundi kanyala khusuubilwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.5",
            "verseOrgIds": [
              "REV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isa. 55.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio aamboolela ali, “Kakholekhe! Ese ndi owe khunyoa lundi omumaliilisi. Khuyo oli ne bulesia ndamua bunyali khunywa kameechi khukhwama mu sebele eye kameechi ke bulamu niko akharuunga tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
            "verseOrgIds": [
              "REV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.14"
              },
              "items": [
                {
                  "text": "2 Sam. 7.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.27+PSA.89.28"
              },
              "items": [
                {
                  "text": "Chiny. 89.27-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abo baula balinyoola kumuruuru kuno khukhwama khwise: Ese ndiba Wele wabwe ne nabo baliba babaana base. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
              "REV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali baari, bachongani, batiimia, babeeri, be sifwaabi, bafumu, basaayanga bifwaani, ne babeeyi boosi, abuundu wabwe aliba mu nyanja eye kumulilo kumubuusi; lino nilio lifwa lia khabili.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lukoba luya lwa Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulala khu malaika saba, ba baaba ne bibuumba saba, bibiechula lufu chingano saba, chimaliilisi echa mala aamboolela ali, “Khowiche mala kane khwekesie Omwea, omukhasi owe Limeeme.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.9",
            "verseOrgIds": [
              "REV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.2"
              },
              "items": [
                {
                  "text": "Esek. 40.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Roho amwichamo mala malaika aasuta ese aaniinia khu sikulu sileeyi lukali. Anjokesia Yerusalemu Lukoba Lutakatifu, lulwaba ne lwikha khukhwama mwikulu wa Wele, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.10",
            "verseOrgIds": [
              "REV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "lwakhosia ne luyali lwa Wele. Lukoba lwakhosia nga libaale lie bukusi bukali, nga libaale liwaanga limelamela nga sikioo ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.30+EZK.48.31+EZK.48.32+EZK.48.33+EZK.48.34+EZK.48.35"
              },
              "items": [
                {
                  "text": "Esek. 48.30-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lwaba ne lisiisi liboofu lileeyi, lie bilibwa ekhumi na bibili, ne malaika ekhumi na babili baliinda bilibwa ebio. Khu bilibwa kamasina ke chikholo ekhumi na chibili che babaana ba Isiraeli kaandikwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.12",
            "verseOrgIds": [
              "REV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lubeka lwaba ne bilibwa bitaru; ebukwe bitaru, ebunaswa bitaru, siafubo bitaru, ne mumbo bitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
              "REV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiisi lie lukoba liombakhwa khu misiingi kie kamabaale ekhumi na kabili ne khu nikio, kamasina ke barumwa be Limeeme kaandikwakho, ekhumi na kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.3"
              },
              "items": [
                {
                  "text": "Esek. 40.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Malaika chana owalomalomanga ne nase aba ne lusaala lwe sahabu lwe khupiima lukoba, bilibwa bialwo, ne lisiisi lialwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukoba olwo lwalekhaana chimbeka choosi, bubalaayi ne buleeyi bwalwo. Malaika chana apiima lukoba chana ne lusaala lwe khupiima; lwaba buleeyi chikilomita chielefu chibili ne chimia chine, ne bukhiikha balwo ne khucha mu ngaaki bialekhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika chana apiima lisiisi lioosi, liaba chimita kamakhumi sita khucha angaaki, khuloondekhana ne sikelo sie khupiima nisio arumikhiranga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.17",
            "verseOrgIds": [
              "REV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.11+ISA.54.12"
              },
              "items": [
                {
                  "text": "Isa. 54.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lisiisi elio liaba liombakhwa ne kamabaale ke bukusi bwe angaaki kamanapenda kamelamela, ne lukoba lulwene lwaba lwombakhwa ne sahabu engwalaafu nga sikioo similiiu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
              "REV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamabaale ke kumusiingi kwe lisiisi lie lukoba kaba kang'oonwa mu ngila endayi eye kamabaale ke khurobarobana ke bukusi bwe angaaki. Libaale lie lukhelela lwe khunyoa mu musiingi liaba libuusi elala, lia khabili liaba lie kamabuusi, lia khataru likokhakokhe, lia khane libookha, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.19",
            "verseOrgIds": [
              "REV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "lia kharaano libuusi lifulaafulane, lia sita libesemu, lia saba linapenda, lia munaane liaba libuusi libookha, lia tisa liaba likokhakokhe, lie khumi liaba lifwaana lufutu, lie khumi na lulala liaba lia mayayi nga liki, lie khumi na chibili liaba linakhanyuusi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
