              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilibwa ekhumi na bibili ebio biaba chisiimbi ekhumi na chibili. Ne buli silibwa silala siakholwa khukhwama mu siimbi ndala. Engila eye mu lukoba yaba eye sahabu engwalaafu nga sikioo sing'enang'ena.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
            "verseOrgIds": [
              "REV.21.21"
            ]
          }
        }
      ]
