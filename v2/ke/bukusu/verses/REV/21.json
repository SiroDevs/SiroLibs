                  "text": "Isa. 60.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bilibwa bie lukoba bilirama khwasie endaalo yoosi; se biliikalwa tawe, sikila siilo se silibayo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
