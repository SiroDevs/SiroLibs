                  "text": "Isa. 60.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lukoba olwo se lwenya enyanga namwe, kumwesi khu lukhosiakho tawe. Sikila luyali lwa Wele lulukhosiangakho, ne Limeeme nilio etaa yalwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
          }
