                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ne oyo ooli ne kamaru, arekereesie niko Roho aboolela chikanisa!",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
