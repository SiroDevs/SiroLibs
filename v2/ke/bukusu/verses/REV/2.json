          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Khwaabo balaula ndabafukiilila khulia kamatuunda ke kumurongooro kwe bulamu kuli mu Paratiso eya Wele.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
