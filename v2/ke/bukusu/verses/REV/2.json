          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ngila ng'eneyo ne ng'ene muli ne babaandu akari wenywe baloondanga kamekisio ke Banikolayi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono yikanila mulekhe bubwoni bwenywe! Mwaba ne mukhakhola murio tawe, ndecha khangu mala ndumikhire embalu eyaama mukhanwa mwase khu khuupana ne babaandu abo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        }
      ]
    },
