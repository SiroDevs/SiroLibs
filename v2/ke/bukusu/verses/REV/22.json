              "items": [
                {
                  "text": "Yer. 17.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu aloma ali, “Rekeeresia! Oli omutakatifu khukhwola achiililile khuba omutakatifu! Ndikho nicha bwangu! Ndareera kumuruuru kwase, ndunge buli mundu khuloondekhana ne bikholwa biewe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
