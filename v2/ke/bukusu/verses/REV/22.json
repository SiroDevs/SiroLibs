              },
              "items": [
                {
                  "text": "48.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ese ndi Alufa ne Omeka, owe khunyoa ne khumaliilikha, owe khurakikha ne khutabusia.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
