              "items": [
                {
                  "text": "Isa. 42.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bemba kumwenya kumuya bali:",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
