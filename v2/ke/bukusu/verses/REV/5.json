              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio naulila buli sibuumbe mwikulu, khu sibala, mu sibala sie aasi ne mu nyanja, bibuumbe bilamu bioosi mu limala lioosi biembanga bili;",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
      ]
