              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino lienyekhana limanya. Yesi yesi oli omukesi anyala akanakana sifuno sie namba eye saang'i yino. Sikila enamba yino yimeelela lisina lio mundu. Enamba yino eli 666.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.18",
            "verseOrgIds": [
              "REV.13.18"
            ]
          }
        }
      ]
    }
