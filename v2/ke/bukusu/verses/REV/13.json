                "loc": "DAN.7.8"
              },
              "items": [
                {
                  "text": "Dan. 7.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "11.36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Esaang'i chana yaebwa kumunwa khuloma ke khukhwefumia eng'ene ne khukhoma Wele, mala yafukiililwa khuba ne bunyali khu miesi kamakhumi kane na kibili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.5",
            "verseOrgIds": [
              "REV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarakikha khulaama Wele, lisina liewe, abuundu niio amenyile, nende abo boosi bamenyile mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.6",
            "verseOrgIds": [
              "REV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Dan. 7.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yafukiililwa khu khupana ne babaandu ba Wele ne khubaula, lundi yaebwa bunyali khu buli luuya, ekholo, lulomo, ne babaandu babaandi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.7",
            "verseOrgIds": [
              "REV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Chiny. 69.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Babaandu boosi bamenyile mu sibala bakhakisaaye, khurusiakho abo nibo kamasina kabwe kaandikwa mu sitabu sie bulamu sie Limeeme lilieerwa sibala ne sikhabaang'anwa tawe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rekeeresia nono, omundu aaba ne ali ne kamaru khaulile! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.9",
            "verseOrgIds": [
              "REV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Yer. 15.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.11"
              },
              "items": [
                {
                  "text": "43.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesi yesi okhoyeele khuambwa ng'ali akhaambwe; oyo okhoyeele khukhwirwa ne mbalu akheerwe ng'ali ne mbalu. Kano kenya liliekhaliilikha ne lisuubila khu baandu ba Wele.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio nabona esaang'i ekiindi yama aasi mwiloba. Yaba ne chinjika chibili nga chinjika che Limeeme, lundi yalomaloma nga kuremu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.11",
            "verseOrgIds": [
              "REV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarumikhira bunyali bukali bwe esaang'i eye khunyoa, ebweeni wayo, yayingiilila sibala nende abo boosi bamenyilemo basaaye esaang'i eye khunyoa, eye likuma liliaba ne liionile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.12",
            "verseOrgIds": [
              "REV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esaang'i eya khabili yino yakhola kamayia ke khuukia; yakhola kumulilo kwekha khukhwama mwikulu kwola khu sibala ebweeni wa buli mundu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
            "verseOrgIds": [
              "REV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi yabea babaandu boosi bamenyile khu sibala mu ngila eye kamayia niko yafukiililwa khukhola ebweeni we esaang'i eye khunyoa. Esaang'i yaboolela boosi khukhwombakha sifwaani khulwe khuana lukoosi khu saang'i yaba ne remirwe ne mbalu mala yaba esiili enamu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.14",
            "verseOrgIds": [
              "REV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esaang'i eya khabili yafukiililwa khuela kumuuya kwe bulamu mu sifwaani sie saang'i eye khunyoa, nio sifwaani sinyale khulomaloma mala siire abo boosi bakhenya khusisaaya nisio tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.15",
            "verseOrgIds": [
              "REV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esaang'i chana yayingilila babaandu boosi, batiiti ne bakhoongo, baiinda ne bataambi, nasioobi ne balekhuule, khura simanyisio khu mikhono kiabwe kimiseecha namwe khu bweni bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.16",
            "verseOrgIds": [
              "REV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se aabaao akhaba mulala owanyala khukula namwe khukusia nakhali ne simanyisio sino tawe, lili, lisina lie saang'i namwe enamba eboola lisina liayo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
