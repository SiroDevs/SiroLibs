                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.25"
              },
              "items": [
                {
                  "text": "Lk. 21.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lundi nabona Limeeme chana liekula kumuuri kukhola sita. Literema liboofu lie sibala liabao ne enyanga yamaliia ti nga embilo, ne kumwesi kwakaluukhanila elala kwekela kumubesemu pe nga kamafuki. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Isa. 34.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ching'enieesi chakwa khu sibala nga chinduli chimbisi ne chikwa khukhwama khu mutuli ekhungu engali ne ucha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.20"
              },
              "items": [
                {
                  "text": "Lif. 16.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Likulu liakoriokha nga sitabu nisio baulukuuse ne buli sikulu ne likenga biarusibwa niio bibechanga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.19"
              },
              "items": [
                {
                  "text": "Isa. 2.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio babaami be khu sibala ne baruki, bakhulu be liie, baiinda nende be bunyali ne babaandu babaandi boosi, nasioobi ne balekhuule, bekisa mu mabina ne mu mbangaachi mwe chinyaanda ne khu bikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 6:16"
          },
          "items": [
