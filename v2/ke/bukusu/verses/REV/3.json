              "items": [
                {
                  "text": "Lk. 12.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abo baula balafwarwa mu waanga; mala se ndarusia kamasina kabwe mu sitabu sie balamu tawe. Ebweeni wa Paapa ne bweni wa malaika bewe ndabeyama abuwaanga ndi bano bali babaase.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        }
