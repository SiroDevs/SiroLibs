        },
        {
          "text": "“Khu malaika oli mu kanisa mu Sarite andika oli:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.1",
            "verseOrgIds": [
              "REV.3.1"
            ]
          }
        }
