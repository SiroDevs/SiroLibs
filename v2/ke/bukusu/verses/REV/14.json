              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi nabona malaika okundi arura mu lukaangu mwikulu, mala yesi aba ne engeso enjoki.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
