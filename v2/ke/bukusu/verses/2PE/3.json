            "verseId": "2PE.3.8",
            "verseOrgIds": [
              "2PE.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.90.4"
              },
              "items": [
                {
                  "text": "Chiny. 90.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne mukhebilila siindu silala basaale base basiime tawe! Khu Wele endaalo ndala eli nga kimiiko eelefu, ne kimiiko eelefu nga endaalo ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.8",
            "verseOrgIds": [
              "2PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami se ali kalaa khukhola nisio alakiilisia nga balala ne bebaasia tawe. Ne kakhali amwekhaliilikha enywe, sikila se eenya yesi yesi khubunisibwa tawe, ne kakhali eenya boosi bekanile.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.9",
            "verseOrgIds": [
              "2PE.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
