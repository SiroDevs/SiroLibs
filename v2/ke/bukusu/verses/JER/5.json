              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne akhaba mu ndaalo echo, Wele Omunyali Owa Bioosi aloma ali, se alimubunisilia elala tawe ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.18",
            "verseOrgIds": [
              "JER.5.18"
            ]
          }
        },
        {
