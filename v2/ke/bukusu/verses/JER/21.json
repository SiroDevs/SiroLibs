              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami Sedekia owa Yuda aruma Pashihuri okhwa Kwini no musaayi Sefania okhwa Maseyi khwise ne burume buno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
