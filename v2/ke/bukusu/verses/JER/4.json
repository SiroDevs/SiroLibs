            "number": "8",
            "style": "v",
            "sid": "JER 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.8",
            "verseOrgIds": [
              "JER.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aaloma ali, “Khu ndaalo eyo bunyindaafu bukhawe mu baami ne babemeelesi babwe, basaayi bakhesiindukhe ne bang'oosi bakharangararwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio ese naloma ndi, “Aa, Omwami WELE, ng'ali ewe wabeyile babaandu bano lukali, ne Yerusalemu ne oloma oli, ‘Mulaba ne kumuleembe’ ne eyi lifwa liaboolilekho.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiise esio babaandu bano nende be mu Yerusalemu baliboolelwa bali, “Ekhuungu embile khukhwama khu bikulu bibiomu mu siangalaamwe elauucha elole niio babaandu ba Wele Omunyali Owa Bioosi bali. Se eli eye khubisia likhuchi namwe eye khuseesa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli ekhuungu engali khukhilakho yino, yiicha sikila ese luno Wele Omunyali Owa Bioosi ndalomaloma bukhalaki bwase khu nibo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lukoba lwa Yuda lwakariirwe ne basiku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bubeeleli bwa Yeremia khulwe babaandu bewe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamalola ka Yeremia ke liilionakwa lilikho liicha",
          "type": "text"
        }
      ]
    }
  ],
