            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.31+2KI.23.32+2KI.23.33+2KI.23.34"
              },
              "items": [
                {
                  "text": "2 Bab. 23.31-34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.1+2CH.36.2+2CH.36.3+2CH.36.4"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 36.1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sikila Wele Omunyali Owa Bioosi aloma ali, khuloondekhana ne Yoahasi okhwa Yosia omwami owa Yuda, owamiia mu bweyaangu bwa raraawe Yosia mala arura ano. “Sakhakobole ano lundi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali akhafwiile abuundu niio bamuyilile mu mbaambe, ne se akhabone sibala sino lundi tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Burume bwa Yeremia khu Yoakimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremia aboola butinyu bukheeche khu Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bukhalaki bwa Wele khu Yehoyakini",
          "type": "text"
        }
      ]
    },
