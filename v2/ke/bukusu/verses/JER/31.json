          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi areeba ali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.20",
            "verseOrgIds": [
              "JER.31.20"
            ]
          }
        }
