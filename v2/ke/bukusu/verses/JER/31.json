            "sid": "JER 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi, Wele owa Isiraeli aloma ali, “Lundi bakharumikhire kamakhuwa kano mu sibala sia Yuda ne mungoba chasio ne malile khubakoboselia bulayi bwabwe. Bakhalome bali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.23",
            "verseOrgIds": [
              "JER.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Lola chindaalo chilikho chiicha nicho ese nja khutasa be nju eya Isiraeli ne be nju eya Yuda, balasaalana babe bakali lundi bibiaayo biabwe bilasaalana bibe bikali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.27",
            "verseOrgIds": [
              "JER.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biise biliola nibio, bulayi bwene nga nabaloleelesia khulwe khubarusiao, khubasalanisia, khubakwisia ne khubonaka, ne khureera bumayaanu, akhaba lundi khabaloleleesie khulwe khubombakha ne khubabiaala. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.28",
            "verseOrgIds": [
              "JER.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.2"
              },
              "items": [
                {
                  "text": "Esek. 18.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siise esio ne siicha babaandu se bakhalome bali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.29",
            "verseOrgIds": [
              "JER.31.29"
            ]
          }
        }
