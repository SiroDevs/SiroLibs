    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Buyiinda bwe babaandu ba Wele mu ndaalo chichiicha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
