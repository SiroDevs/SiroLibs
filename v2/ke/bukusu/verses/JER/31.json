    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Siisa sia Wele Omunyali Owa Bioosi khu Isiraeli",
          "type": "text"
        }
      ]
    },
    {
