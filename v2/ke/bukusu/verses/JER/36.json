                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan. 1.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwiiko kukhola khane kwa Yehoyakimu, okhwa Yosia, omwami owa Yuda, Wele Omunyali Owa Bioosi aboolela Yeremia ali, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.1",
            "verseOrgIds": [
              "JER.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bukula sitabu mala oandikemo kamakhuwa koosi niko ese khuboleele khuloondekhana ne Yuda ne Isiraeli ne chikholo choosi. Andika buli siindu nisio khuboleele khukhwama khale mu ndaalo nicho Yosia abeelakho omwami khukhwola luno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.2",
            "verseOrgIds": [
              "JER.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khola orio nio wakana babaandu ba Yuda baulile kamabi koosi niko nenya khubakhola wakana buli mundu alekha liba liewe limayaanu mala ese mbabeele bumayaanu ne bubwoni bwabwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yeremia alanga Baruku okhwa Neria, mala amuboolela koosi niko Wele Omunyali Owa Bioosi aaba ne amuboleele. Baruku akaandika koosi mu sitabu nga Yeremia amuboolelanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yeremia aboolela Baruku ali, “Ese nakhingiliilwe khukhwingila mu Lukaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono ewe olacha, mala khu ndaalo eye khunyoa eye khukhweyimana khulia, osomele mu Lukaangu kamakhuwa ka Wele Omunyali Owa Bioosi niko khuboleele waandika, babaandu boosi ne barekeeresie. Akhaba lundi okhasomele babaandu ba Yuda barurire mu ngoba chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khola orio nio wakana basaba mala Wele Omunyali Owa Bioosi aulila lundi wakana buli omundu alekha liba liewe limayaanu, sikila lirima ne bukhalafu nibwo Wele Omunyali Owa Bioosi alomile khu baandu bano buli bukali.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Baruku okhwa Neria akhola koosi bulayi bwene nga omung'oosi Yeremia ne aba namulakilisie. Asomela mu Lukaangu kamakhuwa ka Wele Omunyali Owa Bioosi khukhwama mu sitabu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwiiko kukhola kharaano kwa Yehoyakimu okhwa Yosia nga omwami owa Yuda, mu mweesi kwa tisa, babaandu boosi mu Yerusalemu ne babaandu boosi babarama mu ngoba cha Yuda bacha Yerusalemu balangiliila lilieyimana ebweeni wa Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Baruku asoma kamakhuwa ka Yeremia khukhwama mu sitabu. Asomela mu Lukaangu, mu lusiro lwa Kemaria okhwa Siafani, (Siafani aba omuandiki we mu luuya lwo mwami.) Lusiro olwo lwaba khu luuya luboofu, abwingililo bwe silibwa siyia sienju ya Wele Omunyali Owa Bioosi. Baruku asoma kamakhuwa kano babaandu boosi ne barekeeresie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babemeelesi basomelwa sitabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Mikaya okhwa Kemaria, omwichukhulu owa Siafani, aulila kamakhuwa ka Wele Omunyali Owa Bioosi koosi khukhwama mu sitabu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekha acha munju yo mwami mu lusiro lwo muandiki, ne babemeelesi boosi baba bekhaale mumwenomu. Baaba Elisiama omuandiki, Delaya okhwa Shemaya, Elinatani okhwa Akibori, Kemaria okhwa Siafani, Sedekia okhwa Hanania ne babemeelesi boosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.12",
            "verseOrgIds": [
              "JER.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Mikaya ababoolela kamakhuwa koosi niko aba ne nauliile Baruku ne asoma sitabu babaandu boosi ne barekeeresie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.13",
            "verseOrgIds": [
              "JER.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio babemeelesi boosi baruma Yehuti okhwa Netania (Netania aba okhwa Selemia, ne Selemia aba okhwa Kushi) aboolele Baruku ali, “Bukula sitabu nisio osomeele babaandu mala wiche.” Nio Baruku okhwa Neria abukula sitabu mala acha niio babemeelesi baba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.14",
            "verseOrgIds": [
              "JER.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamuboolela bali, “Yikhala asi mala okhusomele.” Nio Baruku abasomela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.15",
            "verseOrgIds": [
              "JER.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga baulila kamakhuwa koosi, balolana buli omundu khu wasie mala baba ne buri. Nio baboolela Baruku bali, “Khukhwola khuboolele omwami kamakhuwa kano koosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.16",
            "verseOrgIds": [
              "JER.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio bareeba Baruku bali, “Khuboolele, oandike oriena kamakhuwa kano koosi? Yeremia niye okhuboolelenge ne ewe oandika?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruku abakobosia ali, “Yee amboolelenge kamakhuwa kano koosi ne ese ngaandika ne bubwino mu sitabu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio babemeelesi baboolela Baruku bali, “Cha mala mwekise, ewe ne Yeremia ne omundu yesi yesi akhamanya niio muli tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omwami osia sitabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio babemeelesi bacha khu luuya niio omwami aba. Baaba babikhile sitabu mu lusiro lwa Elisiama, omuandiki, mala baboolela omwami kamakhuwa koosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.20",
            "verseOrgIds": [
              "JER.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omwami aruma Yehuti khureera sitabu, mala asibukula khukhwama mu lusiro mwa Elisiama omuandiki. Yehuti asomela omwami ne babemeelesi boosi ba baaba ne bemile ne khubotookhelela omwami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.21",
            "verseOrgIds": [
              "JER.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaba kumwesi kwa tisa ne omwami aba ekhaale munju eye siise sie kumunaane ne kumulilo kwe kamaanda kwaba ebweeni wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.22",
            "verseOrgIds": [
              "JER.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Yehuti ne asomanga buli chikaratasi chitaru namwe chine mu sitabu, omwami achikhalanga ne kumubano kumufumba, mala achimwaata mu mulilo, khukhwola nga sitabu sioosi ne siaya siawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.23",
            "verseOrgIds": [
              "JER.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhaba kario, omwami namwe mulala khu bakholi bewe babaulila kamakhuwa kano koosi, se baria namwe se bekesiakho liliekanila tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.24",
            "verseOrgIds": [
              "JER.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elinatani ne Tetaya ne Kemaria bekoonjelela omwami akhosia sitabu tawe, ne se arekeeresia tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.25",
            "verseOrgIds": [
              "JER.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omwami alaka Yeraimeeli, omusoleeli wewe, ne Seraya okhwa Asirieli ne Shelemia okhwa Abuteeli baambe Baruku omuandiki owa Yeremia no mung'oosi Yeremia omwene, ne kakhali Wele Omunyali Owa Bioosi abakisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremia aandika sitabu sisiindi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma wo mwami Yehoyakimu khukhwosia sitabu sie kamakhuwa niko Yeremia aboolanga ne Baruku aandika, Wele Omunyali Owa Bioosi aboolela Yeremia ali, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bukula sitabu sisiindi mala oandikemo kamakhuwa koosi kakabeele mu sitabu sie khunyoa, nisio Yehoyakimu omwami owa Yuda osiisie esio. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.28",
            "verseOrgIds": [
              "JER.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khu Yehoyakimu omwami owa Yuda loma oli, ‘Wele Omunyali Owa Bioosi aloma ali, “Ewe wosiisie sitabu sino noloma oli, siina sikila noandikemo oli omwami owa Babiloni ng'ali alecha onake sibala sino, mala eere babaandu ne chisaang'i chasio? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Wele Omunyali Owa Bioosi aloma ali khuloondekhana ne Yehoyakimu omwami owa Yuda, mbao omundu khu be lisaaye liewe olila khu bwami bwa Daudi tawe. Yehoyakimu akheerwe mala kumubili kwewe kubakalwe khu muumu ne mu bunyifu bwe siilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ese khamuelesie niye siiukuumo alala ne lisaaye liewe ne bakholi bewe khulwe butinyu bwabwe. Khabareerere busiku bwoosi nibwo naloma khu baandu ba Yuda, khu bamenywa ba Yerusalemu, ne se bambulila tawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yeremia abukula sitabu sisiindi aelesia Baruku omuandiki, okhwa Neria. Yeremia amuboolelanga kamakhuwa koosi kakaba mu sitabu nisio Yehoyakimu omwami owa Yuda aba ne osiisie, mala atasakho kakaandi kamakali kafwaanana ne nako, mala Baruku aandika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
    }
  ],
