        "style": "s1"
      },
      "items": [
        {
          "text": "Baruku asoma sitabu mu Lukaangu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
