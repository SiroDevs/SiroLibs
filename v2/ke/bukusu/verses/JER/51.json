          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko kamakhuwa ka Yeremia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
