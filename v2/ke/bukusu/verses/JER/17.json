            "number": "14",
            "style": "v",
            "sid": "JER 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola babaandu bandeeba bali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.15",
            "verseOrgIds": [
              "JER.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khutiila Lilaka lie Sabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi amboolela ali, “Cha wime mu Silibwa sie ekholo eya Benjamini, nisio babaami ba Yuda babiriranga ne bengila ne khurura mu lukoba. Cha mu bilibwa bie lukoba lwa Yerusalemu bioosi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.19",
            "verseOrgIds": [
              "JER.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala olome oli, ‘Ulila likhuwa lia Wele Omunyali Owa Bioosi enywe babaami ba Yuda ne babaandu ba Yuda mweesi ne bamenywa ba Yerusalemu, mubiriranga mu bilibwa bino.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.15+NEH.13.16+NEH.13.17+NEH.13.18+NEH.13.19+NEH.13.20+NEH.13.21+NEH.13.22"
              },
              "items": [
                {
                  "text": "Neh. 13.15-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wele Omunyali Owa Bioosi aloma ali, “Ba barekeerefu khulwe bulamu bwenywe ne mukhasutakho sisutwa khu ndaalo eya sabato namwe musibisilie mu bilibwa bie lukoba lwa Yerusalemu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.8+EXO.20.9+EXO.20.10"
              },
              "items": [
                {
                  "text": "Khur. 20.8-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Likh. 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne mukhasuta sisutwa khu ndaalo eye Sabato khukhwama munju yenywe, namwe mukhakhola kumulimo kwosi kwosi tawe, ne kakhali liinda endaalo eya Sabato ebe endakatifu, nga nalaka bakuuka benywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.22",
            "verseOrgIds": [
              "JER.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nibo se barekeeresia namwe baulila tawe, ne kakhali bakhola sileka bakhakhola bario baulila mala bakaanila kamekisio tawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne kakhali Wele Omunyali Owa Bioosi aloma ali, ‘Kaaba bali mundekeeresia mala mulekhe khusuta sisutwa mwingisie mu bilibwa bie lukoba luno khu ndaalo eya sabato, mulinde endaalo eya Sabato ebe endakatifu, lundi mulekhe khukhola kimilimo khu ndaalo ng'eneyo tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba babaami be lisaaye lia Daudi bakhengile mu bilibwa bie lukoba luno ne batimila khu makaari ne khu farasi. Akhaba babaana babwe, babaandu ba Yuda ne bamenywa ba Yerusalemu bosi bakhakhole bario. Nio lukoba luno lulamenywamo khulwa mindali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.25",
            "verseOrgIds": [
              "JER.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi babaandu balama mu ngoba cha Yuda ne birekere bibiakara Yerusalemu, khukhwama mu maloba ka Benjamini ne khukhwama Shefela khukhwama mu sibala sie bikulu, ne khukhwama ebunaswa owa Yuda. Bakhareere biianwa bie khukhwosia ne chimbosio, biianwa bie biakhulia ne bupani buunya bulayi ne khureera biianwa bie khusiima munju ya Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.26",
            "verseOrgIds": [
              "JER.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali enywe mwaba ne mukhandekeeresia, ne khuliinda endaalo eye Sabato mu butakatifu ne khulekha khusuta sisutwa ne khukhwingila nasio mu bilibwa bia Yerusalemu khu ndaalo eye sabato tawe, aba ndabwana kumulilo mu bilibwa bialwo mala kulaburukha buli abuundu mu Yerusalemu mala se kulasima tawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.27",
            "verseOrgIds": [
              "JER.17.27"
            ]
          }
        }
      ]
    }
