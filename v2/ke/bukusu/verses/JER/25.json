                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 36.5-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan. 1.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwiiko kukhola khane kwe bubwami bwa Yehoyakimu okhwa Yosia omwami owa Yuda nanyoola burume khukhwama khu Wele Omunyali Owa Bioosi khu baandu boosi ba Yuda (kumwenokwo kwaba kumwiiko kwe khunyoa kwo mwami Nebukadinesa omwami owa Babiloni) ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omung'oosi Yeremia aboolela babaandu ba Yuda boosi ne bamenywa ba Yerusalemu boosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababoolela ali, “Khulwe kimiiko kamakhumi kabili na kitaru khukhwamila khu mwiiko kwe khumi na kitaru kwe khukhwamiia khwa Yosia okhwa Amoni omwami owa Yuda khukhwola khu ndaalo yino Wele Omunyali Owa Bioosi amboolelanga ese elomo yewe mala ese muboolela buli busiele ne kakhali se mundekeresianga tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se mwarekeeresia namwe se mwaulila akhaba Wele Omunyali Owa Bioosi ne achiililila khumurumira enywe bakholi bewe bang'oosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bang'oosi bamuboolela enywe bali, ‘Luno buli mundu khwinywe akaluukhane khukhwama khu ngila yewe emayaanu ne bikholwa biibi mala amenye mu sibala nisio Wele Omunyali Owa Bioosi amuelesie enywe ne bakuuka benywe khukhwama khaale khulwa mindali na mindali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhacha khu bawele babaandi mwabakholela ne khubasaaya tawe, namwe mukhaambaambia lirima khulwe bikholwa bienywe tawe. Nio se ndamureerera kamabi tawe.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Ne kakhaba kario, se mwandekeresiisie tawe. Ne kakhali mwambambiisie lirima ne kimilimo kie kamakhono kenywe nio mwereerere mwabeene butinyu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Wele Omunyali Owa Bioosi aloma ali, “Sikila enywe se mwaria kamakhuwa kase tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lola ndalaanga chikholo che ebunaswa choosi, ne khulaanga Nebukadinesa, omwami owa Babiloni omukholi wase, ne ndabareera khukhupana ne sibala sino ne bamenywa bamwo, ne khukhupania chikholo che aembi choosi. Ndababunisilia elala mala mbakhole babe babi be khubiyilwa ne khukwa ne khulekwa mindali na mindali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.34"
              },
              "items": [
                {
                  "text": "Yer. 7.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.16.9"
              },
              "items": [
                {
                  "text": "16.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.22+REV.18.23"
              },
              "items": [
                {
                  "text": "Lif. 18.22-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khutasa khwako ndabarusiakho kumumilo kwe busangaafu, ne ekhoyo ne kumwenya kwe siselelo ne lisia lie lususi ne buwaanga bwe taa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.10",
            "verseOrgIds": [
              "JER.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 36.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "Yer. 29.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Dan. 9.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sibala sino sioosi silonakwa ne khukhwanjukhwa ne chikholo chino chilakholela omwami owa Babiloni khulwe kimiiko kamakhumi saba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.11",
            "verseOrgIds": [
              "JER.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio enyuma we kimiiko kamakhumi saba khareere siiukuumo khu mwami owa Babiloni ne sibala sie Bakalitayo sikila bumayaanu bwabwe mala khole sibala sianjukhwe khulwa mindali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.12",
            "verseOrgIds": [
              "JER.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khakhole khu sibala esio kamakhuwa koosi kamabi niko ndomile khu nisio, buli siindu sisiaandikwa mu sitabu sino, nisio Yeremia ang'oola khu kholo chino choosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.13",
            "verseOrgIds": [
              "JER.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila chikholo chingali ne babaami be bunyali bakhabakhole nasioobi mala ese khabaruungie khuloondekhana ne bikholwa biabwe ne kimilimo kiabwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bukhalaki bwa Wele Omunyali Owa Bioosi khu kholo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi, Wele owa Isiraeli aboolela Yeremia ali, “Bukula sikoombe sie ndali sisichuule lirima liase sino, mala onywesie chikholo choosi nicho ese khurumakho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balanywa bameele batalitaale ne khulalukha sikila liie nilio ese ndikho nduma khu nibo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Yeremia abukula sikoombe khukhwama mukhono mwa Wele Omunyali Owa Bioosi mala akhola chikholo choosi nicho Wele Omunyali Owa Bioosi amurumakho chanywelamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.17",
            "verseOrgIds": [
              "JER.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anywesia Yerusalemu ne chingoba cha Yuda, babaami ne babemeelesi khukhola chingoba chanjukhwe ne khutambamo omundu, khuba che khuuka ne lundi che silaamo, nga ne chili khukhwola luno.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.18",
            "verseOrgIds": [
              "JER.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.18",
            "verseOrgIds": [
              "JER.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi anywesia Farao, omwami owa Misiri, bakholi bewe, babemeelesi, ne babaandu bewe boosi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.19",
            "verseOrgIds": [
              "JER.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "anywesia ne bakeni bamenyile ne Farao boosi babaami be sibala sia Usi boosi, ne babaami ba Filisiti boosi (Ashikeloni, Kasa, Ekironi ne babarama mu Ashitoti), ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "anywesia Edomu, Moabu ne ba okhwa Amoni, alala ne ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.21",
            "verseOrgIds": [
              "JER.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "babaami ba Tiro boosi babaami ba Sidoni boosi ne babaami be sikelekha sie nyanja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
            "verseOrgIds": [
              "JER.25.22"
            ]
          }
        }
      ]
    },
