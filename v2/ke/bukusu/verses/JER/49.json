              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.16",
            "verseOrgIds": [
              "JER.49.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 49:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Libuna lilecha khu Edomu lilaba liboofu lundi liriisia, buli sia mulala obirao aliesiindukha mala auke. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.17",
            "verseOrgIds": [
              "JER.49.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 49:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24+GEN.19.25"
              },
              "items": [
                {
                  "text": "Lir. 19.24-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bibiindu bibiekholekha khu Sodomu ne Komora nibio bibieene bikhekholekhe khu Edomu. Chingoba echo ne chichaba siimbi chabuna. Se aliio olichimenyamo lundi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.18",
            "verseOrgIds": [
              "JER.49.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 49:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola lili nga etalang'i mu bichakha bia Yoritani ne yiicha khukhwebwaakala siko sie kamakheese sie kamaani. Nja khukhola Baedomu belukhe barure mu sibala siabwe, ne ndarobora omwami okona abamiie. Naanu oli nga ese? Naanu onyala wanjalaala ese? Omwaayi aliio onyala ambingania ese ku? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.19",
            "verseOrgIds": [
              "JER.49.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 49:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako ulila lirekekha nilio ese Wele Omunyali Owa Bioosi ndekeekhe khu Edomu ne niko mbisiisie khukhola khu baandu be lukoba lwa Temani. Akhaba babaana bosi balatiilwa. Buli mundu aliesiindukha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.20",
            "verseOrgIds": [
              "JER.49.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endaalo eye likwa lie babaandu ba Edomu, sibala siliterema mala khulila khwabwe khuliuliilikha khwole sia Nyanja Embesemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.21",
            "verseOrgIds": [
              "JER.49.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 49:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, omusiku alibwaakala Bosira, abambule chindaa chewe khu lukoba mala apurukhe khangu oli efuruusi. Ne endaalo eyo kimiooyo kie banamae ba Edomu kiliba nga kumwoyo kwo mukhasi olumwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.22",
            "verseOrgIds": [
              "JER.49.22"
            ]
          }
        }
      ]
    },
