          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.40",
            "verseOrgIds": [
              "JER.48.40"
            ]
          }
        }
