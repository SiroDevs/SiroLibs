          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilio liiandiko lilomalomangakho lili.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.33",
            "verseOrgIds": [
