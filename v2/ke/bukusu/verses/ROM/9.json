              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono khuboola khuli Be Chikholo, bakhakhakanga babeene khuba baluungi khu Wele tawe, bakholwa baluungi ne naye khubirira mu lisuubila, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.30",
            "verseOrgIds": [
              "ROM.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne babaandu ba Wele, babayiimanga lilaka bali libakhole baluungi ne Wele, se balinyoola tawe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
            "verseOrgIds": [
              "ROM.9.31"
            ]
          }
        }
      ]
    },
    {
