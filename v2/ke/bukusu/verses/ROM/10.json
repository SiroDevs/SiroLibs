          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.2"
              },
              "items": [
                {
                  "text": "Isa. 65.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne khuloondekhana ne Isiraeli aboola ali, “Endaalo yoosi nabalaya kamakhono kase khukhwakaanila babaandu be sileka lundi baandalafu mu miooyo.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.21",
            "verseOrgIds": [
              "ROM.10.21"
            ]
          }
        }
      ]
