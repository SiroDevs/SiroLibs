          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.21"
              },
              "items": [
                {
                  "text": "Likh. 32.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lundi ese ndeeba ndi. Babaandu ba Isiraeli se bamanyilisia tawe? Musa omwene niye owanyoa akobosia ali.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        }
      ]
    },
