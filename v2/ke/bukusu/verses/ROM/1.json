        },
        {
          "text": " mu bweyaangu bwe khusaaya Wele omenyile mindali khulwa mindali na mindali basaaya bifwaani bibiang'oonwa biafwaana nga omundu, chinyuni, chisaang'i namwe chimbulu ne chindemu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
