        },
        {
          "text": "Baandu ba Isiraeli, rekeeresia burume buno nibwo Wele Omunyali Owa Bioosi alomile khwinywe, ekholo yoosi niyo aarusia e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumulimo kwo Mung'oosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libuna lia Samaria",
          "type": "text"
        }
      ]
    },
