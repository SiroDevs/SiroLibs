          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bukusi bwoosi bularebwao khuloondekhane ne bukusi bubwafukiililwa ne Abuundu Atakatifu.",
          "type": "text",
          "attrs": {
