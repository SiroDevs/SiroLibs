                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Se aliio omundu onyala akusia, namwe akula sisiindu siosi siosi sisiianwa khu Wele Omunyali Owa Bioosi tawe, abele omundu namwe sisiaayo namwe kamaloba ke luuya. Sikila buli siianwa sili sitakatifu lukali khu Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi yesi oaanwa khubunisibwa se anyala asikulwa tawe, akhoya erwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
