            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aaboolela Musa ali, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.1",
            "verseOrgIds": [
              "LEV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Boolela babaandu ba Isiraeli oli, ‘Ese ndi Wele Omunyali Owa Bioosi, Wele wenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.2",
            "verseOrgIds": [
              "LEV.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhaloonda bikholwa bie Bamisiri niio mwamenyanga tawe, namwe bikholwa bie Bakanaani niio ndikho muyila tawe. Mukhaloonda kamalaka kabwe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.3",
            "verseOrgIds": [
              "LEV.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ria kamalaka kase mala mukaloonde. Ese ndi Wele Omunyali Owa Bioosi, Wele wenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.4",
            "verseOrgIds": [
              "LEV.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.29"
              },
              "items": [
                {
                  "text": "Neh. 9.29",
                  "type": "text"
                }
