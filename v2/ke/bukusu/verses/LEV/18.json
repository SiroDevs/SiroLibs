            }
          ]
        },
        {
          "text": " Okhakhola sifwaabi no museecha wasio tawe. Sikila luli luuswa lubi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
