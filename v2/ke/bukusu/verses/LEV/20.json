          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Omundu yesi yesi owe siikhasi namwe owe siseecha oli omulakusi namwe omulosi akhoya erwa. Bakhoya berwa ne kamabaale ne sifuki siabwe siliba khu beene.’ ”",
          "type": "text",
