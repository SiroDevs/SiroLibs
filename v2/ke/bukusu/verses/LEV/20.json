              },
              "items": [
                {
                  "text": "Mk. 7.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omwana yesi yesi olaama raraawe nanwe maawe aleerwa, sikila aba alaamile raraawe namwe maawe. Khwako alasuta sifuki siewe omwene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
