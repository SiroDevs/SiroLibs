                "loc": "LEV.18.9"
              },
              "items": [
                {
                  "text": "Bal. 18.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.22"
              },
              "items": [
                {
                  "text": "Likh. 27.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Omundu nayila wandaaye omukhaana we mumwabwe, namwe we khuluyia mala nakhola sifwaabi naye chili chisoni. Balarusibwa mu baana basiaabwe. Omwene alasuta luuswa lwewe ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.19"
              },
              "items": [
                {
                  "text": "Bal. 18.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omundu naba ne omukhasi oli mu ndaalo chewe chimbi, boombi batimanisibwa barure enje we kholo eya Isiraeli. Sikila baafunake kamalaka ke khukhweliinda mu bumiliiu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        }
      ]
    },
