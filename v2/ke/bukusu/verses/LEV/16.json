            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.26+LEV.23.27+LEV.23.28+LEV.23.29+LEV.23.30+LEV.23.31+LEV.23.32"
              },
              "items": [
                {
                  "text": "Bal. 23.26-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.7+NUM.29.8+NUM.29.9+NUM.29.10+NUM.29.11"
              },
              "items": [
                {
                  "text": "Khub. 29.7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ne lino likhabe lilaka khwise mindali, Khu ndaalo ekhola ekhumi, eye kumwesi kwa saba, mukheyimane mwabene lundi mulekhe khukholakho kumulimo kwosi kwosi, babele baakwa namwe basaalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu ndaalo eyo mukharusibwe khukhwama mu bwoni bwenywe bwoosi. Mukhatakaasibwe khukhwama mu bwoni bwenywe bwoosi ebweeni wa Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endaalo eyo elaba esabato endakatifu lukali eye khukhebulila, lundi eli endaalo eye khulola. Lili lilaka lia mindali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaayi owachukhwakho kamafura owarebwakho kumukhono ne khuroborwa abukule khukhwila mu bubweyaangu bwa raraawe alakhola kumulimo kwe khutakaasa. Alafwara chingubo che busaayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alatakaasa Abuundu Atakatifu Lukali, ne Liiema lie kumuse ne alutare, basaayi ne babaandu boosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino likhabe lilaka lia mindali khwinywe. Kumwiima kuno khukhwola kukholwe lulala khu mwiiko, khulwe babaandu ba Isiraeli, sikila bubwoni bwabwe bwoosi.” Nio Musa aakhola nga Wele Omunyali Owa Bioosi aba ne amulakile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    }
