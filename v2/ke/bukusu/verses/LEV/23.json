            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wele Omunyali Owa Bioosi aboolela Musa ali, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.26",
            "verseOrgIds": [
              "LEV.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Khu ndaalo eye khumi eye kumwesi kwa saba, eli endaalo eye khurusiao bubwoni. Ekhabe khwinywe endaalo eye libuusiana litakatifu. Ne lundi endaalo ng'eneyi mukhaliakho siindu tawe, yebuusia alala khu saaya mala muaane siianwa sie biakhulia khu Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.27",
            "verseOrgIds": [
              "LEV.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhakhola kimilimo kiosi kiosi khu ndaalo eyo tawe. Sikila eli endaalo eye khukhola kimilukha khurusiao bubwoni ebweeni wa Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.28",
            "verseOrgIds": [
              "LEV.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi yesi oliakho siindu siosi siosi khu ndaalo eyo se alabalikha khuba omundu owa Wele mu baandu bewe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.29",
            "verseOrgIds": [
              "LEV.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi yesi okhola kumulimo kwosi kwosi khu ndaalo eyo, Wele Omunyali Owa Bioosi omwene akhamwire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.30",
            "verseOrgIds": [
              "LEV.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilaka lino lili khulwe babaandu be lisaaye lienywe boosi khulwa mindali niio bamenyile osi osi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.31",
            "verseOrgIds": [
              "LEV.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu khwama nga enyanga ekwa endaalo eya tisa eye kumwesi khu khwola nga ekwa endaalo eye likhumi bukula endaalo yino khuba emboofu eye khuuluukha. Siise sino mbao siilibwa tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        }
      ]
