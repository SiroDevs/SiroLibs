                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Likh. 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muli ne chindaalo sita mu nicho munyala mwakholelamo kimilimo kienywe, ne kakhali khebulila endaalo ekhola saba, eli e sabato, eli endaalo eye khuuluukha. Khu ndaalo ng'eneyi mukhakhola kimilimo tawe, ne kakhali yebuusia alala khusaaya. Esabato eli ya Wele Omunyali Owa Bioosi, osi osi niio mumenyile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chino chili chi naikara chindobore cha Wele Omunyali Owa Bioosi, libuusia litakatifu, nicho mukhekesie mu biise bibiaroborwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Epasaka ne kumukaati kukhalimo limela tawe",
          "type": "text"
        }
      ]
    },
    {
