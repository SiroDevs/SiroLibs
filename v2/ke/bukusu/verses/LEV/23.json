            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Boolela babaandu Baisiraeli oli, chindaalo chicharoborwa che libuusiana litakatifu ne naikara eya Wele Omunyali Owa Bioosi, nicho chino: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        },
        {
