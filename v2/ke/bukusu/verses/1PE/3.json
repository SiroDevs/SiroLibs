        "style": "s1"
      },
      "items": [
        {
          "text": "Bakhasi ne baseecha babwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
