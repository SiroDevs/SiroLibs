              "attrs": {
                "loc": "ISA.53.9"
              },
              "items": [
                {
                  "text": "Isa. 53.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Se akholakho bubwoni bwosi bwosi tawe, ne se aliio owaulila bubeeyi ne bwama mukhanwa mwewe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
