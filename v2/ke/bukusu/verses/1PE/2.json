              "items": [
                {
                  "text": "Chiny. 118.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Libaale lino lili lie bukhala bukali khwinywe musuubila; nende khwaabo bakhasuubila tawe:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
