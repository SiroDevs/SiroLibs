              "items": [
                {
                  "text": "Isa. 53.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kristo omwene asuta bubwoni bwefwe khu mubili kwewe acha nabwo khu musalaba, nio khwolaane khulekha bubwoni mala khumenye khulwe buluungi. Ne khulwe kamakoonjo kewe, enywe mwaonile. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.24",
            "verseOrgIds": [
              "1PE.2.24"
