            }
          ]
        },
        {
          "text": " Kumumilo kwewe kwasisiikha sibala siise esio, ne kakhali luno asuubisie ali, “Khasisiikhe lundi sibala ne likulu liosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
