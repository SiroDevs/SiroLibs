              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yoshua alaanga alala babaandu be chikholo cha Rubeni, Kati, ne Manase, mala ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
