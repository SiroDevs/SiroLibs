          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meyarikoni, ne Rakoni, alala ne kamaloba kakaloleelelana ne Yopa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
