          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumukabwa kwa saba kwaba khulwe ekholo eya Dani khuloondekhana ne kimiliango kiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
          }
        },
