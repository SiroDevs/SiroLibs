            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.9",
            "verseOrgIds": [
              "JOS.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yoshua alaka babemeelesi ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.10",
            "verseOrgIds": [
              "JOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "khucha mu kambi. Baboolela babaandu bali, “Rekekha biakhulia sikila mu ndaalo chitaru mucha khwambukha luluuchi lwa Yoritani khuaamba sibala nisio Wele Omunyali Owa Bioosi, Wele wenywe alikho amuelesia enywe.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.11",
            "verseOrgIds": [
              "JOS.1.11"
            ]
          }
        }
      ]
    },
