              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banamae ba Shamu barekukha ne baumisie Yoashi lukali. Bakholi ba Yoashi bachongela Yoashi mala bamwirira khu sitanda siewe. Bamwiira sikila niye eera okhwa Yehoyata omusaayi. Nio Yoashi afwa mala bamusiikha mu Lukoba lwa Daudi. Ne kakhali se bamusiikha mu biliindwa bie babaami tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo babamuchongela baba Sabati okhwa Simeati, Omuamoni, ne Yehosabadi okhwa Shimuriti Omumoabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chingano che babaana bewe ne bung'oosi bukali khu niye, ne khukhwombakha lundi enju eya Wele, biaandikwa mu sitabu sisinoosia kamakhuwa ke mu sitabu sie babaami. Omwana wewe Amasia amiia mu bweyaangu bwewe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
      ]
