                "loc": "EXO.40.34+EXO.40.35"
              },
              "items": [
                {
                  "text": "Khur. 40.34-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwaba kumulimo kwe bakhupi be chikhoombi ne babembi be chinyimbo khukhola bauliilikhane nga kumumilo mulala mu khufumia ne khusiima Wele Omunyali Owa Bioosi. Lulwimbo kwauliilikhana, ne chikhoombi ne bibiindu bie khu khuupania alala mu nyimbo. Nio babembi be chinyimbo bafumia Wele Omunyali Owa Bioosi ne bemba bali:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
