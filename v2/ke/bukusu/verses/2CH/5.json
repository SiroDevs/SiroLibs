            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enju, enju eya Wele Omunyali Owa Bioosi yechula lifuumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio basaayi bakhilwa khukhwima bakhole kimilimo sikila lifuumbi. Sikila luyali lwa Wele Omunyali Owa Bioosi lwechusia enju eya Wele.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
      ]
