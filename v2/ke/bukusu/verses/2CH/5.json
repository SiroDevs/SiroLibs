                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1 Ke Ch. 15.25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio Solomoni alaanga alala basaakhulu ba Isiraeli, ne babemeelesi boosi be chikholo, nende be kimiliango kie chinju che Baisiraeli, bebuusia mu Yerusalemu. Abalaanga nio bareere Lisanduku lie ndakaano eya Wele Omunyali Owa Bioosi khukhwama mu lukoba lwa Daudi luli Sayuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baisiraeli boosi bebuusia ebweeni wo mwami Solomoni mu Naikara eye Bisali mu mweesi kwa saba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne basaakhulu Baisiraeli boosi beecha mala Balawi babukula Lisanduku lie ndakaano. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bareera Lisanduku lie ndakaano, liiema lie kumuse, ne bibiindu bitakatifu bioosi bibiaba mu Liiema. Basaayi ne Balawi nibo ba babisuta babireera. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami Solomoni ne libuusiana lie Baisiraeli boosi, ba baaba ne babuusiisie ebweeni wewe, baba ebweeni we Lisanduku lie ndakaano. Nio baana embosio eye kamakheese kamakali lukali ne chikhaafu chingali chikhabalikha tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio basaayi bareera Lisanduku lie ndakaano eya Wele Omunyali Owa Bioosi balingisia abuundu walio mu Lusiro lwe mukari lwe Lukaangu, Abuundu Atakatifu Lukali, asi we chindaa che chikerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikerubi chabalaaya chindaa chabwe angaaki we abuundu e Lisanduku lie ndakaano, nio chikerubi chakhola lulama khu ngaaki khwe Lisanduku lie endakaano ne kimirongooro kialio kie khusuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kimirongooro kiaba kimileeyi lukali nio emusia wakio khwabonekha khukhwama Abuundu Atakatifu mu lusiro lwe mukari lwe Lukaangu. Ne kakhali se kiabonekha khukhwama enje tawe. Ne kisiilio khukhwola khu ndaalo yino. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Likh. 10.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sisiindu se siaba mu Lisanduku lie ndakaano tawe, ne kakhali kamabaale kabili niko Musa araamo e Horebu niio Wele Omunyali Owa Bioosi akholela endakaano ne Baisiraeli, nga ne baba ne bama e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luyali lwa Wele Omunyali Owa Bioosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basaayi barura Abuundu Atakatifu. Basaayi boosi bababao baba betakaasile, ne se benana bubwaukhani bwe kimilimo kiabwe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Balawi babemba chinyimbo boosi, Asafu, Hemani ne Yedutuni, basoleeli babwe, ne balebe babwe befwara chingubo cha katani. Baba ne bibiindu bie khu khuupania alala mu nyimbo, biilili ne kamatuungu. Bema lubeka lwe bukwe we alutare alala ne basaayi emia ndala ne kamakhumi kabili, ba baaba bakhupi be chikhoombi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
