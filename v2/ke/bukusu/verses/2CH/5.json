              "items": [
                {
                  "text": "1 Ke Ch. 18.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khwako kimilimo kioosi nikio Solomoni aakhola khulwe enju eya Wele Omunyali Owa Bioosi kiawa. Ne Solomoni areeramo bibiindu nibio raraawe Daudi aaba ne ara alubeka khulwa Wele. Aabunga efwesa, esahabu ne bibiindu bioosi mu mabiikhilo ke Lukaangu lwa Wele.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisanduku lie ndakaano lireerwa mu Lukaangu",
          "type": "text"
        }
      ]
    },
    {
