                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.39"
              },
              "items": [
                {
                  "text": "29.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Likh. 16.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akhola ario nga kimilimo kia buli ndaalo ne kienyekha. Aana khuloondekhana ne lilaka lia Musa khulwe chisabato, kimieesi kimiya ne chinaikara chitaru che kumwiiko. Chinaikara chino chaba che kumukaati kukhalimo limela tawe, Naikara eye Likesa, ne Naikara eye Bisali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuloondekhana ne lilaka lia raraawe Daudi, Solomoni arobora bipupu bie basaayi khulwe kimilimo kiabwe. Lundi arobora bipupu bie Balawi khulwe kimilimo kiabwe kie khufumia ne kimilimo kikiindi ebweeni we basaayi, nga kimilimo kia buli ndaalo ne kienyekha. Ne arobora baliindi be bilibwa mu bipupu khuliinda bilibwa. Solomoni akhola ario khuloondekhana ne lilaka lia Daudi omundu owa Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne se baukhakho khukhwama khu niko Omwami aba ne alaka basaayi ne Balawi, khulwe sisiindu siosi siosi ne khulwe kamabiikhilo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
