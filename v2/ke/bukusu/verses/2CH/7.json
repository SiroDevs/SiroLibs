              "type": "text"
            }
          ]
        },
        {
          "text": " Nga Solomoni aamala lisaba liewe, kumulilo kwekha asi khukhwama mwikulu mala kwosia biianwa bie khukhwosia ne chimbosio. Luyali lwa Wele Omunyali Owa Bioosi lwechula mu Lukaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basaayi se banyala khukhwingila munju eya Wele Omunyali Owa Bioosi tawe, sikila luyali lwa Wele Omunyali Owa Bioosi lwechulamo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
