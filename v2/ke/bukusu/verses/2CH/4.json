        "style": "s1"
      },
      "items": [
        {
          "text": "Bibiindu bie mu Lukaangu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
