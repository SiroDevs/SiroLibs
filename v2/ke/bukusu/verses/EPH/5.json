              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakhasi khukhwola bariire elala baseecha babwe mu buli siindu nga e kanisa ne yaria Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
            "verseOrgIds": [
              "EPH.5.24"
            ]
          }
        }
      ]
    },
