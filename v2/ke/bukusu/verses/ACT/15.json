                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Omwami aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
