              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo nga ne amala khuloma kano Bayaudi barekukha ne bayingana burafu babeene ne babeene.]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
