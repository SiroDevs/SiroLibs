              "type": "text"
            }
          ]
        },
        {
          "text": " Wele aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.17",
            "verseOrgIds": [
              "ACT.2.17"
            ]
          }
        }
      ]
