            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.31"
              },
              "items": [
                {
                  "text": "Lk. 1.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enyuma we lichuuma lilala nga siise ne sioola sie khukheba omwana bamutiuukha bali Yesu. Lisina nilio malaika aaboolela maawe nakhamuesia tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ayilwa mu Lukaangu",
          "type": "text"
        }
      ]
    },
    {
