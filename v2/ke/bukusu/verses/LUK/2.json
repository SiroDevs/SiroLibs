                  "text": "Mat. 2.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nga Yosefu ne Maria ne bamala khukhola koosi kakenyekha kholoondekhana ne lilaka lio Mwami, bakobola engo wabwe mu lukoba lwa Nasareti mu Kalilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana achoa mala aaba ne kamaani, limanya likali, ne chikhabi cha Wele.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
