                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Siise nisio Yosefu ne Maria bakhoyeele babe bakwalaafu khuloondekhana ne Lilaka lia Musa, sioola. Nio babukula omwana bamuyila Yerusalemu khumuana khu Mwami, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
