          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ne Sakayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu engila mu Yeriko ne ali khu lukeendo lwewe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.1",
            "verseOrgIds": [
              "LUK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abao omuiinda bali Sakayo owaba omukhongo we khurosia busuuru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.2",
            "verseOrgIds": [
              "LUK.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekoomba khubona Yesu amanye ali omundu lukano siina, ne se anyala khumubona tawe sikila babaandu baba bakali, mala niye aba omwiimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.3",
            "verseOrgIds": [
              "LUK.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio atima ebweeni aniina khu mukhuyu nio amubone sikila Yesu aba alabirira khu ngila eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.4",
            "verseOrgIds": [
              "LUK.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Yesu ola a mukhuyu akalama angaaki, mala aboolela Sakayo ali, “Sakayo yiikha khangu, sikila endaalo yino khukhwola ningile munju mwowo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.5",
            "verseOrgIds": [
              "LUK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.5",
            "verseOrgIds": [
              "LUK.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Sakayo ekha khangu mala akaanila Yesu ne liliekhoya likali. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.6",
            "verseOrgIds": [
              "LUK.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu boosi ba babona barakikha khukhwelung'unya, ne baloma bali, “Omundu yuno achiile khuba omukeni wo mundu omwoni!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.7",
            "verseOrgIds": [
              "LUK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.7",
            "verseOrgIds": [
              "LUK.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakayo enyokha mala aboolela Omwami ali, “Lola Omwami, ndaelesia bataambi enusu eye kimiaandu kiase. Ne naaba ne nabea omundu yesi yesi khu siindu siosi siosi, ndamukoboselia sikelo esio khukhwola khane.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.8",
            "verseOrgIds": [
              "LUK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.8",
            "verseOrgIds": [
              "LUK.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu amukobosia ali, “Endaalo yino buonia bwechile munju yino, sikila omundu yuno yesi ali owe lisaaye lia Aburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.9",
            "verseOrgIds": [
              "LUK.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.11"
              },
              "items": [
                {
                  "text": "Mat. 18.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sikila Omwana wo Mundu echa khuyiima ne khuonia babatiba.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lukano lwe chirupia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.14+MAT.25.15+MAT.25.16+MAT.25.17+MAT.25.18+MAT.25.19+MAT.25.20+MAT.25.21+MAT.25.22+MAT.25.23+MAT.25.24+MAT.25.25+MAT.25.26+MAT.25.27+MAT.25.28+MAT.25.29+MAT.25.30"
              },
              "items": [
                {
                  "text": "Mat. 25.14-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nga babaandu baba ne barekereesie kano, Yesu achiililila ababoolela lukano. Sikila aba siimbi khwola Yerusalemu ne babaandu bebaasianga bali Bubwami bwa Wele bwaba siimbi khubonekha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio ababoolela ali, “Abao omukhongo owaba ne alikho acha mu sibala sie aleeyi anyoole bubwami, mala ne anyoolile bubwami obwo, akobole engo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.12",
            "verseOrgIds": [
              "LUK.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakharekukha tawe, alaanga bakholi bewe ekhumi mala abaelesia chirupia, ababoolela ali, ‘Nyoola bukhala mu rupia chino nabwila ngobola.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.13",
            "verseOrgIds": [
              "LUK.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu be mu sibala siewe bamubiila, nio baruma bakholi enyuma wewe bali, ‘Se khwenya omundu yuno akhwamiie tawe.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.14",
            "verseOrgIds": [
              "LUK.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.14",
            "verseOrgIds": [
              "LUK.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omundu oyo akholwa omwami mala akobola engo. Arusia lilaka khangu bakholi nibo aelesia chirupia balangwe amanye bukhala nibwo baba ne banyoolile. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.15",
            "verseOrgIds": [
              "LUK.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owe khunyoa echa ebweeni wewe amuboolela ali, ‘Omwami, erupia niyo wambelesia yareerire bukhala bwe chichiindi ekhumi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.16",
            "verseOrgIds": [
              "LUK.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami oyo aboolela omukholi ali, ‘Oli omukholi omulayi, wakholile bulayi! Sikila wabele omusuubilwa mu makeekhe, ndakhukhola obe omwimeelesi we chingoba ekhumi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.17",
            "verseOrgIds": [
              "LUK.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukholi okhola khabili echa aloma ali, ‘Omwami, erupia yowo yareerire bukhala bwe chichiindi chiraano.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.18",
            "verseOrgIds": [
              "LUK.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami, amuboolela ali, ‘Olaba omwimeelesi khu ngoba chiraano.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.19",
            "verseOrgIds": [
              "LUK.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.19",
            "verseOrgIds": [
              "LUK.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omukholi omumaliilisi echa aloma ali, ‘Omwami, erupia yowo niyeeyi. Nakiboa mu sitambala mala nakikisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.20",
            "verseOrgIds": [
              "LUK.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhuria, sikila ewe oli omundu omurafu. Obukulanga nisio okhabiikha tawe, lundi okesanga nibio okhamiicha tawe.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.21",
            "verseOrgIds": [
              "LUK.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami amuboolela ali, ‘Oli omukholi omubi, ndakhukhalakila khuloondekhana ne lilomaloma liowo wamwene! Wamanya oli ese ndi omundu omurafu, mbukulanga biikhali bibiase tawe, lundi ngesaanga nibio khamiicha tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.22",
            "verseOrgIds": [
              "LUK.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono siina, sisiakila ne waloba khura erupia yase mu bengi oli nicha nyoolelakho bukhala?’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.23",
            "verseOrgIds": [
              "LUK.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.23",
            "verseOrgIds": [
              "LUK.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nio omwami oyo aboolela abo ba baaba ne bemileo ali, ‘Munuule erupia niyo ali nayo muelesie oyo oli nacho ekhumi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.24",
            "verseOrgIds": [
              "LUK.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami, ‘Yuno ali nacho ekhumi!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.25",
            "verseOrgIds": [
              "LUK.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.12"
              },
              "items": [
                {
                  "text": "Mat. 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.25"
              },
              "items": [
                {
                  "text": "Mk. 4.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.18"
              },
              "items": [
                {
                  "text": "Lk. 8.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abakobosia ali, ‘Muboolela ndi buli mundu oli ne sisiindu alaebwa bibiindi, ne oyo okhali na siindu tawe, akhaba sitiiti nisio ali nasio alanuulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.26",
            "verseOrgIds": [
              "LUK.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne basiku base bakheenyanga ese mbe omwami wabwe tawe, bareere ano mala mubeere ebweeni wase!’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khukhwingila mu Yerusalemu ne bikalakala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nga amala khuloma kano, achiililila ne lukeendo lwewe lwe khucha Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.28",
            "verseOrgIds": [
              "LUK.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ne embiya e Betifake ne Betania a sikulu sia Miseituni, aruma babeeka bewe babili, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.29",
            "verseOrgIds": [
              "LUK.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khubaa kamalaka kano ali, “Cha mu sirekere sie ataayi esio, nga ne mwingilamo, mulanyoola epunda enjoka niyo omundu akhakeendelakho tawe. Kikangulule mala mukireere ano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.30",
            "verseOrgIds": [
              "LUK.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi yesi aaba ne amureeba ali, ‘Siina sikila ne mukikangulula,’ muboolele muli Omwami akienya.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio babeeka bacha mala banyoola buli siindu nga baba ne baboolelwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.32",
            "verseOrgIds": [
              "LUK.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oli balikho bakangulula epunda, babeeneyo bareeba bali, “Siina sikila ne mukikangulula?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.33",
            "verseOrgIds": [
              "LUK.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakobosia bali, “Omwami akienya,”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.34",
            "verseOrgIds": [
              "LUK.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.34",
            "verseOrgIds": [
              "LUK.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala bakirerera Yesu. Nio baala chingubo chabwe khu punda eyo ne khukhwikhasiakho Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.35",
            "verseOrgIds": [
              "LUK.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Yesu akeendela khu punda, babaandu baala chingubo chabwe khu ngila epunda yachikeendelakho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.36",
            "verseOrgIds": [
              "LUK.19.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.36",
            "verseOrgIds": [
              "LUK.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Yesu ne embiya Yerusalemu, niio engila esungukhila khu sikulu sia Miseituni, babeeka bewe boosi barakikha khukhwekhoya ne khufumia Wele ne kumumilo kwe angaaki khulwe kimilimo kimiboofu nikio baba ne baboone. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.37",
            "verseOrgIds": [
              "LUK.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Chiny. 118.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne baboola bali, “Wele biita chikhabi omuruki owichila mu lisina lio Mwami! Kumuleembe kube mwikulu ne luyali lube khu Wele!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.38",
            "verseOrgIds": [
              "LUK.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.38",
            "verseOrgIds": [
              "LUK.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Bafarisayo balala mu sipupu baboolela Yesu bali, “Omwekisia sisia babeeka bowo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
              "LUK.19.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
              "LUK.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abakobosia ali, “Muboolela enywe ndi basila kamabaale kalarakikha khu khufumia.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu alila sikila Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nga ne ola siimbi ne lukoba lwa Yerusalemu alubona mala arakikha khululila ne aloma ali, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.41",
            "verseOrgIds": [
              "LUK.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abaanga mu manyile endaalo eya luno bibiindu bibienyekha nio kumuleembe kubeo! Ne kakhali luno biakisiibwe se mubibona tawe! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.42",
            "verseOrgIds": [
              "LUK.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siise silikho siicha, basiku benywe bakhamubotookhelele mala bamwibwaakale khukhwama chimbeka choosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.43",
            "verseOrgIds": [
              "LUK.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balimubunisilia enywe elala, ne babaandu balimo. Ne se balilekha libaale khulindi tawe, sikila se mwakhebulila siise nisio Wele echelamo khumuonia enywe tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu engila mu Lukaangu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Yesu ne engila mu Lukaangu arakikha khutimania baboofuli baruremo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.45",
            "verseOrgIds": [
              "LUK.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Isa. 56.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Yer. 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ababoolela ali, “Liaandikwa lili, ‘Enju yase elaba Enju eye lisaba,’ Ne kakhali enywe mwakikholile libina lie banuuli!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.46",
            "verseOrgIds": [
              "LUK.19.46"
            ]
          }
        }
      ]
    },
