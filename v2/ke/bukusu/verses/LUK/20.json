          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
