              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.3+JOS.1.4+JOS.1.5"
              },
              "items": [
                {
                  "text": "Yosh. 1.3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kamaloba koosi niko mulakhandakakho kalaba kakenywe. Lulwakha lwe sibala sienywe lulaba khukhwama khu sichiimi lubeka lwe ebunafubo khukhwola khu sikulu sia Lebanoni lubeka lwe ebunaswa. Lundi khukhwama khu luuchi lwa Efurati ebukwe, khukhwola khu nyanja eya Mediterenia mumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osi osi niio mulacha mu sibala esio Wele Omunyali Owa Bioosi, Wele wenywe alakhola babaandu bamwo bamurie enywe nga ne amusuubisia enywe. Se alibao omundu yesi yesi olimukhiingilila enywe tawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Endaalo yino ese ndikho muelesia enywe burobosi akari we khabi ne silaamo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulanyoola ekhabi, mwaba ne muria kamalaka ka Wele Omunyali Owa Bioosi, Wele wenywe niko ndikho muelesia endaalo yino. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulanyoola silaamo, mwaba barengu khu malaka kano mala mukaluukhane mulekhe kamalaka niko ndikho muelesia luno lundi mwaba ne musaaya bawele babaandi nibo mukhamanyile tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.11+DEU.27.12+DEU.27.13+DEU.27.14"
              },
              "items": [
                {
                  "text": "Likh. 27.11-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Yosh. 8.33-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nga Wele ne amuyila mu sibala nisio mulikho mucha khwingisia, mukhalaangilile ekhabi ne muli khu sikulu sia Kerisimu, ne mukhalaangilile silaamo ne muli khu sikulu sia Ebali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikulu bibili bino bili lubeka lwe mumbo mwe Luluuchi lwa Yoritani mu sibala sie Bakanaani bamenyile mu Litooma lia Yoritani. Bialoleelela lubeka lwe mumbo, siimbi ne kumurongooro kumukhoonge kwa More siimbi ne Kilikali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enywe muli siimbi khukhwambukha Luluuchi lwa Yoritani mala mwingisie sibala nisio Wele Omunyali Owa Bioosi, Wele wenywe alikho amuelesia. Ne musinyoola mala mwombakhe mumenyemo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "mube barekerefu khuria kamalaka koosi niko ndikho muelesia enywe endaalo yino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.32",
            "verseOrgIds": [
              "DEU.11.32"
            ]
          }
        }
      ]
