          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Babaandu babili baaba ne balikho bapana mala omukhasi owa mulala khu nibo aakhaka khuyeeta omuseecha wewe khulwe khukhala omundu okundi oyo kumubili, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhamukholela siisa tawe mukhale kumukhono.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
