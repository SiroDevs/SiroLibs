              "items": [
                {
                  "text": "Bal. 19.35-36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Okhaba ne bipiimilo bibili mulolooti yowo, sibalaayi ne sitiiti tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhaba ne bikelo bibili munju mwowo, sibalaayi ne sitiiti tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumikhira sipiimilo ne sikelo sisienyekha lundi sia ng'ali, nio omenye kimiiko kimikali mu sibala nisio Wele Omunyali Owa Bioosi, Wele wowo alikho akhuelesia ewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi abiila babaandu babeanga ne bakhola bibiindu nga ebio.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lilaka lie khukhwira Baameleki",
          "type": "text"
        }
      ]
    },
