            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam. 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Khebulila niko Baameleki bamukholela enywe nga mwaba ne mwama Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se baba ne buuri khu Wele tawe. Bamuloondakho bamwibwaakala khu lukeendo nga ne mwaba ne mulwiile mala beera balala mwinywe ba baba enyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako, Wele Omunyali Owa Bioosi, Wele wenywe acha khumuelesia sibala mala amukhole mwingilemo sibe sisienywe. Alamuelesia kumuleembe. Basiku bamenyile siimbi nanywe se balaba butinyu khwinywe tawe. Ne amalile khukhola ario, yiira Baameleki boosi, nio akhabao olibakhebulila lundi tawe. Mukhebilila lino tawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        }
      ]
    }
