              "items": [
                {
                  "text": "1 Tim. 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Okhaboa eeyi emunwa ne olikho okirumikhira khuula biakhulia tawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
