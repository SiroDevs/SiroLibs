              "items": [
                {
                  "text": "Mat. 5.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ne wichuba khu Wele Omunyali Owa Bioosi, Wele wowo khumukholela sisiindu siosi siosi, okhalekha khukhola nisio wechuba khukhola tawe. Wele Omunyali Owa Bioosi, Wele wowo alenya okhole sisiindu esio sikila khu khwechuba khwowo, mala buli bumayaanu waaba ne okhakhola nga wechuba tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne waaba ne okhechuba tawe, aba se wakholile bumayaanu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhoya okhole nisio oloma oli okhola sikila wamwene wechubile Wele Omunyali Owa Bioosi, Wele wowo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
