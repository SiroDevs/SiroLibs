        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omundu aanyoolekha ne alikho akona ne omukhasi wo owasie, boombi bakhoya berwa. Mu ngila yino mularusiao bumayaanu akari wenywe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
