              "type": "text"
            }
          ]
        },
        {
          "text": " “Omundu aakwa khu mukhaana owe yabwana mala anyoolekhwa, akhoya ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
