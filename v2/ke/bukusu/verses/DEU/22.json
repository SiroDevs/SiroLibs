            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omundu aanyoolekha mu lukoba ne alikho akona ne omukhaana niye omundu okundi akhwele. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bombi bakhoya bayilwe enje we lukoba mala bapwe kamabaale bafwe. Omukhaana afwa sikila se aakukuula khulaanga buyeeti tawe, akhaba ne aba mu lukoba. Ne omundu oyo afwa sikila akona ne omukhaana niye owasie aba ne akhwele. Mu ngila yino mularusia bumayaanu akari wenywe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
