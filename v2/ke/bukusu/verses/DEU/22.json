          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "aruunge raraawe wo mukhaana bitonyi kamakhumi karaano bie fwesa mala omukhaana oyo alaba omukhasi wewe sikila aamukwakho busa ne kamaani mala aamwoonaka. Aba se alimuoona mu bulamu bwewe bwoosi tawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        }
