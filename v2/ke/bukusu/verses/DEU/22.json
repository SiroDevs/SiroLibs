              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne kakhali niko omundu oyo aloma kaaba ng'ali, sisiekesia sili omukhaana aba owe yabwana siaaba ne siikhaliio tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "babukula omukhasi oyo bamurusie enje we enju eya raraawe, niio babaandu be lukoba olwo balamupila kamabaale bamwire. Akholile sisiindu sie chisoni mu baandu befwe khulwe khukhola bueeyi ne asimenya munju eya raraawe. Mu ngila yino mularusiao bumayaanu akari wenywe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
