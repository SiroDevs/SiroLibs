            "number": "25",
            "style": "v",
            "sid": "DEU 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omundu aakwa khu mukhaana niye omundu okundi akhwele ne bali mundaa, omundu oyo yeng'ene niye owirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se siliio silekholekha khu mukhaana tawe, sikila se akholile bumayaanu bubwolaana lifwa tawe. Kumusaango okwo kuli nga kwo mundu owibwaakala omundu okundi mala amwiira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo akwile khu mukhaana oyo mundaa, ne akhaba ne akukuulile omundu omuyeeta se abeleo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
      ]
    },
