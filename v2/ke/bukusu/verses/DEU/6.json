                  "text": "28.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Wele Omunyali Owa Bioosi, Wele wenywe alikho acha khumuyila enywe mu sibala nisio aalaka bakuuka benywe Aburahamu, Isaaka ne Yakobo ali akhamuelesie enywe. Sibala esio sili ne chingoba chimboofu lundi chindayi nicho mukhombakha tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi sili ne chinju chichechula bibiindu bilayi nibio mukharaamo tawe. Lundi sili ne chisebele nicho enywe mukhaayaba tawe, nende kamaruuti ne kimikuunda kie kimiseituni nikio enywe mukhabiaala tawe. Wele Omunyali Owa Bioosi ne amureera mu sibala sino, mala mulie mwikure, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukheebilila Wele Omunyali Owa Bioosi owamurusia mu Misiri niio mwaba banasioobi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.12",
            "verseOrgIds": [
              "DEU.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.10"
              },
              "items": [
                {
                  "text": "Mat. 4.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.8"
              },
              "items": [
                {
                  "text": "Lk. 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ria Wele Omunyali Owa Bioosi, Wele wenywe, mukholele ne khumusaaya niye yeng'ene ne khukhwechuba mu lisina liewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhasaaya bawele be babaandu babaandi nibo mumenyile nabo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi, Wele wenywe ooli mwinywe yuno ali Wele owe likhendekha. Mwaba ne mukhakhola niko enya tawe, alimuambila lirima mala amubunie murure khu sibala.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        }
      ]
    },
    {
