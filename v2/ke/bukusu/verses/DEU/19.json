            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Okhasendia lulwakha lwo owasio, lulwarebwao khale mu sibala nisio Wele Omunyali Owa Bioosi, Wele wenywe alikho amuelesia enywe tawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
