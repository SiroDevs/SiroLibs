              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.10"
              },
              "items": [
                {
                  "text": "Yosh. 16.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekholo eya Efuraimu se yaoona Bakanaani babamenyanga mu lukoba lwa Keseri baruramo tawe, nio Bakanaani bachiililila khumenyayo ne nabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
              "JDG.1.29"
            ]
          }
        }
      ]
