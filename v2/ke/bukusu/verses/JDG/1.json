            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.11+JOS.17.12+JOS.17.13"
              },
              "items": [
                {
                  "text": "Yosh. 17.11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekholo eya Manase se yaoona babaandu babamenyanga mu ngoba cha Beti-sheani, Taanachi, Tori, Ibuleamu, Mekido, nende be chingoba chili siimbi baruramo tawe. Bakanaani bachiililila khumenyamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Baisiraeli ne banyoola kamaani bayingiilila Bakanaani babakholeleenge kimilimo, ne kakhaba kario se babaoona boosi baruramo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
