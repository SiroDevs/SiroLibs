              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lulwakha lwe Baamori",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
          }
        },
        {
