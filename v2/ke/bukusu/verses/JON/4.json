          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lirima lia Yona ne siisa sia Wele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona naye se asangaalila kano ne atiiti ene tawe, mala aambwa lirima. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Khur. 34.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio aasaba ali, “Wele Omunyali Owa Bioosi, ne khaama engo tawe se naloma ndi kano kali niko olakhola tawe ku? Kano niko kakakila nakhola kamaani khukhwilukhila e Tarishishi. Namanya ndi oli Wele owe kumwalaalo kumukali ne siisa, owe liliekhaliilikha, lundi oli ne busiime bukhawa tawe lundi buli lwoosi wenyanga khukaluukhasia kamebaasio kowo nio olekhe khuukuuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.4"
              },
              "items": [
                {
                  "text": "1 Bab. 19.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wele Omunyali Owa Bioosi, siise sino njire, sikila ese naafwa lukhila ne mba omulamu.”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele Omunyali Owa Bioosi aamukobosia ali, “Eku, oli na ng'ali siina khuambwa lirima?”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yona aarura aacha ebukwe we lukoba mala eekhala asi. Oombakha khasali mala eekhala mu siiniini siakho aliindiilila khubona sikane sikholekhe khu lukoba lwa Ninefe. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.5",
            "verseOrgIds": [
              "JON.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abweene ao Wele Omunyali Owa Bioosi aakhusia lurabu khu khasali lwakhola sisiiniini niio Yona aaba ne eekhaale, nio eeuliile bulayi. Yona asiimisibwa lukali po, sikila lurabu olwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne endaalo eyaloondakho mu mabwiibwi, Wele aaruma liike liarema lurabu chana mala lwaniaala. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.7",
            "verseOrgIds": [
              "JON.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli enyanga yasoa, Wele aaruma ekhuungu eye bukhafu yauucha khukhwama ebukwe, mala Yona enga khukwa luluuchu sikila kumuumu kukwamwoosia khu murwe. Nio ekoomba lifwa mala aaloma ali, “Naafwa lukhila ne mba omulamu!”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele aaboolela Yona ali, “Eku, oli na ng'ali siina khuambila lurabu lirima?”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona aakobosia ali, “Ndi na ng'ali po khuambwa lirima, lirima linyala liianjira!”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele Omunyali Owa Bioosi aamuboolela ali, “Lurabu luno lwachoile siilo silala, mala lwooma siilo sisialoondakho; ewe se wakholakho sisiindu siosi siosi khu nilwo tawe, lundi se walukhola lwachoa tawe, mala walubooneele buubi! ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono khoya khukholela Ninefe lukoba luboofu olwo siisa sikali. Sikila lulimo babaana chielefu emia ndala ne kamakhumi kabili baakhalikho ne buubi bwosi bwosi tawe, ne bibiaayo bikali!”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
              "JON.4.11"
            ]
          }
        }
      ]
    }
  ],
