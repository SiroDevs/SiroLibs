        "style": "s1"
      },
      "items": [
        {
          "text": "Yona akholela Wele Omunyali Owa Bioosi sileka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
