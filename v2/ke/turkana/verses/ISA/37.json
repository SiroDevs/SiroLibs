              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Senakerib lo arai ekapolon a Asiria tobongo nakwap keng, tolot Ninewi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
