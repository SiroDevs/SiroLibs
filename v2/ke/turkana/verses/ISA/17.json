          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani enangi akolongit ngina, eramakinio alorerea alu edukitoe ngawasea, sodi kimiekinae inyasuna loger a ngirerea alu kolong aisikinete Ngiipi, ka Ngiamor",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:9",
              "type": "text"
            },
            {
              "text": "Ngiipi, ka Ngiamor;",
              "type": "text"
            },
            {
              "text": "igiritae Naeburaniae amoni ka akwap na ngimukur.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na amatarotor ani a Ngisirael",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
