            }
          ]
        },
        {
          "text": "Ani erumor katolimok Ekapolon ayong tama, “Adaunet a ekaru a epei, edaun ekipur a Kedar daang. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.16",
            "verseOrgIds": [
