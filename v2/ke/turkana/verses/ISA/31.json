            }
          ]
        },
        {
          "text": "Alimuni Akuj Namerikanyer kona, “Esi Ngisirael, kisechakis esi ayong lokojokon. Nakaneni tobongutu tokona nikang! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
              "ISA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enangi ngirwa lu ichakareta esi daang ngakujo kus nasubuna, nakolong isubunete esi anakwangat ka egolit, iraakasi ngikasechak.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.7",
            "verseOrgIds": [
              "ISA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekapolon lo etenoono",
          "type": "text"
        }
      ]
