              },
              "items": [
                {
                  "text": "Rom 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enangi akolongit na iyeneta esi atamar ayong na arai Akuj kesuruor esi, nakaneni ayei ayong.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
