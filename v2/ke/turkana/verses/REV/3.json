                "loc": "REV.21.2"
              },
              "items": [
                {
                  "text": "Tood 21:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.2"
              },
              "items": [
                {
                  "text": "Isa 62:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.15"
              },
              "items": [
                {
                  "text": "65:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngulu ipiunete, etiliwori ayong kesi ngapirio na erubito alokai a Akuj kang, nakaneni nyepudunete nabo kaneni jik. Egirakini nabo ayong kidiama kech ekiro a Akuj kang ka ekiro a ere a Akuj kang, Yerusalem lokitetet, lo etiyaun anadis ebunit Anakuj kang. Egirakini ayong tani kidiama kech ekiro kang lokitetet.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.12",
            "verseOrgIds": [
              "REV.3.12"
            ]
          }
        }
      ]
