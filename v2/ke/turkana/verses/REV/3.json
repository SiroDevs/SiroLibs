        },
        {
          "text": " Ani kipiut esi, kitanapio ngiworui luakwaak loger logo, nakaneni nyikisario ngirora kus anakitab ana a akiyar. Alimuni ayong alongaren Apakang ka ngimalaikae keng ileere atamar iraakasi esi ngikang. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        },
