              "items": [
                {
                  "text": "Isa 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kilelebun apuru kai a Akuj na abuni alokipur a Akuj ka agogongu keng. Amam itwaan epedori alomar kai a Akuj tanang adaunet a ngakiro anakesiak anakan-kaarei a ngimalaikae alukan-kaarei kangulu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
            "verseOrgIds": [
