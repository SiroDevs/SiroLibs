                  "text": "Isa 42:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Toeokis kesi eeos lokitetet tamasi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
