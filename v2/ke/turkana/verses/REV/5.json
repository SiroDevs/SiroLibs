        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engolia ayong nabo, eira etoil a ngimalaikae alu eraakasi ngabunge ka ngalupui eeosi! Erikaunito kesi ekicholong a apolou ka ngitieng luomwon ayarete ta ngikasukou. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eremasi kesi ebalasi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
