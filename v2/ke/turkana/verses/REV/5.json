                "loc": "EZK.2.9+EZK.2.10"
              },
              "items": [
                {
                  "text": "Ese 2:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.11"
              },
              "items": [
                {
                  "text": "Isa 29:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi katolimok ekasukout epei tama, “Wara nyiigor. Kingolik a! Epiu engatuny lo a ekitela a Yuda lo erai ales a Daudi, ibore daang, sodi tobwangea ngesi ngigoliet lukan-kaarei nabo tangaa akitab.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        },
