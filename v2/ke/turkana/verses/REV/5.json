          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachut ngitieng luomwon ayarete tamasi, “Aamen!” Tadakakinos ngikasukou kwap kilipa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.14",
            "verseOrgIds": [
              "REV.5.14"
            ]
          }
        }
