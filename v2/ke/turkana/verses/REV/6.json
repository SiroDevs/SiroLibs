                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakinae ipei kech daang eworu loakwaan, tolimok kesi atamar kiangasi cha mono wadio, tanang itemokin etiae a ngikasubak etich ka ngikaitotoi kech lu eario, loger lo aarere kesi dang. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        },
        {
          "name": "note",
