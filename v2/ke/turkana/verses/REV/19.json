                "loc": "EZK.1.1"
              },
              "items": [
                {
                  "text": "Ese 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.96.13"
              },
              "items": [
                {
                  "text": "Eosio 96:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.4"
              },
              "items": [
                {
                  "text": "Isa 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Egiritae ekiro logo kidiama eworu keng ka ngakejen keng, “Ekarikon lo idwangit ngikarikok daang ka Ekapolon lo idwangit ngikapolok daang.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
