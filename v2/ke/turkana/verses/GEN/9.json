                {
                  "text": "Siak 1:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Toureta sodi kieatakinos, talalaketa noi anakwap.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.7",
            "verseOrgIds": [
              "GEN.9.7"
            ]
          }
        },
