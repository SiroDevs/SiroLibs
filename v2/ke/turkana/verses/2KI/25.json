              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apon ngitunga a Yuda kikokinae erikio neni, kipudoroe anakwap kech.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
