            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.2"
              },
              "items": [
                {
                  "text": "Ese 24:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Taarae talokookeng itee ngesi. Ani erumor tolim Nebukadinesa atamar topuyokinae ngakonyen a Sedekia. Kitoen ngesi Sedekia ngitunga, torikoroe Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
