            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolemasi ngitunga a Kirias Yearim asaduku a Achamunet a Ekapolon Akuj, yaasi kai a itwaan anyaritae Aminadab, ani alomit lomukura. Kitaleut kesi lokookeng a Aminadab lo anyaritae Eleasar sodi toweik asaduku a Achamunet.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Apolokini Samuel Isirael",
          "type": "text"
        }
      ]
    },
    {
