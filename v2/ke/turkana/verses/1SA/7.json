                  "text": "2 Sam 6:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.5+1CO.1.6+1CO.1.7"
              },
              "items": [
                {
                  "text": "1 Kor 1:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ebooyi asaduku a Achamunet a Ekapolon Akuj alo Kirias Yearim a ngikaru alukaalak, alu araakasi ngitomwon-arei. Ngirwa ngulu daang, egoronokinete Ngisirael Ekapolon Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Samuel Ngisirael tama, “Ani kibongokinete esi Ekapolon Akuj a ngitai kus kadaang, tachakasi ngakujo nagelayek ka ngakisikwaanet a akuj anaberu enyaritae Achitaros. Tolemunos toliworos ngika a Ekapolon Akuj dir, kilipa ngesi bon, sodi kitoyuu ngesi anapolou a Ngipilisti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tochakasi Ngisirael ngakujo kech nasubuna na a Baal ka Achitaros, sodi kilipa Ekapolon Akuj bon.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor Tolim Samuel tama, “Tochunakin Ngisirael daang Misipa, elip ayong Ekapolon Akuj kotere esi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tochunakinos kesi Misipa. Tookut kesi ngakipi tobukosi erai akipeyos na alemikinitae Ekapolon Akuj sodi torono akimuj akolongit ngina daang. Tolimut kesi tamasi, “Kisechak sua Ekapolon Akuj.” (Atubeene Samuel ngikesio a Ngisirael alo Misipa.)",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirarete Ngipilisti atamar achunakin Ngisirael Misipa, apot ngikapolok lukan a Ngipilisti tonyout ka ngitunga kech alosit akitijwore Ngisirael. Tobul Ngisirael na eirareta ngakiro nguna. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimokis Ngisirael Samuel tamasi, “Torubak kare akilipit Ekapolon Akuj na erai Akuj yok kitoyuu ngoni ani eya Ngipilisti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taar Samuel imesek nisorokit tolemik Ekapolon Akuj erai akipeyos na inomio elemwaana. Ani erumor kilip Samuel Ekapolon Akuj esaki kingarak Ngisirael, sodi kiik Ekapolon Akuj akilip a Samuel. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eringa Samuel ipeyoe, kirudun Ngipilisti akitijikin Ngisirael. Nipei bore ngini, togirok Ekapolon Akuj anadis, tobelak Ngipilisti. Kibiler kesi lokojokon tamataros eemito. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyout Ngisirael alo Misipa kiwapakis Ngipilisti tanang Besikar, taarete alorot.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor tolem Samuel amoru kitowo alokiding Misipa ka Chen, ebala, “Kingarak ngoni Ekapolon Akuj jik tanang tokona” sodi tanyara ngesi amoru ngina “Amoru a akingarakino.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi kidwangae Ngipilisti. Kiratak Ekapolon Akuj kesi nyeeremo nabo akwap a Ngisirael ngirwa daang lu ayarea Samuel. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apon Ngisirael tobuakinae akwap daang. Tobuakinae tani ngirerea kech daang lukolong alemarito Ngipilisti napei alo Ekiron tanang Gas. Kisila Ngisirael tani ka Ngikanaan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Samuel topolok Ngisirael ngirwa daang lu ayarea ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaru daang aloseene ngesi irimit ngirerea a Besel, ka Giligal, ta Misipa sodi totubonok ngitunga ngikesio alorerea kangulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor tobong nawi keng na ayei Rama. Atubeene ngikesio tani kaneni. Abu ngesi todukok ekeno a ngakipeyos Rama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        }
      ]
    }
  ],
