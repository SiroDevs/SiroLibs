          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi toeok Musa ngakiro a eeos daang topupokinito Ngisirael.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
