              "items": [
                {
                  "text": "Yoch 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi abu Ekapolon Akuj tolimok Yochua lokookeng a Nun tama, “Totitinyer nabo togogonger. Iriki iyong Ngisirael tolomasi nakwap nakolong echikakini ayong kesi, nakaneni kiruki ayong ka iyong.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
