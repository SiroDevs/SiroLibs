            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ipot esi kibooyoto alo Kadech ngirwa lukaalak.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.46",
            "verseOrgIds": [
              "DEU.1.46"
