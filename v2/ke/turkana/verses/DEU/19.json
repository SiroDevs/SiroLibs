              },
              "items": [
                {
                  "text": "Ebura 10:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Warasi ngakiro na ikote nguna nyikisieneto esi. Tatachakisi akiyar nakiyar nache, akongu tatachakin nakongu nache, ekelae tatachakin lokelae loche, akan tatachakin nakan nache, akeju tatachakin nakeju nache. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.21",
            "verseOrgIds": [
              "DEU.19.21"
            ]
          }
        },
