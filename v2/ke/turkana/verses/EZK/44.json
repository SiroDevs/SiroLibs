              "items": [
                {
                  "text": "Ekim 18:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nyenyamete ngimurok ikeny cha daang kori etiangit lo etoani bon kori lo earete ngitieng luche.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
