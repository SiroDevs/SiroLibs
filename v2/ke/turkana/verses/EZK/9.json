              "items": [
                {
                  "text": "14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " tama, “Kape kitor lore a Yerusalem etia ni etia, kigirak emachar loreetin a ngitunga kadaang alu eriabasi ka akichana kotere ngakiro naaronok daang na esubio alore.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
