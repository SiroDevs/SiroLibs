              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor tobongu itwaan ni anapit eworu lokaanikan nia Ekapolon Akuj tolimok tama, “Asubak ayong loger lo kidungokinitor iyong.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.11",
            "verseOrgIds": [
              "EZK.9.11"
            ]
          }
        }
      ]
