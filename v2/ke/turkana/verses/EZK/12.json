              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katolimok Ekapolon Akuj ayong akiroit tama, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
