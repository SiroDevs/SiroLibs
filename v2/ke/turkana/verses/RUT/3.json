{
  "id": "RUT.3",
  "number": "3",
  "bookId": "RUT",
  "reference": "Rus 3",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
