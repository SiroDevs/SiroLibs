          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.4+1SA.17.5+1SA.17.6+1SA.17.7"
              },
              "items": [
                {
                  "text": "1 Sam 17:4-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tojikinetei nabo ka Ngipilisti ejie eche. Abu Elianan lokookeng a Yair taar Lami lo arai lokaatokeng a Golias alo a akwap a Gas. Alangir akwara a Golias ekoni amorok a akitoe analangir eyei ni etokere ngiworui.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apon tojikinetei nabo ejie eche alo Gas, ani ayei itwaan iche nilangir-kooyan noi. Ayakasi ngesi ngimoyo ngikan-kapei nakan apei, toyakas ngikan-kapei nakan nache. Ngakejen nabo dang kona pei. Arai ngesi alesit a ngitunga alungorok lulangir-kooyak noi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimenya ngesi Ngisirael. Abu Yonasan lo arai lokookeng a lokaatokeng a Daudi alo anyaritae Chama, taar ngesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi luuni ngulu ngalesea a ngitunga alulangir-kooyak noi a Gas. Apot Daudi ka ngasigerea keng taara kesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
