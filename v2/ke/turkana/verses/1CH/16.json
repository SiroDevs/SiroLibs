                "loc": "2SA.6.19+2SA.6.20"
              },
              "items": [
                {
                  "text": "2 Sam 6:19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Apot ngitunga daang toloto nawiyei, sodi tolot Daudi nawi akiruk ka ngitunga a awi keng.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
