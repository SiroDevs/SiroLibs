        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaki ekarikon a Ngiroma akiyen dir ibore ni etitakinitotor Ngiyaudi Paulo. Akolongit na atupit ngina, tolim ngesi atamar talacharae ngiriko anakan a Paulo, sodi tolimok ngesi Ngimurok Luapolok ka ngitunga daang a Atuk atamar kiriamariama. Sodi toriko ngesi Paulo kitowo alongaren kech.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
            "verseOrgIds": [
              "ACT.22.30"
            ]
          }
        }
      ]
