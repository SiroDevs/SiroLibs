            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mat 12:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Toseu Ekapolon Akuj ekolia lotiapolon kiliko Yona. Kiboi Yona anakook a ekolia ngirwa nguuni, akwaar ka apaaran.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
