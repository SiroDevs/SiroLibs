            }
          ]
        },
        {
          "text": "Ayong Paulo lo arai emeanara a Yesu Kiristo ani edungunitor Akuj Akayuunan yok ka Yesu Kiristo lo kigieno ngoni, egirunit abarua naga.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
