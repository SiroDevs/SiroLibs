            "number": "67",
            "style": "v",
            "sid": "EZR 2:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.67",
            "verseOrgIds": [
              "EZR.2.67"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "EZR 2:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani enangunete ngitunga lu abongunete ngulu kai a Akuj alo Yerusalem, apot ngikapolok a ngimacharin ngiche tolemut ngadekon kotere akai a Akuj, tobongonokinere akiduk akai ngina ni kolong sek adukokinitae. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.68",
            "verseOrgIds": [
              "EZR.2.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "EZR 2:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot kesi tolemut ngadekon nakaalak itemem ka eger lo apedorete. Arai ekimar a ngiboro kangulu kadaang, egolit ngakiloi 500, ngakwangae ngakiloi 2,800 ta ngiworui lukooyak a ngimurok 100.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        }
      ]
    },
