                "loc": "NUM.27.21"
              },
              "items": [
                {
                  "text": "Ekim 27:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abu ekarikon a ewae a Ngiyaudi tolimok kesi atamar nyeenyam akimuj na epeyonokinio Akuj, tanang eanyunio emuron lo epedori akingitun ngakiro kotere Urim ka Sumim.*g**",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.63",
            "verseOrgIds": [
              "EZR.2.63"
            ]
          }
        }
      ]
    },
