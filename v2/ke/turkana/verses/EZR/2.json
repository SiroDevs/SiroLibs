          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi ngitunga lu abongunete daang 42,360, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.64",
            "verseOrgIds": [
              "EZR.2.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "EZR 2:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "emam itwaan imarakinit ngikasubak etich kech lukiliok ka luberu lu araakasi 7,337. Amam itwaan emarakinit tani ngikaeok lukiliok ka luberu lu araakasi 200. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.65",
            "verseOrgIds": [
              "EZR.2.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "EZR 2:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi kesi ngangolei 736, ka ngisikiria 245, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.66",
            "verseOrgIds": [
              "EZR.2.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "EZR 2:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ngikaala 435 ta ngisikiria ngiche 6,720.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.67",
            "verseOrgIds": [
              "EZR.2.67"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
