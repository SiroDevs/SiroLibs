        },
        {
          "text": "Ngirwa ngulu, apot ngikadwarak ngiarei lu anyaritae Agai ka Sekaria lokookeng a Ido, kisiakis akisuruor ngitunga lu elomito Yuda ka Yerusalem, alokiro a Akuj a Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
