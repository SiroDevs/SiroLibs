                  "text": "Sek 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani iirarete Serubabel lokookeng a Chalitiel ka Yochua lokookeng a Yeosadak ngakiro nguna, apot kisiakis abongokin akiduk akai a Akuj a Yerusalem, ingarakina ka ngikadwarak luarei ngulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
