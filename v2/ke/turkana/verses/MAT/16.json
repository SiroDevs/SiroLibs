              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tachada Petero ngesi nikeng bon tolomak akikilakin tama, “Meere kongina Ekapolon! Nyesubakinosi nguna anikon jik!”",
          "type": "text",
          "attrs": {
