              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni tolimok Yesu ngirukitos keng atamar nyeelimokis itwaan tani ipei atamar arai ngesi Kiristo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.20",
            "verseOrgIds": [
              "MAT.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eruoro Yesu eger lo eboliare ngesi taarae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
