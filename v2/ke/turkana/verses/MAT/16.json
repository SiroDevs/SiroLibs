                {
                  "text": "Mat 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.3"
              },
              "items": [
                {
                  "text": "Yoa 20:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kainakini iyong ngingaet lu Apolou a Akuj. Daang na ingeri iyong anakwap, engerio tani anadis. Daang na ichamuni iyong anakwap, echamunio anadis.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
              "MAT.16.19"
            ]
          }
        }
