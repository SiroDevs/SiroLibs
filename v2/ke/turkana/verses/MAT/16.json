              "items": [
                {
                  "text": "Yoa 6:68-69",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachak Simon Petero tama, “Irai iyong Kiristo, Lokookeng a Akuj ana eyari.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
