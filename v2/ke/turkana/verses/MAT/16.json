            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.14+MRK.6.15"
              },
              "items": [
                {
                  "text": "Mar 6:14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.7+LUK.9.8"
              },
              "items": [
                {
                  "text": "Luk 9:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachakis tamasi, “Ebaasi ngiche Yoana Ekebatisan. Ebaasi ngiche erai Elija. Tabaas ngiche irai iyong Yeremia kori epei a ngikadwarak a Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingit kesi tama, “Ani bo esi, ibaasi esi ayong ngesi ngae?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.15",
            "verseOrgIds": [
              "MAT.16.15"
            ]
          }
        }
      ]
    },
