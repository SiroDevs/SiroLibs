          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        },
        {
          "name": "verse",
