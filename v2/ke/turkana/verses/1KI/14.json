              "items": [
                {
                  "text": "2 Ngirwa 9:15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Toliwor nacha elosio ekapolon kai a Akuj, totinga ngasigerea nguna ngaupwala, ani erumor tobuasi kai na eteeto kesi ngidorin.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
