          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totoan Reoboam, tonukakinae nalielin a ngikapolok alore a Daudi, sodi kilunyoki lokookeng Abija napolou keng.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
