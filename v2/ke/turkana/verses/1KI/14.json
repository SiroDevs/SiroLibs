          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakiro nache daang na asubi ekapolon Reoboam, igiritae nakitab na enyaritae Ngakiro a Ngikapolok a Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
