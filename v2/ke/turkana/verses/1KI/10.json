          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edwangit Solomon ngikapolok luche a ngakwapea daang kotere ebari ka aosou. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tasaka ngitunga a ngakwapea daang aponere akiirar aosou a Solomon na ainakini Akuj ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.26"
              },
              "items": [
                {
                  "text": "1 Kapol 4:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Itwaan cha daang ni ebuni nikeng, inu ngainakinet a ngiboro alukwangae ka egolit, ka ngiworui, ka ngiboro lujiet, ka ngikito lukitukukunyet akimuj, ka ngangolei ta ngisikiria. Asubasi ngakiro nguna loger ngolo ekaru daang.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
