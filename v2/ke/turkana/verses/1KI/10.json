                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Etal 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Aweikinito kesi tani egielit a ngaurukukui ana iritae ana aponeenete alo Misiri. Agialanakinete kesi ngikapolok a Ngiiti, ka Siria, ngaurukukui a ngaropiyae a ngamiae a ngakan-kapei, ani ngangolei a ngaropiaye a amiat a apei ka ngatomwon-kan apei kech daang.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
