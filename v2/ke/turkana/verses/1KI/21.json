          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Ekapolon Akuj ekadwaran Elija tama, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ingolik iyong eger lo etiditeunor Aab alongaren kang a? Aloger ekokinea ngesi neni, nyayauni ayong ngakiro nugu nikeng eringa ngesi eyari. Ayauni ayong ngakiro naaronok nguna nawi a Aab ngirwa lu eliworor lokookeng ekapolon.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Echikichiki ekadwaran Mikaya Aab",
          "type": "text"
        }
      ]
    }
