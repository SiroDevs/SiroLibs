          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "( ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amam itwaan iche alemuna akisub naaronok noi alongaren Ekapolon Akuj loger a Aab. Aberu keng Yesebel ngesi echuchukinit ngesi nakiro nguna daang. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubi ngesi ngasechesea na ngileech noi ani elipitor ngakujo nasubuna, loger losek asubete Ngiamor, lusek eritari Ekapolon Akuj na alooso Ngisirael ngaren.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
    },
