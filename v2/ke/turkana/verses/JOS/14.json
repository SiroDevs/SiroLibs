          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Topia Yochua Kaleb lokookeng a Yepune sodi nak ngesi ere a Eburon toliwor ekeng. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eringa Eburon erai eka ngalesea a Kaleb lokookeng a Yepune, alo arai eka akwap a Kenis kainyo ewapi ngesi Ekapolon Akuj na erai Akuj a Isirael a eger alo etenoono. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sek ekingaren anyaritae Eburon ere a Ariba. (Arai Ariba itwaan ni apolot ni edwangit Ngianak luche.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
