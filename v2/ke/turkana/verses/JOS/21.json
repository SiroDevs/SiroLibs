          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apon totiakakinae ngirerea nguomwon anakwap a Acher. Ngirora a ngirerea kangulu kesi Michal, ka Abidon, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
              "JOS.21.30"
            ]
          }
