        },
        {
          "text": "Apon totiakakinae ngirerea nguomwon anakwap a Isakar. Ngirora a ngirerea kangulu kesi Kichion, ka Daberas, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
