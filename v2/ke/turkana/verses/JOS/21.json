          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Kedemos ta Mapaas imorikina aapei ka ni iyokiyo ngibaren. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
