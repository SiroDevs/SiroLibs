          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi ngirerea lu atiakakinitae ngitunga a emachar a Gerichon ngitomon ka nguuni imorikina aapei ka ni iyokiyo ngibaren.",
          "type": "text",
          "attrs": {
