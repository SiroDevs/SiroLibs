          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Echibon ta Yaser, imorikina aapei ka ni iyokiyo ngibaren. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
