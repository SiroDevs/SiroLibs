              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Dimina ta Naalal, imorikina aapei ka ni iyokiyo ngibaren. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.35",
            "verseOrgIds": [
