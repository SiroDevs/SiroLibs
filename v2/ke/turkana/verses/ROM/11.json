                  "text": "Isa 59:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eliwor ngirwa ngulu ngesi eyuunere Ngisirael daang. Loger lo igiritere nagiran atamar,",
          "type": "text",
