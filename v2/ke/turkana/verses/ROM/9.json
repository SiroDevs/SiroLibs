          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "tarai ngitunga a Akuj lu asakete akiwap etal lo itiliwori kesi lu etenoono eboyor ani a Akuj, apot kibatar alotal. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
            "verseOrgIds": [
