          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.4"
              },
              "items": [
                {
                  "text": "Eosio 19:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni engita cha ayong, “Nyiirara mono cha kesi dir ngakiro a Akuj a?” Iteni dir, eirarito kona igiritere nagiran atamar,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
