                  "text": "Rom 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " erai egieno atamar keteyarunio ayong dang. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.11",
            "verseOrgIds": [
              "PHP.3.11"
            ]
          }
        },
        {
          "name": "note",
