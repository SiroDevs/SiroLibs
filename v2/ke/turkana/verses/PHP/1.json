      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayong Paulo ka Timoteo lu kirai ngikasubak etich a Yesu Kiristo kesi kigirunit abarua naga. Kigirakinit esi ngikanupak lu iyakasi Pilipi, lu imorikinosi aapei ka Yesu Kiristo, ka esi ngikarikok ta lu ingarakinito ngitunga a ekanisa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
