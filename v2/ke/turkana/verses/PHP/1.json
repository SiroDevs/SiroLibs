            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.12"
              },
              "items": [
                {
                  "text": "Tich 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kigatakinit esi ajokis ka ekisil a Akuj Apayok ka Ekapolon Yesu Kiristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akilipakinit Ngipilipi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuanakini ayong Akuj kang alakara esaa daang loketamunea esi, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.3",
            "verseOrgIds": [
              "PHP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani esaa lo kelipanakinea ayong esi daang, elipeene ayong alakara. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.4",
            "verseOrgIds": [
              "PHP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo kingarakis esi ayong alotich alo a akitatam ngakiro naajokak napei ana kolongit ana ekingaren tanang tokona. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.5",
            "verseOrgIds": [
              "PHP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni ayeni ayong dir atamar, Akuj nakolong esiakini etich loajokon lo anikus, erubakini esubi naajokak tanang Akolongit na a Yesu Kiristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketamunit ayong esi jiik! Kotere nguna, itemokino ayong etami ngakiro kus loger lo tokona etamea. Kainyo ianyut esi daang ka ayong aapei ajokis naketaanyu ayong Akuj, napei ana tokona kaenitere ayong alojela ka tani nakolong pekaenitere ayong na eruoror ngakiro naajokak etenik lokojokon. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuj ngesi eyeni atamar eruoro ayong ngakiro na iteni na abalar itorunit amina nakaminar esi daang lotau a Yesu Kiristo a elope.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elipit atamar torubak amina kus iatanakin talalar, imorikina aapei ka aosou na iteni ta ayenut ngakiro lokojokon, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sodi toseuneta esi ngakiro naajokak noi. Dio toliworor eboyor kus lo ikiuna emam akisech tani edit Akolongit na Kiristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.10",
            "verseOrgIds": [
              "PHP.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eupiyarete eboyor kus ngakiro naajokak na iteni na eraakasi Yesu Kiristo bon itatakanuuni, sodi kikusere ka akipur Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akiyar ngesi Kiristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikaitotoi kang, asaki ayong esi toyena atamar ngakiro daang na asubakin anikang, kengarakis ayong noi akikobar ngakiro naajokak toyenunae. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
            "verseOrgIds": [
              "PHP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotere nguna, ayena ngikeyokok a akai a ekapolon ka luche daang eya nege atamar kaenitae ayong alojela ani araakar ekasuban etich a Kiristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.30"
              },
              "items": [
                {
                  "text": "Tich 28:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anupa tani ngikaitotoi ngikaalak Ekapolon Yesu lokojokon ani kaenitere ayong alojela, atitinyoketa tani dang jiik itatamete ngakiro a Akuj peemito.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iteni dir, eya ngiche kech lu itatamete ngakiro a Kiristo eyei ibore ni iterekuyarit nabo kiburuate. Nakaneni, itatamete luche ngakiro a Kiristo ani ejoikinitotor ngitai kech. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esubete ngulu nguna kotere amina, kainyo eyenete kesi atamar ketaanyu Akuj ayong etich lo aikinitor ngakiro naajokak. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.16",
            "verseOrgIds": [
              "PHP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itatamete luche ngakiro a Kiristo ani ebolotor, nyitatamete kotere ni eminatar, ebaasi kesi kori ketaanyunete ayong ngichan ngiche eringa kaenitae alojela.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etamario tokona ai! Alakara ayong erai kitatamete ngitunga ngakiro a Kiristo a ngirotin kadaang, kerai alotai ajokak kori alotai aronok. Arubakini ayong alakara kotere nguna, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kainyo ayeni ayong atamar kalachakinio kotere ni ilipitotor esi ka ni kengarakinea Etau a Yesu Kiristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.19",
            "verseOrgIds": [
              "PHP.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakiro na kemuito ayong noi nabo na egieno ayong ngesi na atamar nyekeruma ayong ngileech alotich kang tani wadiochichi. Nakaneni asaki ayong atotitinyer jiik ka tokona dang, sodi kipuruunere Kiristo aloboyor kang kadaang, erai kayari ayong kori katoana. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.20",
            "verseOrgIds": [
              "PHP.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo, akiyar ngesi nyo? Ani alowae kang, erai akiyar Kiristo. Eyauni akitu ngakiro naajokak noi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.21",
            "verseOrgIds": [
              "PHP.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni ani karubak ayong ayari sodi atosubea etich lo ejok noi, nyayeni ayong atamar nyoni ejok, akiyar kori akitu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
            "verseOrgIds": [
              "PHP.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keriyaritae ayong a ngiwaitin a ngiarei. Asaki ayong noi aisikin eboyor lo atolot eruko ka Kiristo, ibore ejok noi ngini, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
              "PHP.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakaneni ejok noi anikus erai karubak ayong ayari. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit ayong dir akiroit ngina, kotere anupit ngina, ayeni atamar arubakini kirukit ka esi daang, sodi kengarak esi torotokis ngaren nabo talakaros ananupit kus. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi ani nakirukio ayong ka esi nabo, minio esi ibore ni iwogatar kotere ayong aloboyor alo imorikinotor esi aapei ka Yesu Kiristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
