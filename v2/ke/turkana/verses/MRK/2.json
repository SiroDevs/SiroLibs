            }
          ]
        },
        {
          "text": "Tolim Yesu ngakiro narumoret tama, “Asubio Sabato kotere itwaan meere itwaan kotere Sabato. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
