              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitoro Yesu ka ngirukitos keng lomanikor a ngimomwa akolongit na a Sabato. Tolomakis ngirukitos keng abiluunun ngakies a ngimomwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
