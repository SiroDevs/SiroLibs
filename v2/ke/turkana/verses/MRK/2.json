              },
              "items": [
                {
                  "text": "Etal 23:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi kingita Ngiparisayo Yesu tamasi, “Ayoro, nyo esubeta ngirukitos kon na engeritoe esubio alotal akolongit na a Sabato?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        }
