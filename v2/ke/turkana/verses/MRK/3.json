            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.34"
              },
              "items": [
                {
                  "text": "Mat 9:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.25"
              },
              "items": [
                {
                  "text": "10:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abalasi ngiketatamak a etal ngiche lu apote alo Yerusalem, “Ekapolon a ngipean Beelsebul eyei tooma keng! Erai lokapolon a ngipean ngesi eanyunitor ngesi agogongu na itwarakinea ngipean.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.22",
            "verseOrgIds": [
              "MRK.3.22"
            ]
          }
        }
      ]
    },
