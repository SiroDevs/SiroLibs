            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torotokis Ngisirael alomoru a Hor toloma Salimona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41",
            "verseOrgIds": [
              "NUM.33.41"
            ]
          }
