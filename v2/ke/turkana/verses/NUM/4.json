          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejoikinit Musa ka Aron ingolikinete atamar asubakis Ngigerichon ngitichisio daang lusek atiakakinete Aron ka talokookeng kesi. ",
          "type": "text",
          "attrs": {
