              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliwor etich kech ngesi akiwok ngakito nakiganget eam kang, ka ngasua nakapisa, ka ngapirio, ta ngiwaitin lua ngalup a eam. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
