              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "sodi kigir ngikiliok a ngikaru a ngitomwon-uni tanang ngitomwon-kan, lu epedorete akisub etich aloeam a Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
