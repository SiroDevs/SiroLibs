          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Ekapolon Akuj Musa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "tama, “Kimaru ngitunga a emachar a Gerichon alo a ekitela a Lawi, kimaru a ngatekerin ka ngawiyei, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo kimaru ngikiliok a ngikaru a ngitomwon-uni tanang ngitomwon-kan, lu epedorete akisub etich aloeam a ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etich kech ngesi akidak ngiboro lugu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "eam ka ngiboro lu eburitere tooma ka nikalapatan, ka alaar, ka eleu lokaanokan lo imukokinitae kidiama, ka awaru na erapitere akituk a eam ",
          "type": "text",
