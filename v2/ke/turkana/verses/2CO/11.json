              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kejoikinit ayong ewoga, ewoga kotere ngakiro na idodiunito apalagu kang. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
