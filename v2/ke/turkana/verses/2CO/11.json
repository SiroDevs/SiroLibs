              "items": [
                {
                  "text": "Tich 16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani epalag itwaan apalag ayong dang. Ani na esechea itwaan kariebete ayong ngakiro keng etau. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
