          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuj na erai Apakeng a Ekapolon Yesu, na erai ngesi epiarit nakajik, eyeni atamar nyeruoro ayong alioko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
