                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Ngirwa 36:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abu Ekapolon kiwaak Yeoyakim lo arai ekapolon a Yuda nakan a Nebukadinesa. Tolema Nebukadinesa tani ngiboro ngiche a akai a Akuj yaa kai a akuj keng, kiwaak ngiboro ngulu lodulae a akuj keng. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
