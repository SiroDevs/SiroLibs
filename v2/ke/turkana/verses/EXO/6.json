          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "tolimok tama, “Arai ayong Ekapolon Akuj. Tolimok ekapolon a Misiri ngakiro daang nguna kalimokini ayong iyong.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
