                "loc": "EXO.22.21"
              },
              "items": [
                {
                  "text": "Apud 22:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.33+LEV.19.34"
              },
              "items": [
                {
                  "text": "Lawi 19:33-34",
                  "type": "text"
                }
              ]
            },
            {
