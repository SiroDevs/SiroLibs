            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.26"
              },
              "items": [
                {
                  "text": "Apud 34:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
