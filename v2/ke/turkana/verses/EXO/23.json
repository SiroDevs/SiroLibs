                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "26:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ekaru daang, yaunutu ngalemet na ekingaren kai a Ekapolon Akuj ana erai Akuj kus.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyiidorokis imesek kori ikale a ngakile a itiokeng.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngakichikichiket ka ngakitatamet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ameari ayong emalaikat kingarenik esi, sodi kiyok esi alorot, kiyau ni asubak ayong. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.20",
            "verseOrgIds": [
              "EXO.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Topupo ngesi kiwapa ngakiro keng. Nyiingero ngesi, kainyo amea ayong ngesi, nakaneni nyakarimakini ayong esi erai kingero ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
            "verseOrgIds": [
              "EXO.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiwapa esi ngakiro keng sodi tosuba daang nakadungok ayong esi, etiji ayong ngimoe kus daang. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.22",
            "verseOrgIds": [
              "EXO.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingarenikini emalaikat kang esi, kiyaa nakwap a Ngiamor, ka Ngiiti, ka Ngiperes, ka Ngikanaan, ka Ngiipi, ta Ngiebus, nakaneni amunyari ayong kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.23",
            "verseOrgIds": [
              "EXO.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warasi nyiiriedikokis ngakujo kech kori nyiilipa. Warasi nyiiwapa eger lo ilipitotor kesi. Kinyasutu ngakujo kech sodi tobwanga ngapirio kech na ngamoru anakitaleuno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.24",
            "verseOrgIds": [
              "EXO.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kipeyonokis esi ayong Ekapolon Akuj na arai Akuj kus, kapiari ayong esi kainak akimuj ka ngakipi, nabo alemari ayong ngidekesinei kus daang. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
            "verseOrgIds": [
              "EXO.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emam aberu na akwap kus na iyesi kori na ekolupani. Etalalae ayong ngirwa lu iyareta esi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
            "verseOrgIds": [
              "EXO.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
            "verseOrgIds": [
              "EXO.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kaemete ayong ngitunga lu kitopegete esi. Ayauni ayong ngibiler lotunga lu kitijiete esi, nakaneni aree ayong ngimoe kus daang kipungaros anikus. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.27",
            "verseOrgIds": [
              "EXO.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etubuli ayong ngimoe kus noi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.28",
            "verseOrgIds": [
              "EXO.23.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:28",
              "type": "text"
            },
            {
              "text": "Etubuli ... noi;",
              "type": "text"
            },
            {
              "text": "kori ameuni ao lomoe kus.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Etwarakini ayong Ngiipi, ka Ngikanaan, ta Ngiiti eringa esi iponito. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.28",
            "verseOrgIds": [
              "EXO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyetwarakini ayong kesi a ekaru a epei kainyo ani kekok neni, iboikin akwap kongin, sodi talalaketa ngitieng a moding kichana esi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.29",
            "verseOrgIds": [
              "EXO.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni etwarakini ayong kesi a ngalooso a ngadikidio tanang ni ilalakearotor esi kiruma akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.30",
            "verseOrgIds": [
              "EXO.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiliwori ayong ekukuor a akwap kus lo isiakini anapas a Akaba tanang nangolol a Eupurate, kisiak loche ananam a Mediterenian tanang nariet. Kainakini ayong esi agogongu na ireuneta ngitunga a akwap kangina sodi kitwarakis esi kesi alongaren kus. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.31",
            "verseOrgIds": [
              "EXO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiichamakinosi ka kesi kori ngakujo kech. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.32",
            "verseOrgIds": [
              "EXO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiimiekis ngitunga ngulu elomete nakwap kus, ani kimiekis esi kesi, kitosechete kesi esi etal kang. Ani kilipa esi ngakujo kech, eliworosi elokit loaronon anikus.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.33",
            "verseOrgIds": [
              "EXO.23.33"
            ]
          }
        }
      ]
    }
