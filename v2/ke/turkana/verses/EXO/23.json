          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tanyama akimuj a esukukuu a ngalemet napei isiakineta esi akilem.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        }
