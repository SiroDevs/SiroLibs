  "reference": "2 Ngakiro A Ngirwa 17",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
