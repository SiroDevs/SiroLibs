          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani idwangete ngimoe ngitunga kon Ngisirael ani kisechakinitotor iyong, nakaneni ani kereeunosi kesi nikon pot kai naga, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiira iyong ngakiro kech anadis. Torimak ngasechesea a ngitunga kon, sodi tobuu kesi nakwap nakolong iinakini iyong taapaakech.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
