          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiira ngakilipasinei kech. Kiira kesi anadis sodi kisidwang ngimoe kech.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
