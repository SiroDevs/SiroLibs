          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kisechakis ngitunga kon iyong, aloger emamakar itwaan nyesecheene, sodi ani ingoi iyong kimiek ngimoe idwangete kesi torikosi nakwapea nache toliworos ngirikon, tani keloka ngakwapea nguna, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
