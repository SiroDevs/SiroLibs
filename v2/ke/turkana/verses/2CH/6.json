          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiira ngakilipasinei kech. Kiira kesi kisieneto anawi kon ana eyei nadis, sodi torimak ngasechesea a ngitunga kon daang alu kisechakis iyong.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
