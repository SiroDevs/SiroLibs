            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakiro nache daang a Solomon napei anakisiakinet tanang losal, igiritae nakitabea na enyaritae Ngakiro a ekadwaran Nasan, ka ngakiro na adwari Aija lo a ere a Chilo, ka ngakisingolikinet a ekadwaran Ido na eyakasi tani ngakiro a apolou a Yeroboam alo arai ekapolon a Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apolokinit Solomon Isirael daang eyei Yerusalem a ngikaru a ngitomwon-omwon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totoan ngesi sodi tonukakinae lore a Daudi. Kilunyokin lokookeng lo anyaritae Reoboam nados keng toliwor ekapolon.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
