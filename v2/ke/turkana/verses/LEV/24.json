              "items": [
                {
                  "text": "Mat 5:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Erai etal logo ekus kadaang, esi Ngisirael ka ngitunga a ngakwapea anache lu irukito ka esi, kainyo arai ayong Ekapolon Akuj na arai Akuj kus.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
            "verseOrgIds": [
              "LEV.24.22"
            ]
          }
        },
        {
