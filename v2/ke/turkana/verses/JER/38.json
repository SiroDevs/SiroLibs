                {
                  "text": "Ese 33:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kemiekin ayong ebooyi analaar a akai a ekapolon tanang akolongit na alemarere Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
