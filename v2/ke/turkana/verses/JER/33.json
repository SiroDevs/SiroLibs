            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.9",
            "verseOrgIds": [
              "JER.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim Ekapolon Akuj tama, “Ebalasi ngitunga ikoni akwap naga ariet, na emam ngitunga ka ngitieng eyakasi. Iyookinito kesi nguna. Ngirerea a Yuda ka ngirotin a Yerusalem, esilok. Emam ngitunga ka ngitieng eyakasi neni. Nakaneni iirario moi nabo alorerea kangulu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "verse",
