              },
              "items": [
                {
                  "text": "Gal 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.5",
            "verseOrgIds": [
              "1CO.5.5"
            ]
          }
        },
        {
