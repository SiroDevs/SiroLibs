            }
          ]
        },
        {
          "text": "tokut ekuwam atipei anariet, touko akai ngina taar kesi daang. Ayong bon abuchun abu alimokin iyong.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
