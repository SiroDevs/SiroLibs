            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisyai, nĩtũmetaa aathimwa ala moomĩĩsye: nĩmweewie ũvoo wa wũmĩĩsyo wa Yovu, na ĩngĩ nĩmwoonie mũminũkĩlyo wa Mwĩaĩi, ũndũ Mwĩaĩi wusũĩte ĩnee na tei.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.11",
            "verseOrgIds": [
              "JAS.5.11"
            ]
          }
        }
      ]
