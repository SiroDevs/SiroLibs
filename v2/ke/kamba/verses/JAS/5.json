              "items": [
                {
                  "text": "Lk 6.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu, inyw’ĩ athwii, ĩai na kũkaya nũndũ wa mathĩna ala mokĩte ĩũlũ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.1",
            "verseOrgIds": [
              "JAS.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.19"
              },
              "items": [
                {
                  "text": "Mt 6.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mothwii menyu nĩmoete, na ngũa syenyu nilĩkĩte nĩ lungulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.2",
            "verseOrgIds": [
              "JAS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.27"
              },
              "items": [
                {
                  "text": "Nth 16.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thaavu wenyu na vetha wenyu niĩte nganga; na nganga yasyo ĩkamũkũsĩĩa, nayo ĩkaĩsaa mĩĩ yenyu ta mwaki. Nĩmwĩyiĩe ũthwii wenyu mĩthenya ya mũminũkĩlyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.3",
            "verseOrgIds": [
              "JAS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.13"
              },
              "items": [
                {
                  "text": "Ali 19.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
