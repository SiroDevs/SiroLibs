              },
              "items": [
                {
                  "text": "Yel 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyw’ĩ nĩmwaatĩĩe kwĩyendeesya ene kũũ nthĩ, na kwĩtan’ya ene; na mwaiĩthasya ngoo syenyu mũthenya wa kũawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.5",
            "verseOrgIds": [
              "JAS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmwamũsilĩle na kũmũaa ũla mũlũngalu; nake ndakĩlanasya nenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.6",
            "verseOrgIds": [
              "JAS.5.6"
            ]
          }
        }
      ]
    },
