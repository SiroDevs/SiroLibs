            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.3.13"
              },
              "items": [
                {
                  "text": "3.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyw’ĩ nenyu ũmĩĩsyai; lũlũmĩlyai ngoo syenyu: nũndũ kũka kwa Mwĩaĩi kwĩ vakuvĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.8",
            "verseOrgIds": [
              "JAS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikanyungunyĩanĩsye inyw’ĩ kwa inyw’ĩ, ana‐a‐asa, nĩ kana mũikasilĩlwe: sisyai, mũsili nũũngeme mĩomonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.9",
            "verseOrgIds": [
              "JAS.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.12"
              },
              "items": [
                {
                  "text": "Mt 5.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana‐a‐asa, mosei athani ala maneenie syĩtwanĩ ya Mwĩaĩi, methĩwe ngelekan’yo kwenyu ya kũthĩna na ya kũmĩĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.10",
            "verseOrgIds": [
              "JAS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 5:11"
