                {
                  "text": "Aevl 10.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũmĩĩsyai ĩndĩ, ana‐a‐asa, kũvika kũka kwa Mwĩaĩi. Sisyai, mũĩmi nĩweteelaa ũsyao wa nthĩ ũla wĩ vata akyũmĩĩsya ũndũ waw’o, kũvika oona mbua ya nthwa na ya uũa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.7",
            "verseOrgIds": [
              "JAS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.25"
              },
              "items": [
                {
                  "text": "Aevl 10.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.2.16"
