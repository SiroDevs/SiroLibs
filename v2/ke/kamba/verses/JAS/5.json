                  "text": "Sav 50.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.16"
              },
              "items": [
                {
                  "text": "Ako 3.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ve mũndũ katĩ wenyu ũla ũnũũthĩna? Navoye. Ve ũla wĩ na ũtanu? Naine mbathi sya ndaĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.13",
            "verseOrgIds": [
              "JAS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.13"
              },
              "items": [
                {
                  "text": "Mko 6.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ve ũla ũwaĩte katĩ wenyu? Namete atumĩa ma ĩkanisa; mamũvoyee, makĩmũvaka mauta syĩtwanĩ ya Mwĩaĩi: ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.14",
            "verseOrgIds": [
              "JAS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.18"
              },
              "items": [
                {
                  "text": "Mko 16.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kũvoya kwa mũĩkĩĩo kũkatangĩĩa ũsu mũwau, na Mwĩaĩi akamũvosya; na ethĩwa ekĩte naĩ, akaekewa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.15",
            "verseOrgIds": [
              "JAS.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ũmbũlanĩlai naĩ syenyu inyw’ĩ kwa inyw’ĩ, na mũivoyanĩa inyw’ĩ kwa inyw’ĩ, nĩ kana mũvow’e. Kwĩsũvana kwa mũndũ mũlũngalu nĩkũvotaa mũno akĩvoya na kĩthetheesyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.16",
            "verseOrgIds": [
              "JAS.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Asu 17.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.25"
              },
              "items": [
                {
                  "text": "Lk 4.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.15"
              },
              "items": [
                {
                  "text": "Meko 14.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya aĩ mũndũ wa mwĩkalĩle ũmwe naitũ, na avoya na kĩthing’ĩĩsyo mbua ndĩ kaue; na mbua ndyaaua ĩũlũ wa nthĩ ĩvinda ya myaka ĩtatũ na myei thanthatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.17",
            "verseOrgIds": [
              "JAS.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.42"
              },
              "items": [
                {
                  "text": "1 Asu 18.42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na avoya ĩngĩ; na ĩtu yausya mbua, na nthĩ yamesya ũsyao wayo.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        }
      ]
