                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.31.38+JOB.31.39+JOB.31.40"
              },
              "items": [
                {
                  "text": "Yovu 31.38–40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisyai, ĩtuvi ya atethya ma wĩa ala makethie mĩũndanĩ yenyu, yĩla mwaleile ũmanenga kwondũ wa ũkengani, nĩyĩũlonzan’ya mũno: na iĩo sya ala akethĩ nilikĩte matũnĩ ma Mwĩaĩi wa Savaothi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.4",
            "verseOrgIds": [
              "JAS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.19"
              },
              "items": [
                {
                  "text": "Lk 16.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
