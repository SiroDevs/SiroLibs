            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.1"
              },
              "items": [
                {
                  "text": "Mt 7.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.1"
              },
              "items": [
                {
                  "text": "Alo 2.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.4"
              },
              "items": [
                {
                  "text": "14.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnengani wa mĩao na mũsili no ũmwe, nake nĩ ũla ũtonya kũtangĩĩa na kwananga: ĩndĩ we wĩ ũũ ũla ũsilĩlaa ũngĩ?",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.12",
            "verseOrgIds": [
              "JAS.4.12"
            ]
          }
        }
      ]
    },
