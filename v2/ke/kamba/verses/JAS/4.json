              },
              "items": [
                {
                  "text": "Nth 27.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu, ala mũkwasya, Ũmũnthĩ kana ũnĩ tũkathi ndũanĩ ĩno, na kwĩkala vo mwaka, tũkĩtandĩthya, na kwona ũtandĩthyo: ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.13",
            "verseOrgIds": [
              "JAS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 4:14"
          },
          "items": [
