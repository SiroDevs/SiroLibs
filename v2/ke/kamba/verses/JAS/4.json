              },
              "items": [
                {
                  "text": "1 Vet 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaũ na kũkita kwĩ katĩ wenyu kumaa va? Kũtyumaa vau mĩmeonĩ mĩthũku yenyu ĩla yũkitaa mamuthanĩ menyu? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.1",
            "verseOrgIds": [
              "JAS.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmwendaa, na mũti na kĩndũ: nĩmũaa, na kwĩw’ĩaa kĩwĩu, na mũtitonya kwosa; nĩmũkwatasya kaũ na kũkita; na mũi na kĩndũ nũndũ mũivoyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.2",
            "verseOrgIds": [
              "JAS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũvoyaa, na mũtĩunengwa nũndũ nĩmũvoyaa naĩ, nĩ kana mwanange motanunĩ menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.3",
            "verseOrgIds": [
              "JAS.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.26"
              },
              "items": [
                {
                  "text": "Lk 6.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.7"
              },
              "items": [
                {
                  "text": "Alo 8.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.15"
              },
              "items": [
                {
                  "text": "1 Yoa 2.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyw’ĩ ilaalai, mũiĩsĩ kana ũnyanya wa nthĩ nĩ ũmaitha na Ngai? Kwondũ wa ũu o ũla ũkwenda kwĩthĩwa e mũnyanyae wa nthĩ nũtw’ĩkĩte mũmaitha wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.4",
            "verseOrgIds": [
              "JAS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.3"
              },
              "items": [
                {
                  "text": "Kuma 20.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.24"
              },
              "items": [
                {
                  "text": "Mt 6.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.17"
              },
              "items": [
                {
                  "text": "Aka 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mwĩtalĩlya maandĩko meneena mana? Veva ũla ũtwĩe nthĩnĩ waitũ nĩwendaa kũvika kwĩw’ĩa kĩwĩũ? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.5",
            "verseOrgIds": [
              "JAS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.34"
              },
              "items": [
                {
                  "text": "Nth 3.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.22.29"
              },
              "items": [
                {
                  "text": "Yovu 22.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.12"
              },
              "items": [
                {
                  "text": "Mt 23.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.5"
              },
              "items": [
                {
                  "text": "1 Vet 5.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nũtũnengae mumo mwingĩ mbee. Kwondũ wa ũu maandĩko maĩtye, Ngai nũmasiĩĩaa ala me na wing’athĩlĩlyo, ĩndĩ nũmanengae mumo ala me na wĩnyivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.6",
            "verseOrgIds": [
              "JAS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.12"
              },
              "items": [
                {
                  "text": "Aev 6.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.8"
              },
              "items": [
                {
                  "text": "1 Vet 5.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩnyivyei ĩndĩ kwa Ngai; ĩndĩ mũsiĩĩei ndevili, nake akamũkĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.7",
            "verseOrgIds": [
              "JAS.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.3"
              },
              "items": [
                {
                  "text": "Nzek 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.16"
              },
              "items": [
                {
                  "text": "Isa 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthengeei Ngai, nake akamũthengeea inyw’ĩ. Thambyai moko menyu, inyw’ĩ athe; na mũithesya ngoo syenyu, inyw’ĩ mwĩ na mĩtwe ĩlĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.8",
            "verseOrgIds": [
              "JAS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩn’yei, na kũmeta, na kũĩa: kũtheka kwenyu nikũalyũlwe kĩmeto, na ũtanu wenyu ũalyũlwe kĩmako. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.9",
            "verseOrgIds": [
              "JAS.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.6"
              },
              "items": [
                {
                  "text": "1 Vet 5.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩnyivyei mbee wa Mwĩaĩi, nake akamũnenevya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.10",
            "verseOrgIds": [
              "JAS.4.10"
            ]
          }
        }
      ]
    },
    {
