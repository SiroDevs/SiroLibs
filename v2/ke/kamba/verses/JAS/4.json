                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.5"
              },
              "items": [
                {
                  "text": "Sav 39.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩndĩ mũiĩsĩ maũndũ ũndũ meĩthĩwa ũnĩ. Thayũ wenyu nĩ kyaũ? Nũndũ mwĩ mĩthũmũ ĩla yonekaa kavinda kanini, na ĩkyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.14",
            "verseOrgIds": [
              "JAS.4.14"
            ]
          }
        },
