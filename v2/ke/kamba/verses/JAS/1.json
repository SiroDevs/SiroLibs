            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmwĩsĩ ũu, ana‐a‐asa makwa endwa. Ĩndĩ kĩla mũndũ nĩethĩwe mwiwi wa mĩtũki, na kũlea kũneena mĩtũkĩ, na kũlea kũthata mĩtũkĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.19",
            "verseOrgIds": [
              "JAS.1.19"
            ]
          }
        },
        {
