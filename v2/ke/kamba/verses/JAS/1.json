                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũla ũsyaasya nthĩnĩ wa mwĩao mwĩthĩanu, naw’o nĩ mwĩao wa ũthasyo, na ekalaa vo, na akĩthĩwa ti mwĩwi ũla wũlawa ĩndĩ nĩ mwĩki ũla wĩkaa, mũndũ ũsu akaathimwa mawĩanĩ ala wĩkaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.25",
            "verseOrgIds": [
              "JAS.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JAS 1:26"
          },
          "items": [
