                  "text": "Alo 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ĩthĩwai mwĩ eki ma ndeto, na ti ewi oka, mũkĩkenga ene. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.22",
            "verseOrgIds": [
              "JAS.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JAS 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ethĩwa mũndũ ni mwĩwi wa ndeto na ti mwĩki, ailyi mũndũ ũla ũsyaasya ũthyũ wake, ũla wasyaiwe naw’o, kĩsisyonĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
            "verseOrgIds": [
              "JAS.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JAS 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ esisya mwene, na aithi, oyu niwũlawa ũndũ eĩĩlyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.24",
            "verseOrgIds": [
              "JAS.1.24"
            ]
          }
        },
        {
