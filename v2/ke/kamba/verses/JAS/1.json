            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ĩndĩ vetai kũasa nenyu ũvukyo w’onthe na wingĩ wa ũthũku, mũkyosa na ũuu ndeto ĩla ĩvandĩtwe, ĩla ĩtonya kũtangĩĩa mathayũ menyu, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.21",
            "verseOrgIds": [
              "JAS.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
