            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakovo, ngombo ya Ngai na ya Mwĩaĩi Yesũ Klĩsto, valũa ũũ wakwa wivikĩe ila mbaĩ ĩkũmi na ili syi Ũnyaĩĩkyonĩ, nĩ ngethi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
