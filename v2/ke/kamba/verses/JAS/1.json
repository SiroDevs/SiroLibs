                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.6"
              },
              "items": [
                {
                  "text": "1 Vet 1.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana‐a‐asa makwa ĩtalĩlei kwĩthĩwa nĩ ũtanu mũthei, yila mũũlika matatwanĩ ma mĩthemba mingĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.2",
            "verseOrgIds": [
              "JAS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.7"
              },
              "items": [
                {
                  "text": "1 Vet 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩmanya atĩ kũtatwa kwa mũĩkĩĩo wenyu kũetae wũmĩĩsyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.3",
            "verseOrgIds": [
              "JAS.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wũmĩĩsyo nĩwĩthĩwe na wĩa waw’o mwĩanĩũ, nĩ kana inyw’ĩ mũtw’ĩke eanĩu na aima, mũtatielye ũndũni o na wĩva.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.4",
            "verseOrgIds": [
              "JAS.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
