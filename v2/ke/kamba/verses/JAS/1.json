              },
              "items": [
                {
                  "text": "1 Vet 5.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.25"
              },
              "items": [
                {
                  "text": "1 Ako 9.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.10"
              },
              "items": [
                {
                  "text": "Ũvu 2.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ mũathime mũndũ ũla wũmĩĩasya matatwa; nũndũ eetĩkĩlwa, akanengwa ngovia ya ũsumbĩ ya thayũ, ĩla Mwĩaĩi wamathie ala mamwendaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ o na wĩva atatwa ndakasye, Nĩngũtatwa nĩ Ngai; nũndũ Ngai ndatonya kũtatwa nĩ ũthũku, o nake mwene ndatataa mũndũ: ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.13",
            "verseOrgIds": [
              "JAS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.7+ROM.7.8+ROM.7.9+ROM.7.10"
              },
              "items": [
                {
                  "text": "Alo 7.7–10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ kĩla mundũ atatawa akĩkusw’a na kũkengwa nĩ ĩtomo yake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.14",
            "verseOrgIds": [
              "JAS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ĩtomo yaya ĩvu, yĩsyaaa naĩ: na ĩla naĩ yeana, ĩsyaaa kĩkw’ũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikakengwe, ana‐a‐asa makwa endwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.16",
            "verseOrgIds": [
              "JAS.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
