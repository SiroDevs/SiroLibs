              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũsu, ngatũnga ũla ũthuaa, na ngatũnga ũla ũlũngĩtw’e, na ũla nĩthĩnĩtye, easya ũu Yeova; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
