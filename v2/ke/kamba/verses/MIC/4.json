          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ matyĩsĩ mosũanĩo ma Yeova, o na matiũmanya nzama yake; nũndũ nũmombanĩtye ta syove sya ngetha kĩvũĩonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.12",
            "verseOrgIds": [
              "MIC.4.12"
            ]
          }
        },
