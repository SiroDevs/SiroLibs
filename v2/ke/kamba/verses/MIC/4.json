          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu mbaĩ mbingĩ nikũmbanĩe, ila syaasya, Navukw’e, na metho maitũ nĩmone ũndũ tũkwenda ĩũlũ wa Saioni. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.11",
            "verseOrgIds": [
              "MIC.4.11"
            ]
          }
        },
        {
