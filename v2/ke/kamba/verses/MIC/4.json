          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngatw’a ũla wathuaa ũtialo, na ũla wekĩtw’e kũasa mbaĩ yĩ vinya: na Yeova akamasumbĩka kĩĩmanĩ kya Saioni kuma yu o na kũvika tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        },
        {
