                "loc": "JER.8.19"
              },
              "items": [
                {
                  "text": "Yel 8.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩwa na woo, na ũithĩna ũsyae, we mwĩĩtu wa Saioni, o ta mũndũ mũka ũnũkwaũnya; nũndũ yu ũkauma ndũanĩ, na ũkatũa weũnĩ, na ũkathi o kũvika Mbaviloni: nĩkw’o wĩtangĩĩĩwa; nĩkw’o Yeova wĩkwovoesya kuma kw’okonĩ kwa amaitha maku. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.10",
            "verseOrgIds": [
              "MIC.4.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
