            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ngo syonthe sya andũ iendaa kĩla ũmwe syĩtwanĩ ya ngai yake: na ithyĩ tũkaendaa syĩtwanĩ ya Yeova Ngai waitũ tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        },
        {
          "name": "note",
