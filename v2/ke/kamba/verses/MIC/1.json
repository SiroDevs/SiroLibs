              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ũla ũtwĩe Malesa, ngesa ũkũetee ũla ũkakũsumbĩka: ũtaĩo wa Isilaeli ũkavika o na Atulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.15",
            "verseOrgIds": [
              "MIC.1.15"
            ]
          }
        },
        {
