              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ya Yeova ĩla yamũkĩe Mika Mũmolasiti mĩthenya ya Yothamu, na Aasu, na Esekia, asumbĩ ma Yuta, ĩla wonie ũndũ wa Samalia na Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        },
        {
          "name": "note",
