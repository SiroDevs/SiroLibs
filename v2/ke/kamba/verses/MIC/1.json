                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
