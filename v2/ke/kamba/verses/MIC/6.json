            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ũko wakwa, nĩkwĩkĩte ata? Na nĩkũnoetye ũndũnĩ wĩva? Ngũsĩĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
