        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩnakwambatisye kũkumya nthĩ ya Misili, na nakwovosya kuma nyũmbanĩ ya ũkombo; na natũma Mose, na Aluni, na Miliamu makũtongoesye. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.51"
              },
              "items": [
                {
                  "text": "Kuma 12.51",
