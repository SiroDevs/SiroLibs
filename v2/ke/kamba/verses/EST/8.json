              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũsu mũsumbĩ Aasuelo amũnenga Esita mũka nyũmba ya Amani, mũmaitha wa Ayuti. Na Molitekai ooka vala ve mũsumbĩ; nũndũ Esita nĩwatavanĩtye ũndũ mailen’ye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.1",
            "verseOrgIds": [
              "EST.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
