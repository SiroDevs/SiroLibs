          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ala nthĩnĩ wamo mũsumbĩ amanenga Ayuti ala maĩ kĩla ndũa ũthei wa kũmbana, na kwĩyĩũngamĩa mathayũ moo, manange, na kũaa, na kũtuma waa, ũtonyi w’onthe wa andũ na wa kĩlungu kĩnene kya nthĩ ũla wĩenda kũmavithũkĩa, anini moo na iveti, na kũkwata syĩndũ syoo syĩthĩwe mũtavo, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.11",
            "verseOrgIds": [
              "EST.8.11"
            ]
          }
        },
