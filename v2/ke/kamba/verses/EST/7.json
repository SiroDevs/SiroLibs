        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mamũsũsya Amani mũtĩnĩ mũtũlu ũla waseũvĩsye Molitekai. Na ĩndĩ ũthilĩku wa mũsumbĩ wausya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.10",
            "verseOrgIds": [
              "EST.7.10"
            ]
          }
