          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩkwĩthĩwa Amani mwana wa Ametatha Mũakaki, mũmaitha wa Ayuti onthe, asilĩte ĩũlũ wa Ayuti amanange, na akĩkya Vuli, naw’o nĩ kũlimana, nĩ kana amamine, na kwananga; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
