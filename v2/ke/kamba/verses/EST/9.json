              },
              "items": [
                {
                  "text": "Est 5.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ayuti ala maĩ Susani moombana ĩngĩ mũthenya wa ĩkũmi na ĩna wa mwei wa Atali, na mooaĩa andũ maana atatũ vu Susani; ĩndĩ mũtavo maiaaũtambũũkĩsya moko moo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        },
