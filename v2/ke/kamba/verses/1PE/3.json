            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.12"
              },
              "items": [
                {
                  "text": "Isa 8.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ o na ethĩwa mũkathĩnw’a kwondũ wa ũlũngalũ, mwĩ aathime; na mũikakĩe kũtĩsya kwoo, o na mũikaũũye; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
