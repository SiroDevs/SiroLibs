            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.23"
              },
              "items": [
                {
                  "text": "1 Vet 2.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũikekũle, kana kwĩumĩa mwaumwa; ĩndĩ athimaai; nũndũ mweetĩwe ũndũ ũũ, nĩ kana mũtiĩwe ũathimo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
