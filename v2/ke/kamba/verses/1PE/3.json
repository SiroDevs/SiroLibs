                "loc": "1PE.2.12"
              },
              "items": [
                {
                  "text": "1 Vet 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "makyona mwĩkalĩle wenyu mũtheu wĩ na w’ĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
