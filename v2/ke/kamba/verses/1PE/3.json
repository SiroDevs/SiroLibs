                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwĩ na wasya mũseo wa ngoo: nĩ kana, ũndũnĩ ũla mũkwilĩĩlwa, masonokw’e ala mekũumanga mwĩkalĩle wenyu mũseo nthĩnĩ wa Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
