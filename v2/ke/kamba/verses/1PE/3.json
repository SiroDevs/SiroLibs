            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ ũla wĩmwĩka naĩ, ethĩwa mwĩthangaaĩa ũndũ ũseo? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
