              "items": [
                {
                  "text": "1 Tim 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwĩseũvya kwenyu kũikethĩwe kwĩseũvya kwa ũtheinĩ kwa kwokotha nzw’ĩĩ, na kwĩkĩa mĩio ya wanake ya thaavu, kana kwĩkĩa ngũa; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ nĩkwĩthĩwe mũndũ ũla ũtonekaa wa ngoo, kwĩvw’ĩkanĩ kũla kũtanangĩkaa kwa veva wa wĩnyivyo na wa ũuu, ũla wĩ vata mũno mbee wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũu nĩw’o aka atheu ma tene ala mekwatĩtye Ngai meeseũvisye, makĩnyivĩsya aũme moo: ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.12"
              },
              "items": [
                {
                  "text": "Mwa 18.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.25"
              },
              "items": [
                {
                  "text": "Nth 3.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o tondũ Sala wamwĩw’aa Avalaamu, akĩmwĩta vwana: nenyu mwĩ syana syake, ethĩwa mwĩkaa nesa, mũteũtĩsw’a nĩ w’ĩa o na wĩva.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
