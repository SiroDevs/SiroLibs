                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩ ũseo mbee, kũthĩnw’a kwondũ wa kwĩka nesa kwĩ kũthĩnw’a kwondũ wa kwĩka naĩ, ethĩwa nĩw’o kwenda kwa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
