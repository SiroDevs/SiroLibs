        },
        {
          "text": "O ta ũu, inyw’ĩ aũme, ĩkalai na iveti syenyu kwĩanana na ũmanyi, mũkĩmũnenga mũndũ mũka ndaĩa, ta mũio ũte na vinya, ta mwĩ atiĩwa vamwe ma mumo wa thayũ; nĩ kana mboya syenyu itikaisĩĩwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
