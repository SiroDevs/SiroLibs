          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.10"
              },
              "items": [
                {
                  "text": "Alo 12.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
