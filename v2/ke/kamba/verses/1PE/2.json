                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taĩai andũ onthe. Endai ana‐a‐asa. Mũkĩei Ngai. Mũtaĩei mũsumbĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
