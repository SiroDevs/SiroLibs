            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endwa, nĩngũmwĩsũva ta mwĩ ekali ma ũeninĩ na aendi ma kyalo, mwĩvathane na mĩmeo mĩthũku ya mwĩĩ, ĩla yũkitaa na ngoo; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
