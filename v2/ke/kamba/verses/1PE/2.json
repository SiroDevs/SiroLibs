                "loc": "ISA.10.3"
              },
              "items": [
                {
                  "text": "Isa 10.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.16"
              },
              "items": [
                {
                  "text": "Mt 5.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.3.13"
              },
              "items": [
                {
                  "text": "Yak 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwĩthĩwe na mwĩkalĩle waĩle kwa Andũ‐ma‐mbaĩ‐ingĩ; nĩ kana o na vala mamwilĩĩlaa ta mwĩ eki ma naĩ, yĩla meona meko menyu maseo, mamũtaĩe Ngai mũthenya wa kũsiw’a nĩwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
