                {
                  "text": "Sav 34.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethĩwa nĩmũsamĩte kana Mwĩaĩi nĩ mũseo: ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        },
        {
