                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ta tũũkenge tũsyaĩtwe mĩtũkĩ, endaĩ mũno ĩia ya kĩlĩko yĩte ĩthũkye, nĩ kana mwĩane ũtangĩĩonĩ kwondũ wayo; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.2",
            "verseOrgIds": [
              "1PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 2:3"
          },
          "items": [
