        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Kaini aneena na mwana‐a‐inyia Aveli. Na kweethĩwa, yĩla maĩ kĩsesinĩ, Kaini amũkĩlĩla mwana‐a‐inyia Aveli, na amũaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.8",
            "verseOrgIds": [
              "GEN.4.8"
            ]
          }
        },
