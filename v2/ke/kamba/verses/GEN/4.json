          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Aveli aete mosyao ma mbee ma ĩĩthya yake na mathunya mamo. Na Yeova eetĩkĩla Aveli na nthembo yake: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.4",
            "verseOrgIds": [
              "GEN.4.4"
            ]
          }
        },
        {
