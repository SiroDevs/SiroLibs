          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova akũlya Kaini, Aĩva Aveli, mwana‐a‐mwenyu? Nake asũngĩa, ndyĩsĩ: ninyie mũsũvĩi wa mwana‐a‐ia? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.44"
              },
              "items": [
                {
                  "text": "Yoa 8.44",
                  "type": "text"
                }
