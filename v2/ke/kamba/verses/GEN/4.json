            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa, Kwondũ wa ũu o ũla ũkoaa Kaini, nũkaĩvanĩw’a kũndũ mũonza. Na Yeova amwĩkĩa Kaini ũvano, kana o ũla ũkamwĩthĩa ndakaamũae. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
