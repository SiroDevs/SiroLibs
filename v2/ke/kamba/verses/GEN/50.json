              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.4"
              },
              "items": [
                {
                  "text": "Mwa 46.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.1",
            "verseOrgIds": [
              "GEN.50.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu ameaĩa athũkũmi make aiiti mekĩe kimba kya ĩthe wake mũtĩ: na ala aiiti meekĩa kimba kya Isilaeli mũtĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
              "GEN.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matukũ mĩongo ĩna meanĩw’a kwondũ wake; nĩkwĩthĩwa nĩw’o meanĩw’a matukũ ma kwĩkĩa kimba mũtĩ: na Amisili mamũĩĩa matukũ mĩongo mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
