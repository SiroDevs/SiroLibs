          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu amũvalũkĩla ĩthe wake ũthyũ, na amũĩĩa, na amũmumunya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.1",
            "verseOrgIds": [
              "GEN.50.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
