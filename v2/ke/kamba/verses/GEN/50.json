            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matukũ ma kũmũĩĩa mathela, Yosevu aneena na andũ ma nyũmba ya Valao, akĩmea, Ethĩwa yu nĩnonete ũseo methonĩ menyu, nĩngũmwĩsũva, neenai matũnĩ ma Valao, mũkĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.33.15"
              },
              "items": [
                {
                  "text": "Mwa 33.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nau nĩwambĩavĩthisye, akĩmbĩa, Sisya, nĩngũkw’a: mbũanĩ yakwa ĩla neeyĩnzĩe nthĩ ya Kanaani, kũu mũkanthika. Na yu ĩndĩ, nĩngũkwĩsũva, eka nambate nĩthike nau, na ngĩsyoka ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.14"
              },
              "items": [
                {
                  "text": "2 Mav 16.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.16"
              },
              "items": [
                {
                  "text": "Isa 22.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.60"
              },
              "items": [
                {
                  "text": "Mt 27.60",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Valao amwĩa, Ambata, ũthike au, kwĩanana na ũndũ wakwĩavĩthisye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu ambata athike ĩthe wake; na athũkũmi onthe ma Valao mambata vamwe nake, atumĩa ma nyũmba yake, na atumĩa onthe ma nthĩ ya Misili, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.7",
            "verseOrgIds": [
              "GEN.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na andũ onthe ma nyũmba ya Yosevu, na ana‐a‐ĩthe make, na andũ ma nyũmba ya ĩthe wake: no syana syoo nini, na ndĩthya syoo sya mbũi na malondu na ndĩthya syoo sya ng’ombe, matiie nthĩ ya Ngoseni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.8",
            "verseOrgIds": [
              "GEN.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vambata vamwe nake makasya o na ala matũlĩte mbalasi: na meethĩwa nguthu nene mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.9",
            "verseOrgIds": [
              "GEN.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mavika kĩvũĩoni kya Atati, kĩla kĩ mũingo wa Yolotani, kw’o maĩĩa kĩĩo kĩnene mũno kĩ woo: na aseũvya maĩo kwondũ wa ĩthe wake matukũ mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.17"
              },
              "items": [
                {
                  "text": "2 Sam 1.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.2"
              },
              "items": [
                {
                  "text": "Meko 8.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala matwĩe nthĩ ĩsu, Akanaani, moona ala maĩo kĩvũĩonĩ kya Atati, masya, Aa nĩ maĩo me woo kwa Amisili: kwondũ wa wa ũu syĩtwa ya vo veetwa Aveli‐misili, na vo nĩ mũingo wa Yolotani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana make mamwĩka kwĩanana na ũndũ wameaĩe: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.12",
            "verseOrgIds": [
              "GEN.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ ana make nĩmamũkuie mamũtwaa nthĩ ya Kanaani, na mamũthika ngunganĩ ya kĩsesi kĩ Makivela, ĩla Avalaamu wamũthooee Eveloni Mũititi, vu mbee wa Mamile, vamwe na kĩsesi, vethĩwe vake va mbũa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.30"
              },
              "items": [
                {
                  "text": "Mwa 49.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu asyoka Misili ĩtina wa kũthika ĩthe wake, we na ana‐a‐ĩthe na onthe ala mambatie vamwe nake kũthika ĩthe wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ana‐a‐ĩthe ma Yosevu moonie kana ĩthe woo nũnakwie, masya, Nokwĩthĩwa Yosevu atũmena, na kwĩĩvanĩsya vyũ ũthũku w’onthe ũla twamwĩkie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.15",
            "verseOrgIds": [
              "GEN.50.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matũma ũtũmane kwa Yosevu, makĩmwĩa, Au atanakw’a eaie, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.16",
            "verseOrgIds": [
              "GEN.50.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenai ũũ na Yosevu, Nĩngũkwĩsũva yu, ekea ana‐a‐au ĩvĩtyo na naĩ yoo, nĩkwĩthĩwa nĩmakwĩkie ũthũku. Na yu ĩndĩ, nĩtũũkwĩsũva, ekea athũkũmi ma Ngai wa au ĩvĩtyo yoo. Na Yosevu aĩa yĩla maneenie nake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.17",
            "verseOrgIds": [
              "GEN.50.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.25"
              },
              "items": [
                {
                  "text": "Mwa 49.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.17",
            "verseOrgIds": [
              "GEN.50.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ ana‐a‐ĩthe mathi na mavalũka nthĩ mbee wa ũthyũ wake; na mamwĩa, Sisya, ithyĩ twĩ athũkũmi maku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.18",
            "verseOrgIds": [
              "GEN.50.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.6"
              },
              "items": [
                {
                  "text": "Mwa 42.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.18",
            "verseOrgIds": [
              "GEN.50.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu amea, Mũikakĩe: nũndũ nyie nĩ vandũ va Ngai? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.19",
            "verseOrgIds": [
              "GEN.50.19"
            ]
          }
        },
