              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maiaamanya kana Yosevu nĩwamew’a; nũndũ mũalyũli aĩ katĩ woo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.23",
