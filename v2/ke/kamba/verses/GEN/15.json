              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amwĩa, Mbosea moi ya myaka ĩtatũ, na mbũi nga ya myaka ĩtatũ, na ndũũme ya myaka ĩtatũ, na ndumbũ, na ĩswii ya ĩvũĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
