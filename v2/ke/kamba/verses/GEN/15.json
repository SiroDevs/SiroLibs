          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eeyosea ii syonthe, na aatũan’ya katĩ, na aia kĩla nyunzu yelekele ĩla ĩngĩ: ĩndĩ nyũnyi ndaatũan’ya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
