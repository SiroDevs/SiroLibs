              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.3",
            "verseOrgIds": [
              "GEN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, ndeto ya Yeova yamũkĩa, ĩkĩmwĩa, Mũndũ ũsu ndakethĩwa mũtiĩwa waku; ĩndĩ ũla ũkauma kĩnyunyunĩ kyaku mwene nĩwe ũkethĩwa mũtiĩwa waku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
          }
        },
        {
