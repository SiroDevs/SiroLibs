            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Sala atheka ngoonĩ yake, akĩkũlya, Nĩ mũtumĩu ngeethĩwa na mũyo, mwĩaĩi wakwa nake e mũtumĩu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        },
        {
