          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala andũ mauma vau, masisya ngalĩ ya Sotomo: na Avalaamu aendan’ya nao amaumaaĩtye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.16",
            "verseOrgIds": [
              "GEN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova eekũlya, Nĩmũvithe Avalaamu ũndũ ngwĩka: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.17",
            "verseOrgIds": [
              "GEN.18.17"
            ]
          }
        },
        {
          "name": "note",
