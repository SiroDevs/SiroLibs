              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Avalaamu na Sala maĩ akũu, na ma myaka mingĩ; waĩ ũnaeka kwĩthĩwa na Sala mwĩkalĩle wa aka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.11",
