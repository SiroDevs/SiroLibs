          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ookĩlya metho na oona, na, sisya andũ atatũ nĩmaũngamĩte mbee wake; na amona, asemba kuma mũomonĩ wa ĩeema amathaũe, na eekunamya kũvika nthĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.2",
            "verseOrgIds": [
              "GEN.18.2"
            ]
          }
        },
        {
