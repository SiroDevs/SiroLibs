              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Sala akaĩa, akyasya, Ndinatheka; nũndũ aĩ na w’ĩa. Nake asya, Aiee; ĩndĩ nĩwatheka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
