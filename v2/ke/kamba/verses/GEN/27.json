                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
