              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na moosa kanzũ wa Yosevu, na mooaa nthenge, na mainda kanzũ nthakamenĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.31",
