          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oomanya, na asya, Nĩ kanzũ wa mwana wakwa; nũlĩkĩte nĩ nyamũ mbai; vate nzĩka Yosevu nũtilangĩtwe ilungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
