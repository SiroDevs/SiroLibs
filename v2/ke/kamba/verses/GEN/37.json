          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, Yosevu avika kũla ana‐a‐ĩthe maĩ, mamumya Yosevu ũla kanzũ wake, kanzũ wa langi wa mĩthemba mingĩ ũla wekĩe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.23",
            "verseOrgIds": [
              "GEN.37.23"
            ]
          }
        },
        {
