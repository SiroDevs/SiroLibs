          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mamwosa, na mamwĩkya ĩimanĩ: na ĩima yaĩ ĩthei, yĩtyaĩ na manzĩ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.24",
            "verseOrgIds": [
              "GEN.37.24"
