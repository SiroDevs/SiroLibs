          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, Yeova aũngamĩte ĩũlangũ wayo, na amwĩa, Ninyie Yeova, Ngai wa Avalaamu ĩthe waku, na Ngai wa Isaka: nthĩ ĩla ũkomete, ngakũnenga we, na ũsyao waku; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
