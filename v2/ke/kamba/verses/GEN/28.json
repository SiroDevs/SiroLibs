          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ngai Mwene Vinya W’onthe akũathime, na akwongeleele, na akwingĩvye, wĩthĩwe wĩ nguthu sya ngo sya andũ; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
            "verseOrgIds": [
              "GEN.28.3"
            ]
          }
        },
        {
