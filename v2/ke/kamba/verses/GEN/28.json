          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩndĩ Esau athi kwa Isumaeli, atwaa Maalathi mwĩĩtu wa Isumaeli mwana wa Avalaamu, mwĩĩtu‐a‐inyia wa Nevaiothi, ethĩwe mũka wake vamwe na aka ala waĩ nao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        },
        {
