              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Esau oona kana Isaka nĩwamũathima Yakovo na amũtũma Vatani‐alamu, akatwae mũka kuma kũu; nake akĩmũathima, amwĩaĩa, akĩmwĩa, Ndũkaatwae mũka wa eĩtu ma Kanaani; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kana Yakovo nĩwew’a ĩthe na nyinyia, nake athi Vatani‐alamu: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Esau oona kana Isaka ĩthe wake ndaaendeew’a nĩ eĩtu ma Kanaani; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
          }
        },
        {
