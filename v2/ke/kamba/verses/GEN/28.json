          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akũnenge ũathimo wa Avalaamu, we, na ũsyao waku vamwe naku; nĩ kana ũtiĩwe nthĩ ya kwĩkala ũeni kwaku, ĩla Ngai wamũnengie Avalaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
