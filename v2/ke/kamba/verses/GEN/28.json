          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkĩla, ũende Vatani‐alamu, nyũmbanĩ ya Mbethueli ĩthe wa mwenyu; na ũketwaĩe mũka kuma kũu eĩtunĩ ma Lavani mwana‐a‐inyia wa mwenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.2",
            "verseOrgIds": [
              "GEN.28.2"
            ]
          }
        },
        {
