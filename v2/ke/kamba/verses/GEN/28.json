            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na avika vandũ vamwe, na ekala vo ũtukũ mũima, nũndũ syũa yaĩ yĩnathũa; na oosa ĩvia yĩmwe ya vandũ vau, aia ungu wa mũtwe, na akoma o vo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
