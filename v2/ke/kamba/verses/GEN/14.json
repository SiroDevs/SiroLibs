              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Melikiseteki mũsumbĩ wa Saleme aete kĩmũtũ na mbinyu: nake aĩ mũthembi wa Ngai Ũla Wĩ Ĩũlũ wa Onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
              "GEN.14.18"
            ]
          }
        },
