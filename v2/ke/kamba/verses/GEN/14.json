            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ wa Sotomo athi kũmũthaũa, ĩtina wa kũsyoka kwake kuma kũaa Ketololaomeli na asumbĩ ala maĩ vamwe nake, mwandanĩ wa Save (nĩw’o Mwanda wa Mũsumbĩ). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.17",
            "verseOrgIds": [
              "GEN.14.17"
            ]
          }
        },
        {
