          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana kũathima ngakũathima, na kwingĩvya ngaingĩvya ũsyao waku ta ndata sya matunĩ, na ta kĩthangathĩ kĩ ũtee wa ũkanga; na ũsyao waku ũkatiĩwa mbingĩlo ya amaitha maw’o; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.17",
            "verseOrgIds": [
              "GEN.22.17"
            ]
          }
        },
