              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usi ĩkithathi yake, na Mbusi mwana‐a‐inyia, na Kemueli ĩthe wa Alamu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
