          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mbethueli asyaa Leveka: asu nyanya Milika asyaĩa Naoli, mwana‐a‐inyia wa Avalaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.23",
            "verseOrgIds": [
              "GEN.22.23"
            ]
          }
