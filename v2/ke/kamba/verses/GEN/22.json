          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ĩtina wa maũndũ asu, Ngai atata Avalaamu, na amwĩa, Avalaamu; nake asũngĩa, Ninyioo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        },
        {
