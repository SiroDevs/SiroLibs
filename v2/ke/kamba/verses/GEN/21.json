          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalaamu asũngĩa, Nĩngwĩvĩta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalaamu amũkan’ya Avimeleki nũndũ wa kĩthima kya manzĩ, kĩla athũkũmi ma Avimeleki mavenanie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.25",
            "verseOrgIds": [
              "GEN.21.25"
            ]
          }
        },
        {
