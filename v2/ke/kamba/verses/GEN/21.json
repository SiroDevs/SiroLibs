                "loc": "GEN.26.15+GEN.26.16+GEN.26.17+GEN.26.18+GEN.26.19+GEN.26.20+GEN.26.21+GEN.26.22"
              },
              "items": [
                {
                  "text": "Mwa 26.15–22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.25",
            "verseOrgIds": [
              "GEN.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
