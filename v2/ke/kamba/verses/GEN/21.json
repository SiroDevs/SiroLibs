                "loc": "GEN.26.28+GEN.26.29+GEN.26.30+GEN.26.31"
              },
              "items": [
                {
                  "text": "Mwa 26.28–31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.27",
            "verseOrgIds": [
              "GEN.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalaamu aia tũmyati mũonza twa ĩĩthya twĩ tw’oka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.28",
            "verseOrgIds": [
              "GEN.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avimeleki amũkũlya Avalaamu, Nĩ twa kĩ tũmyati tũũ mũonza wiĩte tw’oka? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.29",
            "verseOrgIds": [
              "GEN.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake asũngĩa, Tũmyati tũũ mũonza ũtwose kw’okonĩ kwakwa, wĩthĩwe ũkũsĩ kwakwa, kana ninyie nĩnzĩte kĩthima kĩĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
            "verseOrgIds": [
              "GEN.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu eeta vandũ vau Mbeeli‐sieva; nũndũ nĩvo meevĩtĩe me elĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
