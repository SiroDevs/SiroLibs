            "sid": "GEN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Sala aya ĩvu, na amũsyaĩa Avalaamu mwana ũkũunĩ wake, ĩvinda yĩtw’e yĩla watavĩw’e nĩ Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.2",
            "verseOrgIds": [
              "GEN.21.2"
            ]
          }
        },
        {
