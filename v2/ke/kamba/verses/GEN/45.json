              "type": "tag",
              "attrs": {
                "loc": "GEN.45.19"
              },
              "items": [
                {
                  "text": "Mwa 45.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 45:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Isilaeli asya, Nũũ; Yosevu mwana wakwa e o thayũ: ngaenda ngamwone ndanakw’a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.28",
