              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athamba ũthyũ, na aumaala; na eeyũmĩĩsya, na asya. Iai lĩu mesanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.31",
