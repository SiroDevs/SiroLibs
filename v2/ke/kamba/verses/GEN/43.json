            "number": "23",
            "style": "v",
            "sid": "GEN 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amasũngĩa, Mũuo wĩthĩwe kwenyu, mũikakĩe: Ngai wenyu, na Ngai wa ĩthe wenyu, nĩwamũnengie ũthwii makunianĩ menyu: nyie naĩ na mbesa syenyu. Na amaumĩlĩlya Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.23",
            "verseOrgIds": [
              "GEN.43.23"
            ]
          }
        },
        {
          "name": "verse",
