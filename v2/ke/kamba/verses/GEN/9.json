                  "text": "Mwa 6.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.9",
            "verseOrgIds": [
              "GEN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na kĩla kyũmbe kĩ thayũ kĩ vamwe nenyu, na nyũnyi, na indo, na kĩla nyamũ ya nthĩ vamwe nenyu; syonthe ila syumĩte ngalawanĩ, o kĩla nyamũ ya nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
            "verseOrgIds": [
              "GEN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngalũlũmĩlya ũtianĩo wakwa nenyu; o na mĩĩ yonthe ndĩkanangwa ĩngĩ nĩ manzĩ ma kĩla kĩw’ũ kingĩ; o na kũikethĩwa kĩw’ũ kingĩ ĩngĩ, kya kwananga nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
