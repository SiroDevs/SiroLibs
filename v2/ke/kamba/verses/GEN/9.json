              "type": "text"
            }
          ]
        },
        {
          "text": "Na Noa ambĩlĩlya kwĩthĩwa mũĩmi, na avanda mũũnda mĩsavivũ: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.20",
            "verseOrgIds": [
              "GEN.9.20"
            ]
