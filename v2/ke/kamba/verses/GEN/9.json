              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, yĩla ngaete ĩthweo ĩũlũ wa nthĩ, ũtaathĩ ũkoonekaa ĩthweonĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
