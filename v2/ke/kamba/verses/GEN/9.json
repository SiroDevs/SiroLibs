          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩla kĩndũ kĩendaa kĩ thayũ kĩkeethĩwa lĩu kwenyu; o ta nyũnyi nziũ nĩnĩmũnengete syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
