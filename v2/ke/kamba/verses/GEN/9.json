          ]
        },
        {
          "text": "Na Noa ekala ĩtina wa kĩla kĩw’ũ kingĩ myaka maana atatũ na mĩongo ĩtano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.28",
