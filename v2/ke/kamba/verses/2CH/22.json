      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala matwĩe Yelusaleme mamũsũmbĩkya Aasia mwana wake wa ĩlumaita vandũ vake; nũndũ nguthu ya andũ ala mookie na Alavu mwakonĩ wa maeema nĩmoaĩte onthe ala akũũ. Na ĩndĩ Aasia mwana wa Yeolamu mũsumbĩ wa Yuta asumbĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
