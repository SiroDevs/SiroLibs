              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla Yeu wasilĩlaa nyũmba ya Aavu, eethĩa anene me mbee ũsumbĩnĩ ma Yuta na ana ma ana‐a‐ĩthe ma Aasia, makĩthũkũma Aasia, na amoaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.11+2KI.10.12+2KI.10.13+2KI.10.14"
              },
              "items": [
                {
                  "text": "2 Asu 10.11–14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amantha Aasia, na mamũkwata (na eevithĩte ku Samalia), na mamũete kwa Yeu na mamũaa; na mamũthika, nũndũ maisye, Nĩ mwana wa Yeosavati, ũla wamũmanthie Yeova na ngoo yake yonthe. Na nyũmba ya Aasĩa ndĩaĩ na ũtonyi wa kũlũmya ũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.27"
              },
              "items": [
                {
                  "text": "2 Asu 9.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.28"
              },
              "items": [
                {
                  "text": "28",
