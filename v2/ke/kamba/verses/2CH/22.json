            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Athalia inyia wa Aasia wonie kana mwana wake nĩ mũkw’ũ, ookĩla na amina ũsyao w’onthe wa kĩũsumbĩ wa nyũmba ya Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.11.1+2KI.11.2+2KI.11.3"
              },
              "items": [
                {
                  "text": "2 Asu 11.1–3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yeosaveathi, mwĩĩtu wa mũsumbĩ, oosa Yoasi mwana wa Aasia, na amũya kũmumya ananĩ ma mũsumbĩ ala mooaawa, na amwĩkĩa e na mũei wake kasũmbanĩ ka ũkoma. Ũu nĩw’o Yeosaveathi mwĩĩtu wa mũsumbĩ Yeolamu, kĩveti kya mũthembi Yeoiata (nũndũ aĩ mwĩĩtu‐ainyia wa Aasia), wamũvithie Athalia ndakamwone, na ĩndĩ ndaamũaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aĩ nao avithĩtwe nyũmbanĩ ya Ngaĩ myaka thanthatũ: na Athalia asumbĩka ĩ nthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
      ]
