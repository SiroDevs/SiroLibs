              "2CH.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasia aĩ wa myaka mĩongo ĩna na ĩlĩ yĩla wambĩlĩlye kũsumbĩka; na asumbĩka mwaka ũmwe Yelusaleme: na syĩtwa ya inyia wake eetawa Athalia mwĩĩtu wa Omili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.6"
              },
              "items": [
                {
                  "text": "2 Mav 21.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake nĩwaendaa mĩendelenĩ ya nyũmba ya Aavu; nũndũ inyia wake aĩ mũtai wake wa ũmwĩkĩthya naĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩwekaa ũla Yeova wonaa wĩ ũthũku, o tondũ nyũmba ya Aavu yekaa; nũndũ maĩ atai make ĩtina wa kĩkw’ũ kya ĩthe wake, kũvika aanangĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na aendaa aatĩĩe ũtao woo, na aendaa na Yeolamu mwana wa Aavu mũsumbĩ wa Isilaeli okite na Aasaeli mũsumbĩ wa Silia ku Lamothi‐ngileati: na Asilia mamũkita Yolamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asyoka avoee ku Yesileeli mawũkite ala mamũkitĩe Lama, yĩla wokitaa na Aasaeli mũsumbĩ wa Silia. Na Asalia mwana wa Yeolamu mũsumbĩ wa Yuta atheea kũsisya Yeolamu mwana wa Aavu ku, Yesileeli, nũndũ aĩ mũwau.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
