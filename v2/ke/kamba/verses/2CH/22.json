          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ wanangĩko wa Aasĩa waumie kwa Ngai, nũndũ nĩwaendie kwa Yolamu: nũndũ yĩla wavikie, aumaala na Yeolamu mokite na Yeu mwana wa Nimisi, ũla Yeova wamwĩtĩkĩsye mauta avete nyũmba ya Aavu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
