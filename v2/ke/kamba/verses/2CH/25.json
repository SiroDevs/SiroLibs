            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ĩngĩ Amasia oomban’ya Yuta, na amaia kwĩanana na nyũmba sya aaĩthe moo, ĩtheo wa makavuteni ma ngili ngili na makavuteni ma maana, o Yuta onthe na Mbenyamini: na amatala kuma ala mavikĩtye myaka mĩongo ĩlĩ na mbee, na eethĩa nĩ andũ anyuve ngili maana atatũ, ala maĩ matonya kũthi kaũnĩ, ala maĩ matonya kũkwata ĩtumo na ngao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.1.3"
              },
              "items": [
                {
                  "text": "Mot 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.17.14+2CH.17.15+2CH.17.16+2CH.17.17+2CH.17.18"
              },
              "items": [
                {
                  "text": "2 Mav 17.14–18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.13"
              },
              "items": [
                {
                  "text": "26.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na aandĩka ngũmbaũ nene sya Isilaeli, andũ ngili ĩana, talendi ĩana sya vetha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũndũ wa Ngai amũendea, akĩmwĩa, We mũsumbĩ, ndũkaeke ita sya Isilaeli iende naku; nũndũ Yeova nde vamwe na Isilaeli, o asu onthe ana ma Evalaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa ndũtĩa kũthi, ĩka na ũkũmbaũ, ĩthĩwa na vinya wa kũkita: Ngai akakũvalũkya nthĩ vu mbee wa mũmaitha; nũndũ Ngai e na ũtonyi wa kũtethya, na wa kũvalũkya nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.6"
              },
              "items": [
                {
                  "text": "1 Sam 14.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.11"
              },
              "items": [
                {
                  "text": "2 Mav 14.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.6"
              },
              "items": [
                {
                  "text": "20.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Amasia amwĩa mũndũ wa Ngai, Ĩndĩ tũkeeka ata ũndũ wa talendi ĩana ila nanengie ita sya Isilaeli? Na mũndũ wa Ngai asũngĩa, Yeova nũtonya ũkũnenga mbingĩ kwĩ isu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Amasia waitaanũkanisye, o ita ila syamũkĩe kuma Evalaimu, syĩnũke: kwondũ wa ũu ũthatu wasyo wamakanĩa Yuta mũno, na syenũka na ũthatu mwai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Amasia eethĩwa na ũkũmbaũ, na amatongoesya andũ make, na athi Kyandanĩ kya Mũnyũ, na ooaa ana ma Seili ngili ĩkũmi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.7"
              },
              "items": [
                {
                  "text": "2 Asu 14.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngili ingĩ ĩkũmi ana ma Yuta mamatava me thayũ, na mamatwaa ĩũlũ wa ũvai, na mamekya nthĩ kuma ĩũlũ wa ũvai, na onthe mavevenzeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ andũ ma ita ala Amasia wamenũkisye, matikaende nake kaũnĩ, maivithũkĩa ndũa sya Yuta, kuma Samalia o kũvika Mbethi‐oloni, na makũna ngili itatũ, na matava mũtavo mwingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.8"
              },
              "items": [
                {
                  "text": "2 Mav 15.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.19.4"
              },
              "items": [
                {
                  "text": "19.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ kweethĩwa, Amasia amina kũsyoka kũma kũaa Aetomu, aete ngai sya ana ma Seili, na aiũngamya syĩthĩwe ngai syake, na asyĩkunamĩsya, na aitoeesya ũvani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ũthatu wa Yeova wakanĩa Amasia, na atũma mwathani kwake, ũla wamwĩie, Ũmanthĩte ngai sya andũ nĩkĩ, ila itaneevonokya andũ moo ene kw’okoni kwaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, akĩneena nake, mũsumbĩ amũkũlya, Nĩtwakũnyuvie wĩthĩwe wa atai ma mũsumbĩ? Eka; nĩkĩ ũkwenda ũkũnwa? Na ĩndĩ mwathani aeka, na asya, Nĩnĩsĩ Ngai mũtw’ĩte ũkwananga, nĩkwĩthĩwa nĩwĩkĩte ũu, na ndwaaĩthukĩĩsya ũtao wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.20"
              },
              "items": [
                {
                  "text": "Yos 11.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Amasia mũsumbĩ wa Yuta wasũanĩie, na atũmana kwa Yoasi, mwana wa Yeoaasi mwana wa Yeu, mũsumbĩ wa Isilaeli, akyasya, Ũka twonane ũthyũ kwa ũthyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.8+2KI.14.9+2KI.14.10+2KI.14.11+2KI.14.12+2KI.14.13+2KI.14.14"
              },
              "items": [
                {
                  "text": "2 Asu 14.8–14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoasi mũsumbĩ wa Isilaeli atũmana kwa Amasia mũsumbĩ wa Yuta, akyasya, Thangila ũla waĩ Levanoni watũmana kwa mũkũũ ũla waĩ Levanoni, ũkyasya, Mũnenge mwana wakwa mwĩĩtu waku ethĩwe mũka: na nyamũ mbai ĩla yaĩ Levanoni yavĩta, na yakinyanga ũla thangila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.8+JDG.9.9+JDG.9.10+JDG.9.11+JDG.9.12+JDG.9.13+JDG.9.14+JDG.9.15"
              },
              "items": [
                {
                  "text": "Asi 9.8–15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku nũkwasya, Sisya, nũkũnĩte Etomu; na ngoo yaku nĩnĩkũkũkĩlya wĩkathĩĩe: ĩkala yu kwaku; nũndũ wa kĩ ũkwĩlikya maũndũnĩ ma kwĩyĩka naĩ, nĩ kana ũvalũke, o we, wĩ na Yuta?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Amasia ndaaĩtĩkĩla kwĩthukĩĩsya; nũndũ ũndũ ũsu waumĩte kwa Ngai, nĩ kana amanengane kw’okonĩ kwa amaitha moo, nĩkwĩthĩwa nĩmamanthĩte ngai sya Etomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yoasi mũsumbĩ wa Isilaeli ambata; nake na Amasia mũsumbĩ wa Yuta moonanĩa ũthyũ kwa ũthyũ ku Mbethi‐semesi, ĩla ya Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yũta makũnwa nĩ Isilaeli; na makũka kĩla mũndũ athi ĩeemanĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoasi mũsumbĩ wa Isilaeli amũkwatĩa Amasia mũsumbĩ wa Yuta, mwana wa Yoasi mwana wa Yeoaasi, ku Mbethi‐semesi, na amũtwaa Yelusaleme, na aomboanga ũvai wa Yelusaleme kuma mbĩngĩlonĩ ya Evalaimu kũvika mbingĩlonĩ ya kĩkotonĩ, mĩkono maana ana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.17"
              },
              "items": [
                {
                  "text": "2 Mav 21.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.16"
              },
              "items": [
                {
                  "text": "Nee 8.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oosa thaavu na vetha w’onthe, na mĩio yonthe ĩla yonekie kwa Oveti‐etomu nyũmbanĩ ya Ngai, na mothwii maie ma nyũmba ya mũsumbĩ, o na andũ na ngwatĩlĩlyo, na asyoka Samalia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Amasia mwana wa Yoasi mũsumbĩ wa Yuta ekala thayũ ĩtina wa kĩkw’ũ kya Yoasi mwana wa Yeoaasi mũsumbĩ wa Isilaeli myaka ĩkũmi na ĩtano. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.17+2KI.14.18+2KI.14.19+2KI.14.20"
              },
              "items": [
                {
                  "text": "2 Asu 14.17–20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ meko ala angĩ ma Amasia, ma mbee na ma mũminũkĩlyo, sisya, matiandĩkĩtwe ĩvukunĩ ya asumbĩ ma Yuta na Isilaeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ kuma ĩvinda yĩla Amasia wethyũũie aeka kũmũatĩĩa Yeova nĩmamũsamĩĩe ku Yelusaleme; na akĩĩa Lakisi: ĩndĩ matũmana aatĩĩwe Lakisi, na mamũaĩa kw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamũete akuĩtwe nĩ mbalasi, na mamũthika vamwe na aaĩthe make ndũanĩ ya Yuta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
