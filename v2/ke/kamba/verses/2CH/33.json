                "loc": "2KI.21.17"
              },
              "items": [
                {
                  "text": "2 Asu 21.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
