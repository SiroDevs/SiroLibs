            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũsumbĩ wa Yuta, ũla ũmũtũmie mũkũlye kwa Yeova, ũũ nĩw’o mwĩmwĩa, Ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũkwasya: Ũndũ wa ndeto ila wĩw’ĩte, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩkwĩthĩwa ngoo yaku ĩnaĩ mbololo, na weenyivya vala ve Ngai, yĩla ũneewie ndeto syake ĩũlũ wa vandũ vaa, na ĩũlũ wa andũ ala matwĩe vaa, na nĩwĩnyivĩtye vala nĩĩ, na nũtembũangĩte ngũa syaku, na kũĩa mbee wakwa; o nakwa nĩnĩkwĩw’ĩte, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, ngakũmban’ya wĩthĩwe vamwe na aaĩthe maku, na ũkoombanw’a mbũanĩ yaku na mũuo, o na metho maku matikona ũthũku w’onthe ũla ngaete ĩũlũ wa vandũ vaa, na ĩũlũ wa ala mavatwĩe. Na mamũtũngĩa mũsumbĩ ũvoo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
