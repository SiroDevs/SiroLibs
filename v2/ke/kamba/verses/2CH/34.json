            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia aĩ wa myaka nyanya yĩla wambĩlĩlye kũsumbĩka; na asumbĩka myaka mĩongo ĩtatũ na ũmwe ku Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
