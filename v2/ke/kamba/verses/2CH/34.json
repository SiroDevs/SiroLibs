              },
              "items": [
                {
                  "text": "31.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maananga ithembeo sya Mbaalimu e vo; na amĩtemanga mĩvw’anano ya syũa ĩla yaĩ ĩũlũ wasyo yavalũka; na Aselimu, na mĩvw’anano myasũvye, na mĩvw’anano yaseũvĩtw’e na syĩndũ ila matwekethisye, amĩtũlanga ilungu, na amĩtw’ĩkĩthya kĩtoo, na akĩnyaĩĩkya mbũanĩ sya ala mamĩthembeaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na avĩvĩsya mavĩndĩ ma athembĩ ithembeonĩ syoo, na athesya Yuta na Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1 Asu 13.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.20"
              },
              "items": [
                {
                  "text": "2 Asu 23.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eeka ũu ndũanĩ sya Manase na Evalaimu na Simeoni, o kũvika Navitali, moombokunĩ masyo ngalĩ syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.15"
              },
              "items": [
                {
                  "text": "2 Asu 23.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aananga ithembeo, na atumbatumba Aselimu na mĩvw’anano myasũvye yatw’ĩka ta kĩtoo, na atemanga mĩvw’anano yonthe ya syũa nthĩ yonthe ya Isilaeli yavalũka, na asyoka Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
