            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa nĩmandiĩte, na nĩmatoeesye ngai ingĩ ũvani, nĩ kana manthatye na mawĩa onthe ma moko moo; kwondũ wa ũu ũthilĩku wakwa nĩ mwonosye ĩũlũ wa vandũ vaa, na ndũkavoeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
