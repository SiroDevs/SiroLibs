            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mwaka wa nyanya wa kũsumbĩka kwake, o yĩla waĩ mũnini, nĩwambĩlĩlye kũmantha Ngai wa Ndaviti ĩthe wake; na mwaka wa ĩkũmi na ĩlĩ ambĩlĩlya kũthesya Yuta na Yelusaleme aiveta kũla kũndũ kũtũlu, na Aselimu, na mĩvw’anano myasũvye, na mĩvw’anano yaseũvĩtw’e na syĩndũ ila matwekethisye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.6"
              },
              "items": [
                {
                  "text": "2 Asu 23.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.3"
              },
              "items": [
                {
                  "text": "2 Mav 14.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
