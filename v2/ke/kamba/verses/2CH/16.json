              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, meko ma Asa, ma mbee na ma mũminũkĩlyo, sisya, nĩmaandĩkĩtwe ĩvukunĩ ya asumbĩ ma Yuta na Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
            "verseOrgIds": [
              "2CH.16.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
