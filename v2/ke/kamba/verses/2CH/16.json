            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aethiovia na Aluvi matyaĩ nguthu nene mũno, me na makasya ma kaũ na andũ ala matũlaa mbalasi aingĩ mũno? Ĩndĩ, nĩkwĩthĩwa nĩwamwĩkwatisye Yeova, nake amanengane kw’okonĩ kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
