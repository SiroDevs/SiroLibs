                  "text": "Meko 5.39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
