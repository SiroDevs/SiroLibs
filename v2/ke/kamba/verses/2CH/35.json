                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.31.3"
              },
              "items": [
                {
                  "text": "31.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene make me mbee ũsumbĩnĩ nĩmanenganie kwondũ wa andũ, na athembi, na Alivai, sya nthembo ya kumya na ngoo ya kwenda. Ilikia na Nzekalia na Yeiieli, anene ma nyũmba ya Ngai, manenga athembi kwondũ wa nthembo sya vasaka kuma ndĩthyanĩ sya mbũi na malondu ngili ilĩ na maana thanthatũ, na ng’ombe maana atatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
