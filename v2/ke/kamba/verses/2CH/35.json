        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩyũmban’yei kwĩanana na nyũmba sya aaĩthe menyu kũatĩanĩa na nguthu syenyu, kwĩanana na ũndũ kwaandĩkiwe nĩ Ndaviti mũsumbĩ wa Isilaeli, na kwĩanana na ũndũ kwaandĩkiwe nĩ Solomoni mwana wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
