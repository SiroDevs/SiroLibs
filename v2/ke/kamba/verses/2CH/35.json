              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
