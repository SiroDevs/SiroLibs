                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.8.14"
              },
              "items": [
                {
                  "text": "2 Mav 8.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũngamai vala vandũ vatheu kwĩanana na nguthu sya nyũmba sya aaĩthe sya ana‐a‐ĩthe menyu ana ma ala andũ, na nĩkwĩthĩwe kwondũ wa kĩla ũmwe kĩlungu kya nyũmba ya aaĩthe ma Alivai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũaai vasaka, na mũkĩĩvathan’ya mwĩthĩwe atheu, na kũseũvya kwondũ wa ana‐a‐ĩthe menyu, mwĩke kwĩanana na ndeto ya Yeova, na kanyw’a wa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        },
        {
