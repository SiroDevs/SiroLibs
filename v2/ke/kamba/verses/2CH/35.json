              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũtyaĩ vasaka waalilikanwa nthĩnĩ wa Isilaeli ĩtina wa mĩthenya ya mwathani Samueli ta ũsu; o na kũtyaĩ mũsumbĩ o na ũmwe wa Isilaeli ũla walilikanile vasaka ta ũsu Yosia walilikanile, vamwe na athembĩ, na Alivai, na Yuta na Isilaeli onthe ala maĩ vo, na ala matwĩe Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
