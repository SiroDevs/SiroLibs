              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vasaka ũsu walilikanilwe mwaka wa ĩkũmi na nyanya wa kũsumbĩka kwa Yosia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
