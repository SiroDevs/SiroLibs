            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yosia ndaaĩtĩkĩla kũthyũũa ũthyũ wake amũeke, ĩndĩ eeyũlan’ya nĩ kana okite nake, na ndaaĩthukĩĩsya ndeto sya Neko ila syaumĩte kanyw’anĩ wa Ngai, na ooka akwatĩsye kaũ mwandanĩ wa Mekito. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
