              "type": "tag",
              "attrs": {
                "loc": "1KI.22.34"
              },
              "items": [
                {
                  "text": "1 Asu 22.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu athũkũmi make mamumya ĩkasyanĩ ya kaũ, na mamwĩkĩa ĩkasyanĩ ya kelĩ yĩla waĩ nayo, na mamũtwaa Yelusaleme; na akw’a, na athikwa ngunganĩ sya aaĩthe make vala vathikawa akw’ũ. Na Yuta na Yelusaleme onthe mamũmetea Yosia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
