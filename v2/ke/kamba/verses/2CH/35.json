        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na Konania, na Semaia, na Nethaneli, ana‐a‐ĩthe make, na Asavia na Yeieli na Yosavati, anene ma Alivai, mamanenga Alivai kwondũ wa nthembo sya vasaka kuma ndĩthyanĩ sya mbũi na malondu ngili itano, na ng’ombe maana atano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        }
