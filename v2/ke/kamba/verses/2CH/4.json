              "type": "text"
            }
          ]
        },
        {
          "text": "ũkanga ũmwe, na ila nzaũ ĩkũmi na ilĩ ungu waw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
