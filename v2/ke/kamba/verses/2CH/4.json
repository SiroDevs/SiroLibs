              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũsumbĩ amĩtũĩe ũiĩnĩ wa Yolotani, nthĩ yĩ yũmba katĩ wa Sukothi na Nzeleta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
