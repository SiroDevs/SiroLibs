          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na mbisũ, na mĩko, na itonyi sya nyama, na mĩio yonthe yayo, Ulamu ĩthe wake amũseũvĩsya mũsumbĩ Solomoni, ya ũthuku mũkute, kwondũ wa nyũmba ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
