            "number": "18",
            "style": "v",
            "sid": "2CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũu nĩw’o Solomoni waseũvĩthisye mĩio ĩsu yonthe mingĩ mũno: nũndũ ũito wa ũthuku ndwaĩ ũtonya kũmanyĩka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
