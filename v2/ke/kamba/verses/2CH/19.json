          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ve maũndũ maseo moneku nthĩnĩ waku, nũndũ nũvetete Aselothi kuma ĩ nthĩ, na nũlũlũmĩlye ngoo yaku ũmũmanthe Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        },
        {
