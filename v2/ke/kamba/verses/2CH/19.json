              "items": [
                {
                  "text": "Esa 7.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ameaĩa, akĩmea, Mũkeke ũu mũkĩmũkĩa Yeova, mwĩ na kĩthito, na mwĩ na ngoo mbĩanĩu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.3"
              },
              "items": [
                {
                  "text": "2 Sam 23.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.61"
              },
              "items": [
                {
                  "text": "1 Asu 8.61",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na o yĩla ngananĩo o na yĩva ĩkamũvikĩa kuma kwa ana‐a‐ĩthe menyu ala matwĩe ndũanĩ syoo, katĩ wa nthakame na nthakame, katĩ wa mwĩao na mwamũlo, mĩao na motw’ĩo, mwĩmon’ya matikethĩwe na ĩvĩtyo kũla kwĩ Yeova, na kwondũ wa ũu ũthilĩku wĩmũkĩa inyw’ĩ na ana‐a‐ĩthe menyu: ĩkaai ũu, na mũtikethĩwa na ĩvĩtyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, Amalia mũthembi mũnene nĩ mũnene wenyu maũndũnĩ onthe ma Yeova: na Nzevatia mwana wa Isumaelĩ, mũnene wa nyũmba ya Yuta, maũndũnĩ onthe ma mũsumbĩ: o na Alivai makeethĩwa anene ma kwenyu. Ĩkaai na ũkũmbaũ, na Yeova nĩethĩwe vamwe na ala aseo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        },
