              },
              "items": [
                {
                  "text": "Kũt 1.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.6",
            "verseOrgIds": [
              "2CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu kũmũkĩa Yeova nĩkwĩthĩwe nenyu; ĩsũvĩei na mũkĩka: nũndũ Yeova Ngai waitũ nde na ũthũku, kana wendeesyo wa andũ, kana kwosa mavaki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        },
