          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ku Yelusaleme Yeosavati aia Alivai na athembi, na atongoi ma nyũmba sya aaĩthe ma Isilaeli, kwondũ wa wĩa wa Yeova wa ũsili, na kwondũ wa ngananĩo. Na masyoka Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
