                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.5",
            "verseOrgIds": [
              "2CH.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na amea asili, Sũanĩai ũndũ mũkwĩka: nũndũ mũtiũsila kwondũ wa mũndũ, ĩndĩ kwondũ wa Yeova; nake e vamwe nenyu kũsilanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.6",
            "verseOrgIds": [
              "2CH.19.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
