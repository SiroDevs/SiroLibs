            "verseId": "2CH.32.7",
            "verseOrgIds": [
              "2CH.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwake ve kw’oko kwa mwĩĩ; ĩndĩ kwĩtũ ve Yeova Ngai waitũ wa ũtũtethya, na kũtũkitĩthasya makaũ. Na andũ nĩmeethũmũisye ndetonĩ sya Esekia mũsumbĩ wa Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.8",
            "verseOrgIds": [
              "2CH.32.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
