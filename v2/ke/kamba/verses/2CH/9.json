        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
