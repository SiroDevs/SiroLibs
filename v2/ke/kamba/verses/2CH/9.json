            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ atw’ĩkĩthya vetha weethĩwa ta mavia ku Yelusaleme, na mĩkũũ yeethĩwa ta mĩkũyũ ĩla yĩ nthĩ ndindimalu kwondũ wa kwingĩva. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
