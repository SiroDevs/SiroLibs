              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
