              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa ũu w’onthe Yeova amũkũna maanĩ na ũwau ũtavoeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
