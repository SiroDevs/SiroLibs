          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aamũkya veva wa Avilisiti, na wa Alavu ala me ũtee wa Aethiovia mokite na Yeolamu: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
