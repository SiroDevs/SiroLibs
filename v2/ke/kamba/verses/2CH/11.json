        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.15",
            "verseOrgIds": [
              "2CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina woo, kuma mbaĩnĩ syonthe sya Isilaeli, ala malũlũmĩlye ngoo syoo mamanthe Yeova, Ngai wa Isilaeli, mooka Yelusaleme mamũthembee Yeova, Ngai wa aaĩthe moo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
            "verseOrgIds": [
              "2CH.11.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
