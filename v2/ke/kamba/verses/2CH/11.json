              },
              "items": [
                {
                  "text": "2 Mav 15.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
            "verseOrgIds": [
              "2CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o meekĩie ũsumbĩ wa Yuta vinya, na mamwongeleela Leovoamu mwana wa Solomoni vinya, myaka ĩtatũ; nũndũ nĩmaendeee myaka ĩtatũ mũendelenĩ wa Ndaviti na Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
