            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ matyaatonya kũlilikana ĩvinda yĩu, nĩkwĩthĩwa ũtalo wa athembi ala meevathanĩtye methĩwe atheu ndwaĩ mwĩanĩu, o na andũ matyaĩ manamba kũmbana Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
