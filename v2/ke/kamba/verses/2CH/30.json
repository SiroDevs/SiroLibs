              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maũngama vandũ voo maatĩanĩe, kwĩanana na mwĩao wa Mose mũndũ wa Ngai: athembi maminzangĩsya nthakame ĩla moosie kuma mokonĩ ma Alivai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.16",
            "verseOrgIds": [
              "2CH.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwaĩ aingĩ ũmbanonĩ ala mataaĩvathan’ya methĩwe atheu: kwondũ wa ũu Alivai maĩ na wĩaĩo wa kũaa mavasaka kwondũ wa kĩla ũmwe ũtetheetye, mamavathan’ye methĩwe atheu kwa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.55"
              },
              "items": [
                {
                  "text": "Yoa 11.55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ wingĩ wa andũ, o aingĩ ma Evalaimu na Manase, na Isakali na Nzevuluni, matyeetheetye, ĩndĩ maya vasaka ũndũ kũtaandĩkĩtwe. Nũndũ Esekia aĩ anamavoyea, akyasya, Yeova mũseo naekee kĩla ũmwe ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla wĩlũmya ngoo yake amanthe Ngai, Yeova, Ngai wa aaĩthe make, o na ethĩwa ndetheetye kwĩanana na ũthesyo wa vala vandũ vatheu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.19",
            "verseOrgIds": [
              "2CH.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩthukĩĩsya Esekia, na avosya andũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli ala maĩ Yelusaleme malĩlĩkana mboka ya kĩmũtũ kĩte ĩlawa mĩthenya mũonza me na ũtanu mwingĩ; na Alivai na athembi mamũtaĩa Yeova mũthenya na mũthenya, makĩmwinĩa Yeova na syĩndũ sya kũinga syĩ wasya mũnene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
