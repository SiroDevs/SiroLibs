            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ athembi Alivai maũngamie na maathima andũ: na wasya woo weew’ĩka, na kũvoya kwoo kwambata kũvika ũtũonĩ wake mũtheu, o kũvika ĩtunĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.27",
            "verseOrgIds": [
              "2CH.30.27"
            ]
          }
        },
