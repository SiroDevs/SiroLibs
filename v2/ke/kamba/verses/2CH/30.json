                {
                  "text": "1 Asu 8.65",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.23",
            "verseOrgIds": [
              "2CH.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Esekia mũsumbĩ wa Yuta anenga ũmbano tũsalũ twa mũew’a ngili na malondu ngili mũonza syĩthĩwe nthembo; na anene me mbee ũsumbĩnĩ manenga ũmbano tũsalũ twa mũew’a ngili na malondu ngili ĩkũmi: na athembi aingĩ meevathan’ya methĩwe atheu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.34"
              },
              "items": [
                {
                  "text": "2 Mav 29.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũmbano w’onthe wa Yuta, vamwe na athembi na Alivai, na ũmbano w’onthe ũla waumie nthĩnĩ wa Isilaeli, na ekali ma ũeninĩ ala maumie nthĩ ya Isilaeli, na ala matwĩe Yuta, matana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu kwaĩ ũtanu mwingĩ Yelusaleme; nũndũ kuma ĩvinda ya Solomoni mwana wa Ndaviti mũsumbĩ wa Isilaeli kũtyaaĩthĩwa ũndũ ta ũsu Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
