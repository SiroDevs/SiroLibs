                "loc": "EXO.12.15"
              },
              "items": [
                {
                  "text": "Kuma 12.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.6"
              },
              "items": [
                {
                  "text": "13.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.22"
              },
              "items": [
                {
                  "text": "Esa 6.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Esekia aneena aimakiakiasya Alivai onthe ala maĩ na ũmanyi mũseo ũthũkũminĩ wa Yeova. Na ĩndĩ maya mboka mĩthenya ĩsu mũonza, makĩthemba nthembo sya nthembo sya mũuo, na makyumbũlĩla Yeova, Ngai wa aaĩthe moo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        },
