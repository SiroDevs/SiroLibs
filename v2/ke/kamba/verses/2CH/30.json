          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mooaa vasaka mũthenya wa ĩkũmi na ĩna wa mwei wa kelĩ: na athembi na Alivai masonoka, na meevathan’ya methĩwe atheu, na maete nthembo sya kũvĩvw’a nyũmbanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
