        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ mũka akekale nthakamenĩ ya kwĩthesya kwake mĩthenya mĩongo ĩtatũ na ĩtatũ; ndakakiite kĩndũ kĩvathe, kana kũlika vala vandũ vatheu, kũvika mĩthenya ya kwĩthesya kwake yĩanĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa akasyaa kelĩtu, nĩvo ĩndĩ wĩĩthĩwa mũvuku syumwa ilĩ, ta ĩvinda ya kũvathwa kwake, na akekala nthakamenĩ ya kwĩthesya kwake mĩthenya mĩongo thanthatũ na thanthatũ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
