              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mĩthenya yake ya kwĩthesya kwake yeanĩa, ũndũ wa kavĩsĩ, kana ũndũ wa kelĩtu, akamũetee mũthembi, mũomonĩ wa ĩeema ya kũmbanĩa, katena ka ĩlondu ka mwaka ũmwe kethĩwe nthembo ya kũvĩvw’a, na ĩswii ya ĩvũĩ, kana ndumbũ, yĩthĩwe nthembo ya naĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
