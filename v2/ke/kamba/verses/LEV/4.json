          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akailĩĩle kw’oko mũtwenĩ wa nthembo ya naĩ, na kũkoaĩa vala moaĩaa nthembo ya kũvĩvw’a kethĩwe nthembo ya naĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
            "verseOrgIds": [
              "LEV.4.33"
            ]
          }
        },
        {
