              },
              "items": [
                {
                  "text": "Mot 19.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.5",
            "verseOrgIds": [
              "LEV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũthembi akatolye kyaa kyake nthakamenĩ, na kũminzangĩsya nthakame maminzangĩsya mũonza mbee wa Yeova, mbee wa tũtũ wa vala vandũ vatheu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthembi akavake nthakame mbyanĩ sya kĩthembeo kya kũtoeesya ũvani wĩ mũuke mũseo mbee wa Yeova, kĩla kĩ ĩeemanĩ ya kũmbanĩa; na nthakame yonthe ya kala kasalũ akatulũĩle ĩtinanĩ ya kĩthembeo kya nthembo ya kũvĩvw’a, kĩla kĩ mũomonĩ wa ĩeema ya kũmbanĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
