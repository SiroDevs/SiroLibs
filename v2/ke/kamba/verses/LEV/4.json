          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "o kasalũ kau konthe akatwae ũtee wa mwako wa maeema vandũ vatheu, vala mũu wĩtawa, na kũkavĩvĩsya ĩũlũ wa ngũ na mwaki: vala mũu wĩtawa nĩvo kevĩvĩw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        },
