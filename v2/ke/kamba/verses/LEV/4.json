              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa akaete katena ka ĩlondu kethĩwe nthembo yake ya naĩ, naete kamwatĩ kate kĩema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.32",
            "verseOrgIds": [
              "LEV.4.32"
            ]
