          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atumĩa ma ũmbano makailĩĩle moko mũtwenĩ wa kasalũ kau mbee wa Yeova; na kasalũ kakoaĩwe mbee wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
