              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũndũ, o mũndũ, akeeka naĩ atesĩ, akĩka ũndũ o na wĩva wa maũndũ asu ala Yeova weaie matikekwe, na nĩwatw’ĩka mũvĩtan’ya; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
