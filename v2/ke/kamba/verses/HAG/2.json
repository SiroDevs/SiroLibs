          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngathingithya mbaĩ syonthe; na ũla wendetwe nĩ mbaĩ syonthe ũkooka; na ngausũsya nyũmba ĩno ũtheu mũtisu, easya ũu Yeova wa nguthu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.7",
            "verseOrgIds": [
              "HAG.2.7"
            ]
          }
        },
        {
