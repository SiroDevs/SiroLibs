              "HAG.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Akai wasũngĩie na asya, Andũ aa mailyĩ ũu, na mbaĩ ĩno ĩilyĩ ũu mbee wakwa, easya ũu Yeova; na no ta ũu kĩla wĩa wa moko moo; na o kĩla mathembaa vo no kĩvuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.64.6"
              },
              "items": [
                {
                  "text": "Isa 64.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu, nĩngũmwĩsũva, sũanĩai mũthenya ũũ, na sũanĩai mĩthenya ĩla mĩthelu, mbee wa ĩvia yĩtanailĩĩlwa ĩũlũ wa ĩvia mwakonĩ wa ĩkalũ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.15",
            "verseOrgIds": [
              "HAG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuma ĩvinda yĩu yonthe, yĩla ũmwe waenda mbumbunĩ yĩ ithimo mĩongo ĩlĩ, veethĩwa o ĩkũmi; yĩla ũmwe waenda ĩvivanĩ ya mbinyu kwosa itethi mĩongo ĩtano, veethĩwa o mĩongo ĩlĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.16",
            "verseOrgIds": [
              "HAG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnamũkũnie na wũmanĩlu na mbuka na mbua ya mavia wĩanĩ w’onthe wa moko menyu; ĩndĩ mũtyaaĩnthyũũĩa, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.17",
            "verseOrgIds": [
              "HAG.2.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
