          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vetha nĩ wakwa, na thaavu nĩ wakwa, easya ũu Yeova wa nguthu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
