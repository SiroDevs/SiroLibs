            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.3",
            "verseOrgIds": [
              "HAG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu ĩthĩwa na vinya, we Nzeluvaveli, easya ũu Yeova; na ĩthĩwa na vinya, we Yosua, mwana wa Yeosataki, mũthembi mũnene; na ĩthĩwai na vinya, inyw’ĩ andũ onthe ma nthĩ ĩno, na tethyai wĩa, easya ũu Yeova: nũndũ nĩ vamwe nenyu, easya ũu Yeova wa nguthu, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "o kwĩanana na ndeto ĩla natianĩie nenyu yĩla mwaumie Misili, na Veva wakwa ekalaa katĩ wenyu; mũikakĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.5",
            "verseOrgIds": [
              "HAG.2.5"
            ]
          }
        },
