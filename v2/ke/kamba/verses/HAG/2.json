          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũu nĩw’o Yeova wa nguthu ũnũkwasya: No ĩmwe, o kavinda kanini, na ngathingithya matu, na nthĩ, na ũkanga, na nthĩ nyũmũ; ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
