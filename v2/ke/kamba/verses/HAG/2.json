          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtheu wa ĩtina wa nyũmba ĩno ũkeethĩwa wĩ mũnene kwĩ ũla wa mbee, easya ũu Yeova wa nguthu; na nganenganĩa mũuo vandũ vaa, easya ũu Yeova wa nguthu.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        }
      ]
