          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.16",
            "verseOrgIds": [
              "NEH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũndũ ũngĩ mĩthenyanĩ ĩsu anene me ndaĩa ma Yuta mamũtwaĩa Tovia mavalũa maingĩ, na mavalũa ma Tovia mamavikĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.17",
            "verseOrgIds": [
              "NEH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwaĩ aingĩ Yuta ala mamwĩavĩthĩsye, nĩkwĩthĩwa aĩ mũthoni wa Sekania mwana wa Alaa; na mwana wake Yeoanani aĩ anatwaa mwĩĩtu wa Mesulamu mwana wa Mbelekia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.18",
            "verseOrgIds": [
              "NEH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na maweta meko make maseo vala nĩĩ, na mamũtũngĩa ndeto syakwa. Na Tovia andetee mavalũa ma kũmbĩkĩa w’ĩa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.19",
            "verseOrgIds": [
              "NEH.6.19"
            ]
          }
        }
      ]
