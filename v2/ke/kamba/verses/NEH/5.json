              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ kwookĩlile kĩĩo kĩnene kya andũ na kya iveti syoo ĩũlũ wa ana‐a‐ĩthe moo Ayuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.1",
            "verseOrgIds": [
              "NEH.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
