          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla neewie kũĩa kwoo na ndeto isu nĩnathatie mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ nasũanĩa thayũnĩ wakwa, na nakananĩa na anene me nguma na asumbĩki, na namea, Nĩmũmaumĩthya ũtandĩthyo mbesanĩ kĩla ũmwe kwa mwana‐a‐ĩthe wake. Na namombanĩsya ũmbano mũnene. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
