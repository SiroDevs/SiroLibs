        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ nasya, Ũndũ ũũ mũkwĩka ti ũseo: mũtyaĩle kũendaa mũkĩmũkĩa Ngai waitũ, nĩ kana i mbaĩ amaitha maitũ itikethĩwe na kĩvũthya? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
