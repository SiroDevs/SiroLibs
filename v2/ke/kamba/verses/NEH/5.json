            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwaĩ amwe ala maisye, Ithyĩ, na ana maitũ, na eĩtu maitũ, nĩ aingĩ: twosei lĩu wa mbaa ngetha, nĩ kana tũye na kwĩkala thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na kwaĩ amwe ala maisye, Nĩtumĩtye mĩũnda yaitũ, na mĩũnda yaitũ ya mĩsavivũ, na nyũmba sitũ, syĩthĩwe ngwatĩlĩlyo: twosei lĩu wa mbaa ngetha nũndũ wa yũa yĩĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na kwaĩ angĩ ala maisye, Nĩtũkovete mbesa ũndũ wa koti wa mũsumbĩ, na nĩtwiĩte mĩũnda yaitũ na mĩũnda yaitũ ya mĩsavivũ yĩthĩwe ngwatĩlĩlyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.4.13"
              },
              "items": [
                {
                  "text": "Esa 4.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu mĩĩ yaitũ no ta mĩĩ ya ana‐a‐ĩthe maitũ, na syana sitũ nĩ ta syana syoo: na, kaĩ, nĩtũkũete ũkombonĩ ana maitũ na eĩtu maitũ methĩwe athũkũmi, na eĩtu maitũ amwe me ũkombonĩ o na yu: o na tũti na vinya wa kũsiĩĩa ũndũ ũsu; nũndũ andũ angĩ me na mĩũnda yaitũ na mĩũnda yaitũ ya mĩsavivũ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
