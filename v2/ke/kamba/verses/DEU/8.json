          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sũvĩa ndũkese kũlwa nĩ Yeova Ngai waku, kwondũ wa kũlea kũkwata mĩao yake, na motw’ĩo make, na myamũlo yake, ĩla ngũkwĩaĩa ũmũnthĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũikethĩwe, waya na kũvũna, na waaka nyũmba nzeo, na kwĩkala vo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
