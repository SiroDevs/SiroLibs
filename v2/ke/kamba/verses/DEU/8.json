          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku ũkamanya ngoonĩ yaku, kana, o ũndũ mũndũ ũkũnaa mwana wake, now’o Yeova Ngai waku ũkũkũnaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
