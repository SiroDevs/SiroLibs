          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndĩthya syaku sya ng’ombe na sya mbũi na malondu syaingĩva, na vetha waku na thaavu waku waingĩva, na syonthe ila wĩ nasyo syaingĩva; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoo yaku ĩndĩ ĩketũlya, naku ũkyũlwa nĩ Yeova Ngai waku, ũla wakumisye nthĩ ya Misili, ũkumya nyũmbanĩ ya ũkombo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
