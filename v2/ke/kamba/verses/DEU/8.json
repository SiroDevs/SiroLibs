          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngũa syaku ila weekĩe ityaakũa, o na kũũ kwaku kũtyaaimba, myaka ĩno mĩongo ĩna. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
