          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na twamwĩkaĩla Yeova, Ngai wa aaĩthe maitũ, na Yeova eethukĩĩsya wasya witũ, na oona thĩna witũ, na wĩa witũ wĩ vinya, na ũnyamao witũ; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
