          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nũtũetete vaa, na nũtũnengete nthĩ ĩno, nthĩ yusũĩte ĩia na ũkĩ wa nzũkĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
