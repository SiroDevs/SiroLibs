        {
          "text": "na Yeova atumya Misili na kw’oko kwĩ vinya, na kw’oko kũtambũũku, na ũtĩsyo mũnene, na syama, na moseng’yo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
