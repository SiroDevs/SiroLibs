              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Amisili matwĩka naĩ, na matũthĩn’ya, na matũthũkũmĩthya na ũkombo wĩ vinya: ",
          "type": "text",
          "attrs": {
