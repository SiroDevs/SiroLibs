              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilikana ũndũ Yeova Ngai waku wamwĩkie Miliamu, mwĩ nzĩanĩ mumĩte Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        },
