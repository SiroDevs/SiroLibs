          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mũndũ akooneka akyũya mwana‐a‐ĩthe o na wĩva wa ana ma Isilaeli, na aimwĩka ta ngombo, kana kũmũthoosya; mũvaka kĩng’ei kyu kyũawe: ũu nĩw’o wĩvetaa ũthũku ũsu wume katĩ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
