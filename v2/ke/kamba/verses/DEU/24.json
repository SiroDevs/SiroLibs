                "loc": "MAT.5.31"
              },
              "items": [
                {
                  "text": "Mt 5.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.7"
              },
              "items": [
                {
                  "text": "19.7",
