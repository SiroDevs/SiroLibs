              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na auma nyũmbanĩ yake, nũtonya kũenda na kũtw’ĩka mũka wa mũndũ ũngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũũme wa ĩtina nũnũũmũmena, na kũmũandĩkĩa valũa wa kũtaanĩsya, na kũmũnenga kw’okonĩ kwake, na aimũlũngya nyũmbanĩ yake; kana ethĩwa mũũme wa ĩtina, ũla wamũtwaie ethĩwe mũka wake nĩwakw’a; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũũme wake wa mbee, ũla wamũlũngilye, ndatonya kũmũtwaa ĩngĩ ethĩwe mũka wake, ĩtina wa kũvukwa kwake; nũndũ ũu nĩ ũthatyo mbee wa Yeova: na ndũkavĩtĩthye nthĩ, ĩla Yeova Ngai waku ũkũnengae yĩthĩwe ũtiĩwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
