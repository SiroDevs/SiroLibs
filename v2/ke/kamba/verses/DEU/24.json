            "number": "1",
            "style": "v",
            "sid": "DEU 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ oosa mũndũ mũka, na aimũtwaa, kũkeethĩwa, ethĩwa mũndũ mũka ndeona ũseo methonĩ make, nĩkwĩthĩwa mũũme nĩwonete ũndũ ũtaĩle kwake, akamũandĩkĩe valũa wa kũtaanĩsya, na kũmũnenga kw’okonĩ kwake, na aimũlũngya nyũmbanĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
