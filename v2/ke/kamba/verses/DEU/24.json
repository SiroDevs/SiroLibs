            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ndakaose ĩvia ya ũthia kana nthio yayo yĩthĩwe ngwatĩlĩlyo; nũndũ ũu nĩ ta kwosa thayũ wa mũndũ wĩthĩwe ngwatĩlĩlyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
      ]
    },
