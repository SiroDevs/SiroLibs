              "DEU.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩseũvĩsye nzĩa, na atũan’ya mĩvaka ya nthĩ yaku, ĩla Yeova Ngai waku wĩtuma ũmĩtiĩwa, yĩthĩwe ilungu itatũ, nĩ kana kĩla mũndũ ũkoaa ũngĩ akĩĩe vo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũũ nĩw’o ũvoo wa ũla ũkoaa ũngĩ, ũla ũkakĩĩa vo na kwĩkala thayũ: o ũla ũkoaa mũtũi wake na mbanga, na ndatwĩe e ũthũ nake; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.4",
            "verseOrgIds": [
              "DEU.19.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.42"
              },
              "items": [
                {
                  "text": "Kũt 4.42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.4",
            "verseOrgIds": [
              "DEU.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ta yĩla mũndũ ũendaa mũtitũnĩ e na mũtũi wake kũtema mĩtĩ, na kw’oko kwake kũkyũkĩlya ĩthoka ateme mũtĩ, na ĩthoka yĩisingĩla, na kũkũna mũtũi wake, na aikw’a; nake akakĩĩa ndũa ĩmwe ya isu na kwĩkala thayũ: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.5",
            "verseOrgIds": [
              "DEU.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũĩvanĩsya wa nthakame ndakese kũmũatĩĩa mũaani, yĩla wĩ na ũthatu ngoonĩ, na kũmũkwata, nũndũ nzĩa nĩ ndasa, na kũmũkũna akw’e; nake ndaĩlwe nĩ kũkw’a, nũndũ ndatwĩe e ũthũ nake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.6",
            "verseOrgIds": [
              "DEU.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nĩngũkwĩaĩa, ngyasya, Ĩvathĩe ndũa itatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.7",
            "verseOrgIds": [
              "DEU.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa Yeova Ngai waku akongela mũvaka waku, o tondũ wameavĩe aaĩthe maku, na ũkũnenga nthĩ yonthe ĩla wathie akamanenga aaĩthe maku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
