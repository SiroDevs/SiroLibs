          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla Yeova Ngai waku ũkaveta mbaĩ, ila Yeova Ngai waku ũkũnengae nthĩ yasyo, naku woosa nthĩ yasyo, na kũtũa ndũanĩ syasyo, na nyũmba syasyo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩvathĩe ndũa itatũ nthĩnĩ wa nthĩ yaku, ĩla Yeova Ngai waku ũkũnengae ũmĩmesye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
