          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũkimange na mavia akw’e, nĩkwĩthĩwa nũtatĩte ũkũkusya ũtaanĩsye na Yeova Ngai waku, ũla wakumisye nthĩ ya Misili, ũkumya nyũmbanĩ ya ũkombo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isilaeli onthe makeew’a, na kũkĩa, na maikeka ĩngĩ ũthũku wĩana ũu kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
