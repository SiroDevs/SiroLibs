            "sid": "DEU 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũatĩĩei Yeova Ngai wenyu, na mũkĩei we, na kũkwata mĩao yake, na kwĩw’a wasya wake, na mũthũkũmei, na kũlũman’ya nake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.4",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
