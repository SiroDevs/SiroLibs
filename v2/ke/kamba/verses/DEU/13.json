        },
        {
          "text": "no mũvaka ũkũne andũ ma ndũa ĩsu kwa kũmatemanga na ũvyũ, ũkĩmyananga vyũ, na syĩndũ syonthe ila syĩ nthĩnĩ wayo na indo ila syĩ vo, kũtemanga na ũvyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.15",
            "verseOrgIds": [
              "DEU.13.15"
            ]
          }
        },
        {
          "name": "verse",
