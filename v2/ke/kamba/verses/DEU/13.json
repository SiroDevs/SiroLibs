            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mwana‐a‐mwenyu, kana mwana waku, kana mwĩĩtu waku, kana kĩveti kya kĩthũinĩ kyaku, kana mũnyanyau, ũla ũilyĩ thayũ waku mwene, akakũsengasenga kĩmbithĩ, aikwĩa, Tũthi tũthũkũme ngai ingĩ, ila ũtaamanya, we, kana aaĩthe maku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.6",
            "verseOrgIds": [
              "DEU.13.6"
            ]
