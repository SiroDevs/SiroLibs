              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa ũkeew’a ndũanĩ ĩmwe yaku, ĩla Yeova Ngai waku ũkũnengae ũtũe vo, ũmwe akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ ang’endu nĩmaumĩte kwaku, na nĩmakusĩtye andũ ma ndũa yoo, makyasya Tũthi tũthũkũme ngai ingĩ, ila mũtaamanya; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.13",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ wĩkũlya, na kũmantha, na kũlya na kĩthing’ĩĩsyo; na, sisya, ethĩwa nĩ wa w’o, na nĩ w’o ki, kana ũthũku ũilyĩ ũu nĩwĩkĩtwe kwaku, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.14",
            "verseOrgIds": [
              "DEU.13.14"
            ]
          }
        },
