              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova Ngai waku akeekĩa iumo ii syonthe ĩũlũ wa amaitha maku, na ĩũlũ wa ala meũkũmena, ala makũthĩnisye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku ũkasyoka na kwĩw’a wasya wa Yeova, na kwĩka mĩao yake yonthe ĩla ngũkwĩaĩa ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova Ngai waku akakwongeleela wĩanĩ w’onthe wa moko maku, na ũsyaonĩ wa mwĩĩ waku, na ũsyaonĩ wa indo syaku, na ũsyaonĩ wa nthĩ yaku, kwondũ wa ũseo: nũndũ Yeova akakũtanĩa ĩngĩ kwondũ wa ũseo, o tondũ wamatanĩaa aaĩthe maku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.11"
              },
              "items": [
                {
                  "text": "Kũt 28.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.63"
              },
              "items": [
                {
                  "text": "63",
                  "type": "text"
