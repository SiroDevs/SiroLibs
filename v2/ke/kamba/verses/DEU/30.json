        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethĩwa ũkethukĩĩasya wasya wa Yeova Ngai waku, kũkwataa mĩao yake na myamũlo yake ĩla ĩandĩkĩtwe ĩvukunĩ yĩĩ ya mĩao; ethĩwa wĩmũsyokea Yeova Ngai waku na ngoo yaku yonthe, na thayũ waku w’onthe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
