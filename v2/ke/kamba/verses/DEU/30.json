              },
              "items": [
                {
                  "text": "Alo 10.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
