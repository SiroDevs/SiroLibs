              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ndwĩ mũingo wa ũkanga, ũndũ ũneena, Nũũ ũla ũkainga ũkanga kwondũ witũ, na kũwosa na kũtũetee, na kũtwĩw’ĩthya, nĩ kana twĩke? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ĩ ndeto yĩ vakuvĩ mũno naku, kanyw’anĩ waku, na ngoonĩ yaku, nĩ kana ũmĩke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
