          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mwĩao ũũ ũla ngũkwĩaĩa ũmũnthĩ, ti mũito mũno kwaku, o na ndwĩ kũasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
            "verseOrgIds": [
              "DEU.30.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
