                {
                  "text": "Isa 45.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
            "verseOrgIds": [
              "DEU.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndwĩ ĩtunĩ, ũndũ ũneena, Nũũ ũla ũkambata ĩtunĩ kwondũ witũ, na kũwosa na kũtũetee, na kũtwĩw’ĩthya, nĩ kana twĩke? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
