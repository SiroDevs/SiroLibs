              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, nĩnĩĩte mbee waku ũmũnthĩ thayũ na ũseo, na kĩkw’ũ na ũthũku; ",
          "type": "text",
          "attrs": {
