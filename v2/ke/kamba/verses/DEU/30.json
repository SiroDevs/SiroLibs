              "type": "tag",
              "attrs": {
                "loc": "NEH.1.9"
              },
              "items": [
                {
                  "text": "Nee 1.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ Yeova Ngai waku ũkakũtũnga wume kũtavwanĩ kwaku, na ũkwĩw’ĩa tei, na akasyoka na ũkũmban’ya kuma ngonĩ syonthe sya andũ, kũla Yeova Ngai waku wakũnyaĩĩkĩsye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
