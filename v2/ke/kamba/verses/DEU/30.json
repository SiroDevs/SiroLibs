                "loc": "DEU.28.64"
              },
              "items": [
                {
                  "text": "Kũt 28.64",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.126.1"
              },
              "items": [
                {
                  "text": "Sav 126.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
