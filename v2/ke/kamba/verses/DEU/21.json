        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo kũkeethĩwa, mũthenya ũla ũkatuma ana make matĩĩwa kĩla wĩ nakyo, ndatonya kũmũtw’a mwana wa mũndũ mũka ũla wendetwe ĩkithathi yĩla mwana wa ũla ũmenetwe wĩ thayũ, nake nĩwe ĩkithathi: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
