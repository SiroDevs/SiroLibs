                "loc": "DEU.10.8"
              },
              "items": [
                {
                  "text": "Kũt 10.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.8"
              },
              "items": [
                {
                  "text": "17.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atumĩa onthe ma ndũa ĩsu, ala me vakuvĩ na mũndũ ũla woaiwe, mathambĩsye moko moo ĩũlũ wa moi ĩla ngingo yayo yatũlĩlwa mwandanĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.6",
            "verseOrgIds": [
              "DEU.21.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
