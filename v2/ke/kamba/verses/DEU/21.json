                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ nĩetĩkĩle yĩla ĩkithathi, mwana wa ũla ũmenetwe, aiyĩnenga kũndũ kwĩlĩ syĩndũnĩ syonthe ila wĩ nasyo; nũndũ nĩwe wambĩlĩlyo wa vinya wake; ũtiĩwa wa ũkithathi nĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
