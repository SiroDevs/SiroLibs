          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mũndũ e na aka elĩ, ũmwe mwende, na ũla ũngĩ mũmene, na makĩmũsyaĩa syana, ũla wendetwe na ũla ũmenetwe me elĩ; na ethĩwa ĩkithathi nĩ ya ũla ũmenetwe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
