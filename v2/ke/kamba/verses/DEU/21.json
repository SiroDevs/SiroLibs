              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũndũ ekĩte naĩ yaĩle kĩkw’ũ, na ooawa, na ũimũsũsya mũtĩnĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.22",
