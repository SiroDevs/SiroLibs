        },
        {
          "text": "Ethĩwa kwaku kũkeethĩwa mũndũ ngya, ũmwe wa ana‐a‐au, kwaku nthĩ yaku ĩla Yeova Ngai waku ũkũnengae, ndũkomye ngoo yaku, o na ndũkamũkumbatĩlĩlye kw’oko kwaku mwana‐a‐au e ngya; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
