              "attrs": {
                "loc": "DEU.28.8"
              },
              "items": [
                {
                  "text": "28.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
