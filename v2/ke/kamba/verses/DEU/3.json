          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ame Mwĩaĩi Yeova, nĩwambĩlĩlye kwon’ya mũthũkũmi waku, ũnene waku na kw’oko kwaku kwĩ vinya: nũndũ nĩ ngai yĩva ĩtunĩ kana kũũ nthĩ, ĩtonya kwĩka kwĩanana na mawĩa maku, na kwĩanana na meko maku me vinya? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
