          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndũa syonthe sya ũiĩnĩ, na Ngileati yonthe, na Mbasani yonthe, kũvika Saleka na Etilei, ndũa sya ũsumbĩ wa Oku nthĩ ya Mbasani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.10",
            "verseOrgIds": [
              "DEU.3.10"
            ]
          }
        },
