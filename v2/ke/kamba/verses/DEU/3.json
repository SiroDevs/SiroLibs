              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikamakĩe; nũndũ Yeova Ngai waku, nĩwe ũmũkitĩaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
