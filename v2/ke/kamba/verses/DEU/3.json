          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nũndũ no Oku weka mũsumbĩ wa Mbasani watialilw’e wa ũtialo wa Alevai; sisya, ũkomo wake waĩ ũkomo wa kĩaa; ndwĩ vo ndũanĩ ya Lava ya ana ma Amimoni? Ũasa waw’o waĩ mĩkono kenda, na ũthanthau waw’o waĩ mĩkono ĩna, o ũndũ mũkono wa mũndũ ũilyĩ.) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.11",
            "verseOrgIds": [
              "DEU.3.11"
            ]
          }
        },
