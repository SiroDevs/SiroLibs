          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩkwĩthĩwa nĩmwambĩtanĩsye katĩ wa ana ma Isilaeli manzĩnĩ ma Meliva nthĩ ya Katesi, weũnĩ wa Nzini; nĩkwĩthĩwa mũtyaonan’ya kana nyie nĩ mũtheu katĩ wa ana ma Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
