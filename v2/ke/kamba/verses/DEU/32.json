          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Mose mũthenya o ũsu, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambata kĩĩmanĩ kĩĩ kya Avalimu, kũvika kĩĩma kya Nevo, kĩla kĩ nthĩ ya Moavi, kĩla kyelekele Yeliko; na ĩloele nthĩ ya Kanaani, ĩla nĩmanengae ana ma Isilaeli yĩthĩwe ng’ũndũ yoo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
