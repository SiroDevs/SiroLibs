          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthukĩĩsyei, inyw’ĩ matu, na nĩngũneena;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.1",
            "verseOrgIds": [
              "DEU.32.1"
            ]
          }
        }
      ]
    },
    {
