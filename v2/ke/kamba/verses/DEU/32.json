          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũkoona ĩ nthĩ mbee waku; ĩndĩ ndũkalika nthĩ ĩsu ĩla nĩmanengae ana ma Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
