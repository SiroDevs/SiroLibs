              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩsyũlĩlye manyenze motiivonĩ ana ma ngũa yaku ya kwĩvw’ĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        },
        {
