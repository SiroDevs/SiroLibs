          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩkwĩthĩwa amwĩthĩie mũũndanĩ, na mwĩĩtu ũsu ũla wĩvaĩtwe akaya, na vatyĩĩ mũndũ wa ũmũtaan’ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
