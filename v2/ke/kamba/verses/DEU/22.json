              "DEU.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaka nyũmba nzaũ, nĩvo ĩndĩ akĩĩa wiio ũengonĩ wa kĩala kyayo, nĩ kana ndũkaete nthakame ĩũlũ wa nyũmba yaku, ethĩwa mũndũ akavalũka kuma vo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkaavande mũũnda waku wa mĩsavivũ mbeũ sya mĩthemba ĩlĩ, ũsyao w’onthe ndũkese kwanangana, mbeũ ila wavandie, na ũsyao wa mũũnda wa mĩsavivũ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.19"
              },
              "items": [
                {
                  "text": "Ali 19.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkaaĩme na ng’ombe na ĩng’oi vamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.10",
            "verseOrgIds": [
              "DEU.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkaekĩe ngũa ĩvulanĩtye ndii sya mĩthemba ĩlĩ, ya w’ĩa wa ĩlondu na ya katane vamwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        }
      ]
    },
    {
