          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa ndala ya nyũnyi ĩkeethĩwa mbee waku nzĩanĩ, mũtĩnĩ o na wĩva kana nthĩ, yĩ na tũswii kana matumbĩ, ndũkakwate inyia vamwe na tũswii: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.6",
            "verseOrgIds": [
              "DEU.22.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.28"
              },
              "items": [
                {
                  "text": "Ali 22.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.6",
            "verseOrgIds": [
              "DEU.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũvaka ũlekye inyia, ĩndĩ tũswii nũtonya kwĩyosea; nĩ kana wĩthĩwe ũseo kwaku, na nĩ kana wingĩvye mĩthenya yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.7",
            "verseOrgIds": [
              "DEU.22.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
