            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkeethĩwa na mboka ya syumwa kwondũ wa Yeova Ngai waku vamwe na ũelo wa nthembo ya kw’oko kwaku ya kumya na kwenda kwa ngoo, ĩla wĩnengane, o kwĩanana na ũndũ Yeova Ngai waku ũkũathimaa: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
