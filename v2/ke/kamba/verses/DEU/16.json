          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na tanĩa mbokanĩ yaku, we, na mwana waku, na mwĩĩtu waku, na mũthũkũmi waku mũndũ mũũme, na mũthũkũmi waku mwĩĩtu, na Mũlivai, na mwĩkali wa ũeninĩ, na ũla wakw’ĩĩwe nĩ ĩthe, na mũndũ mũka ndiwa, ala me kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
