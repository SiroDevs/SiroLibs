        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "naku ũkatane mbee wa Yeova Ngai waku, we, na mwana waku, na mwĩĩtu waku, na mũthũkũmi waku mũndũ mũũme, na mũthũkũmi waku mwĩĩtu, na Mũlivai ũla wĩ kwaku, na mwĩkali wa ũeninĩ, na ũla wakw’ĩĩwe nĩ ĩthe, na mũndũ mũka ndiwa, ala matwĩe kwaku, vandũ vala Yeova Ngai waku wĩnyuva, ekalye syĩtwa yake vo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
