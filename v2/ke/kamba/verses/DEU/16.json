              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sũvĩa mwei wa Avivu, na lilikana vasaka kwondũ wa Yeova Ngai waku; nũndũ Yeova Ngai waku nĩwakumisye nthĩ ya Misili ũtukũ mwei wa Avivu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
