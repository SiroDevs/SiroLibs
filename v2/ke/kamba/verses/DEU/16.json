          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩtalĩle syumwa mũonza: ambĩlĩlya kũtala syumwa mũonza kuma yĩla wĩambĩlĩlya kũketha lĩu ũtũĩtye na kavyũ ke ngoto. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
