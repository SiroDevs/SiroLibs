              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ wĩthũkũma syĩtwanĩ ya Yeova Ngai wake, o tondũ ana‐a‐ĩthe make onthe Alivai mekaa, ala maũngamaa mbee wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makeethĩwa na ilungu sya ũya syĩanene, vamwe na kĩla wosaa kwondũ wa ũthoosya ũtiĩwa wa ĩthe wake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.8",
            "verseOrgIds": [
              "DEU.18.8"
            ]
          }
        },
