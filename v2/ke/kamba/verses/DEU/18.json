                  "text": "Mot 18.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.4",
            "verseOrgIds": [
              "DEU.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Yeova Ngai waku nũmũnyuvĩte kuma mbaĩnĩ syaku syonthe, aũngamae kũthũkũma syĩtwanĩ ya Yeova, we na ana make tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
