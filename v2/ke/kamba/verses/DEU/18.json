            "sid": "DEU 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũla wĩkaa maũndũ asu nũmũthatasya Yeova: na kwondũ wa mothatyo asu Yeova Ngai waku nũmalũngasya maume mbee wake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
