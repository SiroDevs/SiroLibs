          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩwa mwĩanĩu mbee wa Yeova Ngai waku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.13",
            "verseOrgIds": [
              "DEU.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mbaĩ isu, ila wĩlũngya syume kwoo, syĩthukĩĩasya ala maingasya nyũnyi, na ala maaũasya; ĩndĩ we, Yeova Ngai waku ndakũnengete ũthei wa kwĩka ũu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.14",
            "verseOrgIds": [
              "DEU.18.14"
            ]
          }
        }
