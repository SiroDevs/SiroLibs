              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose ambata kuma ndiĩnĩ sya Moavi kũvika kĩĩma kya Nevo, mũtumbĩnĩ wa kĩĩma kya Visika, kĩla kyelekele Yeliko. Na Yeova amwon’ya nthĩ yonthe ya Ngileati, kũvika Ndani, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
