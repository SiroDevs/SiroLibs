          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Mose mũthũkũmi wa Yeova akw’ĩa kũu nthĩ ya Moavi, kwĩanana na ndeto ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.5",
            "verseOrgIds": [
              "DEU.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amũthika mwandanĩ nthĩ ya Moavi kwelekela Mbethi‐veoli: ĩndĩ vai mũndũ waamanya mbũa yake kũvika ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.6",
            "verseOrgIds": [
              "DEU.34.6"
            ]
          }
        },
