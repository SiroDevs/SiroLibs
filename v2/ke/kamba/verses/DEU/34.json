          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli mamũĩĩa Mose ndiĩnĩ sya Moavi mĩthenya mĩongo ĩtatũ; na ĩndĩ mĩthenya ya kũĩa na kũmũmetea Mose yathela. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        },
