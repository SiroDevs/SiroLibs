          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.14"
              },
              "items": [
                {
                  "text": "Mko 11.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩoko mavĩtĩte moona ũla mũkũyũ wũmĩte kuma mĩĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.20",
            "verseOrgIds": [
              "MRK.11.20"
            ]
          }
        },
        {
          "name": "verse",
