        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.18",
            "verseOrgIds": [
              "MRK.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩla mũthenya kwavika wĩoo aumaa ndũanĩ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.19",
            "verseOrgIds": [
              "MRK.11.19"
            ]
          }
        }
      ]
    },
