              "MRK.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ ũwaĩte mangũ athi vala ũĩ, akĩmwĩsũva na kũmũtulĩlya ndu, na kũmwĩa, Ethĩwa nũkwenda, nũtonya kũnthesya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.40",
            "verseOrgIds": [
              "MRK.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ ũndũ wa kũmwĩw’ia ĩnee, atambũũkya kw’oko kwake, amũkiita, na amwĩa, Nĩngwenda; ĩthĩwa mũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.41",
            "verseOrgIds": [
              "MRK.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oyu mangũ mavoa, na athea ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.42",
            "verseOrgIds": [
              "MRK.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.12"
              },
              "items": [
                {
                  "text": "Mko 3.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.36"
              },
              "items": [
                {
                  "text": "7.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwĩaĩa na vinya, na amumaalya oyu, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.43",
            "verseOrgIds": [
              "MRK.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
