                {
                  "text": "1 Ako 15.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina amaumĩlĩla ala ĩkũmi na ũmwe mailyĩ makĩya; na amakan’ya nũndũ wa kũlea kwĩtĩkĩla kwoo na nũndũ wa wũmũ wa ngoo syoo, nũndũ mainametĩkĩla ala mamwonie ĩtina wa kũthayũũka kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.18+MAT.28.19+MAT.28.20"
              },
              "items": [
                {
                  "text": "Mt 28.18–20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amea, Endai inyw’ĩ nthĩ yonthe, mũkaitavye syũmbe syonthe ũvoo mũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
              "MRK.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 16:16"
          },
          "items": [
