                  "text": "Lk 24.13–35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa maũndũ asu amaumĩlĩla andũ elĩ moo, e na mũvw’ano ũngĩ, maendete na nzĩa makĩthi na ku ndee. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao mathi na matavya ala angĩ: o na asu mainametĩkĩla.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.13",
            "verseOrgIds": [
              "MRK.16.13"
            ]
          }
        }
      ]
    },
