            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.11+JHN.20.12+JHN.20.13+JHN.20.14+JHN.20.15+JHN.20.16+JHN.20.17+JHN.20.18"
              },
              "items": [
                {
                  "text": "Yoa 20.11–18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ athayũũka kĩoko tene, mũthenya wa mbee wa kyumwa, amba ũmumĩlĩla Meli Makatalene, ũla waumiw’e nĩwe ndaimoni mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake athi amatavya ala maĩ vamwe nake ũvoo, me na kĩmeto na kĩĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao meew’a kana e thayũ, na nĩwoniwe nĩwe, malea kwĩtĩkĩla.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        }
      ]
    },
