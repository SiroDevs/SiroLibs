                {
                  "text": "Meko 2.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũnũkwĩtĩkĩla na kũvatiswa akatangĩĩwa; ĩndĩ ũla ũtekwĩtĩkĩla akasilĩlwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        },
        {
