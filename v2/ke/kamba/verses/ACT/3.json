                {
                  "text": "Aka 3.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyw’i mwĩ ana ma athani, na ma ũtianĩo ũla Ngai watianĩe na aaĩthe menyu, aimwĩa Avalaamu atĩĩ, Ũsyaonĩ waku mĩvĩa yonthe ya andũ ĩkaathimwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.25",
            "verseOrgIds": [
              "ACT.3.25"
            ]
          }
        },
        {
