                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa maũndũ asu mathela, Vaulo atw’a vevanĩ wake, kũvĩtĩla Masetonia na Akaia, na akĩthi Yelusaleme, aiasya, Ĩtina wa kwĩthĩwa kw’o, mũvaka none Lomi nakw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
          }
        },
        {
