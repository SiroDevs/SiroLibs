              "items": [
                {
                  "text": "1 Ako 9.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Vaulo oosana na ala andũ, na mũthenya ũla waatĩĩe ũsu eethesya mwene vamwe namo, avota ĩkalũnĩ, aitavan’ya kana mĩthenya ya ũthesyo nĩ mĩanĩu, mũvaka nthembo yathembwa kwondũ wa kĩla ũmwe wamo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        }
      ]
