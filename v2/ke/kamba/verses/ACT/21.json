                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũndũ wa Andũ‐ma‐mbaĩ‐ingĩ ala metĩkĩlĩte, nĩtwaandĩkie na twamatavya, kana mevathane na syĩndũ ila syũaĩwe mĩvw’anano, na maikanyw’e nthakame, o na kĩndũ kitĩtwe, na kwĩvathana na ũlaalai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.25",
            "verseOrgIds": [
              "ACT.21.25"
            ]
          }
        },
        {
