            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩla mĩthenya mũonza ĩkilĩlye ũthela, Ayuti ala maumie Asia, moona Vaulo ĩkalũnĩ, maingĩanĩsya ĩkomano yonthe na mamũkwata, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.27",
            "verseOrgIds": [
              "ACT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.13"
              },
              "items": [
                {
                  "text": "Meko 6.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.7"
              },
              "items": [
                {
                  "text": "Esek 44.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "makyũkĩlya mawasya, makyasya, Aũme ma Isilaeli, tũtethyei: Mũndũ nĩwe ũũ ũla ũmanyĩasya andũ onthe kũndũ kw’onthe, aineenea andũ naĩ, na ĩla mĩao, o na vandũ vaa; na mbee wa ũu nĩwaetie Akiliki nao ĩkalũnĩ, nake nũvukĩtye vandũ vaa vatheu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.28",
            "verseOrgIds": [
              "ACT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.4"
              },
              "items": [
                {
                  "text": "Meko 20.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.20"
              },
              "items": [
                {
                  "text": "2 Tim 4.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ maĩ manamwona ndũanĩ e na Telovimo, mũndũ wa Eveso, namo nĩmatalĩlasya kana Vaulo nũmũetete ĩkalũnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndũa yonthe yaya kĩtuu, na andũ moombana masembete; na mamũkwata Vaulo, mamũkusũlan’ya na kũmumaalya ũtee wa ĩkalũ: na oyu mĩomo yavingwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.30",
            "verseOrgIds": [
              "ACT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makĩmantha kũmũaa, ũvoo wamũvikĩa ũla mũnene wa nguthu ya asikalĩ ngili, kana Yelusaleme kw’onthe nĩkũlikile kĩtuu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.31",
            "verseOrgIds": [
              "ACT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oyu oosa asikaiĩ na anene ma asikalĩ ĩana ĩana, na amatheeea asembete: nao, moona ũla mũnene na asikalĩ, maeka kũmũlumangya Vaulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.32",
            "verseOrgIds": [
              "ACT.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.11"
              },
              "items": [
                {
                  "text": "Meko 21.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.23"
              },
              "items": [
                {
                  "text": "20.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ũla mũnene athengeea, na amũkwata Vaulo, na eeaa nĩovwe na mĩnyololo ĩlĩ; na akũlya ũndũ wĩtawa na ũndũ wĩkĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.33",
            "verseOrgIds": [
              "ACT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwe manĩĩsya ũndũ ũmwe, na angĩ katĩ wa nguthu manĩĩsya ũndũ ũngi: na alea ũmanya nesa nũndũ wa kĩtuu, eeaa aetwe ngomenĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.34",
            "verseOrgIds": [
              "ACT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na avika mbasyanĩ, akuwa nĩ asikalĩ nũndũ wa ũng’endu wa ĩla nguthu ya andũ; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.35",
            "verseOrgIds": [
              "ACT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.22"
              },
              "items": [
                {
                  "text": "Meko 22.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.18"
              },
              "items": [
                {
                  "text": "Lk 23.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ ĩkomano ya andũ yamũvikĩlĩte, yĩkyasya na wasya mũnene, Mũvete ũsu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Vaulo akilĩlye ũlikwa ngomenĩ nthĩnĩ, amwĩa ũla mũnene wa asikalĩ, Nĩ na ũthei nyie kũkũtavya ũndũ? Nake amũkũlya, Nĩwĩsĩ Kĩkiliki? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.36"
              },
              "items": [
                {
                  "text": "Meko 5.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuue ũla Mũmisili, ũla mbee wa mĩthenya ĩno wamang’endethisye andũ ngili inya ala metawa Oaani na wamatongoesya weũnĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.11"
              },
              "items": [
                {
                  "text": "Meko 9.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Vaulo amũsũngĩa, Nyie nĩ Mũyuti, mũndũ wa Taliso, ndũa ya Silisia, mũndũ wa ndũa ĩte mbũthũ: na nĩngũkwĩsũva ũnenge ũthei nĩneene na andũ aa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 21:40"
          },
          "items": [
