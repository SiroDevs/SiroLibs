            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndyaawĩw’ĩa ĩtomo vetha wa mũndũ o na wĩva, kana thaavu, kana ngũa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.33",
