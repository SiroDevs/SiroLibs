              },
              "items": [
                {
                  "text": "Sav 74.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.16"
              },
              "items": [
                {
                  "text": "1 Tim 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
