            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na andũ aingĩ makookĩla kuma katĩ wenyu, makĩneena ndeto sya ngũlũ, maimakusya amanyĩw’a mamaatĩĩe mo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.30",
