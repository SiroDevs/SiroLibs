                {
                  "text": "Meko 21.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ndiũtala thayũ wakwa ta kĩndũ kwakwa, nĩ kana nĩtonye kwĩanĩsya mũendo wakwa, na ũthũkũmi ũla noosie kwa Mwĩaĩi Yesũ, kũkũsĩĩa ũla ũvoo mũseo wa mumo wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.24",
            "verseOrgIds": [
              "ACT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu, sisyai, nĩnĩsĩ kana inyw’onthe, ala nangangĩte katĩ wenyu ngĩtavan’ya ũsumbĩ wa Ngai, mũikambona ĩngĩ ũthyũ wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.25",
            "verseOrgIds": [
              "ACT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.6"
              },
              "items": [
                {
                  "text": "Meko 18.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nĩmũkũsĩĩa ũmũnthĩ, kana ndikakũlw’a nyie nthakame ya mũndũ o na wĩva. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.26",
            "verseOrgIds": [
              "ACT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ndyaatundua kũmũtavya inyw’ĩ ũtw’ĩo w’onthe wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.27",
            "verseOrgIds": [
              "ACT.20.27"
            ]
          }
        },
        {
