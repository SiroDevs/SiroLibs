                  "text": "Kũt 33.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu nĩmũnengane kwa Ngai, na kwa ndeto ya mumo wake, ĩla ĩtonya kũmwaka, na kũmũnenga inyw’ĩ ũtiĩwa katĩ wa onthe ala mavathĩwe Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.32",
            "verseOrgIds": [
              "ACT.20.32"
            ]
          }
        },
        {
