            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩsĩ kana ĩtina wa kũthi kwakwa nzũi mbai ikalika katĩ wenyu, iteũyĩw’ĩa yĩla ĩĩthya tei; ",
          "type": "text",
