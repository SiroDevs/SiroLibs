                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ate o Veva Mũtheu kũngũsĩĩa ndũanĩ syonthe, aiasya kana syĩndũ sya kwovwa nasyo na monyamao nimbeteele. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.23",
            "verseOrgIds": [
              "ACT.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
