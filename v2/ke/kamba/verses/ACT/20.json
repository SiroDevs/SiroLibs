            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyw’ĩ ene nĩmwĩsĩ kana moko aa makwa matethisye wĩa kwondũ wa mavata makwa mwene na ma ala maĩ nakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.34",
