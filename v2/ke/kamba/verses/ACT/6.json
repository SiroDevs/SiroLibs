              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.6",
            "verseOrgIds": [
              "ACT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.20"
              },
              "items": [
                {
                  "text": "Meko 19.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndeto ya Ngai yeana; na ũtalo wa amanyĩw’a waingĩvw’a mũno Yelusaleme; na nguthu nene ya athembi yalika ũla mũĩkĩĩonĩ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Sitivini, ausũĩte mumo na vinya, eeka momakyo manene na mawonan’yo andũnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.8",
            "verseOrgIds": [
              "ACT.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kwookĩla amwe ala maĩ ma ĩsinakoke yĩla yĩtawa ya Alivelitino, na ya Akulene, na ya Aalesandalia, na ya ala ma Silisia na Asia, maikananĩa na Sitivini. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.9",
            "verseOrgIds": [
              "ACT.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.15"
              },
              "items": [
                {
                  "text": "Lk 21.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matyaatonya kũsiĩĩa ũĩ wake na Veva ũla waneenie naw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.10",
            "verseOrgIds": [
              "ACT.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.60+MAT.26.61+MAT.26.62+MAT.26.63+MAT.26.64+MAT.26.65+MAT.26.66"
              },
              "items": [
                {
                  "text": "Mt 26.60–66",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mew’ana na maisye, Nĩtwĩw’ĩte ũsu aineenea Mose na Ngai ndeto sya ũumano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.11",
            "verseOrgIds": [
              "ACT.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamaingĩanĩsya andũ, na atumĩa, na aandĩki, na mamũkĩlĩla, mamũkwata, na mamũete nzamanĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.12",
            "verseOrgIds": [
              "ACT.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.11"
              },
              "items": [
                {
                  "text": "Yel 26.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mamũũngamĩsya ngũsĩ sya ũvũngũ, ila syaisye, Mũndũ ũũ ndaekaa ũneenea vandũ vaa vatheu na ĩla mĩao ndeto: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.13",
            "verseOrgIds": [
              "ACT.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩtwĩw’ĩte aiasya kana Yesũ ũsu wa Nasaleti akaananga vandũ vaa, na kũalyũla syĩthĩo ila twanengiwe nĩ Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.14",
            "verseOrgIds": [
              "ACT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na onthe ala mekalĩte nzamanĩ, maimũketeea na metho moo, moona ũthyũ wake ũilyĩ ta ũthyũ wa mũlaĩka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.15",
            "verseOrgIds": [
              "ACT.6.15"
            ]
          }
        }
      ]
    }
  ],
