              "items": [
                {
                  "text": "Meko 7.54",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo meew’a ũu matemwa ngoonĩ, na menda kũmoaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.33",
            "verseOrgIds": [
              "ACT.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
