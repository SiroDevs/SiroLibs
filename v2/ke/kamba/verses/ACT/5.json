                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.2"
              },
              "items": [
                {
                  "text": "12.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ we Ngai nũmũnenevetye kw’okonĩ kwake kwa aũme, ethĩwe Mũnene na Mũtangĩĩi, amanenge Isilaeli ũalyũlo wa ngoo, na ũekeo wa naĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.31",
            "verseOrgIds": [
              "ACT.5.31"
            ]
          }
        },
        {
