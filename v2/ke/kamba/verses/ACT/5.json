              },
              "items": [
                {
                  "text": "Meko 22.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũndũ ũmwe Mũvalisi, wetawa Kamalieli, mũmanyĩsya mũnene wa mĩao, ũla wataĩawa nĩ andũ onthe, aũngama nzamanĩ, na atw’a mamaumaalye andũ asu nza kavinda kanini. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.34",
            "verseOrgIds": [
              "ACT.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amea, Inyw’ĩ aũme ma Isilaeli, ĩsũvĩei ene ũndũ wa andũ aa, ũndũ mũkilĩlye kwĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.35",
            "verseOrgIds": [
              "ACT.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.38"
              },
              "items": [
                {
                  "text": "Meko 21.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwĩthĩwa mbee wa mĩthenya ĩno Theutasi nũnookĩlile, aimatavya andũ nĩwe ĩkũ; na andũ aingĩ mamũatĩĩa, ũtalo woo wavikĩte ta maana ana: nake nĩwoaiwe; na onthe ala mamwĩw’aa manyaĩĩkw’a, meethĩwa ti kĩndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.36",
            "verseOrgIds": [
              "ACT.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.2"
              },
              "items": [
                {
                  "text": "Lk 2.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩtina wa mũndũ ũsu, anookĩla Yutasi, mũndũ wa Kalilii, mĩthenya ĩsu ya kũandĩkwa, nake akusya andũ amwe mamũatĩĩa: nake aaa; na onthe, o ala mamwĩw’aa, manyaĩĩkw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.37",
            "verseOrgIds": [
              "ACT.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.13"
              },
              "items": [
                {
                  "text": "Mt 15.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu nĩmwĩa inyw’ĩ, Isiĩĩei na andũ aa, nũmaeke: nũndũ ethĩwa nzama ĩno kana wĩa ũũ nĩ wa andũ, ũkaanangwa: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.38",
            "verseOrgIds": [
              "ACT.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.5"
              },
              "items": [
                {
                  "text": "Meko 9.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ethĩwa nĩ wa Ngai, mũtikatonya kũmananga; mũikese kwoneka mũkyũkita na Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.39",
            "verseOrgIds": [
              "ACT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.19"
              },
              "items": [
                {
                  "text": "Meko 22.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na meew’a ndeto syake; na mameta atũmwa mbee woo, mamakũna na mameaĩa maikaneene syĩtwanĩ ya Yesũ, na mamaeka mathi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.40",
            "verseOrgIds": [
              "ACT.5.40"
            ]
          }
        },
