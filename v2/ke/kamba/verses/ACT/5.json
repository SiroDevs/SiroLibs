              "items": [
                {
                  "text": "Meko 2.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.10"
              },
              "items": [
                {
                  "text": "Aevl 2.10",
