          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake ambĩlĩlya ũneena na ũkũmbaũ ĩsinakokenĩ. Ĩndĩ Vilisila na Akwila mamwĩw’a, mamũtwaa kwoo, na mamũvuanĩsya nzĩa ya Ngai nesa mbee wa vala wesĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.26",
            "verseOrgIds": [
              "ACT.18.26"
            ]
          }
        },
        {
