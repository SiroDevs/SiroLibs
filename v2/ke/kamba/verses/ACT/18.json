            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake aumĩa Kaisalea ambata amakethya andũ ma ĩkanisa, na ĩndĩ atheea Andiokia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.22",
