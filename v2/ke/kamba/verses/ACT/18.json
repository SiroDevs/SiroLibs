                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũsu nĩwamanyĩĩtw’e nzĩa ya Mwĩaĩi; na nĩkwĩthĩwa aĩ mũthangaau vevanĩ wake, nĩwaneenie na kũmanyĩsya nesa maũndũ ma Yesũ, ĩndĩ eesĩ ũvatisi wa Yoana w’oka: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.25",
            "verseOrgIds": [
              "ACT.18.25"
            ]
          }
        },
        {
          "name": "verse",
