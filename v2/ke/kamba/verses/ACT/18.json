            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ eeaanĩa nao, amea, Ngamũalũkĩla ĩngĩ, Ngai enda, na athi na ngalawa kuma Eveso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.21",
