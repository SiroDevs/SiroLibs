          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mathaw’a, mathi vala ve ala angĩ moo, na mamatavya maũndũ onthe ala mataviw’e nĩ athembi anene na atumĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.23",
            "verseOrgIds": [
              "ACT.4.23"
            ]
          }
        },
        {
