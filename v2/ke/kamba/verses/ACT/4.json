                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo, meew’a ũu, mamũkĩlĩlya Ngai mawasya moo na ngoo ĩmwe, maiasya, Ame Mwĩaĩi, nue woombie ĩtu na nthĩ na ũkanga, na syĩndũ syonthe ila syĩ nthĩnĩ wasyo: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.24",
            "verseOrgIds": [
              "ACT.4.24"
            ]
          }
        },
        {
          "name": "verse",
