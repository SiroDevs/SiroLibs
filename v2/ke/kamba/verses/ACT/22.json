          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũnĩ ũsu, aienda kũmanya vyũ ũndũ ũnavinganĩw’e nĩ Ayuti, amũthasya, na ameaĩa athembi anene na nzama yonthe mombane vamwe, na amũtheesya Vaulo amwia mbee woo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
            "verseOrgIds": [
              "ACT.22.30"
            ]
          }
        }
