              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana‐a‐asa makwa na aasa, ĩthukĩĩsyei ũsũngĩo wakwa ũla ngũsũngĩa mbee wenyu oyu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.1",
