            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ athi Taliso kũmũmantha Saulo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.25",
            "verseOrgIds": [
              "ACT.11.25"
            ]
