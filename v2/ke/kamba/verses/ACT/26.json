                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.2"
              },
              "items": [
                {
                  "text": "Aev 2.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.13"
              },
              "items": [
                {
                  "text": "Ako 1.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũmasalukya metho moo, nĩ kana methyũũe na kũkĩtia kĩvindu makyelekele kyeni, na kũeka ũkũmũ wa Satani na ũmwelekela Ngai, nĩ kana mose ũekeo wa naĩ, na ũtiĩwa vamwe na onthe ala mavathanĩtw’e kwondũ wa mũĩkĩĩo ũla wĩ kwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.16"
              },
              "items": [
                {
                  "text": "Aka 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ, mũsumbĩ Akiliva, ndyaatw’ika mũlei wa ũla woni waumie ĩtunĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.19",
            "verseOrgIds": [
              "ACT.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.8"
              },
              "items": [
                {
                  "text": "Mt 3.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mbee natavanisye kwa ala ma Ndamasiku, na Yelusaleme, na ku kw’onthe nthĩ ya Yutia, na kwa Andũ‐ma‐mbaĩ‐ingĩ nao, kana mealyũle na ũmwelekela Ngai, mekae meko mosanĩte na kũalyũla ngoo kwoo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.30"
              },
              "items": [
                {
                  "text": "Meko 21.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Ayuti mangwatĩa ĩkalũnĩ na menda ũmbũaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.44+LUK.24.45+LUK.24.46+LUK.24.47"
              },
              "items": [
                {
                  "text": "Lk 24.44–47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩkwĩthĩwa nosete ũtethyo ũla wumaa kwa Ngai, nĩũngeme kũvika ũmũnthĩ ngĩnenga ũkũsĩ anene na anini nao, o na ndiũneena ũndũ, ate o ũla athani na Mose maisye ũkoka: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.20"
              },
              "items": [
                {
                  "text": "1 Ako 15.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa atĩ ũndũ Klĩsto nde ndĩi ya ũlea kũthĩnw’a, na ũndũ we ũkamba kũthayũũkw’a kwa akw’ũ na kũtavan’ya kyeni kwa andũ ma mbaĩ yaitũ na kwa Andũ‐ma‐mbaĩ‐ingĩ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
