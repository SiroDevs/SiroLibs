              "attrs": {
                "loc": "ROM.12.16"
              },
              "items": [
                {
                  "text": "Alo 12.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ndikwenda, ana‐a‐asa, mũlee ũmanya nzama ĩno, nĩ kana mũĩkeyone ta mwĩ oĩ, atĩ wũmũ wa kilungu nĩwamakwatie Isilaeli, kũvika wĩanĩu wa Andũ‐ma‐mbaĩ‐ingĩ wĩvika; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.25",
            "verseOrgIds": [
              "ROM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ta ũu Isilaeli onthe makatangĩĩwa: o ũndũ kũandĩkĩtwe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.26",
            "verseOrgIds": [
              "ROM.11.26"
            ]
          }
        }
      ]
    },
