                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.37"
              },
              "items": [
                {
                  "text": "Yel 31.37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.5"
              },
              "items": [
                {
                  "text": "Avi 3.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩngũkũlya indĩ, Ngai nĩwamavetie andũ make? Aiee, kũĩkethĩwe ũu. Nũndũ nyie nakwa nĩ Mũisilaeli, wa ũsyao wa Avalaamu, wa mbaĩ ya Mbenyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.1",
            "verseOrgIds": [
              "ROM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.10"
              },
              "items": [
                {
                  "text": "1 Asu 19.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai ndaamaveta andũ make ala wesĩ kuma tene. Kana mũiĩsĩ ũndũ maandĩko measya ũndũ wa Eliya? Ũndũ emwĩsũva Ngai aivinganĩsya Isilaeli, aiasya: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.2",
            "verseOrgIds": [
              "ROM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩaĩi, nĩmooaie athani maku, nĩmaomboie ithembeo syaku; nakwa ndiele nĩ nyioka, nao memantha thayũ wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.3",
            "verseOrgIds": [
              "ROM.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.18"
              },
              "items": [
                {
                  "text": "1 Asu 19.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũsũngĩo wa Ngai wĩmwĩa ata? Nĩtialĩlye andũ ngili. Mũonza, ala mataatulĩlya Mbaali ndu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.4",
            "verseOrgIds": [
              "ROM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.27"
              },
              "items": [
                {
                  "text": "Alo 9.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na yu ĩvindanĩ yĩĩ kwĩ ũtialo kwĩanana na kũnyuvwa kwa mumo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.5",
            "verseOrgIds": [
              "ROM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Aka 3.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa nĩ ũndũ wa mumo ti ũndũ wa meko ĩngĩ: ethĩwa ti ũu mumo nũtw’ĩkĩte ti mumo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.6",
            "verseOrgIds": [
              "ROM.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.31"
              },
              "items": [
                {
                  "text": "Alo 9.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũilyĩ ata ĩndĩ? Kĩla Isilaeli wamanthaa, ndaakyona; ĩndĩ ala anyuve nĩmakyonie, na ala angĩ nĩmoomiw’e: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.7",
            "verseOrgIds": [
              "ROM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.10"
              },
              "items": [
                {
                  "text": "Isa 29.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.4"
              },
              "items": [
                {
                  "text": "Kũt 29.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ũndũ kũandĩkĩtwe, Ngai nĩwamanengie veva wa too, metho maikone, na matũ maikew’e, kũvika mũthenya ũũ wa ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.8",
            "verseOrgIds": [
              "ROM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.22"
              },
              "items": [
                {
                  "text": "Sav 69.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.8"
              },
              "items": [
                {
                  "text": "35.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti easya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.9",
            "verseOrgIds": [
              "ROM.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.10",
            "verseOrgIds": [
              "ROM.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.11",
            "verseOrgIds": [
              "ROM.11.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.21"
              },
              "items": [
                {
                  "text": "Kũt 32.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.46"
              },
              "items": [
                {
                  "text": "Meko 13.46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.19"
              },
              "items": [
                {
                  "text": "Alo 10.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩngũkũlya, Malulutĩkile mavalũke? Aiee, kũikethiwe ũu: ĩndĩ ũndũ wa kũvalũka kwoo ũtangĩĩo nũvikĩe Andũ‐ma‐mbaĩ‐ingĩ, nĩ kana nao mekĩwe kĩwĩu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.11",
            "verseOrgIds": [
              "ROM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa kũvalũka kwoo nĩ ũthwii kwa nthĩ, na wasyo woo nĩ ũthwii kwa Andũ‐ma‐mbaĩ‐ingĩ; nĩ mbee veanata wĩanĩu woo? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.12",
            "verseOrgIds": [
              "ROM.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩngũneena nenyu Andũ‐ma‐mbaĩ‐ingĩ. O ũndũ nyie nĩ mũtũmwa kwa Andũ‐ma‐mbaĩ‐ingĩ, nĩtaĩa ũthũkũmi wakwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.13",
            "verseOrgIds": [
              "ROM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.16"
              },
              "items": [
                {
                  "text": "1 Tim 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana ndonye kwa ũndũ o na wĩva kũmew’ithya kĩwĩu ala ma mbai yakwa, na kũtangĩĩa amwe moo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.14",
            "verseOrgIds": [
              "ROM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ethĩwa kũvetwa kwoo nĩ kwiw’anithw’a kwa nthĩ. Kwĩtĩkĩlwa kwoo kũkethĩwa nĩ ata, ate o thayũ kuma kikw’ũnĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.15",
            "verseOrgIds": [
              "ROM.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.17+NUM.15.18+NUM.15.19+NUM.15.20+NUM.15.21"
              },
              "items": [
                {
                  "text": "Mot 15.17–21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũtuo wa ũsyao wa mbee nĩ mũtheu, no ta ũu mũndo w’onthe naw’o: na ethĩwa kĩtina nĩ kĩtheu, mbonge nasyo no ta ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.16",
            "verseOrgIds": [
              "ROM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.11+EPH.2.12+EPH.2.13+EPH.2.14+EPH.2.15+EPH.2.16+EPH.2.17+EPH.2.18+EPH.2.19"
              },
              "items": [
                {
                  "text": "Aev 2.11–19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa mbonge imwe nĩsyatũlilwe, naku, yĩla waĩ mũthata wa kĩthekanĩ, wasamaniw’e katĩ wasyo, na watw’ĩkie mwosi vamwe nasyo wa kĩla kĩtina na ũnou wa ũla mũthata; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.17",
            "verseOrgIds": [
              "ROM.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.22"
              },
              "items": [
                {
                  "text": "Yoa 4.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndũkekathĩie ĩũlũ wa ila mbonge: ĩndĩ ethĩwa nũkwĩkathĩĩa, tuue ũkuaa kĩtina, ĩndĩ nĩ kĩtina kĩũkuaa we. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.18",
            "verseOrgIds": [
              "ROM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũkasya, Mbonge nĩsyatũlilwe, nĩ kana nĩsamanw’e vo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.19",
            "verseOrgIds": [
              "ROM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.16"
              },
              "items": [
                {
                  "text": "Alo 12.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni w’o; kwa kũlea kwĩtĩkĩla kwoo nĩmatũlilwe, naku ũũngeme ũndũ wa kũĩkĩĩa kwaku. Ndũkethĩwe na kĩlĩko kĩ mĩtũlyo, ĩndĩ ĩthĩwa na w’ĩa: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.20",
            "verseOrgIds": [
              "ROM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ ethĩwa Ngai ndaaekana na mbonge ila syai vo, o naku ndakakũeka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.21",
            "verseOrgIds": [
              "ROM.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.2"
              },
              "items": [
                {
                  "text": "Yoa 15.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.14"
              },
              "items": [
                {
                  "text": "Aevl 3.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya ĩndĩ ũseo na wai wa Ngai: kwa ala mavalũkile, wai; ĩndĩ kwaku, ũseo wa Ngai, ethĩwa ũkekalaa ũseonĩ wake: na ethiwa ti ũu o naku ũkatilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.22",
            "verseOrgIds": [
              "ROM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.16"
              },
              "items": [
                {
                  "text": "2 Ako 3.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asu nao, ethĩwa maikekala na kũlea kwĩtĩkĩla kwoo, makasamanw’a: nũndũ Ngai nũtonya kũmasaman’ya ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.23",
            "verseOrgIds": [
              "ROM.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ethĩwa we nĩwatililwe waumw’a mũthatanĩ, mũthata wa mũtuo wa kĩthekanĩ, na wasamaniw’e ũndũ ũtekawa nthĩnĩ wa mũthata mũseo; ti mbee mũno asu, ala maĩ mbonge kwa mũtuo woo, kũsamanw’a mũthatanĩ ũla woo ene?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.24",
            "verseOrgIds": [
              "ROM.11.24"
            ]
          }
        }
      ]
    },
