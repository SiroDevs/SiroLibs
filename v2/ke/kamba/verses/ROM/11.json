                "loc": "ISA.45.15"
              },
              "items": [
                {
                  "text": "Isa 45.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "A! Kyũngũ kya ũthwii wa ũĩ na ũmanyi wa Ngai! Motw’ĩo make matamanyĩka, na nzĩa syake itamanthĩka! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.33",
            "verseOrgIds": [
              "ROM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.13"
              },
              "items": [
                {
                  "text": "Isa 40.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.15.8"
              },
              "items": [
                {
                  "text": "Yovu 15.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.18"
              },
              "items": [
                {
                  "text": "Yel 23.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.16"
              },
              "items": [
                {
                  "text": "1 Ako 2.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nũũ ũla wamanyie kĩlilikano kya Mwĩaĩi? Kana nũũ ũla waĩ mũtai wake? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana nũũ ũla wambie ũmũnenga kĩndũ, na kũĩvwa ĩngĩ o kyo? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.35",
            "verseOrgIds": [
              "ROM.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ROM 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ syĩndĩ syonthe syumaa kwake, na ĩngĩ syĩ kwondũ wake, na ialũkaa kwake. Ndaĩa nĩ yake tene na tene. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.36",
            "verseOrgIds": [
              "ROM.11.36"
            ]
          }
        }
