                "loc": "JHN.8.7"
              },
              "items": [
                {
                  "text": "Yoa 8.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu naku ndwĩ na wĩmilo, we mũndũ, ũla ũsilĩlaa ũngĩ: nũndũ maũndũnĩ ala ũsilĩlaa ũngĩ, wĩsilĩlaa mwene kana wĩ mũvĩtan’ya; nĩkwĩthĩwa we ũla ũsilĩlaa wĩkaa maũndũ o asu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.1",
            "verseOrgIds": [
              "ROM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitũ nĩtwĩsĩ kana ũsilĩlo wa Ngai nĩ kwĩanana na w’o ĩũlũ wa ala mekaa maũndũ ta asu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.2",
            "verseOrgIds": [
              "ROM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku mũndũ, ũla ũsilĩlaa ala mavikĩlaa maũndũ ta asu, naku mwene nũmekaa, wĩtalĩlya kana we ũkavonoka ũsilĩlo wa Ngai? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.3",
            "verseOrgIds": [
              "ROM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.15"
              },
              "items": [
                {
                  "text": "2 Vet 3.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana we wĩvũthya wingĩ wa ũseo wake na wĩtũngi na wũmĩĩsyo, ũteũmanya kana ũseo wa Ngai ũkũtongoeasya ũalyũloni wa ngoo? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.4",
            "verseOrgIds": [
              "ROM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kũatĩĩa wũmũ waku na ngoo yaku ĩte na wĩlilo wĩyiĩaa ũthatu wa mũthenya wa ũthatu na wa wonan’yo wa ũsilĩlo mũlũngalu wa Ngai: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.5",
            "verseOrgIds": [
              "ROM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.62.12"
              },
              "items": [
                {
                  "text": "Sav 62.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.12"
              },
              "items": [
                {
                  "text": "Nth 24.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.27"
              },
              "items": [
                {
                  "text": "Mt 16.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Yoa 5.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.10"
              },
              "items": [
                {
                  "text": "2 Ako 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla ũkamũnenga kĩla mũndũ kwĩanana na meko make: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.6",
            "verseOrgIds": [
              "ROM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa asu ala mekwĩyũmĩĩsya kwĩkaa nesa mamanthaa ndaĩa na nguma na maũndũ matanangĩkaa, akamanenga thayũ ũtathela: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.7",
            "verseOrgIds": [
              "ROM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.8"
              },
              "items": [
                {
                  "text": "2 Ath 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ kwa ala maetae ngananĩo, na matew’aa ũla w’o, ĩndĩ nĩmew’aa ũndũ ũte ũlũngalu, kũkeethĩwa ũthilĩku na ũthatu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.8",
            "verseOrgIds": [
              "ROM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.16"
              },
              "items": [
                {
                  "text": "Alo 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.9"
              },
              "items": [
                {
                  "text": "3.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "thĩna na ũnyamao, ĩũlũ wa kĩla mũndũ ũla wĩkaa nai, wa Mũyuti mbee, na wa Mũkiliki nake; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.9",
            "verseOrgIds": [
              "ROM.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ndaĩa na nguma na mũuo kwa kĩla mũndũ ũla wĩkaa nesa, Mũyuti mbee, na Mũkiliki nake: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.10",
            "verseOrgIds": [
              "ROM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.34"
              },
              "items": [
                {
                  "text": "Meko 10.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.17"
              },
              "items": [
                {
                  "text": "1 Vet 1.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ Ngai ti mwendeesya wa andũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.11",
            "verseOrgIds": [
              "ROM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ onthe ala meekie nai ĩla mĩao ĩte vo makaaa vate ĩla mĩao; na asu onthe ala meekie nai me na ĩla mĩao makasilĩlwa na ĩla mĩao; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.12",
            "verseOrgIds": [
              "ROM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.21"
              },
              "items": [
                {
                  "text": "Mt 7.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.7"
              },
              "items": [
                {
                  "text": "1 Yoa 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.22"
              },
              "items": [
                {
                  "text": "Yak 1.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ ti ewi ma ĩla mĩao alũngalu mbee wa Ngai, ĩndĩ nĩ eki ma mĩao makatalĩlwa ũlũngalu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.13",
            "verseOrgIds": [
              "ROM.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.35"
              },
              "items": [
                {
                  "text": "Meko 10.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nũndũ yĩla Andũ‐ma‐mbaĩ‐ingĩ mate na ĩla mĩao mekaa maũndũ ala me nthĩnĩ wa mĩao kwa mũtuo woo, andũ asu, mate na mĩao, no mo mĩao ene; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.14",
            "verseOrgIds": [
              "ROM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.32"
              },
              "items": [
                {
                  "text": "Alo 1.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ maũndũnĩ asu meonan’ya wĩa wa ĩla mĩao ũandĩkĩtwe ngoonĩ syoo, wasya wa ngoo woo ũkĩkũsĩĩa, na malilikano moo ene kwa ene maimon’ya mavĩtyo kana kũmaekea;) ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.15",
            "verseOrgIds": [
              "ROM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.8"
              },
              "items": [
                {
                  "text": "2 Tim 2.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũthenya ũla Ngai ũkasilĩla syĩmbithĩ sya andũ, kwa nzĩa ya Yesũ Klĩsto, kwĩanana na ũvoo mũseo wakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.16",
            "verseOrgIds": [
              "ROM.2.16"
            ]
          }
        }
      ]
    },
