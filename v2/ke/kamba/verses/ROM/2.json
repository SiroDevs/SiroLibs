              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ we ti Mũyuti ũla wĩ Mũyuti kwa ũvano wa ũtheinĩ: o na nzaĩko ti ĩla yĩ ũtheinĩ mwĩĩnĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.28",
            "verseOrgIds": [
              "ROM.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
