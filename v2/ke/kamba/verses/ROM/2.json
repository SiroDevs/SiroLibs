          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.8"
              },
              "items": [
                {
                  "text": "Mwa 49.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.6"
              },
              "items": [
                {
                  "text": "Kũt 30.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.11"
              },
              "items": [
                {
                  "text": "Ako 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ we nĩ Mũyuti, ũla wĩ Mũyuti nthĩnĩ; na nzaĩko nĩ ĩla ya ngoo, vevanĩ na ti nthĩnĩ wa maandĩko; na ndaĩa yake ndyumaa andũnĩ, ĩndĩ yumaa kwa Ngai.",
          "type": "text",
          "attrs": {
