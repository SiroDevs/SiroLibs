              "items": [
                {
                  "text": "Yel 4.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "9.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩ w’o nzaĩko yĩ vata, ethĩwa wĩ mwĩki wa ĩla mĩao: ĩndĩ ethĩwa wĩ mũvĩtan’ya wa ĩla mĩao, nzaĩko yaku ĩtw’ĩkĩte ti nzaĩko. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.25",
            "verseOrgIds": [
              "ROM.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.6"
              },
              "items": [
                {
                  "text": "Aka 5.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa ũla ũtaĩkawa akwataa motw’io ma ĩla mĩao, kũtaĩkwa kwake kũikatalwa kwĩthĩwa nĩ nzaĩko? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.26",
            "verseOrgIds": [
              "ROM.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa ũla wa mũtuo wa kũlea kwaĩkwa, nũkwĩanĩsya ĩla mĩao, ndakaũsilĩla we, ũla wĩ na maandĩko na nzaĩko, na wĩ mũvĩtan’ya wa ĩla mĩao? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.27",
            "verseOrgIds": [
              "ROM.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
