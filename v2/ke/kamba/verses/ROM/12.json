            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmwĩsũva ĩndĩno, ana‐a‐asa makwa, kwondũ wa matei ma Ngai, mwĩnengane mĩĩ yenyu ĩthĩwe nthembo ĩ thayũ, ntheu, ya kũmwendeesya Ngai, naw’o nĩ ũthaithi wenyu waĩlaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.1",
            "verseOrgIds": [
              "ROM.12.1"
            ]
          }
        },
        {
