              "type": "text"
            }
          ]
        },
        {
          "text": "Maathimei ala mamũthĩnasya; athimai, o na mũikaumanĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.14",
            "verseOrgIds": [
