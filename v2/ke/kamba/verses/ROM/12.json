                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.4"
              },
              "items": [
                {
                  "text": "Aka 1.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikavw’ananw’e na nthĩ ĩno: ĩndĩ mũalyũkw’e mũtũngwe eũ ilĩkonĩ syenyu, nĩ kana mwĩkuũe ũndũ kũilyĩ kwenda kwa Ngai kũla kũseo na kũla kwĩtĩkĩlĩka na kũla kwĩanĩu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        }
      ]
    },
    {
