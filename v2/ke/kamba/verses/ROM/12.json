          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.11"
              },
              "items": [
                {
                  "text": "1 Ako 12.11",
