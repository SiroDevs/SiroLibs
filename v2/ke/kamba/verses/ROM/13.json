          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.8"
              },
              "items": [
                {
                  "text": "1 Yoa 2.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.11"
              },
              "items": [
                {
                  "text": "Aev 5.11",
