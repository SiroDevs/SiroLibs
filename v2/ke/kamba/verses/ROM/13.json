            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũu, tũkĩmanya ĩvinda, kana yuyu kyathĩ nĩ kĩviku kya kũamũka kuma toonĩ: nũndũ yu ũtangĩĩo wĩ vakuvĩ naitũ kwĩ yĩla tweetĩkĩlile mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
