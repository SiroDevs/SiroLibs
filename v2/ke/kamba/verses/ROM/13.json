              "items": [
                {
                  "text": "Nth 8.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩla mũndũ nĩethĩwe e mwĩwi wa ala me na ũkũmũ: nũndũ kũi ũkũmũ ũtaumite kwa Ngai; na mokũmũ ala me kw’o nĩmatwiwe nĩ Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.1",
            "verseOrgIds": [
              "ROM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ũla ũleaa kwĩw’a ũkũmũ ũsu, aleaa kwĩw’a ũtw’ĩo wa Ngai: na ala maleaa kwĩw’a makeeyoseaa ũsilĩlo ene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.2",
            "verseOrgIds": [
              "ROM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.13"
              },
              "items": [
                {
                  "text": "1 Vet 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.13"
              },
              "items": [
                {
                  "text": "3.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ala masumbĩkĩte maitĩsasya andũ kwondũ wa meko maseo, ĩndĩ no kwondũ wa meko mathũku. Na nũkwenda kwĩkala ũte na w’ĩa kwa ũla wĩ na ũkũmũ? Ĩkaa ũseo, na ũkoosaa nguma kuma kwake: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.3",
            "verseOrgIds": [
              "ROM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.82.6"
              },
              "items": [
                {
                  "text": "Sav 82.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.19"
              },
              "items": [
                {
                  "text": "Alo 12.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩ mũthũkũmi wa Ngai kwaku kwondũ wa ũseo. Ĩndĩ ethĩwa wĩkaa maũndũ ala mathũku, ĩthĩwa na w’ĩa; nũndũ ndakuaa ũvyũ mana: nũndũ nĩ mũthũkũmi wa Ngai mũĩvanĩsya wa ũthatu kwa ũla wĩkaa naĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.4",
            "verseOrgIds": [
              "ROM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, mũvaka mwĩthĩwe ewi, ti ũndũ wa ũthatu w’oka, ĩndĩ naw’o kwondũ wa wasya wa ngoo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.5",
            "verseOrgIds": [
              "ROM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwondũ wa ũu nĩmumasya kotĩ; nũndũ nĩ athũkũmi ma Ngai, mekalaa mavinda onthe ũndũnĩ o ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.21"
              },
              "items": [
                {
                  "text": "Mt 22.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nengai onthe kĩla kyaĩle: koti kwa ũla waĩlwe nĩ kũmĩw’a kotĩ: kumya mũvothi kwa ũla waĩlwe nĩ kumĩw’a mũvothi; w’ĩa kwa ũla waĩlwe nĩ kũkĩwa; ndaĩa kwa ũla waĩlwe nĩ kũtaĩwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        }
      ]
    },
