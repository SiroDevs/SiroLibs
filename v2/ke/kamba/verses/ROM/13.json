                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17"
              },
              "items": [
                {
                  "text": "Kũt 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, Ndũkalaalae, Ndũkoae, Ndũkoye, Ndũkakĩw’ĩe kĩndũ kya ũngĩ ĩtomo, na ethĩwa kwĩ mwĩao ũngĩ, ũtalanĩlwe ndetonĩ ĩno, Mwende ũngĩ ũndũ wĩyendete mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.4"
              },
              "items": [
                {
                  "text": "1 Ako 13.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.40"
              },
              "items": [
                {
                  "text": "Mt 22.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wendo ndwĩkaa naĩ kwa ũngĩ; kwondũ wa ũu wendo nĩ wĩanĩsyo wa ĩla mĩao.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
