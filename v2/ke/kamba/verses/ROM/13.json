                {
                  "text": "1 Tim 1.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũĩkethĩwe mwi thiĩ na mũndũ wa kĩndũ o na kĩva kyonthe, ate o kwendana inyw’ĩ kwa inyw’ĩ: nũndũ ũla ũmwendaa ũngĩ nĩwĩanĩsye ĩla mĩao. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.8",
            "verseOrgIds": [
              "ROM.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 13:9"
          },
          "items": [
