                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaĩ na ũsyao mwaũ ĩvinda yĩu maũndũnĩ asu ala mũmew’ĩaa nthoni yu? Nũndũ mũminũkĩlyo wa maũndũ asu nĩ kĩkw’ũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.21",
            "verseOrgIds": [
              "ROM.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.9"
              },
              "items": [
                {
                  "text": "1 Vet 1.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu nĩmũthaĩtw’e kuma naĩnĩ, na mwatw’ĩka athũkũmi ma Ngai, mwĩ na ũsyao wenyu kũvika kũvathĩka, na mũminũkĩlyo nĩ thayũ ũtathela. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.22",
            "verseOrgIds": [
              "ROM.6.22"
            ]
          }
        },
        {
