                "loc": "ROM.5.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nata ĩndĩ? Twĩke nai, nũndũ tũi ũngũ wa ĩla mĩao, ĩndĩ twĩ ungu wa mumo? Aiee, kũikethĩwe ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.15",
            "verseOrgIds": [
              "ROM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
