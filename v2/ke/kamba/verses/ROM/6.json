                "loc": "ROM.5.17"
              },
              "items": [
                {
                  "text": "Alo 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
