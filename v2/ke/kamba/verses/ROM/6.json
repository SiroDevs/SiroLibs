              },
              "items": [
                {
                  "text": "Yoa 8.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.19"
              },
              "items": [
                {
                  "text": "2 Vet 2.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũiĩsĩ, kana kwa ũla mwĩnenganĩte ene mwĩthĩwe ngombo syake sya kwĩw’a, mwĩ ngombo syake ũla mũmwĩw’aa; ethĩwa nĩ ũkombo wa naĩ ũetae kĩkw’ũ, kana ethĩwa nĩ ũkombo wa kwĩw’a ũetae ũlũngalu? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.16",
            "verseOrgIds": [
              "ROM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũvea wĩthĩwe kwa Ngai, nũndũ, yĩla mwaĩ ngombo sya naĩ, nimweewie kuma ngoonĩ mũthemba wa momanyĩsyo asu ala mweekĩiwe nthĩnĩ wamo; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.17",
            "verseOrgIds": [
              "ROM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.32"
              },
              "items": [
                {
                  "text": "Yoa 8.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũthaĩtw’e kuma nainĩ, mwatw’ĩka ngombo sya ũlũngalu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.18",
            "verseOrgIds": [
              "ROM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩneena o tondũ andũ maneenaa nũndũ wa ũvũthũ wa mĩĩ yenyu: o ũndũ mweenenganie mamutha menyu methĩwe ngombo sya kwĩka ũvuku na ũthũku kũendeea ũthũkunĩ, o ta ũu yu, ĩnenganei mamutha menyu methĩwe ngombo sya ũlũngalu kũvika kũvathĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.19",
            "verseOrgIds": [
              "ROM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ yĩla mwaĩ ngombo sya naĩ, mwaĩ athasye ngalĩ ĩla ya ũlũngalu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.20",
            "verseOrgIds": [
              "ROM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
