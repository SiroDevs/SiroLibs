              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.1"
              },
              "items": [
                {
                  "text": "2 Ako 8.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.2"
              },
              "items": [
                {
                  "text": "9.2",
                  "type": "text"
