            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩmwĩsũva mũno, ana‐a‐asa, kwondũ wa Mwĩaĩi waitũ Yesũ Klĩsto, na kwondũ wa wendo wa ũla Veva, kana mwĩthing’ĩĩsye vamwe nakwa mboyanĩ syenyu kwa Ngai kwondũ wakwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ndangĩĩwe nyie kwa ala matew’aa ma Yutia, na nĩ kana ũthũkũmi wakwa ũla nĩ naw’o Yelusaleme wĩtĩkĩlĩke kwa atheu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana nĩũka kwenyu na ũtanu kwondũ wa kwenda kwa Ngai, na kwona ũthũmũo vamwe nenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ngai wa mũuo nĩethĩwe vamwe nenyu inyw’onthe. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.33",
            "verseOrgIds": [
              "ROM.15.33"
            ]
          }
        }
