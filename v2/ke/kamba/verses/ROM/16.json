                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaio mũthokya wakwa, na wa ĩkanisa yonthe, nĩwamũkethya. Elasito, ũla mũsũvĩi wa mbesa sya ndũa, nĩwamũkethya, na Kwalito mwana‐a‐asa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        },
