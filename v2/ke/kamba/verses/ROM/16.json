              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyie Telitio, ũla waandĩka valũa ũũ, nĩngũmũkethya nthĩnĩ wa Mwĩatĩ. ",
          "type": "text",
          "attrs": {
