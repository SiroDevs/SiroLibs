        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.116.11"
              },
              "items": [
                {
                  "text": "Sav 116.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.4"
              },
              "items": [
                {
                  "text": "51.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiee, kũikethĩwe ũu: nĩkũmanyĩke Ngai nĩ wa w’o, ĩndĩ kĩla mũndũ nĩ mũkengani; o tondũ kũandĩkĩtwe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        }
      ]
