            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩ vata mũno na nzĩa syonthe: mbee nĩ kũĩkĩĩĩka na ndeto ila syaneeniwe nĩ Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.2",
            "verseOrgIds": [
              "ROM.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
