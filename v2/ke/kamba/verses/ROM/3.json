              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwĩkathĩĩa kũĩva ĩndĩ? Nĩ kũvingĩe nza. Kwondũ wa mwĩao wa mũthemba mwaũ? Wa meko? Aiee: ĩndĩ nũndũ wa mwĩao wa mũĩkĩĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.27",
            "verseOrgIds": [
              "ROM.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.16"
              },
              "items": [
                {
                  "text": "Aka 2.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩtũkwona ĩndĩ kana mũndũ atalĩlwa ũlũngalu kwondũ wa kũĩkĩĩa vate meko ma ĩla mĩao. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.28",
            "verseOrgIds": [
              "ROM.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 3:29"
          },
          "items": [
