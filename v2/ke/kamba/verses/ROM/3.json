                  "text": "Aev 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla Ngai wambie ũmwia ethĩwe nthembo ya wĩw’anĩthyo, kwondũ wa mũĩkĩĩo nthakamenĩ yake, kwonan’ya ũlũngalu wake nũndũ wa kũkĩla naĩ ila syeekiwe tene, nũndũ wa wũmĩĩsyo wa Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.25",
            "verseOrgIds": [
              "ROM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
