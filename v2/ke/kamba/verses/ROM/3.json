                  "text": "2 Tim 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nata ĩndĩ o na ethĩwa amwe matyaĩ na mũĩkĩĩo? Kũlea kwĩtĩkĩla kwoo kũkatw’ĩkĩthya kĩthito kya Ngai ta kĩte na ũtonyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.3",
            "verseOrgIds": [
              "ROM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 3:4"
          },
          "items": [
