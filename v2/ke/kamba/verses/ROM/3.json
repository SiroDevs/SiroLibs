          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kwonan’ya ũlũngalu wake ĩvinda yĩĩ: nĩ kana ethĩwe mũlũngalu we mwene, na ĩngĩ ethĩwe mũnengani wa ũlũngalu kwa ũla ũmwĩtĩkĩlaa Yesũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.26",
            "verseOrgIds": [
              "ROM.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 3:27"
          },
          "items": [
