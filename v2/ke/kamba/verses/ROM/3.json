              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ onthe nĩmeekie naĩ, na maivikĩaa ũtaĩo wa Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.23",
            "verseOrgIds": [
