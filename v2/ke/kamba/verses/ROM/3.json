            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kũtalĩlwa ũlũngalu mana nĩ mumo wake kwondũ wa wovosyo ũla wĩ nthĩnĩ wa Klĩsto Yesũ: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.24",
            "verseOrgIds": [
              "ROM.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 3:25"
          },
          "items": [
