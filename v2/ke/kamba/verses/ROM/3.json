                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu ũlũngalu wa Ngai nĩwumĩlĩtw’e vate mĩao, naw’o ũkũsĩĩwe nĩ ĩla mĩao na athani; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.21",
            "verseOrgIds": [
              "ROM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "naw’o nĩ ũlũngalu wa Ngai ũla wosawa ũndũ wa kũĩkĩĩa Yesũ Klĩsto kwa onthe ala metĩkĩlaa; nũndũ kũi kĩvathũkan’yo; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.22",
            "verseOrgIds": [
              "ROM.3.22"
            ]
          }
        },
        {
