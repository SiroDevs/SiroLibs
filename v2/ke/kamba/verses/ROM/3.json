              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.16"
              },
              "items": [
                {
                  "text": "Aka 2.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ kwondũ wa meko ma ĩla mĩao vai mũndũ ũkatalĩlwa ũlũngalu mbee wake; nũndũ ũmanyi wa naĩ wũkaa kwondũ wa ĩla mĩao.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.20",
