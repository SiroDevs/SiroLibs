                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethĩwa nĩ w’o Ngai nĩ ũmwe, na akamatalĩla ũlũngalu ala ma nzaĩko kwondũ wa kũĩkĩĩa, na ala mate ma nzaĩko kwondũ wa ũla mũĩkĩĩo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.30",
            "verseOrgIds": [
              "ROM.3.30"
            ]
          }
