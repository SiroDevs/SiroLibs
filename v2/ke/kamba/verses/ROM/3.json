              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.12"
              },
              "items": [
                {
                  "text": "Alo 10.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana Ngai nĩ Ngai wa Ayuti oka? Ti Ngai wa Andũ‐ma‐mbaĩ‐ingĩ nao? Ĩĩ, nĩ wa Andũ‐ma‐mbaĩ‐ingĩ nao: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.29",
            "verseOrgIds": [
              "ROM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
