                "loc": "PHP.2.10"
              },
              "items": [
                {
                  "text": "Avi 2.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩkũandĩkĩtwe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.11",
            "verseOrgIds": [
              "ROM.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
