              },
              "items": [
                {
                  "text": "1 Ako 8.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ we ũla wĩ na mũĩkĩĩo mũnini mwĩtĩkĩlei, ĩndĩ ti kwa kũkananĩa maũndũ ala me nzika. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.1",
            "verseOrgIds": [
              "ROM.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.29"
              },
              "items": [
                {
                  "text": "Mwa 1.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.9.3"
              },
              "items": [
                {
                  "text": "9.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũmwe e na mũĩkĩĩo wa kũya lĩu wa mĩthemba yonthe: ĩndĩ ũla mũvũthũ aĩsaa lĩu wa mũũndanĩ w’oka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.2",
            "verseOrgIds": [
              "ROM.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.16"
              },
              "items": [
                {
                  "text": "Ako 2.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũĩsaa ndakamũvũthye ũla ũtaĩsaa; na ũla ũtaĩsaa nake ndakamũsilĩle ũsu ũĩsaa: nũndũ Ngai nũmwĩtĩkĩlĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.3",
            "verseOrgIds": [
              "ROM.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.1"
              },
              "items": [
                {
                  "text": "Mt 7.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.11"
              },
              "items": [
                {
                  "text": "Yak 4.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "We wĩ ũũ ũsilĩlaa mũthũkũmi wa ũngĩ? Kwa vwana wake mwene nũnũkũũngama kana nũnũũvalũka. Ni w’o, akaũngamw’a; nũndũ Mwĩaĩi e na vinya wa kũmũũngamya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.4",
            "verseOrgIds": [
              "ROM.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.10"
              },
              "items": [
                {
                  "text": "Aka 4.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũmwe nũtaĩaa mũthenya ũmwe kwi ũngĩ: mũndũ ũngĩ ataĩaa mĩthenya yonthe ũndũ ũmwe. Kĩla mũndũ namanyĩthw’e vyũ kĩlĩkonĩ kyake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.5",
            "verseOrgIds": [
              "ROM.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũsũvĩaa mũthenya, asũvĩaa kwondũ wa Mwĩaĩi: na ũla ũĩsaa, aĩsaa kwa Mwĩaĩi, nũndũ nũmũtũngĩaa Ngai mũvea; na ũla ũlea kũya, kwa Mwĩaĩi ndaĩsaa, na amũnengae Ngai mũvea. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.6",
            "verseOrgIds": [
              "ROM.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ vai ũmwe wa ithyĩ wĩkalaa thayũ kwondũ wake mwene, o na vai ũla ũkusaa kwondũ wake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.7",
            "verseOrgIds": [
              "ROM.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.20"
              },
              "items": [
                {
                  "text": "Aka 2.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.10"
              },
              "items": [
                {
                  "text": "1 Ath 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.38"
              },
              "items": [
                {
                  "text": "Lk 20.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ethĩwa nĩtũkwĩkala thayũ, twĩĩkala kwondũ wa Mwĩaĩi; kana ethĩwa nĩtũũkw’a, twĩkw’a kwondũ wa Mwĩaĩi: kwondũ wa ũu ethĩwa twĩĩkala thayũ, kana ethĩwa nĩ kũkw’a, twĩ ma Mwĩaĩi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.8",
            "verseOrgIds": [
              "ROM.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwondũ wa ũu Klĩsto nĩwakwie na eethĩwa thayũ ĩngĩ, nĩ kana ethĩwe Mwĩaĩi wa ala akw’ũ na wa ala me thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.9",
            "verseOrgIds": [
              "ROM.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.31"
              },
              "items": [
                {
                  "text": "Meko 17.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.10"
              },
              "items": [
                {
                  "text": "2 Ako 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.31"
              },
              "items": [
                {
                  "text": "Mt 25.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ we, wĩsilĩla mwana‐a‐au nũndũ wa ki? Kana ĩngĩ we, wĩvũthĩsya mwana‐a‐au kĩ? Nũndũ ithyonthe tũkaũngama mbee wa kĩvĩla kya sila kya Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.10",
            "verseOrgIds": [
              "ROM.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.23"
              },
              "items": [
                {
                  "text": "Isa 45.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.18"
