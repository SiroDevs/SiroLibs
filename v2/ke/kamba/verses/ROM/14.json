            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.12",
            "verseOrgIds": [
              "ROM.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ĩndĩ kũikethĩwe ĩngĩ kũsilĩlana ithyĩ kwa ithyĩ: ĩndĩ nĩkwaĩle mũsile ũũ, kana mũndũ ndakamwiĩe mwana‐a‐ĩthe kya ũmũlulutĩkya, kana kya ũmũvalũkya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.13",
            "verseOrgIds": [
              "ROM.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.11"
              },
              "items": [
                {
                  "text": "Mt 15.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.15"
              },
              "items": [
                {
                  "text": "Meko 10.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.15"
              },
              "items": [
                {
                  "text": "Tito 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩsĩ, na ndi na nzika nthĩnĩ wa Mwĩaĩi Yesũ, kana vai kĩndũ kĩvuku ũndũ wakyo kyoka: ate o kwa ũla wonaa kĩndũ nĩ kĩvuku, kwa ũsu kĩndũ kyu nĩ kĩvuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.14",
            "verseOrgIds": [
              "ROM.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.11+1CO.8.12+1CO.8.13"
              },
              "items": [
                {
                  "text": "1 Ako 8.11–13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mwana‐a‐au eew’a woo kwondũ wa lĩu waku, ndũendaa ĩngĩ wendonĩ. Ndũkamwanange na lĩu waku ũla Klĩsto wakwie kwondũ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.15",
            "verseOrgIds": [
              "ROM.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.5"
              },
              "items": [
                {
                  "text": "Tito 2.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkatume ĩndĩ ũseo waku ũwetwa naĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.16",
            "verseOrgIds": [
              "ROM.14.16"
            ]
          }
        },
