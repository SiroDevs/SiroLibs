                "loc": "EZR.1.1+EZR.1.2+EZR.1.3"
              },
              "items": [
                {
                  "text": "Esa 1.1–3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.2.20"
              },
              "items": [
                {
                  "text": "Nee 2.20",
