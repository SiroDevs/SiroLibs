                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
