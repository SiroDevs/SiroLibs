        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ yĩla wumĩĩsyo wa valũa wa mũsumbĩ Alitasasita wasomewe vala ve Leumu na mũandĩki Simisai, na atindan’ya moo, nĩmamaendee Ayuti ku Yelusaleme mĩtũkĩ, na mamaekethya kwa ũng’endu na vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wĩa wa nyũmba ya Ngai ĩla yĩ Yelusaleme waekiwe; na waekiwe kũvika mwaka wa kelĩ wa kũsumbĩka kwa Ndalio mũsumbĩ wa Velisia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.24",
            "verseOrgIds": [
              "EZR.4.24"
            ]
          }
        }
