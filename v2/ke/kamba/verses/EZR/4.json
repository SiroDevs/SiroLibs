                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ andũ ma ĩ nthĩ monzethisye moko ma andũ ma Yuta, na mamathĩn’ya makyaka, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na maandĩka atai, masiĩĩe ũndũ mendaa kwĩka, mĩthenya yonthe ya Kulusi mũsumbĩ wa Velisia, o na kũvika kũsumbĩka kwa Ndalio mũsumbĩ wa Velisia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũsumbĩkanĩ kwa Aasuelo, wambĩlĩlyonĩ wa kũsumbĩka kwake, nĩmaandĩkie ndeto sya kũmavinganĩsya ala matwĩe Yuta na Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.1"
              },
              "items": [
                {
                  "text": "Est 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
