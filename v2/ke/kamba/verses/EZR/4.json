              },
              "items": [
                {
                  "text": "19.37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ syamũthengeeie Nzeluvaveli, na atongoi ma nyũmba sya aaĩthe, na syamea, Twake vamwe nenyu; nũndũ nĩtũmanthaa Ngai wenyu, o tondũ mwĩkaa; na nĩtũmũthembeaa kuma mĩthenya ya Esali‐atoni mũsumbĩ wa Asuli, ũla watũetie vaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Nzeluvaveli, na Yesua, na ala angĩ ma atongoi ma nyũmba sya aaĩthe ma Isilaeli, masyĩa, Mũti ũndũ naitũ tũkĩmwakĩa Ngai waitũ nyũmba; ĩndĩ ithyĩ ene vamwe tũkamwakĩa Yeova, Ngai wa Isilaeli, o tondũ Kulusi mũsumbĩ wa Velisia watwĩaĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
