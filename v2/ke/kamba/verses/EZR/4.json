              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ yĩla nthũ sya Yuta na Mbenyamini syeewie ana ma ala matavĩtwe nĩmeũmwakĩa Yeova, Ngai wa Isilaeli, ĩkalũ; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
