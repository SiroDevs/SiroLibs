          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũikua vetha na thaavu, ũla mũsumbĩ na atai make mamumĩsye na ngoo ya kwenda Ngai wa Isilaeli ũla ũtũo wake wĩ Yelusaleme, ",
          "type": "text",
          "attrs": {
