          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana wa Nzelaia, mwana wa Usisi, mwana wa Mbuki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
