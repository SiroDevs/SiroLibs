          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwambata Yelusaleme amwe ma ana ma Isilaeli, na ma athembi, na Alivai, na aini, na asũvĩi ma mĩomonĩ, na Anethini, mwaka wa mũonza wa kũsumbĩka kwa mũsumbĩ Alitasasita. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
