              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana wa Amalia, mwana wa Asalia, mwana wa Melaiothi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
