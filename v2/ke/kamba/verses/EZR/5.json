              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ĩtina wa aaĩthe maitũ mamũthatya Ngai wa ĩtunĩ, nĩwamanenganie kw’okonĩ kwa Nevukatilesa mũsumbĩ wa Mbaviloni, Mũkalitei, ũla wanangie nyũmba ĩno, na amatwaa andũ Mbaviloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.1"
              },
              "items": [
                {
                  "text": "Esa 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mwaka wa mbee wa kũsumbĩka kwa Kulusi mũsumbĩ wa Mbaviloni, mũsumbĩ Kulusi nĩwatwie ũtw’ĩo kana nyũmba ĩno ya Ngai ĩtũngĩĩwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.7"
              },
              "items": [
                {
                  "text": "Esa 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.5"
              },
              "items": [
                {
                  "text": "6.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na mĩio ya thaavu na vetha ya nyũmba ya Ngai, ĩla Nevukatilesa waumisye ĩkalũnĩ yĩla yaĩ Yelusaleme, na amĩete ĩkalũni ya Mbaviloni, ĩsu mũsumbĩ Kulusi aumya ĩkalũnĩ ya Mbaviloni, na yanengwa mũndũ ũmwe ũla wetawa syĩtwa yake Sesivasali, ũla wamũtw’ĩkĩthisye ngavana; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.14",
            "verseOrgIds": [
              "EZR.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na amwĩa, Osa mĩio ĩno, ũende, ũmĩkĩe ĩkalũnĩ yĩla yĩ Yelusaleme, na nyũmba ya Ngai ĩtũngĩĩwe vandũ vayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.15",
            "verseOrgIds": [
              "EZR.5.15"
            ]
          }
        },
