            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyũmba ĩsu yathela mũthenya wa katatũ wa mwei wa Atali ũla waĩ mwakanĩ wa thanthatũ wa kũsumbĩka kwa mũsumbĩ Ndalio. ",
          "type": "text",
          "attrs": {
