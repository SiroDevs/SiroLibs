                "loc": "2KI.17.6"
              },
              "items": [
                {
                  "text": "2 Asu 17.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa mbee wa kũsumbĩka kwa mũsumbĩ Kulusi, mũsumbĩ Kulusi nĩwatwie ũtw’ĩo wa atĩĩ: Ũndũ wa nyũmba ya Ngai Yelusaleme, nyũmba nĩkatũngĩĩwe, vandũ va kũthembeaa nthembo, na myambĩlĩlyo yayo ĩkwatwe yĩ vinya; ũtũlu wayo mĩkono mĩongo thanthatũ, na ũthanthau wayo mĩkono mĩongo thanthatũ; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        },
        {
