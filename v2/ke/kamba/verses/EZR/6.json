              "items": [
                {
                  "text": "1 Asu 6.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.4",
            "verseOrgIds": [
              "EZR.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na mĩio ya thaavu na vetha ya nyũmba ya Ngai, ĩla Nevukatilesa waumisye ĩkalũnĩ yĩla yĩ Yelusaleme, na amĩete Mbaviloni, ĩtũngwe, ĩtwawe ĩngĩ ĩkalũnĩ yĩla yĩ Yelusaleme, kĩla ũmwe vandũ vaw’o; naku ũkamĩkĩe nyũmbanĩ ya Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        },
        {
