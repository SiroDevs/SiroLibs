              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa ĩkũmi na ĩtano wa kũsumbĩka kwa Amasia mwana wa Yoasi mũsumbĩ wa Yuta, Yelovoamu mwana wa Yoasi mũsumbĩ wa Isilaeli ambĩlĩlya kũsumbĩka Samalia, na asumbĩka myaka mĩongo ĩna na ũmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
