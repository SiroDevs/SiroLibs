              "2KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aĩ wa myaka mĩongo ĩlĩ na ĩtano yĩla wambĩlĩlye kũsumbĩka; na asumbĩka myaka mĩongo ĩlĩ na kenda Yelusaleme: na syĩtwa ya inyia wake eetawa Yeoatini wa ku Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.2",
            "verseOrgIds": [
              "2KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eekaa ũla Yeova wonaa wĩ ũseo, ĩndĩ ti ta Ndaviti ĩthe wake: nĩwekaa kwĩanana na w’onthe ũla Yoasi ĩthe wake wekaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kũla kũndũ kũtũlu kũtyaavetwa: andũ mĩmathembaa na kũtoeeasya ũvani kũla kũndũ kũtũlu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.3"
              },
              "items": [
                {
                  "text": "2 Asu 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, o yĩla ũsumbĩ walũlũmĩlw’e kw’okonĩ kwake, ooaa athũkũmi make ala mooaie mũsumbĩ ĩthe wake: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.5",
            "verseOrgIds": [
              "2KI.14.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.3"
              },
              "items": [
                {
                  "text": "2 Asu 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.5",
            "verseOrgIds": [
              "2KI.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ syana sya oaani asu ndaasyũaa; kwĩanana na ũla ũandĩkĩtwe ĩvukunĩ ya mĩao ya Mose, o tondũ Yeova weaie, akyasya, Aaithe matikoaawe kwondũ wa syana, o na syana itikoaawe kwondũ wa aaĩthe; ĩndĩ kĩla mũndũ akusae kwondũ wa naĩ yake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.16"
              },
              "items": [
                {
                  "text": "Kũt 24.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.30"
              },
              "items": [
                {
                  "text": "Yel 31.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.20"
              },
              "items": [
                {
                  "text": "Esek 18.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩwoaĩe andũ ma Etomu ngili ĩkũmi Kyandanĩ kya Mũnyũ, na akwata ĩvia ya Sela na kaũ, na eeta syĩtwa yayo Yokitheeli, kũvika ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.25.11"
              },
              "items": [
                {
                  "text": "2 Mav 25.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Amasia watũmie atũmwa kwa Yeoasi, mwana wa Yeoaasi mwana wa Yeu, mũsumbĩ wa Isilaeli, akĩmwĩa, Ũka, twonane ũthyũ kwa ũthyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.8",
            "verseOrgIds": [
              "2KI.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.25.17+2CH.25.18+2CH.25.19+2CH.25.20+2CH.25.21+2CH.25.22+2CH.25.23+2CH.25.24"
              },
              "items": [
                {
                  "text": "2 Mav 25.17–24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.8",
            "verseOrgIds": [
              "2KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeoasi mũsumbĩ wa Isilaeli atũmana kwa Amasia mũsumbĩ wa Yuta, akyasya, Thangila ũla waĩ Levanoni watũmana kwa mũkũũ ũla waĩ Levanoni, ũkyasya, Mũnenge mwana wakwa mwĩĩtu waku ethĩwe mũka wake; na nyamũ mbai ĩla yaĩ Levanoni yavĩta, na yakinyanga ũla thangila. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.9",
            "verseOrgIds": [
              "2KI.14.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.8+JDG.9.9+JDG.9.10+JDG.9.11+JDG.9.12+JDG.9.13+JDG.9.14+JDG.9.15"
              },
              "items": [
                {
                  "text": "Asi 9.8–15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.9",
            "verseOrgIds": [
              "2KI.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ w’o, nũkũnĩte Etomu, na ngoo yaku nĩnĩkũkĩlĩtye: ĩkathĩĩe ũndũnĩ ũsu, nokĩkala kwaku; nũndũ wa kĩ ĩndĩ ũkwĩlikya maũndũnĩ ma kwĩyĩka naĩ, nĩ kana ũvalũke, o we, wĩ na Yuta?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Amasia ndaaĩtĩkĩla kwĩthukĩĩsya. Kwondũ wa ũu Yeoasi mũsumbĩ wa Isilaeli ambata; nake na Amasia mũsumbĩ wa Yuta moonanĩa ũthyũ kwa ũthyũ ku Mbethi‐semesi, ĩla ya Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.11",
            "verseOrgIds": [
              "2KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yuta makũnwa nĩ Isilaeli; na makũka kĩla mũndũ athi ĩeemanĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.12",
            "verseOrgIds": [
              "2KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeoasi mũsumbĩ wa Isilaeli amũkwatĩa Amasia mũsumbĩ wa Yuta, mwana wa Yeoasi mwana wa Aasia, ku Mbethi‐semesi, na avika Yelusaleme, na aomboanga ũvai wa Yelusaleme kuma mbingĩlonĩ ya Evalaimu kũvika mbingĩlonĩ ya kĩkotonĩ, mĩkono maana ana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.13",
            "verseOrgIds": [
              "2KI.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oosa thaavu w’onthe na vetha, na mĩio yonthe ĩla yoonekie nyũmbanĩ ya Yeova, na mothwiinĩ maie ma nyũmba ya mũsumbĩ, o na andũ ma ngwatĩlĩlyo, na asyoka Samalia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.18"
              },
              "items": [
                {
                  "text": "2 Asu 12.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ meko ala angĩ ma Yeoasi ala wekaa, na vinya wake mũnene, na ũndũ wokitie na Amasia mũsumbĩ wa Yuta, ti maandĩke ĩvukunĩ ya maũndũ ma mavinda ma asumbĩ ma Isilaeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.13.12"
              },
              "items": [
                {
                  "text": "2 Asu 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.13.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeoasi akoma na aaĩthe make, na athikwa Samalia vamwe na asumbĩ ma Isilaeli; na Yelovoamu mwana wake asumbĩka vandũ vake.",
          "type": "text",
