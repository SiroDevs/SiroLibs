          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ meko ala angĩ ma Amasia, ti maandĩke ĩvukunĩ ya maũndũ ma mavinda ma asumbĩ ma Yuta? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.18",
            "verseOrgIds": [
              "2KI.14.18"
            ]
          }
        },
        {
