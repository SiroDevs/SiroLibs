          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.19",
            "verseOrgIds": [
              "2KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamũete akuĩtwe nĩ mbalasi; na athikwa Yelusaleme vamwe na aaĩthe make ndũanĩ ya Ndaviti. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.20",
            "verseOrgIds": [
              "2KI.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ onthe ma Yuta moosa Asalia, ũla waĩ wa myaka ĩkũmi na thanthatũ, na mamũtw’ĩkĩthya mũsumbĩ vandũ va ĩthe wake Amasia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.21",
            "verseOrgIds": [
              "2KI.14.21"
            ]
          }
        },
