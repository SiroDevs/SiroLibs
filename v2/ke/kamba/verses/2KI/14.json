          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamũsamĩĩa ku Yelusaleme; na akĩĩa Lakisi: ĩndĩ matũmanie aatĩĩwe ku Lakisi, na mamũaĩa kw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.19",
            "verseOrgIds": [
              "2KI.14.19"
            ]
          }
        },
        {
          "name": "note",
