            "sid": "2KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa kelĩ wa kũsumbĩka kwa Yoasi mwana wa Yoaasi mũsumbĩ wa Isilaeli Amasia mwana wa Yoasi mũsumbĩ wa Yuta ambĩlĩlya kũsumbĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
            "verseOrgIds": [
              "2KI.14.1"
            ]
          }
        },
        {
