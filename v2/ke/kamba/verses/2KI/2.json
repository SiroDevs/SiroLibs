          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu manzĩ mavow’a kũvika ũmũnthĩ, kwĩanana na ndeto ya Elisa ĩla waneenie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        }
      ]
