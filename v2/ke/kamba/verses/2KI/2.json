                "loc": "1KI.18.12"
              },
              "items": [
                {
                  "text": "1 Asu 18.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.39"
              },
              "items": [
                {
                  "text": "Meko 8.39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla mamũingĩĩsye mũvaka eew’a nthoni, asya, Tũmanai. Kwondũ wa ũu matũma andũ mĩongo ĩtano; na mamantha mĩthenya ĩtatũ, ĩndĩ matyaamwona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamũsyokea, yĩla wekalĩte Yeliko; na amea, Ndineemũtavya, Mũtikathi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
