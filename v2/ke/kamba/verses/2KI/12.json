            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kũtyaaseũvw’a kwondũ wa nyũmba ya Yeova ikombe sya vetha, kana mĩkasi, kana masaani manene, kana masoo, kana mĩio o na yĩva ya thaavu, kana mĩio ya vetha, na mbesa ila syaetiwe nyũmbanĩ ya Yeova; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
