                {
                  "text": "1 Asu 7.50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ isu syanengiwe ala matethasya wĩa, na matũngĩĩa nyũmba ya Yeova nasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ĩngĩ matyaatalana na andũ, ala mamanengie mbesa isu kw’okonĩ kwoo mamanenge ala matethasya wĩa; nũndũ matethasya na kĩthito. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
