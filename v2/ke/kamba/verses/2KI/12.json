            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũthembi Yeoiata oosa ĩsandũkũ, na atonya ĩima ngunĩkonĩ yayo, na ayia ũtee wa kĩthembeo, ngalĩ ya kw’oko kwa aũme, vala mũndũ ũlikĩlaa nyũmbanĩ ya Yeova: na athembi ala masũvĩaa me mwalyonĩ meekĩa nthĩnĩ wayo mbesa syonthe ila syaetiwe nyũmbanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.41"
              },
              "items": [
                {
                  "text": "Mko 12.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla moonie kwaĩ mbesa mbingĩ ĩsandũkũnĩ, mũandĩki wa mũsumbĩ na mũthembi mũnene mambata, na meekĩa mbesa ila syoonekie nyũmbanĩ ya Yeova mũvukonĩ na maitala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbesa ila syathimiwe manengane mokonĩ ma ala matethasya wĩa, ala masyaĩĩasya nyũmba ya Yeova: na maĩva aseũvya ma mbwaũ na aki, ala matethasya wĩa nyũmbanĩ ya Yeova, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na aki ma mavia na asũvya ma mavia, na kwondũ wa kũthooa mĩtĩ na mavia masũvye ma kũtũngĩĩa kũndũ kũvũthũku kwa nyũmba ya Yeova, na kwondũ wa syonthe ila syaumiwe sya kũtũngĩĩa nyũmba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
