                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Aasu oosa vetha na thaavu ũla woonekete nyũmbanĩ ya Yeova, na mothwiinĩ maie nyũmbanĩ ya mũsumbĩ, na amũtwaĩa mũsumbĩ wa Asuli wĩthĩwe mũthĩnzĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.18"
              },
              "items": [
                {
                  "text": "2 Asu 12.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ wa Asuli amwĩthukĩĩsya; na mũsumbĩ wa Asuli ambata okite na Ndamasiku, na amĩkwata, na atwaa andũ mayo me atave Kili, na amũaa Lesini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.21"
              },
              "items": [
                {
                  "text": "2 Mav 28.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.5"
              },
              "items": [
                {
                  "text": "Amo 1.5",
                  "type": "text"
                }
              ]
            },
