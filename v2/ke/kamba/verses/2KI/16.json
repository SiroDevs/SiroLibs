            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩu Lesini mũsumbĩ wa Silia atũngĩa Silia mũsyĩ wa Elathi, na alũngya Ayuti ku Elathi; na Asilia mooka Elathi, na matũa kw’o, kũvika ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
