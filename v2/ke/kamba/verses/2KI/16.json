              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Lesini mũsumbĩ wa Silia na Veka mwana wa Lemalia mũsumbĩ wa Isilaeli mambatie Yelusaleme mokite: na mamũthyũlũlũka Aasu mamũtw’ĩkanĩsya, ĩndĩ matyaatonya kũmũkĩlya vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
