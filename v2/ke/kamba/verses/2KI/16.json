            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Aasu athi Ndamasiku akomane na Tikilathi‐vileseli mũsumbĩ wa Asuli, na oona kĩthembeo kĩla kyaĩ Ndamasiku; na mũsumbĩ Aasu amũtwaĩa mũthembi Uliya mwakĩlwe wa kĩthembeo, na ngelekan’yo yakyo, kwĩanana na wĩa w’onthe wakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.2"
              },
              "items": [
                {
                  "text": "Isa 8.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthembi Uliya aaka kĩthembeo: kwĩanana na w’onthe ũla mũsumbĩ Aasu wamũtũmĩe kuma Ndamasiku, now’o mũthembi Uliya wakĩseũvisye eteele kũka kwa mũsumbĩ Aasu kuma Ndamasiku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla mũsumbĩ wokie kuma Ndamasiku, mũsumbĩ oona kĩthembeo: na mũsumbĩ athengeea kĩthembeo, na athemba ĩũlũ wakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na avĩvya nthembo yake ya kũvĩvw’a na nthembo yake ya mũtu, na eta nthembo yake ya kũnyuwa, na aminzangĩsya nthakame ya nthembo syake sya mũuo, ĩũlũ wa kĩthembeo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩthembeo kya ũthuku, kĩla kyaĩ mbee wa Yeova, akyumya ngalĩ ya mbee ya nyũmba, kuma katĩ wa kĩthembeo kyake na nyũmba ya Yeova, na akĩkĩa ngalĩ ya ĩũlũ ya kĩthembeo kyake. ",
