              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aendaa mũendelenĩ w’onthe ũla ĩthe wake waendaa naw’o, na athũkũmaa mĩvw’anano ĩla ĩthe wake wathũkũmaa, na kũmĩthaithaa: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.21",
            "verseOrgIds": [
              "2KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na aeka Yeova, Ngai wa aaĩthe make, na ndaendaa nzĩanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        },
