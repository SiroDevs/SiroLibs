              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ meko ala angĩ ma Amoni ala wekaa, ti maandĩke ĩvukunĩ ya maũndũ ma mavinda ma asumbĩ ma Yuta? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.25",
            "verseOrgIds": [
              "2KI.21.25"
            ]
          }
        },
