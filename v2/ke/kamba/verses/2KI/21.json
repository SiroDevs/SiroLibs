            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ matyaaĩthukĩĩsya: na Manase amasesenga meke ũthũku kũvĩtũka mbaĩ ila Yeova waanangie mbee wa ana ma Isilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
