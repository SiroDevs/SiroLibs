            "number": "11",
            "style": "v",
            "sid": "2KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa Manase mũsumbĩ wa Yuta nĩwĩkĩte mothatyo aa, na nĩwĩkĩte naĩ kwĩ w’onthe ũla Aamoli meekaa, ala maĩ mbee wake, na nũvĩtĩthĩtye o na Yuta ũndũ wa mĩvw’anano yake; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.11",
            "verseOrgIds": [
              "2KI.21.11"
            ]
          }
        },
