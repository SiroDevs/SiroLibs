              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na kanyw’a wa athũkũmi make athani, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
