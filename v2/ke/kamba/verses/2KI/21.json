        },
        {
          "text": "Manase ai wa myaka ĩkũmi na ĩlĩ yĩla wambĩlĩlye kũsumbĩka; na asumbĩka myaka mĩongo ĩtano na ĩtano Yelusaleme; na syĩtwa ya inyia wake eetawa Evisiva. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.1",
            "verseOrgIds": [
              "2KI.21.1"
            ]
          }
        },
