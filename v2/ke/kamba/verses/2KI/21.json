              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni aĩ wa myaka mĩongo ĩlĩ na ĩlĩ yĩla wambĩlĩlye kũsumbĩka; na asumbĩka myaka ĩlĩ Yelusaleme: na syĩtwa ya inyia wake eetawa Mesulemethi mwĩĩtu wa Aalusi wa ku Yotiva. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
