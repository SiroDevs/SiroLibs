          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athũkũmi ma Amoni mamũsamĩa, na mooaĩa ũ mũsumbĩ nyũmbanĩ yake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
              "2KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ andũ ma nthĩ ĩsu mamoaa onthe ala mamũsamĩĩte mũsumbĩ Amoni; na andũ ma nthĩ ĩsu mamũtw’ĩkĩthya Yosia mwana wake mũsumbĩ vandũ vake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.24",
            "verseOrgIds": [
              "2KI.21.24"
            ]
          }
        },
