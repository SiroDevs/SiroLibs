            "number": "8",
            "style": "v",
            "sid": "2KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ilikia mũthembi mũnene amwĩa mũandĩki Savani, Nĩnoona yĩla ĩvuku ya mĩao nyũmbanĩ ya Yeova. Na Ilikia amũnenga Savani yĩla ĩvuku, nake ayĩsoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũandĩki Savani amũkĩa mũsumbĩ, na amũetee mũsumbĩ uvoo, na asya, Athũkũmi maku nĩmatulũlĩte mbesa ila syoonekie nyũmbanĩ, na mainenganĩte kw’okonĩ kwa athũkũmi ala masyaĩĩasya nyũmba ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.9",
            "verseOrgIds": [
              "2KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũandĩki Savani amũtavya mũsumbĩ, akyasya, Mũthembi Ilikia nũnengete ĩvuku. Na Savani ayĩsomea mbee wa mũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla mũsumbĩ waminie kwĩw’a ndeto sya ĩvuku ya mĩao, atembũanga ngũa syake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ eeaia mũthembi Ilikia, na Aikamu mwana wa Savani, na Akivoli mwana wa Mikaia, na mũandĩki Savani, na Asaia mũthũkũmi wa mũsumbĩ, akĩmea, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
