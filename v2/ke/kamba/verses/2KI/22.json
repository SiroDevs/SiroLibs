              },
              "items": [
                {
                  "text": "Kũt 29.25–27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.17",
            "verseOrgIds": [
              "2KI.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũsumbĩ wa Yuta, ũla ũmũtũmie mũkũlye kwa Yeova, ũũ nĩw’o mwĩmwĩa, Ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũkwasya: Ũndũ wa ndeto ila wĩw’ĩte, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.18",
            "verseOrgIds": [
              "2KI.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩkwĩthĩwa ngoo yaku ĩnaĩ mbololo, na weenyivya vala ve Yeova, yĩla ũneewie ũla naneenie ĩũlũ wa vandũ vaa, na ĩũlũ wa andũ ala matwĩe vaa, atĩ makatw’ĩka wanangĩko na kĩumo, na nũtembũangĩte ngũa syaku, na kũĩa mbee wakwa; o nakwa nĩnĩkwĩw’ĩte, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.19",
            "verseOrgIds": [
              "2KI.22.19"
            ]
          }
        },
