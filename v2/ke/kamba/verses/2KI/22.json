            "sid": "2KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eekaa ũla Yeova wonaa wĩ ũseo, na aendaa mũendelenĩ w’onthe wa ĩthe wake Ndaviti, na ndaaathũka ngalĩ ya kw’oko kwa aũme kana kw’oko kwa aka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        }
