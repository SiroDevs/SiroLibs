          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mwaka wa ĩkũmi na nyanya wa kũsumbĩka kwa mũsumbĩ Yosia, mũsumbĩ atũma Savani, mwana wa Asaliia mwana wa Mesulamu, mũandĩki, nyũmbanĩ ya Yeova, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.3",
            "verseOrgIds": [
              "2KI.22.3"
            ]
          }
        },
        {
