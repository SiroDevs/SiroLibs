          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao nĩ aseũvya ma mbwaũ, na aki, na aki ma mavia, na sya kũthooa mĩtĩ na mavia masũvye ma kũtũngĩĩa ĩ nyũmba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.6",
            "verseOrgIds": [
              "2KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ matyaatalana nao ũndũ wa mbesa ila inenganiwe kw’okonĩ kwoo; nũndũ nĩmatethisye na kĩthito. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        },
