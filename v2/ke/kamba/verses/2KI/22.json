          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mainengane kw’okonĩ kwa athũkũmi ala masiasya nyũmba ya Yeova; nao nĩmanenge athũkũmi ala me nyũmbanĩ ya Yeova, sya kũtũngĩĩa kũndũ kũvũthũku kwa nyũmba, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.5",
            "verseOrgIds": [
              "2KI.22.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
