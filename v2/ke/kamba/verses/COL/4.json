                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩkalai mũlũlũmĩle mboyanĩ, voyai mũkĩsyaĩĩsya vamwe na kũtũnga mũvea; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.2",
