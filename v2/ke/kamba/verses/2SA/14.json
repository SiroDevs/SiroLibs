            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ũla mũndũ mũka wa Tekoa waneenie na mũsumbĩ, avalũka nthĩ na ũthyũ wake, na eekunamya vyũ, na amwĩa, Ndethya, ame mũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.4",
            "verseOrgIds": [
              "2SA.14.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.6.26"
              },
              "items": [
                {
                  "text": "2 Asu 6.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.3"
              },
              "items": [
                {
                  "text": "8.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.4",
            "verseOrgIds": [
              "2SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ amũkũlya, Wĩ na ũndũ mwaũ? Nake asũngĩa, Nĩ ndiwa w’o, na mũemewa nĩ mũkw’ũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.5",
            "verseOrgIds": [
              "2SA.14.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.1"
              },
              "items": [
                {
                  "text": "2 Sam 12.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.5",
            "verseOrgIds": [
              "2SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthũkũmi waku mwĩĩtu, aĩ na ana elĩ, na asu elĩ mokita ene kwa ene kĩsesinĩ, na vatyaĩ mũndũ wa kũmatan’ya, ĩndĩ ũmwe akũna ũla ũngĩ, na amũaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.6",
            "verseOrgIds": [
              "2SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, mũvĩa w’onthe nũmũkĩlĩle mũthũkũmi waku mwĩĩtu, na measya, Nengane ũla wakũnie mwana‐a‐inyia, nĩ kana tũmũae vandũ va thayũ wa mwana‐a‐inyia ũla woaie, na ĩndĩ twanange mũtiĩwa nake. O ta ũu makavosya ĩkaa yakwa yĩla yĩtiele, na matikatiĩa mũemewa syĩtwa kana ũtialo ĩũlũ wa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.7",
            "verseOrgIds": [
              "2SA.14.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.7"
              },
              "items": [
                {
                  "text": "Mko 12.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
