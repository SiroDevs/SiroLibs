              "2SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ wasũngĩie na amwĩa mũndũ mũka, Nĩngũkwĩsũva, ndũkambithe ũndũ o na wĩva ũla ngũũkũlya. Na mũndũ mũka amwĩa, Mwĩaĩi wakwa mũsumbĩ naneene yu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ amũkũlya, Kw’oko kwa Yoavu kwĩ naku ũndũnĩ ũũ w’onthe? Na mũndũ mũka asũngĩa na asya, O tondũ kyuu kyaku kĩ thayũ, mwĩaĩi wakwa mũsumbĩ, vati ũla ũtonya kwĩthyũũa kw’okonĩ kwa aũme kana kwa aka kũtia ũndũ o na wĩva ũla mũsumbĩ ũneenete; nũndũ mũthũkũmi waku Yoavu, we nũmbĩaĩe, na eekĩa ndeto isu syonthe kanyw’anĩ wa mũthũkũmi waku mwĩĩtu; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.14.3"
              },
              "items": [
                {
                  "text": "2 Sam 14.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũthũkũmi waku Yoavu nĩwĩkĩte ũu nĩ kana aalyũle ũvoo ũndũ ũilyĩ: na mwĩaĩi wakwa nĩ mũĩ kwĩanana na ũĩ wa mũlaĩka wa Ngai, kũmanya maũndũ onthe ala me kũũ nthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ amwĩa Yoavu, Sisya yu, nĩnĩkĩte ũndũ ũsu: kwondũ wa ũu enda, ũlatye ũ mwanake Avisalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.21",
            "verseOrgIds": [
              "2SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoavu avalũka nthĩ na ũthyũ wake, na eekunamya vyũ, na amũathima mũsumbĩ; na Yoavu asya, Ũmũnthĩ mũthũkũmi waku nĩwĩsĩ nĩnonete ũseo methonĩ maku, mwĩaĩi wakwa, ame mũsumbĩ, nũndũ mũsumbĩ nĩwĩanĩsye ũndũ mũthũkũmi wake ũkũlĩtye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.22",
            "verseOrgIds": [
              "2SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yoavu ookĩla na athi Ngesuli, na aete Avisalomu Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.23",
            "verseOrgIds": [
              "2SA.14.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.38"
              },
              "items": [
                {
                  "text": "2 Sam 13.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.23",
            "verseOrgIds": [
              "2SA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ asya, Naende nyũmba kwake, ĩndĩ ndakone ũthyũ wakwa. Na ĩndĩ Avisalomu aenda nyũmbanĩ kwake, na ndaaona ũthyũ wa mũsumbĩ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ kwa Isilaeli onthe kũtyaĩ ũmwe wa kũtaĩwa mũno ta Avisalomu ũndũ wa mũmbĩlwe wake: kuma ũnyaĩĩ o na kũvika lolotya vatyaĩ kĩema nthĩnĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.25",
            "verseOrgIds": [
              "2SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla wenzaa nzw’ĩĩ sya mũtwe wake (aitilaa mũminũkĩlyo wa kĩla mwaka; nĩkwĩthĩwa syaĩ ngito kwake, kwondũ wa ũu nĩwaitilaa); nĩwathimaa nzw’ĩĩ sya mũtwe wake sekeli maana elĩ, kwĩanana na kĩthimi kya mũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.26",
            "verseOrgIds": [
              "2SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avisalomu asyaa ana atatũ, na mwĩĩtu ũmwe, ũla wetawa syĩtwa yake Tamali: nake aĩ mũndũ mũka wĩ ũthyũ mũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
