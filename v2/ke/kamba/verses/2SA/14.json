        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mũvaka tũkw’e, na tũilyĩ manzĩ metĩku nthĩ, ala matatonya kũkolanw’a ĩngĩ; o na Ngai ndavetaa thayũ, ĩndĩ nũsũanĩaa maũndũ, nĩ kana ũla walũngilw’e ndakethĩwe mũlũngw’a kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.14",
            "verseOrgIds": [
              "2SA.14.14"
            ]
          }
        },
