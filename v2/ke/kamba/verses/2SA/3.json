        },
        {
          "text": "Na kwaĩ kaũ ĩvinda ĩasa wa nyũmba ya Saulo na nyũmba ya Ndaviti: na Ndaviti aendeea kũneneva mũno, ĩndĩ nyũmba ya Saulo yaendeea na kwaa vinya mũno.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        }
      ]
    },
