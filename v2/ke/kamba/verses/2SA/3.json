          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wa thanthatũ nĩ Ithileamu wa Ekila, kĩvetĩ kya Ndaviti. Asu Ndaviti amasyaĩe ku Eviloni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        }
