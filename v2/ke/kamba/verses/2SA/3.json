                "loc": "GEN.43.3"
              },
              "items": [
                {
                  "text": "Mwa 43.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.49"
              },
              "items": [
                {
                  "text": "1 Sam 14.49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.13",
            "verseOrgIds": [
              "2SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti atũma atũmwa kwa Isi‐vosethi, mwana wa Saulo, akĩmwĩa, Nenga mũka wakwa Mikali, ũla neeasĩsye na ikonde sya mbinũ ĩana sya Avilisiti. ",
          "type": "text",
