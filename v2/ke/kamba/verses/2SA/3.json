            "sid": "2SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "aumye ũsumbĩ nyũmbanĩ ya Saulo, na kũũngamya kĩvĩla kya ũsumbĩ kya Ndaviti asumbĩke Isilaeli na Yuta, kuma Ndani o na kũvika Mbeeli‐sieva. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
