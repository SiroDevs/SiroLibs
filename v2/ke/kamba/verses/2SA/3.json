            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na yu ĩndĩ ĩkai ũu; nũndũ Yeova nũneenete ũndũ wa Ndaviti, akyasya, Ngatangĩĩa andũ makwa Isilaeli na kw’oko kwa mũthũkũmi wakwa Ndaviti kũmaumya kw’okonĩ kwa Avilisiti, na kuma kw’okonĩ kwa amaitha moo onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        },
        {
