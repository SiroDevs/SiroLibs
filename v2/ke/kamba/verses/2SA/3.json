                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.22"
              },
              "items": [
                {
                  "text": "1 Asu 2.22",
                  "type": "text"
                }
