              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Avineli wathilĩkile mũno nũndũ wa ndeto sya Isi‐vosethi, na akũlya, Nyie nĩ mũtwe wa ngitĩ ĩsu Yuta? Ũmũnthĩ nĩnĩkaa nyũmba ya Saulo ĩthe waku nesa, na ana‐a‐ĩthe make, na anyanyae make, na ndyaakũnengane kw’okonĩ kwa Ndaviti; ĩndĩ ũmũnthĩ nũũmbilĩĩla ĩvĩtyo ũndũ wa mũndũ mũka ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.43"
              },
              "items": [
                {
                  "text": "1 Sam 17.43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai namwĩke Avineli ũu, o na mbee, ethĩwa ndimwĩka Ndaviti o w’o, o tondũ Yeova wamwĩvĩtĩe Ndaviti; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
