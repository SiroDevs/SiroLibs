              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wa kana nĩ Atoniya mwana wa Akithi; na wa katano nĩ Sevatia mwana wa Avitali; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        },
