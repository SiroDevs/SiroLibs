        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.13",
            "verseOrgIds": [
              "2SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
