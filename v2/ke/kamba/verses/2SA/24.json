          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ngati amũkĩa Ndaviti mũthenya ũsu, na amwĩa, Ambata, ũmwakĩe Yeova kĩthembeo kĩvũĩonĩ kya Alauna Mũyevusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.18",
            "verseOrgIds": [
              "2SA.24.18"
            ]
          }
        },
        {
          "name": "note",
