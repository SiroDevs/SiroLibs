              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.19",
            "verseOrgIds": [
              "2SA.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athũkũmi ma Avisalomu mamũkĩa ũ mũndũ mũka nyũmbanĩ; na makũlya, Aimaasĩ na Yonathani maĩva? Na mũndũ mũka amea, Nĩmaingie kalũsĩ ke manzĩ. Na yĩla mamamanthie na malea kũmona, masyoka Yelusaleme.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.20",
            "verseOrgIds": [
              "2SA.17.20"
            ]
          }
        }
      ]
