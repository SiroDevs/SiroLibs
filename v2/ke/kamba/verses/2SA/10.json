                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.3"
              },
              "items": [
                {
                  "text": "2 Sam 8.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.6",
            "verseOrgIds": [
              "2SA.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Ndaviti wewie ũu, atũma Yoavu, na nguthu yonthe ya ngũmbaũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.7",
            "verseOrgIds": [
              "2SA.10.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.8"
              },
              "items": [
                {
                  "text": "2 Sam 23.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.7",
            "verseOrgIds": [
              "2SA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Amimoni maumaala, na mataũsya ita mokitĩe ũlikĩlonĩ mbingĩlonĩ: na Asilia ma Sova na ma Leovu, na andũ ma Tovu na Maaka, maĩ kĩsesinĩ me oka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Yoavu wonie kana nĩmetaũĩtye mokite nake mbee na ĩtina, anyuva amwe ma andũ onthe anyuve ma Isilaeli, na amataũsya mokite na Asilia: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.9",
            "verseOrgIds": [
              "2SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na andũ ala angĩ amaia kw’okonĩ kwa Avisai mwana‐a‐inyia: na amataũsya mokite na ana ma Amimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.10",
            "verseOrgIds": [
              "2SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asya, Ethĩwa Asilia me vinya kwĩ nyie, nĩvo wĩndethya; ĩndĩ ethĩwa ana ma Amimoni me vinya kwĩ we, nĩvo nĩũka na ngĩũtethya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.11",
            "verseOrgIds": [
              "2SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩwa na ũkũmbaũ mũnene, na twĩthĩwe aũme kwondũ wa andũ maitũ, na kwondũ wa ndũa sya Ngai waitũ: na Yeova nĩeke ũndũ ũnũkwona wĩ ũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.18"
              },
              "items": [
                {
                  "text": "1 Sam 3.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.13"
              },
              "items": [
                {
                  "text": "1 Ako 16.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yoavu na andũ ala maĩ nake mathengeea mokite na Asilia kaũnĩ: nao makũka mamũkĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.13",
            "verseOrgIds": [
              "2SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ana ma Amimoni moonie kana Asilia nĩmakĩa, nao o ta ũu makĩa Avisai, na malĩka ndũanĩ. Na ĩndĩ Yoavu asyoka kuma vala ve ana ma Amimoni, na ooka Yelusaleme.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Asilia moonie kana nĩmakũiwe nĩ Isilaeli, moombana vamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.15",
            "verseOrgIds": [
              "2SA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ataleseli atũmana, kũetwe Asilia ala maĩ mũingo wa ũla Ũsĩ: na mooka Eelamu, me na Sovaki kavuteni wa nguthu ya Ataleseli amatongoesye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.16",
            "verseOrgIds": [
              "2SA.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti atavw’a; na oomban’ya Isilaeli onthe vamwe, na mainga Yolotani, na mavika Eelamu. Na Asilia meetaũsya mokite na Ndaviti, na mokita nake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.17",
            "verseOrgIds": [
              "2SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Asilia makũka makĩa Isilaeli; na Ndaviti ooaa Asilia andũ ma makasya ngili mũonza, na andũ ala matũlaa mbalasi ngili mĩongo ĩna, na amũkũna Sovaki kavuteni wa nguthu yoo, na akw’ĩa kw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.18",
            "verseOrgIds": [
              "2SA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla asumbĩ onthe ala maĩ athũkũmi ma Ataleseli moonie kana nĩmakũwa nĩ Isilaeli, maseũvya mũuo na Isilaeli, na mamathũkũma. Na ĩndĩ Asilia makĩa kũtethya ana ma Amimoni ĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    }
  ],
