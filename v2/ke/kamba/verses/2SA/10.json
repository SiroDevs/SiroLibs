              "type": "tag",
              "attrs": {
                "loc": "JDG.11.3"
              },
              "items": [
                {
                  "text": "Asi 11.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.28"
