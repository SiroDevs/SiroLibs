                {
                  "text": "Kũt 13.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.16"
              },
              "items": [
                {
                  "text": "1 Asu 12.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu andũ onthe ma Isilaeli mambata maeka kũatĩĩa Ndaviti, na maatĩĩa Sieva mwana wa Mbikili, ĩndĩ andũ ma Yuta malũman’ya na mũsumbĩ woo, kuma Yolotani kũvika Yelusaleme.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
