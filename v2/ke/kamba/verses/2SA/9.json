          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eekunamya vyũ, na asya, Mũthũkũmi waku nĩ mwaũ, ũndũ ũũsisya ngitĩ ngw’ũ takwa?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        }
      ]
