              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ wamwĩtie Nziva, mũthũkũmi wa Saulo, na amwĩa, Kyonthe kya Saulo na kya nyũmba yake yonthe nĩnĩnengete mwana wa vwana waku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkamũĩmĩaa mĩũnda, we, na ana maku, na athũkũmi maku; na ũkaetae mosyao, nĩ kana mwana wa vwana waku ethĩawe na lĩu wa ũya: ĩndĩ Mevivosethi mwana wa vwana waku akaĩsaa lĩu ĩndĩ yonthe mesanĩ yakwa. Na ĩndĩ Nzĩva aĩ na ana ĩkũmi na atano na athũkũmi mĩongo ĩlĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.17"
              },
              "items": [
                {
                  "text": "2 Sam 19.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Nziva wamwĩie mũsumbĩ, O kwĩanana na w’onthe ũla mwĩaĩi wakwa mũsumbĩ ũnũũmwĩaĩa mũthũkũmi wake, now’o mũthũkũmi wakũ ũkekaa. Ĩndĩ ũndũ wa Mevivosethi, mũsumbi asya, akaĩsaa mesanĩ yakwa ta ũmwe wa ana ma mũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mevivosethi aĩ na kamwana kala keetawa syĩtwa yako Mika. Na onthe ala mekalaa nyũmbanĩ ya Nziva maĩ athũkũmi ma Mevivosethi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
            "verseOrgIds": [
              "2SA.9.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.8.34"
              },
              "items": [
                {
                  "text": "1 Mav 8.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
            "verseOrgIds": [
              "2SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Mevivosethi atũa Yelusaleme; nũndũ aĩsaa mavinda onthe mesanĩ ya mũsumbĩ. Na nĩwaĩte maũũ make elĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.13",
            "verseOrgIds": [
              "2SA.9.13"
            ]
          }
        },
