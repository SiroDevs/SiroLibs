              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ akũlya, Vatyĩthĩwa ũmwe wa nyũmba ya Saulo, nĩ kana nĩmwĩke ũseo wa Ngaĩ? Na Nziva amwĩa mũsumbĩ, Yonathani e na mwana, waie maũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
