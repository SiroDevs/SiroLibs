              "2SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ andũ masya, Ndũkathi: nũndũ ethĩwa tũkakĩa, matikatũsũanĩa; o na ethĩwa nyunzu yaitũ ĩkakw’a, matikatũsũanĩa: ĩndĩ we wĩ vata ta ngili ĩkũmi maitũ; kwondũ wa ũu nĩ kavaa wĩthĩwe wĩyũmbanĩtye kũtũtethasya wĩ ndũanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.3",
            "verseOrgIds": [
              "2SA.18.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.21.17"
              },
              "items": [
                {
                  "text": "2 Sam 21.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.3",
            "verseOrgIds": [
              "2SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ amea, O ũndũ mwĩona wĩ ũseo mbee now’o nĩĩka. Na mũsumbĩ aũngama ũtee wa mbingĩlo, na andũ onthe maumaala maana na maana na ngili na ngili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ eeaĩa Yoavu na Avisai na Itai, akĩmea, Mũsũvĩei ũ mwanake, o Avisalomu, kwondũ wakwa. Na andũ onthe meew’a yĩla mũsumbĩ weaĩe makavuteni onthe ũndũ wa Avisalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.18.12"
              },
              "items": [
                {
                  "text": "2 Sam 18.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ andũ maumaala maenda kĩthekanĩ mokite na Isilaeli: na kaũ waĩ mũtitũnĩ wa Evalaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.6",
            "verseOrgIds": [
              "2SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ ma Isilaeli makũnĩwa kw’o nĩ athũkũmi ma Ndaviti, na kwaĩ ũai mũnene kw’o mũthenya ũsu wa andũ ngili mĩongo ĩlĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.7",
            "verseOrgIds": [
              "2SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kaũ nĩwanyaĩĩkĩe ku ĩũlũ wa nthĩ yonthe; na mũtitũ wamina andũ aingĩ kwĩ ala maminiwe na ũvyũ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avisalomu esa kũkomana na athũkũmi ma Ndaviti. Na Avisalomu aendete akuĩtwe nĩ nyũmbũ yake, na nyũmbũ yavĩtĩla ungu wa mbonge nthungu sya mũtĩ wa mwaloni mũnene, na mũtwe wake wakwatwa nĩ mwaloni, na ookĩlw’a ĩũlũ wa nthĩ; na nyũmbũ ĩla yaĩ ungu wake yathi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.9",
            "verseOrgIds": [
              "2SA.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ ũmwe oona ũu, na atavya Yoavu, na amwĩa, Sisya, nĩnonie Avisalomu aniinĩte mwaloninĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.10",
            "verseOrgIds": [
              "2SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoavu atavya mũndũ ũla wamũtavisye, Na, sisya, nĩwonie ũu, na nĩkĩ ũtanamũkũnĩa vau akavalũka nthĩ? Nakwa nĩthĩwa nakũnenga ilungu ĩkũmĩ sya vetha, na mũsivi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.11",
            "verseOrgIds": [
              "2SA.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũ mũndũ amwĩa Yoavu, O na ethĩwa ngoona ĩlungu ngili sya vetha kw’okonĩ, ndyĩtĩkĩla kũmũtambũũkĩa mwana wa mũsumbĩ kw’oko kwakwa: nũndũ mũsumbĩ eaĩe we na Avisai na Itai tũkĩw’a, akĩmwĩa, Ĩsũvĩei mũndũ o na wĩva ndakakiite ũ mwanake Avisalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.12",
            "verseOrgIds": [
              "2SA.18.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.18.5"
              },
              "items": [
                {
                  "text": "2 Sam 18.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.12",
            "verseOrgIds": [
              "2SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keka ũu, kethĩwa nĩkie ũndũ ũte wa w’o ĩũlũ wa thayũ wake (na vati ũvoo ũvithĩtwe mũsumbĩ), we mwene wĩthĩwa ũngalyũkĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.13",
            "verseOrgIds": [
              "2SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Yoavu waisye, Nditonya kwĩkalanga naku ta ũu. Nake oosa tũtumo tũtatũ na kw’oko kwake, na atũtonyethya ngoonĩ ya Avisalomu mũkuthũ, e o thayũ vu mwaloninĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.14",
            "verseOrgIds": [
              "2SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anake ĩkũmi ala makuaa mĩio ya kaũ ya Yoavu mamwĩlingĩla na mamũkũna Avisalomu, mamũaa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
