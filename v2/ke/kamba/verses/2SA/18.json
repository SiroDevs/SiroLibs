            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Aimaasi mwana wa Nzatoki asya, Eka nzembe yu, na kũmũtwaĩa mũsumbĩ ũvoo, ũndũ Yeova ũmũĩvanĩsye kwa amaitha make. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
