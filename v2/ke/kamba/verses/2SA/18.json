                "loc": "JOS.7.26"
              },
              "items": [
                {
                  "text": "Yos 7.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avisalomu yĩla waĩ thayũ aĩ anosa na kwĩũngamĩsya kĩtuĩ, kĩla kĩ mwandanĩ wa mũsumbĩ; nũndũ aisye, Ndi na mwana wa kwĩkalya syĩtwa yakwa yĩlilikenwe: na eeta kĩtuĩ na syĩtwa yake mwene; na nĩkĩtawa ũlilikan’yo wa Avisalomu, kũvika ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
