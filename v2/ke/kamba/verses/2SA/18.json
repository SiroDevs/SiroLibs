            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ atelema mũno, na ambata kasũmbanĩ ke mbingĩlonĩ ĩũlũ, na aĩa: na aendete, aasya atĩĩ, We mwana wakwa Avisalomu, mwana wakwa, mwana wakwa Avisalomu! Nenda kethĩwa ninyie ngwie vandũ vaku, we Avisalomu, mwana wakwa, mwana wakwa!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
        }
