                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malilikan’ye maũndũ asu, ũkĩmeaĩa mbee wa Mwĩaĩi, maikethĩwe na ngananĩo sya ndeto, ila ite na kĩndũ imoneaa, na imaasya ala mew’aa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.14",
            "verseOrgIds": [
              "2TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
