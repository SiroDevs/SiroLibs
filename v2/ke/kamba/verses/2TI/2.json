                "loc": "EPH.3.1"
              },
              "items": [
                {
                  "text": "Aev 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
