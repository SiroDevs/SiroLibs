            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngombo ya Mwĩaĩi ndyaĩlwe nĩ ũkandanĩa, ĩndĩ nĩyaĩle kwĩthĩwa ĩ nduu kwa andũ onthe, ĩ na ũtonyi wa kũmanyĩsya, ĩ na wũmĩĩsyo: ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.24",
            "verseOrgIds": [
              "2TI.2.24"
            ]
          }
        },
        {
          "name": "verse",
