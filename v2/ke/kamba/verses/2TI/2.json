                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ lea mokũlyo ma ũtumanu na ala mate na ũmanyi, ũkĩmanya kana maetae ngandanĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.23",
            "verseOrgIds": [
              "2TI.2.23"
            ]
