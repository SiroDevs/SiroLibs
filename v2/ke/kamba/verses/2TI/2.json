                  "text": "2 Tim 3.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa ĩndĩ mũndũ etheasya kwa asu, akeethĩwa e mũio wa kwona ndaĩa, ũvathĩtwe ethĩwe mũtheu, waĩle wĩa wa Mwĩaĩi, ũseũvĩtw’e kwa kĩla wĩa mũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.21",
            "verseOrgIds": [
              "2TI.2.21"
            ]
          }
        },
        {
