                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.1.12+PHP.1.13+PHP.1.14"
              },
              "items": [
                {
                  "text": "Avi 1.12–14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.17"
              },
              "items": [
                {
                  "text": "2.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla kwondũ waw’o nĩthĩnaw’a kũvika kwovwa, ta mwĩki wa naĩ; ĩndĩ ndeto ya Ngai ndyovawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.9",
            "verseOrgIds": [
              "2TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.24"
              },
              "items": [
                {
                  "text": "Ako 1.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nũmĩĩasya maũndũ onthe nũndũ wa ala anyuve, nĩ kana nao mose ũtangĩĩo ũla wĩ nthĩnĩ wa Klĩsto Yesũ vamwe na ũtaĩo wa tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        }
      ]
    },
    {
