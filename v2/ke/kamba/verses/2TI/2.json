                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kĩa mĩmeo ya wana, na ũkĩatĩĩa ũlũngalu, na mũĩkũo, na wendo, na mũuo, vamwe na ala mamwĩkaĩlaa Mwĩaĩi na ngoo ntheu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.22",
            "verseOrgIds": [
              "2TI.2.22"
            ]
          }
        },
        {
