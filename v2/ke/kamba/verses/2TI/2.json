              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩkĩmataa na ũuu ala akananĩi; no kwĩthĩwa Ngai emanenga ũalyũlo wa ngoo kũvika ũmanyi wa ũla w’o, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.25",
            "verseOrgIds": [
              "2TI.2.25"
            ]
          }
        },
        {
