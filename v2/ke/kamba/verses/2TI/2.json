            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.12"
              },
              "items": [
                {
                  "text": "2 Sam 7.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũlilikane Yesũ Klĩsto, ũla wathayũũkie kuma akw’ũnĩ, ũla waĩ wa ũsyao wa Ndaviti, kwĩanana na ũvoo mũseo wakwa: ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
