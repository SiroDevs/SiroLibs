        {
          "text": "Alesanda ũla mũtwii wa ũthuku nĩwambĩkie ũthũku mwingĩ: Mwĩaĩi akamũĩva kwĩanana na mawĩa make: ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "naku mwĩsũvĩe mũno; nũndũ nĩwasiĩĩe mũno ndeto sitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
