        },
        {
          "text": "Nĩkwĩaĩa mbee wa Ngai, na mbee wa Klĩsto Yesũ, ũla ũkasilĩla ala me thayũ na ala akw’ũ, o na ĩngĩ ũndũ wa kumĩla kwake na ũsumbĩ wake: ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.1",
            "verseOrgIds": [
              "2TI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 4:2"
          },
          "items": [
