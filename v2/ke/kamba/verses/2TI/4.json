              "items": [
                {
                  "text": "Ũvu 2.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuma yu nĩniĩwe ngovia ya ũsumbĩ ya ũlũngalu, nayo Mwĩaĩi, mũsili ũla mũlũngalu, akanenga mũthenya ũsu; na ti nyie nyioka, ĩndĩ andũ onthe nao ala mendaa kumĩlw’a kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
            ]
          }
        }
