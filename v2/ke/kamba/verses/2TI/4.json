              "type": "text"
            }
          ]
        },
        {
          "text": "Elasito ekalile Kolintho: ĩndĩ Telovimo namũtiie Mileto e mũwau. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.20",
