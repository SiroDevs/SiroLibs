                "loc": "COL.4.10"
              },
              "items": [
                {
                  "text": "Ako 4.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "No Luka e weka nĩ nake. Mwose Maliko wũke nake kũũ; nũndũ nĩ na vata nake wianĩ wa ũthũkũmi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
              "2TI.4.11"
            ]
          }
        },
