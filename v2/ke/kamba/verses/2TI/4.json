                "loc": "ACT.20.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "tavan’ya ĩla ndeto; ĩthĩwa wĩ mũthangaau ĩvinda yaĩle, na yĩla yĩtaĩle; onan’ya mavĩtyo, kan’ya, taa, na wũmĩĩsyo w’onthe na kũmanyĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.2",
            "verseOrgIds": [
              "2TI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 4:3"
          },
          "items": [
