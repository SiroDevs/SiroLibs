            "number": "13",
            "style": "v",
            "sid": "2TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngũa ya ĩũlũ ĩla natiie na Kalivo nthĩ ya Teloa, wĩete ũyũka, vamwe na ala mavuku, na mũno mbee ũka na ala ma mbũa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
            "verseOrgIds": [
              "2TI.4.13"
            ]
          }
        },
