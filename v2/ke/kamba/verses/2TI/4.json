            }
          ]
        },
        {
          "text": "Thangaaa kũka kwakwa na mĩtũkĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.9",
            "verseOrgIds": [
              "2TI.4.9"
