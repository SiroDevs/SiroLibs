              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.5"
              },
              "items": [
                {
                  "text": "2 Tim 2.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.12"
              },
              "items": [
                {
                  "text": "Yak 1.12",
                  "type": "text"
                }
