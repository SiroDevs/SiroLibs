                  "text": "Ako 4.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ Ndema nĩwandiie, endie nthĩ ĩno ya ĩvinda yĩĩ, na anaendie Thesalonika; na Keliseke anaendie Kalatia, na Tito anaendie Ndalamatia. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
            "verseOrgIds": [
              "2TI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 4:11"
          },
          "items": [
