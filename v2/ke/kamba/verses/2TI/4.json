              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũsũngĩo wakwa wa mbee vai mũndũ waũngamie vamwe nakwa, ĩndĩ onthe nĩmandiie; maikaatalĩlwe ũndũ ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.16",
            "verseOrgIds": [
              "2TI.4.16"
            ]
          }
        },
