            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.4",
            "verseOrgIds": [
              "1KI.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akoma too ĩtina wa mũtĩ wa mũlutemu; na, sisya, mũlaĩka amũkiita, na amwĩa, Ũkĩla ũye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asisya, na, kaĩ, kwaĩ kamũtũ kakaangĩwe makaanĩ, o na sũva wa manzĩ mũtwenĩ wake. Na aya na anyw’a, na akoma ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.6",
            "verseOrgIds": [
              "1KI.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka wa Yeova ooka ĩngĩ ya kelĩ, na amũkiita, na amwĩa, Ũkĩla ũye, nũndũ kyalo nĩ kĩvĩtũku vinya waku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
              "1KI.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ookĩla, na aya na anyw’a, na aenda na vĩnya wa lĩu ũsu mĩthenya mĩongo ĩna na matukũ mĩongo ĩna kũvika Olevu kĩĩma kya Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
