              "1KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ waisye, Ũmwe nũnũkwasya, Kaa nĩ kana kakwa kala ke thayũ, na kana kaku nĩ kala kakw’ũ: na ũla ũngĩ nũnũkwasya, Aiee; ĩndĩ kana kaku nĩ kala kakw’ũ, na kana kakwa nĩ kala ke thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.23",
            "verseOrgIds": [
              "1KI.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ asya, Ndeteei ũvyũ. Na maete ũvyũ vala ve mũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.24",
            "verseOrgIds": [
              "1KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ asya, Atũanĩlyai katĩ kana kala ke thayũ, na nengai ũmwe nyunzu, na ũla ũngĩ nyunzu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mũndũ mũka ũla kana kake ke thayũ aneena na mũsumbĩ, nũndũ ngoo yake yeew’ĩe kana kake ĩnee, na asya, Ame, mwĩaĩi wakwa, mũnenge kana kala ke thayũ, na ndũkakoae nongi. Ĩndĩ ũla ũngĩ asya, Katikethĩwa kakwa kana kaku; katũanw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
