              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mũsumbĩ asũngĩa asya, Mũnengei kana kala ke thayũ, na mũtikakoae nongi: nĩwe inyia wako. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.27",
            "verseOrgIds": [
              "1KI.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isilaeli onthe meew’a sila ũla mũsumbĩ wasilile; na mamũkĩa mũsumbĩ: nũndũ nĩmoonie ũĩ wa Ngai waĩ nthĩnĩ wake, asilae katĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.28",
            "verseOrgIds": [
              "1KI.3.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
