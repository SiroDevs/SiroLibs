        },
        {
          "text": "Na akalaata, na aumya kĩtambaa kya mũtwe methoni make; na mũsumbĩ wa Isilaeli amũmanya atĩ nĩ ũmwe wa athani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.41",
            "verseOrgIds": [
              "1KI.20.41"
            ]
          }
        },
