                {
                  "text": "1 Asu 13.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wonie mũndũ ũngĩ, na amwĩa, Ngũna, nĩngũkwĩsũva. Na mũndũ ũsu amũkũna, o kũmũkũna na kũmũkita. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.37",
            "verseOrgIds": [
              "1KI.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mwathani athi, na amweteela mũsumbĩ ũtee wa nzĩa, na eeyũlan’ya kwa kwĩvw’ĩka metho na kĩtambaa kya mũtwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.38",
            "verseOrgIds": [
              "1KI.20.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.8"
              },
              "items": [
                {
                  "text": "1 Sam 28.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.38",
            "verseOrgIds": [
              "1KI.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ akĩvĩta, amwĩkaĩla mũsumbĩ; na asya, Mũthũkũmi waku nĩwaumaalile aenda kaũnĩ katĩ; na, sisya, mũndũ aathũkĩla ũtee, na andetee mũndũ, na ambĩa, Sũvĩa mũndũ ũũ: ethĩwa kwondũ wa ũndũ o na wĩva, akaaa, nĩvo ĩndĩ thayũ waku wĩĩthĩwa vandũ va thayũ wake, kana ethĩwa ti ũu ũkaĩva talendi ya vetha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.39",
            "verseOrgIds": [
              "1KI.20.39"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
