          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wamwĩie, Nĩkwĩthĩwa ndũnew’a wasya wa Yeova, sisya, o wauma vaa nĩĩ, mũnyambũ nũkũaa. Na o auma vala waĩ, mũnyambũ wamwona, na wamũaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        },
        {
