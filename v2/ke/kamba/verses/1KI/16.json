          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa mĩongo ĩlĩ na mũonza wa kũsumbĩka kwa Asa mũsumbĩ wa Yuta Nzimili asumbĩka mĩthenya mũonza ku Tilisa. Na ĩndĩ andũ maĩ manamba maeema moo mataũĩĩe Ngivethoni, ĩla yaĩ ya Avilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.15",
            "verseOrgIds": [
              "1KI.16.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.27"
              },
              "items": [
                {
                  "text": "1 Asu 15.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.15",
            "verseOrgIds": [
              "1KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ ala maĩ mwakonĩ wa maeema meew’a kũkyaw’a, Nzimili nũnamũsamĩe, o na nũnamũaie mũsumbĩ: kwondũ wa ũu Isilaeli onthe mũthenya ũsu mamũtw’a Omili, kavuteni wa nguthu, mũsumbĩ wa Isilaeli me ku mwakonĩ wa maeema. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.16",
            "verseOrgIds": [
              "1KI.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Omili ambata kuma Ngivethoni, na Isilaeli onthe vamwe nake, na mathyũlũlũka Tilisa mamĩtw’ĩkanĩsye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.17",
            "verseOrgIds": [
              "1KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
