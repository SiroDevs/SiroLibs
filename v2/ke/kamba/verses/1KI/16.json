                "loc": "2CH.19.2"
              },
              "items": [
                {
                  "text": "19.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
