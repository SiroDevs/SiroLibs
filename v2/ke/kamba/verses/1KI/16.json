            "number": "2",
            "style": "v",
            "sid": "1KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa nĩnakũkĩlilye kuma kĩtoonĩ, na nakũtw’ĩkĩthya mũnene wĩ mbee ũsumbĩnĩ wa andũ makwa Isilaeli, naku nũendete na mũendele wa Yelovoamu, na wamavĩtĩthya andũ makwa Isilaeli, ũkĩnthatya na naĩ syoo; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.2",
            "verseOrgIds": [
              "1KI.16.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
