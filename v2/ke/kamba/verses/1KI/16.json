              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ wa naĩ syake ila wavitisye akĩka ũla Yeova wonaa wĩ ũthũku, kwondũ wa kũthi mũendelenĩ wa Yelovoamu, na naĩnĩ yake ĩla wekaa, amavĩtĩthye Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.19",
            "verseOrgIds": [
              "1KI.16.19"
            ]
          }
        },
