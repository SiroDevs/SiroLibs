              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu ĩndĩ umya mwĩao mandemee mĩtĩ ya mĩkũũ ku Levanoni; na athũkũmi makwa makeethĩwa vamwe na athũkũmi maku; na ngakũĩva kwondũ wa athũkũmi maku kwĩanana na w’onthe ũla ũkaneena: nũndũ nĩwĩsĩ vati ũmwe katĩ waitũ ũla wĩsĩ kũtema mĩtĩ ta Asitoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla Ilamu wewie ndeto sya Solomoni, atana mũno, na asya, Yeova nataĩwe ũmũnthĩ, ũla ũmũnengete Ndaviti mwana mũĩ asumbĩke andũ aa aingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ilamu atũmana kwa Solomoni, akĩmwĩa, Nĩnĩw’ĩte ũvoo ũla wandũmĩe: ngeeka kwenda kwaku kw’onthe kwondũ wa mĩtĩ ya mĩkũũ, na kwondũ wa mĩtĩ ya mĩsonovali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athũkũmi makwa makamĩete kuma Levanoni kũvika ũkanganĩ; na ngamyovan’ya vamwe ĩthambĩĩle ũkanganĩ vandũ vala wĩmbatha, na ngamĩthaĩsya vo, naku ũkamyosa; na wĩĩanĩsya kwenda kwakwa, ũkĩnengane lĩu wa andũ ma nyũmba yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.7"
              },
              "items": [
                {
                  "text": "Esa 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.20"
              },
              "items": [
                {
                  "text": "Meko 12.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Ilamu amũnenga Solomoni mĩtĩ ya mĩkũũ na mĩtĩ ya mĩsonovali o kwĩanana na kwenda kwake kw’onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Solomoni anenga Ilamu ithimi ngili mĩongo ĩlĩ sya nganũ kwondũ wa lĩu wa andũ ma nyũmba yake, na ithimi mĩongo ĩlĩ sya mauta matheu: ũu nĩw’o Solomoni wanengae Ilamu kĩla mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova anenga Solomoni ũĩ, o tondũ wamwathie; na kwaĩ mũuo katĩ wa Ilamu na Solomoni; na asu elĩ nĩmaseũvĩtye wĩw’ano vamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
