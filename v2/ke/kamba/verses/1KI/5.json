              "items": [
                {
                  "text": "1 Mav 22.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, nĩngũsũanĩa kwaka nyũmba kwondũ wa syĩtwa ya Yeova Ngai wakwa, o tondũ Yeova waneenie na Ndaviti ĩthe wakwa, akĩmwĩa, Mwana waku ũla ngekalya kĩvĩlanĩ kyaku kya ũsumbĩ vandũ vaku, nĩwe ũkaka ĩ nyũmba kwondũ wa syĩtwa yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.13"
              },
              "items": [
                {
                  "text": "2 Sam 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.10"
              },
              "items": [
                {
                  "text": "1 Mav 22.10",
