          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Solomoni aumya kwa Isilaeli onthe andũ ma kũtethethw’a wĩa; na ala maumĩthiw’e maĩ andũ ngili mĩongo ĩtatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
