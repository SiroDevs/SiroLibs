          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "eka anene ma kwa Solomoni ala maĩ aũngamĩi ma wĩa, ngili itatũ na maana atatũ, ala masumbĩkie andũ ala matethasya wĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        },
        {
