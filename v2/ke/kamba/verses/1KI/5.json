            "sid": "1KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu Yeova Ngai wakwa nũnthũmũĩtye ngalĩ syonthe; vati nthũ, kana ũndũ ũthũku wĩkĩkaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.4"
            ]
          }
        },
        {
          "name": "note",
