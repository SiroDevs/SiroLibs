          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ kwookĩla mũsumbĩ ũngĩ Misili, ũla ũtamwĩsĩ Yosevu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.8",
            "verseOrgIds": [
