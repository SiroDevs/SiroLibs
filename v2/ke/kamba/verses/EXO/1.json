              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mamaiĩa aũngamĩi nĩ kana mamathĩn’ye na mĩio yoo. Nao mamwakĩa Valao ndũa sya kwia mĩio, Vithomu na Lamesesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.11",
            "verseOrgIds": [
              "EXO.1.11"
            ]
