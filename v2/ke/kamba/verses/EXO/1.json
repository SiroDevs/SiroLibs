            "sid": "EXO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Amĩsili mamathũkũmĩthya ana ma Isilaeli na vinya mũno: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.13",
            "verseOrgIds": [
              "EXO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na meekĩa ũũ mathayũnĩ moo kwondũ wa ũthũkũmi wi vinya, wa ndaka, na wa mavali, na wĩa w’onthe wa mĩũndanĩ, ũthũkũmi woo w’onthe ũla mamathũkũmĩthisye na vinya mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
