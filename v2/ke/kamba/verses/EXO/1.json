              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na masyĩtwa ma ana ma Isilaeli ala malikile Misili nĩmo aa (o kĩla mũndũ na andũ ma nyũmba yake mookie na Yakovo): ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.23+GEN.35.24+GEN.35.25+GEN.35.26"
              },
              "items": [
                {
                  "text": "Mwa 35.23–26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leuveni, na Sĩmeoni, na Livai, na Yuta, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.2",
            "verseOrgIds": [
              "EXO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Isakali, na Nzevuluni, na Mbenyamini, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.3",
            "verseOrgIds": [
              "EXO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ndani, na Navitali, na Ngati, na Aseli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.4",
            "verseOrgIds": [
              "EXO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ onthe ala maumie kĩnyunyunĩ kya Yakovo maĩ andũ mĩongo mũonza: nake Yosevu aĩ o ku Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
