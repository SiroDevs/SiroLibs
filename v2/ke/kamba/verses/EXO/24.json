                {
                  "text": "Kũt 31.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.4",
            "verseOrgIds": [
              "EXO.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atũma anake ma ana ma Isilaeli, ala mathembie nthembo sya kũvĩvw’a, na kũthembea Yeova nthembo sya mũuo sya ng’ombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.5",
            "verseOrgIds": [
              "EXO.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose oosa nyunzu ya ĩla nthakame, na amĩkĩa masaaninĩ manene; na nyunzu ya nthakame aminzangĩsya kĩthembeonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.6",
            "verseOrgIds": [
              "EXO.24.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.18"
              },
              "items": [
                {
                  "text": "Aevl 9.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.6",
            "verseOrgIds": [
              "EXO.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oosa ĩvuku ya ũtianĩo, na asoma andũ makĩw’a: namo masya, Tũkekaa onthe ala Yeova ũneenete, na kwĩkalaa twĩ ewi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.7",
            "verseOrgIds": [
              "EXO.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose oosa ĩla nthakame, na aminzangĩsya andũ, na amea, Sisyai nthakame ya ũtianĩo, ũla Yeova ũtianĩĩte nenyu ũndũ wa ndeto ii syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        },
