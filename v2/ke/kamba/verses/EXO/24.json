          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndaailĩĩla kw’oko kwake anene me ndaĩa ma ana ma Isilaeli: namo mamwona Ngai, na maya na manyw’a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        }
