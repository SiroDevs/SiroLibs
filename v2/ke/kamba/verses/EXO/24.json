                "loc": "GEN.28.18"
              },
              "items": [
                {
                  "text": "Mwa 28.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.31.45"
              },
              "items": [
                {
                  "text": "31.45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.9"
