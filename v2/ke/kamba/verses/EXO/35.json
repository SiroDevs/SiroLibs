          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla wĩkalo, na ĩeema yaw’o, na kĩla kyaw’o kya kũvw’ĩka, na tũvoloi twaw’o, na mbwaũ syaw’o, na mĩamba yaw’o, na ituĩ syaw’o, na iĩndĩ syaw’o; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.11",
            "verseOrgIds": [
              "EXO.35.11"
            ]
          }
        },
