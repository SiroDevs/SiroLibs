              "EXO.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose amea ana ma Isilaeli, Sisya, Yeova nũmũwetete na syĩtwa yake Mbesaleli, mwana wa Ulĩ, mwana wa Uulu, wa mbaĩ ya Yuta; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.1+EXO.31.2+EXO.31.3+EXO.31.4+EXO.31.5+EXO.31.6"
              },
              "items": [
                {
                  "text": "Kuma 31.1–6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na amusũĩtye Veva wa Ngai, ũĩnĩ, na ũmanyinĩ, na ũmanyĩsyonĩ, na wĩanĩ wa mĩthemba yonthe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũmantha kwĩka mawĩa ma ũĩ, nĩ kana aseũvye thaavu, na vetha, na ũthuku, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kwasũvya tũvila twa kwĩkĩwa nthĩnĩ wa syĩndũ, na kwasũvya mbwaũ, o na kũthethya mawĩa ma ũĩ ma mĩthemba yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩwĩkĩĩte ngoonĩ yake nĩ kana amanyĩsye, we, o na Ooliavu, mwana wa Aisamaki, wa mbaĩ ya Ndani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
