              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose aneena na ũmbano w’onthe wa ana ma Isilaeli, akĩwĩa, Ũũ nĩw’o ũla Yeova wĩaĩte, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.1"
              },
              "items": [
                {
                  "text": "Kuma 25.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumĩsyei Yeova nthembo kuma kwenyu; o ũla wĩ na ngoo ya kwenda, namĩete, nthembo ya Yeova: thaavu, na vetha, na ũthuku, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.2+EXO.25.3+EXO.25.4+EXO.25.5+EXO.25.6+EXO.25.7"
              },
              "items": [
                {
                  "text": "Kuma 25.2–7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na langi wa vuluu, na ũla ũtilyĩ ta mũtune, na ũla mũtune mũno, na katane nzeo, na maw’ĩa ma mbũi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mbũa sya ndũũme syĩkĩĩtwe langi mũtune, na mbũa sya vomboo, na mĩtĩ ya mũea, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mauta ma kwakan’ya taa, na mĩtĩ ĩla ĩnyungaa nesa kwondũ wa mauta ma kwĩtĩkĩsya, na kwondũ wa ũvani ũla ũnyungaa nesa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na tũvila twa nzumalati, na tũvila twa kũlũmanĩthw’a iĩndĩnĩ syatw’o, evotinĩ na kakalonĩ ka kĩthũi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        }
      ]
