              "items": [
                {
                  "text": "Kuma 31.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
