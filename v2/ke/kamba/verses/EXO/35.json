              "attrs": {
                "loc": "EXO.34.32"
              },
              "items": [
                {
                  "text": "Kuma 34.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩthenya thanthatũ wĩa ũkatethaw’e; ĩndĩ mũthenya wa mũonza kũkeethĩwa kwenyu mũthenya mũtheu, o savato wa ũthũmũo mũuu kwa Yeova: o ũla wĩtethya wĩa o na wĩva nthĩnĩ waw’o mũvaka oawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
