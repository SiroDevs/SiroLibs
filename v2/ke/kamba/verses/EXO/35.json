            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose oomban’ya ũmbano w’onthe wa ana ma Isilaeli, na awĩa, Ii nĩsyo ndeto ila Yeova wĩaĩte, nĩ kana mũsyĩkae. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
