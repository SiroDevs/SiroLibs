          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaie kĩla kĩthembeo kya nthembo ya kũvĩvw’a ngalĩ ya mbee ya mũomo wa ũla wĩkalo wa ĩeema ya kũmbanĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.6",
            "verseOrgIds": [
              "EXO.40.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
