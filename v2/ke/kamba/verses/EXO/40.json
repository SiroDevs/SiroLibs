        },
        {
          "text": "Nake Mose eeka o ta ũu; kwĩanana na onthe ala Yeova wamwĩaĩe, ũu nĩw’o wekie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        }
      ]
    },
