          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaie kĩla kĩndũ kya kũthambĩaa katĩ wa yĩla ĩeema ya kũmbanĩa na kĩthembeo kyu, na kwĩkĩa manzĩ vo nthĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.7",
            "verseOrgIds": [
              "EXO.40.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
