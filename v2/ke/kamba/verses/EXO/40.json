              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũketĩkĩsye kĩthembeo kya nthembo ya kũvĩvw’a mauta, na mĩio yonthe yakyo, na kũvathan’ya kĩla kĩthembeo kĩthĩwe kĩtheu: na kĩthembeo kĩkeethĩwa kĩtheu mũno vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.10",
            "verseOrgIds": [
              "EXO.40.10"
            ]
          }
        },
