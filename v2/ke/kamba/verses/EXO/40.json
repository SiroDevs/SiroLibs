              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaiie nza ũlingĩlĩte, na kwanĩka ũla tama wa mbingĩlo ya nza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.8",
            "verseOrgIds": [
              "EXO.40.8"
            ]
