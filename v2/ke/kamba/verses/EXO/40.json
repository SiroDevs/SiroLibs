            "number": "2",
            "style": "v",
            "sid": "EXO 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya wa mbee wa mwei wa mbee ũkaũngamye ũla wĩkalo wa ĩeema ya kũmbanĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.2",
            "verseOrgIds": [
