          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aia kĩla kĩndũ kya kũthambĩaa katĩ wa ĩeema ya kũmbanĩa na kĩthembeo kyu, na eekĩa manzĩ nthĩnĩ wakyo, ma kũthamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.30",
            "verseOrgIds": [
              "EXO.40.30"
            ]
          }
        },
