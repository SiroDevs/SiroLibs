              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose ndaatonya kũlika ĩeemanĩ ya kũmbanĩa, nĩkwĩthĩwa ũla mũumbĩ wekalaa ĩũlũ wayo, na ũtheu mũtisu wa Yeova wausũa wĩkalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
              "EXO.40.35"
            ]
          }
        },
