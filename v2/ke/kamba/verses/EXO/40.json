            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkekĩe nthĩnĩ yĩla ĩsandũkũ ya ũkũsĩ, na ũkavw’ĩke ĩsandũkũ yĩu na ũla tũtũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.3",
            "verseOrgIds": [
              "EXO.40.3"
            ]
          }
        },
        {
