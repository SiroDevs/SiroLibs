          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose na Aluni na ana make mathambĩsya moko moo na maũũ moo vo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.31",
            "verseOrgIds": [
              "EXO.40.31"
            ]
          }
        },
