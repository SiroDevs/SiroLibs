                "loc": "NUM.3.2"
              },
              "items": [
                {
                  "text": "Mot 3.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.4"
              },
              "items": [
                {
                  "text": "Aevl 5.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaseũvĩsye Aluni, mwana‐a‐mwenyu, ngũa ntheu, kwondũ wa kũmũtaĩĩthya na kũmwanakavya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.2",
            "verseOrgIds": [
              "EXO.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaneene na onthe ala me na ũĩ ngoonĩ, ala nusũĩtye na veva wa ũĩ, nĩ kana maseũvye ngũa sya Aluni sya ũmũvathan’ya ethĩwe mũtheu, nĩ kana anthũkũmae wĩanĩ wa ũthembi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.3",
            "verseOrgIds": [
              "EXO.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ii nĩsyo ngũa ila metuma: kakalo ka kĩthũi, na evoti, na ngũa ndasa, na kanzũ wa kũngũlũ, na ngutw’a, na mũsivi: na makamaseũvĩsye Aluni mwana‐a‐mwenyu, na ana make, ngũa ntheu, nĩ kana anthũkũmae wĩanĩ wa ũthembi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩmakose ũla thaavu, na ila ndii sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane nzeo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makaseũvye yĩla evoti ya thaavu, na ya ndii sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane nzeo mbokothe, wĩa wa mũtethya wa wĩa ũla mũĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩkethĩwe na ikwatũ ilĩ sya ituonĩ ikwatene na mĩthya ĩlĩ yayo, nĩ kana yĩkwatanw’e vamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.7",
            "verseOrgIds": [
              "EXO.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla mũsivi ũtũmĩtwe na ũĩ, ũla wĩ ĩũlũ wayo, o ũla wa kũyova yĩlũme, ũkaseũvw’e ũndũ ũmwe nayo na wa kĩlungu kĩmwe nayo; wa thaavu, na wa ndii sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane nzeo mbokothe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.8",
            "verseOrgIds": [
              "EXO.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkose tũvila twĩlĩ twa nzumalati, noitũvana masyĩtwa ma ana ma Isilaeli: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.9",
            "verseOrgIds": [
              "EXO.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "masyĩtwa thanthatũ moo kavilanĩ kamwe, na masyĩtwa thanthatũ ala matiala kavilanĩ kala kangĩ, kwĩanana na mosyaanĩo moo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.10",
            "verseOrgIds": [
              "EXO.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkavane tũvila tũu twĩlĩ kwĩanana na wĩa wa mũvani wa tũvila, o ta movano me ngomenĩ ya kũsiĩla, kũatĩĩa masyĩtwa ma ana ma Isilaeli: ũkaseũvye tũlũmanĩthw’e iĩndĩnĩ sya thaavu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.11",
            "verseOrgIds": [
              "EXO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkekĩe tũla tũvila twĩlĩ ikwatũnĩ sya ituo sya evoti, twĩthĩwe tũvila twa ũlilikan’yo kwondũ wa ana ma Isilaeli: na Aluni akakuĩaa masyĩtwa moo vu mbee wa Yeova ituonĩ syake kwondũ wa ũlilikan’yo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaseũvye iĩndĩ sya thaavu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.13",
            "verseOrgIds": [
              "EXO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mĩnyoo ĩlĩ ya thaavu mũtheu; ũkamĩseũvye ta tũkanda, twa wĩa wa kũvĩnda: na ũkekĩe ĩla mĩnyoo mĩvĩnde iĩndĩnĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaseũvye kakalo ka kĩthũi ka kũtw’a sila, wĩa wa mũtethya wa wĩa ũla mũĩ; ũkakaseũvye o ta evoti; ũkakaseũvye ka thaavu, na ka ndii sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane nzeo mbokothe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakethĩwe keanene ngalĩ inya, katũlanĩlwa; ũasa wako ũkeethĩwa wa ĩkwata yĩmwe ya kĩtaa, na ũthanthau wayo ĩkwata yĩmwe ya kĩtaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkekĩe nthĩnĩ wako tũvila tũlũmanĩthw’e iĩndĩnĩ syatw’o, mĩsoa ĩna ya tũvila: mũsoa wa mbee wa salitũ, na tovasi, na alimasi ndune; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.17",
            "verseOrgIds": [
              "EXO.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũsoa wa kelĩ sumalati, na savili, na salitonyi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.18",
            "verseOrgIds": [
              "EXO.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũsoa wa katatũ samawi, na yasimu, na amethusito; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.19",
            "verseOrgIds": [
              "EXO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũsoa wa kana nzumalati ntheu, na nzumalati, na yasivi: tũlũmanĩthw’e na thaavu iĩndĩnĩ syatw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
              "EXO.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tũvila tũu tũkeethĩwa tũkĩatĩĩa masyĩtwa ma ana ma Isilaeli, ĩkũmi na elĩ, kwĩanana na masyĩtwa moo; o ta movano me ngomenĩ ya kũsiĩla, kĩla kamwe kwĩanana na syĩtwa yake, nĩtũkethĩwa kwondũ wa ila mbaĩ ĩkũmi na ilĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaseũvye mĩnyoo ĩtilyĩ tũkanda kakalonĩ ka kĩthũi ĩũlũ, ya thaavu mũtheu wĩ mũvĩnde. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.22",
            "verseOrgIds": [
              "EXO.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaseũvye kakalonĩ ka kĩthũi ĩũlũ ngome ilĩ sya thaavu, na kwĩkĩa ngome isu ilĩ mĩthyanĩ ĩlĩ ya kakalo ka kĩthũi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.23",
            "verseOrgIds": [
              "EXO.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkĩkĩa ĩla mĩnyoo ĩlĩ mĩvĩnde ya thaavu ila ngomenĩ ilĩ ila syĩ mĩthyanĩ ya kakalo ka kĩthũi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.24",
            "verseOrgIds": [
              "EXO.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mĩthya ĩla ĩngĩ ĩlĩ ya ĩla mĩnyoo ĩlĩ mĩvĩnde ũkekĩe ĩũlũ wa ila iĩndĩ ilĩ, na kũkolelya ikwatũnĩ sya ituo sya evoti ngalĩ ya mbee yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.25",
            "verseOrgIds": [
              "EXO.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkatue ngome ilĩ sya thaavu, na ũikolelya mĩthyanĩ ĩlĩ ya kakalo ka kĩthũi, ũtiivonĩ wako, ũla welekele ngalĩ ya nthĩnĩ ya evoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.26",
            "verseOrgIds": [
              "EXO.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkatue ngome ilĩ sya thaavu, na ũikolelya ikwatũnĩ ilĩ sya ituo sya evoti ungu, ngalĩ ya mbee yayo, vakuvĩ na vala vakwatanĩlwe vayo, ĩũlũ wa ũla mũsivi wa evoti ũtumĩtwe na ũĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.27",
            "verseOrgIds": [
              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makalũmanye kakalo ka kĩthũi na ngome syako ngomenĩ sya evoti na ũlii wa vuluu, nĩ kana kethĩwe ĩũlũ wa ũla mũsivi wa evoti ũtumĩtwe na ũĩ, na nĩ kana kala kakalo ka kĩthũi kaikathaw’e yĩla evotinĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Aluni akakuae masyĩtwa ma ana ma Isilaeli kakalonĩ ka kĩthũi ka kũtw’a sila ĩũlũ wa ngoo yake, yĩla wĩvotaa vala vandũ vatheu, kwondũ wa ũlilikan’yo vu mbee wa Yeova ĩndĩ yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkekĩe kakalonĩ ka kĩthũi ka kũtw’a sila Ulimu na Thumimu; nasyo ikeethĩwa ĩũlũ wa ngoo ya Aluni, yĩla wĩvotaa vala ve Yeova: na Aluni akakuĩaa ũsilĩlo wa ana ma Isilaeli ĩũlũ wa ngoo yake vu mbee wa Yeova ĩndĩ yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
