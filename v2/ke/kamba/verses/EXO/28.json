    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku mwĩte Aluni, mwana‐a‐mwenyu, oke vala ũĩ, na ana make vamwe nake, kuma ananĩ ma Isilaeli, nĩ kana anthũkũmae wĩanĩ wa ũthembi, Aluni, o na Natavu, na Aviu, na Eleasali, na Ithamali, ana ma Aluni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
