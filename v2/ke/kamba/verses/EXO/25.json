                "loc": "EXO.35.21"
              },
              "items": [
                {
                  "text": "Kuma 35.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
