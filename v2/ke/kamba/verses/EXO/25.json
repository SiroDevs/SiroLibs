            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Mose, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.1",
            "verseOrgIds": [
              "EXO.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matavye ana ma Isilaeli mambũmbanĩsye nthembo: mũkose nthembo yakwa kwa kĩla mũndũ ũla wĩ na ngoo ya kwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.2",
            "verseOrgIds": [
              "EXO.25.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
