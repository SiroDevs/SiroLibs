        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mĩkasi yakyo, na masaani ma makaa makyo, ikethĩwe sya thaavu mũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩkaseũvw’e kya talendi ya thaavu mũtheu, vamwe na mĩio ĩsu yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
