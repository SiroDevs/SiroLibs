          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aĩthi mooka na mamalũngya; ĩndĩ Mose ookĩla na amatethya, na anyĩthya ndĩthya yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.17",
            "verseOrgIds": [
