              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose eanĩwa nĩ kwĩkala na mũndũ ũsu: na amũnenga Mose Nzivola mwĩĩtu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
            "verseOrgIds": [
              "EXO.2.21"
            ]
