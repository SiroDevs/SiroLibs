                "loc": "EXO.6.20"
              },
              "items": [
                {
                  "text": "Kuma 6.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.59"
              },
              "items": [
                {
                  "text": "Mot 26.59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ mũka ũsu aitava, na asyaa mwana: na oona kana nĩ kana kaseo, akavitha myei ĩtatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.2",
            "verseOrgIds": [
              "EXO.2.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.20"
              },
              "items": [
                {
                  "text": "Meko 7.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.23"
              },
              "items": [
                {
                  "text": "Aevl 11.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.2",
            "verseOrgIds": [
              "EXO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ũtaatonya kũkavithĩkya, akosea kakalawa ka malula na akavaka lami na kĩsia; na eekĩa kala kana nthĩnĩ, na aia makangaanĩ ũtee wa ũsĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.3",
            "verseOrgIds": [
              "EXO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwĩĩtu‐a‐inyia wako aũngama kũasa amanye ũndũ keĩkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.4",
            "verseOrgIds": [
              "EXO.2.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "Kuma 15.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.59"
              },
              "items": [
                {
                  "text": "Mot 26.59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.4",
            "verseOrgIds": [
              "EXO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwĩĩtu wa Valao atheea ũsĩnĩ atuunye; na athũkũmi make eĩtu matambũka ũtee wa ũsĩ; nake oona kakalawa nthĩnĩ wa makangaa, na atũma mũthũkũmi wake mwĩĩtu aete. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.5",
            "verseOrgIds": [
              "EXO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akavingũa, na oona kala kana: na, sisya, kana nĩkaĩaa. Na akew’ĩa ĩnee, na asya, Kaa nĩ kamwe ka ana ma Aevelania. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.6",
            "verseOrgIds": [
              "EXO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mwĩĩtu‐ainyĩa wako akũlya mwĩĩtu wa Valao, Nĩende nĩkwĩtĩe mũei akanĩ ma Aevelania, akũee kana? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.7",
            "verseOrgIds": [
              "EXO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwĩĩtu wa Valao amwia, Enda. Na ũla mwĩĩtu athi, eeta inyia wa kala kana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.8",
            "verseOrgIds": [
              "EXO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwĩĩtu wa Valao amwĩa, Kua kana kaa ũthi nako ũkandee, na ngaũnenga ĩtuvi yaku. Na ũla mũndũ mũka akua kana, na akaea. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.9",
            "verseOrgIds": [
              "EXO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kana keana, na akaete kwa mwĩĩtu wa Valao, na katw’ĩka mwana wake. Na syĩtwa yake amwĩta Mose, na asya, Nĩkwĩthĩwa nĩnamumisye manzĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.21"
              },
              "items": [
                {
                  "text": "Meko 7.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
