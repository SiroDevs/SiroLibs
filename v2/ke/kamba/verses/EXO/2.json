              "type": "text"
            }
          ]
        },
        {
          "text": "Na yila mookie vala Leueli ĩthe woo ũĩ, amakũlya, Ũmũnthĩ mwooka mĩtũkĩ ũũ ata? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        },
