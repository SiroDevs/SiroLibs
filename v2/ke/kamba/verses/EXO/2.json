              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwaenda mũndũ wa nyũmba ya Livai, na amũtwaa mwĩĩtu wa a Livai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
