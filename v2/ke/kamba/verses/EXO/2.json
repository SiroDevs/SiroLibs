          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akũlya eĩtũ make, Na aĩva? Mũtiie mũndũ ũsu nĩkĩ? Mwĩtei, aye lĩu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.20",
            "verseOrgIds": [
              "EXO.2.20"
            ]
          }
        },
        {
          "name": "note",
