            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mĩthenya ĩsũ, yĩla Mose weanie, aenda kwa ana‐a‐ĩthe make, na asisya mĩio yoo: na oona Mũmisili akĩmũkũna Mũevelania, ũmwe wa ana‐a‐ĩthe make. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.23"
              },
              "items": [
                {
                  "text": "Meko 7.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.24"
              },
              "items": [
                {
                  "text": "Aevl 11.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asisya kũũ na kũũ, na yĩla wonĩe atĩ vati mũndũ, amũaa ũla Mũmisili, na amumbĩka kĩthangathĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.12",
            "verseOrgIds": [
              "EXO.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.24"
              },
              "items": [
                {
                  "text": "Meko 7.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.12",
            "verseOrgIds": [
              "EXO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aumaala ũnĩ ũsu, na, sĩsya, andũ elĩ ma Aevelania nĩmokitaa ene kwa ene: na amwĩa ũla ũmũtheie ũngĩ, Wĩmũkũna mũtindan’ya waku nĩkĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.13",
            "verseOrgIds": [
              "EXO.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.14"
              },
              "items": [
                {
                  "text": "Lk 12.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.26+ACT.7.27+ACT.7.28"
              },
              "items": [
                {
                  "text": "Meko 7.26–28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.13",
            "verseOrgIds": [
              "EXO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amũkũlya, Ũla ũkũtw’ĩte mũnene na mũsili ĩũlũ waitũ nũũ? Wĩsũanĩa kũmbũaa, o tondũ ũnamũaie ũla Mũmisili? Na Mose atelema, na asya, Kaĩ ũndũ ũsu nĩ ũmanyĩku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.14",
            "verseOrgIds": [
              "EXO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ yĩla Valao wewie ũndũ ũsu, enda kũmũaa Mose. Ĩndĩ Mose akĩa, auma kwa Valao, na atũa nthĩ ya Mitiani: na ekala nthĩ ũtee wa kĩthima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
