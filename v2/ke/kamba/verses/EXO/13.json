          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkeethĩwa ũvano kwaku kw’okonĩ kwaku, na kwondũ wa ũlilikan’yo katĩ wa metho maku, nĩ kana mwĩao wa Yeova wĩthĩwe kanyw’anĩ waku: nũndũ Yeova akumisye Misili na kw’oko kwĩ vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
