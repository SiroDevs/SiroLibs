              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaũngamye wĩkalo kwĩanana na ngelekan’yo yaw’o ĩla woonew’e kĩĩmanĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
