          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neena yu matũnĩ ma andũ, namo metye kĩla mũndũ mũũme mũtũi wake, na kĩla mũndũ mũka mũtũi wake, mĩio ya wanake ya vetha, na mĩio ya wanake ya thaavu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
        {
