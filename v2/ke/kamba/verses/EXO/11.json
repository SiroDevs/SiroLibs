              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose asya, Ũũ nĩw’o Yeova ũnũkwasya, Ta ũtukũ katĩ ngathi mbĩtĩle Misili katĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.12"
              },
              "items": [
                {
                  "text": "Kuma 12.12",
                  "type": "text"
                }
              ]
