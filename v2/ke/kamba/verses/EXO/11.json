            "number": "7",
            "style": "v",
            "sid": "EXO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kwa ana ma Isilaeli o na ngitĩ ndikamakũnĩa o na ũmwe, mũndũ o na nyamũ: nĩ kana mũmanye ũndũ Yeova ũvathũkanasya katĩ wa Amisili na Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
