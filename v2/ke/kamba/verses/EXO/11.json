              "items": [
                {
                  "text": "Kuma 8.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.21"
              },
              "items": [
                {
                  "text": "Yos 10.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athũkũmi aa onthe maku makatheea moke vala mĩĩ, makĩndulĩlya ndu, makĩmbĩa, Uma vaa, we, na andũ onthe ala maatĩanĩe naku: na ĩtina wa ũu ngauma nĩthi. Na auma kwa Valao e mũthatu mũno.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        }
      ]
    },
