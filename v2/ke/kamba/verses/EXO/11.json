              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Mose, Valao ndakakwĩthukĩĩsya; nĩ kana syama syakwa syongeleke nthĩ ya Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
