              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makithathi onthe nthĩ ya Misili makakw’a, kuma ĩkithathi ya Valao ũla wĩkalĩte kĩvĩlanĩ kya ũsumbĩ, o na kũvika ĩkithathi ya mũthũkũmi mwĩĩtu ũla ũnũũthia; o na makithathi onthe ma indo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa kĩĩo kĩnene nthĩ yonthe ya Misili, o ta kĩla kĩtaaĩthĩwa, o na kĩtakethĩwa ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
        {
