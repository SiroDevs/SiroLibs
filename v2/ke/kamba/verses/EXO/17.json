          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Amaleki mookie, na mokitĩa na Isilaeli ku Levitimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
