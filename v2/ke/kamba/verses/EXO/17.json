                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.6"
              },
              "items": [
                {
                  "text": "1 Sam 30.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Mose, Vĩta we mbee wa andũ, na ũkĩthi na atumĩa amwe ma Isilaeli: na ndata yaku, ĩla wakũnie ũsĩ nayo, ũkue kw’okonĩ kwaku, noithi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.19"
              },
              "items": [
                {
                  "text": "Kuma 7.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, nĩngũũngama ĩvianĩ mbee waku vu Olevu; naku ũkakũne ĩvia, nayo yĩkauma manzĩ, nĩ kana andũ manyw’e. Na Mose eeka ũu atumĩa ma Isilaeli mene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
