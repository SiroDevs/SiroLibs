              },
              "items": [
                {
                  "text": "Kuma 16.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.3",
            "verseOrgIds": [
              "EXO.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose amwĩkaĩla Yeova, akyasya, Nĩĩka andũ aa ata? Makilĩlye kũngima na mavia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
