                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na athembi namo, ala mathengeeaa Yeova, nĩmevathan’ye methĩwe atheu, Yeova ndakese kũmakitya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose amwĩa Yeova, Ala andũ matitonya kwambata kĩĩmanĩ kya Sinai: nũndũ ũnatwĩaĩe, ũitwĩa, Ĩkĩai mĩvaka kũthyũlũlũka kĩĩma, na mũikĩvatha kĩthĩwe kĩtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa, Enda, ũtheee; na ũkambate, we, na Aluni e naku; ĩndĩ athembi na andũ matikeyalĩlye nzĩa mambate kũla kwĩ Yeova, ndakese kũmakitya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.24",
            "verseOrgIds": [
              "EXO.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Mose amatheeea andũ, na amatavya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.25",
            "verseOrgIds": [
              "EXO.19.25"
            ]
          }
