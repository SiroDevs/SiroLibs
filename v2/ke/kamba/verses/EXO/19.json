                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Vet 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Ũvu 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.6"
              },
              "items": [
                {
                  "text": "20.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũkeethĩwa kwakwa ũsumbĩ wa athembĩ, na mbaĩ ntheu. Ndeto ila wĩmatavya ana ma Isilaeli nĩ isu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose ooka, na eeta atumĩa ma andũ, na amavuanĩsya ndeto isu syonthe ila Yeova wamwĩaĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.7",
            "verseOrgIds": [
              "EXO.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.3"
              },
              "items": [
                {
                  "text": "Kuma 24.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.27"
              },
              "items": [
                {
                  "text": "Kũt 5.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.17"
              },
              "items": [
                {
                  "text": "26.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ onthe masũngĩa vamwe, na masya, Onthe ala Yeova ũneenete tũkeeka. Na Mose atũngĩa Yeova ndeto syonthe sya andũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.8",
            "verseOrgIds": [
              "EXO.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.11"
              },
              "items": [
                {
                  "text": "Kũt 4.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.12"
              },
              "items": [
                {
