                  "text": "Kũt 4.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose aumaalya andũ mwakonĩ wa maeema makomane na Ngai; namo maũngama ĩtheo wa kĩĩma. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.17",
