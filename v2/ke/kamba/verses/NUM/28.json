          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kĩlungu kya ĩkũmi ũkathembe kwondũ wa kĩla katũlũme ka tũla tũtũlũme mũonza; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.21",
            "verseOrgIds": [
              "NUM.28.21"
            ]
          }
        },
