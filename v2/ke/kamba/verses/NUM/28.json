          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũkathembe isu o vamwe na nthembo ya kũvĩvw’a ya kĩoko, nayo nĩ nthembo ya kũvĩvw’a ĩtatw’ĩkanaa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.23",
            "verseOrgIds": [
