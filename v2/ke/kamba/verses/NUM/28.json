          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nthenge ĩmwe yĩthĩwe nthembo kwondũ wa naĩ, ya kwĩw’anĩthw’a kwenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.22",
            "verseOrgIds": [
