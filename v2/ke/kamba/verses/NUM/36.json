        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩsu nĩyo mĩao na motw’ĩo ala Yeova weaĩe ana ma Isilaeli na kanyw’a wa Mose ndiĩnĩ sya Moavi vakuvĩ na Yolotani ku Yeliko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.13",
            "verseOrgIds": [
              "NUM.36.13"
            ]
          }
        },
