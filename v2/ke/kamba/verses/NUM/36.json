          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atongoi ma nyũmba sya aaithe ma mũvia wa ana ma Ngileati, mwana wa Makili, mwana wa Manase, ma mĩvĩa ya ana ma Yosevu, mathengeea, na maneena vala ve Mose, na vala ve anene, ala atongoi ma nyũmba sya aaĩthe ma ana ma Isilaeli: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.1",
            "verseOrgIds": [
              "NUM.36.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
