              },
              "items": [
                {
                  "text": "Mot 26.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.1",
            "verseOrgIds": [
              "NUM.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na masya, Yeova amwĩaĩe mwĩaĩi wakwa amanenge ana ma Isilaeli nthĩ yĩthĩwe ũtiĩwa woo kwondũ wa kũlimana: na mwĩaĩi wakwa eeaĩwa nĩ Yeova atĩ ũtiĩwa wa Nzeloveati mwana‐a‐ĩthe waitũ ũnengwe eĩtu make. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.2",
            "verseOrgIds": [
              "NUM.36.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
