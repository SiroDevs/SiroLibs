                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "Kuma 15.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.59"
              },
              "items": [
                {
                  "text": "Mot 26.59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.1",
            "verseOrgIds": [
              "NUM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na masya, Nĩ w’o, Yeova aneenaa na Mose e weka? Ndaaneena o naitũ? Na Yeova eew’a ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.4.15"
              },
              "items": [
                {
                  "text": "Kuma 4.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.4"
              },
              "items": [
                {
                  "text": "2 Asu 19.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.35.12"
              },
              "items": [
                {
                  "text": "Esek 35.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ ũsu Mose aĩ mũuu mũno, kũvĩtũka andũ onthe ala maĩ ĩũlũ wa nthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.3",
            "verseOrgIds": [
              "NUM.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.3",
            "verseOrgIds": [
              "NUM.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kavenya o kau Yeova aneena na Mose, na Aluni, na Miliamu, Umaalai mwĩ atatũ mũthi ĩeemanĩ ya kũmbanĩa. Na asu atatũ maumaala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.4",
            "verseOrgIds": [
              "NUM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova atheea e kĩtuĩnĩ kya mũumbĩ, na aũngama mũomonĩ wa yĩla Ĩeema, na ameta Aluni na Miliamu; na me elĩ maumaala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.5",
            "verseOrgIds": [
              "NUM.12.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.25"
              },
              "items": [
                {
                  "text": "Mot 11.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.5",
            "verseOrgIds": [
              "NUM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amea, Yu ĩw’ai ndeto syakwa: ethĩwa ve mwathani katĩ wenyu, nyie Yeova ngeemanyĩthya kwake woninĩ, nganeena nake ndotonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.3"
              },
              "items": [
                {
                  "text": "Mwa 20.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.2"
              },
              "items": [
                {
                  "text": "46.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
