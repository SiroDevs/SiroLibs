          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthũkũmi wakwa Mose ndailyĩ ũu; nake e na kĩthito nyũmbanĩ yakwa yonthe: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.7",
            "verseOrgIds": [
              "NUM.12.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
