          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Miliamu avingĩwa ũtee wa mwako wa maeema mĩthenya mũonza: na andũ matyaathi kyalo kũvika Miliamu aetwe nthĩnĩ ĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.15",
            "verseOrgIds": [
              "NUM.12.15"
            ]
          }
        }
      ]
