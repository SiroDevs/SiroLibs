            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩla nthembo ya kũkĩlw’a ya syĩndũ syonthe ntheu sya ana ma Isilaeli, ĩla memũtwaĩa mũthembi, ĩkeethĩwa yake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
