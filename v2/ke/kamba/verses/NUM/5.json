          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũndũ mũka ndevukĩtye, ĩndĩ nĩ mũtheu; nĩvo ĩndĩ wĩthĩwa ate na ũndũ, nake akaitava.",
          "type": "text",
          "attrs": {
