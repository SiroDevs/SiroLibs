          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũthembi akaute ũvĩ wa nthembo ya mũtu, wĩthĩwe ũlilikan’yo wayo, na kũvĩvĩsya kĩthembeonĩ, na ĩtina akamũkundye ũ mũndũ mũka manzĩ asu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        },
