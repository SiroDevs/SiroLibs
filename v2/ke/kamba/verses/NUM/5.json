          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũsu nĩw’o mwĩao wa nzika, yĩla mũndũ mũka, e mwĩaonĩ wa mũũme, wĩlika wathavunĩ na kwĩvukya; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana yĩla nzika syĩmũkwata mũndũ mũũme ngoonĩ, na ailikwa nĩ nzika ũndũ wa mũka; nĩvo ĩndĩ wĩmwĩkalya mũka mbee wa Yeova, na mũthembi akamwĩka maũndũ onthe ma mwĩao ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ mũũme ũsu akeethĩwa ate na ũthũku, na mũndũ mũka ũsu akakua ũthũku wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.31",
            "verseOrgIds": [
              "NUM.5.31"
            ]
          }
