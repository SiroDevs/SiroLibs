          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũmbano ũkamũvonokya mũaani kũmumya kw’okonĩ kwa mũĩvanĩsya wa nthakame, na ũmbano ũkamũtũnga ndũanĩ yake ya kwĩvitha, vala wakĩĩe: na akekala nthĩnĩ wayo kũvika yĩla mũthembi mũnene ũkakw’a ũla wetĩkĩw’e mauta matheu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.25",
            "verseOrgIds": [
              "NUM.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa mũaani o na ĩndĩĩ akakĩla mũvaka wa ndũa yake ya kwĩvitha, vala wakĩĩe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
            "verseOrgIds": [
              "NUM.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũĩvanĩsya wa nthakame akamwona akĩlĩte mũvaka wa ndũa yake ya kwĩvitha, na mũĩvanĩsya wa nthakame akoaa ũla mũaani; ndakethĩwae na ĩvĩtyo kwondũ wa nthakame ĩsu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.27",
            "verseOrgIds": [
              "NUM.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩkwĩthĩwa ũsu nĩwaĩlwe nĩ kwĩkala ndũanĩ yake ya kwĩvitha kũvika yĩla mũthembi mũnene ũkakw’a: ĩndĩ mũthembi mũnene akw’a ũla mũaani akasyoka nthĩ ĩla ya ng’ũndũ yake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        }
