          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ethĩwa nĩwamũkũna na kĩndũ kya mũtĩ akwete kw’okonĩ, kĩla kĩtonya kũaa mũndũ, na akw’a, ũsu mũkũnani nĩ mũaani: mũaani nde ndĩi ya kũlea kũawa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.18",
            "verseOrgIds": [
              "NUM.35.18"
            ]
          }
        },
        {
          "name": "verse",
