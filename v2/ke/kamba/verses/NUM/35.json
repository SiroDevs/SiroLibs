            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ũla ũkoaa mũndũ o na wĩva, mũaani ũsu akooawa nũndũ wa makanyw’a ma ngũsĩ: ĩndĩ ngũsĩ ĩmwe yĩ yoka ndĩkamũkũsĩĩe mũndũ o na wĩva oawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        },
        {
