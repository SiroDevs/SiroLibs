              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maũndũ asu makeethĩwa kwenyu mwamũlo na ũtw’ĩo mosyaanĩonĩ menyu onthe motũonĩ menyu onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
