          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa nĩwamũluuta na kĩthũlũmũkĩlo vate ũthũ, kana kũmwĩkya kĩndũ vate kũmwoveesya, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.22",
            "verseOrgIds": [
              "NUM.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ĩvia o na yĩva, yĩla yĩtonya kũaa mũndũ, na akamwĩkya, atamwene, na kwondũ wa ũu aikw’a, na ti nthũ yake, o na ndaamantha kũmwĩka ũndũ ũthũku; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.23",
            "verseOrgIds": [
              "NUM.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ ũmbano ũkamasilan’ya ũla mũkũnani na mũĩvanĩsya wa nthakame, kwĩanana na motw’ĩo aa; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.24",
            "verseOrgIds": [
              "NUM.35.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
