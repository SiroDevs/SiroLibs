          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũa isu thanthatũ ikeethĩwa sya kwĩvitha kwondũ wa ana ma Isilaeli, na kwondũ wa mũeni, na kwondũ wa mwĩkali wa ũeninĩ wĩ kwoo; nĩ kana kĩla mũndũ ũla ũkoaa mũndũ o na wĩva na mbanga akĩĩae vo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        },
