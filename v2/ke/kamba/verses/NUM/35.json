              "items": [
                {
                  "text": "Yos 20.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.24",
            "verseOrgIds": [
              "NUM.35.24"
