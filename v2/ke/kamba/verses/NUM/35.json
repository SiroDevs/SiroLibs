              },
              "items": [
                {
                  "text": "Yos 21.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.7",
            "verseOrgIds": [
              "NUM.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũndũ wa ndũa ila mũkanengane kuma nthĩnĩ wa ng’ũndũ ya ana ma Isilaeli, kuma kwa andũ aingĩ mũkoosa ndũa nyingĩ; na kuma kwa andũ anini mũkoosa nini: kĩla mũndũ akanenga Alivai ndũa imwe syake, kwĩanana na ũtiĩwa wake ũla watiĩwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.8",
            "verseOrgIds": [
              "NUM.35.8"
            ]
          }
        },
        {
