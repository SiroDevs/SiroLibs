          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ethĩwa nĩwamũkũna na kw’oko kwondũ wa ũthũ, na kwondũ wa ũu aikw’a; ũla wamũkũna nde ndĩi ya kũlea kũawa; ũsu mũkũnani nĩ mũaani: mũĩvanĩsya wa nthakame akoaa mũaani ũsu, o yĩla wĩkomana nake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        }
