          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Mose, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.10",
            "verseOrgIds": [
              "NUM.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vineasi, mwana wa Eleasali, mwana wa mũthembi Aluni, nũalyũlĩte ũthilĩku wakwa wume ĩũlũ wa ana ma Isilaeli, nũndũ nĩwewie kĩwĩu, o kĩwĩu kyakwa katĩ woo, ũndũ wa ũu ndyaananga ana ma Isilaeli kĩwĩunĩ kyakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.11",
            "verseOrgIds": [
              "NUM.25.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
