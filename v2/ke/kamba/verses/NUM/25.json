            }
          ]
        },
        {
          "text": "Kwondũ wa ũu neena atĩĩ, Sisya, nĩngũmũnenga ũtianĩo wakwa wa mũuo: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.12",
            "verseOrgIds": [
              "NUM.25.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
