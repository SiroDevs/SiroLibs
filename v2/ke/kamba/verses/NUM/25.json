              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isilaeli meekwatan’ya na Mbaali‐veoli: na ũthatu wa Yeova wakanĩa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        },
        {
