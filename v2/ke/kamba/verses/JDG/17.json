              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.10",
            "verseOrgIds": [
              "JDG.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
