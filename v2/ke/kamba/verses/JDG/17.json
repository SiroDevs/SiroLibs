              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Mika asya, Yu nĩnĩsĩ kana Yeova akambĩka nesa, nũndũ nĩ na Mũlivai ethĩwe mũthembi wakwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.13",
            "verseOrgIds": [
              "JDG.17.13"
