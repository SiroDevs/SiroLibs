          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Manoa akũlya mũlaĩka wa Yeova, Wĩtawa ata, nĩ kana, ndeto syaku syeanĩa, tũtonye kũkũtaĩa? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        },
