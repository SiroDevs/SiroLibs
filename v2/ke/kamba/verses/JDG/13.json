            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ambĩa, Sisya, ũkaitava, na ũkasyaa mwana; na yu ĩndĩ ndũkaanyw’e mbinyu o na kĩla kĩtoonasya, na ndũkaaye kĩndũ kĩvuku o na kĩva; nũndũ kana kakeethĩwa Mũnasili kwa Ngai kuma ke ĩvunĩ kũvika mũthenya wa kĩkw’ũ kyake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        }
