                "loc": "JOS.13.2+JOS.13.3+JOS.13.4+JOS.13.5+JOS.13.6"
              },
              "items": [
                {
                  "text": "Yos 13.2–6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.3",
            "verseOrgIds": [
              "JDG.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasyo saytiiwe sya kũtataa Isilaeli nasyo, ũndũ wa kũmanyaa ethĩwa makeethukĩĩasya mĩao ya Yeova, ĩla weaĩe aaĩthe moo na kanyw’a wa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli namo matũa katĩ wa Akanaani, na Aititi, na Aamoli, na Avelisi, na Aivi, na Ayevusi: ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.5",
            "verseOrgIds": [
              "JDG.3.5"
            ]
          }
        },
