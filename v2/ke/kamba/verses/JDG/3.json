              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli mamũthũkũma Ekeloni mũsumbĩ wa Moavi myaka ĩkũmi na nyanya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
