            "number": "24",
            "style": "v",
            "sid": "JDG 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ yĩla waendie athũkũmi make mooka; namo moona, na, sisya, mĩomo ya nyũmba ĩsu ya ĩũlũ nĩ mĩvinge ki, na masya, Vate ndĩi evw’ĩkĩte maũũ make e nyũmbanĩ ya ĩũlũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
