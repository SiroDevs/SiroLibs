              "items": [
                {
                  "text": "1 Sam 24.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na meteelanga mũvaka meew’a nthoni; na, sisya, ndaavingũa mĩomo ya nyũmba ya ĩũlũ: kwondũ wa ũu moosa ũvungũo, na mamĩvingũa; na, sisya, mwĩaĩi woo avalũkĩte nthĩ e mũkw’ũ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        }
      ]
    },
