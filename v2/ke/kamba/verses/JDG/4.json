                "loc": "JDG.5.24"
              },
              "items": [
                {
                  "text": "Asi 5.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.17",
            "verseOrgIds": [
              "JDG.4.17"
            ]
          }
        },
        {
          "name": "verse",
