          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Sisela akũka na maũũ avika ĩeemanĩ ya Yaeli mũka wa Eeveli ũla Mũkeni; nũndũ kwaĩ mũuo katĩ wa Yavini mũsumbĩ wa Asoli na nyũmba ya Eeveli ũla Mũkeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.17",
            "verseOrgIds": [
              "JDG.4.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
