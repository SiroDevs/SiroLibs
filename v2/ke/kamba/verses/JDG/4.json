            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.1",
            "verseOrgIds": [
              "JDG.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amathoosya kw’okonĩ kwa Yavini mũsumbĩ wa Kanaani, ũla wasumbĩkĩte ku Asoli; na kavuteni wa nguthu ya ũsu aĩ Sisela, ũla watwie Alosethi wa Andũ‐ma‐mbaĩ‐ingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.2",
            "verseOrgIds": [
              "JDG.4.2"
            ]
          }
        },
        {
