              },
              "items": [
                {
                  "text": "Asi 5.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.21",
            "verseOrgIds": [
              "JDG.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, Mbalaka aatĩĩe Sisela, Yaeli aumaala amũthaũe, na amwĩa, Ũka, na nĩngũkwon’ya mũndũ ũla ũũmantha. Na ooka vala ũĩ; na, sisya, Sisela akomete e mũkw’ũ, na kĩla kyambo kĩ ũthĩanĩ kĩkuthũkene.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.22",
            "verseOrgIds": [
              "JDG.4.22"
            ]
          }
        }
      ]
