            "number": "4",
            "style": "v",
            "sid": "JDG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩvinda yĩu Ndevola, mwathani mũndũ mũka, kĩveti kya Lavitothi, nĩkyasilanasya Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.4",
            "verseOrgIds": [
              "JDG.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake ekalaa ĩtina wa mũtende wa Ndevola, katĩ wa Lama na Mbethi‐eli, nthĩ yĩ iĩma ya Evalaimu: na ana ma Isilaeli mambataa vala ũĩ nĩ kana makasilanw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.5",
            "verseOrgIds": [
              "JDG.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atũmana Mbalaka aketwe, mwana wa Avinoamu, kuma Ketesi‐navitali, na amwĩa, Yeova, Ngai wa Isilaeli, ndakwĩaĩĩte, aikwĩa, Enda ũthengeee kĩĩmanĩ kya Tavoli, na ũkĩthi na andũ ngili ĩkũmi ma ana ma Navitali na ma ana ma Nzevuluni? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.6",
            "verseOrgIds": [
              "JDG.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.37"
              },
              "items": [
                {
                  "text": "Yos 19.37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.8.18"
              },
              "items": [
                {
                  "text": "Asi 8.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.32"
              },
              "items": [
                {
                  "text": "Aevl 11.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.6",
            "verseOrgIds": [
              "JDG.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa ngakũthengeesya Sisela ũsĩnĩ wa Kisoni, kavuteni wa ita sya Yavini, vamwe na makasya make ma kaũ na nguthu yake; na ngamũnengane kw’okonĩ kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.7",
            "verseOrgIds": [
              "JDG.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
