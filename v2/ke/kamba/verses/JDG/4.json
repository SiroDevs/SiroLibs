              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli meeka ĩngĩ ũla Yeova wonaa wĩ ũthũku, yĩla Euti wakwie. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.1",
            "verseOrgIds": [
              "JDG.4.1"
            ]
          }
        },
