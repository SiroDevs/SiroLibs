          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthembi amea, Endai na mũuo: nzĩa ĩla mũkwete Yeova nũmyene. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.6",
