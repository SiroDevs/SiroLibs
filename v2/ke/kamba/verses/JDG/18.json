                {
                  "text": "Mot 13.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.1"
              },
              "items": [
                {
                  "text": "Yos 2.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.2",
            "verseOrgIds": [
              "JDG.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me vakuvĩ na nyũmba ya Mika, mamanya wasya wa ũla mwanake Mũlivai; nao meelelũkĩla vo, na mamũkũlya, Nũũ wakũetie kũũ? Na wĩĩka ata vaa? Na wĩ na kyaũ vaa? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.3",
            "verseOrgIds": [
              "JDG.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amea, Ũũ na ũũ nĩw’o Mika ũmbĩkĩte, na nũnandĩkĩte, nakwa nĩndw’ĩkĩte mũthembi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.4",
            "verseOrgIds": [
              "JDG.18.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
