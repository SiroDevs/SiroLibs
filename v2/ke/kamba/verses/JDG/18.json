        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.26",
            "verseOrgIds": [
              "JDG.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
