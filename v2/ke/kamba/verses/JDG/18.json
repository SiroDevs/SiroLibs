              },
              "items": [
                {
                  "text": "Asi 17.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.4",
            "verseOrgIds": [
              "JDG.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamwĩa, Nĩtũũkwĩsũva, mũkũlye Ngai, nĩ kana tũmanye kana nzĩa ĩla tũkwete kana ĩkaathimĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.5",
            "verseOrgIds": [
              "JDG.18.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
