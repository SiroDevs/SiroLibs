              "type": "tag",
              "attrs": {
                "loc": "EXO.18.3"
              },
              "items": [
                {
                  "text": "18.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.12"
              },
              "items": [
