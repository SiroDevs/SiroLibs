                {
                  "text": "Asi 21.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.18",
            "verseOrgIds": [
              "JDG.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na masya, Sisyai, kwĩ mboka ya Yeova kĩla mwaka ku Silo, ĩla yĩ ngalĩ ya ĩũlũ ya Mbethi‐eli, ngalĩ ya wumĩlonĩ wa syũa ya lelũ ũla wambatĩte kuma Mbethi‐eli kũvika Sekemu, na ngalĩ ya ĩtheo ya Levona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.19",
            "verseOrgIds": [
              "JDG.21.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.3"
              },
              "items": [
                {
                  "text": "1 Sam 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.19",
            "verseOrgIds": [
              "JDG.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mameaĩa ana ma Mbenyamini, makĩmea, Endai mwoveesye mĩũndanĩ ya mĩsavivũ; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.20",
            "verseOrgIds": [
              "JDG.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na, sisyai, ethĩwa eĩtu ma Silo nĩmekumaala makasũnge mbathinĩ, nĩvo ĩndĩ mwĩuma mĩũndanĩ ya mĩsavivũ, na ĩyoseei kĩla mũndũ mũka kuma eĩtunĩ ma Silo, na mũkĩthi nthĩ ya Mbenyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.21",
            "verseOrgIds": [
              "JDG.21.21"
            ]
          }
        },
        {
