                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.21.25"
              },
              "items": [
                {
                  "text": "21.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.1",
            "verseOrgIds": [
              "JDG.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ mũka ũsu ngombo amũthĩn’ya kwa kwĩka ũmalwaya, na amũtia athi nyũmbanĩ kwa ĩthe ku Mbethi‐leemu‐yuta, na ekalile kw’o vandũ va myei ĩna. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.2",
            "verseOrgIds": [
              "JDG.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũũme ookĩla, na amũatĩĩa, e na mũthũkũmi wake, na mang’oi elĩ, akaneene nake nesa, amũtũnge ĩngĩ: na ũla mũndũ mũka amũthokya nyũmbanĩ ya ĩthe; na yĩla ĩthe wa mwĩĩtu ũsu wamwonie, atana ũndũ wa kũmwona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.3",
            "verseOrgIds": [
              "JDG.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthoni, ĩthe wa mwĩĩtu ũsu, amwĩkalya; nake ekala nake mĩthenya ĩtatũ: na ĩndĩ maya na manyw’a, na kũkoma kw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.4",
            "verseOrgIds": [
              "JDG.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mũthenya wa kana, mookĩla kĩoko tene, nake ookĩla nĩ kana aende: na ĩthe wa ũla mwĩĩtu amwĩa mũthoni, Ĩkĩa ngoo yaku vinya na kalungu ka kĩmũtũ, na ĩtina mũkĩyĩendea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.5",
            "verseOrgIds": [
              "JDG.19.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.5"
              },
              "items": [
                {
                  "text": "Mwa 18.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.5",
            "verseOrgIds": [
              "JDG.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mekala nthĩ, na maya na manyw’a, elĩ vamwe: na ĩthe wa ũla mwĩĩtu atavya mũthoni, Nĩngũkwĩsũva, endeew’a nĩ kwĩkala ũtukũ w’onthe, na ngoo yaku nĩtane. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.6",
            "verseOrgIds": [
              "JDG.19.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.3.7"
              },
              "items": [
                {
                  "text": "Lu 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.6",
            "verseOrgIds": [
              "JDG.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla mũndũ ookĩla nĩ kana aende; ĩndĩ mũthoni amũthetheesya mũno, nake akoma ĩngĩ kw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.7",
            "verseOrgIds": [
              "JDG.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ookĩla kĩoko tene mũthenya wa katano nĩ kana athi; na ĩthe wa ũla mwĩĩtu amwĩa, Ĩkĩa ngoo yaku vinya nĩngũkwĩsũva, na ĩkalanga syũa yeeeke; na maya, me elĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.8",
            "verseOrgIds": [
              "JDG.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ũla mũndũ wokĩlile nĩ kana aende, we, na ũla mũndũ mũka wake ngombo, na mũthũkũmi wake, mũthoni, ĩthe wa ũla mwĩĩtu, amwĩa, Sisya, yu mũthenya nĩ mũendu, nĩngũkwĩsũva, ĩkala ũtukũ w’onthe: sisya, syũa yĩkilĩlye ũthũa, koma kũũ, nĩ kana ngoo yaku ĩtane; na ũnĩ tene wĩkwata nzĩa, nĩ kana wĩnũke.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.9",
            "verseOrgIds": [
              "JDG.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.9",
            "verseOrgIds": [
              "JDG.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũla mũndũ ndaaĩtĩkĩla kwĩkala ũtukũ ũsu, ĩndĩ ookĩla na athi, na avika kwelekela Yevusi (nayo nĩ Yelusaleme): nake aĩ na mang’oi elĩ me matandĩke; o na ũla mũndũ mũka wake ngombo aĩ nake. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.10",
            "verseOrgIds": [
              "JDG.19.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.8"
              },
              "items": [
                {
                  "text": "Yos 15.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.63"
              },
              "items": [
                {
                  "text": "63",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.10",
            "verseOrgIds": [
              "JDG.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla maĩ vakuvĩ na Yevusi, mũthenya waĩ mũendu mũno; na ũla mũthũkũmi amwĩa vwana wake, Nĩngũkwĩsũva, ũka, twelelũkĩĩle ndũa ĩno ya Ayevusi, tũkome vo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.11",
            "verseOrgIds": [
              "JDG.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vwana wake amwĩa, Tũtiathũka ndũa ya mũndũ wa nthĩ ĩngĩ, ĩte ya ana ma Isilaeli; ĩndĩ nĩtũũvĩta tũvike Ngivea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.12",
            "verseOrgIds": [
              "JDG.19.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.28"
              },
              "items": [
                {
                  "text": "Yos 18.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.12",
            "verseOrgIds": [
              "JDG.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwĩa mũthũkũmi wake, Ũka tũthengeee vandũ vamwe va kũndũ kũũ; na nĩtũũkoma Ngivea, kana Lama. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.13",
            "verseOrgIds": [
              "JDG.19.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.25"
              },
              "items": [
                {
                  "text": "Yos 18.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.17"
              },
              "items": [
                {
                  "text": "1 Sam 7.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.13",
            "verseOrgIds": [
              "JDG.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mavĩta na meeendea; na syũa yamathũĩĩa me vakuvĩ na Ngivea, ĩla ya Mbenyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.14",
            "verseOrgIds": [
              "JDG.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao meelelũkĩĩla vo, malike makome Ngivea: nake alika nthĩnĩ, na ekala nthĩ nzĩanĩ nene ya ĩ ndũa; nũndũ kũtyaĩ mũndũ o na ũmwe waamathokya nyũmbanĩ yake makome. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.2"
              },
              "items": [
                {
                  "text": "Mwa 19.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, kwooka mũtumĩa mũkũũ aumĩte wĩanĩ wake mũũndanĩ wĩoo: na mũndũ ũsu aĩ wa nthĩ yĩ iĩma ya Evalaimũ, nake ekalaa ũeni ku Ngivea; ĩndĩ andũ ma vandũ vau maĩ Ambenyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.16",
            "verseOrgIds": [
              "JDG.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake ookĩlya metho make, na oona mũndũ ũendete kyalo nzĩanĩ nene ya ndũa; na ĩndĩ ũla mũtumĩa amũkũlya, Wĩthi na kũ? Na wauma va? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.17",
            "verseOrgIds": [
              "JDG.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amwĩa, Nĩtũvĩtĩte tumĩte Mbethi‐leemũyuta tũthi ngalĩ ĩla ĩngĩ ya nthĩ yĩ iĩma ya Evalaimu; nĩ kw’o nĩnaumie, na naendie Mbethi‐leemu‐yuta; na yu nĩendete nyũmbanĩ ya Yeova; na vati mũndũ ũnanthokya nyũmbanĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.18",
            "verseOrgIds": [
              "JDG.19.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.31"
              },
              "items": [
                {
                  "text": "Asi 18.31",
                  "type": "text"
                }
