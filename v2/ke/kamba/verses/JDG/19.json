          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwĩa, Ũkĩla, tũthĩ; ĩndĩ vatyaĩ ũsũngĩo; na ĩndĩ amũtũlya ĩng’oinĩ; na mũndũ ũsu akũsya, na athi kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        },
