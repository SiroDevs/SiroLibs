      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mĩthenya ĩsu, yĩla kũtaĩ mũsumbĩ nthĩnĩ wa Isilaeli, kwaĩ Mũlivai ũmwe wekalaa ũeni ngalĩ ĩla ĩngĩ ya nthĩ yĩ iĩma ya Evalaimu, ũla wetwaĩe mũndũ mũka ngombo wa Mbethi‐leemu‐yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.1",
            "verseOrgIds": [
              "JDG.19.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.6"
              },
              "items": [
                {
                  "text": "Asi 17.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
