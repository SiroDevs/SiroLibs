                {
                  "text": "Mwa 34.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ ĩthe na nyinyia mamũkũlilye, Kũti mũndũ mũka nongi katĩ wa eĩtu ma ana‐a‐au, kana andũnĩ makwa onthe, ũndũ ũkũthi kwa Avilisiti ala mate aĩke kũtwaa kĩveti? Na Samusoni amwĩa ĩthe, Ndwaĩa ũsu; nũndũ nũkũmbendeesya mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        },
