          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ũtukũ o ũsu Yeova amwĩa, Ũkĩla, ũtheee mwakonĩ wa maeema; nũndũ nĩnĩũnenganĩte kw’okonĩ kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.9",
            "verseOrgIds": [
              "JDG.7.9"
            ]
          }
        },
