            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ngiteoni atũma atũmwa nthĩ yonthe yĩ iĩma ya Evalaimu, akyasya, Theeai mũkite na Mitiani, na mũkyamba kũkwata iw’ũ kwĩ mo, o kũvika Mbethi‐mbala, o Yolotani. Na ĩndĩ andũ onthe ma Evalaimu moombanite vamwe, na makwata iw’ũ kũvika Mbethi‐mbala, o Yolotani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.24",
            "verseOrgIds": [
              "JDG.7.24"
            ]
          }
        },
