              "items": [
                {
                  "text": "2 Mav 20.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ ma Isilaeli moombanĩte vamwe kuma Navitali, na kuma Aseli, na kuma Manase yonthe, na maatĩĩa Mitiani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.23",
            "verseOrgIds": [
              "JDG.7.23"
            ]
          }
        }
      ]
    },
