              "JDG.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ mamwĩaa, Asya Syivolethi ĩndĩ, nake aĩasya Sivolethi; nũndũ ndaatonya kũmĩta nesa: na ĩndĩ maimũkwata, na kũmũaĩa masyũkonĩ ma Yolotani. Na ĩvinda yĩu kwavalũkw’a ma Evalaimu andũ ngili mĩongo ĩna na ilĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.6",
            "verseOrgIds": [
              "JDG.12.6"
            ]
          }
        },
        {
