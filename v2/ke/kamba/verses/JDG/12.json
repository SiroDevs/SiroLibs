                {
                  "text": "Asi 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.14",
            "verseOrgIds": [
              "JDG.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avitoni mwana wa Ileli Mũvilathoni akw’a, na athikwa Vilathoni nthĩ ya Evalaimu, nthĩ yĩ iĩma ya Aamaleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.15",
            "verseOrgIds": [
              "JDG.12.15"
            ]
          }
        }
