      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa Avimeleki kwookĩla Tola mwana wa Vua, mwana wa Ndoto, mũndũ wa Isakali, amatangĩĩe Isilaeli; nake atũa Samili ku nthĩ yĩ iĩma ya Evalaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.1",
            "verseOrgIds": [
              "JDG.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake asilan’ya Isilaeli myaka mĩongo ĩlĩ na ĩtatũ, na akw’a, na athikwa ku Samili.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
