          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli meea Yeova, Nĩtũvĩtanĩtye: ĩka naitũ o ũndũ wĩona wĩ ũseo; ĩndĩ, nĩtũũkũvoya, ũtũvonokye o ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
              "JDG.10.15"
            ]
          }
        },
