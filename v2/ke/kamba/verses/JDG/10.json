              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endai mũkekaĩle ngai ila mwanyuvie; nimũtangĩĩe ĩnvinda ya thĩna wenyu. ",
          "type": "text",
          "attrs": {
