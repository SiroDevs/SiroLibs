          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩmwandiie, na mwathũkũma ngai ingĩ: kwondũ wa ũu ndimũtangĩĩa ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.13",
            "verseOrgIds": [
              "JDG.10.13"
            ]
          }
        },
