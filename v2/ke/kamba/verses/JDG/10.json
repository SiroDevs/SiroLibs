              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wake kwookĩla Yaili, Mũngileati; nake asilan’ya Isilaeli myaka mĩongo ĩlĩ na ĩlĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.3",
            "verseOrgIds": [
              "JDG.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aĩ na ana mĩongo ĩtatũ ala makuawa nĩ ndena sya mang’oi mĩongo ĩtatũ, na maĩ na ndũa mĩongo ĩtatũ ila syĩtawa Avothi‐yaili kũvika ũmũnthĩ, ila syĩ nthĩ ya Ngileati. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.4",
            "verseOrgIds": [
              "JDG.10.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.14"
              },
              "items": [
                {
                  "text": "Kũt 3.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.12.14"
              },
              "items": [
                {
                  "text": "Asi 12.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.4",
            "verseOrgIds": [
              "JDG.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yaili akw’a, na athikwa ku Kamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
