          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asitoni namo, na Aamaleki na Amaoni, nĩmamũthĩnasya; nenyu mweengaĩla, nakwa namũtangĩĩa kuma mokonĩ moo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.12",
            "verseOrgIds": [
              "JDG.10.12"
            ]
          }
        },
        {
