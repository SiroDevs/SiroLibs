              "items": [
                {
                  "text": "2 Ako 4.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ tũkĩmanya kũmũkĩa Mwĩaĩi, twĩmanzanza andũ, ĩndĩ nĩtwonanĩtw’e kwa Ngai; nakwa nĩnĩkwatĩtye kana nĩtwonanĩtw’e naw’o nthĩnĩ wa mawasya ma ngoo menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.11",
            "verseOrgIds": [
              "2CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.1"
              },
              "items": [
                {
                  "text": "2 Ako 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũikwĩĩkĩĩthya ene ĩngĩ mbee wenyu, ĩndĩ nĩtũũmũnenga ũthei wa kwĩkathĩĩa kwondũ witũ, nĩ kana mwĩthĩwe na ũndũ wa ũmasũngĩa ala mekwĩkathĩĩa maũndũnĩ ala monekaa nĩ andũ, na ti ala ma ngoonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.12",
            "verseOrgIds": [
              "2CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ o na ethĩwa kĩlĩko kitũ nĩkyaĩte, nĩ kwondũ wa Ngai; kana ethĩwa twĩ nakyo, nĩ kwondũ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.13",
            "verseOrgIds": [
              "2CO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ wendo wa Klĩsto nũũtũthing’ĩĩsya; nĩkwĩthĩwa twĩona atĩ ũmwe nĩwakwie kwondũ wa onthe, kwondũ wa ũu onthe nĩmakwie; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.14",
            "verseOrgIds": [
              "2CO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.6"
              },
              "items": [
                {
                  "text": "1 Tim 2.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.7"
              },
              "items": [
                {
                  "text": "Alo 14.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake nĩwamakwĩĩe onthe, nĩ kana ala me thayũ maikethĩwe naw’o ĩngĩ kwondũ woo ene, ĩndĩ no kwondũ wake ũla wakwie na athayũũka ĩngĩ kwondũ woo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        }
      ]
    },
    {
