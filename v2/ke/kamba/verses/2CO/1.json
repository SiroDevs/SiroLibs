                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwĩkathĩĩa kwitũ nĩ kũũ, ũkũsĩ wa wasya wa ngoo witũ, kana twekalile kũũ nthĩ, na mbee mũno nĩ kwenyu, twĩ na ũtheu na w’o wa ngoo wumĩte kwa Ngai, na ti na ũĩ wa mwĩĩ ĩndĩ mumonĩ wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ tũiũmũandĩkĩa maũndũ angĩ, no ala mũsomaa na kũmalĩkĩla, nakwa nĩnĩkwatĩtye kana mũkalĩkĩla kũvika mũminũkĩlyo: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.12"
              },
              "items": [
                {
                  "text": "2 Ako 5.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.16"
              },
              "items": [
                {
                  "text": "Avi 2.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o tondũ nenyu mwatũlĩkĩle ithyĩ kũmwe, kana kĩtumi kya kwĩkathĩĩa kwenyu nĩ ithyĩ, o tondũ nenyu mwĩĩthĩwa kĩtumi kya kwĩkathĩĩa kwitũ, mũthenya wa Mwĩaĩi waitũ Yesũ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
