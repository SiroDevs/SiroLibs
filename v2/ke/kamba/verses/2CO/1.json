              },
              "items": [
                {
                  "text": "1 Vet 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nataĩwe Ngai, Ĩthe wa Mwĩaĩi waitũ Yesũ Klĩsto, Ĩthe wa matei na Ngai wa ũkiakisyo w’onthe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla ũtũkiakiasya mathĩnanĩ maitũ onthe, nĩ kana ithyĩ tũtonye kũmakiakisya ala me thĩnanĩ o na wĩva, na ũkiakisyo ũla ithyĩ naitũ tũkiakiaw’a naw’o nĩ Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.19"
              },
              "items": [
                {
                  "text": "Sav 34.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.19"
              },
              "items": [
                {
                  "text": "94.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa o tondũ mathĩna ma Klĩsto mausũĩte ki kwitũ, o ta ũu ũkiakisyo witũ naw’o nĩwusũĩte ki kwondũ wa Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.15"
              },
              "items": [
                {
                  "text": "2 Ako 4.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa nĩtũthĩnaw’a, nĩ ũndũ wa ũkiakisyo na ũtangĩĩo wenyu; kana ethĩwa nĩtũkiakiaw’a, nĩ ũndũ wa ũkiakisyo wenyu, ũla ũtethasya wĩa wa kũmĩĩsya mathĩna o ala naitũ tũthĩnaw’a nĩo: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wĩkwatyo witũ kwondũ wenyu nĩ mũlũmu, twĩsĩ kana o tondũ mwĩ osi ma mathĩna, o ta ũu mwĩ osi ma mokiakisyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.23"
              },
              "items": [
                {
                  "text": "Meko 19.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.32"
              },
              "items": [
                {
                  "text": "1 Ako 15.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na tũikwenda, ana‐a‐asa, mũlee ũmanya mathĩna ala matũkwatĩe nthĩ ya Asia, kana twaitavĩwe mũno, kũvĩta vinya witũ, o na twayĩtũka kwĩthĩwa thayũ: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩĩ, ithyĩ ene nthĩnĩ waitũ tweewie ta tũte ndĩi ya kũlea ũkw’a, nĩ kana tũikeĩkĩĩe ithyĩ ene, ĩndĩ tũmũĩkĩĩe Ngai ũla ũthayũũkasya akw’ũ: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.18"
              },
              "items": [
                {
                  "text": "2 Tim 4.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla watwovoisye kũtumya kĩkw’ũnĩ kĩnene ta kyu, nake akatwovosya: we ũla tũmwĩkwatĩtye kana akatwovoasya: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "inyw’ĩ nenyu mũkĩtetheanĩsya kũvoya kwondũ witũ; nĩ kana, kwondũ wa mũthĩnzĩo ũla twanengiwe ithyĩ nũndũ wa andũ aingĩ, aingĩ matonye kũtũnga mũvea kwondũ witũ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
