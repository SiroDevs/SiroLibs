              "items": [
                {
                  "text": "1 Ako 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaulo, mũtũmwa wa Klĩsto Yesũ kwondũ wa kwenda kwa Ngai, na Timotheo mwana‐a‐asa waitũ, valũa ũũ witũ ũyĩvikĩe ĩkanisa ya Ngai yĩla yĩ Kolintho, vamwe na ala atheu onthe, ala me nthĩ yonthe ya Akaia: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.7"
              },
              "items": [
                {
                  "text": "Alo 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumo na mũuo nĩmethĩwe nenyu kuma kwa Ngai Asa waitũ na kwa Mwĩaĩi Yesũ Klĩsto.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
    {
