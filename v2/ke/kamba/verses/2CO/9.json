            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩneena ndeto ii, Ũla ũvuĩaa nini akethaa nini; na ũla ũvuĩaa nyingĩ akethaa nyingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
