                  "text": "1 Mav 29.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩla mũndũ nĩeke o tondũ utw’ĩte ngoonĩ yake: ti kwa kulea kwenda, kana kwa kũingĩĩw’a: nũndũ Ngai endete mũndũ ũnenganae na ũtanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.7",
            "verseOrgIds": [
              "2CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ngai nũtonya kwingĩvya mumo w’onthe kwa inyw’ĩ; nĩ kana inyw’ĩ, mwĩanĩwe vyũ mavinda onthe maũndũnĩ onthe, mwingĩve kĩla wĩanĩ mũseo: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.8",
            "verseOrgIds": [
              "2CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
