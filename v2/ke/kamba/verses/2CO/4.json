          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.1"
              },
              "items": [
                {
                  "text": "2 Ako 5.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.15"
              },
              "items": [
                {
                  "text": "Meko 9.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ twĩ na ũthwĩĩ ũsu mĩionĩ ya mũthanga, nĩ kana vinya ũsu mũnene ũvĩtũkĩte wĩthĩwe wĩ wa Ngai, na ti kuma kwitũ; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.7",
            "verseOrgIds": [
              "2CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.8"
              },
              "items": [
                {
                  "text": "2 Ako 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.5"
              },
              "items": [
                {
                  "text": "7.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩtũlĩlĩĩlawa ngalĩ syonthe, ĩndĩ ti kũthyũlũlũkwa; nĩtũsũanĩawa, ĩndĩ ti kwĩyĩtũka: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.8",
            "verseOrgIds": [
              "2CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩtũatĩĩawa, ĩndĩ tũtiũtiwa; nĩtũvalũkawa nthĩ, ĩndĩ tũikwanangwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.9",
            "verseOrgIds": [
              "2CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.31"
              },
              "items": [
                {
                  "text": "1 Ako 15.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mavinda onthe nĩtũkuaa kũawa kwa Yesũ mĩĩnĩ yaitũ nĩ kana thayũ wa Yesũ naw’o wonanw’e mĩĩnĩ yaitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
              "2CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.36"
              },
              "items": [
                {
                  "text": "Alo 8.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ithyĩ ala twĩ thayũ tũnenganawe tũkw’e mavinda onthe kwondũ wa Yesũ, nĩ kana thayũ wa Yesũ naw’o wonanw’e mĩĩnĩ yaitũ ĩla ĩkusaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ũu ĩndĩ, kĩkw’ũ nĩkĩtethasya wĩa nthĩnĩ waitũ, ĩndĩ nthĩnĩ wenyu nĩ thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.116.10"
              },
              "items": [
                {
                  "text": "Sav 116.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nũndũ twĩ na veva wa ũla mũĩkĩĩo, kwĩanana na ũndũ kũandĩkĩtwe, Nĩneetĩkĩlile, na kwondũ wa ũu nĩnaneenie; naitũ nĩtũkwĩtĩkĩla, na kwondũ wa ũu naitũ nĩtũneenaa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.14"
              },
              "items": [
                {
                  "text": "1 Ako 6.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "twĩsĩ kana we ũla wamũthayũũkisye Mwĩaĩi Yesũ akatũthayũũkya ithyĩ naitũ vamwe na Yesũ, na kũtũnengane vamwe nenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
            "verseOrgIds": [
              "2CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.3+2CO.1.4+2CO.1.5+2CO.1.6"
              },
              "items": [
                {
                  "text": "2 Ako 1.3–6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ maũndũ onthe nĩ kwondũ wenyu, nĩ kana mumo, ũkingĩvw’a kwondũ wa aingĩ, ũtume mũvea wingĩvw’a nĩ kana Ngai ataĩwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        }
      ]
    },
