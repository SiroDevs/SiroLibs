                "loc": "1SA.1.18"
              },
              "items": [
                {
                  "text": "1 Sam 1.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ waisye, Nĩnone ũseo vala ũĩ, mwĩaĩi wakwa; nũndũ nĩwangiakisya, na nĩwaneena nesa na mũthũkũmi waku mwĩĩtu, o na ndiilyĩ ta ũmwe wa athũkũmi maku eĩtu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩvinda ya kũya lĩu Mboasi amwĩa Luthi, Ũka vaa, ũye lĩu, noivoka kalungu kaku ka kĩmũtũ na siki. Nake ekala nthĩ vakuvĩ na akethi; na mamũnenga lĩu wa mbaa ngetha mũkaange, na aya, na avũna, na atialya. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla wokĩlile akolan’ye, Mboasi ameaĩa anake make, akĩmea, Mũekei akolan’ye o syovenĩ, na mũikamũsonokye. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.15",
            "verseOrgIds": [
              "RUT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ mũsũmũlĩlei syovenĩ, na mũekei akolan’ye, na mũikamũkan’ye.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ akolan’ya mũũndanĩ ũsu kũvika wĩoo; na avũa ila wakolanasya, na syaĩ ta eva ya mbaale. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eeyaĩkya, na athi ndũanĩ; na inyia wa mũũme oona ila ũkolanilye: na aumya na amũnenga lĩu ũla ũtialilye ĩtina wa avũna. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.18",
            "verseOrgIds": [
              "RUT.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.2.10"
              },
              "items": [
                {
                  "text": "Lu 2.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inyia wa mũũme amũkũlya, Wĩkolanasya va ũmũnthĩ? Na wĩtethasya wĩa va? Naathimwe ũla ũkũmanyie. Nake amũmanyĩthya inyia wa mũũme kwa ũla ũnũũtethasya wĩa kwake, na amwĩa, Mũndũ ũsu ngũtethasya wĩa kwake ũmũnthĩ syĩtwa yake nĩ Mboasi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
