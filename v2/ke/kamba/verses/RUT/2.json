              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Naomi aĩ na mũndũ wa mbaĩ ya a mũũme wa mũvĩa wa Elimeleki, mũndũ mũthwii wĩ nguma, na syĩtwa yake eetawa Mboasi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
              "RUT.2.1"
            ]
          }
        },
