                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.19"
              },
              "items": [
                {
                  "text": "Kũt 24.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Luthi Mũmoavi amwĩa Naomi, Eka nĩthi yuyu mũũndanĩ ngekolanĩlye iia sya mbaale ĩtina wa ũla wĩmbonea ũseo. Na amwĩa, Thi, mwĩĩtu wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athi, na avika na akolan’ya mũũndanĩ ĩtina wa akethi: na esa kũwĩla kĩlungu kya mũũnda kĩla kyaĩ kya Mboasi, ũla waĩ wa mũvĩa wa Elimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.129.7"
              },
              "items": [
                {
                  "text": "Sav 129.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.129.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, Mboasi auma Mbethi‐leemu, na amea akethi, Yeova nĩethĩwe vamwe nenyu. Namo mamũsũngĩa, Yeova nakũathime. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Mboasi wamũkũlilye ũla mũthũkũmi wake wamwiĩte kũũngamĩa akethi, Mwĩĩtu ũũ nĩ waũ? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.5",
            "verseOrgIds": [
              "RUT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthũkũmi ũsu waiĩtwe kũũngamĩa akethi asũngĩa na amwĩa, Nĩ ũla mwĩĩtu Mũmoavi wokie na Naomi kuma nthĩ ya Moavi: ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.6",
            "verseOrgIds": [
              "RUT.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.22"
              },
              "items": [
                {
                  "text": "Lu 1.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.6",
            "verseOrgIds": [
              "RUT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake asya, Nĩngũkwĩsũva, nenga mwanya nĩkolanĩlye nũmban’ye ĩtina wa akethi katĩ wa syove. Na ĩndĩ ooka, na atindie kuma kĩoko kũvika o na yu, ate o ĩvinda ĩvũthũ wekalangile nyũmbanĩ.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Mboasi wamwĩie Luthi, Ndũkwĩw’a, mwĩĩtu wakwa? Ndũkathi kũkolan’ya mũũndanĩ ũngĩ, o na ndũkaume vaa, ĩndĩ ĩkala vaa vakuvĩ na athũkũmi makwa eĩtu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.8",
            "verseOrgIds": [
              "RUT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metho maku nĩmasisye mũũnda o ũla meũketha, naku ũmaatĩĩe: ndimatavisye anake asu maikakũkiite? Naku weew’a waũni thi vala ve ĩkuu ũnyw’e kĩla anake matavĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.9",
            "verseOrgIds": [
              "RUT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wavalũkile na ũthyũ wake, na kwĩkunamya nthĩ, na amwĩa, Nũndũ wa kĩ nyie noona ũseo vala ũĩ, na wamanya nyie, nakwa nĩ mũndũ wa nthĩ ĩngĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
            "verseOrgIds": [
              "RUT.2.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.2.19"
              },
              "items": [
                {
                  "text": "Lu 2.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.41"
              },
              "items": [
                {
                  "text": "1 Sam 25.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
            "verseOrgIds": [
              "RUT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mboasi amũsũngĩa, na amwĩa, Nĩnonetw’e vyũ onthe ala wamwĩkie inyia wa mũemeu kuma mũemeu akw’a; na ũndũ ũtiĩte au na mwenyu na nthĩ ĩla wasyaĩwe, na wũkĩte kwa andũ ala ũtamesĩ o na ĩndĩĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.11",
            "verseOrgIds": [
              "RUT.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.16"
              },
              "items": [
                {
                  "text": "Lu 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.11",
            "verseOrgIds": [
              "RUT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova nakũĩve wĩa waku, na ĩtuvi yĩanĩu wĩnengwa nĩ Yeova, Ngai wa Isilaeli, ũla wũkĩte kwĩvitha nthwaunĩ syake. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.12",
            "verseOrgIds": [
              "RUT.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
