              },
              "items": [
                {
                  "text": "Lk 1.68",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wokĩlile vamwe na aka ma ana make, asyoke kuma nthĩ ĩsu ya Moavi: nũndũ nĩwew’ĩte e ku nthĩ ya Moavi ũndũ Yeova ũmokĩe andũ make ũndũnĩ wa kũmanenga lĩu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.6",
            "verseOrgIds": [
              "RUT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake auma vandũ vau waĩ, vamwe na aka ma ana make elĩ; namo makwata nzĩa nĩ kana masyoke nthĩ ya Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.7",
            "verseOrgIds": [
              "RUT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.12"
              },
              "items": [
                {
                  "text": "Yos 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.2.20"
              },
              "items": [
                {
                  "text": "Lu 2.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Naomi amea aka ma ana make elĩ, Endai, mũsyoke kĩla ũmwe nyũmba ya inyia wake: Yeova amwĩke nesa, o tondũ inyw’ĩ mwamekie ala makwie, o nakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.3.1"
              },
              "items": [
                {
                  "text": "Lu 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova amũnenge kwona ũthũmũo, kĩla ũmwe nyũmbanĩ kwa mũũme wake. Nĩvo ĩndĩ wamamumunyie, namo mookĩlya wasya woo, na maĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamwĩa, Aiee, ĩndĩ ithyĩ twĩsyoka vamwe naku kwa andũ maku. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.10",
            "verseOrgIds": [
              "RUT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Naomi amea, Syokai, eĩtu makwa: mwĩendan’ya nakwa nĩkĩ? nĩ na ana angĩ ĩvunĩ yakwa, matonya kwĩthĩwa aũme menyu? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.11",
            "verseOrgIds": [
              "RUT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syokai, eĩtu makwa, endai kwenyu; nũndũ nyie nĩ mũtumĩu, nditonya kwĩthĩwa na mũũme ĩngĩ. O na ethĩwa nĩngwasya, Nĩ na wĩkwatyo, o na ngethĩwa na mũũme ũtukũ ũũ wa ũmũnthĩ, o na kũsyaa tũvĩsĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.12",
            "verseOrgIds": [
              "RUT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.15"
              },
              "items": [
                {
                  "text": "Kũt 2.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.15"
