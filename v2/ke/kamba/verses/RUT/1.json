            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwĩa, Sisya, mũka wa mwana‐a‐inyia wa mũemeu nĩwasyoka kwa andũ make, na kwa ngai yake: syoka naku ũmũvikĩle mũka wa mwana‐a‐inyia wa mũemeu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.15",
            "verseOrgIds": [
              "RUT.1.15"
            ]
          }
        },
