              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "vala wĩkw’ĩa, novo nĩkw’ĩa, na novo nĩthikwa: Yeova nambĩke ũu, o na mbee, ethĩwa ũndũ ũkandaan’ya naku ate o kĩkw’ũ. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
              "RUT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla wonie kana nĩweyũmbanĩtye ki kũthi nake, aeka kũneena nake.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        }
