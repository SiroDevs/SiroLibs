          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Mboasi waisye, Mũthenya ũla wĩthooa mũũnda kw’okonĩ kwa Naomi, mũvaka ũkĩthooe o ta ũu kwa Luthi ũla Mũmoavi, kĩveti kya ũla mũkw’ũ, wũkĩlye syĩtwa ya ũsu mũkw’ũ ũtiĩwanĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.5",
            "verseOrgIds": [
              "RUT.4.5"
            ]
          }
        },
        {
