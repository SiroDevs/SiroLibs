                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikaseng’e, ana‐asa, ethĩwa nthĩ nĩnĩũmũmena. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.13",
            "verseOrgIds": [
              "1JN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.11"
              },
              "items": [
                {
                  "text": "1 Yoa 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.24"
              },
              "items": [
                {
                  "text": "Yoa 5.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩtwĩsĩ kana nĩtũvĩtĩte twauma kĩkw’ũnĩ twavota thayũnĩ, nĩkwĩthĩwa nĩtũmendaa ana‐a‐asa. Ũla ũtendanaa atwĩe kĩkw’ũni. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.21"
              },
              "items": [
                {
                  "text": "Mt 5.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.44"
              },
              "items": [
                {
                  "text": "Yoa 8.44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mũndũ ũla ũmenaa mwana‐a‐ĩthe nĩ mũaani: nenyu nĩmwĩsĩ kana vai mũaani wĩ na thayũ ũtathela ũtwĩe nthĩnĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.15",
            "verseOrgIds": [
              "1JN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.1"
              },
              "items": [
                {
                  "text": "Yoa 13.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.13"
              },
              "items": [
                {
                  "text": "15.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.20"
              },
              "items": [
                {
                  "text": "Aka 2.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũndũnĩ ũũ nĩtũũmanya wendo, nũndũ we anenganie thayũ wake kwondũ witũ; naitũ nĩtwaĩle kũnengane mathayũ maitũ kwondũ wa ana‐a‐asa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.16",
            "verseOrgIds": [
              "1JN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.20"
              },
              "items": [
                {
                  "text": "1 Yoa 4.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7"
              },
              "items": [
                {
                  "text": "Kũt 15.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ o ũla wĩ na syĩndũ sya kũũ nthĩ, nake aimwona mwana‐a‐ĩthe e na vata, na ailea ũmwĩw’ĩa tei, wendo wa Ngai ũtwĩe nthĩnĩ wake ata? ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.17",
            "verseOrgIds": [
              "1JN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.22"
              },
              "items": [
                {
                  "text": "Yak 1.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.15"
              },
              "items": [
                {
                  "text": "2.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syana syakwa nini, tũikendane na ndeto, kana na ũĩmĩ; ĩndĩ twendane na kwĩka, na twendane w’o. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.18",
            "verseOrgIds": [
              "1JN.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nĩtũũmanya kana twĩ ma ũla w’o, na nĩtũtonya kũvindĩthya ngoo sitũ, twĩ mbee wake: ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.19",
            "verseOrgIds": [
              "1JN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ ethĩwa ngoo sitũ niũtũsilĩla, Ngaĩ nĩ mũnene kwĩ ngoo sitũ, na nĩwĩsĩ maũndũ onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.20",
            "verseOrgIds": [
              "1JN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.1"
              },
              "items": [
                {
                  "text": "Alo 5.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.16"
              },
              "items": [
                {
                  "text": "Aevl 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endwa, ethĩwa ngoo sitũ itiũtũsilĩla, twĩ na ũnyiau vala ve Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.21",
            "verseOrgIds": [
              "1JN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.24"
              },
              "items": [
                {
                  "text": "Mko 11.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na o ũndũ ũla tũũvoya nĩtũũnengwa nĩwe, nĩkwĩthĩwa nĩtũkwataa mĩao yake na nĩtwĩkaa maũndũ ala mamwendeeasya. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.22",
            "verseOrgIds": [
              "1JN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1JN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.29"
              },
              "items": [
                {
                  "text": "Yoa 6.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "15.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwĩao wake nĩ ũũ, kana twĩtĩkĩle syĩtwa ya Mwana wake Yesũ Klĩsto, na kwendana, o ũndũ watwĩaĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.23",
            "verseOrgIds": [
              "1JN.3.23"
            ]
