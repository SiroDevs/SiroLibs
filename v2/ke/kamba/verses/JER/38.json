            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ anene asu onthe mamũkĩe Yelemia na kũmũkũlya; nake amasũngĩa kwĩanana na ndeto ii syonthe ila mũsumbĩ wamwĩaĩe. Na ĩndĩ maeka kũneena nake; nũndũ ũvoo ndwaamanyĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yelemia ekala nza ya kolokolo kũvika mũthenya ũla Yelusaleme yosiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        },
