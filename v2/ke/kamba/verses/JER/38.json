              },
              "items": [
                {
                  "text": "1 Sam 31.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yelemia asya, Matikakũnengane. Nĩngũkwĩsũva, ĩw’a wasya wa Yeova, ũndũnĩ ũla ngũneena naku: na ĩndĩ kũkeethĩwa ũseo kwaku, na ũkekala thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa nũũlea kumaala, ĩno nĩyo ndeto ĩla Yeova ũmbonetye: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.12"
              },
              "items": [
                {
                  "text": "Yel 27.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, aka onthe ala matialile nyũmbanĩ ya mũsumbĩ wa Yuta makaumaalĩlw’a anene asu ma mũsumbĩ wa Mbaviloni, na aka asu makasya, Anyanyau ala mwĩsene nĩmaũkengete, na ũkũkĩlya vinya: yu maũũ maku malikĩte ndakanĩ, nĩmasyokete na ĩtina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.20.10"
              },
              "items": [
                {
                  "text": "Yel 20.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makaumaalĩlya Akalitei aka maku onthe, na syana syaku; naku ndũkavonoka kuma mokonĩ moo, ĩndĩ ũkakwatwa na kw’oko kwa mũsumbĩ wa Mbaviloni: na ũkatuma ndũa ĩno ĩvĩvw’a na mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        },
        {
