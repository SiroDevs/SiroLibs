              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.13",
            "verseOrgIds": [
              "JER.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ Nzetekia watũmanie, na kũmũete mwathani Yelemia vala waĩ vandũ va katatũ va kũlikĩla nyũmbanĩ ya Yeova: na mũsumbĩ amwĩa Yelemia, Nĩngũũkũlya kaũndũ; ndũkambithe ko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.14",
            "verseOrgIds": [
              "JER.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Yelemia wamũkũlilye Nzetekia, Ethĩwa ngakũvuanĩsya ko, nĩ w’o we ndwĩmbũaa? O na ethĩwa ngakũtaa, ndũkambĩthukĩĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.15",
            "verseOrgIds": [
              "JER.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mũsumbĩ Nzetekia eevĩta kwa Yelemia na kĩmbithĩ, akyasya, O tondũ Yeova wĩ thayũ, ũla watũmbĩe thayũ ũũ, ndikakũaa, o na ndikakũnengane mokonĩ ma andũ aa ala mamanthaa thayũ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.16",
            "verseOrgIds": [
              "JER.38.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
