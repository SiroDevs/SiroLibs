            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.6",
            "verseOrgIds": [
              "JER.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Mũethiovia Eveti‐meleki, mũvakũe, ũla waĩ nyũmbanĩ ya mũsumbĩ, wewie atĩ nĩmamwĩkĩĩte Yelemia yĩla ĩimanĩ (ĩvinda yĩu mũsumbĩ ekalĩte mbingĩlonĩ ya Mbenyamini), ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.7",
            "verseOrgIds": [
              "JER.38.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.3+ISA.56.4+ISA.56.5"
              },
              "items": [
                {
                  "text": "Isa 56.3–5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.27"
              },
              "items": [
                {
                  "text": "Meko 8.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.7",
            "verseOrgIds": [
              "JER.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eveti‐meleki aumaala nyũmbanĩ ya mũsumbĩ, na aneena na mũsumbĩ, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.8",
            "verseOrgIds": [
              "JER.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩaĩi wakwa mũsumbĩ, andũ asu nĩmekĩte naĩ maũndũnĩ onthe ala mamwĩkie mwathani Yelemia, ũla mamwĩkisye yĩla ĩimanĩ; na ailyĩ ta ũnũkw’ĩa vala ũĩ, nũndũ wa yũa; nũndũ vati kĩmũtũ nongi ndũanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.9",
            "verseOrgIds": [
              "JER.38.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.11.22"
              },
              "items": [
                {
                  "text": "Yel 11.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.21"
              },
              "items": [
                {
                  "text": "37.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.9",
            "verseOrgIds": [
              "JER.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ wamwĩaĩe Mũethiovia Eveti‐meleki akĩmwĩa, Osa andũ mĩongo ĩtatũ kuma vaa ũende nao, na mũyumya mwathani Yelemia ĩimanĩ, atanakw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.10",
            "verseOrgIds": [
              "JER.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Eveti‐meleki aenda na ala andũ, na alika nyũmbanĩ ya mũsumbĩ ĩtheo wa vala vaiawa ũthwii, na oosa matani na ngũa ndwĩkangu, na aitheesya na makanda yĩla ĩimanĩ vala ve Yelemia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.11",
            "verseOrgIds": [
              "JER.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mũethiovia Eveti‐meleki amwĩa Yelemia, Yu ĩkĩa matani aa na ngũa ii ndwĩkangu nzakwathanĩ syaku ungu wa makanda. Na Yelemia eeka ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.12",
            "verseOrgIds": [
              "JER.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mambatya Yelemia na makanda, na kũmumya yĩla ĩimanĩ: na ũu nĩw’o Yelemia wekalile vu nza ya kolokolo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.13",
            "verseOrgIds": [
              "JER.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
