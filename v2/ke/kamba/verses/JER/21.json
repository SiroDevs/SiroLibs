        },
        {
          "text": "Ndeto ĩla yamũkĩe Yelemia kuma kwa Yeova, yĩla mũsumbĩ Nzetekia watũmie kwake Vasuli mwana wa Malikiya, na Nzevania mwana wa mũthembi Maaseia, makĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
