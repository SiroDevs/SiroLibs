              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩw’ai ndeto ya Yeova ũndũ wa nyũmba ya mũsumbĩ wa Yuta: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova easya atĩĩ, We nyũmba ya Ndaviti, silai ũsili wa katĩ kĩoko, na kũmumya ũla ũvutĩtwe kw’okonĩ kwa ũla ũthĩnasya, ũthilĩku wakwa ndũkese kumĩla ta mwaki, na kwakana ũndũ mũndũ o na wĩva ũtatonya kũvosya, nũndũ wa ũthũku wa meko menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
