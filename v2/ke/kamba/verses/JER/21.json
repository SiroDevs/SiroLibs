          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Yelemia wameie, Ũũ nĩw’o mũkamwĩa Nzetekia: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũkwasya, Sisya, ngathyũũa mĩio ya kaũ ĩla yĩ mokonĩ menyu, ĩla mũkũkita mũsumbĩ wa Mbaviloni nayo, na Akalitei ala meũmũtwĩkanĩsya, me ũtee wa maũvai; na ngamyũmbanĩsya ndũanĩ katĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
