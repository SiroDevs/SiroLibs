            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩnamĩlutĩle ndũa ĩno ũthyũ wakwa nĩmĩke ũthũku, na ti ũseo, easya ũu Yeova: ĩkanenganwe kw’okonĩ kwa mũsumbĩ wa Mbaviloni, nake akamĩvĩvya na mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
