            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa mwene ngokita nenyu na kw’oko kũtambũũku na kw’oko kwĩ vinya, nĩ na ũthatu, na ũthilĩku, na woo mwingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
