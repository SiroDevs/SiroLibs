          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũĩmĩ woo nĩ mũsyĩ wũaaa; nũneenaa ũkengani: mũndũ nũneenaa na mũuo na mũtũi wake na kanyw’a wake, ĩndĩ ngoonĩ yake nũmwoveeasya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.8"
            ]
