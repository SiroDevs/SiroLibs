            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Yeova wa nguthu easya atĩĩ, Sisya, ngamatwekethya, na kũmatata; nũndũ naĩle kwĩka ũndũ ũngĩ wĩva, ũndũ wa mwĩĩtu wa andũ makwa? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        },
