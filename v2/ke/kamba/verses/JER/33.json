          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, ngamĩetee ũseo wa mwĩĩ na ũvosyo, na ngamavosya; na ngamon’ya wingĩ wa mũuo na w’o. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
