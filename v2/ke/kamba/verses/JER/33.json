          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngatũnga Yuta na Isilaeli maume kũtavwanĩ kwoo, na ngamatũngĩĩa, o ũndũ mailyĩ mbee. ",
          "type": "text",
          "attrs": {
