          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndeto ya Yeova yamũkĩa Yelemia, ĩkĩmũkũlya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
