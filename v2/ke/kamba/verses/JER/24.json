          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Yeova wangũlilye, Wĩona kyaũ, Yelemia? Nakwa nasya, Makũyũ; ala makũyũ maseo, maseo mũno; na ala mathũku, mathũku mũno, ala mataĩka, nũndũ wa kũthũka kwamo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
