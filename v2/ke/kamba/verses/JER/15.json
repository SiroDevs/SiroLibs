            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova easya, Ngamaiĩa mĩthemba ĩna: ũvyũ wa kũaa, na ngitĩ sya kũtembũanga, na nyũnyi sya yayaya, na nyamũ sya nthĩ, sya kũya na kwananga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
