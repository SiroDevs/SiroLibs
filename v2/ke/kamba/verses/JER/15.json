            "number": "7",
            "style": "v",
            "sid": "JER 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩnĩmaũlũkĩlye na kĩũlũkya mbingĩlonĩ sya ĩ nthĩ; nĩnĩmakw’ĩĩthĩsye syana, nĩnĩmanangĩte andũ makwa; matyaasyoka kuma mĩendelenĩ yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        },
