          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nũũ ũla ũkakwĩw’ĩa tei, we Yelusaleme? Kana nũũ ũla ũkakũmetea? Kana nũũ ũla ũkathũka ũtee aũkũlye ũndũ ũilyĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        },
        {
