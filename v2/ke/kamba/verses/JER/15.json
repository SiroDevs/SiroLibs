          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa ngamekangya kũũ na kũũ mosumbĩnĩ onthe ma nthĩ nũndũ wa Manase, mwana wa Esekia, mũsumbĩ wa Yuta, nũndũ wa ũndũ ũla wekie Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        },
