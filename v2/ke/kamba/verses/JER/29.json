              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, nũndũ wa kĩ ndwaamũkan’ya Yelemia wa Anathothi, ũla wĩtw’ĩte mwathani kwenyu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
