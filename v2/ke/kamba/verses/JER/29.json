              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwondũ wa ũu Yeova easya atĩĩ, Sisya, ngakũna Semaia ũla Mũneelami, na ũsyao wake; ndakethĩwa na mũndũ mũũme wa kwĩkala andũnĩ aa, o na ndakona ũseo ũla ngameka andũ makwa, easya Yeova, nĩkwĩthĩwa nũneeneete Yeova ndeto sya ũng’endu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
