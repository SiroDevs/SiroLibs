          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa nĩmũneenete atĩĩ, Yeova nĩwatũkĩlĩlye athani ku Mbaviloni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũũ nĩw’o Yeova ũnũkwasya ũndũ wa mũsumbĩ ũla wĩkalĩte kĩvĩlanĩ kya ũsumbĩ kya Ndaviti, na ũndũ wa andũ onthe ala matwĩe ndũanĩ ĩno, ana‐a‐ĩthe menyu ala mataathi me atave vamwe nenyu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
