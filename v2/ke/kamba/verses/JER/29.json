          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũkamantha nyie, na kũmbona, yĩla mwĩmantha na ngoo yenyu yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
