              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambata ũende ku Ngileati, noyosa seli, we mwĩĩtu mũtheu wa Misili: nũkwĩtethya na mĩtĩ mingĩ mana; vati kũvow’a kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.11",
            "verseOrgIds": [
              "JER.46.11"
            ]
          }
        },
