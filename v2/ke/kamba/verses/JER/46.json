          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasya wayo ũkanyoloka ta nzoka; nũndũ makaenda na ita, na kũmyũkĩa na mathoka, ta ala maunaa ngũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.22",
