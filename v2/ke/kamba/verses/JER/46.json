          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaĩ nĩsyĩw’ĩte ũvoo wa nthoni syaku, na nthĩ nĩyusũĩte kĩĩo kyaku; nũndũ ngũmbaũ nĩlulutĩkĩle ngũmbaũ, nivalũkĩte syelĩ vamwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        }
