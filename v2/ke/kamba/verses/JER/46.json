            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩĩtu wa Misili akasonokw’a; akanenganwe mokonĩ ma andũ ma ngalĩ ya ĩũlũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.24",
            "verseOrgIds": [
