            "number": "25",
            "style": "v",
            "sid": "JER 46:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova wa nguthu, Ngai wa Isilaeli, easya: Sisya, ngakũna Amoni wa ndũa ya No, na Valao, na Misili, vamwe na ngai syayo, na asumbĩ mayo; o Valao, na ala mamwĩkwatasya: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        },
        {
