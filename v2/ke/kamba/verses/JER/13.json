              },
              "items": [
                {
                  "text": "Isa 13.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa wĩasya ngoonĩ yaku, Maũndũ aa membũkĩa nũndũ wa kĩ? Nũndũ wa ũthũku waku kwingĩva nũvuĩtwe ngũa syaku, na itiinyo syaku nĩ ndine. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
