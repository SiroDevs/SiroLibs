                "loc": "EXO.19.5"
              },
              "items": [
                {
                  "text": "Kuma 19.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.9"
              },
              "items": [
                {
                  "text": "Yel 33.9",
