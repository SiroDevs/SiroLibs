            "number": "21",
            "style": "v",
            "sid": "JER 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkasya ata, yĩla wĩmaia methĩwe atongoi maku asu ala we mwene wamamanyĩĩsye methĩwe anyanyau? Mawoo maikakũkwata, ta ma mũndũ mũka akyaũnya? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
