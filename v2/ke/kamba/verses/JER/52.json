          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwaka wa ĩkũmi na nyanya wa kũsumbĩka kwa Nevukatilesa atwaa me atave andũ maana nyanya na mĩongo ĩtatũ na elĩ kuma Yelusaleme; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
