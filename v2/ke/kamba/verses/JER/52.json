          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na aneena nake nesa, na aia kĩvĩla kyake kya ũsumbĩ ĩũlũ wa kĩvĩla kya ũsumbĩ kya asumbĩ ala maĩ nake Mbaviloni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
