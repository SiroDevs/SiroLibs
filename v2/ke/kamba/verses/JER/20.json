                {
                  "text": "Meko 16.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ũnĩ ũsu, Vasuli amumya Yelemia mĩtĩnĩ ĩsu. Na ĩndĩ Yelemia amwĩa, Yeova ndaaĩta syĩtwa yaku Vasuli, ĩndĩ Makoli‐misavivu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Yeova ũnũkwasya, Sisya, ngakũtw’ĩkĩthya ũtĩsyo kwaku mwene, na kwa anyanyau onthe; na makavalũkw’a na ũvyũ wa amaitha moo, na metho maku makoona ũu; na nganengane Yuta onthe kw’okonĩ kwa mũsumbĩ wa Mbaviloni, na akamatava amatwae Mbaviloni, na kũmoaa na ũvyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.25"
              },
              "items": [
                {
                  "text": "Yel 6.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ũndũ ũngĩ nganengane ũthwii w’onthe wa ndũa ĩno, na motandĩthyo onthe mayo, na syĩndũ syonthe syayo syĩ vata mũno, ĩĩ, mothwii onthe maie ma asumbĩ ma Yuta nganengane kw’okonĩ kwa amaitha moo; na makamatava mũtavo, na kũmatwaa, na kũenda nao Mbaviloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.5",
            "verseOrgIds": [
              "JER.20.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
