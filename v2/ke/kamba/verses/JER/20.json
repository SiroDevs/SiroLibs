        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Vasuli wamũkũnie mwathani Yelemia, na amwoveea maũũ mĩtĩnĩ ĩla yaĩ mbingĩlonĩ ya ngalĩ ya ĩũlũ ya Mbenyamini, ĩla yaĩ nyũmbanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
