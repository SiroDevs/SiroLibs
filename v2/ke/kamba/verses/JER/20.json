            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vasuli, mwana wa mũthembi Imeli, ũla waĩ mũnene nyũmbanĩ ya Yeova, eew’a Yelemia akyathana maũndũ asu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
