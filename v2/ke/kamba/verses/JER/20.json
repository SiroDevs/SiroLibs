        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku, Vasuli, na onthe ala matwĩe nyũmbanĩ yaku mũkaenda mwĩ atave; na ũkavika Mbaviloni, na ũkakw’ĩa kw’o, na ũkenzĩwa nthĩ kw’o, we, na anyanyau onthe, ala wamathanĩe ũvũngũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
