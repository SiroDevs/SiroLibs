          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nĩmakĩte kũndũ kũtũlu kwa Mbaali, mamũvĩvĩsye Mbaali ana moo mwakinĩ methĩwe nthembo sya kũvĩvw’a; ũndũ ũla ndaawĩaa, kana kũneena, o na ndwaalika kĩlilikanonĩ kyakwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
