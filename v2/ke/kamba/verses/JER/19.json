            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa nĩmandiĩte, na matw’ĩkĩthĩtye vandũ vaa va mũeni, na kwitoeesya vaa ngai ingĩ ũvani, ila mataamanya, mo na aaĩthe moo na asumbĩ ma Yuta, na kusũsya vandũ vaa na nthakame ya ala mate na ĩvĩtyo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
