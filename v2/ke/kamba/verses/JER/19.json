        {
          "text": "Ũũ nĩw’o Yeova waisye, Enda ũthooe sũva wa yũmba wũmbĩtwe nĩ mũmbi, noyosa amwe ma atumĩa ma andũ, na ma atumĩa ma athembi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
