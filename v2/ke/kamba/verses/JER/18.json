        },
        {
          "text": "Ĩndĩ measya, Nĩ mana; nũndũ tũkaenda tũatĩĩe mũsũanĩo maitũ ene, na tũkeeka kĩla ũmwe aatĩĩe ngũlũ sya ngoo yake nthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.12",
            "verseOrgIds": [
              "JER.18.12"
            ]
          }
        },
