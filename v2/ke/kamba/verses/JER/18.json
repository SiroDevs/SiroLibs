          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ndeto ya Yeova yambũkĩa, ĩkyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "We nyũmba ya Isilaeli, nditonya kwĩka nenyu ta mũmbi ũũ? Easya ũu Yeova. Sisya, ta yũmba kw’okonĩ kwa mũmbi, now’o mũilyĩ kw’okonĩ kwakwa, inyw’ĩ nyũmba ya Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
