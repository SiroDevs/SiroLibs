              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩa ya Levanoni yĩkathela kuma ĩvianĩ yĩ mũũndanĩ? Kana manzĩ mathithu ala matheeaa kuma kũasa makang’ala? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        },
        {
          "name": "verse",
