          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ andũ makwa nĩmolĩtwe ninyie, nĩmaitoeesye ngai sya ũvũngũ ũvani; na nĩmalulutĩkĩtw’e nzĩanĩ syoo, nzĩanĩ sya tene tene, maende na nzĩa sya myathũko, nzĩa ĩte nzeũvye; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        },
