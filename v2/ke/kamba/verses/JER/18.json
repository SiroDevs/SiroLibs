          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kavinda kala nganeena ũvoo wa mbaĩ, na ũvoo wa ũsumbĩ, kũkũa, na kũomboa na kwananga; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.10"
              },
              "items": [
                {
                  "text": "Yel 1.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethĩwa mbaĩ ĩsu ĩla nĩneenete ũvoo wayo, ĩkeethyũũa na kũtia ũthũku wayo, ngeetũnga ũndũ wa ũthũku ũla nasũanĩe kũmĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
