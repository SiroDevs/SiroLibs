                "loc": "2KI.18.17"
              },
              "items": [
                {
                  "text": "2 Asu 18.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.15"
              },
              "items": [
                {
                  "text": "Yel 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
