          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Nevusalatani kavuteni wa nguthu ya asũvĩi nĩwatiie ala ngya ma andũ, ala mataĩ na kĩndũ, nthĩ ya Yuta, na amanenga mĩũnda ya mĩsavivũ na mĩũnda o ĩvinda yĩu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        },
