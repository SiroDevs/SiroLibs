            "sid": "JER 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa yĩla Yelusaleme yosiwe (mwaka wa kenda wa kũsumbĩka kwa Nzetekia mũsumbĩ wa Yuta, mwei wa ĩkũmi, Nevukatilesa mũsumbĩ wa Mbaviloni na ita syake syonthe syoka kũkita na Yelusaleme, na syamĩtw’ĩkanĩsya; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.1",
            "verseOrgIds": [
              "JER.39.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.1+2KI.25.2+2KI.25.3+2KI.25.4+2KI.25.5+2KI.25.6+2KI.25.7+2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11+2KI.25.12"
              },
              "items": [
                {
                  "text": "2 Asu 25.1–12",
                  "type": "text"
                }
              ]
            },
            {
