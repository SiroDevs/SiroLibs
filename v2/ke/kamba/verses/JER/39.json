        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwaka wa ĩkũmi na ũmwe wa kũsumbĩka kwa Nzetekia, mwei wa kana, mũthenya wa kenda wa mwei, ndũa ĩsu yavũthũwa), ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.2",
            "verseOrgIds": [
              "JER.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na anene onthe me mbee ũsumbĩnĩ ma mũsumbĩ wa Mbaviloni malika, na mekala mbingĩlonĩ ĩla yaĩ katĩ, nao nĩ aa, Nelikali‐saleseli, na Samikali‐nevo, na Salisekimu, na Lavisalisi, na Nelikali‐saleseli, na Lavimaki, vamwe na anene ala angĩ onthe ma mũsumbĩ wa Mbaviloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
