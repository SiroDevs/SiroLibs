              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Nevukatilesa mũsumbĩ wa Mbaviloni amwĩaĩa Nevusalatani kavuteni wa asũvĩi ũndũ wa Yelemia, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.11",
            "verseOrgIds": [
              "JER.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwose, noimũsũvĩa nesa, na ndũkamwĩke ũthũku; ĩndĩ mwĩke o ũndũ ũkakwĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
