              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Nevusalatani kavuteni wa asũvĩi atũmana, o na Nevusasivani, na Lavisalisi, na Nelikali‐saleseli, na Lavimaki, na anene onthe ma mũsumbĩ wa Mbaviloni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao matũmana, na maumya Yelemia vu nza ya kolokolo, na mamũnengane mokonĩ ma Ngetalia mwana wa Aikamu, mwana wa Savani, amũtwae kwake. Kwondũ wa ũu ekala na andũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
            "verseOrgIds": [
              "JER.39.14"
            ]
          }
        },
