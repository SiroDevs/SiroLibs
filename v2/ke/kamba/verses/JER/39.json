              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ndeto ya Yeova yamũkĩa Yelemia, yĩla waĩ mwove nza ya kolokolo, ĩkĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.15",
            "verseOrgIds": [
