              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla waĩ mbingilonĩ ya Mbenyamini, kavuteni wa asuvĩi aĩ vo, syĩtwa yake nĩ Iliya, mwana wa Selemia, mwana wa Aanania; nake amũkwata mwathani Yelemia, akĩmwĩa, Nũkwĩtila we ũende kwa Akalitei. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.9"
              },
              "items": [
                {
                  "text": "Yel 21.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo Yelemia waisye, Nĩ ũvũngũ; ndikwĩtila nĩende kwa Akalitei. Ĩndĩ ndaamwĩthukĩĩsya; kwondũ wa ũu Iliya amũkwata Yelemia, na amũtwaa vala vaĩ anene me mbee ũsumbĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.36.12"
              },
              "items": [
                {
                  "text": "Yel 36.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene asu mamũthilĩkĩla Yelemia, na mamũkũna, na mamwĩkĩa kolokolonĩ nyũmbanĩ ya mũandĩki Yonathani; nũndũ nĩmamĩtw’ĩkĩthĩtye kolokolo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
