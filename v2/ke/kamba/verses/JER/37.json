          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla ita sya Akalitei syaumie Yelusaleme ũndũ wa ũkĩa ita sya Valao, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ Yelemia waumie Yelusaleme aende nthĩ ya Mbenyamini, kwosa kĩanda kyake kw’o, katĩ wa andũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
