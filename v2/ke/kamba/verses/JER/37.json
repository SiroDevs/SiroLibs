          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Nzetekia atũma Yeukali mwana wa Selemia, na Nzevania mwana wa mũthembi Maaseia, mathi kwa mwathani Yelemia, akĩmwĩa, Mũvoye Yeova Ngai waitũ kwondũ witũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelemia nĩwalikaa na kumaalaa andũnĩ; nũndũ matyaĩ manamwĩkĩa kolokolonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
