              "type": "tag",
              "attrs": {
                "loc": "JER.32.8"
              },
              "items": [
                {
                  "text": "32.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
