            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ ndeto ya Yeova yamũkĩe mwathani Yelemia, ĩkyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũkwasya, Ũũ nĩw’o mũkamwĩa mũsumbĩ wa Yuta, ũla wamũtũmie kwakwa mũngũlye: Sisya, ita sya Valao, ila syũkĩte kũmũtethya, ikasyoka Misili nthĩ yoo ene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "note",
