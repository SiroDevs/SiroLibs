          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ we, kana athũkũmi make, kana andũ ma nthĩ ĩsu, matyaaĩthukĩĩsya ndeto sya Yeova, ila waneenie na kanyw’a wa mwathani Yelemia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        },
