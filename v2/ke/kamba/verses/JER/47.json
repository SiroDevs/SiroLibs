            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũvaa nĩwũkĩte ndũanĩ ya Ngasa; Asikeloni nĩ mbanangĩku vyũ, nayo nĩ ũtialo wa mwanda woo: ũkeetemanga kũvika ĩndĩĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.37"
              },
              "items": [
                {
                  "text": "Yel 48.37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ũvyũ wa Yeova, kũkeethĩwa ĩvinda yĩana ata kũvika yĩla wĩvindya? Ĩtũngĩe ndoonĩ yaku; thũmũa, noivindya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.41"
              },
              "items": [
                {
                  "text": "Kũt 32.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtonya kũvindya ata, nũndũ Yeova nũkũnengete wĩaĩo? Ĩũlũ wa Asikeloni, na ĩũlũ wa ũkanga ũtee, nĩ vo waũtw’ĩĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        },
