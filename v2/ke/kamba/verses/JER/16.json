                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.4"
              },
              "items": [
                {
                  "text": "Osea 9.4",
                  "type": "text"
                }
              ]
            },
            {
