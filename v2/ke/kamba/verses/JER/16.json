              "items": [
                {
                  "text": "Yovu 1.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
