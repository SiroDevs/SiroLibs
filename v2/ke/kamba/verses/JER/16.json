            "sid": "JER 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Yeova ũnũkwasya, Ndũkalike nyũmbanĩ ya kũĩĩa, o na ndũkathi kũmeta, kana kũmaĩĩa; nĩnumĩtye mũuo wakwa kwa andũ aa, o ũseo wĩ wendo na tei mwololo, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
