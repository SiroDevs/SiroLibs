            "number": "11",
            "style": "v",
            "sid": "JER 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ ũkamea, Yeova easya, Nĩkwĩthĩwa aaĩthe menyu nĩmandiĩte, na kũatĩĩa ngai ingĩ, na kwithũkũma, na kwithaitha, na kũndia, na matyaakwata mĩao yakwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
