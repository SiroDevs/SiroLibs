            "number": "10",
            "style": "v",
            "sid": "JER 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yeova nĩ Ngai wa w’o; nake nĩ Ngai wĩ thayũ na Mũsumbĩ wa tene na tene: nthĩ nĩtetemaa kwondũ wa ũthilĩku wake, na mbaĩ ititonya kũmĩĩsya ũthatu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        },
