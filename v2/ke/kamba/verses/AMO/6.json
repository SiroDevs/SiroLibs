              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu yu makaenda me atave vamwe na ala metavwa mbee; na kĩsekele kya ala meekootaa kĩkathela. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.47.4"
              },
              "items": [
                {
                  "text": "Sav 47.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.14"
              },
              "items": [
                {
                  "text": "Yel 51.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩaĩi Yeova nĩwevĩtie nake mwene, easya ũu Yeova, Ngai wa nguthu: Nĩngũthĩtha ũnene wa Yakovo, na nĩngũmena nyũmba nene syake mbanakavye; kwondũ wa ũu nganengane ĩ ndũa na syonthe ila syĩ nthĩnĩ wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.3"
              },
              "items": [
                {
                  "text": "Amo 8.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, ethĩwa vakatiala andũ ĩkũmi nyũmbanĩ ĩmwe, makakw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.14"
              },
              "items": [
                {
                  "text": "2 Mav 16.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.13"
              },
              "items": [
                {
                  "text": "Amo 5.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla mwendw’a‐ĩthe wa mũndũ ũla mũkw’u wĩũkĩlya ĩ kimba, aumye mavĩndĩ nyũmbanĩ, o ũsu wĩkĩvĩvya, na akakũlya ũla wĩ kũndũ kwĩ nthĩnĩ kwa nyũmba, Ve o ũmwe wĩ naku? Nake akasũngĩa, Aiee; nĩvo ĩndĩ wĩasya, Kilya ki; nũndũ tũtitonya kũweta syĩtwa ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.15"
              },
              "items": [
                {
                  "text": "Amo 3.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ, sisya, Yeova nĩwaĩaĩte, na nyũmba ĩla nene ĩkakũnwa ĩye mawatũe, na nyũmba ĩla nini ĩye mawatũku.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
