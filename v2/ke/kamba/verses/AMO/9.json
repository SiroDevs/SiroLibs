            "number": "5",
            "style": "v",
            "sid": "AMO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Mwĩaĩi, Yeova wa nguthu, nĩwe ũla ũkiitaa nthĩ na ĩkĩtweka, na onthe ala mamĩtwĩe makameta; na ĩkookĩla vyũ ta ũla Ũsĩ, na ĩkalika ĩngĩ, ta Ũsĩ wa Misili; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.46.6"
              },
              "items": [
                {
                  "text": "Sav 46.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩwe ũla wakaa nyũmba syake matunĩ, na kũlũlũmĩlya mwambĩlĩlyo wa ũtũo wake nthĩ; ũla wĩtaa manzĩ ma ũkanga moke, na akĩmatulũla ĩũlũ wa nthĩ; Yeova nĩyo syĩtwa yake. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
