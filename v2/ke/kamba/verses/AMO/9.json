        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athe onthe na andũ makwa makooawa na ũvyũ, ala maasya, Ũla ũthũku ndũkatũkwata, o na kũkomana naitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.10",
            "verseOrgIds": [
              "AMO.9.10"
            ]
          }
        },
