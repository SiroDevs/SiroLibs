                "loc": "ACT.15.16+ACT.15.17+ACT.15.18"
              },
              "items": [
                {
                  "text": "Meko 15.16–18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        },
        {
