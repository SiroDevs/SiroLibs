            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na makenza kũvika Seoli, kw’oko kwakwa kũkamaumya o vo; o na makambata ĩtunĩ, ngamatũnga nthĩ kuma vo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.139.8"
              },
              "items": [
                {
                  "text": "Sav 139.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.139.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na makeevitha ene kĩĩmanĩ kya Kalimeli ĩũlũ, ngamantha na kũmaumya o vo; o na me avithe kyũngũnĩ kya ũkanga ndikamone, o vo ngeeaĩa nzoka, na ĩkamaũma. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na makaenda mbee wa amaitha moo me atave, o vo ngeeaĩa ũvyũ, na ũkamoaa: na ngamaketeea na metho makwa nĩmeke naĩ, na ndimeka nesa. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
