          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũsu ngaũngamya wĩkalo wa Ndaviti ũla mũvalũku, na kũlinda mawatũe maw’o; na ngatũngĩĩa kũla waombokie, na ngootũngĩĩa o tondũ watilyĩ mĩthenya ya tene; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
