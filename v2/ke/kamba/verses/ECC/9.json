            }
          ]
        },
        {
          "text": "O na nĩnonete ũĩ ĩtheo wa syũa ta ũũ, na wooneka kwakwa ta mũnene: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.13",
