        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ũla kw’oko kwaku kwona wa kwĩka, ĩka na vinya waku, nũndũ kũti wĩa kana ũsũanĩo, kana ũmanyi, kana ũĩ, Seoli vala ũendete. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        },
