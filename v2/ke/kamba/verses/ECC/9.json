        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wendo woo, o na kĩmena kyoo na kĩwĩu kyoo, nĩsyaaie tene mũno; o na mati na kĩanda ĩngĩ tene na tene ũndũnĩ o na wĩva ũla wĩkawa ĩtheo wa syũa",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        }
      ]
