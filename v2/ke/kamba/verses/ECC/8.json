          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ kũtikethĩwa ũseo kwa ũla mũthũku o nake ndakongeleela mĩthenya yake, ĩla ĩilyĩ ta muunyĩ; nĩkwĩthĩwa ndakĩaa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.13",
            "verseOrgIds": [
              "ECC.8.13"
            ]
          }
        },
