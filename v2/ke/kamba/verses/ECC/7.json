          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla wĩ kw’o, wĩ kũasa na ũliku mũno; nũũ ũtonya kũmanya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
