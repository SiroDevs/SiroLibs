              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ mavinda maingĩ ngoo yaku nayo nĩyĩsĩ kana we mwene nũumĩte angĩ.",
          "type": "text",
          "attrs": {
