                {
                  "text": "Mũta 5.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
              "ECC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũndũ ũla Ngai ũmũnengae ũthwii, na syĩndũ mbingĩ, na ndaĩa, na kwondũ wa ũu vati kĩndũ kĩoleku kya kyonthe kĩla ũnũkwenda ũndũ wa thayũ wake, ĩndĩ Ngai ndamũnengaa ũtonyĩ wa kwiĩsaa, ĩndĩ mũeni nĩwiĩsaa; ũu nĩ mana, na nĩ ũwau mũthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.2",
            "verseOrgIds": [
              "ECC.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
