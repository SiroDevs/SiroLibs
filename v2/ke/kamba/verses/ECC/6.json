              "type": "text"
            }
          ]
        },
        {
          "text": "Ve ũthũku ũla nonete ĩtheo wa syũa, na nĩ mũito ĩũlũ wa andũ: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
