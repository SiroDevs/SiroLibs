        {
          "text": "O na mĩthenya yake yonthe aĩaa kĩvindunĩ, na nũthĩnaw’a mũno, na e na ũwau na ũthilĩku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
