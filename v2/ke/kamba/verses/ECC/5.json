          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ũu naw’o nĩ ũthũku wĩ woo, atĩ o ũndũ wokie, now’o ũkathi; na ũla wĩthĩnĩasya kĩseve e na ũunĩko mwaũ? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
            "verseOrgIds": [
              "ECC.5.16"
            ]
          }
        },
