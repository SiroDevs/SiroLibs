              "type": "tag",
              "attrs": {
                "loc": "PSA.104.13"
              },
              "items": [
                {
                  "text": "Sav 104.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.19",
            "verseOrgIds": [
