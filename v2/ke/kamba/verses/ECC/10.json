              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woo nĩ waku, we nthĩ, yĩla mũsumbĩ waku nĩ kana, na anene maku me mbee ũsumbĩnĩ maĩsaa kĩoko! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.3.4"
              },
              "items": [
                {
                  "text": "Isa 3.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.11"
              },
              "items": [
                {
                  "text": "5.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wĩ na ũtanu, we nthĩ, yĩla mũsumbĩ waku nĩ mwana wa andũ me ndaĩa, na anene maku me mbee ũsumbĩnĩ maĩsaa ĩvinda yaw’o, ũndũ wa vinya, na ti ũndũ wa ũthengi! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
