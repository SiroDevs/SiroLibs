            "number": "15",
            "style": "v",
            "sid": "ECC 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnoonie onthe me thayũ ala makinyaa ĩtheo wa syũa, atĩ maĩ vamwe na kĩmwana, kĩla kya kelĩ, kĩla kyaũngamĩe vandũ vake. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
              "ECC.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũtyaĩ mũmĩnũkĩlyo wa andũ onthe, o asu onthe ala waĩ ĩũlũ woo: ĩndĩ ala makooka ĩtina matikamũtanĩa. Vate ndĩĩ o na ũu naw’o nĩ mana na ta kũsemban’ya na kĩseve.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.16",
            "verseOrgIds": [
              "ECC.4.16"
            ]
          }
        }
      ]
