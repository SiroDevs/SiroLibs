          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kavaa kĩmwana kĩkya na kyũĩ kwĩ mũsumbĩ mũkũũ na mũtumanu, ũla ũtesĩ nzĩa ya kwosa ũtao ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
        {
