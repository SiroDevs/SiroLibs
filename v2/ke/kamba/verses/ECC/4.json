                {
                  "text": "Yovu 3.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩĩ, na mbee wa asu nĩmũtaĩa ũla ũtanamba kwĩthĩwa, ũla ũtaona wĩa mũthũku ũla wĩkawa ĩtheo wa syũa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
