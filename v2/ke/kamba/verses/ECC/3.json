          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩvinda ya kũĩa, na ĩvinda ya kũtheka; ĩvinda ya kũmeta, na ĩvinda ya kũsunga; ",
          "type": "text",
          "attrs": {
