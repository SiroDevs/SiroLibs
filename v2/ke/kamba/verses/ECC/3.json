        },
        {
          "text": "ĩvinda ya kũmantha, na ĩvinda ya kwasya; ĩvinda ya kũsũvĩa, na ĩvinda ya kwĩkya ũtee; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.6",
