              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onthe maendaa vandũ vamwe; onthe nĩ ma kĩtoo, na onthe masyokaa ĩngĩ kĩtoonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.20",
