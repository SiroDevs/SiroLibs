          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩsĩ vati ũndũ ũseo kwoo, kwĩ kũtana na kwĩka ũseo o yĩla me thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ nĩ mũthĩnzĩo wa Ngaĩ kana kĩla mũndũ aye na kũnyw’a, na kũtanĩa ũseo wĩanĩ wake w’onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
