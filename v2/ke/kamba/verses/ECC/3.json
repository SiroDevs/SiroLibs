          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtethya wa wĩa e na ũunĩko mwaũ ũndũnĩ ũla ũtethasya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
