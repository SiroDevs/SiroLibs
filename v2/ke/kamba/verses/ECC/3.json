            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩsĩ atĩ o ũla Ngai wĩkaa, ũkekalaa tene na tene: vati ũndũ ũtonya wongeleelwa ũndũnĩ ũsu, kana ũndũ o na wĩva kũolwa; na Ngai nĩwĩkĩte ũu, nĩ kana andũ mamũkĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.14",
            "verseOrgIds": [
              "ECC.3.14"
            ]
          }
        },
        {
