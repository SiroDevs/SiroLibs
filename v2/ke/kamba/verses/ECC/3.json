          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩvinda ya kũtembũa, na ĩvinda ya kũtuma; ĩvinda ya kũvindya, na ĩvinda ya kũneena; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.7",
            "verseOrgIds": [
