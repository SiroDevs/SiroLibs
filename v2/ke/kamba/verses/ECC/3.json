          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩvinda ya kũaa, na ĩvinda ya kũvosya; ĩvinda ya kũomboa, na ĩvinda ya kwaka; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.3",
