            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Satani auma mbee wa Yeova, na amũkũna Yovu na mĩimũ mĩthũku kuma ũnyaĩĩ wa kũũ kwake kũvika lolotya wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        },
