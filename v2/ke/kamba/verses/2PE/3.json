              "items": [
                {
                  "text": "Mwa 7.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kwondũ wa ũu nthĩ ĩla yaĩ vo yaaa, ĩkĩvwĩkwa nĩ manzĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.6",
            "verseOrgIds": [
              "2PE.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ matu ala me vo yu, na nthĩ, sĩĩwe mwaki ũndũ wa ndeto o ĩsu, ikĩsũvĩwa kũvika mũthenya wa ũsilĩlo na kwanangwa kwa andũ ala matamũkĩaa Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.7",
            "verseOrgIds": [
              "2PE.3.7"
            ]
          }
        }
      ]
