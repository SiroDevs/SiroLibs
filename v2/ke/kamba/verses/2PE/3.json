              "type": "text"
            }
          ]
        },
        {
          "text": "Endwa, valũa ũũ nĩ wa kelĩ namũandĩkĩa; na nthĩnĩ wamo elĩ nĩvindũa ilĩko syenyu sya w’o kwondũ wa ũmũlilikan’ya; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.1",
            "verseOrgIds": [
              "2PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 3:2"
          },
          "items": [
