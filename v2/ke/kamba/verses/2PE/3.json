                "loc": "1TI.4.1"
              },
              "items": [
                {
                  "text": "1 Tim 4.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.18"
              },
              "items": [
                {
                  "text": "Yuta 18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩmanya ũũ mbee, atĩ mĩthenya ya mũminũkĩlyo akaakaan’ya makooka na ũkaakaasya, makĩatĩĩa mĩmeo yoo mĩthũkũ, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.3",
            "verseOrgIds": [
              "2PE.3.3"
            ]
          }
        },
        {
