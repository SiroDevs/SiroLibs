              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa kwenda kwoo ene nĩmolawa nĩ ũũ kana kwaĩ matu kuma tene, na nthĩ ĩkwatene ũtee wa manzĩ na nthinĩ wa manzĩ, ũndũ wa ndeto ya Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.5",
            "verseOrgIds": [
              "2PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 3:6"
          },
          "items": [
