              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.17"
              },
              "items": [
                {
                  "text": "Yuta 17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana mũlilikane ndeto ila syaneeniwe tene nĩ athani atheu, na mwĩao wa Mwĩaĩi na Mũtangĩĩi ũla waetiwe nĩ atũmwa menyu: ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.2",
            "verseOrgIds": [
              "2PE.3.2"
            ]
          }
        },
        {
