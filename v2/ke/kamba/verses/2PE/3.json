            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũikolwe nĩ ũndũ ũũ ũmwe, endwa, kana mũthenya ũmwe kwa Mwĩaĩi nĩ ta myaka ngili, na myaka ngili no ta mũthenya ũmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.8",
            "verseOrgIds": [
              "2PE.3.8"
            ]
          }
        },
        {
