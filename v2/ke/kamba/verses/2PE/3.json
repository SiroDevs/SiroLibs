            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa syĩndũ isu syonthe nikanyaĩĩkw’a ũu, inyw’ĩ mwaĩle kwĩthĩwa andũ mailyĩ ata mwĩkalĩlenĩ mũtheu wa thayũ na kũmũkĩa Ngai, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.11",
            "verseOrgIds": [
              "2PE.3.11"
            ]
          }
        },
