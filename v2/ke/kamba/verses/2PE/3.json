              "attrs": {
                "loc": "MAT.24.48"
              },
              "items": [
                {
                  "text": "Mt 24.48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makyasya, Ũla watho wa kũka kwa Klĩsto ũĩva? nũndũ, kuma ĩvinda yĩla aaũmae maitũ makomie, syĩndũ syonthe iilyĩ o ũndũ syailyĩ kuma mwambĩlĩlyo wasyo kũmbwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.4",
            "verseOrgIds": [
              "2PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 3:5"
          },
          "items": [
