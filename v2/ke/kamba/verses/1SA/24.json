          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbĩavĩe yu ĩndĩ na Yeova, atĩ ndũkaveta ũsyao wakwa ĩtina wakwa, na kana ndũkananga syĩtwa yakwa yume nyũmbanĩ ya asa wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
