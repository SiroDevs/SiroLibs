          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũu nĩw’o Ndaviti wavatie andũ na ndeto isu, na ndaamaeka mamwĩke Saulo ũndũ. Na Saulo ookĩla auma ngunganĩ, na eeyĩendea. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.7",
            "verseOrgIds": [
              "1SA.24.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.44"
              },
              "items": [
                {
                  "text": "Mt 5.44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
