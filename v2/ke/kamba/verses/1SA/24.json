                "loc": "ROM.12.17"
              },
              "items": [
                {
                  "text": "Alo 12.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
