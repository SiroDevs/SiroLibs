            "sid": "1SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla Saulo wasyokie kuma kũmaatĩĩa Avilisiti, kwatavanw’a kwake, kũkyaw’a, Sisya, Ndaviti e weũnĩ wa Eni‐ngeti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.1",
            "verseOrgIds": [
              "1SA.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Saulo oosa andũ ngili itatũ manyuvĩtwe kuma Isilaeli onthe, na athi amanthe Ndaviti na andũ make mavianĩ ma mbũi sya kĩthekanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.2",
            "verseOrgIds": [
              "1SA.24.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.26.2"
              },
              "items": [
                {
                  "text": "1 Sam 26.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.2",
            "verseOrgIds": [
              "1SA.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na avika syengonĩ sya malondu nzĩanĩ, vala vaĩ ngunga; na Saulo alika evw’ĩke maũũ make. Na yu Ndaviti na andũ make nĩmekalĩte kũndũ kwĩ nthĩnĩ mũno ngunganĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.3",
            "verseOrgIds": [
              "1SA.24.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.24"
              },
              "items": [
                {
                  "text": "Asi 3.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.3",
            "verseOrgIds": [
              "1SA.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ ma Ndaviti mamwĩa, Sisya, mũthenya nĩ ũũ ũla Yeova wakwĩie, Sisya, nganengane mũmaitha waku kw’okonĩ kwaku, na ũkamwĩka o ũndũ wĩona wĩ ũseo. Nĩvo ĩndĩ Ndaviti wũkĩlile na atila mũthya wa ngũa ndasa ya Saulo kĩmbithĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.4",
            "verseOrgIds": [
              "1SA.24.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.4.14"
              },
              "items": [
                {
                  "text": "Asi 4.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.26.8"
              },
              "items": [
                {
                  "text": "1 Sam 26.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.4",
            "verseOrgIds": [
              "1SA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ĩtina ngoo ya Ndaviti yamũthĩn’ya, nũndũ nĩwatila mũthya wa ngũa ya Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.5",
            "verseOrgIds": [
              "1SA.24.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.10"
              },
              "items": [
                {
                  "text": "2 Sam 24.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.5",
            "verseOrgIds": [
              "1SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amea andũ make, Yeova ndakandeke nĩke mwĩaĩi wakwa, mwĩtĩkĩw’a mauta wa Yeova, ũndũ ũũ, kũmũtambũũkĩsya kw’oko kwakwa, nũndũ nĩ mwĩtĩkĩw’a mauta wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.3"
              },
              "items": [
                {
                  "text": "1 Sam 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.26.9"
              },
              "items": [
                {
                  "text": "26.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
