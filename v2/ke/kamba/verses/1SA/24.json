            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.7",
            "verseOrgIds": [
              "1SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaviti nake ookĩla ĩtina, na auma ngunganĩ, na amwanĩĩsya Saulo, akyasya, Mwĩaĩi wakwa, mũsumbĩ Na yĩla Saulo wasiisye ĩtina, Ndaviti akunamya ũthyũ wake nthĩ, na kwĩkunamya vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.8",
            "verseOrgIds": [
              "1SA.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amwĩa Saulo, Wĩthukĩĩasya ndeto sya andũ nĩkĩ, makyasya, Sisya, Ndaviti nũmanthaa kũkwĩka naĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.9",
            "verseOrgIds": [
              "1SA.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya ũmũnthĩ metho maku nĩmonie ũndũ Yeova ũkũnenganie kw’okonĩ kwakwa ũmũnthĩ wĩ ngunganĩ; na amwe mambĩa nĩkũae; ĩndĩ itho yakwa yakũeka; na nasya, Ndikatambũũkĩa mwĩaĩi wakwa kw’oko kwakwa; nũndũ nĩ mwĩtĩkĩw’a mauta wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.10",
            "verseOrgIds": [
              "1SA.24.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
