              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.12",
            "verseOrgIds": [
              "1SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tondũ nthimo ya ala ma tene ĩkwasya, Ũthũku nĩwumaa kwa ala athũku; ĩndĩ kw’oko kwakwa kũtikethĩwa ĩũlũ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.13",
            "verseOrgIds": [
              "1SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũsumbĩ wa Isilaeli aumĩte aatĩĩe ũũ? Ũatĩĩaa ũũ we? Ũatĩĩaa ngitĩ ngw’ũ, ũatĩĩaa ngala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
            "verseOrgIds": [
              "1SA.24.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
