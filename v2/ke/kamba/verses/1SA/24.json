              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.10",
            "verseOrgIds": [
              "1SA.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na mbee wa ũu, asa wakwa, sisya, ĩĩ, sisya mũthya wa ngũa yaku ndasa kw’okonĩ kwakwa; nũndũ o ũndũ natila mũthya wa ngũa ngũanĩ yaku ndasa, na ndinakũaa, manya na kwona ki kana vati ũthũku o na ĩvĩtyo kw’okonĩ kwakwa, na kana ndikũvĩtanĩsye, o na kau nũmanthaa thayũ wakwa ũmbene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.11",
            "verseOrgIds": [
              "1SA.24.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.3"
              },
              "items": [
                {
                  "text": "Sav 7.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.11",
            "verseOrgIds": [
              "1SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova nasilan’ye katĩ wakwa naku, na Yeova andĩvanĩsye vala ũĩ; ĩndĩ kw’oko kwakwa kũtikethĩwa ĩũlũ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.12",
            "verseOrgIds": [
              "1SA.24.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
