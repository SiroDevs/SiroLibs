              "items": [
                {
                  "text": "2 Sam 9.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
            "verseOrgIds": [
              "1SA.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova nĩethĩwe mũsili ĩndĩ, na aitw’a sila katĩ wakwa naku, na akyona, na akĩndetea, na akĩmbonokya kw’okonĩ kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
              "1SA.24.15"
            ]
          }
        },
