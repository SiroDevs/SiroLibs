              },
              "items": [
                {
                  "text": "1 Sam 5.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
              "1SA.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ala matwĩe Yavesi‐ngileati meewie ũvoo wake ũndũ Avilisiti mamwĩkie Saulo, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.11",
            "verseOrgIds": [
              "1SA.31.11"
            ]
          }
        },
