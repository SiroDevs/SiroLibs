          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maia mĩio yake ya kaũ nyũmbanĩ ya Asetalothi; na maathĩĩa kimba kyake ũvainĩ wa Mbethi‐sani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
              "1SA.31.10"
            ]
          }
        },
        {
