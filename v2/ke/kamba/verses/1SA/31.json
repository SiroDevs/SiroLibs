          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "andũ ngũmbaũ onthe mookĩla, na maenda ũtukũ w’onthe, na maumya kimba kya Saulo na simba sya ana make ũvainĩ wa Mbethi‐sani; na mavika Yavesi, na maivĩvĩsya vo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.12",
            "verseOrgIds": [
              "1SA.31.12"
            ]
          }
        },
