            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ ma Isilaeli mauma Misiva, na mamakũa Avilisiti, na mamakũna, mũvaka mavika ĩtheo wa Mbethi‐kali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
    },
    {
