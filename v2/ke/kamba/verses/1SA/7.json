              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Samueli amasilanasya Isilaeli matukũ onthe ma thayũ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
