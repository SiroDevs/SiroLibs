          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ana ma Isilaeli maveta Mbaalimu na Asetalothi, na mamũthũkũma Yeova e weka.",
          "type": "text",
          "attrs": {
