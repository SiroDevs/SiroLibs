              "attrs": {
                "loc": "1SA.10.17"
              },
              "items": [
                {
                  "text": "1 Sam 10.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
