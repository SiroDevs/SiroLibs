            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Samueli amea, Ũmban’yai Isilaeli onthe Misiva, na ngavoya Yeova nũndũ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
