            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo moombana ku Misiva, na matava kĩw’ũ, na mamwĩtĩa Yeova nthĩ, na matĩĩa kũya mũthenya ũsu, na maĩsya vau, Nĩtũvĩtanĩsye Yeova. Na Samueli amasilanĩlasya ana ma Isilaeli ku Misiva. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
