              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Samueli wosie ĩvia, na ayĩũngamya katĩ wa Misiva na Seni, na eeta syĩtwa yavo Eveni‐eseli, akyasya, Kũvika yu Yeova nũtũtethetye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
