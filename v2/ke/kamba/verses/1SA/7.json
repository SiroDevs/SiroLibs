          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, atĩ ĩvinda yaĩ ĩasa kuma mũthenya ũla yĩla ĩsandũkũ yekalaa ku Kiliathi‐yealimu; nũndũ yaĩ myaka mĩongo ĩlĩ: na nyũmba yonthe ya Isilaeli yamũĩĩa Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        }
      ]
