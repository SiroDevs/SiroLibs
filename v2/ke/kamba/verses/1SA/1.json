                "loc": "EXO.23.14"
              },
              "items": [
                {
                  "text": "Kuma 23.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.1"
              },
              "items": [
                {
                  "text": "Yos 18.1",
                  "type": "text"
                }
              ]
            },
            {
