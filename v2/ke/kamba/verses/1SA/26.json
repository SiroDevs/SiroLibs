          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu ĩndĩ, nthakame yakwa ndĩkavalũke nthĩ kuma kũla kwĩ Yeova: nũndũ mũsumbĩ wa Isilaeli nĩwumaalĩte amanthe ngala o ta ũmwe ũsyĩmaa ngwae iĩmanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        },
