          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Ndaviti wasũngĩie na akũlya Aimeleki Mũititi, na Avisai mwana wa Nzeluia, mwana‐a‐inyia wa Yoavu, akyasya, Ũla wĩtheea nakwa kwa Saulo mwakonĩ wa maeema nũũ? Na Avisai amwĩa, Nyie nĩngũtheea naku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.9+JDG.7.10+JDG.7.11"
              },
              "items": [
                {
                  "text": "Asi 7.9–11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.18"
