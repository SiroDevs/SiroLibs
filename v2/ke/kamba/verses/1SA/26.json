                "loc": "1SA.14.50"
              },
              "items": [
                {
                  "text": "1 Sam 14.50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.20"
