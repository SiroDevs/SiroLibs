            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Ndaviti na Avisai mavika kũla kwĩ andũ ũtukũ: na, sisya, Saulo akomete too katĩ wa vala vandũ vaĩ makasya, e na ĩtumo yake yĩtonyete nthĩ mũtwenĩ wake; na Avineli na andũ makomete mamũthyũlũlũkĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.7",
            "verseOrgIds": [
              "1SA.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Avisai wamwĩie Ndaviti, Ngai nũnenganĩte mũmaitha waku kw’okonĩ kwaku ũmũnthĩ: yu ĩndĩ, nĩngũkwĩsũva, eka nĩmũtonyanĩsye na nthĩ na ĩtumo ĩtonya o yĩmwe, na ndimũtonya ĩvinda ya kelĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
