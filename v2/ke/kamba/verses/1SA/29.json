            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ anene me mbee ũsumbĩnĩ ma Avilisiti mamũthilĩkĩla; na anene me mbee ũsumbĩnĩ ma Avilisiti mamwĩa, Tũngĩthya ũ mũndũ, nĩ kana asyoke vandũ vake vala ũmũtw’ĩĩte, na ndũkamũeke atheee naitũ kaũnĩ, ndakese ũtũtw’ĩkĩa nthũ kaũnĩ: nũndũ mũndũ ũũ akeyĩw’anĩthya na mwĩaĩi wake ata? Ti o na mĩtwe ya andũ aa? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.4",
            "verseOrgIds": [
              "1SA.29.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
