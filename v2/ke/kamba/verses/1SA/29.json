            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ anene me mbee ũsumbĩnĩ ma Avilisiti makũlilye, Aevelania meĩka ata vaa? Na Akisi amea anene me mbee ũsumbĩnĩ ma Avilisiti, Ũũ ti Ndaviti, mũthũkũmi wa Saulo mũsumbĩ wa Isilaeli, ũla wĩkalĩte nakwa matukũ asu, kana o myaka ĩsu, na ndyaaona ĩvĩtyo nthĩnĩ wake kuma yĩla wetilile ooka kwakwa kũvika ũmũnthĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.27.7"
              },
              "items": [
                {
                  "text": "1 Sam 27.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.27.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
