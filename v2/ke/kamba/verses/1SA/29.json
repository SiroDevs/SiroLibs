              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Akisi wamwĩtie Ndaviti, na amwĩa, O tondũ Yeova wĩ thayũ, nĩwĩthĩĩtwe mũlũngalu, na kumaala kwaku na kũlika kwaku vamwe nakwa nguthunĩ nĩ kũseo vala nĩĩ; nũndũ ndyaaona ũthũku nthĩnĩ waku kuma mũthenya ũla wookie kwakwa kũvika ũmũnthi: ĩndĩ ala eaĩi matyonaa wĩ mũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.20.3"
              },
              "items": [
                {
                  "text": "1 Sam 20.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũũ ĩndĩ syoka, na ũkĩthi na mũuo, nĩ kana ndũkew’ĩthye eaĩi ma Avilisiti woo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.7",
            "verseOrgIds": [
              "1SA.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti akũlya Akisi, Ĩndĩ nĩkĩte ata? Na wonete ata mũthũkũminĩ waku ĩvinda yĩu yonthe nĩthĩĩtwe vala ũĩ kũvika ũmũnthĩ, kana ndikatonye kũthi na kũkita na amaitha ma mwĩaĩi wakwa mũsumbĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.8",
            "verseOrgIds": [
              "1SA.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Akisi asũngĩa na amwĩa Ndaviti, Nĩnĩsĩ wĩ mũseo kwakwa, o ta mũlaĩka wa Ngai: ĩndĩ vamwe na ũu anene me mbee ũsumbĩnĩ ma Avilisiti nĩmaĩtye, Ndakaenda naitũ kaũnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.9",
            "verseOrgIds": [
              "1SA.29.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
