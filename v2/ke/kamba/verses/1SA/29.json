        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Ndaviti ookĩla tene, we na andũ make, nĩ kana mathi kĩoko, masyoke nthĩ ya Avilisiti. Na Avilisiti mambata ku Yesileeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.11",
            "verseOrgIds": [
              "1SA.29.11"
            ]
