          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eaĩi ma Avilisiti maenda mbee me maana, na me ngili ngili, na Ndaviti na andũ make maenda ĩtina me na Akisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.3"
              },
              "items": [
                {
                  "text": "Yos 13.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.1"
              },
              "items": [
                {
                  "text": "1 Sam 28.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
