            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla waminie kũneena na Saulo, ngoo ya Yonathani yakwatana na ngoo ya Ndaviti, na Yonathani amwenda o tondũ wĩyendete mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
