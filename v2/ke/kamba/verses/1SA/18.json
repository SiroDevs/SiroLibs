          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kweethĩwa atĩ ĩvinda yĩla Melavu, mwĩĩtu wa Saulo, waĩlĩte kũnengwa Ndaviti, anengwa Atilieli Mũmeolathi ethĩwe mũka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
