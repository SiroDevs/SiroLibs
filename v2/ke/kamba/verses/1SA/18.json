          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saulo amũkĩa Ndaviti mũno mbee; na Saulo aĩ mũmaitha wa Ndaviti ĩndĩ yonthe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
