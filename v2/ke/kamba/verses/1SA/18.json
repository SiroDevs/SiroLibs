          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saulo oona na amanya kana Yeova aĩ vamwe na Ndaviti; na Mikali, mwĩĩtu wa Saulo, nĩwamwendete. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
