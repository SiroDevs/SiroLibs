              "items": [
                {
                  "text": "20.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saulo nĩwamũkĩaa Ndaviti, nĩkwĩthĩwa Yeova aĩ vamwe nake, na nĩwamũekete Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
