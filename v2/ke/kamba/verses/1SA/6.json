        },
        {
          "text": "Na ĩsandũkũ ya Yeova yaĩ nthĩ ya Avilisiti myei mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.1",
            "verseOrgIds": [
