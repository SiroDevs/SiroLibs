              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mailĩĩla ĩsandũkũ ya Yeova ĩkasyanĩ ĩũlũ, na kasandũkũ ke na mbĩa sya thaavu na mĩvw’anano ya mĩimũ yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.11",
            "verseOrgIds": [
              "1SA.6.11"
            ]
          }
        },
