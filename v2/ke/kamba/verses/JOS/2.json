            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosua mwana wa Nuni atũma andũ elĩ kuma Sitimu na kĩmbithĩ makathiane, akĩmea, Endai, mũsisye nthĩ, na Yeliko. Na mathi, na malika nyũmba ya ĩlwaya yĩla syĩtwa yayo yeetawa Laavi, na makoma vo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
