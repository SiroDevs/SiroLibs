          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩtwĩw’ĩte ũndũ Yeova wang’alĩthisye manzĩ ma Ũkanga Mũtune mbee wenyu, yĩla mwaumie Misili; na ũla mweekie asumbĩ elĩ ma Aamoli, Sioni na Oku, ala maĩ mũingo wa Yolotani, ala mwooaie vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.10",
            "verseOrgIds": [
              "JOS.2.10"
            ]
          }
        },
