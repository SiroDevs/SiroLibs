            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu ĩndĩ, nĩngũmwĩsũva mbĩavĩei na Yeova, nĩkwĩthĩwa nĩmwĩkie nesa, inyw’ĩ nenyu mwĩmĩka nesa nyũmba ya nau, na mũkĩnenga ũvano ũla wa w’o; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.18"
              },
              "items": [
                {
                  "text": "Yos 2.18",
                  "type": "text"
                }
              ]
            },
