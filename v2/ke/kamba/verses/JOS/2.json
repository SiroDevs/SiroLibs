            "number": "2",
            "style": "v",
            "sid": "JOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ wa Yeliko atavw’a, akĩw’a, Sisya, nĩkwalika kũũ andũ ma ana ma Isilaeli ũtukũ ũũ mathiane nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ wa Yeliko atũmana kwa Laavi, akĩmwĩa, Umaalya andũ ala mokie kwaku, ala malikile nyũmba kwaku; nũndũ nĩmokie mathiane nthĩ yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla mũndũ mũka oosa andũ asu elĩ, na amavitha; na asya, Ĩĩ, andũ asu nĩmokie kwakwa, ĩndĩ ndinamanya kũla maumĩte: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kweethĩwa o ta ĩvinda ya kũvinga mbingĩlo, kwatuka, ala andũ maumaala; kũla andũ asu mathi ndyĩsĩ: maatĩĩei mĩtũkĩ; nũndũ nĩmũũmakwata. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ aĩ anamatwaa kĩalanĩ ĩũlũ, na ũmavitha na ũa wa katane ũla walanĩtye kĩalanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ asu mamaatĩĩa nzĩanĩ ĩelete Yolotani kũvika masyũkonĩ: na o yĩla asu mamaatĩĩe maumaalile, mavinga mbingĩlo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
