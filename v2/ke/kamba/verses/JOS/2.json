          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa nũũweta ũndũ ũũ witũ, nĩvo ĩndĩ tũkethĩwa tũte na ĩvĩtyo wĩvĩtonĩ waku ũla watuma twĩvĩta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
              "JOS.2.20"
            ]
          }
        },
        {
