              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla mbaĩ yonthe yaminie kũinga Yolotani vyũ, Yeova aneena na Yosua, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osa andũ ĩkũmi na elĩ kuma andũnĩ, kuma kĩla mbaĩ mũndũ ũmwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
