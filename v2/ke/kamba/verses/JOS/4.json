          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mavia asu ĩkũmi na elĩ, ala maumisye Yolotani, Yosua amaũngamya Ngilikali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
