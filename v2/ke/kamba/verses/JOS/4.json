              "type": "tag",
              "attrs": {
                "loc": "JOS.3.12"
              },
              "items": [
                {
                  "text": "Yos 3.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũimeaĩa, ũkĩmea, Osai mavia ĩkũmi na elĩ Yolotani katĩ, kuma vandũ vala maũũ ma athembi maũngamĩte ki, nenyu mũimakua, na mũkamaie vandũ vala mwĩkoma, o vala mwĩkoma ũtukũ ũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.3",
            "verseOrgIds": [
              "JOS.4.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.2"
              },
              "items": [
                {
                  "text": "Kũt 27.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.4.8"
              },
              "items": [
                {
                  "text": "Yos 4.8",
