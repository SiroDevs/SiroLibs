                "loc": "RUT.4.1"
              },
              "items": [
                {
                  "text": "Lu 4.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũĩvanĩsya wa nthakame akamũatĩĩa, matikamũnengane ũla wũaĩte mũndũ kw’okonĩ kwake; nĩkwĩthĩwa nĩwoaie mũtũi wake atesĩ, na ndatwĩe e ũthũ nake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akekalaa ndũanĩ ĩsu, kũvika o yĩla ũkaũngama mbee wa ũmbano asilĩlwe, kũvika yĩla ũla ũkethĩwa mũthembi mũnene mĩthenya ĩsu ũkakw’a: nĩvo ĩndĩ ũla woaie mũndũ akasyoka na kũvika ndũa yake mwene, na nyũmba yake mwene, kũvika ndũa ĩla waumie yĩla wakĩie. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
