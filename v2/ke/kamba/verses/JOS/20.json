            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Yosua, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neena na ana ma Isilaeli, ũkĩmea, Ĩyiĩei ndũa sya kwĩvitha ila naneenie nenyu ũndũ wasyo na kanyw’a wa Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
