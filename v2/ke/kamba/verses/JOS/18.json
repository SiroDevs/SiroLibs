          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩlungu kya ngalĩ ya ĩtheo kyaĩ kuma mũthelelo wa Kiliathi‐yealimu; na mũvaka waumĩla kwelekela ngalĩ ya ũthũĩlonĩ wa syũa, na waumĩla wavika nthongonĩ ya manzĩ ma Nevitoa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.15",
            "verseOrgIds": [
              "JOS.18.15"
            ]
          }
        },
