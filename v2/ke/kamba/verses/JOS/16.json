          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "vamwe na ndũa ila ivathĩtwe kwondũ wa ana ma Evalaimu katĩ wa ũtiĩwa wa ana ma Manase, ndũa syonthe na mĩsyĩ yasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.9",
            "verseOrgIds": [
              "JOS.16.9"
            ]
          }
