              },
              "items": [
                {
                  "text": "Yos 18.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũvaka waumĩla kwelekela ngalĩ ya ũthũĩlonĩ wa syũa ku Mikimetha ngalĩ ya ĩũlũ; na mũvaka weelingĩla kwelekela ngalĩ ya wumĩlonĩ wa syũa kũvika Taanathi‐silo, na wavĩtĩla ũtee wayo ngalĩ ya wumĩlonĩ wa syũa ya Yanoa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.6",
            "verseOrgIds": [
              "JOS.16.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.7"
              },
              "items": [
                {
                  "text": "Yos 17.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.6",
            "verseOrgIds": [
              "JOS.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na watheea kũma Yanoa kũvika Atalothi, na kũvika Naala, na wavika Yeliko, na waumĩlĩla Yolotani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.7",
            "verseOrgIds": [
              "JOS.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuma Tavua mũvaka waendeea kwelekela ngalĩ ya ũthũĩlonĩ wa syũa kũvika kalũsĩ ka Kana; na umalĩlo waw’o waĩ ũkanganĩ. Ũsu nĩw’o ũtiĩwa wa mbaĩ ya ana ma Evalaimu kũatĩĩa mĩvĩa yoo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.8",
            "verseOrgIds": [
              "JOS.16.8"
            ]
          }
        },
        {
