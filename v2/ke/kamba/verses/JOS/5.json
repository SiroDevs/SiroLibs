            "sid": "JOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩu Yeova amwĩa Yosua, Ĩseũvĩsye tũvyũ twa ĩvia yũmũ, waĩke ana ma Isilaeli ĩngĩ ĩvinda ya kelĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
