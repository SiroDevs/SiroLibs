            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na syana syoo, ila wokĩlilye vandũ voo, nĩsyo Yosua waĩkie: nũndũ ityaĩ mbaĩke, nĩkwĩthĩwa matyaasyaĩka me nzĩanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
