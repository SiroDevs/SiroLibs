          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli mamba maeema Ngilikali; na malilikana vasaka mũthenya wa ĩkũmi na ĩna wa mwei wĩoo me ndiĩnĩ sya Yeliko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
