              "ISA.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Yeova ũnũũmbĩa, O tondũ mũnyambũ vamwe na mũnyambũ wa mũika ũlulumaa ũtũlĩte, ethĩwa aĩthi aingĩ makeetwa maende kũwũkita, ũtatevaa kwondũ wa mawasya moo, o na ũtenyivasya kwondũ wa kĩlonzo kyoo: o ta ũu Yeova wa nguthu akatheea okite kĩĩmanĩ kya Saioni, na kalĩmanĩ kakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tondũ nyũnyi ilelaa, o ta ũu Yeova wa nguthu akasũvĩa Yelusaleme; akamĩsũvĩa na kũmĩvonokya, akavĩtĩla ĩũlũ na kũmĩsũvĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.4"
              },
              "items": [
                {
                  "text": "Sav 91.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
