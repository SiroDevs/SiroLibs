            "number": "2",
            "style": "v",
            "sid": "ISA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nake nĩ mũĩ, na akaete ũthũku, na ndakaalyũla ndeto syake, ĩndĩ akamyũkĩlĩla nyũmba ya eki ma naĩ, o na akookĩlĩla ũtethyo wa ala mekaa ũthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Amisili nĩ andũ, o na ti Ngai; na mbalasi syoo nĩ nyama na ti veva: na yĩla Yeova wĩtambũũkya kw’oko kwake, ũla ũtethanasya akalulutĩka, o na ũla ũtethaw’a akavalũka, na onthe makaminwa vamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.5"
              },
              "items": [
                {
                  "text": "Yel 17.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
