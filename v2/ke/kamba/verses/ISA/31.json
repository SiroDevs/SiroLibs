            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
              "ISA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mũthenya ũsu makekya kĩla mũndũ mĩvw’anano yake ya vetha, na mĩvw’anano yake ya thaavu, ĩla moko menyu ene maseũvĩsye yĩthĩwe naĩ kwenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.7",
            "verseOrgIds": [
              "ISA.31.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.22"
              },
              "items": [
                {
                  "text": "Isa 30.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.7",
            "verseOrgIds": [
              "ISA.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mũasuli akavalũkw’a na ũvyũ, naw’o ti wa mũndũ; na ũvyũ, naw’o ti wa andũ, ũkamũmina; na akakũka akĩe ũvyũ, na anake make makeethĩwa ngombo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.35"
              },
              "items": [
                {
                  "text": "2 Asu 19.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩvia yake yĩkavĩta ũndũ wa kũtĩsw’a, na anene make me mbee ũsumbĩnĩ makateva ũndũ wa kĩvevelo, easya ũu Yeova, ũla mwaki wake wĩ Saioni, na iko yake ĩnene yĩ Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        },
