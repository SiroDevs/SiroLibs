              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.5"
              },
              "items": [
                {
                  "text": "Isa 1.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.15"
              },
              "items": [
                {
                  "text": "30.15",
                  "type": "text"
                }
