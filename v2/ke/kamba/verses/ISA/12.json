            "sid": "ISA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mũkatava manzĩ na ũtanu ithimanĩ sya ũtangĩĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        },
        {
