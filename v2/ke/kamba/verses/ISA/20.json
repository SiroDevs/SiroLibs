        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova asya, O tondũ mũthũkũmi wakwa Isaia ũendete e mũthei na maũũ mathei myaka ĩtatũ ethĩwe wonan’yo na ũseng’yo ũndũ wa Misili na ũndũ wa Ethiovia; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
