            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ngunĩ na nzee ikamĩtũa; na ndundu na ngũngũũ ikekala kw’o: na akatambũũkya ĩũlũ wayo ũlii wa kĩthokoo, na kavilũ ka vathei. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makameta anene mayo me ndaĩa moke ũsumbĩnĩ, ĩndĩ o na ũmwe ndakethĩwa vo; na anene mayo onthe me mbee ũsumbĩnĩ matikethĩwa kĩndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.12",
            "verseOrgIds": [
              "ISA.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mĩw’a ĩkamea nyũmbanĩ nene mbanakavye syayo, syĩnyeelya na thangila ngomenĩ syayo; na ĩkeethĩwa ũtũo wa mbĩwa, na wĩkalo wa nyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.13",
            "verseOrgIds": [
              "ISA.34.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.21"
              },
              "items": [
                {
                  "text": "Isa 13.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.32.13"
              },
              "items": [
                {
                  "text": "32.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.13",
            "verseOrgIds": [
              "ISA.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyamũ mbai sya weũnĩ ikoombana na nzũi, na mbũi ya kĩthekanĩ ĩkanĩsya ĩla ĩngĩ; ĩĩ, mũnyũũ ũkatũa kw’o, na kwĩyonea vandũ va ũthũmũa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.14",
            "verseOrgIds": [
              "ISA.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndundu nene ĩkaaka ndala yayo kw’o, na kũlekya matumbĩ, na kũvw’ĩkĩa yalĩkye, na kũmbanĩa muunyĩnĩ wa vo; ĩĩ, vau nĩvo imangaũ syĩũmbanĩa, kĩla kĩmwe na mũũme wakyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.15",
            "verseOrgIds": [
              "ISA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
