          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka ũla mũsumbĩ Usia wakwie nyie nĩnoonie Mwĩaĩi ekalĩte kĩvĩlanĩ kya ũsumbĩ, kĩtũlu na kyũkĩlĩtw’e; na ngũa yake ya mũnyelele yausũĩte ĩkalũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
