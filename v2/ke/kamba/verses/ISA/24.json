        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthĩnĩ wa ndũa kũtiĩtwe ĩanzo, na mbingĩlo nĩ ngũne nĩ wanangĩko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.12",
            "verseOrgIds": [
              "ISA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kũkeethĩwa ũu katĩ wa nthĩ katĩ wa ngo sya andũ, ta kũthingithangw’a kwa mũthata, ta mothean’yo yĩla ngetha ya mũũnda wa mũsavivũ yathela. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
