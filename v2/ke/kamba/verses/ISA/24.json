      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nasya, Nĩngũsonzoma, nĩngũsonzoma, woo nĩ wakwa! Ala nzeleke nĩmekĩte ũseleke; ĩĩ, ala nzeleke nĩmekĩte ũseleke mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        },
        {
