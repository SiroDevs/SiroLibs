        },
        {
          "text": "Nthĩ nĩ ndũlĩkangu, nthĩ nĩ mbatũkangu, nthĩ nĩthingithĩkĩte na vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.19",
