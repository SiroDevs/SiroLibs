              "type": "text"
            }
          ]
        },
        {
          "text": "W’ĩa, na ĩima, na kĩtei, nikwoveesye, we ũla ũtwĩe nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.17",
