            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu nĩmakokĩlya mawasya moo, makanĩĩsya; kwondũ wa ũnene wa Yeova nĩmokĩlasya wasya mũnene me ũkanganĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.14",
            "verseOrgIds": [
              "ISA.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mũtaĩei Yeova wumĩlonĩ wa syũa, o syĩtwa ya Yeova, Ngai wa Isilaeli, ithamanĩ syĩ ũkanganĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
