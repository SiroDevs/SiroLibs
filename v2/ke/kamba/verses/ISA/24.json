          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuma kĩtulunĩ kya nthĩ nĩtwĩw’ĩte mbathi: Ndaĩa kwa ala alũngalu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
