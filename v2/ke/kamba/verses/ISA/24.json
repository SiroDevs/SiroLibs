        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
