            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthĩ nĩnĩũmeta na kũthelekelya, nthĩ yonthe nĩnĩũleela na kũthelekelya, andũ me na wĩng’athĩlĩlyo kũũ nthĩ nĩmeũleela. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
