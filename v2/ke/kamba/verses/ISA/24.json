            "sid": "ISA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthĩ ĩkatw’ĩka nthei vyũ, na ĩkaanangwa vyũ; nũndũ Yeova nũneenete ndeto ĩno. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        },
        {
