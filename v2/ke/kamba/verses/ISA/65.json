            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, nĩkũandĩkĩtwe mbee wakwa: Ndikavindya, ĩndĩ ngaĩvanĩsya, ĩĩ, ngaĩvanĩsya kĩthũinĩ kyoo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.6",
            "verseOrgIds": [
              "ISA.65.6"
            ]
          }
        },
        {
