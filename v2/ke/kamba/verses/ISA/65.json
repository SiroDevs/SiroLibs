              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saioni ĩkeethĩwa kĩsesi kya ndĩthya sya mbũi na malondu, na mwanda wa Akoli vandũ va ndĩthya sya ng’ombe kũtindiaa, kwondũ wa andũ makwa ala mamanthie nyie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.10",
            "verseOrgIds": [
              "ISA.65.10"
            ]
          }
        },
