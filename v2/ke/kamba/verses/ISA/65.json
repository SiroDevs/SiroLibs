          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngaumya ũsyao nthĩnĩ wa Yakovo, na mũtiĩwa wa iĩma syakwa kuma nthĩnĩ wa Yuta; na anyuve makwa makatiĩwa yo, na athũkũmi makwa makatũaa kw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.9",
            "verseOrgIds": [
              "ISA.65.9"
            ]
          }
        },
        {
