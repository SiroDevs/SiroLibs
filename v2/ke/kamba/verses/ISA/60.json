              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.12",
            "verseOrgIds": [
              "ISA.60.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 60:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaĩa ya Levanoni ĩkooka vala ũĩ, mũtĩ wa mũsonovali, na mũtindali, na mũtĩ wa mũvuena vamwe, yanakavye vandũ vakwa vatheu; na ngaseũvya vandũ va maũũ makwa vethĩwe va ndaĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.13",
            "verseOrgIds": [
              "ISA.60.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.19"
              },
              "items": [
                {
                  "text": "Isa 41.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.13",
            "verseOrgIds": [
              "ISA.60.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 60:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma ala makũthĩnisye makooka vala ũĩ makĩkwĩkunamĩsya; na onthe ala makũvũthisye makeekunamya nyaĩĩnĩ syaku; na makakwĩta, Ndũa ya Yeova, Saioni ya Ũla Mũtheu wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.14",
            "verseOrgIds": [
              "ISA.60.14"
            ]
          }
        },
