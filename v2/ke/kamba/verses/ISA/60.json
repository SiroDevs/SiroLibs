          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 60:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mbaĩ na ũsumbĩ ũla ũleaa ũkũthũkũma ũkaaa; ĩĩ, mbaĩ isu ĩkaanangwa vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.12",
            "verseOrgIds": [
              "ISA.60.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
