        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbingĩlo syaku ikeethĩwa mbingũe mavinda onthe; itikavingwa mũthenya kana ũtukũ; nĩ kana andũ makũetee ũthwii wa i mbaĩ, na asumbĩ moo me atave. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        },
        {
