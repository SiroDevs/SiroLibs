            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya makeethĩwa ta mavuthĩ; mwaki ũkamavĩvya; matiketangĩĩa kuma vinyanĩ wa ũmũĩ: ndũkethĩwa ĩkaa ya kwota, o na mwaki wa kũthengeewa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        },
        {
