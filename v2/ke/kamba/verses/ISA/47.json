          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku wasya, Ngeethĩwa vivi tene na tene; kwondũ wa ũu ndwaaia maũndũ aa ngoonĩ yaku, o na ndwaalilikana mũminũkĩlyo wamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
