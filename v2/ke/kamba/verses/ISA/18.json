        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syonthe vamwe ikatiĩwa nyũnyi mbai sya iĩmanĩ, na nyamũ sya nthĩ; na nyũnyi isu mbai ikekala ĩũlũ woo ĩvinda ya syũa, na nyamũ syonthe sya nthĩ ikekala ĩũlũ wasyo ĩvinda ya mbevo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩu mũthĩnzĩo ũkaetewe Yeova wa nguthu kuma andũnĩ aasa na atendeu, o kuma andũnĩ ma kũtĩsya kuma wambĩlĩlyo woo kũvika na yu, mbaĩ ĩla ĩthimaa na kũkinyanga, ĩla nthĩ yayo yatũanganĩtw’e nĩ mbũsĩ, kũvika vandũ va syĩtwa ya Yeova wa nguthu, kĩĩma kya Saioni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        },
