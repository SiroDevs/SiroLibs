              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Yeova ũnũkwasya, Nĩmwathooiw’e mana; na mũkoovow’a vate mbesa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
