          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvangũle kĩtoo; ũkĩla nokĩkala kĩvĩlanĩ kyaku kya ũsumbĩ, we Yelusaleme: ĩthasye syĩndũ ila wovetwe nasyo ngingonĩ yaku, we, mwĩĩtu mũtave wa Saioni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
