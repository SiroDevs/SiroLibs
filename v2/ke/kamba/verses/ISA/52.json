          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya, Mbee andũ makwa nĩmatheeie Misili mekale ũeni kw’o: na Mũasuli nũmathĩnĩtye vate kĩtumi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
