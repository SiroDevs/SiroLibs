              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amũka, amũka, ĩkĩa vinya waku, we Saioni; ĩkĩa ngũa syaku nzeo, we Yelusaleme, ndũa ntheu; nũndũ kuma yu ala mate aĩke na ala mate atheu matikalika nthĩnĩ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        },
