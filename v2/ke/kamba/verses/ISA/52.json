          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu andũ makwa makamanya syĩtwa yakwa: kwondũ wa ũu mũthenya ũsu makamanya kana ninyie ũla ũneenaa; sisya, ninyie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        },
