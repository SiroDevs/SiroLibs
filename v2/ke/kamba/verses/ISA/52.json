            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
