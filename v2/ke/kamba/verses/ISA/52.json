          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasya wa asyaĩĩsya maku! Nĩmokĩlasya wasya, nĩmainaa vamwe; nũndũ makoonana itho kwa itho, yĩla Yeova wĩsyoka Saioni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        },
