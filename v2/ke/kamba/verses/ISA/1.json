            "number": "2",
            "style": "v",
            "sid": "ISA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩw’ai, inyw’ĩ matu, na tea kũtũ, we nthĩ; nũndũ Yeova nũneenete: niniĩthĩtye syana na kũea, nasyo nimbaĩte matũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.2",
            "verseOrgIds": [
              "ISA.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
