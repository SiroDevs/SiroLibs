          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kwanangwa kwa avĩtan’ya na andũ athe kũkethĩwa ĩvinda yĩmwe, na ala mamũtiaa Yeova makaminwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.28",
            "verseOrgIds": [
              "ISA.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ makasonoka ũndũ wa mĩtĩ ya myaloni ĩla mwendie, mũkathokoanw’a ũndũ wa mĩũnda ĩla mũnyuvĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.29",
            "verseOrgIds": [
              "ISA.1.29"
            ]
          }
        },
