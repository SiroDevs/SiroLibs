          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saioni ĩkoovow’a na sila wa katĩ, na andũ mayo ala maalyũlile ngoo makoovow’a na ũlũngalu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.27",
            "verseOrgIds": [
              "ISA.1.27"
            ]
          }
        },
        {
