          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vetha waku nũtw’ĩkĩte makwaũ ma vetha, mbinyu yaku nĩvulanĩtw’e na manzĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.22",
