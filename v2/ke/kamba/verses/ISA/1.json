              "attrs": {
                "loc": "NUM.28.9"
              },
              "items": [
                {
                  "text": "Mot 28.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.11"
