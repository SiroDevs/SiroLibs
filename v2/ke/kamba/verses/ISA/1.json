              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.2",
            "verseOrgIds": [
              "ISA.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’ombe nĩyĩsĩ mwene wayo, na ĩng’oi vandũ va kũĩthĩw’a nĩ vwana wayo; ĩndĩ Isilaeli ndesĩ, andũ makwa matisũanĩaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.3",
            "verseOrgIds": [
              "ISA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A! Mbaĩ mbathe, andũ ala makuĩte ũthũku, ũsyao wĩki wa naĩ, syana ila syĩkaa ũthũku! Nĩmamũtiĩte Yeova, nĩmamũvũthĩtye Ũla Mũtheu wa Isilaeli, nĩmevathĩte na kũsyoka na ĩtina. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.4",
            "verseOrgIds": [
              "ISA.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.24"
              },
              "items": [
                {
                  "text": "Isa 5.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.5"
              },
              "items": [
                {
                  "text": "Esek 14.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.4",
            "verseOrgIds": [
              "ISA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ wa kĩ mũũkũnangwa kũvika na yu, nĩ kana mũendeee na kũng’enda? Mũtwe w’onthe nĩ mũwau, na ngoo yonthe nĩ ndevu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.5",
            "verseOrgIds": [
              "ISA.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.30"
              },
              "items": [
                {
                  "text": "Yel 2.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.3"
              },
              "items": [
                {
                  "text": "5.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.5",
            "verseOrgIds": [
              "ISA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuma ũnyaĩĩ wa kũũ o na kũvika mũtwe vati vandũ vaima; no mawũkite, na maiĩsya, na makũna ma mĩtũkĩ: matyaatumwa, kana kwovwa, kana kwololow’a na mauta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.6",
            "verseOrgIds": [
              "ISA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthĩ yenyu nĩ nthei; ndũa syenyu nivĩvĩtw’e na mwaki; aeni nĩmekũmina nthĩ yenyu mwene, na nĩ nthei, o ta ĩkulumanĩtw’e nĩ aeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.7",
            "verseOrgIds": [
              "ISA.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.51"
              },
              "items": [
                {
                  "text": "Kũt 28.51",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.11"
              },
              "items": [
                {
                  "text": "Isa 6.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.12"
              },
              "items": [
                {
