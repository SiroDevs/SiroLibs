              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.13",
            "verseOrgIds": [
              "ISA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoo yakwa nĩmenaa myei yenyu mĩtisu, na mboka syenyu ila itw’ĩtwe; nasyo nĩ mũio kwakwa; nĩnĩnoete nĩ kwikua. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.14",
            "verseOrgIds": [
              "ISA.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla mwĩtambũũkya moko menyu, ngavitha metho makwa ndikamwone; ĩĩ, yĩla mwĩvoya mboya mbingĩ, ndikethukĩĩsya: moko menyu nĩmausũĩte nthakame. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.15",
            "verseOrgIds": [
              "ISA.1.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
