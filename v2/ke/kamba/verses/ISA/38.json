              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o ũandĩko wa Esekia mũsumbĩ wa Yuta, yĩla wavoie ũwau wake, ũla wawaĩte.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.20",
            "verseOrgIds": [
              "ISA.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Isaia aĩ ananeena, Nĩmose kakũmbwa ka makũyũ, na makailĩĩle mũimũnĩ wĩthĩwe mũtĩ, nake akavoa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.21",
            "verseOrgIds": [
              "ISA.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Esekia aĩ ananeena ũndũ ũngĩ, Wonan’yo nĩ wĩva kana ngambata nyũmbanĩ ya Yeova?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.22",
            "verseOrgIds": [
              "ISA.38.22"
            ]
          }
        }
      ]
    }
