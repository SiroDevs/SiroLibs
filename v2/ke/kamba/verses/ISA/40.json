              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩĩ, matyaavandwa; ĩĩ, matyaavuĩwa; ĩĩ, kĩtina kyoo kĩtyaatambũũkya mĩi nthĩ: o na ĩngĩ amaveveea, maivova, na kĩlingi kĩimatwaa ta mavuthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.24",
            "verseOrgIds": [
              "ISA.40.24"
            ]
          }
        },
