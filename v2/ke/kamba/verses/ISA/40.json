              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyeki nĩyũmaa, na ĩlaa nĩyĩvovaa, nũndũ mĩthũmũ ya Yeova nĩyĩveveaa; vate ndĩi andũ nĩ nyeki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.7",
            "verseOrgIds": [
              "ISA.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyeki nĩyũmaa, na ĩlaa nĩyĩvovaa; ĩndĩ ndeto ya Ngai waitũ ĩkekala tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.8",
            "verseOrgIds": [
              "ISA.40.8"
            ]
          }
        }
