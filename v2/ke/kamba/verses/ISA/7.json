              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkethĩwa mũthenya ũsu, kana mũndũ akaĩthya moi, na malondu elĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kũkethĩwa, nũndũ wa wingĩ wa ĩia yasyo akaĩsaa mauta: nũndũ kĩla mũndũ ũla wĩtiwa katĩ wa ĩ nthĩ akaĩsaa mauta na ũkĩ wa nzũkĩ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
