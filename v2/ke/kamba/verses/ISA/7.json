              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ akaendaa kw’o na mĩsyĩ na ũta, nũndũ nthĩ yonthe ĩkethĩwa’mĩtae na mĩw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
            "verseOrgIds": [
              "ISA.7.24"
            ]
          }
        },
        {
