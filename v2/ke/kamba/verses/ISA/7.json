              "ISA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Aasu ĩngĩ, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.10",
            "verseOrgIds": [
              "ISA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩtye Yeova Ngai waku wonan’yo; ĩtya ũlikunĩ, kana ũtũlunĩ ĩũlũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Aasu asya, Ndiketya, o na ndikamũtata Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake asya, Ĩw’ai yu, inyw’ĩ nyũmba ya Ndaviti: Nĩ ũndũ ũnini kwenyu kũmanosya andũ, o na mũkanosya Ngai wakwa nake? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.13",
            "verseOrgIds": [
              "ISA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Mwĩaĩi mwene akamũnenga wonan’yo: sisyai, mwĩĩtu mũtheu akaitava, na kũsyaa kavĩsĩ, nako syĩtwa yako akaketa Imanueli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
