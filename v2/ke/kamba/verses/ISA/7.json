            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkethĩwa mũthenya ũsu, Yeova akauĩsya ngi ila syĩ mĩthyanĩ ya mbũsĩ sya Misili, na nzũkĩ ila syĩ nthĩ ya Asuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasyo ikooka, na syonthe ikathũmũa myandanĩ mĩthei, na mĩvatĩnĩ ya mavia, na mbiionĩ syonthe syĩ mĩw’a, na isesinĩ syonthe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        }
      ]
