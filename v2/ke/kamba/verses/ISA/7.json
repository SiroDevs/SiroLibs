              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkethĩwa mũthenya ũsu, kĩla vandũ vala vaĩ mĩsavivũ ngili ya thooa wa sekeli ngili, vakethĩwa mĩtae na mĩw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.23",
            "verseOrgIds": [
              "ISA.7.23"
            ]
          }
        },
