          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova akaete ĩũlũ waku, na andũ maku, na nyũmba ya au, mĩthenya ĩla ĩtaamba kũka, kuma mũthenya ũla Evalaimu waumie katĩ wa Yuta — o mũsumbĩ wa Asuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
