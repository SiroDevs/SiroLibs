          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũlũngalu wakwa wĩ vakuvĩ, ũtangĩĩo wakwa nĩwumaalĩte, na moko makwa makasilĩla ngo sya andũ; ithama ikambeteela, na ikeekwatya kw’oko kwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
