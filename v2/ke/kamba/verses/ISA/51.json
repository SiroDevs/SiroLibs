        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkĩlyai metho menyu mũsisye matu, na sisyai nthĩ ĩtheo; nũndũ matu makaaa ta syũki, na nthĩ ĩkakũa ta ngũa; na ala mamĩtwĩe makakw’a o ta ũu: ĩndĩ ũtangĩĩo wakwa ũkeethĩwa tene na tene, na ũlũngalu wakwa ndũkathela. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        },
        {
