            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Yeova nũkiakiĩtye Saioni; nũkiakiĩtye kũndũ kwayo kw’onthe kwanangĩku, na nũtw’ĩkĩthĩtye weũ wayo ta Eteni, na yalata yayo ta mũũnda wa Yeova; ũtanu na mũyo ũkooneka nthĩnĩ wayo, na kũtũnga mũvea, na wasya mũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        },
        {
