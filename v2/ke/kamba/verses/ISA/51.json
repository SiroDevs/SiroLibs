          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala ovosye ma Yeova makasyoka, na kuka Saioni makina; na ũtanu ũtathelaa ũkeethĩwa mĩtwenĩ yoo: makeethĩwa na mũyo na ũtanu; na kũmaka na kũvevũũka kũkakĩa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.11",
            "verseOrgIds": [
              "ISA.51.11"
            ]
