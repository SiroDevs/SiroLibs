              },
              "items": [
                {
                  "text": "Isa 24.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kũkatiala mothean’yo, ta kũthingithangw’a kwa mũthata, tũthata twĩlĩ kana tũtatũ mũthyanĩ wa ũvonge wĩ ĩũlũ kwĩ syonthe, tũna kana tũtano mbongenĩ itambũkĩte ndee kwĩ ila ingĩ syonthe, mũtĩnĩ wĩ ũsyao, easya ũu Yeova, Ngai wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.13"
              },
              "items": [
                {
                  "text": "Isa 24.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũsu andũ makasisya Mũmbi woo, na metho moo makamũsiasya Ũla Mũtheu wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
