              "items": [
                {
                  "text": "Sav 106.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
