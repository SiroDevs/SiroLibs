              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ngito ũndũ wa Ndamasiku. Sisya, Ndamasiku nĩvetetwe ndĩkethĩwe ndũa, na ĩkeethĩwa kĩvumbu kya ũomboku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        },
        {
