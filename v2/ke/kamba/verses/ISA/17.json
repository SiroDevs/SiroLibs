          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũla ũvandaa nũvaiiaa, na kĩoko ũituma mbeũ yaku ĩlaũka; ĩndĩ ngetha nĩkĩaa mũthenya wa kĩmako na wa woo mũnene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
