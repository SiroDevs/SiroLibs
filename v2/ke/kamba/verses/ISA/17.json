                "loc": "1SA.4.21"
              },
              "items": [
                {
                  "text": "1 Sam 4.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.16"
              },
              "items": [
                {
                  "text": "Isa 7.16",
                  "type": "text"
                }
