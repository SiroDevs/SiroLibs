                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Moavĩ akameta nũndũ wa Moavi, kĩla ũmwe akameta: mũkameta nũndũ wa tũmũtũ twĩ nzavivũ twa Kili‐alesethi, mwĩ akũne vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mĩũnda ya Esivoni nĩnĩkũma, na mũsavivũ wa Sivima; eaĩi ma i mbaĩ nĩmatũlĩte mbonge nzeo syaw’o, ila syavilie o Yaseli, ila syatambie kũvika weũnĩ; nthongooo syaw’o nĩsyeenyaisye mũno, nĩkĩlĩte ũkanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.32"
              },
              "items": [
                {
                  "text": "Yel 48.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ngaĩa vamwe na andũ ma ku Yaseli ũndũ wa mũsavivũ wa Sivima; ngakũnyithya na methoi makwa, we Esivoni, na Eleale; nũndũ wasya wa kaũ nũvalũkĩle mosyao maku ma ĩvinda ya syũa na ngetha yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũyo nũvetetwe, na ũtanu nĩumĩtw’e mũũndanĩ wĩ ũsyao; na mĩũndanĩ ya mĩsavivũ kũikethĩwa kwina, kana wasya wĩ ũtanu: mũkinyangi o na wĩva ndakakinyanga nzavivũ iangĩonĩ; nĩnĩkilĩthĩtye wasya wa ngetha ya nzavivũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.33"
              },
              "items": [
                {
                  "text": "Yel 48.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ngoo yakwa nĩnĩũkaya ta mbeve kwondũ wa Moavi, na nthĩnĩ wakwa ve kĩĩo kwondũ wa Kili‐elesi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.11",
            "verseOrgIds": [
              "ISA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, yĩla Moavi wĩĩyumĩlya, yĩla wĩĩnoesya kũndũ kũtũlu, na aiũka vandũ vake vatheu avoye, ndakakĩlya vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
