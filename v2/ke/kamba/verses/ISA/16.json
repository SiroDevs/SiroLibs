          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩno nĩyo ndeto ĩla Yeova waneenie ũndũ wa Moavi ĩvinda ĩvĩtu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu Yeova nũneenete, akyasya, Nthĩnĩ wa myaka ĩtatũ, ta myaka ya mũthũkũmi, ũnene wa Moavi ũkavũthw’a, vamwe na wingĩ wa andũ make; na ũtialo ũkeethĩwa mũnini mũno na ũte vata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
        }
      ]
