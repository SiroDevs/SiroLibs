              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtwii nũtuaa ĩthoka, na kũtethya wĩa na makaa, na kũyĩseũvya na syĩiva, na kũyũmba na kw’oko kwake kwĩ vinya: ĩĩ, nĩwĩw’aa nzaa, na vinya wake nũũthela; ndanyusaa manzĩ, na nũnũũnyala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũseũvya wa mbwaũ nũtambũũkasya ũlii; nũkululaa na kĩandĩki; nũseũvasya na landa, na nũkululaa na kambasi, na nĩwũmbaa ta mũvw’anano wa mũndũ, kwĩanana na mũmbĩlw’e mũseo wa mũndũ, wĩkale nyũmbanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.13",
            "verseOrgIds": [
              "ISA.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩwĩtemeaa mĩkũũ na nĩwosaa mũtĩ wa mũtilisa na wa mwaloni, na kwĩsavĩĩa mũtĩ ũmwe katĩ wa mĩtĩ ya mũtitũ kwondũ wake mwene; nũvandaa mũsonovali, na mbua nĩyũnyithasya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.14",
            "verseOrgIds": [
              "ISA.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ ũkethĩwa wa kũvĩvw’a nĩ mũndũ; nake nĩwosaa kĩlungu kyaw’o, na aikyota; ĩĩ, nũkyakanasya, na kũua kĩmũtũ: ĩĩ, nũseũvasya ngai, na kũmĩthaitha; nũkĩtw’ĩkĩthasya mũvw’anano mwasũvye, na aivalũka mbee waw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.15",
            "verseOrgIds": [
              "ISA.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũvĩvasya kĩlungu kyaw’o na mwaki; nũĩsaa nyama na kĩlungu kyaw’o; nũkaangaa nyama, na aivũna; ĩĩ, nũkyota aiasya, Aa! Nĩngwĩw’a muutĩa, nĩnonete mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.16",
            "verseOrgIds": [
              "ISA.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩlungu kĩla kyatiala nũkĩseũvasya ngai, o mũvw’anano wake mwasũvye; nũvalũkaa mbee waw’o na kũthaitha, na kũvoya, na aiasya, Ndangĩĩa, nũndũ nue Ngai wakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        }
      ]
    },
