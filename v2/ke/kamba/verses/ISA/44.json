          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũĩsaa mũu; ngoo ĩkengetwe nĩnĩmwathũkĩtye; na ndatonya kũtangĩĩa thayũ wake, kana kũkũlya, Vati ũvũngũ kw’okonĩ kwakwa kwa aũme? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        },
