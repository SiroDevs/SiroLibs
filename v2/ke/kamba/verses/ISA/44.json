              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu ĩw’a, we Yakovo mũthũkũmi wakwa, na Isilaeli, ũla nĩnyuvĩte: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.1",
            "verseOrgIds": [
              "ISA.44.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.8"
              },
              "items": [
                {
                  "text": "Isa 41.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.1",
            "verseOrgIds": [
              "ISA.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova ũnũkwasya ũla wakũtw’ĩkĩthisye, na ũkũmbĩa ĩvunĩ, ũla ũkakũtethya: Ndũkakĩe, we Yakovo mũthũkũmi wakwa; na we Yesuluni, ũla nĩnyuvĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.2",
            "verseOrgIds": [
              "ISA.44.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
