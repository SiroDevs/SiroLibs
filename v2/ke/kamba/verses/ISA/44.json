              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.22",
            "verseOrgIds": [
              "ISA.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inai, inyw’ĩ matu, nũndũ Yeova nĩwĩkĩte ũu; ũkĩlyai wasya mũnene, inyw’ĩ kũndũ kwĩ nthĩnĩ wa nthĩ; ambĩlĩlyai kwina, inyw’ĩ iĩma, we mũtitũ, na kĩla mũtĩ wĩ nthĩnĩ: nũndũ Yeova nũmwovoetye Yakovo, na akeetaĩa nthĩnĩ wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        },
