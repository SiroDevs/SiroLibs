              "items": [
                {
                  "text": "Aka 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.2",
            "verseOrgIds": [
              "ISA.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamwĩtĩkĩsya manzĩ ũla wĩ na waũni, na ngoonosya tũlũsĩ nthĩ nyũmũ; ngatulũla Veva wakwa ĩũlũ wa ũsyao waku, na ũathimo wakwa syananĩ syaku: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.3",
            "verseOrgIds": [
              "ISA.44.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.6"
              },
              "items": [
                {
                  "text": "Isa 35.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.28"
              },
              "items": [
                {
                  "text": "Yoe 2.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.3",
            "verseOrgIds": [
              "ISA.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ikathandĩkangĩla nyekinĩ, ta mĩtĩ ĩla ĩmeaa vakuvĩ na mbũsĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.4",
            "verseOrgIds": [
              "ISA.44.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.1.3"
              },
              "items": [
                {
                  "text": "Sav 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.4",
            "verseOrgIds": [
              "ISA.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũmwe akasya, Nyie nĩ wa Yeova; na ũngĩ akeeyĩtanĩsya na syĩtwa ya Yakovo; na ũngĩ akaandĩka kw’okonĩ kwake atĩ nĩ wa Yeova, na akeenenga syĩtwa yĩngĩ ya Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.5",
            "verseOrgIds": [
              "ISA.44.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.1"
              },
              "items": [
                {
                  "text": "Isa 14.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
