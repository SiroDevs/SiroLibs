              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova, Mwovosya waku, ũla wakũmbĩe ĩvunĩ easya atĩĩ: Ninyie Yeova, ũla ũseũvasya syĩndũ syonthe; ũla ũtambũũkasya matu nĩ nyioka; ũla walanasya nthĩ (nũũ wĩ nakwa?); ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
