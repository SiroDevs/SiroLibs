          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩmamũseũvĩsye mbũa vamwe na ala athũku, o na vamwe na ũla mũthwii kĩkw’ũnĩ kyake; o na kau we ndaaĩka ũng’endu, o na vatyaĩ ũkengani kanyw’anĩ wake nongi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        },
