          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩwatonyiwe kwondũ wa mavĩtyo maitũ, auauĩkw’a kwondũ wa mothũku maitũ; ũsilĩlo ũndũ wa mũuo witũ waĩ ĩũlũ wake; naitũ nĩtũvoetw’e kwondũ wa makũnwa make. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        },
