          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla weekie maũndũ ma ũtĩsya ala tũtaasũanĩa, nĩvo watheeie nthĩ, iĩma syatetemea mbee waku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        },
        {
