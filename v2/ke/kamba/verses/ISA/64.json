          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vati ũmwe wĩkaĩlaa syĩtwa yaku, ũla wĩvindũaa mwene akwĩkwatye; nũndũ nũtũvithĩte ũthyũ waku, na nũtũminĩte kwondũ wa mothũku maitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        },
