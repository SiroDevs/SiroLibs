                  "text": "Mwa 9.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 54:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ iĩma nitonya kũthi, na tũlĩma tũtonya kũthamw’a; ĩndĩ ũseo wakwa wĩ wendo ndũkakũtia, o na ũtianĩo wakwa wa mũuo ndũkavetwa, easya ũu Yeova ũla ũkwĩw’ĩaa tei. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
