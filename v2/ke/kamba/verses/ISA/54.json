          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenevya vandũ va ĩeema yaku, na matambũũkye motũtũ ma ngũa ma mawĩkalo maku; ndũkaeke: asavya makanda maku, noiĩkĩa vinya syambo syaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        },
        {
