          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, matonya kũmbana, ĩndĩ ti kwondũ wakwa: o ũla ũkakũmbanĩa akavalũka nũndũ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.15",
            "verseOrgIds": [
              "ISA.54.15"
            ]
          }
        },
        {
