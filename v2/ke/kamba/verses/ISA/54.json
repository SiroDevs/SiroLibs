          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkakĩe; nũndũ ndũkasonoka: o na ndũkathokoanw’e; nũndũ ndũkasonokw’a: nũndũ ũkoolwa nĩ nthoni sya wana waku; na kũvũthw’a nũndũ wĩ ndiwa ndũkakũlilikana ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
