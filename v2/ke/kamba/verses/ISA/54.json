              "ISA.54.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 54:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũu ũilyĩ kwakwa ta ala manzĩ ma Noa; o tondũ neevĩtie atĩ manzĩ ma Noa matikavw’ĩka nthĩ ĩngĩ, o ta ũu nĩnĩvĩtĩte ndikakũthilĩkĩla, o na ndikakũkan’ya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
