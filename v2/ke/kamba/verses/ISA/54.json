        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũkanyaĩĩka ngalĩ ya kw’oko kwa aũme na kw’oko kwa aka; na ũsyao waku ũkoosa mbaĩ syĩthĩwe syaw’o, na kũtuma ndũa syĩ maanzo itũwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
