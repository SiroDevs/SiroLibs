              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syana sya ũtiwa waku ikaneenea matũnĩ maku atĩĩ, Vandũ vaa nĩ vatheke vaimbĩanĩa; nenga vandũ nĩtũe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.20",
            "verseOrgIds": [
              "ISA.49.20"
            ]
          }
        },
