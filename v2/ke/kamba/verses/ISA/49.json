              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ mũka nũtonya kũlwa nĩ kana kake kala kekwonga, ndakew’ĩe tei mwana wa ĩvu yake? Ĩĩ, nĩmatonya kũlwa, ĩndĩ ndikolwa nue. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.15",
            "verseOrgIds": [
