              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ambĩa, Nue mũthũkũmi wakwa; Isilaeli, ũla ngataĩwa nthĩnĩ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.3",
            "verseOrgIds": [
              "ISA.49.3"
            ]
          }
        },
        {
