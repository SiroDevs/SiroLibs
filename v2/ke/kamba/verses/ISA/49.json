          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, nĩngũvanĩte itaanĩ sya moko makwa; maũvai maku me mbee wakwa mavinda onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.16",
            "verseOrgIds": [
              "ISA.49.16"
            ]
          }
        },
        {
