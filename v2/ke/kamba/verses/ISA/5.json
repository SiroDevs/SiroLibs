              },
              "items": [
                {
                  "text": "Isa 7.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.6",
            "verseOrgIds": [
              "ISA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mũũnda wa mĩsavivũ wa Yeova wa nguthu nĩw’o nyũmba ya Isilaeli, na andũ ma Yuta nĩ mũkenge wake wa ũmwendeesya: nake nĩwamanthie sila wa katĩ, ĩndĩ, sisya, no thĩna; amantha ũlũngalu, ĩndĩ, sisya, no kĩĩo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.7",
            "verseOrgIds": [
              "ISA.5.7"
            ]
          }
        }
      ]
