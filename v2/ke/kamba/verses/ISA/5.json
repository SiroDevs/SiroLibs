        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.8",
            "verseOrgIds": [
              "ISA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matũnĩ makwa Yeova wa nguthu easya atĩĩ, Nĩ w’o nyũmba nyingĩ ikeethĩwa nthei, o ila nene na nzeo, ite na mũndũ wa kũsyĩkala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.9",
            "verseOrgIds": [
              "ISA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ matambya maana ana ma mũũnda wa mĩsavivũ makasyaa vathi ĩmwe, na omeli ĩmwe ya mbeũ ĩkasyaa eva ĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.10",
            "verseOrgIds": [
              "ISA.5.10"
            ]
          }
        },
        {
