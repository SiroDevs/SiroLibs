          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "mauumu moo nĩ moĩ, na mata moo onthe nĩ makoote; mavũngũ ma mbalasi syoo makatalwa ta mavia momũ, na ndĩa syoo ta kĩlingi: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.28",
            "verseOrgIds": [
              "ISA.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
