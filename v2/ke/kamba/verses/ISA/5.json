          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbeve na kananda, kathembe na mũtũlilũ, na mbinyu, syĩ mbokanĩ syoo; ĩndĩ matisyaĩĩasya wĩa wa Yeova, o na matiũsũanĩa wĩa wa moko make. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.12",
            "verseOrgIds": [
