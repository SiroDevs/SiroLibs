          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũluma kwoo kũkethĩwa ta kũluma kwa mũnyambũ mũka, makaluma ta mĩnyambũ ya mũika; ĩĩ, makaluma, na kũkwata sya nzyĩma, na kũkua vate mũisyo, na vaikethĩwa ũmwe wa kũvonokya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.29",
            "verseOrgIds": [
              "ISA.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 5:30"
          },
          "items": [
