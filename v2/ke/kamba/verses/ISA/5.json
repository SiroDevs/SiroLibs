          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woo nĩ wa ala mokĩlaa kĩoko tene, nĩ kana maatĩĩe kĩla kĩtoonasya; ala mekalaa kũvika ũtukũ katĩ, kũvika mbinyu ĩkwate mwaki nthĩnĩ woo! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.11",
            "verseOrgIds": [
              "ISA.5.11"
            ]
          }
        },
