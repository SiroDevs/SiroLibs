              "items": [
                {
                  "text": "Osea 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.5",
            "verseOrgIds": [
              "ISA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngootw’ĩkĩthya ĩei; ndũkasewa kana kũĩmwa; ĩndĩ ũkamesya mĩtae na mĩw’a: o na ngeeaĩa mathweo matikausye mbua ĩũlũ waw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.6",
            "verseOrgIds": [
              "ISA.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
