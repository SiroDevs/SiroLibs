        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩĩ, nzĩanĩ ya motw’ĩo maku, ame Yeova, nĩtwakweteelile; kwenda kwa ngoo sitũ nĩkwelekele syĩtwa yaku, o yĩla ya kũlilikanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
