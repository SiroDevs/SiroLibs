          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũseo wonanw’e kwa ũla mũthũku, ĩndĩ ndakemanyĩsya ũlũngalu; e nthĩ ya ũlũngalu akeekaa naĩ, na ndakona ũnene wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        },
        {
