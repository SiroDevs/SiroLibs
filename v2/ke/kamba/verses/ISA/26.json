              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova, ũkatũtw’ĩĩa mũuo; nũndũ nue wĩkĩte mawĩa maitũ onthe kwondũ witũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.12",
            "verseOrgIds": [
              "ISA.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ame Yeova Ngai waitũ, eaĩi angĩ ate o we nĩmatũsumbĩkie; ĩndĩ we wĩ weka tũkawetaa syĩtwa yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.13",
            "verseOrgIds": [
              "ISA.26.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
