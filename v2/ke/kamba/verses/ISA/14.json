          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "atĩ ngaananga Mũasuli ũla wĩ nthĩ yakwa, na kũmũkinyangĩa iĩmanĩ syakwa: nĩvo ĩndĩ ĩsoki yake yĩuma kwoo, na mũio wake wĩuma ituonĩ syoo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.25",
            "verseOrgIds": [
              "ISA.14.25"
            ]
          }
        },
