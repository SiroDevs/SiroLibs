              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova wa nguthu nĩwĩvĩtĩte, akyasya, Vate ndĩi, o ũndũ nasũanĩe, now’o kũkethĩwa; na ũndũ natwie, now’o kũkekĩka: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
              "ISA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
