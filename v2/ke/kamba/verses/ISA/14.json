              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngambata kũvĩta ũtũlu wa mathweo; ngeetw’ĩkĩthya ta Ũla Wĩ Ĩũlũ wa Onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.14",
