          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbonge sya kw’o syavova, ikatũlwa, aka makooka na kwivĩvya, nũndũ nĩ andũ mate na ũmanyi: kwondũ wa ũu ũla wamombie ndakamew’ĩa ĩnee, na ũla wamombie ndakamon’ya ũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.11",
            "verseOrgIds": [
              "ISA.27.11"
            ]
          }
        },
