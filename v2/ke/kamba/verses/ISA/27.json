        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ĩla ndũa mbiie ĩtiĩtwe yĩ yoka, ũtũo ũketwe na nĩ ĩanzo, ta weũ: kasaũ kakaĩthw’a kw’o, na kakatindia kw’o, na kũya mbonge sya kw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
        },
        {
