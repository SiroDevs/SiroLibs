          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũmakũnĩte o tondũ wakũnie asu ala mamakũnie? Kana nĩmooaiwe kwĩanana na kũawa kwa ala mooaiwe nĩmo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        },
