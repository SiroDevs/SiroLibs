                "loc": "ISA.45.1+ISA.45.2+ISA.45.3"
              },
              "items": [
                {
                  "text": "Isa 45.1–3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thengeeai vakuvĩ nakwa, ĩw’ai ũũ; kuma wambĩlĩlyonĩ ndyaaneena na kĩmbithĩ; kuma ĩvinda yĩla ũũ wambĩlĩlw’e, naĩ vo: na yu Mwĩaĩĩ Yeova, vamwe na Veva wake, nũndũmĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
