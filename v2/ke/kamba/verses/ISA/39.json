              },
              "items": [
                {
                  "text": "Nda 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Esekia wamwĩie Isaia, Ndeto ya Yeova ĩla waneena nĩ nzeo. Na aneena ĩngĩ, Kũkeethĩwa mũuo na w’o mĩthenyanĩ yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        },
        {
