      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũsumbĩ Nevukatilesa aseũvĩthya mũvw’anano wa thaavu, ũtũlu waw’o waĩ wa mĩkono mĩongo thanthatũ, na ũthanthau waw’o mĩkono thanthatũ: awũũngamya ũiĩnĩ wa Ndula, kĩlungunĩ kĩnene kya nthĩ kĩtawa Mbaviloni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mũsumbĩ Nevukatilesa atũmana kũmbanw’e asumbĩ anini, na amũli, na makavana, na asili, na asũvĩi ma ũthwii, na atai, na asilan’ya, na asumbĩki onthe ma ilungu isu nene sya nthĩ, moke kwambĩlĩya ũthaithi wa mũvw’anano ũla mũsumbĩ Nevukatilesa waĩ anaũngamya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.2",
            "verseOrgIds": [
              "DAN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ asumbĩ anini, na amũli, na makavana, na asili, na asũvĩi ma ũthwii, na atai, na asilan’ya, na asumbĩki onthe ma ilungu isu nene sya nthĩ, moombana kwambĩlĩlya ũthaithi wa mũvw’anano ũla mũsumbĩ Nevukatilesa waĩ anaũngamya; na maũngama mbee wa mũvw’anano ũla Nevukatilesa waĩ anaũngamya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũtavan’ya waneenie na wasya mũnene, Nĩ inyw’ĩ mweeaĩwa, inyw’ĩ ngo sya andũ, na mbaĩ, na ithyomo, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩvinda yĩla mwĩĩw’a wasya wa soo mũkelemu, na nzumalĩ, na mbeve, na kaveve, na kĩnanda, na mũtũlilũ, na mĩthemba yonthe ya mbeve syĩ mawasya, mwĩvalũka nthĩ na kũthaitha mũvw’anano wa thaavu ũla mũsumbĩ Nevukatilesa ũnaũngamisye; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũla ũtevalũka nthĩ na kũthaitha saa o ũsu akekw’a nthĩnĩ wa iko yĩ mwaki mwakanu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.22"
              },
              "items": [
                {
                  "text": "Yel 29.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.15"
              },
              "items": [
                {
                  "text": "Ũvu 13.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ĩvinda yĩu, ngo syonthe sya andũ syeew’a wasya wa soo mũkelemu, na nzumalĩ, na mbeve, na kaveve, na kĩnanda, na mĩthemba yonthe ya mbeve syĩ mawasya, ngo syonthe sya andũ, na mbaĩ, na ithyomo, syavalũka nthĩ na syathaitha mũvw’anano wa thaavu ũla mũsumbĩ Nevukatilesa waĩ anaũngamya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ĩvinda yĩu Akalitei amwe mathengeea, na mavinganĩsya Ayuti. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.8",
            "verseOrgIds": [
              "DAN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maneena na mamwĩa mũsumbĩ Nevukatilesa, We mũsumbĩ, ĩkala tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.4"
              },
              "items": [
                {
                  "text": "Nda 2.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku, we mũsumbĩ, nũtw’ĩte ũtw’ĩo, kana kĩla mũndũ wĩĩw’a wasya wa soo mũkelemu, na nzumalĩ, na mbeve, na kaveve, na kĩnanda, na mũtũlilũ, na mĩthemba yonthe ya mbeve syĩ mawasya, evalũka nthĩ na kũthaitha mũvw’anano ũsu wa thaavu; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na o ũla ũtevalũka nthĩ na kũthaitha, akekw’a nthĩnĩ iko yĩ mwaki mwakanu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.11",
            "verseOrgIds": [
              "DAN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ve Ayuti amwe ala waiie ĩũlũ wa maũndũ ma kĩlungu kĩnene kya nthĩ kĩtawa Mbaviloni: Satalaki, na Mesaki, na Aveti‐neko; andũ asu, we mũsumbĩ, mainakũkĩa: maithũkũmaa ngai syaku, o na maiũthaitha mũvw’anano wa thaavu ũla ũnaũngamisye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.7"
              },
              "items": [
                {
                  "text": "Nda 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.6.13"
              },
              "items": [
                {
                  "text": "6.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
