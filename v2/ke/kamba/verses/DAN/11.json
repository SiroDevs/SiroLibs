          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ yĩla mevalũka, makatetheew’a na ũtethyo mũnini; ĩndĩ aingĩ makalũman’ya nao na ndeto sya kũkathĩĩana. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.34",
            "verseOrgIds": [
              "DAN.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
