          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ we, we Ndanieli, vingĩa ndeto, na siĩla ĩvuku, o kũvika ĩvinda ya mũminũkĩlyo: aingĩ makasemba kũũ na kũũ, na ũmanyi ũkongeleka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
