            "verseOrgIds": [
              "DAN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ weaie, na maete Ndanieli, na mamwĩkya ngunganĩ ya mĩnyambũ. Mũsumbĩ aneena na amwĩa Ndanieli, Ngai waku ũla ũthũkũmaa mavinda onthe, nĩwe wĩkũtangĩĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.16",
            "verseOrgIds": [
              "DAN.6.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
