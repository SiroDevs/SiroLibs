        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ anene asu na asumbĩ anini mamanthie ũndũ wa kwilĩĩla Ndanieli maũndũnĩ ma ũsumbĩ; ĩndĩ maiaaona ũndũ o na ĩvĩtyo, nĩkwĩthĩwa aĩ na kĩthito, o na kũiaaoneka kwake ĩvĩtyo kana ũndũ ũtaĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.4",
            "verseOrgIds": [
              "DAN.6.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.14"
              },
              "items": [
                {
                  "text": "Esek 14.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.20"
              },
              "items": [
