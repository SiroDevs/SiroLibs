                "loc": "EST.1.19"
              },
              "items": [
                {
                  "text": "Est 1.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.8.8"
              },
              "items": [
                {
                  "text": "8.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.8",
            "verseOrgIds": [
              "DAN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mũsumbĩ Ndalio eekĩa ũandĩko na ũtw’ĩo saii.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
