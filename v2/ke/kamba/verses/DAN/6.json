              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Ndanieli wamanyie kana ũandĩko nĩweekĩwa saii, aenda nyũmbanĩ yake (na ĩndĩ mbũthi sya kasũmba kake syaĩ mbingũe kwelekela Yelusaleme); na atulasya ndu kĩla mũthenya katatũ, aivoya, na aitũngĩa mũvea vu mbee wa Ngai wake, o tondũ weekaa tene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.10",
            "verseOrgIds": [
              "DAN.6.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
