              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Ndanieli wasũngĩie mũsumbĩ, We mũsumbĩ, ĩkala tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.21",
            "verseOrgIds": [
              "DAN.6.21"
            ]
          }
