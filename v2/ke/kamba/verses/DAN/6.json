            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.4",
            "verseOrgIds": [
              "DAN.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ andũ asu masya, Tũikona ũndũ wa kwilĩĩla Ndanieli ũũ, ate o tũiona wa kũmwilĩĩla maũndũnĩ ma mĩao ya Ngai wake. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.5",
            "verseOrgIds": [
              "DAN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ anene asu na asumbĩ anini moombanĩe mũsumbĩ vamwe, na mamwĩa atĩĩ, Mũsumbĩ Ndalio, ĩkala tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.6",
            "verseOrgIds": [
              "DAN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anene onthe ma ũsumbĩ, o na amũli na asumbĩ anini, na atai na makavana, nĩmasũanĩĩte vamwe kwia mwamũlo wa kĩũsumbĩ, na kũtw’a ũtw’ĩo mũlũmu, kana o ũla wĩvoya ũndũ wa ngai o na yĩva kana kwa mũndũ ĩvinda ya matukũ mĩongo ĩtatũ, ate o kwaku, we mũsumbĩ, akekw’a ngunganĩ ya mĩnyambũ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.7",
            "verseOrgIds": [
              "DAN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ, we mũsumbĩ, lũmya ũtw’ĩo, na ũkĩkĩa ũandĩko saii, ndũkaalyũlwe, kwĩanana na mwĩao wa Ametia na Avelisia, ũla ũtaalyũlĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.8",
            "verseOrgIds": [
              "DAN.6.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
