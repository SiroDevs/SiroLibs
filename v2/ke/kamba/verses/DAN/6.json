              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mũsumbĩ ookĩla kĩoko tene mũno, na aenda na mĩtũkĩ ngunganĩ ya mĩnyambũ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.19",
            "verseOrgIds": [
