            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩvia yaetwe, na yaiwa mũomonĩ wa ngunga; na mũsumbĩ asiĩla na ngome yake mwene ya ũvana ũsiĩlo, na ngome ya ũvana ũsiĩlo ya eaĩi ma kwake; nĩ kana ũndũ o na wĩva ndũkaalyũlwe ũndũ wa Ndanieli. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.17",
            "verseOrgIds": [
              "DAN.6.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
