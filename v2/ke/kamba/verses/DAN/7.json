          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũsĩ wa mwaki waumĩla wumĩte kwake: ngili kũndũ ngili mamũthũkũma, na ngili ĩkũmi kũndũ ngili ĩkũmi maũngama mbee wake: ũsilĩlo waiwa, na mavuku mavuanw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
