          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũvika yĩla mũtumĩa wa matukũ wokie, na atheu ma Ũla Wĩ Ĩũlũ wa Onthe manengwa ũsili, na ĩvinda yeanĩa yĩla atheu meethĩiwe na ũsumbĩ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        }
      ]
