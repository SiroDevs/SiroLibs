              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndanieli ekala kũvika mwaka wa mbee wa kũsumbĩka kwa mũsumbĩ Kulusi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.21",
