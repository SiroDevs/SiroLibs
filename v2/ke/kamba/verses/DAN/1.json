            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mwĩaĩi anengane Yeoiakimu mũsumbĩ wa Yuta kw’okonĩ kwake, vamwe na kĩlungu kya mĩio ya nyũmba ya Ngai; nake amĩtwaa nthĩ ya Sinali nyũmbanĩ ya ngai yake: na aete mĩio nyũmbanĩ ya kwia ũthwii ya ngai yake. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
