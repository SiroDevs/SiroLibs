              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa katatũ wa kũsumbĩka kwa Yeoiakimu mũsumbĩ wa Yuta, Nevukatilesa mũsumbĩ wa Mbaviloni nĩwokie Yelusaleme, na amĩthyũlũlũka amĩtw’ĩkanĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
