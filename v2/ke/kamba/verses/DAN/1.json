            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ amwĩa Asivenasi vwana wa avakũe make, aete ana amwe ma Isilaeli, o ma nzyawa sya kĩũsumbĩ na ma ala anene me ndaĩa; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.18"
              },
              "items": [
                {
                  "text": "2 Asu 20.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "imwana ila ite kĩema, ĩndĩ syĩthĩwe na wũmbe mũseo, na ũtũĩka uĩnĩ w’onthe, syĩ na ũmanyi, na kũmanya ũĩ wa wĩmanyĩso, na ila itonya kũũngama nyũmbanĩ nene mbanakavye ya mũsumbĩ; na aimanyĩsye momanyĩsyo na kĩthyomo kya Akalitei. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ aitw’ĩa lĩu wa kĩla mũthenya wa kya ũya kĩseo kya mũsumbĩ, na mbinyu ĩla wanyusaa we mwene, iĩthw’e myaka ĩtatũ; nĩ kana mũminũkĩlyo wayo iũngame mbee wa mũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ katĩ wa ii nĩvo syaĩ, sya ana ma Yuta, Ndanieli, na Aanania, na Misaeli, na Asalia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũnene wa avakũe aitw’ĩĩa masyĩtwa: Ndanieli amwĩta syĩtwa yake Mbelitesasa; na Aanania, Satalaki; na Misaeli, Mesaki; na Asalia, Aveti‐neko. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
