                  "text": "Aka 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kwa ala mate na mĩao, neethĩwa ta nde na mĩao, tĩ atĩndyaĩ na mĩao kwa Ngai, ĩndĩ naĩ mĩaonĩ kwa Klĩsto, nĩ kana nĩmone asu mate na mĩao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.21",
            "verseOrgIds": [
              "1CO.9.21"
            ]
