                  "text": "21.20–26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa Ayuti neethĩwa ta Mũyuti, nĩ kana nĩmone Ayuti; na kwa ala me mĩaonĩ, neethĩwa ta nĩ mĩaonĩ, nde mĩaoni nyie, nĩ kana nĩmone ala me mĩaonĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.20",
            "verseOrgIds": [
              "1CO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
