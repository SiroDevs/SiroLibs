              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, nyie nĩsembaa, nde na nzika; nĩkasya ngundi, ndeũkũna vathei: ",
          "type": "text",
          "attrs": {
