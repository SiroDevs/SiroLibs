                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa syonze neethĩwa ta kyonze, nĩ kana nĩsyone syonze: nĩtw’ĩkĩte maũndũ onthe kwa andũ onthe, nĩ kana kwa nzĩa syonthe nĩtonye kũmatangĩĩa amwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.22",
            "verseOrgIds": [
              "1CO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa nĩkaa maũndũ aa onthe kwondũ wa ũla ũvoo mũseo, nĩ kana nĩthĩwe nĩ mwosi ũmwe waw’o vamwe na angĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.23",
            "verseOrgIds": [
              "1CO.9.23"
            ]
          }
        }
