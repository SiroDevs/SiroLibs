              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ w’o, ũvoo nĩ mũnyaĩĩku kana kwĩ ũlaalai katĩ wenyu, na nĩ ũlaalai ũla ũte kwa Andũ‐ma‐mbaĩ‐ingĩ, kana ũmwe wenyu e na mũka wa ĩthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.1",
            "verseOrgIds": [
              "1CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyu nĩmwĩkathĩĩe: o na mũinew’a woo, nĩ kana ũsu wĩkĩte ũndũ ũsu, avetwe katĩ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.2",
            "verseOrgIds": [
              "1CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.5"
              },
              "items": [
                {
                  "text": "Ako 2.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩ w’o, o na ethĩwa ndi vo na mwĩĩ, ĩndĩ vevanĩ nĩ vo, nyie nĩnĩminĩte kũmũsilĩla ũsu wĩkĩte ũndũ ũsu, ta nĩnaĩ kw’o mwene, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.3",
            "verseOrgIds": [
              "1CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.19"
              },
              "items": [
                {
                  "text": "Mt 16.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.18"
              },
              "items": [
                {
                  "text": "13.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.10"
              },
              "items": [
                {
                  "text": "2 Ako 13.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "syĩtwanĩ ya Mwĩaĩi waitũ Yesũ, inyw’ĩ mweethĩwa mũmbanĩte vamwe, o na vamwe na veva wakwa, na vinya wa Mwĩaĩi waitũ Yesũ, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.4",
            "verseOrgIds": [
              "1CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.20"
              },
              "items": [
                {
                  "text": "1 Tim 1.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.6"
              },
              "items": [
                {
                  "text": "1 Vet 4.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũmumya mũndũ ũilyĩ ũu na kũmũnengane kwa Satani mwĩĩ wanangwe, nĩ kana veva ũtangĩĩwe mũthenya wa Mwĩaĩi Yesũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.5",
            "verseOrgIds": [
              "1CO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.9"
              },
              "items": [
                {
                  "text": "Aka 5.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwĩkathĩĩa kwenyu ti kũseo. Mũtyĩsĩ kana ĩlawa ĩnini nĩyĩkaatasya kĩmũtũ kyonthe? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.6",
            "verseOrgIds": [
              "1CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.21"
              },
              "items": [
                {
                  "text": "Kuma 12.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.7"
              },
              "items": [
                {
                  "text": "13.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.7"
              },
              "items": [
                {
                  "text": "Isa 53.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.19"
              },
              "items": [
                {
                  "text": "1 Vet 1.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthesyei vyũ mũkyumya yĩla ĩlawa ya tene, mwĩthĩwe mũndo mweũ ki, o ta mũtekĩwe ĩlawa. Nũndũ vasaka witũ nũthembetwe, naw’o nĩ Klĩsto: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.7",
            "verseOrgIds": [
              "1CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13+EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kuma 12.3–20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwondũ wa ũu, tũvokae mboka, ti na ĩlawa ĩkũũ, o na ti na ĩlawa ya ũmaitha na ũthũku; ĩndĩ na kĩmũtũ kĩte ĩlawa, kĩtheu na kya w’o.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.8",
            "verseOrgIds": [
              "1CO.5.8"
            ]
          }
        }
      ]
    },
