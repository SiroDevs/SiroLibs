              },
              "items": [
                {
                  "text": "Ako 1.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaulo, mũtũmwa wa Klĩsto Yesũ kwĩanana na mwĩao wa Ngai Mũtangĩĩi waitũ, na Klĩsto Yesũ wĩkwatyo witũ; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.4"
              },
              "items": [
                {
                  "text": "Tito 1.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "valũa ũũ wakwa ũmũvikĩe Timotheo, mwana wakwa wa w’o nthĩnĩ wa mũĩkĩĩo: Mũmo, na tei, na mũuo, kuma kwa Ngai Asa na Klĩsto Yesũ Mwĩaĩi waitũ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
