              "1TI.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.1"
              },
              "items": [
                {
                  "text": "Meko 20.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tondũ nakwĩsũvie wĩkale Eveso, yĩla naendete Masetonia, nĩ kana ũtonye kwĩaĩa andũ amwe maikamanyĩsye ũmanyĩsyo wa mũthemba ũngĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.3",
            "verseOrgIds": [
              "1TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.7"
              },
              "items": [
                {
                  "text": "1 Tim 4.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na maikethukĩĩsye mbano na ũsyaanĩo ũte na mũminũkĩlyo, namo maetae mokũlangyo, na ti walan’yo wa Ngai ũla wĩ kwondũ wa mũĩkĩĩo; na yu nĩkwĩaĩa o ũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.4",
            "verseOrgIds": [
              "1TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.10"
              },
              "items": [
                {
                  "text": "Alo 13.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.6"
              },
              "items": [
                {
                  "text": "Aka 5.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũminũkĩlyo wa wĩaĩi ũsu nĩ wendo ũla wumaa ngoonĩ ntheu na wasyanĩ mũseo wa ngoo na mũĩkĩĩo ũte na wangangan’yo: ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.5",
            "verseOrgIds": [
              "1TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.4"
              },
              "items": [
                {
                  "text": "1 Tim 6.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na amwe makĩvĩtya maũndũnĩ asu nĩmathũkĩte ũtee kũvika kũneena mana; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.6",
            "verseOrgIds": [
              "1TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "makyenda kwĩthĩwa amanyĩsya ma ĩla mĩao, o na kau maiũmanya maũndũ asu ala maneenaa, o na kĩtina kya maũndũ ala maneenaa ta mamesĩ vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.7",
            "verseOrgIds": [
              "1TI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.12"
              },
              "items": [
                {
                  "text": "Alo 7.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ithyĩ nĩtwĩsĩ kana ĩla mĩao nĩ mĩseo, ethĩwa mũndũ ekaa nayo ũndũ ũmyaĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.8",
            "verseOrgIds": [
              "1TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akĩmanya ũũ, kana ĩla mĩao ti kwondũ wa mũndũ mũlũngalu, ĩndĩ nĩ kwondũ wa ala maleaa mĩao na ala ang’endu, nũndũ wa ala mateũmũkĩa Ngai na ala athe, nũndũ wa ala mate atheu na ala avuku, nũndũ wa ala moaa aaĩthe na ala moaa aainyia, na nũndũ wa oai, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.3"
              },
              "items": [
                {
                  "text": "1 Tim 6.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ wa ilaalai, na aũme ala mekaa naĩ na aũme angĩ, nũndũ wa ala moyaa andũ, nũndũ wa aneeni ma ũvũngũ, nũndũ wa ala mevĩtaa ũvũngũ, na ethĩwa ve ũndũ ũngĩ ũtosana na momanyĩsyo ala ma w’o; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.15"
              },
              "items": [
                {
                  "text": "1 Tim 6.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwĩanana na ũvoo mũseo wa ũtheu mũtisu wa Ngai ũla mũtaĩwa, ũvoo ũla naĩkĩĩiwe nĩsũvĩe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        }
      ]
    },
