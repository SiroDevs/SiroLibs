              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.13+GAL.1.14+GAL.1.15+GAL.1.16"
              },
              "items": [
                {
                  "text": "Aka 1.13–16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũtũngĩa mũvea ũla wandonyethisye, nake nĩ Klĩsto Yesũ Mwĩaĩi waitũ, nũndũ nĩwandalile kwĩthĩwa na kĩthito akĩndw’a wa kũmũthũkũma; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na kau na vu tene naĩ mũumi wa Ngai, na mũthĩn’ya wa andũ, na kũmeka naĩ: ĩndĩ nĩneew’ĩwe tei, nũndũ nĩneekie ndesĩ ndanamba kwĩtĩkĩla; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mumo wa Mwĩaĩi waitũ waingĩvie mũno vamwe na mũĩkĩĩo na wendo ũla wĩ nthĩnĩ wa Klĩsto Yesũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.2"
              },
              "items": [
                {
                  "text": "Lk 15.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.10"
              },
              "items": [
                {
                  "text": "19.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ndeto ya kũĩkĩĩwa, na nĩyaĩlwe nĩ kwĩtĩkĩlwa nĩ andũ onthe, kana Klĩsto Yesũ ookie kũũ nthĩ kũmatangĩĩa andũ athe; na ũla wa mbee woo, ninyie: ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ kwondũ wa ũu nĩneew’ĩwe tei, kana nthĩnĩ wakwa, nyie ũla mũthũku mbee, Yesũ Klĩsto atonye kumĩlya wũmĩĩsyo wake w’onthe, kwondũ wa ngelekan’yo kwa ala makamwĩtĩkĩla ĩtina methĩwe na thayũ ũtathela. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.16",
            "verseOrgIds": [
              "1TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.27"
              },
              "items": [
                {
                  "text": "Alo 16.27",
