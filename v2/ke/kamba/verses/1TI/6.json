              "attrs": {
                "loc": "EPH.5.5"
              },
              "items": [
                {
                  "text": "Aev 5.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ wendi wa mbesa nĩ kĩtina kya mĩthemba yonthe ya ũthũku: namo andũ amwe makĩsyenda mũno, nĩmaĩtw’e na kũtia ũla mũĩkĩĩo, na kwĩtonya ene na mawoo maingĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
      ]
