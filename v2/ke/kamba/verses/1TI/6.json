              "items": [
                {
                  "text": "2 Tim 1.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mũndũ o na wĩva amanyĩasya ũmanyĩsyo ũngĩ, na ndeũsyĩtĩkĩla ndeto syĩ na waĩlo, nasyo nĩ ndeto sya Mwĩaĩi waitũ Yesũ Klĩsto, na ũmanyĩsyo wĩanene na kũmũkĩa Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "e na ngathĩĩo, na nde ũndũ wĩsĩ, ĩndĩ mwĩkalo wake nĩ wa ũwau wa kũkũlangya na kũkananĩa ndeto, vala vaumaa kĩwĩu, na ĩteta, na kũumana, na kũtalĩlya ũthũku, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
