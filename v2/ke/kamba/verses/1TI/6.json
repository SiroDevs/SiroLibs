              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩngũkwĩaĩa mbee wa Ngai, ũla ũnengae syĩndũ syonthe thayũ, na mbee wa Klĩsto Yesũ, ũla wakũsĩĩe ũkũsĩ mũseo yĩla waĩ mbee wa Vondio Vilato; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
