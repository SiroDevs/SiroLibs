                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.14"
              },
              "items": [
                {
                  "text": "Tito 1.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na motũngĩthan’yo ma andũ ala manangĩkĩte kĩlĩkonĩ kyoo, na ala mevetee ũla w’o, makĩtalĩlya kũmũkĩa Ngai nĩ nzĩa ya kwona ũtandĩthyo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
            ]
          }
        }
      ]
