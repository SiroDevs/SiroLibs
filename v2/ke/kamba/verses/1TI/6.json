              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kũmũkĩa Ngai vamwe na kwĩanĩwa nĩ kĩla twĩ nakyo nĩ ũtandĩthyo mũnene: ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.6",
            "verseOrgIds": [
              "1TI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.5.15"
              },
              "items": [
                {
                  "text": "Mũta 5.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.21"
              },
              "items": [
                {
                  "text": "Yovu 1.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ tũtyaaũka kũũ nthĩ twĩ na kĩndũ, o na tũitonya kuma na kĩndũ; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.7",
            "verseOrgIds": [
              "1TI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.30.8"
              },
              "items": [
                {
                  "text": "Nth 30.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ tweethĩwa na kya ũya na kya kwĩvw’ika, syĩndũ isu ikatwĩanĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.8",
            "verseOrgIds": [
              "1TI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.23.4"
              },
              "items": [
                {
                  "text": "Nth 23.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.22"
              },
              "items": [
                {
                  "text": "28.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ala mekwenda kwĩthĩwa athwii nĩmavalũkaa na kũlika kũtatwanĩ na mũkwanĩ na mĩmeonĩ mingĩ ya ũtumanu na ya kũthũkya, ta ĩla ĩthikaa andũ makaa na kwanangĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.9",
            "verseOrgIds": [
              "1TI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
