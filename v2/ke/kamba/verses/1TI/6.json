              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mavindanĩ makw’o we mwene nũkonan’ya, ũla Mũtonyi mũtaĩwa e weka, Mũsumbĩ wa asumbĩ, na Mwĩaĩi wa eaĩi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.15",
            "verseOrgIds": [
