        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩmwendete, easya ũu Yeova. Ĩndĩ inyw’ĩ mwĩkũlya, Ũtwendete ũndũnĩ wĩva? Esau ndaĩ mwana‐a‐inyia wa Yakovo? Ekũlya ũu Yeova: ĩndĩ nĩnamwendie Yakovo; ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
