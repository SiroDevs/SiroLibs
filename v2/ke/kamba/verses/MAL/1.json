            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.3",
            "verseOrgIds": [
              "MAL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vala Etomu ũnũkwasya, Twĩ avalũkye nthĩ, ĩndĩ nĩtũũsyoka na tũkyaka maanzonĩ; Yeova wa nguthu easya atĩĩ, Makaaka, ĩndĩ ngang’uthũlanga; na andũ makametaa Mũvaka wa ũthũku, na Andũ ala Yeova ũmathatĩe tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na metho menyu makoona, na mũkasya, Yeova nanenevw’e mũkĩlo wa mũvaka wa Isilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        }
      ]
    },
    {
