              "type": "text"
            }
          ]
        },
        {
          "text": "Ũito wa ndeto ya Yeova kwa Isilaeli kwa kanyw’a wa Malaki.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
          }
        }
