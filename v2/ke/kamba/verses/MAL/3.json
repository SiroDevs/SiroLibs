          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuma mĩthenya ya aaĩthe menyu nĩmweelelũkile kuma motw’ĩonĩ makwa, na mũiaamasũvĩa. Nzyokeai, nakwa ngamũsyokea, easya ũu Yeova wa nguthu. Ĩndĩ inyw’ĩ mwĩkũlya, Twĩsyoka ũndũnĩ wĩva? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
