            "sid": "MAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nyie, Yeova, ndialyũkaa; kwondũ wa ũu inyw’ĩ, inyw’ĩ ana ma Yakovo, mũiminawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        },
