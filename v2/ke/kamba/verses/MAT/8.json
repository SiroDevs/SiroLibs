                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ amwĩa, Sisya, ndũkatavye mũndũ; ĩndĩ thi, ũkeyonan’ye kwa mũthembi, noiumya mũthĩnzĩo ũla Mose weaie, wĩthĩwe ũkũsĩ kwoo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.4",
            "verseOrgIds": [
              "MAT.8.4"
            ]
          }
        }
      ]
    },
    {
