              "items": [
                {
                  "text": "Yoa 4.47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na avota Kavelinaumi, mũnene wa asikalĩ ĩana ooka vala ũĩ, aimwĩsũva, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.5",
            "verseOrgIds": [
              "MAT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akyasya, Mwĩaĩi, mũthũkũmi wakwa nũkomete nyũmba awaĩte ũwau wa kwaa mamutha, na nũnũũthĩna mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.6",
            "verseOrgIds": [
              "MAT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwĩa, Ngooka na ngĩmũvosya: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.7",
            "verseOrgIds": [
              "MAT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla mũnene wa asikalĩ ĩana amũsũngĩa, asya, Mwĩaĩi, ndyĩanĩwe nue kũlika ungu wa kĩala kyakwa; ĩndĩ neena ndeto tũ, na mũthũkũmi wakwa nũnũũvoa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.8",
            "verseOrgIds": [
              "MAT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nyie nakwa nĩ mũndũ ũla wĩaĩawa, nĩ na asikalĩ makwa ĩtheo wakwa; na ngĩmwĩa ũmwe, Enda, na akĩthi; na ũngĩ, Ũka na akyũka; na ngombo yakwa, Ĩka ũna, na ĩkĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.9",
            "verseOrgIds": [
              "MAT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.28"
              },
              "items": [
                {
                  "text": "Mt 15.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ eew’a ũu, aseng’a, na amea ala mamũvikĩlĩte, Nĩw’onĩngũmwĩa, Ndyaaona mũĩkĩĩo mũnene ta ũu, aiee, o na nthĩnĩ wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.10",
            "verseOrgIds": [
              "MAT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 8:11"
          },
          "items": [
