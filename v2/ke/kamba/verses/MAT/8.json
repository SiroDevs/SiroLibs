                "loc": "ISA.53.4"
              },
              "items": [
                {
                  "text": "Isa 53.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana kwĩanĩw’e ũla waneeniwe nĩ mwathani Isaia, akyasya, We mwene nĩwosie mawonzu maitũ na akua mowau maitũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
