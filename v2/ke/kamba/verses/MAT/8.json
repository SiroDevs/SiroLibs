              "items": [
                {
                  "text": "Sav 107.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa nĩngũmwĩa, kana aingĩ makooka kuma wumĩlonĩ wa syũa na ũthũĩlonĩ wa syũa, na makekala nthĩ vamwe na Avalaamu, na Isaka, na Yakovo ũsumbĩnĩ wa ĩtu: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.11",
            "verseOrgIds": [
              "MAT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 8:12"
          },
          "items": [
