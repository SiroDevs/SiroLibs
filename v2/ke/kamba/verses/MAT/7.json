            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Votai inyw’ĩ nthĩnĩ na mbingĩlo ĩla ntheke: nũndũ mbingĩlo nĩ nthanthau, na nzĩa nĩ mbaamu, ĩla ĩelete wanangĩkonĩ, nao nĩ aingĩ ala mavotelaa mbingĩlonĩ ĩsu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 7:14"
          },
          "items": [
            {
              "text": "14",
