            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.24"
              },
              "items": [
                {
                  "text": "Mt 19.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.22"
              },
              "items": [
                {
                  "text": "Meko 14.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mbingĩlo nĩ ntheke, na nzĩa nĩ nziĩĩe, ĩla ĩelete thayũnĩ, nao nĩ avũthũ ala mamyonaa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.14",
            "verseOrgIds": [
              "MAT.7.14"
            ]
          }
        }
      ]
    },
