              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ta ũu kĩla mũtĩ mũseo nũsyaaa ũsyao mũseo; ĩndĩ mũtĩ mũthũku nũsyaaa ũsyao mũthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
