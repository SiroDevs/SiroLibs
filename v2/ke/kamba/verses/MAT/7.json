              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtĩ mũseo ndũtonya ũsyaa ũsyao mũthũku, o na mũtĩ mũthũku ndũtonya kũsyaa ũsyao mũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.18",
