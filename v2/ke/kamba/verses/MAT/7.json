            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.11+MAT.10.12+MAT.10.13+MAT.10.14"
              },
              "items": [
                {
                  "text": "Mt 10.11–14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikanenge ngitĩ kĩla kĩtheu, o na mũikekye malũlũ menyu mbee wa ngũlũe, iikese kũmakinyanga na maũũ masyo, na ĩndĩ ikĩthyũũa na kũmũtembũanga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.6",
            "verseOrgIds": [
              "MAT.7.6"
            ]
          }
        }
      ]
