            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.8+ROM.13.9+ROM.13.10"
              },
              "items": [
                {
                  "text": "Alo 13.8–10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ onthe ĩndĩno o na meva ala mũkwenda andũ mamwĩke inyw’ĩ, nenyu mekei o ta ũu: nũndũ ũu nĩw’o mĩao na athani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.12",
            "verseOrgIds": [
              "MAT.7.12"
            ]
          }
        }
      ]
    },
