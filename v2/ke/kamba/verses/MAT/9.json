          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.14"
              },
              "items": [
                {
                  "text": "Mt 14.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.34"
              },
              "items": [
                {
                  "text": "Mko 6.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.17"
              },
              "items": [
                {
                  "text": "Mot 27.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.5"
              },
              "items": [
                {
                  "text": "Esek 34.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amona makomano, amew’ĩa tei nĩkwĩthĩwa nĩmanyamaaw’a na kũnyaĩĩkw’a ta malondu mate na mũĩthi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.2"
              },
              "items": [
                {
                  "text": "Lk 10.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ amea amanyĩw’a make, Nĩ w’o ngetha nĩ nyingĩ, ĩndĩ akethi nĩ avũthũ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voyai ĩndĩ Mwĩaĩi wa ngetha, atũme akethi ngethanĩ yake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.38",
            "verseOrgIds": [
              "MAT.9.38"
            ]
          }
        }
      ]
