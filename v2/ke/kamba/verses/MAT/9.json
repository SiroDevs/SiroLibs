                "loc": "MAT.4.23"
              },
              "items": [
                {
                  "text": "Mt 4.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ anganga ndũa syonthe na mĩsyĩ, aimanyĩsya masinakokenĩ moo, na aitavan’ya ũvoo mũseo wa ũsumbĩ, na aivosya mowau ma mĩthemba yonthe na kĩla wonzu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
