                {
                  "text": "Nth 24.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Mwana wa mũndũ akooka ũtheunĩ mũtisu wa Ĩthe wake vamwe na alaĩka make; na ĩvinda yĩu akamũĩva kĩla mũndũ kwĩanana na kwĩka kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.23"
              },
              "items": [
                {
                  "text": "Mt 10.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ w’o nĩngũmwĩa, Ve andũ amwe ma aa maũngeme vaa, ala matakasama kĩkw’ũ nongi, matanamba kwona Mwana wa mũndũ akyũka ũsumbĩnĩ wake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.28",
            "verseOrgIds": [
              "MAT.16.28"
            ]
          }
        }
