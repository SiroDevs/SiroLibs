              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa Yesũ amina ndeto isu, auma Kalilii athi mĩvakanĩ ya Yutia, mũingo wa Yolotani; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
