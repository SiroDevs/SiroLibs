            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ĩyiĩei ũthwii ĩtunĩ, vala lungulu na nganga itananga, na vala ing’ei itavũthũa kana kũya: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ vala ve ũthwii waku, nĩvo vethĩawa ngoo yaku nayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.21",
            "verseOrgIds": [
              "MAT.6.21"
            ]
          }
        }
      ]
    },
