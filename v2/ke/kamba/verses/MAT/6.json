                "loc": "PSA.37.4"
              },
              "items": [
                {
                  "text": "Sav 37.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.37.25"
