            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũi mũndũ ũtonya kũthũkũma mavwana elĩ: nũndũ akamũmena ũmwe, na akamwenda ũla ũngĩ; kana akalũman’ya na ũmwe, na akamũvũthya ũla ũngĩ. Mũitonya kũthũkũma Ngai o na ũthwii. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.24",
            "verseOrgIds": [
              "MAT.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 6:25"
          },
