            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩsũvĩei mũikekae ũlũngalu wenyu mbee wa andũ, nĩ kana mwoneke nĩo: nĩkwĩthĩwa mweeka ũu, mũi na ĩtuvi kwa Ĩthe wenyu ũla wĩ ĩtunĩ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
