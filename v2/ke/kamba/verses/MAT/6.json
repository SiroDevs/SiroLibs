            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.6"
              },
              "items": [
                {
                  "text": "Avi 4.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.7"
              },
              "items": [
                {
                  "text": "1 Vet 5.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.6"
              },
              "items": [
                {
                  "text": "1 Tim 6.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.5"
              },
              "items": [
                {
                  "text": "Aevl 13.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nĩmwĩa, Mũikemakĩe ũndũ wa mathayũ menyu, kĩla mwĩya kana kĩla mwĩnyw’a; o na mĩĩ yenyu, kĩla mwĩĩvw’ika. Thayũ ndwĩ mbee wa kya ũya, na mwĩĩ mbee wa ngũa? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.29+MAT.10.30+MAT.10.31"
              },
              "items": [
                {
                  "text": "Mt 10.29–31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisyai nyũnyi sya yayaya, nĩkwĩthĩwa itivandaa, o na itikethaa, o na ityũmbanasya makũmbĩnĩ; na Ĩthe wenyu wa ĩtunĩ nĩwiĩthasya. Inyw’ĩ mũi vata mũno kwĩ syo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nũũ kwenyu ũla ũtonya kwondũ wa kwĩmakĩa kwake kwĩyongeleela ũasa wake mũkono ũmwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.27",
            "verseOrgIds": [
              "MAT.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩkĩ mũkwĩmakĩa ũndũ wa ngũa? Sũanĩai ũndũ wa malaa ma lili ma kĩthekanĩ, ũndũ mameaa; maitethasya wĩa, o na maiokothaa: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
              "MAT.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10"
              },
              "items": [
                {
                  "text": "1 Asu 10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ nĩngũmwĩa, o na Solomoni ndaĩanĩ yake yonthe ndaaĩvw’ĩka ta yĩmwe yamo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
            "verseOrgIds": [
              "MAT.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa ĩndĩ Ngai nũvw’ĩkaa nyeki ya kĩthekanĩ ta ũu, ĩla ĩnĩkwĩkala ũmũnthi, na ũnĩ ĩkekw’a ikonĩ, ndakamũvw’ĩka inyw’ĩ mbee mũno, inyw’ĩ ma mũĩkĩĩo mũnini? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikemakĩe ĩndĩ, mũkyasya, Tũkaya kyaũ? Kana, Tũkanyw’a kyaũ? Kana, Tũkeevw’ĩka kĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.8"
              },
              "items": [
                {
                  "text": "Mt 6.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ syĩndũ isu syonthe nimanthawa nĩ Andũ‐ma‐mbaĩ‐ingĩ; nĩkwĩthĩwa Ĩthe wenyu wa ĩtunĩ nĩwĩsĩ mwĩ na vata wa syĩndũ isu syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.17"
              },
              "items": [
                {
                  "text": "Alo 14.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.13"
              },
              "items": [
                {
                  "text": "1 Asu 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
