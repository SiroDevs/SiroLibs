          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikeyiĩe ũthwii kũũ nthĩ vala lungulu na nganga syanangaa, na vala ing’ei ivũthũaa na kũya: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
