              "attrs": {
                "loc": "LUK.11.34+LUK.11.35+LUK.11.36"
              },
              "items": [
                {
                  "text": "Lk 11.34–36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taa wa mwĩĩ nĩ itho: ethĩwa ĩndĩ itho yaku nĩ ĩseo, mwĩĩ waku w’onthe ũkausũa kyeni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.15"
              },
              "items": [
                {
                  "text": "Mt 20.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa itho yaku nĩ ĩthũku, mwĩĩ waku w’onthe ũkatulya kĩvindu. Ethĩwa ĩndĩ kyeni kĩ nthĩnĩ waku kyeethĩwa kĩvindu, kĩvindu kyu ko te kĩnene!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.23",
            "verseOrgIds": [
              "MAT.6.23"
            ]
          }
        }
      ]
    },
