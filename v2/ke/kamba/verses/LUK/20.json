        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.44",
            "verseOrgIds": [
              "LUK.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
