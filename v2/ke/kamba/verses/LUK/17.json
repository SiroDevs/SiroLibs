              "items": [
                {
                  "text": "12.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na matikasya, Sisyai, kũũ! Kana, Kũya! Nũndũ ũsumbĩ wa Ngai wĩ katĩ wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.21",
            "verseOrgIds": [
              "LUK.17.21"
            ]
          }
        }
      ]
