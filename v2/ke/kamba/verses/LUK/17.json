                  "text": "Mt 24.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.26"
              },
              "items": [
                {
                  "text": "Yoa 1.26",
                  "type": "text"
                }
