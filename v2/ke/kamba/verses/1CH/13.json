            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũmbano w’onthe wasya ũkeeka ũu; nũndũ ũndũ ũsu andũ onthe moonie nĩ ũseo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
      ]
    },
    {
