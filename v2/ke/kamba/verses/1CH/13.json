          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Ndaviti oomban’ya Isilaeli onthe, kuma Sioli kalũsĩ ka Misili o kũvika ũlikĩlo wa Amathi, maete ĩsandũkũ ya Ngai kũyumya Kiliathi‐yealimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
