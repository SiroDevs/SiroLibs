          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "mamũthembeae Yeova nthembo sya kũvĩvw’a kithembeonĩ kya nthembo ya kũvĩvw’a ĩtatw’ikanaa kĩoko na wĩoo, o kwĩanana na w’onthe ũla ũandĩkĩtwe mĩaonĩ ya Yeova, ĩla wameaĩe Isilaeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.40",
            "verseOrgIds": [
              "1CH.16.40"
            ]
          }
        },
