          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "na vamwe nao Emani na Yetuthuni, na angĩ ala manyuviwe, ala mawetiwe na masyĩtwa, mamũtũngĩae Yeova mũvea, nũndũ ũseo wake wĩ wendo nĩwĩkalaa tene na tene; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
