          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ amatia vo, mbee wa ĩsandũkũ ya ũtianĩo ya Yeova, Asavu na ana‐a‐ĩthe make, mathũkũmĩae vu mbee wa yĩla ĩsandũkũ mavinda onthe, o tondũ wĩa wa kĩla mũthenya waĩ na vata; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
