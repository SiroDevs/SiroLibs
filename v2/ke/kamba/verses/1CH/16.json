              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maete ĩsandũkũ ya Ngai nthĩnĩ, na mayia ĩeemanĩ nthĩnĩ yĩla Ndaviti wambĩte kwondũ wayo: na mamũthembea Ngai nthembo sya kũvĩvw’a na nthembo sya mũuo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.1"
              },
              "items": [
                {
                  "text": "1 Mav 15.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Ndaviti waminie kũthemba nthembo ya kũvĩvw’a na nthembo sya mũuo, aathima andũ syĩtwanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
