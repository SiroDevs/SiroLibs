        },
        {
          "text": "Na ĩndĩ aa nĩ ana ma Ndaviti ala wasyaĩe ku Eviloni: ĩkithathi yake nĩ Aminoni, ũla wasyaiwe nĩ Ainoamu Mũyesileeli; wa kelĩ nĩ Ndanieli ũla wasyaiwe nĩ Avikaili Mũkalimeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.2+2SA.3.3+2SA.3.4+2SA.3.5"
              },
              "items": [
                {
                  "text": "2 Sam 3.2–5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
