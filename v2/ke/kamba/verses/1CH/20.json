          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu masyaĩwe nĩ yĩla ĩmũndũ ku Ngathi; na mavalũkw’a nĩ kw’oko kwa Ndaviti, na moko ma athũkũmi make.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
