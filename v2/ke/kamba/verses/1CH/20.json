                "loc": "2SA.12.30"
              },
              "items": [
                {
                  "text": "2 Sam 12.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
