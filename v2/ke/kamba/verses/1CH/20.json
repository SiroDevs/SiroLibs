            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti aumya ngovia ya ũsumbĩ mũsumbĩ woo mũtwe kwake, na eethĩa ũito wayo nĩ talendi ya thaavu, na kwaĩ tũvila twĩ thooa mũnene nthĩnĩ wayo; na yeekĩwa mũtwe wa Ndaviti: na aumaalya mũtavo wa ĩ ndũa, mwingĩ mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
