              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuma mũtavonĩ ũla woosiwe makaũnĩ nĩmavathie syĩthĩwe ntheu sya kũtũngĩĩaa nyũmba ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
