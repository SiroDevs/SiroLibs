              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũlaĩka wa Yeova wamwĩaĩe Ngati amwĩe Ndaviti, kana Ndaviti nĩambate, na kũmwakĩa Yeova kĩthembeo kĩvũĩonĩ kya Olinani Mũyevusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.1"
              },
              "items": [
                {
                  "text": "2 Mav 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti ambata ũndũ wa ndeto sya Ngati, ila waneenie syĩtwanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.19",
            "verseOrgIds": [
              "1CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Olinani eethyũũa, na oona ũ mũlaĩka; na ana make ana ala maĩ vamwe nake meevitha. Na yu Olinani nĩwavũaa nganũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.20",
            "verseOrgIds": [
              "1CH.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Ndaviti wamũkĩe Olinani, Olinani asisya na oona Ndaviti, na auma kĩvũĩonĩ, na amwĩkunamĩsya Ndaviti ũthyũ wake welekele nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.21",
            "verseOrgIds": [
              "1CH.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Ndaviti amwĩa Olinani, Nenga vandũ va kĩvũĩo kĩĩ, nĩ kana nĩmwakĩe Yeova kĩthembeo vo: ũkanenga vo kwa thooa mwĩanĩu, nĩ kana ũthĩn’yo ũũ ũsiĩĩwe wumw’e andũnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Olinani amwĩa Ndaviti, Ĩyosee, na mwĩaĩi wakwa mũsumbĩ nĩeke ũla wĩona wĩ ũseo: sisya, nĩngũkũnenga ng’ombe ii sya nthembo sya kũvĩvw’a, na ivũi ii syĩthĩwe ngũ, na nganũ ĩno yĩthĩwe nthembo ya mũtu; nĩngũnengane syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Ndaviti amwĩa Olinani, Aiee, ĩndĩ nditĩa kũvathooa na thooa mwĩanĩu: nũndũ ndikosa kĩla kyaku kwondũ wa Yeova, kana kũthemba nthembo ya kũvĩvw’a ndathooete. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.24",
            "verseOrgIds": [
              "1CH.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Ndaviti amũnenga Olinani sekeli maana thanthatũ sya thaavu kwa kũthima ũndũ wa vandũ vau. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amwakĩa Yeova kĩthembeo vau, na athemba nthembo sya kũvĩvw’a na nthembo sya mũuo, na amwĩkaĩla Yeova; nake amũsũngĩa kuma ĩtunĩ na mwaki ũitheea kĩthembeonĩ kya nthembo ya kũvĩvw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.24"
              },
              "items": [
                {
                  "text": "Ali 9.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.39"
              },
              "items": [
                {
                  "text": "1 Mav 16.39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova eeaĩa mũlaĩka; na atũngĩa ũvyũ wake ndoonĩ yaw’o.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩũ, yĩla Ndaviti wonie kana Yeova nũmũsũngĩĩĩte kĩvũĩonĩ kya Olinani Mũyevusi, nĩwathembaa vo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ wĩkalo wa Yeova, yĩla Mose waseũvĩsye weũnĩ, na kĩthembeo kya nthembo ya kũvĩvw’a, ĩvinda yĩu syaĩ vala vandũ vatũlu Ngiveoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Ndaviti ndaatonya kũenda mbee wakyo akũlye Ngai; nĩkwĩthĩwa nĩwakĩaa nũndũ wa ũvyũ wa mũlaĩka wa Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        }
      ]
