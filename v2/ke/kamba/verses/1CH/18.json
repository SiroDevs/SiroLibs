        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti asumbĩka Isilaeli onthe; na asilanasya andũ make onthe na sila wa katĩ na mũlũngalu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoavu mwana wa Nzeluia aĩ mũnene wa nguthu; na Yeosavati mwana wa Ailuti aĩ mũandĩki wa maũndũ; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
