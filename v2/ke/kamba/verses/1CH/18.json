                "loc": "1CH.11.6"
              },
              "items": [
                {
                  "text": "1 Mav 11.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Nzatoki mwana wa Aituvu, na Avimeleki mwana wa Aviathali, maĩ athembi; na Savisa aĩ mũandĩki; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
