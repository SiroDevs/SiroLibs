            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Toi mũsumbĩ wa Amathi wewie Ndaviti nũkũnĩte nguthu yonthe ya Ataleseli mũsumbĩ wa Sova, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "atũma Aatoiamu mwana wake kwa mũsumbĩ Ndaviti, akamũkethye, na kũmũathima, nĩkwĩthĩwa aĩ anokita na Ataleseli na kũmũkũna (nũndũ Ataleseli eethĩawa na makaũ na Toi); na akũĩte mĩthemba yonthe ya mĩio ya thaavu na vetha na ũthuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩsu nayo mũsumbi Ndaviti amĩvathie yĩthĩwe mĩtheu ya Yeova, vamwe na vetha na thaavu ũla watavie mbaĩnĩ syonthe; kuma Etomu, na kuma Moavi, na kuma kwa ana ma Amimoni, na kwa Avilisiti, na Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ Avisai mwana wa Nzeluia akũnĩa Aetomu ngili ĩkũmi na nyanya Kyandanĩ kya Mũnyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.26.6"
              },
              "items": [
                {
                  "text": "1 Sam 26.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aia ngome syĩ asikalĩ Etomu; na Aetomu onthe matw’ĩka athũkũmi ma Ndaviti. Na Yeova amũnenga Ndaviti kũkĩlya vinya o kũla waendaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
