        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mũlimano wa mbee kwa Asavu wamũvalũkĩla Yosevu: wa kelĩ wamũvalũkĩla Ngetalia; we na ana‐a‐ĩthe make na ana make maĩ ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa katatũ, Nzakuli, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.10",
            "verseOrgIds": [
              "1CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa kana, Isili, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.11",
            "verseOrgIds": [
              "1CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa katano, Nethania, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.12",
            "verseOrgIds": [
              "1CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa thanthatũ, Mbukia, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.13",
            "verseOrgIds": [
              "1CH.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa mũonza Yesalela, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.14",
            "verseOrgIds": [
              "1CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa nyanya Yesaia, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.15",
            "verseOrgIds": [
              "1CH.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa kenda Matania, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.16",
            "verseOrgIds": [
              "1CH.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi Simei, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.17",
            "verseOrgIds": [
              "1CH.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi na ũmwe Asaleeli, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.18",
            "verseOrgIds": [
              "1CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi na ĩlĩ Asavia, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.19",
            "verseOrgIds": [
              "1CH.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi na ĩtatũ Suvaeli, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.20",
            "verseOrgIds": [
              "1CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi na ĩna Matithia, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.21",
            "verseOrgIds": [
              "1CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi na ĩtano Yelemothi, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.22",
            "verseOrgIds": [
              "1CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi na thanthatũ Aanania, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.23",
            "verseOrgIds": [
              "1CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi na mũonza Yosivekasa, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.24",
            "verseOrgIds": [
              "1CH.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ĩkũmi na nyanya Aanani, ana make na ana‐a‐ĩthe make, ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.25",
            "verseOrgIds": [
              "1CH.25.25"
            ]
          }
        },
        {
