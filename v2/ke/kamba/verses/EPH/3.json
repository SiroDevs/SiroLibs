            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana yu kwa nzĩa ya ĩkanisa, ũĩ wa Ngai wa mĩthemba mingĩ ũmanyĩke kwa monene na mokũmũ ma ĩtunĩ, ",
          "type": "text",
