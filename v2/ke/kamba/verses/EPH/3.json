            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla nyie natwiwe mũthũkũmi waw’o, kwĩanana na mũthĩnzĩo wa mumo wa Ngai ũla nanengiwe kwĩanana wa kwĩka kwa vinya wake. ",
          "type": "text",
          "attrs": {
