            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kũtuma andũ onthe mamanya ũndũ ũilyĩ ũla walan’yo wa nzama ĩla kuma tene tene yavithiwe nthĩnĩ wa Ngai ũla wombie syĩndũ syonthe; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.9",
