                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethĩwa nĩmwĩw’ĩte ũvoo wa walan’yo wa mumo wa Ngai ũla nanengiwe kwondũ wenyu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.2",
            "verseOrgIds": [
              "EPH.3.2"
            ]
          }
        },
