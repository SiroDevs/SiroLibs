                  "text": "Ako 1.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwondũ wa ũu nyie, mwovwa nthĩnĩ wa Mwĩaĩi, nĩngũmwĩsũva mũendae o ũndũ waĩle wĩtano ũla mweetiwe naw’o, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
            "verseOrgIds": [
              "EPH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.12"
              },
              "items": [
                {
                  "text": "Ako 3.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wĩnyivyo w’onthe na ũuu, na wũmĩĩsyo, mũkyũmĩanĩsya inyw’ĩ kwa inyw’ĩ nthĩnĩ wa wendo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.14"
              },
              "items": [
                {
                  "text": "Ako 3.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩthing’ĩĩsya kũsũvĩa wĩw’ano ũmwe wa Veva wovanonĩ wa mũuo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.3",
            "verseOrgIds": [
              "EPH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.5"
              },
              "items": [
                {
                  "text": "Alo 12.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩĩ nĩ ũmwe, na Veva nĩ ũmwe, o ũndũ mweetiwe wĩkwatyonĩ ũmwe wa wĩtano wenyu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.4",
            "verseOrgIds": [
              "EPH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.16"
              },
              "items": [
                {
                  "text": "Yoa 10.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.6"
              },
              "items": [
                {
                  "text": "1 Ako 8.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩaĩi ũmwe, mũĩkĩĩo ũmwe, ũvatiso ũmwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.5",
            "verseOrgIds": [
              "EPH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.6"
              },
              "items": [
                {
                  "text": "1 Ako 12.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai ũmwe, nake ni Ĩthe wa onthe, ũla wĩ ĩũlũ wa onthe, na kũtũngana kwa onthe, na nthĩni wa onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "Alo 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.11"
              },
              "items": [
                {
                  "text": "1 Ako 12.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kĩla ũmwe waitũ nũnengetwe ũla mumo kwĩanana na kĩthimo kya mũthĩnzio wa Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
              "EPH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
