            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ nĩneena ũu, na kũkũsĩĩa nthĩnĩ wa Mwĩaĩi, kana kuma yu inyw’ĩ mũikaende ũndũ Andũ‐ma‐mbaĩ‐ingĩ maendaa, na ũtumanu wa ilĩko syoo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.17",
            "verseOrgIds": [
              "EPH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
