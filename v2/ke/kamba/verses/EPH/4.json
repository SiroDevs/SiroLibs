              },
              "items": [
                {
                  "text": "Alo 8.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.9"
              },
              "items": [
                {
                  "text": "Ako 3.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.8"
              },
              "items": [
                {
                  "text": "Aka 6.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũndũ wa mwĩkalĩle wenyu wa tene, mumyei mwĩkye kũasa mũndũ wa tene, ũla wanangĩkaa kwa ũvikĩlaa mĩmeo ya ũkengani; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
            "verseOrgIds": [
              "EPH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 4:23"
          },
          "items": [
