                "loc": "EPH.2.12"
              },
              "items": [
                {
                  "text": "Aev 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.21"
              },
              "items": [
                {
                  "text": "Ako 1.21",
