            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Mwa 1.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwĩvw’ĩke mũndũ mweũ, ũla wombiwe na mũvw’ano wa Ngai nthĩnĩ wa ũlũngalu na ũtheu wa w’o.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
