              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yosua eekĩĩte ngũa mbuku, na aũngamĩte mbee wa mũlaĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
