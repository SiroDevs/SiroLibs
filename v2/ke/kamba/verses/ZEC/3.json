              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka wa Yeova amũkũsĩĩa Yosua, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova wa nguthu ũnũkwasya: Ethĩwa ũkakinyaa nzĩanĩ syakwa, na ethĩwa ũkasũvĩaa wĩaĩo wakwa, nĩvo o naku wĩsilĩla nyũmba yakwa, o na ĩngĩ ũkasũvĩaa nza syakwa, na ngakũnenga vandũ va ũlikĩlaa katĩ wa aa maũngamĩte ũtee. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        },
