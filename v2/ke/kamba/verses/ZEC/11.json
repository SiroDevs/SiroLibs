              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.14",
            "verseOrgIds": [
              "ZEC.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova ambĩa, Ĩyosee o ĩngĩ mĩio ya mũĩthi mũtumanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ, sisya, ngookĩlya mũĩthi ĩ nthĩ, ũla ũtakaisisya ila mbete, o na ndakamantha ila inyaĩĩkĩtw’e, o na kũvosya ila ndũlĩkangu, o na kũĩthya ila nima; ĩndĩ akaĩsaa nyama sya malondu manou, na akatembũanga mavũngũ mamo tũlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.16",
            "verseOrgIds": [
              "ZEC.11.16"
            ]
          }
        },
        {
