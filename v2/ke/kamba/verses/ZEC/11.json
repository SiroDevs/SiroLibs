            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vingũa mĩomo yaku, we Levanoni, nĩ kana mwaki ũvĩvye mĩtĩ yaku ya mĩkũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
