              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova akatiĩwa Yuta ta kĩanda kyake nthĩnĩ wa ĩla nthĩ ntheu, na akanyuva Yelusaleme ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
