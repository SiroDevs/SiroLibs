              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ae! Ae! Kĩai mume nthĩ ya ngalĩ ya ĩũlũ, easya ũu Yeova; nũndũ nĩnamũnyaĩĩkisye ta iseve inya sya matu, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.6",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        },
