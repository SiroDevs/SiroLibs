              "type": "text"
            }
          ]
        },
        {
          "text": "Ina na tana, we mwĩĩtu wa Saioni; nũndũ, sisya, ngooka, na ngatũa katĩ waku, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.10",
            "verseOrgIds": [
