              },
              "items": [
                {
                  "text": "Ũvu 6.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.8",
            "verseOrgIds": [
              "ZEC.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo naisye, We mwĩaĩi wakwa, ii nĩ myaũ? Na mũlaĩka ũla waneenaa nakwa ambĩa, Nĩngũkũmanyĩthya syo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.6"
              },
              "items": [
                {
                  "text": "Ũvu 22.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla mũndũ ũũngeme katĩ wa mĩandasi asũngĩa na asya, Ii nĩsyo Yeova ũtũmĩte syangange nthĩ kũũ na kũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
