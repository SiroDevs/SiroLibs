                "loc": "JOB.1.7"
              },
              "items": [
                {
                  "text": "Yovu 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.1.14"
              },
              "items": [
                {
                  "text": "Aevl 1.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na syasũngĩa mũlaĩka wa Yeova ũla waũngyĩ katĩ wa mĩandasi, na syasya, Nĩtwangangĩte nthĩ kũũ na kũũ, na, sisya, nthĩ yonthe ĩkalĩte ĩuĩtye, na ĩthũmũĩte.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        }
      ]
