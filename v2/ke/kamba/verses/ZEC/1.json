            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova nĩwew’ĩthĩw’e woo nĩ aaĩthe menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu matavye, Ũũ nĩw’o Yeova wa nguthu ũnũkwasya: Nzyokeai, easya ũu Yeova wa nguthu, nakwa ngamũsyokea, easya ũu Yeova wa nguthu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
