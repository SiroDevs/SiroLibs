                "loc": "JOB.1.20"
              },
              "items": [
                {
                  "text": "Yovu 1.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.2.8"
              },
              "items": [
                {
                  "text": "2.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
            "verseOrgIds": [
              "JON.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake aumya ũtũmane na anyaĩĩkya Nineva kw’onthe kwa ũtw’ĩo wa mũsumbĩ na anene make me ndaĩa, akyasya, Kũtikasamwe kĩndũ o na kĩmwe nĩ mũndũ kana indo, ndĩthya ya ng’ombe kana ya mbũi na malondu; kũtikaĩwe, kana kũnyuwa kĩw’ũ; ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
