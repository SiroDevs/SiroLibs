              "items": [
                {
                  "text": "Yoe 2.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.9",
            "verseOrgIds": [
              "JON.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ngai oona mawĩa moo, kana nĩmeethyũũie kuma mũendelenĩ woo mũthũku; na Ngai eetũnga aeka ũthũku ũla waĩtye akameka; na ndaawĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
            "verseOrgIds": [
              "JON.3.10"
            ]
          }
