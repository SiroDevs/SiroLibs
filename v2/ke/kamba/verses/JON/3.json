                "loc": "2CH.20.3"
              },
              "items": [
                {
                  "text": "2 Mav 20.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.41"
              },
              "items": [
                {
                  "text": "Mt 12.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.5",
            "verseOrgIds": [
              "JON.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũvoo wavikĩa mũsumbĩ wa Nineva, nake ookĩla kuma kĩvĩlanĩ kyake kya ũsumbĩ, na aia ngũa yake ya ũsumbĩ, na eevw’ĩka makunia, na ekala mũunĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
            "verseOrgIds": [
              "JON.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
