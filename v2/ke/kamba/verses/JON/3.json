              "type": "tag",
              "attrs": {
                "loc": "JER.18.11"
              },
              "items": [
                {
                  "text": "Yel 18.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.8",
            "verseOrgIds": [
              "JON.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ wĩsĩ ethĩwa Ngai ndeĩthyũũa na kwĩtũnga, na kwĩthyũũa aeke ũthatu wake mwai kana tũtikae? ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.9",
            "verseOrgIds": [
              "JON.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
