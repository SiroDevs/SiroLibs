              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ nĩkwĩvw’ĩkwe makunia, mũndũ o na indo, na nĩkwĩkaĩlwe Ngai na vinya: ĩĩ, nĩmethyũũe kĩla ũmwe kuma mũendelenĩ wake mũthũku, na kuma ũng’endunĩ ũla wĩ mokonĩ make. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.8",
            "verseOrgIds": [
              "JON.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
