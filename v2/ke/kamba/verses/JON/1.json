            "number": "2",
            "style": "v",
            "sid": "JON 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkĩla, ũende Nineva, ndũa ĩsu nene, na ũkĩmyũkĩlĩlya wasya; nũndũ ũthũku woo nĩ mwambatu vala nĩĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        },
