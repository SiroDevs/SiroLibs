            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JON 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mamũkĩlya Yona, na mamwĩkya ũkanganĩ; na ũkanga waeka kũkĩlangan’ya. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.15",
            "verseOrgIds": [
              "JON.1.15"
            ]
          }
        },
