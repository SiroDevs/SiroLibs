            "sid": "JON 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yeova aete kĩseve kĩnene ĩũlũ wa ũkanga, na kwaĩ kĩuutani kĩ vinya ĩũlũ wa ũkanga, o na ngalawa yesaa kwanangwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
