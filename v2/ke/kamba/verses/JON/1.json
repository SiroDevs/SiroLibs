                "loc": "PSA.48.7"
              },
              "items": [
                {
                  "text": "Sav 48.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.107.25"
              },
              "items": [
                {
                  "text": "107.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ andũ ma ngalawa meewie w’ĩa, na meekaĩla kĩla mũndũ ngai yake; na mekangya syĩndũ ila syaĩ ngalawanĩ ũkanganĩ, nĩ kana yĩthĩwe mbũthũ kwamo. Ĩndĩ Yona nĩwalikĩte kũndũ kwĩ nthĩnĩ ngalawanĩ; na akakoma, akalĩkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.107.28"
              },
              "items": [
                {
                  "text": "Sav 107.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.27.18"
              },
              "items": [
                {
                  "text": "Meko 27.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.27.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mũnene wa ngalawa amũkĩa, na amũkũlya, Wĩ na kĩ, we mũkomi? Ũkĩla, wĩkaĩle Ngai waku, no kwĩthĩwa Ngai atũlilikana, tũtikae. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maneenan’ya kĩla mũndũ na ũla ũngĩ, Ũkai, tũlimane, nĩ kana tũmanye nĩ ũndũ waũ ũthũku ũũ wĩ ĩũlũ waitũ. Na ĩndĩ malimana, naw’o wamũvalũkĩla Yona. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.7",
            "verseOrgIds": [
              "JON.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mamwĩie, Tũtavye, nĩtũũkwĩsũva, nũũ ũla ũtumie ũthũku ũũ wĩthĩwa ĩũlũ waitũ; wĩa waku nĩ mwaũ? Na wumĩte nakũ? Nthĩ yaku nĩ yĩkũ? Na wĩ mũmwaũ? ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amea, Nyie nĩ Mũevelania; na nĩngũkĩa Yeova, Ngai wa ĩtu, ũla wombie ũkanga na nthĩ nyũmũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.146.6"
              },
              "items": [
                {
                  "text": "Sav 146.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ andũ meewie w’ĩa mũno, na mamũkũlya, Wĩkĩte ũndũ mwaũ? Nũndũ andũ nĩmamanyie kana nĩwakĩĩte kuma vala ve Yeova, nĩkwĩthĩwa nĩwamatavya.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mamwĩie, Twĩkwĩka ata, nĩ kana ũkanga ũtũuĩsye? Nũndũ ũkanga wookĩlangilye itulumo mbee na mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amea, Mbũkĩlyai, na mũimbĩkya ũkanganĩ; na ĩndĩ ũkanga ũkamũuĩsya: nũndũ nĩnĩsĩ kana nũndũ wakwa kĩuutani kĩĩ kĩnene kĩ ĩũlũ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.20"
              },
              "items": [
                {
                  "text": "Yos 7.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JON 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ andũ matwaa na vinya masyoke nthĩ; ĩndĩ matyaatonya; nũndũ ũkanga wamokĩlangĩlye itulumo mbee na mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.13",
            "verseOrgIds": [
              "JON.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JON 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mamwĩkaĩla Yeova, na masya, Nĩtũũkwĩsũva, ame Yeova, nĩtũũkwĩsũva, tũikae nũndũ wa thayũ wa mũndũ ũũ, na ndũkatũtalĩle nthakame ĩte ĩvĩtyo; nũndũ we, ame Yeova, nĩweeka ũla wakwendeesya. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
