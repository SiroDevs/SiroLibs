          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yona ookĩla akĩĩe Talisisi aume vala ve Yeova; na atheea Yova, na awĩla ngalawa ĩendete Talisisi: na ĩndĩ aĩva ĩtuvi yayo, na alika nthĩnĩ wayo, kũendan’ya namo Talisisi aume vala ve Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        },
