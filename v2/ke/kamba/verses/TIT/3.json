              "items": [
                {
                  "text": "Yoe 2.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla watwonoesye kwa wingĩ, kwondũ wa Yesũ Klĩsto Mũtangĩĩi waitũ; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.6",
            "verseOrgIds": [
              "TIT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
