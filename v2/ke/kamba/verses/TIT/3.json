            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũla ũetae kĩvathũkangano, ĩtina wa kũmũtaa ya mbee na ya kelĩ, mũlee; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.10",
            "verseOrgIds": [
