                {
                  "text": "5.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa ithyĩ naitũ tene twaĩ atũmanu, tũtyaĩ ewi, twaĩ akenge, tũkĩthũkũma mawendi na motanu ma nthĩ ma mĩthemba mingĩ, tũkĩkalya mathayũ maitũ maũndũnĩ mai, na kwĩw’anĩa iwĩu, tũkimeneka, na kũmenana ithyĩ kwa ithyĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.3",
            "verseOrgIds": [
              "TIT.3.3"
            ]
          }
        },
        {
