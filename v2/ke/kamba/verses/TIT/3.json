              },
              "items": [
                {
                  "text": "Alo 3.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana, ũndũ wa kũtalĩlwa ũlũngalu kwondũ wa mumo wake, tũtonye kũtuwa atiĩwa kwĩanana na wĩkwatyo wa thayũ ũtathela. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.7",
            "verseOrgIds": [
              "TIT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto nĩ ya kũĩkĩĩwa, na kwondũ wa maũndũ aa nĩngwenda ũneene na vinya, nĩ kana ala metĩkĩlĩte Ngai mesũvĩe mũno mekae meko maseo. Maũndũ aa nĩ maseo na me na ũtandĩthyo andũnĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.8",
            "verseOrgIds": [
              "TIT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.7"
              },
              "items": [
                {
                  "text": "1 Tim 4.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mokũlyo ma ũtumanu, na mosyaanĩo, na mateta, na kũkita ũndũ wa ĩla mĩao, ĩvete maũndũnĩ asu; nũndũ mati na ũtandĩthyo na nĩ ma mana. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.9",
            "verseOrgIds": [
              "TIT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
