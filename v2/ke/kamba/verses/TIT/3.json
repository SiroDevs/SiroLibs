            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũkĩmanya kana mũndũ ũilyĩ ũsu nũalyũkĩte, na ekaa naĩ, nĩwĩsilĩlĩte mwene kwĩthĩwa nĩ mũvĩtan’ya.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.11",
            "verseOrgIds": [
