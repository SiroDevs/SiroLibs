                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti kwondũ wa meko ma ũlũngalu, ala ithyĩ tweekie, ĩndĩ kwĩanana na tei wake nĩwatũtangĩĩe, kwondũ wa kũthambw’a kwa kũsyawa ĩngĩ, na kũtw’ĩkĩthw’a eũ nĩ Veva Mũtheu, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.5",
            "verseOrgIds": [
              "TIT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
