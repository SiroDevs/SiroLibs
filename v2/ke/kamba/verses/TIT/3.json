                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yĩla ũseo wa Ngai Mũtangĩĩi waitũ, na wendo wake welekele andũ, waumilile, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.4",
            "verseOrgIds": [
              "TIT.3.4"
            ]
          }
        },
