                {
                  "text": "Avi 4.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maikaneenee mũndũ o na wĩva naĩ, kana kũtetan’ya, methĩwe me avoo, makyonan’ya ũuu w’onthe kwa andũ onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.2",
            "verseOrgIds": [
              "TIT.3.2"
            ]
          }
        },
        {
