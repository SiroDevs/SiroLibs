            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.2",
            "verseOrgIds": [
              "GAL.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.1"
              },
              "items": [
                {
                  "text": "2 Ako 10.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisyai, nyie Vaulo nĩmwĩa, mwaĩkwa, Klĩsto ndakamũuna na ũndũ nongi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.2",
            "verseOrgIds": [
              "GAL.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩĩ, nĩngũkũsĩĩa ĩngĩ kĩla mũndũ ũla waĩkawa, kana e na thiĩ wa kwĩka ĩla mĩao yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.3",
            "verseOrgIds": [
              "GAL.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũtaanĩtw’e na Klĩsto, inyw’ĩ ala mũkwenda kũtalĩlwa ũlũngalu kwondũ wa ĩla mĩao; nĩmwavalũkĩte kuma mumonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.4",
            "verseOrgIds": [
              "GAL.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ithyĩ kwondũ wa ũla Veva nĩtweteelaa wĩkwatyo wa ũlũngalu kwa nzĩa ya mũĩkĩĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.5",
            "verseOrgIds": [
              "GAL.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.15"
              },
              "items": [
                {
                  "text": "Aka 6.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.19"
              },
              "items": [
                {
                  "text": "1 Ako 7.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nthĩnĩ wa Klĩsto Yesũ kwaĩkwa kũiaĩlya ũndũ, kana kũlea kwaĩkwa; ĩndĩ mũĩkĩĩo ũla ũtethasya wĩa kwondũ wa wendo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.6",
            "verseOrgIds": [
              "GAL.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasembete nesa; nũũ ũla wamũsiĩĩe mũikawĩw’e ũla w’o? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.7",
            "verseOrgIds": [
              "GAL.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.6"
              },
              "items": [
                {
                  "text": "Aka 1.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũsesengwa ku kũtyumĩte kwa ũla ũmwĩtaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.8",
            "verseOrgIds": [
              "GAL.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.6"
              },
              "items": [
                {
                  "text": "1 Ako 5.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩlawa ĩnini nĩyĩkaatasya kĩmũtũ kyonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.9",
            "verseOrgIds": [
              "GAL.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.7"
              },
              "items": [
                {
                  "text": "Aka 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.15"
              },
              "items": [
                {
                  "text": "2 Ako 11.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩngũmũĩkĩĩa inyw’ĩ mũno nthĩnĩ wa Mwĩaĩi, kana mũikethĩwa na kĩlilikano kĩngĩ: ĩndĩ ũla ũmũthĩnasya akakua ũsilĩlo wake mwene, o na ethĩwa nũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.10",
            "verseOrgIds": [
              "GAL.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.23"
              },
              "items": [
                {
                  "text": "1 Ako 1.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nyie, ana‐a‐asa, ethĩwa nĩtavan’ya nzaĩko kũvika o na yu, nĩthĩnĩaw’a kĩ? Ethĩwa ũu nĩ w’o ũlulutĩkyo wa ngelan’yo nũvetetwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.11",
            "verseOrgIds": [
              "GAL.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.12.3"
              },
              "items": [
                {
                  "text": "Sav 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenda asu meũmũthingithya maketile e mo ene.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.12",
            "verseOrgIds": [
              "GAL.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
