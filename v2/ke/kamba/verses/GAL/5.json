                "loc": "ACT.15.10"
              },
              "items": [
                {
                  "text": "Meko 15.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kũthaw’a, Klĩsto nũtũthaĩtye: kwondũ wa ũu ũngamai na ũlũmu, mũikalingisane ĩngĩ kwovwanĩ kwa ũkombo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.1",
            "verseOrgIds": [
              "GAL.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
