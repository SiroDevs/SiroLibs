                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake amwĩtĩe ũndũ ũsu kwondũ wa ũvoo mũseo witũ, mwose ũtheu mũtisu wa Mwĩaĩi waitũ Yesũ Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.14",
            "verseOrgIds": [
              "2TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ĩndĩ, ana‐a‐asa, ũngamai na ũlũmu, na kũkwata momanyĩsyo ala mũmanyĩĩtw’e, ethĩwa nĩ ndeto, kana nĩ valũa witũ.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        }
      ]
