          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisyai, inyw’ĩ i mbaĩnĩ, na mũiketeea, na kũseng’a mũseng’eee; nũndũ nĩtethya wĩa mĩthenya yenyu, ũla mũtaketĩkĩla o na mwatavw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
