          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokaa onthe kwondũ wa ũng’endu; mothyũ moo malũlũmĩle kwelekela mbee; na mombanasya atavwa o ta kĩthangathĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
