            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wĩvĩta o ta kĩseve, na akĩvĩtũka, na akĩthĩwa mũvĩtan’ya, we ũla ũtonyi wake nĩ ngai yake.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.11",
            "verseOrgIds": [
              "HAB.1.11"
            ]
