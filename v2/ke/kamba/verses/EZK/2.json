              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Veva alika nthĩnĩ wakwa yĩla waneenie nakwa, na anũngamya na maũũ makwa; na neew’a ũla waneenie nakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.2",
            "verseOrgIds": [
              "EZK.2.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
