        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
