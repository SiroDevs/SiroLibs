          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku, mwana wa mũndũ, ndũkamakĩe, o na ndũkakĩe ndeto syoo, o na kau mĩtae na mĩw’a syĩ vamwe naku, naku nũtũaa katĩ wa ing’auũ; ndũkakĩe ndeto syoo, o na ndũkateve nũndũ wa mothyũ moo, o na kau nĩ nyũmba ng’endu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.6",
            "verseOrgIds": [
              "EZK.2.6"
            ]
          }
        },
