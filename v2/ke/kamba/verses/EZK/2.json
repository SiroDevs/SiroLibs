          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao, ethĩwa makeew’a, kana matikew’a (nũndũ nĩ nyũmba ng’endu), nĩmakamanya kana kwaĩ mwathani katĩ woo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.5",
            "verseOrgIds": [
              "EZK.2.5"
            ]
          }
        },
