          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, ũtheu mũtisu wa Ngai wa Isilaeli waĩ vo, kwĩanana na woni ũla noonee ũiĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.4",
            "verseOrgIds": [
              "EZK.8.4"
            ]
          }
        },
