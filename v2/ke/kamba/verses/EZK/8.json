              "items": [
                {
                  "text": "Esek 9.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ ambĩa, Ũkoona ĩngĩ mothatyo angĩ manene ala mekaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        }
