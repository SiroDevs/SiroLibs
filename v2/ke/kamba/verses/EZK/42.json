              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbee wa ũla ũasa wa mĩkono ĩana kwaĩ mũomo wa ngalĩ ya ĩũlũ, na ũthanthau waĩ mĩkono mĩongo ĩtano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwelekela mĩkono mĩongo ĩlĩ ĩla ya nza ya nthĩnĩ, na kwelekela nthĩ nzeũvye na mavia ĩla ya nza yĩ ũtee, kwaĩ valasya wa ĩũlũ nthĩnĩ welekele valasya wa ĩũlũ nthĩnĩ kasũmbanĩ ka katatũ ka tũla twilĩanĩlw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbee wa tũsũmba kwaĩ nzĩa ya ũthanthau wa mĩkono ĩkũmi ya kũlika nthĩnĩ, nzĩa ya mũkono ũmwe; na mĩomo yatw’o yelekele ngalĩ ya ĩũlũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũsũmba twa ĩũlũ twaĩ tũkuvangĩ; nũndũ mavalasya ma ĩũlũ nĩmaolete tũsũmba tũu, kũvĩtũka ũndũ tũla twa ĩtheo na tũla twa katĩ twaoletwe, mwakonĩ ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ twaĩ tũsũmba tũtatũ twilĩanĩlw’e, na tũtyaĩ na ituĩ, ta ituĩ sya nza: kwondũ wa ũu kala kaĩ ĩũlũ kaĩ katheke kwĩ kala ke ĩtheo na kala ke katĩ kuma nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6",
            "verseOrgIds": [
              "EZK.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wako ũla waĩ ngalĩ ya nza ũtee wa tũsũmba, kwelekela nza yĩ ũtee ngalĩ ya mbee ya tũsũmba, ũasa waw’o waĩ mĩkono mĩongo ĩtano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.7",
            "verseOrgIds": [
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũasa wa tũsũmba tũla twaĩ nza yĩ ũtee waĩ mĩkono mĩongo ĩtano: na, sisya, ngalĩ ya mbee ya ĩkalũ kwaĩ mĩkono ĩana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuma ĩtheo wa tũsũmba tũu kwaĩ ũlikĩlo ngalĩ ya wumĩlonĩ wa syũa, vala mũndũ ũvotelaa nthĩnĩ watw’o kuma nza yĩ ũtee.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩemonĩ kya ũvai wa nza kwelekela wumĩlonĩ wa syũa, mbee wa vala vandũ vavathan’ye, na mbee wa mwako, kwaĩ tũsũmba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nzĩa yĩ mbee watw’o yaĩ na mũvw’anĩle wa nzĩa ya tũsũmba tũla twelekele ngalĩ ya ĩũlũ; kwĩanana na ũasa watw’o now’o ũthanthau watw’o wailyĩ: na mawumaalĩlo onthe matw’o maĩ kwĩanana na moseũvĩlw’e matw’o, na kwĩanana na mĩomo yatw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwĩanana na mĩomo ya tũsũmba tũla twelekele ngalĩ ya ĩtheo kwaĩ mũomo wambĩlĩlyonĩ wa nzĩa, o nzĩa ĩla yaendele mbee wa ũvai yelekele ngalĩ ya wumĩlonĩ wa syũa, o vala mũndũ wavotelaa nthĩnĩ watw’o.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
