            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla waminie kũthima nyũmba ya nthĩnĩ, anumaalya na nzĩa ya mbingĩlo ĩla yelekele ngalĩ ya wumĩlonĩ wa syũa, na amĩthima ngalĩ syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.15",
            "verseOrgIds": [
              "EZK.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athima ngalĩ ya wumĩlonĩ wa syũa na mũangi wa kũthima mĩangi maana atano, na mũangi wa kũthima ngalĩ syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.3"
              },
              "items": [
                {
                  "text": "Esek 40.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athima ngalĩ ya ĩũlũ mĩangi maana atano na mũangi wa kũthima ngalĩ syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.17",
            "verseOrgIds": [
              "EZK.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athima ngalĩ ya ĩtheo mĩangi maana atano, na mũangi wa kũthima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.18",
            "verseOrgIds": [
              "EZK.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eethyũũa ngalĩ ya ũthũĩlonĩ wa syũa, na athima mĩangi maana atano na mũangi wa kũthima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.19",
            "verseOrgIds": [
              "EZK.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amĩthima ngalĩ inya: yaĩ na ũvai ũthyũlũlũkĩte, ũasa maana atano, na ũthanthau maana atano, wa kũvathan’ya vala vatheu na vala vate vatheu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
