          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wambĩĩe, Tũsũmba twa ngalĩ ya ĩũlũ na tũsũmba twa ngalĩ ya ĩtheo, tũla twĩ mbee wa vala vandũ vavathan’ye, tũu nĩtw’o tũsũmba tũtheu, vala athembi ala me vakuvĩ na Yeova makaĩsaa syĩndũ ila ntheu mũno: vau makaia syĩndũ ntheu mbee, na nthembo ya mũtu, na nthembo ya naĩ, na nthembo ya mavĩtyo; nũndũ vandũ vau nĩ vatheu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
