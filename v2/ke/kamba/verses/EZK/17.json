          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oosa wa ũsyao wa kĩũsumbĩ, na atianĩa ũtianĩo nake; o na amũingĩĩsya evĩte, na atwaa ala me na ũtonyi ma ĩ nthi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.13",
            "verseOrgIds": [
              "EZK.17.13"
            ]
          }
        },
        {
