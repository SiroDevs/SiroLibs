          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ĩngĩ ndeto ya Yeova yambukĩa, ĩkĩmbĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩtavye ĩla nyũmba ng’endu, Mũtyĩsĩ ũalyũlo wa maũndũ aa? Matavye, Sisya, mũsumbĩ wa Mbaviloni nĩwokie Yelusaleme, na akwata mũsumbĩ wa kw’o, na anene me mbee ũsumbĩnĩ ma kw’o, na amatwaa kwake Mbaviloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.12",
            "verseOrgIds": [
              "EZK.17.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
