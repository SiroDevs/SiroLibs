          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩthenya mũonza o kĩla mũthenya ũkaseũvasya mbũi yĩthĩwe nthembo ya naĩ: o na makaseũvya kasalũ, na ndũũme ya ndĩthya, ite kĩema. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
