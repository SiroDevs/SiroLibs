            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
            "verseOrgIds": [
              "EZK.43.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaithengeesya mbee wa Yeova, na athembi makasyĩkĩa mũnyũ, na makaithembea Yeova syĩthĩwe nthembo ya kũvĩvw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
        {
