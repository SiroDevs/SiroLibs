        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.13",
            "verseOrgIds": [
              "EZK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngamanyaĩĩkya melekele kĩla kĩseve onthe ala mamũthyũlũlũkĩte mamũtethye, na nguthu syake syonthe; na ngamaatĩĩa nĩkũĩte ũvyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.14",
            "verseOrgIds": [
              "EZK.12.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
