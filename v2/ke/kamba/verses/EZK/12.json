            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.14",
            "verseOrgIds": [
              "EZK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makamanya ninyie Yeova, yĩla ngamanyaĩĩkya mbaĩnĩ, na kũmekangya kũũ na kũũ nthĩnĩ wa i nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ngatialya andũ avũthũ moo mavonoke ũvyũ, na yũa, na mũimũ; nĩ kana matavanasye mothatyo moo onthe katĩ wa i mbaĩ kũla methi; na makamanya ninyie Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
