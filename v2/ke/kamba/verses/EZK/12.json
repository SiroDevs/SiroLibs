                "loc": "JER.52.11"
              },
              "items": [
                {
                  "text": "Yel 52.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.20"
