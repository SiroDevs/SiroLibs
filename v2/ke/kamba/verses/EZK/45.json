          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthĩnĩ wakyo kwondũ wa vala vandũ vatheu kũkethĩwa ũasa wa maana atano na ũthanthau wa maana atano, yĩanene ngalĩ syonthe; na mĩkono mĩongo ĩtano kwondũ wa syengo syakyo ngalĩ syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
