              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩthimonĩ kyu ũkathima ũasa wa ngili mĩongo ĩlĩ na ĩtano, na ũthanthau wa ngili ĩkũmi: na nthĩnĩ wa vo kũkeethĩwa vala vandũ vatheu, vala vatheu mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.41.4"
              },
              "items": [
                {
                  "text": "Esek 41.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ kĩlungu kĩheu kya ĩ nthĩ; kĩkethĩwa kya athembi, athũkũmi ma vala vandũ vatheu, ala mathengeeaa mamũthũkũmae Yeova; na kĩkethĩwa vandũ va nyũmba syoo, na vandũ vatheu va vala vandũ vatheu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.11"
              },
              "items": [
                {
                  "text": "Esek 48.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũasa wa ngili mĩongo ĩlĩ na itano, na ũthanthau wa ngili ĩkũmi, kĩkethĩwa kya Alivai, athũkũmi ma ĩ nyũmba, kĩkethĩwa ng’ũndũ kwoo, kwondũ wa tũsũmba mĩongo ĩlĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.13"
              },
              "items": [
                {
                  "text": "Esek 48.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũkatila kĩlungu kya ndũa ũthanthau ngili itano, na ũasa ngili mĩongo ĩlĩ na itano, kĩvakanĩte na nthembo ya kĩla kĩlungu kĩtheu: kĩkethĩwa kya nyũmba yonthe ya Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩlungu o na kĩva kwondũ wa mũnene wĩ mbee ũsumbĩnĩ kĩkethĩwa ngalĩ ĩmwe na ngalĩ ĩla ĩngĩ ya ĩla nthembo ntheu na ya kĩla kĩlungu kya ndũa, mbee wa ĩla nthembo ntheu na mbee wa kĩla kĩlungu kya ndũa, ngalĩ ya ũthũĩlonĩ wa syũa, na ngalĩ ya wumĩlonĩ wa syũa; na ũasa wakyo wĩanene na kĩlungu kĩmwe, kuma mũvaka wa ngalĩ ya ũthũĩlonĩ wa syũa kũvika mũvaka wa ngalĩ ya wumĩlonĩ wa syũa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.7",
            "verseOrgIds": [
              "EZK.45.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.3"
              },
              "items": [
                {
                  "text": "Esek 44.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.7",
            "verseOrgIds": [
              "EZK.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩ nthĩ ĩkethĩwa kwake ũtiĩwa nthĩnĩ wa Isilaeli: na anene makwa me mbee ũsumbĩnĩ matikathĩn’ya andũ makwa ĩngĩ; makanenga nyũmba ya Isilaeli ĩ nthĩ kwĩanana na mbaĩ syayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
