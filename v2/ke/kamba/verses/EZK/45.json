          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ, yĩla mũkaaan’ya kwondũ wa kũlimana nthĩ yĩthĩwe ũtiĩwa, mũkamũthembea Yeova nthembo, kĩlungu kĩtheu kya nthĩ; ũasa ũkethĩwa ũasa wa mĩangi ngili mĩongo ĩlĩ na ĩtano, na ũthanthau ũkethĩwa ngili ĩkũmi: kĩkethĩwa kĩtheu mũvakanĩ w’onthe wakyo ngalĩ syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
