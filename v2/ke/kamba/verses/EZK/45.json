                "loc": "NUM.35.2"
              },
              "items": [
                {
                  "text": "Mot 35.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.42.16+EZK.42.17+EZK.42.18+EZK.42.19+EZK.42.20"
              },
              "items": [
                {
                  "text": "Esek 42.16–20",
                  "type": "text"
                }
              ]
            },
