              },
              "items": [
                {
                  "text": "Kuma 30.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩno nĩyo nthembo ĩla mũkathemba: kĩlungu kya thanthatũ kya eva kumya kĩthiminĩ kya omeli ya nganũ; na mũkanengane kĩlungu kya thanthatũ kya eva ya omeli ya mbaale; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kĩlungu kitw’e kya mauta, kya vathi ya mauta, kĩlungu kya ĩkũmi kya vathi kumya kĩthiminĩ kya kolo, nayo nĩ vathi ĩkũmi, o omeli (nũndũ vathi ĩkũmi nĩ omeli); ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.14",
            "verseOrgIds": [
              "EZK.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na katena kamwe ka ĩlondu ka ndĩthya, kumya vala ve maana elĩ, kuma isesinĩ sya Isilaeli syĩ manzĩ maingĩ; — kwondũ wa nthembo ya mũtu, na nthembo ya kũvĩvw’a, na nthembo sya mũuo, kwondũ wa kwĩw’anĩthw’a kwoo, easya ũu Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        },
        {
          "name": "note",
