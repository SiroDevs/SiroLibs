                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.1"
              },
              "items": [
                {
                  "text": "Yel 39.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.2",
            "verseOrgIds": [
              "EZK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tavya ĩla nyũmba ng’endu ngelekan’yo, noimea, Ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya, Tinĩsya kĩteve, kĩtinĩsye, o na ĩkĩa manzĩ nthĩnĩ wakyo: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.3"
              },
              "items": [
                {
                  "text": "Esek 11.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.7"
              },
              "items": [
                {
                  "text": "7",
