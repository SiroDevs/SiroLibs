          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana mũthenya o ũsu ũla wĩvonoka akakũkĩa, atume wĩw’a ũu na matũ maku? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
