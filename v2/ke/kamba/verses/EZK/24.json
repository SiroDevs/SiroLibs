              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩngĩ, mwaka wa kenda, mwei wa ĩkũmi, mũthenya wa ĩkũmi wa mwei, ndeto ya Yeova yambũkĩa, ĩkĩmbĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
