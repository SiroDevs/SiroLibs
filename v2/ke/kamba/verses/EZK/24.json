            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ndeto ya Yeova yambũkĩa, ĩkĩmbĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa mũndũ, sisya, nĩngumya kwaku na ĩkũna yĩmwe kĩla kyendetwe nĩ metho maku: ĩndĩ ndũkamete kana kũĩa, o na methoi maku maiketĩke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vevũũka, ũvindĩtye, ndũkametee ũla mũkw’ũ; ĩyove kakovila kaku, noyĩkĩa iatũ syaku maũũnĩ maku, na ndũkavw’ĩke ilomo syaku, o na ndũkaye lĩu wa andũ. ",
          "type": "text",
