          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mwathani nũkengetwe na akaneena ndeto, nyie, Yeova, nĩnĩkengete mwathani ũsu, na ngamũtambũũkĩsya kw’oko kwakwa, na ngamwananga aume andũnĩ makwa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.9",
            "verseOrgIds": [
              "EZK.14.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
