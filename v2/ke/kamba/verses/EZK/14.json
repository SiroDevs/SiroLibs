          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa mũndũ, yĩla nthĩ ĩkambĩtanĩsya kwondũ wa kwĩka naĩ, nakwa ngamĩtambũũkĩsya kw’oko kwakwa, na kũtũla ndata ya kĩmũtũ kyayo, na kũmĩetee yũa, na kũveta kwayo mũndũ na nyamũ; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.13",
            "verseOrgIds": [
              "EZK.14.13"
            ]
          }
        },
