            "number": "10",
            "style": "v",
            "sid": "EZK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makakua ũthũku woo: ũthũku wa mwathanĩ ũkethĩwa ta ũthũku wa ũla ũmũkũlasya; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.10",
            "verseOrgIds": [
              "EZK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana nyũmba ya Isilaeli ndĩkaende ĩkyanganga ĩngĩ kũasa nakwa, kana kwĩthũkya ĩngĩ na movĩtyo moo onthe; ĩndĩ nĩ kana methĩwe andũ makwa, nakwa nĩthĩwe Ngai woo, easya ũu Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.11",
            "verseOrgIds": [
              "EZK.14.11"
            ]
          }
        },
