              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.4"
              },
              "items": [
                {
                  "text": "Ũvu 9.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.6",
            "verseOrgIds": [
              "EZK.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amea, Vukyai ĩ nyũmba, na mũyusũsya nza ala mooawa: umaalai. Na maumaala, na makũna ndũa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.7",
            "verseOrgIds": [
              "EZK.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa yĩla maĩ makĩkũna, nakwa nĩtiĩtwe, navalũka na ũthyũ wakwa, na naĩa, na nasya, A! Mwĩaĩi Yeova! Ũkaananga ũtĩalo w’onthe wa Isilaeli kwonosyanĩ kwaku kwa ũthilĩku waku ĩũlũ wa Yelusaleme? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.8",
            "verseOrgIds": [
              "EZK.9.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
