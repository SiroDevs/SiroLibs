          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngalĩ ĩ yakwa, itho yakwa yĩtikaekea, o na ndikew’ĩa tei, ĩndĩ ngaete mĩendele yoo mĩtwenĩ yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        },
