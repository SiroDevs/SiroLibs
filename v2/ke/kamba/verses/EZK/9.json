              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, ũla mũndũ wevw’ĩkĩte ngũa ya katane, ũla waĩ na ũvya wa ingĩ kĩnyunyunĩ kyake, atũnga ũvoo, akyasya, Nĩnĩkĩte o ũndũ wambĩaĩe.",
          "type": "text",
          "attrs": {
