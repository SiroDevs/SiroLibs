                "loc": "PSA.119.136"
              },
              "items": [
                {
                  "text": "Sav 119.136",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Ũvu 7.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amea ala angĩ ngĩw’a na matũ makwa, Vĩtĩlai ndũanĩ ĩtina wake, na mũikũna: itho yenyu yĩtĩkaekee, o na mũtikew’ĩe tei; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.5",
            "verseOrgIds": [
              "EZK.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũaai vyũ mũtumĩa, mwanake na mwĩĩtu mũtheu, na syana nini na aka; ĩndĩ mũtikathengeee mũndũ o na wĩva ũla wĩ na ũla ũvano: na ambĩlĩlyai vala vandũ vakwa vatheu. Na ĩndĩ mambĩlĩlya na atumĩa ala maĩ mbee wa ĩ nyũmba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.6",
            "verseOrgIds": [
              "EZK.9.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
