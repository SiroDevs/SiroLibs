          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa mũndũ, nĩnĩtũlĩte kw’oko kwa Valao mũsumbĩ wa Misili; na, sisya, kũtyaaovwa, kwĩkĩwe mĩtĩ ya ũvosya, kũlingĩlĩĩlwe kĩtambaa, nĩ kana kwĩthĩwe na vinya wa kũkwata ũvyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.21",
            "verseOrgIds": [
