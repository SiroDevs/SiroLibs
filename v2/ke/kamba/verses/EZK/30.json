              },
              "items": [
                {
                  "text": "Isa 19.4–6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.10"
              },
              "items": [
                {
                  "text": "Esek 29.10",
