              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nganyaĩĩkĩsya Amisili mbaĩnĩ, na kũmanyaĩĩkĩsya katĩ wa i nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.23",
            "verseOrgIds": [
