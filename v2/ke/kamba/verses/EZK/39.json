              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũkaya mathunya kũvika mwavũna, na kũnyw’a nthakame kũvika mwatoona, ya nthembo yakwa ĩla nĩthembete kwondũ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
