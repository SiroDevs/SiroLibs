                {
                  "text": "Isa 33.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkethĩwa mũthenya ũsu, nganenga Ngoki vandũ va kũthika andũ nthĩ ya Isilaeli, mwanda wa ala mavĩtĩlaa ngalĩ ya wumĩlonĩ wa syũa ya ũkanga; na vakasiĩĩaa ala mavĩtĩlaa vo: na ku nĩkw’o makenzĩa Ngoki nthĩ na wingĩ w’onthe wa andũ make; na makaveta Mwanda wa Aamoni‐ngoki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.11",
            "verseOrgIds": [
              "EZK.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ ma nyũmba ya Isilaeli makamenzĩa nthĩ myei mũonza, nĩ kana mathesye nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.12",
            "verseOrgIds": [
              "EZK.39.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Kũt 21.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.12",
            "verseOrgIds": [
              "EZK.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩĩ, andũ onthe ma ĩ nthĩ makamenzĩa nthĩ; na kũkeethĩwa nguma kwoo mũthenya ũla ngataĩwa, easya ũu Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.13",
            "verseOrgIds": [
              "EZK.39.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.22"
              },
              "items": [
                {
                  "text": "Esek 28.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.13",
            "verseOrgIds": [
              "EZK.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makanyuva andũ ma kũtethya wĩa ĩndĩ yonthe, ala mevĩtĩlaa ĩ nthĩ, makĩnzĩa nthĩ me na avĩti ala matialĩte ĩũlũ wa nthĩ, mamĩthesye: ĩtina wa myei mũonza makamantha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.14",
            "verseOrgIds": [
              "EZK.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala avĩti mavĩtĩlaa ĩ nthĩ makavĩtĩlaa; yĩla ũmwe wona ĩvĩndĩ ya mũndũ, akaũngamya ũvano vakuvĩ nayo, kũvika yĩla ala menzĩaa nthĩ meyĩnzĩa nthĩ mwandanĩ wa Aamoni‐ngoki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.15",
            "verseOrgIds": [
              "EZK.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ĩngĩ syĩtwa ya Amona yĩkeethĩwa ya ndũa. Ũũ nĩw’o makathesya nthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        }
      ]
    },
    {
