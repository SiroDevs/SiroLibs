                {
                  "text": "Isa 22.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.3"
              },
              "items": [
                {
                  "text": "Esek 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.6",
            "verseOrgIds": [
              "EZK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, yĩla mekũkũlya, Wĩvevũũkw’a nĩ kyaũ? Ũkasũngĩa, Nũndũ wa ũvoo, nũndũ nĩwũkĩte; na kĩla ngoo ĩkatweka, na moko onthe makaleela, na kĩla veva ũkateva, na mau onthe makeethĩwa mate vinya ta manzĩ: sisya, nĩwũkĩte, na ũkeekĩka, easya ũu Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        },
        {
