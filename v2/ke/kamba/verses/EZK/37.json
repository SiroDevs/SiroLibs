                "loc": "EZK.1.3"
              },
              "items": [
                {
                  "text": "Esek 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.12"
              },
              "items": [
                {
                  "text": "3.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atuma nĩvĩta nĩmathyũlũlũkĩte: na, sisya, kwaĩ maingĩ mũno mwandanĩ ũtheinĩ; na, sisya, maĩ momũ mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.2",
            "verseOrgIds": [
              "EZK.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na angũlya, Mwana wa mũndũ, mavĩndĩ aa nĩmatonya kwĩthĩwa thayũ? Na nasũngĩa, We Mwĩaĩi Yeova, nĩwĩsĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.39"
              },
              "items": [
                {
                  "text": "Kũt 32.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.35"
              },
              "items": [
                {
                  "text": "1 Ako 15.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩngĩ ambĩa, Athana ĩũlũ wa mavĩndĩ aa, ũmatavye, Inyw’ĩ mavĩndĩ momũ, ĩthukĩĩsyei ndeto ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.2"
              },
              "items": [
                {
                  "text": "Esek 6.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.28"
              },
              "items": [
                {
                  "text": "Yoa 5.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Mwĩaĩi Yeova ũnũũmea mavĩndĩ aa: Sisyai, ngatuma veva ũlika nthĩnĩ wenyu, na mũkeethĩwa thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngeekĩa malangũ ĩũlũ wenyu, na ngaete nyama ĩũlũ wenyu, na kũmũvw’ĩka kĩkonde, na kwĩkĩa veva nthĩnĩ wenyu, na mũkeethĩwa thayũ; na mũkamanya ninyie Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.7"
              },
              "items": [
                {
                  "text": "Esek 6.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
