            "number": "15",
            "style": "v",
            "sid": "EZK 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ya Yeova yambũkĩa ĩngĩ, ĩkĩmbĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku, mwana wa mũndũ, osa mũtĩ ũmwe, ũandĩke ĩũlũ waw’o, Kwa Yuta, na kwa ana ma Isilaeli atindan’ya make: na ĩndĩ osa mũtĩ ũngĩ, ũandĩke ĩũlũ waw’o, Kwa Yosevu, mũtĩ wa Evalaimu, na kwa nyũmba yonthe ya Isilaeli atindan’ya make: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.16",
            "verseOrgIds": [
              "EZK.37.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.48.13"
              },
              "items": [
                {
