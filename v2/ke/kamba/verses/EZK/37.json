          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mĩtĩ ĩla wĩmĩandĩka ĩkeethĩwa kw’okonĩ kwaku mbee wa metho moo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.20",
            "verseOrgIds": [
              "EZK.37.20"
            ]
          }
        },
