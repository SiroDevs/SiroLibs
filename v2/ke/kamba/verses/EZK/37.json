                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.24"
              },
              "items": [
                {
                  "text": "Esek 36.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
