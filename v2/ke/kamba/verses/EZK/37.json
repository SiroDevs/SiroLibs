            "sid": "EZK 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kw’oko kwa Yeova kwai ĩũlũ wakwa, na anumaalya nĩ Vevanĩ wa Yeova, na ambĩkalya nthĩ mwandanĩ katĩ; na waĩ mũsũu mavĩndĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
