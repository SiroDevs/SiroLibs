              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ya Yeova yambũkĩa ĩngĩ, ĩkĩmbĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩasya ata mũineena nthimo ĩno ũndũ wa nthĩ ya Isilaeli, mũkyasya, Aaĩthe nĩmaĩe nzavivũ syĩ ngaati, na maeo ma syana maya nthithi? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        },
        {
