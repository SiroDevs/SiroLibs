        },
        {
          "text": "Ĩndĩ ethĩwa mũndũ nĩ mũlũngalu na ekaa ũla wosanaa na mĩao na ũla wa w’o, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
