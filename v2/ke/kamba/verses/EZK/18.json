            "number": "6",
            "style": "v",
            "sid": "EZK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndaaĩa iĩmanĩ, o na ndaamyũkĩlĩlya mĩvw’anano ya nyũmba ya Isilaeli metho make, o na ndaavukya kĩveti kya mũtũi wake, o na ndaathengeea mũndũ mũka ũla wealũlĩte, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        },
