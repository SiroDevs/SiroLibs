          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũũ ũkeethĩwa mũvaka wa ĩ nthĩ: Ngalĩ ya ĩũlũ, kuma ũkanga mũnene, kwa nzĩa ya kũthi Ethiloni, kũvika ũlikĩlonĩ wa Nzetati; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        },
        {
          "name": "note",
