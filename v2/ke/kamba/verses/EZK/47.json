          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya: Ũũ ũkeethĩwa mũvaka, ũla mũkaan’ya nthĩ naw’o kwondũ wa ũtiĩwa kwĩanana na mbaĩ ĩkũmi na ilĩ sya Isilaeli: Yosevu akeethĩwa na ianda ilĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
