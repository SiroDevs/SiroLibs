          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nthembo ya mũtu ĩkeethĩwa eva kwondũ wa ĩla ndũũme, na nthembo ya mũtu kwondũ wa tũla tũtena twa ĩlondu o ũndũ ũtonya kũnengane, na ini ya mauta kwondũ wa kĩla eva. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
