          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyũnyi syonthe sya yayaya ikekala wanangĩkonĩ wake, na nyamũ syonthe sya kĩthekanĩ ikeethĩwa mbongenĩ syake; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
