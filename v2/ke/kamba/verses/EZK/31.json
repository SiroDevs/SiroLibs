              },
              "items": [
                {
                  "text": "Nda 5.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngamũnengane kw’okonĩ kwa ũla wĩ ũtonyi wa i mbaĩ; vate ndĩĩ akatwaatwaana nake; nĩnĩmũlũngĩtye ũndũ wa ũthũku wake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.11",
            "verseOrgIds": [
              "EZK.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aeni, ala ma ũtĩsya ma i mbaĩ, nĩmamũvetete, na nĩmamũtiĩte: mbonge syake nivalũkĩte iĩmanĩ ĩũlũ na myandanĩ yonthe, na mbonge syake nitũlĩkĩte vakuvĩ na mbũsĩ syonthe sya ĩ nthĩ; na ngo syonthe sya andũ sya nthĩ nĩsyatheeie kuma muunyĩnĩ wake, na nĩsyamũtiie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.12",
            "verseOrgIds": [
              "EZK.31.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
