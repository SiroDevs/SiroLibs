            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana mĩtĩ yonthe yĩ vakuvĩ na manzĩ ndĩkenenevye ũasanĩ wayo, kana kwia mĩthya yayo katĩ wa mbonge nthungu, kana ĩla yĩ vinya katĩ wayo ĩũngame ũasanĩ wayo, o yonthe ĩla ĩnyusaa manzĩ: nũndũ onthe nĩmanenganĩte makw’e, kũvika kũndũ kwĩ nthĩnĩ wa nthĩ, katĩ wa ana ma andũ, vamwe na ala matheeaa yĩla ĩimanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.14",
            "verseOrgIds": [
              "EZK.31.14"
            ]
          }
        },
