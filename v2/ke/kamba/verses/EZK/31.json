          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Mwĩaĩi Yeova nũnũkwasya: Nĩkwĩthĩwa nũtũlĩtw’e ũasanĩ, na kwia mũthya wake katĩ wa mbonge nthungu, na ngoo yake nĩtũlĩtw’e ũasanĩ wake; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
