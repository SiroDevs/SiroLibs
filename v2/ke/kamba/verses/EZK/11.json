          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũkavalũkw’a na ũvyũ; ngamũsilĩĩla mũvakanĩ wa Isilaeli; na mũkamanya ninyie Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.10",
            "verseOrgIds": [
              "EZK.11.10"
            ]
          }
        },
        {
