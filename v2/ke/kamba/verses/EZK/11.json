          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mathanĩe, athana, we mwana wa mũndũ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.4",
            "verseOrgIds": [
