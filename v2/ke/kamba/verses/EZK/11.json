          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngamumya nthĩnĩ wayo, na kũmũnengane mokonĩ ma aeni, na kũmũsilila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.9",
            "verseOrgIds": [
              "EZK.11.9"
            ]
          }
        },
        {
