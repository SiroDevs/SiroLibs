              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkoosa imwe nini syasyo, na kũsyoveea mũthyanĩ wa ngũa syaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.3",
