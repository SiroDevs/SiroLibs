          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndĩaaĩthukĩĩsya ũla wasya; ndĩaakwata ũmanyĩsyo; ndĩaamũĩkĩĩa Yeova; ndĩaathengeea vakuvĩ na Ngai wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
