            }
          ]
        },
        {
          "text": "Ĩndĩ ngaeka kwaku ũko wa andũ ũla ũnyamaaw’a o na ngya, na makeevitha syĩtwanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
