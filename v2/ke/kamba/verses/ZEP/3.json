          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuma mũingo ũya wa mbũsĩ sya Ethiovia avoyi makwa, o mwĩĩtu wa mũnyaĩĩkw’a wakwa, makandetee nthembo yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.10",
