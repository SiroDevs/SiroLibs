        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩvetete mbaĩ; maũvai moo matũlu nĩ mathei; nĩnĩtw’ĩkĩthĩtye nzĩa syoo nene mbanangĩku, ũndũ itavĩtĩlwa nĩ mũndũ; ndũa syoo nĩ mbanange, ũndũ itethĩwa mũndũ, ũndũ itatũwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        },
