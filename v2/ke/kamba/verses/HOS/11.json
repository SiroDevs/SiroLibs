            "sid": "HOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmakamũvikĩla Yeova, ũla ũkaluma ta mũnyambũ; nũndũ nũkaluma, na syana nikoka kuma ũthũĩlonĩ wa syũa itetemete. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        },
