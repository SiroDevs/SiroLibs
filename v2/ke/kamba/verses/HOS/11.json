              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maikasyoka nthĩ ya Misili; ĩndĩ Mũasuli akeethĩwa mũsumbĩ woo, nĩkwĩthĩwa nĩmaleile kũnzyokea. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        },
        {
