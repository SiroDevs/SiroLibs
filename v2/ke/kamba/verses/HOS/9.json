                {
                  "text": "Isa 10.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.10.8"
              },
              "items": [
                {
                  "text": "Osea 10.8",
                  "type": "text"
                }
