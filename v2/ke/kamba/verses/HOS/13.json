              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ninyie Yeova Ngai waku o kuma nthĩ ya Misili; na ndũkaamanye ngai ĩngĩ ate o nyie, na nde vo nyie vati mũtangĩĩi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
