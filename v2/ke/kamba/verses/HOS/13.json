                {
                  "text": "Osea 5.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngakomana namo ta nduva ĩvenetwe maswii mayo, na ngatembũa wambũ wa ngoo syoo; na ngamaĩa vu ta mũnyambũ mũka; nyamũ mbai ĩkamatembũanga. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
