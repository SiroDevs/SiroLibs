            "number": "7",
            "style": "v",
            "sid": "HOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu kwoo nĩilyĩ ta mũnyambũ; ngooveesya o ta ngo nzĩanĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        },
