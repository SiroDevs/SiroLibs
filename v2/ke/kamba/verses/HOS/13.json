            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
