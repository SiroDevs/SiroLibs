          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩtina wa mĩthenya ĩlĩ akatũvuũkya: mũthenya wa katatũ akatũkĩlya, na tũkeethĩwa thayũ mbee wake. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        },
        {
