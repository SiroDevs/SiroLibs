              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkai, na tũimũsyokea Yeova; nũndũ nũtũtembũĩte, na akatũvosya; nũtũkũnĩte, na akatwova. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
