          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa Evalaimu nĩwaingĩvisye ithembeo ekae naĩ, ithembeo nitw’ĩkĩte kwake kũndũ kwa naĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
