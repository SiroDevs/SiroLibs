            "number": "12",
            "style": "v",
            "sid": "HOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namũandĩkĩe maũndũ ngili ĩkũmi ma mĩao yakwa; ĩndĩ nĩmatalĩtwe o ta kĩndũ kĩeni. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.12",
            "verseOrgIds": [
              "HOS.8.12"
            ]
          }
        },
        {
