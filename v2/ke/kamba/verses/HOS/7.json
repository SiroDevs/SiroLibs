          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Evalaimu ailyĩ ĩvũĩ ĩtumanu, yĩte na ũmanyi: nĩmekaĩlaa Misili, o na maendaa Asuli. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        },
        {
