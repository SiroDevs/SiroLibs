          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla methi, ngalan’ya kĩtei kyakwa ĩũlũ wamo; ngamatheesya nthĩ ta nyũnyi sya yayaya; ngamasilĩla, o tondũ ũmbano woo wĩw’ĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
            ]
          }
        },
