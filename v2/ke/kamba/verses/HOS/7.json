                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.8.7"
              },
              "items": [
                {
                  "text": "Osea 8.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngathĩĩo sya Isilaeli nikũsĩĩaa mbee wa ũthyũ wake: ĩndĩ o na ũu w’onthe matisyokete kwa Yeova Ngai woo, o na kũmũmantha. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
