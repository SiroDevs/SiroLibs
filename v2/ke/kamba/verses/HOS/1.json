              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa mũthenya ũsu, ngatũlĩla ũta wa Isilaeli mwandanĩ wa Yesileeli. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.29"
              },
              "items": [
                {
                  "text": "2 Asu 15.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aitava ĩngĩ, na asyaa mwĩĩtu. Na Yeova amwĩa, Mwĩte syĩtwa yake Lo‐luama; nũndũ ndikambĩla kwĩw’ĩa nyũmba ya Isilaeli tei ĩngĩ, nĩmaekee kwondũ wa ũndũ o na wĩva. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
