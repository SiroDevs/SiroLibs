                {
                  "text": "Osea 13.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.14",
            "verseOrgIds": [
              "HOS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaenda nĩsyoke vandũ vakwa, mũvaka meetĩkĩla ĩvĩtyo yoo, na kũmantha ũthyũ wakwa: thĩnanĩ woo makamantha na kĩthing’ĩĩsyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.15",
            "verseOrgIds": [
              "HOS.5.15"
