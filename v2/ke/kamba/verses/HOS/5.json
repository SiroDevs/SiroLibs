              "items": [
                {
                  "text": "Osea 9.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmekĩte Yeova ũseleke; nũndũ nĩmasyaĩte syana ngeni: yu mwei mũtisu ũkamamina vamwe na mĩũnda yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        },
        {
