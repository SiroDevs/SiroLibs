          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩmwĩsĩ Evalaimu, na Isilaeli ndembithĩte; nũndũ yu, we Evalaimu, nĩwĩkĩte ũmalwaya, Isilaeli nũvukĩtw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        },
        {
