                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.12",
            "verseOrgIds": [
              "HOS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla Evalaimu wonie ũwau wake, na Yuta wonie wũkite wake, nĩvo Evalaimu waendie Asuli, na atũmana kwa mũsumbĩ Yalevu: ĩndĩ ndatonya kũkũvosya, o na ndakakũvosya wũkite waku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.13",
            "verseOrgIds": [
              "HOS.5.13"
            ]
          }
        },
        {
