          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na alei nĩmalikĩte mũno ũainĩ; ĩndĩ nyie nĩ mũkan’ya wa onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
