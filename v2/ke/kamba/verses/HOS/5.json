                {
                  "text": "Kũt 19.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evalaimu nũthĩnĩtw’e, nũtumbĩĩwe ũsilĩlonĩ; nĩkwĩthĩwa nĩwendeew’e nĩ kũatĩĩa mwĩao wa mũndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.11",
            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
