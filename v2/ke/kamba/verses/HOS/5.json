            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nyie kwa Evalaimu nĩilyĩ lungulu, na kwa nyũmba ya Yuta nĩilyĩ wou. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.12",
            "verseOrgIds": [
              "HOS.5.12"
            ]
          }
        },
        {
