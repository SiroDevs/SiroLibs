              },
              "items": [
                {
                  "text": "Isa 59.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngathĩĩo sya Isilaeli nĩkũsĩĩaa mbee wa ũthyũ wake: kwondũ wa ũu Isilaeli na Evalaimu makalulutĩka ũthũkunĩ woo; nake Yuta akalulutĩka vamwe nao. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.7.10"
              },
              "items": [
                {
                  "text": "Osea 7.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makaenda na ndĩthya syoo sya mbũi na malondu na ndĩthya syoo sya ng’ombe mamũmanthe Yeova; ĩndĩ matikamwona: nĩwĩvathanĩte nao. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.11"
              },
              "items": [
                {
