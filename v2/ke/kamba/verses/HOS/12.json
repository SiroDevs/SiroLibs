          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ninyie Yeova Ngai waku o kuma nthĩ ya Misili; ngatuma ũtũa maeemanĩ o ĩngĩ, o ta mĩthenyanĩ ya mboka ĩtw’ĩtwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
