            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evalaimu nũĩsaa kĩseve, na kũatĩĩa kĩesve kyumĩte wumĩlonĩ wa syũa: nake aendeeaa kwingĩvya movũngũ na wanangĩko; na nĩmeũtianĩa ũtianĩo na Asuli, na mauta nĩmatwaawa Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
