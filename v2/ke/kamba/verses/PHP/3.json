              "attrs": {
                "loc": "GAL.6.17"
              },
              "items": [
                {
                  "text": "Aka 6.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana nĩmũmanye we, na vinya wa kũthayũũka kwake, na mũamba wa mathĩna make, ngĩvw’ananw’a na kikw’ũ kyake; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.10",
            "verseOrgIds": [
              "PHP.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 3:11"
          },
          "items": [
