                "loc": "REV.20.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana kwa ũndũ o na wĩva w’onthe nĩtonye kũvikĩa ũthayũũkyo kuma kwa akw’ũ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.11",
            "verseOrgIds": [
              "PHP.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 3:12"
          },
          "items": [
            {
