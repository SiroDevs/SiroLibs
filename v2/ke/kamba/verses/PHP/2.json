              "type": "text"
            }
          ]
        },
        {
          "text": "kĩla mũndũ wenyu ndakasũvĩe syĩndũ syake mwene, ĩndĩ kĩla ũmwe wenyu nasũvĩe syĩndũ sya ala angĩ nasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
