            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũikeke ũndũ o na wĩva na ngananĩo kana kwĩkathĩĩa kwa mana, ĩndĩ na wĩnyivyo kĩla mũndũ namũtale ũla ũngĩ mũseo kwĩ we mwene; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.3",
            "verseOrgIds": [
              "PHP.2.3"
            ]
          }
        },
        {
