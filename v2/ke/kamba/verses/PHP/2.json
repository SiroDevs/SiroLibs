          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩwai na kĩlilikano kĩĩ nthĩnĩ wenyu, o kĩla kyaĩ nthĩnĩ wa Klĩsto Yesũ: ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.5",
            "verseOrgIds": [
              "PHP.2.5"
            ]
          }
        },
