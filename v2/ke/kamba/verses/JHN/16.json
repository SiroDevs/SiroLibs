                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.4"
              },
              "items": [
                {
                  "text": "1 Yoa 5.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ aa namũtavya, nĩ kana nthĩnĩ wakwa mwĩthĩwe na mũuo. Kũũ nthĩ mwĩ na thĩna: ĩndĩ ĩthĩwai na ũnyiau; nyie, nĩngĩlĩtye nthĩ vinya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.33",
            "verseOrgIds": [
              "JHN.16.33"
            ]
          }
        }
