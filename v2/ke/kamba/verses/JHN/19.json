              "JHN.19.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Kũt 21.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Ayuti, nũndũ kwaĩ Ũseũvyo, kana simba itikekale ngelan’yonĩ mũthenya wa savato (nũndũ savato ũsu waĩ mũthenya mũnene), mamũvoya Vilato maũũ moo matũlwe, nĩ kana simba ivetwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.31",
            "verseOrgIds": [
              "JHN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ asikalĩ mooka, matũla ũla wa mbee maũũ, na ũla ũngi wambiwe nake: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.32",
            "verseOrgIds": [
              "JHN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mavika vala ve Yesũ, na meethĩa nũkwie, maiaamũtũla maũũ: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.33",
            "verseOrgIds": [
              "JHN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ate o mũsikalĩ ũmwe wamũtonyie mbaunĩ na ĩtumo, na oyu vauma nthakame na manzĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.34",
            "verseOrgIds": [
              "JHN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla wonie nĩwe ngũsĩ, na ũkũsĩ wake nĩ wa w’o: nake nĩwĩsĩ kana eneena w’o, nĩ kana nenyu mwĩtĩkĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.35",
            "verseOrgIds": [
              "JHN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.46"
              },
              "items": [
                {
                  "text": "Kuma 12.46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.12"
              },
              "items": [
                {
                  "text": "Mot 9.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.20"
              },
              "items": [
                {
                  "text": "Sav 34.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ aa meekiwe, kana maandĩko meanĩw’e ala maĩtye, Vai ĩvĩndĩ yake yĩkatũlwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.10"
              },
              "items": [
                {
                  "text": "Nzek 12.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Ũvu 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maandĩko angĩ maĩtye, Makamũsisya ũla matonyie.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa maũndũ asu Yosevu, mũndũ wa ndũa ya Alimathia, nake aĩ mũmanyĩw’a wa Yesũ, ĩndĩ kwa kĩmbithĩ nũndũ wa ũkĩa Ayuti, amũvoya Vilato anengwe ũthei wa kwosa mwĩĩ wa Yesũ: na Vilato eetĩkĩla. Nake athi oosa mwĩĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.2"
              },
              "items": [
                {
                  "text": "Yoa 3.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.2.11"
              },
              "items": [
                {
                  "text": "Mt 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Nikotemo nake ũla waendie mbee kwa Yesũ na ũtukũ, athi akuĩte mũvulan’yo wa manemane na uuti, ũvikya latili ĩana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo moosa mwĩĩ wa Yesũ, na moolingĩla ngũa sya katane vamwe na ũla mũvulan’yo wa mĩtĩ ĩla ĩnyungaa nesa, o ũndũ Ayuti mekaa makĩnzĩa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vakuvĩ na vala wambiwe vaĩ mũũnda; na mũũndanĩ vaĩ mbũa nzaũ, ĩla ĩtaamba kwiwa mũndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandũ vau nũndũ wa Ũseũvyo wa Ayuti (nũndũ mbũa yaĩ vakuvĩ) nĩvo mamwiie Yesũ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
      ]
    }
