                "loc": "JHN.13.3"
              },
              "items": [
                {
                  "text": "Yoa 13.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.4"
              },
              "items": [
                {
                  "text": "18.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.15"
              },
              "items": [
                {
                  "text": "Sav 22.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa ũu Yesũ amanya kana maũndũ onthe nĩmathelile, nĩ kana maandĩko meanĩw’e, asya, Nĩ na waũni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Sav 69.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vaiĩtwe nzele vo yausũĩtwe siki: na manyw’ĩthya sivanzi siki yakola, mamĩkĩa ĩsevenĩ ya mũtĩ wa ĩsovo na matwaa kanyw’anĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ avivita ũla siki, asya, Nĩwathela: na enamya mũtwe, na aumya veva wake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
    },
    {
