              },
              "items": [
                {
                  "text": "Yoe 3.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.11",
            "verseOrgIds": [
              "OBA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "OBA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ndũkasisye mũthenya wa mwana‐a‐mwenyu mũthenya wa thĩna wake mũnene, na ndũkatane ĩũlũ wa ana ma Yuta mũthenya wa wanangĩko woo; o na ndũkaneene na ngathĩĩo mũthenya wa thĩna. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.12",
            "verseOrgIds": [
              "OBA.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.11"
              },
              "items": [
                {
                  "text": "Mika 4.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.8"
              },
              "items": [
                {
                  "text": "7.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.12",
            "verseOrgIds": [
              "OBA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "OBA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkalike mbingĩlonĩ ya andũ makwa mũthenya wa wanangĩko woo mũnene; ĩĩ, ndũkasisye kũnyamawa kwoo mũthenya wa wanangĩko woo mũnene, o na mũikaakwate syĩndũ syoo mũthenya wa wanangĩko woo mũnene. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.13",
            "verseOrgIds": [
              "OBA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "OBA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndũkaũngame mavĩtanĩonĩ ma nzĩa, kũmamina andũ make ala meũvonoka; na ndũkamanengane ala make meũtiala mũthenya ũsu wa thĩna.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.14",
            "verseOrgIds": [
              "OBA.1.14"
            ]
          }
        }
      ]
    },
