              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nĩ kana mwĩmanyĩsye kwĩthĩwa na ũuu, na kwĩka maũndũ menyu ene, na kũtethya wĩa na moko menyu, o ũndũ twamwĩaĩe; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
            "verseOrgIds": [
              "1TH.4.11"
            ]
          }
        },
        {
