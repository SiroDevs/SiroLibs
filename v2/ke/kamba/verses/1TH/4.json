            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana mũendae ũndũ waĩle mbee wa ala me ũtee, na ĩngĩ mũikethĩwe na vata wa kĩndũ o na kĩva.",
          "type": "text",
          "attrs": {
