                {
                  "text": "2 Ath 3.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩ w’o nĩmwĩkaa ũndũ ũũ kwa ana‐a‐asa onthe ala me Masetonia kw’onthe. Ĩndĩ nĩtũũmwĩsũva, ana‐a‐asa, nĩ kana mwongeleele ũu mũno mbee; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.10",
            "verseOrgIds": [
              "1TH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
