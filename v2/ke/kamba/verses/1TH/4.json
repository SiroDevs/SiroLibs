              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũndũ wa wendano wa ana‐a‐asa mũi na vata wa mũndũ kũmũandĩkĩa: nũndũ inyw’ĩ ene nĩmũmanyĩaw’a nĩ Ngai kwendana ene kwa ene; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
            "verseOrgIds": [
              "1TH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
