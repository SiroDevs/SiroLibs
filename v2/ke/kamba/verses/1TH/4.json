              "attrs": {
                "loc": "EZK.37.14"
              },
              "items": [
                {
                  "text": "37.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ũla ũnũũlea, ndeũmũlea mũndũ, ĩndĩ emũlea Ngai, ũla ũmũnengae inyw’ĩ Veva Mũtheu wake.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        }
