              "type": "tag",
              "attrs": {
                "loc": "2TH.1.5"
              },
              "items": [
                {
                  "text": "2 Ath 1.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
