                  "text": "7.52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ala mamũaie Mwĩaĩi Yesũ na athani, na matũlũngya ithyĩ, na maimwendeeasya Ngai, na nĩmakananĩasya andũ onthe; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
