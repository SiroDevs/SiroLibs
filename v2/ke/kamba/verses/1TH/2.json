              },
              "items": [
                {
                  "text": "2 Vet 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ tũtyaaoneka o na ĩvinda yĩva tũkĩneena ndeto sya kũkathĩĩa andũ, o ũndũ mwĩsĩ, kana kũvw’ĩka wendi wa syĩndũ, Ngai nĩwe ngũsĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.5",
            "verseOrgIds": [
              "1TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.41"
              },
              "items": [
                {
                  "text": "Yoa 5.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na tũtyaamantha ndaĩa kuma kwa andũ, o na inyw’ĩ kana andũ angĩ, o na kau twaĩ tũtonya kwĩthĩwa mũio mũito kwenyu nũndũ twaĩ atũmwa ma Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.6",
            "verseOrgIds": [
              "1TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ twaĩ auu katĩ wenyu, o tondũ mũei ũsũvĩaa syana syake mwene: ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.7",
            "verseOrgIds": [
              "1TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ta ũu, tũkĩmwenda na wendo mwingĩ, nĩtweewie mũyo mũno kũmũnenga inyw’ĩ ti ũla ũvoo mũseo wa Ngai w’oka, ĩndĩ o na mathayũ maitũ, nĩkwĩthiwa mũtw’ĩkĩte endwa maitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.8",
            "verseOrgIds": [
              "1TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.12"
              },
              "items": [
                {
                  "text": "1 Ako 4.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.34"
              },
              "items": [
                {
                  "text": "Meko 20.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩmũũlilikana, ana‐a‐asa, kũthĩnĩa wĩa kwitũ na ũnyamao witũ; tũkĩtethya wĩa ũtukũ na mũthenya, nĩ kana tũikethĩwe mũio kwa mũndũ o na wĩva wenyu, twamũtavisye ũla ũvoo mũseo wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.9",
            "verseOrgIds": [
              "1TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyw’ĩ mwi ngũsĩ, o na Ngai nake, ũndũ twekalile kwenyu inyw’ĩ ala mwĩtĩkĩlaa twĩ na mwĩkalĩle wa ũtheu na ũlũngalu na tũtyailĩĩlĩka ũthũku: ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.10",
            "verseOrgIds": [
              "1TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.31"
              },
              "items": [
                {
                  "text": "Meko 20.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o tondũ mwĩsĩ ũndũ twamwĩkĩe kĩla ũmwe wenyu, ta ũndũ ĩthe wĩkaa syana syake mwene, tũkĩmũtaa, na kũmwĩkĩa vinya ngoonĩ, na kũkũsĩĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
