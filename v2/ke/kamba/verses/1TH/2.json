                "loc": "1PE.5.10"
              },
              "items": [
                {
                  "text": "1 Vet 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana mũendae ũndũ kwaĩle kwa Ngai, ũla ũmwĩtaa mũlike ũsumbĩnĩ na ũtheunĩ wake mũtisu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        }
