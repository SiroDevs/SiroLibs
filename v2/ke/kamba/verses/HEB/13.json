                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũikolwe nĩ kwĩka nesa na kũolanĩla: nũndũ Ngai nĩwendeeaw’a nĩ nthembo ta isu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.16",
            "verseOrgIds": [
