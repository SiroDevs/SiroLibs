              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manyai kana mwana‐a‐asa waitũ Timotheo nũthaĩtw’e; nake ethĩwa akooka mĩtũkĩ, ngoonana nenyu vamwe nake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
