              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩkwĩthĩwa twĩ na mũthembi mũnene mbee, ũla walikile ĩtunĩ, Yesũ Mwana wa Ngai, tũkwate mũno kumbũla kwitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
