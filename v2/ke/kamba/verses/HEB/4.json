          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.17"
              },
              "items": [
                {
                  "text": "Aevl 2.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ tũi na mũthembi mũnene ũla ũtatonya kũtwĩw’ĩa tei mawonzunĩ maitũ; ĩndĩ nĩ ũmwe watatiwe maũndũnĩ onthe o tondũ tũtatawa, ate na naĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
