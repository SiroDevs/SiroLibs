              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ ĩeema na mĩio yonthe ya ũthaithĩ aminzangĩsya nthakame o ta ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
