              },
              "items": [
                {
                  "text": "Mot 19.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩkwĩthĩwa nĩ motw’ĩo ma maũndũ ma mwĩĩ ki, sya ũya na sya ũnyw’a na kũthesya kwa mĩthemba mingĩ, ala maiiwe kũvika ĩvinda yĩkoka yĩla maũndũ makaseũvw’a methĩwe meũ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
