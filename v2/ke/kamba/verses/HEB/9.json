              "attrs": {
                "loc": "EXO.26.34"
              },
              "items": [
                {
                  "text": "26.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩũlũ wayo vaĩ akeluvi ma ũtheu mũtisu mekĩae muunyĩ wĩkalonĩ wa tei; tũitonya kũneena yu ũvoo wa syĩndũ ĩsu kĩmwe na kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.3"
              },
              "items": [
                {
                  "text": "Mot 18.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
