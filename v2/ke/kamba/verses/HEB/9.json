                "loc": "NUM.18.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ syĩndũ isu iminĩtwe kũseũvw’a ũu, athembi nĩmalikaa ĩeemanĩ ya mbee mĩthenya yonthe, makĩanĩsya ũthaithi woo; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
