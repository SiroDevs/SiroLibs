              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ o na ũla ũtianĩo wa mbee waĩ na motw’io ma kũthaitha Ngai, na vandũ vatheu vaw’o vaĩ va nthĩ ĩno. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.23"
              },
              "items": [
                {
                  "text": "Kuma 25.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
