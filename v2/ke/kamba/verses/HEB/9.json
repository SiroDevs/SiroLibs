          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na ti kwondũ wa nthakame ya mbũi na tũsaũ, ĩndĩ kwondũ wa nthakame yake mwene, nĩwavotie vala vandũ o ĩmwe tũ, osete wovosyo wa tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
            "verseOrgIds": [
              "HEB.9.12"
            ]
          }
        },
