              "HEB.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.14"
              },
              "items": [
                {
                  "text": "Aevl 4.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa mũthembi mũnene ta ũsu nĩwatwaĩle ithyĩ, ũla mũtheu, ũtaĩ na ũkengani, ũtaĩ na ũvuku, ũla wavathanĩtw’e na andũ athe, na watũlilw’e ĩũlũ wa matu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.6"
              },
              "items": [
                {
                  "text": "Ali 16.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla ũte vata kĩla mĩthenya, ta athembi asu anene, kumya nthembo, mbee kwondũ wa nai syake mwene, na ĩndĩ kwondũ wa naĩ sya andũ; nũndũ nĩwekie ũu o ĩmwe, yĩla weyumisye mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.1"
              },
              "items": [
                {
                  "text": "Aevl 5.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ĩla mĩao ĩmaiaa andũ me na wonzu methĩwe athembi anene; ĩndĩ ndeto ya wĩvĩto, ũla wookie ĩtina wa ĩla mĩao, yamwiie Mwana ũla wĩanĩe kũvika tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.28",
            "verseOrgIds": [
              "HEB.7.28"
            ]
          }
        }
      ]
    }
