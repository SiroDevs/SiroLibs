              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.14"
              },
              "items": [
                {
                  "text": "Aevl 4.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, ana‐a‐asa atheu, osi ma wĩtano wa ĩtunĩ, sũanĩai mũno ũla Mũtũmwa na Mũthembi Mũnene wa kumbũla kwitũ, nake nĩ Yesũ; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
              "HEB.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.7"
              },
              "items": [
                {
                  "text": "Mot 12.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla waĩ na kĩthito kwa ũla wamwiie, o tondũ Mose nake wailyĩ nyũmbanĩ yake yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.2",
            "verseOrgIds": [
              "HEB.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ we nĩwatalilwe nĩwaĩlwe nĩ ũtaĩo mwingĩ kwĩ Mose, o tondũ ũla wakĩte nyũmba wĩ na ndaĩa nyingĩ kwĩ ĩ nyũmba. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.3",
            "verseOrgIds": [
              "HEB.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa kĩla nyũmba yakĩtwe nĩ mũndũ: ĩndĩ ũla ũseũvĩtye syĩndũ syonthe nĩ Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.4",
            "verseOrgIds": [
              "HEB.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.7"
              },
              "items": [
                {
                  "text": "Mot 12.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩ w’o Mose aĩ na kĩthito nyũmbanĩ yake yonthe ta mũthũkũmi, ethĩwe na ũkũsĩ wa maũndũ asu ala makaneenwa ĩtina; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.5",
            "verseOrgIds": [
              "HEB.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.19"
              },
              "items": [
                {
                  "text": "Aev 2.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.23"
              },
              "items": [
                {
                  "text": "Ako 1.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ Klĩsto ta mwana, ĩũlũ wa nyũmba ya Ngai; nayo nyũmba yake nĩ ithyĩ, ethĩwa nĩtũũlũmya mũno ũkũmbaũ witũ na kwĩkathĩĩa kwa wĩkwatyo witũ kũvika mũminũkĩlyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, o tondũ Veva Mũtheu ũnũũneena,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.11",
            "verseOrgIds": [
              "HEB.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩsũvĩei, ana‐a‐asa, kũikese kwĩthĩwa ũmwe wenyu wĩ na ngoo mbathe ya ũlea kwĩtĩkĩla, na kwĩvathana na Ngai ũla wĩ thayũ: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.12",
            "verseOrgIds": [
              "HEB.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.11"
              },
              "items": [
                {
                  "text": "1 Ath 5.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ taanai kĩla mũndũ na ũla ũngĩ mĩthenya yonthe, o ĩvinda yĩla yĩtawa Ũmũnthĩ; nĩ kana kũikethĩwe ũmwe wenyu ũtw’ĩka mũmũ kwondũ wa ũkengani wa naĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.13",
            "verseOrgIds": [
              "HEB.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.6.11"
              },
              "items": [
                {
                  "text": "Aevl 6.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.1"
              },
              "items": [
                {
                  "text": "11.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩtũw’ĩkĩte osi vamwe na Klĩsto, ethĩwa nĩtũkwataa wambĩlĩlyo wa kũĩkĩĩa kwitũ tũkĩlũmya kũvika mũminũkĩlyo: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.14",
            "verseOrgIds": [
              "HEB.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "yĩla kũũneenwa,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.15",
            "verseOrgIds": [
              "HEB.3.15"
            ]
          }
        }
      ]
    }
