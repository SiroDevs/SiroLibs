            "number": "12",
            "style": "v",
            "sid": "NAM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnyambũ watembũangaa tũlungu twĩanĩu nũndũ wa tũswii twaw’o, na kwita nũndũ wa mĩnyambũ yaw’o mĩka, na kusũsya ngunga syaw’o na sya nzyĩma, na isumo syaw’o na kĩla ũtembũangĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.12",
            "verseOrgIds": [
              "NAM.2.12"
            ]
          }
        },
