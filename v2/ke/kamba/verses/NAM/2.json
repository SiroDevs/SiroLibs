              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Nineva yatwĩe ĩtilyĩ ndia ya kĩw’ũ kuma tene: ĩndĩ nĩmeũkĩa. Mamanĩĩsyaa, Ũngamai, ũngamai; ĩndĩ vati ũsisya na ĩtina. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
