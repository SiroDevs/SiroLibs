                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.11",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
