            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩwaĩle we, Mwĩaĩi waitũ na Ngai waitũ, kwosa ndaĩa na nguma na vinya: nĩkwĩthĩwa nĩwoombie syĩndũ syonthe, na kwondũ wa kwenda kwaku syaĩ kw’o, na ĩngĩ syoombwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.11",
            "verseOrgIds": [
              "REV.4.11"
            ]
          }
        }
