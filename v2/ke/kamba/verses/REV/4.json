              },
              "items": [
                {
                  "text": "10.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.1"
              },
              "items": [
                {
                  "text": "Isa 6.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.47.8"
              },
              "items": [
                {
                  "text": "Sav 47.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oyu naĩ nthĩnĩ wa Veva: na sisya, kwaĩ kĩvĩla kya ũsumbĩ kiĩtwe ĩtunĩ, na ũmwe ekalile kĩla kĩvĩla; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26+EZK.1.27+EZK.1.28"
              },
              "items": [
                {
                  "text": "Esek 1.26–28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũla wakĩkalĩle, ũkĩmũsisya ailyĩ kavila ka yasivi na ka salitũ; na kwaĩ ũtaathi ũthyũlũlũkĩte kĩvĩla kyu, ũisisya ũilyĩ kavila ka sumalatai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.23"
              },
              "items": [
                {
                  "text": "Isa 24.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.4"
              },
              "items": [
                {
                  "text": "Ũvu 3.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "5.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwaĩ ivĩla sya ũsumbĩ mĩongo ĩlĩ na inya ithyũlũlũkĩte kĩla kĩvĩla kya ũsumbĩ: na ivĩlanĩ isu nĩnoonie atumĩa mĩongo ĩlĩ na ana masyĩkalĩle, mekĩe ngũa nzaũ; na mĩtwenĩ yoo kwaĩ ngovia sya ũsumbĩ sya thaavu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
