            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26"
              },
              "items": [
                {
                  "text": "Esek 1.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
