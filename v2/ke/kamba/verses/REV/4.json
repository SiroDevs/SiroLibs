              },
              "items": [
                {
                  "text": "Isa 6.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mbee wa kĩvĩla, kwaĩ kĩndũ kĩilyĩ ũkanga wa kĩsisyo kĩtisu; na kĩvĩlanĩ kyu katĩ, na kũthyũlũlũka kĩvĩla, kwaĩ syũmbe inya syĩ thayũ syusĩe metho mbee na ĩtina. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.10"
              },
              "items": [
                {
                  "text": "Esek 1.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "10.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kyũmbe kya mbee kyailyĩ mũnyambũ, na kya kelĩ ta kasaũ, na kya katatũ kyaĩ na ũthyũ ta wa mũndũ, na kĩla kya kana kyailyĩ ndiũ ĩũlũkĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na syũmbe isu inya syĩ thayũ, kĩla kĩmwe kyethĩwa na nthwau thanthatũ, syusũĩte metho ndee syonthe na nthĩnĩ; nasyo itithũmũaa mũthenya na ũtukũ, ikyasya,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
    },
