                "loc": "ZEC.4.2"
              },
              "items": [
                {
                  "text": "Nzek 4.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩvĩlanĩ kyu kwauma motisi na mawasya na itundumo. Na kwaĩ mataa mũonza ma mwaki makanĩte mbee wa kĩvĩla kyu kya ũsumbĩ, nao nĩ ala Maveva mũonza ma Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.22"
              },
              "items": [
                {
                  "text": "Esek 1.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
