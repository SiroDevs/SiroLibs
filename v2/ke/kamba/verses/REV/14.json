                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na maina wathi weũ mbee wa kĩvĩla kya ũsumbĩ, na mbee wa ila syũmbe inya syĩ thayũ na ala atumĩa: na vai mũndũ waatonya kwĩmanyĩsya wathi ũsu, ate o ala ngili ĩana na mĩongo ĩna na inya, ala methooetwe kumw’a nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
