              "items": [
                {
                  "text": "Aev 5.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa nĩo ala matavukĩt’we nĩ aka; nũndũ nĩ atheu vyũ. Asu nĩo ala mavikĩlaa Katena ka ĩlondu o vala ũendaa. Aa mathooetwe kumw’a andũnĩ, methĩwe ũsyao wa mbee kwa Ngai na kwa kala Katena. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
