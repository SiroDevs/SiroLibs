                  "text": "Yoe 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka ũngĩ auma ĩkalũnĩ, akyanĩĩsya ũla ũilyĩ ĩũlũ wa ĩthweo, akĩmwĩa, Likya kavyũ kaku, ũkethe: nũndũ saa wa ũketha nĩ mũviku; nũndũ ngetha ya nthĩ nĩminĩte kũma. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
        {
