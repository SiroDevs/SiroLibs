            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makanyw’anĩ moo vaiaaoneka ũvũngũ: mati na ũndũ ũtaĩle.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
