          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla wailyĩ ĩũlũ wa ĩthweo ekya nthĩ kavyũ kake; na nthĩ yakethwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        }
