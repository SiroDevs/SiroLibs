                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neew’a kĩthembeo kĩiasya, Ĩĩ, we Mwĩaĩi Ngai, Mwene Vinya W’onthe, motw’ĩo maku nĩ ma w’o na nĩ malũngalu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
