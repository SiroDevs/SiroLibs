              "items": [
                {
                  "text": "Sav 79.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩmetĩkisye nthakame ya atheu na athani, naku wamanenga nthakame manyw’e: nĩmaĩlwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        },
