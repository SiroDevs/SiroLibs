              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ mavĩvw’a na ũvyũvu mũnene: na mayĩuma syĩtwa ya Ngai ũla wĩ na ũkũmũ ĩũlũ wa mothĩn’yo asu; na matyaalyũla ngoo na kũmũnenga ndaĩa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        }
      ]
    },
