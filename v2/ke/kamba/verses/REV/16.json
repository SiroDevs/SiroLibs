              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla wa kana eta mbakũli yake ĩũlũ wa syũa; na yanengwa kũvĩvya andũ na mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        },
        {
