            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neew’a mũlaĩka wa manzĩ aiasya, We wĩ mũlũngalu, ũla wĩ vo na ũla waĩ vo, we Ũla Mũtheu, nĩkwĩthĩwa nĩwasilĩla ũu: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
