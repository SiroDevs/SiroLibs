                "loc": "ISA.49.26"
              },
              "items": [
                {
                  "text": "Isa 49.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.79.3"
