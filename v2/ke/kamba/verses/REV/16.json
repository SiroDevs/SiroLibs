            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla wa katatũ eta mbakũli yake mbũsĩnĩ na nthongonĩ sya manzĩ; nasyo syatw’ĩka nthakame. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
