              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo yeeka syama nene, o na kũtuma mwaki wuma ĩtunĩ ũkavika nthĩ, andũ mene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
            "verseOrgIds": [
              "REV.13.13"
            ]
          }
        },
