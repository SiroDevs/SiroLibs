                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yanengwa kwĩkĩa mũvw’anano ũsu wa nyamũ mĩthũmũ, nĩ kana mũvw’anano wa nyamũ ũneene, o na ũtume onthe ala matethaitha mũvw’anano ũsu wa nyamũ moawa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.15",
            "verseOrgIds": [
              "REV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
