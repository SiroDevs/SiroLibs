              "items": [
                {
                  "text": "Ũvu 19.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yamakenga ala matwĩe nthĩ nũndũ wa syama ĩnengetwe kwĩka o nyamũ ĩsu yene; ĩkĩmatavya ala matwĩe nthĩ, kana maseũvye mũvw’anano wa ĩla nyamũ, ĩla ĩ na ĩkũnwa ya ũvyũ na yavoa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.14",
            "verseOrgIds": [
              "REV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
