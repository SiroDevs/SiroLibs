              "items": [
                {
                  "text": "Ũvu 19.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yatuma onthe, anini na anene, athwii na ngya, ala mate ngombo na ngombo, mekĩwa ũvano kw’okonĩ kwa aũme kwoo, kana itulyanĩ syoo; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.16",
            "verseOrgIds": [
              "REV.13.16"
            ]
          }
        },
        {
