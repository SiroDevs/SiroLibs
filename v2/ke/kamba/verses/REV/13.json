                "loc": "ISA.53.7"
              },
              "items": [
                {
                  "text": "Isa 53.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.12"
