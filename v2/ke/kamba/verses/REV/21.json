              "attrs": {
                "loc": "ISA.60.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbaĩ ikaendaa na kyeni kyaw’o: na asumbĩ ma nthĩ makaete ndaĩa yoo nthĩnĩ waw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
            "verseOrgIds": [
              "REV.21.24"
            ]
          }
        },
        {
