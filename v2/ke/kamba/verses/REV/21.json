            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akavyaĩa methoi onthe methonĩ moo; na kĩkw’ũ kĩikethĩwa vo ĩngĩ; o na kũikethĩwa ĩngĩ kũmeta, kana kũĩa, kana woo: maũndũ ma mbee nĩ mavĩtu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        },
        {
