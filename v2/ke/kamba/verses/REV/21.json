                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona ũla mũsyĩ mũtheu, Yelusaleme mweũ, ũitheea kuma ĩtunĩ kwa Ngai, ũmbanĩtw’e ta mũtwawa ũseũvĩw’e mũũme. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
