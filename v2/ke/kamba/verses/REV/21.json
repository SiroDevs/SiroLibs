                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nthĩnĩ waw’o vaikavota nongi kĩndũ kĩvuku, kana ũla wĩkaa ũthũku na ũvũngũ; ĩndĩ no ala maandĩkĩtwe ĩvukunĩ ya thayũ ya kala Katena.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.27",
            "verseOrgIds": [
