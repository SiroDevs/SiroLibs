        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.10"
              },
              "items": [
                {
                  "text": "Nzek 2.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.8"
              },
              "items": [
                {
                  "text": "Isa 8.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neew’a wasya mũnene kuma kĩvĩlanĩ kya ũsumbĩ, ũiasya, Sisya, ĩeema ya Ngai yĩ vamwe na andũ, nake akatũa vamwe nao, namo makeethĩwa andũ make, na Ngai mwene akeethĩwa vamwe nao, Ngai woo: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
