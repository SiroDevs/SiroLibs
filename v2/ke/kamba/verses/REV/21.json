                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũkĩlasya akatiĩwa maũndũ asu; nakwa ngeethĩwa Ngai wake, nake akeethĩwa mwana wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
