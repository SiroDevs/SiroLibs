            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.7"
              },
              "items": [
                {
                  "text": "Ũvu 2.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
