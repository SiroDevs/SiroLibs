            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbingĩlo syaw’o itikavingwa o na ĩndĩĩ mũthenya (nũndũ kũikethĩwa ũtukũ kw’o): ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
          }
        },
        {
