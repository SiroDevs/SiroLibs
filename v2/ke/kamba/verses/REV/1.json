            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.24"
              },
              "items": [
                {
                  "text": "Esek 1.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
