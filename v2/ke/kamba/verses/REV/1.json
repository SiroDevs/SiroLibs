                {
                  "text": "Nda 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.5"
              },
              "items": [
                {
                  "text": "10.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na katĩ wa syĩndũ isu noona ũmwe ũilyĩ mwana wa mũndũ, ekĩĩte ngũa ĩvikĩte maũũnĩ make, na eevotoele ndavũ ya thaavu nondonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
