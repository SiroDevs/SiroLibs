                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.2"
              },
              "items": [
                {
                  "text": "8.2",
                  "type": "text"
                }
              ]
            },
            {
