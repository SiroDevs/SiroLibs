                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũtwe wake na nzw’ĩĩ syake syaĩ nzaũ ta w’ĩa mweũ wa ilondu, nzaũ ta ĩa; na metho make mailyĩ ũmũĩ wa mwaki; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
