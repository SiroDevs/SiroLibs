            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nyaĩĩ syake syailyĩ ũthuku mũkute mũno ta ũtheew’e ikonĩ ĩnene yĩ mwaki; na wasya wake waĩ ta wasya wa iw’ũ nyingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
