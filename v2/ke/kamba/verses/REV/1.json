            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andĩka ĩndĩ maũndũ ala wonie, na ala me vo, na maũndũ ala makekĩka ĩtina; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
            "verseOrgIds": [
              "REV.1.19"
            ]
          }
        },
        {
