              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Isa 23.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.8"
              },
              "items": [
                {
                  "text": "Ũvu 14.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.3"
              },
              "items": [
                {
                  "text": "18.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yĩla asumbĩ ma nthĩ malaalaile nayo, na ala matwĩe nthĩ matoonw’a nĩ mbinyu ya ũiaalai wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Nda 7.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Ũvu 13.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake angua nĩ Vevanĩ kũvika weũnĩ: na noona mũndũ mũka ekalĩle nyamũ ndune mũno, yusũĩte masyĩtwa ma kũumana, ĩ na mĩtwe mũonza na mbya ĩkũmi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.13"
              },
              "items": [
                {
                  "text": "Esek 28.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yel 51.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũ mũndũ mũka eevw’ĩkĩte ngũa ĩilyĩ ta ndune na ĩngĩ ndune mũno, na aseũvĩtw’e na thaavu na tũvila twĩ thooa mũnene na malũlũ, na kw’okonĩ kwake aĩ na kĩkombe kya thaavu kyusĩwe nĩ mothatyo, nao nĩ maũndũ mavuku ma ũlaalai wake, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.7"
              },
              "items": [
                {
                  "text": "2 Ath 2.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.30"
              },
              "items": [
                {
                  "text": "Nda 4.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.8"
              },
              "items": [
                {
                  "text": "Ũvu 14.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.19"
              },
              "items": [
                {
                  "text": "16.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kĩtulyanĩ kyake vaandĩkĩtwe syĩtwa, NZAMA, MBAVILONI ĨLA NENE, INYIA WA MALWAYA NA WA MOTHATYO MA NTHĨ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.24"
              },
              "items": [
                {
                  "text": "Ũvu 18.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona mũndũ mũka ũsu aitoonw’a nĩ nthakame ya atheu, na nthakame ya ngũsĩ sya Yesũ. Namwona, naseng’a na ũseng’yo mũnene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla mũlaĩka angũlya, Nĩ kyaũ kĩũkũseng’ya? Nĩngũũtavya nzama ya mũndũ mũka ũũ, na ya nyamũ ĩla ĩmũkuĩte, ĩla ĩ na mĩtwe mũonza na mbya ĩkũmi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.7",
            "verseOrgIds": [
              "REV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.3"
              },
              "items": [
                {
                  "text": "Nda 7.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "12.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Sav 69.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1+REV.13.2+REV.13.3"
              },
              "items": [
                {
                  "text": "Ũvu 13.1–3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.5"
              },
              "items": [
                {
                  "text": "3.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamũ ĩla woona yaĩ vo, na yu ndĩ vo; na nĩkilĩlye kwambata kuma yĩla ĩimanĩ yĩte kĩtulu, na kũthi wanangĩkonĩ. Na ala matwĩe nthĩ makaseng’a, ala masyĩtwa moo mataaandĩkwa ĩvukunĩ ya thayũ kuma mwambĩlĩlyo wa nthĩ, moona ĩla nyamũ, ũndũ yaĩ vo, na yu ndĩ vo, na ĩkeethĩwa vo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Ũvu 13.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaa nĩvo ve kĩlĩko kĩ na ũĩ. Mĩtwe ĩsu mũonza nĩ iĩma mũonza, ila mũndũ mũka wĩkalĩle: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.9",
            "verseOrgIds": [
              "REV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasyo nĩ asumbĩ mũonza; atano nĩ avalũku, ũmwe e vo, na ũla ũngĩ ndanamba kũka; nake ooka, mũvaka ekale kavinda kanini. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.10",
            "verseOrgIds": [
              "REV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "Ũvu 19.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyamũ ĩla yaĩ vo, na yu ndĩ vo, nayo nĩyo ya nyanya, na nĩ ya ila mũonza; nayo ĩthi wanangĩkonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.20"
              },
              "items": [
                {
                  "text": "Nda 7.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbya ĩkũmi ila wonie nĩ asumbĩ ĩkũmi, ala matanamba kwosa ũsumbĩ; ĩndĩ meosa ũkũmũ ta asumbĩ, vamwe na nyamũ ĩsu, ĩvinda ya saa ũmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.12",
            "verseOrgIds": [
              "REV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu me na kĩlilikano kĩmwe, na memĩnenga nyamũ ĩsu vinya na ũkũmũ woo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.13",
            "verseOrgIds": [
              "REV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Kũt 10.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
