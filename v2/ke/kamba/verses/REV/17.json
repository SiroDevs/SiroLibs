                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwookie ũmwe wa alaĩka asu mũonza ala maĩ na mbakũli mũonza, aneena nakwa, akyasya, Ũka vaa, nĩngũkwon’ya ũsilĩlo wa yĩla ĩlwaya ĩnene yĩla yĩkalaa ĩũlũ wa iw’ũ nyingĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.1",
            "verseOrgIds": [
              "REV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 17:2"
          },
          "items": [
            {
