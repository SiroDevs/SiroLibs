            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Ngai ekĩĩte ngoonĩ syoo kwĩka kwenda kwake, na kwĩtĩkĩla ũndũ ũmwe, na kũmĩnenga ĩla nyamũ ũsumbĩ woo, mũvaka ndeto sya Ngai syĩanĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.17",
            "verseOrgIds": [
