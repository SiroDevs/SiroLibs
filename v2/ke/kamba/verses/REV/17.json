            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbya ĩkũmi ila wonie na ĩla nyamũ, asu makamena yĩla ĩlwaya, na makayĩtia yoka, na yĩ ĩthei, na makaya nyama syayo, na makayĩvĩvya vyũ na mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.16",
            "verseOrgIds": [
              "REV.17.16"
            ]
          }
        },
        {
