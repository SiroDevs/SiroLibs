                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.7"
              },
              "items": [
                {
                  "text": "Nda 12.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na eevĩta na ũla wĩ thayũ kũvika tene na tene, ũla wombie ĩtu na syĩndũ ila syĩ vo, na nthĩ na syĩndũ ila syĩ vo, na ũkanga na syĩndũ ila syĩ vo, kana kũikethĩwa kweteela ĩngĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
