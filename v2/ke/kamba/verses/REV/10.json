              },
              "items": [
                {
                  "text": "5.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona mũlaĩka ũngĩ wĩ na vinya aitheea kuma ĩtunĩ, evw’ĩkĩte ĩthweo; na ũtaathi waĩ mũtwenĩ wake, na ũthyũ wake wailyĩ syũa, na nyaĩĩ syake syailyĩ ituĩ sya mwaki; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.1",
            "verseOrgIds": [
              "REV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kw’okonĩ kwake aĩ na kavuku kanini kavuan’ye: nake akinya na kũũ kwake kwa aũme ũkanganĩ, na kũla kwa aka akinya nthĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.2",
            "verseOrgIds": [
              "REV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.30"
              },
              "items": [
                {
                  "text": "Yel 25.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.11.10"
              },
              "items": [
                {
                  "text": "Osea 11.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.2"
              },
              "items": [
                {
                  "text": "Amo 1.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akũthũka, o ũndũ mũnyambũ ũlumaa: na akũthũka, itundumo mũonza syaumya mawasya masyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
            "verseOrgIds": [
              "REV.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.3.26"
              },
              "items": [
                {
                  "text": "Nda 3.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.4"
              },
              "items": [
                {
                  "text": "12.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na itundumo mũonza syaumya mawasya masyo, nakilĩlye kũandĩka: na neew’a wasya ũkyuma ĩtunĩ ũkyasya, Siĩla maũndũ asu maneenwa nĩ itundumo mũonza, na ndũkamaandĩke. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.4",
            "verseOrgIds": [
              "REV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.40"
              },
              "items": [
                {
                  "text": "Kũt 32.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka ũla noonie aũngeme ũkanganĩ na nthĩ ookĩlya kw’oko kwake kwa aũme elekelye ĩtunĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
