                "loc": "ACT.3.21"
              },
              "items": [
                {
                  "text": "Meko 3.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.15"
              },
              "items": [
                {
                  "text": "Ũvu 11.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.17"
              },
              "items": [
                {
                  "text": "17.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mĩthenya ya wasya wa mũlaĩka ũsu wa mũonza, o yĩla wĩvuva soo, nĩvo nzama ya Ngai ĩkeanĩw’a, kwĩanana na ũvoo mũseo ũla watavisye ngombo syake athani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wasya ũla neewie kuma ĩtunĩ, neew’a ũineena nakwa ĩngĩ, ũkyasya, Enda, wose ĩvuku yĩla ĩvuan’ye kw’okonĩ kwa mũlaĩka ũla ũũngeme ũkanganĩ na nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.8"
              },
              "items": [
                {
                  "text": "Esek 2.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.1+EZK.31.2+EZK.31.3"
              },
              "items": [
                {
                  "text": "31.1–3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa naendie kwa mũlaĩka, namwĩa nanenge kala kavuku. Na ambĩa, Kose, ũkaye; na kakeekĩa ĩvu yaku ũũ, ĩndĩ kanyw’anĩ waku kakeethĩwa ke mũyo ta ũkĩ wa nzũkĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noosa kala kavuku kanini kw’okonĩ kwa mũlaĩka ũsu, nakaya; na kanyw’anĩ wakwa kaĩ mũyo ta ũkĩ wa nzũkĩ: na nakaya, ĩvu yakwa yeekĩwa ũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 10:11"
