              "items": [
                {
                  "text": "7.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao mambĩa, Mũvaka wathane ĩngĩ ũndũ wa ngo nyingĩ sya andũ na mbaĩ na ithyomo na asumbĩ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.11",
            "verseOrgIds": [
              "REV.10.11"
            ]
          }
        }
