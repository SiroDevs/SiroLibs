            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩmwe kya ila syũmbe inya syĩ thayũ kyamanenga alaĩka asu mũonza mbakũli mũonza sya thaavu syusĩe ũthilĩku wa Ngai, ũla wĩ thayũ kũvika tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
