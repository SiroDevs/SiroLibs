              },
              "items": [
                {
                  "text": "Esek 28.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ala alaĩka mũonza ala me na mothĩn’yo mũonza mauma ĩkalũnĩ, mevw’ĩkĩte mavia me thooa mũnene, matheu na matisu, na meevotoele nondonĩ syoo ndavũ sya thaavu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
