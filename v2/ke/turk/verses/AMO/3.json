              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Ngisirael, topupokisi akiroit naga, na alimu Ekapolon Akuj kotere ebukut lokolong epuduni ngesi alo Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etich a ekadwaran",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eriras a Samaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
