              },
              "items": [
                {
                  "text": "Tich 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Erai ayong Paulo lo arai emeanara a Yesu Kiristo kotere echami a Akuj, ta Lokaato yok Timoteo, kesi kigirunit abarua naga.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigirakinit ngitunga a ekanisa a Akuj lu eya Korinto ta ngikanupak daang lu eya wadaang alo Akaya:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kagatakinit esi ajokis ka ekisil a Akuj Apayok ta Ekapolon Yesu Kiristo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebuakinit Paulo Akuj alakara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atobuakisi Akuj na erai Apakeng a Ekapolon yok Yesu Kiristo alakara. Erai ngesi Apa lo a ngisien, Akuj na erai nikeng itoronit akingarakino daang! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingarakini ngesi ngoni alochan yok kadaang, sodi engarakineta luche lu eanyunito ngichan ngigelagelae. Erai kingarakinit kesi kotere akingarakinit napei kianyuni ngoni ani a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kona kianyunitor ngoni ngichan lukaalak lua Kiristo, loger lopei ngolo, kianyuni ngoni akingarakino a Akuj kotere Kiristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kianyu sua ngichan, kianyuni kotere akingarakino kus ka ayuuno. Ani kingarakin sua, kingarakinio esi dang sodi taanyut atitinyu na inaikineta ngichan lupei kinaikinit sua dang. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.32"
              },
              "items": [
                {
                  "text": "1 Kor 15:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni nyilochokin ngitamen kosi lu kigienor sua esi, kiyeni sua atamar eger lopei ianyunitotor esi ngichan ka sua aapei, ianyunete esi dang akingarakino napei kianyunit sua.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisaki sua esitamutu esi, ngikaitotoi, ngichan lu kianyuni sua anakwap a Asia. Kianyunit sua ngichan luaronok noi atamasi kori nyeringa tani kiyari. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosub kidungokin sua atamar kitaar. Nakaneni asubakinosi nguna sodi nyikigienokin sua agogongu kosi a ngikulepek, nakaneni egienokinos Akuj bon na iteyaruni ngikatoak. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitoyuu ngesi sua alochan aluaronok a akitu, nakaneni kiyuuni, nakaneni kigienokin sua ngesi atamar kiyuuni ngesi sua nabo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "erai kingarakinito esi sua a eger alo kilipakinitotor. Nakaneni etachunio ngakilipet kosi nakaalak, nabo kipiari Akuj sua, nabo ilipete lukaalak ebuakinito Akuj alakara kotere sua.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elochosi ngakiro na arekinit Paulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwoga sua a ibore a ipei. Kidodikinito sua ngakiro na eya lotai kosi atamar eboyor kosi anakwap kana ka erukitene kosi ka esi, arai lo etenoono dir loajokon kotere agogongu a ajokis a Akuj, meere kotere aosou a ngitunga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigirikanit esi ngakiro na ipedorete akisomare toyena. Etamit atamar iyenete lokojokon, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Tich 19:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kainyo tanang tokona, kiyana esi ayong wadio. Kiyeni atamar Akolongit na Ekapolon Yesu, kiwogatar esi dang sua loger lo kiwogar sua esi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayeni ayong dir atamar areat sek abunere nikus sodi kitopiarere esi ngapiaret ngaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo asakit ayong akitorun nikus alosi Makedonia ka na abongunio, sodi kingarakis esi ayong analosit kang anaalosio Yudea. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokona a, nakolong areator ayong kongina, asibit ayong itwaan nikeitiiton a? Ngakiro kang na areat ayong a, areat ayong kotere ni eyakar ibore ni keterekuyarit a? Sodi toliwor eikini atama, “Ee” ka “Emam” akiikinet apei a? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kona iruoror Akuj ngakiro na iteni dir, meere ngakiro nakechikak ayong esi na akiikin atamar, “Ee” ka atamar “Emam” aapei. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.18",
            "verseOrgIds": [
              "2CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo Yesu Kiristo Lokookeng a Akuj lo etatami Sila ka Timoteo ta ayong elope ngakiro keng anikus, meere ngesi lo erai, “Ee” ka “Emam” aapei. Nakaneni erai ngesi ngirwa daang “Ee” a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo ngesi erai “Ee” a ngakichikakinet kadaang a Akuj. Ngakiro nguna ngesi kitamanarea “Aamen” kitorunit nikeng, epuruutu Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erai Akuj alope kitunup sua ka esi aapei eger a akiyar ana kiraakar ngipei ka Kiristo, erai Akuj alope kitiliwo ngibekon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.21",
            "verseOrgIds": [
              "2CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.5"
              },
              "items": [
                {
                  "text": "Tich 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kimacharik ngesi ngoni emachar lo erai ekeng, nabo kitaanyu ngoni Etau keng alotai yok erai ngesi eweikinit daang na kidaritor ngesi ngoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
