          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyasun ngikito lu edonyuunere ngiworui ka ngimomwa kainyo akokito ngimomwa, toturoote ngikito lu edonyuunere ngiworui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
