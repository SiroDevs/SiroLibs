          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni nyinyasuna ngakanoi kainyo ekokeenete ekisidi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
