          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Musa ngesi tama, “Napei apudorea ayong alore, ekeari ayong ngakan kidiama elip Ekapolon Akuj. Edaun agiro ka akiru na ngamoru, sodi toyenea iyong atamar erai akwap aka Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni ayeni ayong atamar nyikerito iyong ka ngikasubak etich kon Ekapolon Akuj na erai Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        }
      ]
