          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiruor Akuj ka Musa alomoru a Sinai kerumor, nak ngesi Musa ngamoru nadapal ngaarei na egirit ngesi alope ngitalio.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
