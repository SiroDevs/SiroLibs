          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakinae ayong ngide kus lusapa lu ekingaren. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        },
