          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kilemasi esi eworu a itwaan toliwor ngesi imichaata esi ngesi, kinyiakakisi ngesi eringa akolong nyedooyoro, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
