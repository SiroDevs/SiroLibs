          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakinae ayong ngiuriuna lu ekingaren anaatuk ka ngamesekin kus. Kimiekisi ngiuriuna lu ekingaren kiruko ka ta itiokech a ngirwa a ngikan-kaarei. Ani akolongit na ngakan-kauni, kipeyokis ayong.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
