                  "text": "9:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikalapatan a ewae alo italeuno noi, kiwaak emeesa lowae loa lokwap eam kang, ka ni esipor ataa lowae loa lokuju.",
          "type": "text",
          "attrs": {
