              "EXO.33.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.15"
              },
              "items": [
                {
                  "text": "Rom 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kimaima Musa ngesi tolimok tama, “Kimiekinae kare ayong ataanyunga akwangis kon naakwaan kea.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.18",
            "verseOrgIds": [
              "EXO.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.18",
            "verseOrgIds": [
              "EXO.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Ekapolon Akuj ngesi tama, “Esitoruni ayong apolou kang daang ngaren kon, sodi atanyara ayong ekiro kang ipupi iyong. Ayong arai Ekapolon Akuj, nakaneni edodiuni ayong ajokis kang ka ngisien ani eyakasi ngulu aseu ayong. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.19",
            "verseOrgIds": [
              "EXO.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyeketaanyungari ayong iyong ereet kang, kainyo emam itwaan kaanyungari ayong kidong eyari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.20",
            "verseOrgIds": [
              "EXO.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni diyete kang nege eyei ataaba na ipedorea iyong akiwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
