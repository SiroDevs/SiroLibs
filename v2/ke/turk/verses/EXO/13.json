            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.50.25"
              },
              "items": [
                {
                  "text": "Siak 50:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.32"
              },
              "items": [
                {
                  "text": "Yoch 24:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Toting Musa akwaan a Yosep loger lokolong esikongio Yosep Ngisirael ichikichiki atamar kikokis neni. Alimuni Yosep tama, “Nakiyuunea esi Akuj, ejoikinit itingete akwaan kang tolemasi kane.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torotokis Ngisirael alo Sukos toloma nasalunet a ariet ni enyaritae Esam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.20",
            "verseOrgIds": [
              "EXO.13.20"
            ]
          }
        },
        {
