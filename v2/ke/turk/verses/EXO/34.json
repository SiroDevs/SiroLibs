          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ketwarak ayong ngibukui lu eyakasi ngaren kus kerumor, sodi eatak akwap kus, emam nabo itwaan eremi akwap kus ngaponet nauni daang iponeta esi akilip Ekapolon Akuj na erai Akuj kus.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
