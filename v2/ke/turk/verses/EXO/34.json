          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyiidorokis imesek kori ikale a ngakile a itiokeng.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
