              "JAS.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikaitotoi kang! Ani kibatar ipei kus anakiro ana iteni sodi tobuu itwaan iche ngesi, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.19",
            "verseOrgIds": [
              "JAS.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.12"
              },
              "items": [
                {
                  "text": "Matak 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.8"
              },
              "items": [
                {
                  "text": "1 Pet 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kitamutu nugu, itwaan cha daang ni ereuni ekasechan aloboyor keng aloaronon, eyuuni etau a ekasechan kangolo anakitu torimakinere ngasechesea nakaalak.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.20",
            "verseOrgIds": [
              "JAS.5.20"
            ]
          }
        }
