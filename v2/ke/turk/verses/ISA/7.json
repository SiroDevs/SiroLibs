          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloose ngikerikak inaa etingito ngakawa ka ngimalea. Ee robo, ilelebun akwap daang ngirega ka ngiikwa tomutonon. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
            "verseOrgIds": [
