                "loc": "2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15+2KI.24.16"
              },
              "items": [
                {
                  "text": "2 Kapol 24:10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Ngirwa 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Erikio ngalesea ngache na iyanatar iyong, toliworos ngikiliok lu idongitoe lu esubete etich alokai a ekapolon a Babilonia.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
      ]
    },
