            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.48"
              },
              "items": [
                {
                  "text": "Mar 9:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ani enyounete kesi, ingolikinete ngawat nakatoak a ngitunga alu kangerete ayong. Ngikuru lu enyamete ngawat nguna, nyetoakete jik. Akim na enomi kesi, nyedunge jik. Ekadakini ngitunga daang akingolikin kesi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.24",
            "verseOrgIds": [
              "ISA.66.24"
            ]
          }
        }
      ]
