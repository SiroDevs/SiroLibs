          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi engis ayong atama, “Ngirwa ngiai irikarete ngakiro nugu, Ekapolon?” Katatachak ngesi ayong tama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
