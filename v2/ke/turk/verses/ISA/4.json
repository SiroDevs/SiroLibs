            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.16"
              },
              "items": [
                {
                  "text": "24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eliwor akwangis keng etorube lo imuki ere nyeenom akolong naparan. Kitiliwo ere ngolo lo emam naaronok, ni emechere akiru ka ekuwam.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
