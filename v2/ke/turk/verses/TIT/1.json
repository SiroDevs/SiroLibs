                "loc": "2CO.8.23"
              },
              "items": [
                {
                  "text": "2 Kor 8:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.3"
              },
              "items": [
                {
                  "text": "Gal 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.10"
              },
              "items": [
                {
                  "text": "2 Tim 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Egirakinit ayong Tito lo erai lokookang dir anakiro a Akuj ana kinupit ngoni daang.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agasi atamar kitaanyu Akuj Apa ka Yesu Kiristo Ekayuunan yok ajokis ka ekisil.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etich a Tito alo Kirete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaisikini ayong iyong alo Kirete, tosubak ngakiro daang na aroko nyesubakina, nabo toseu ngikasukou a ngikanisae alorerea kadaang loger lo kolong kalimokinitor. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.5",
            "verseOrgIds": [
              "TIT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejoikinit ekasukout a ekanisa peitoronitae, ejoikinit erikit aberu apei bon. Ejoikinit ngide keng eraakasi lu enupito ngakiro a Akuj nabo nyeeliworosi kesi lua nginyas kori lu nyepupete ngakiro. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.6",
            "verseOrgIds": [
              "TIT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kona epolokinitor ekarikon a ekanisa etich a Akuj, nyejoikinit ngesi itoronitae. Nyejoikinit ngesi erai itwaan nikewogan kori ni edesem etau, kori nikelewan kori nikaadengan, kori ni iterekuyarito ngaropiyae. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejoikinit ngesi erai itwaan ni ipeyoununi ngipeyok anawi, nabo tarai itwaan ni emina ngakiro naajokak. Ejoikinit erai itwaan ni iapunit ngakiro, ka ni etenoono, ta ni italeuno tochoikinite ngakiro. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.2+1TI.3.3+1TI.3.4+1TI.3.5+1TI.3.6+1TI.3.7"
              },
              "items": [
                {
                  "text": "1 Tim 3:2-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ejoikinit ngesi etionikini jiik anupit ngakiro a Akuj na iteni loger lo itatamere. Aloger kangolo, epedori ngesi akitititiny luche a akitatamet ana iteni ani nabo dang kisileereu ngakiro na ichwangakinito lu epegasi ngakiro a Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo eyakasi ngikaalak lu engerito Akuj, ngitunga lu iruorosi ngakiro napasiek, kingalaate ngitunga, tarai cha noi lu areeunosi alodin a Ngiyaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.10",
            "verseOrgIds": [
              "TIT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejoikina kesi isililingio, kainyo echana kesi ngitunga a ngawiyei anakaalak ani itatameta ngakiro na nyejoikinit itatamete, esubete kesi kongina ani esaketa aanyun ngaropiyae na a ngileech. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
            "verseOrgIds": [
              "TIT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwaan a Kirete elope niarai epei a ngikadwarak kech, ngesi alimuni ngakiro na iteni tama, “Eliokoko ngitunga a Kirete ngipean, ikote ngitieng luaronok nabo dang, edakaka takalanyaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.12",
            "verseOrgIds": [
              "TIT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi ngakiro nguna iteni. Ejoikinit iyong ikilakini kesi lokojokon toliworotor kesi ngikanupak luajokak ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.13",
            "verseOrgIds": [
              "TIT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "lu nyeneikina anupit ngakiro napasiek na isisaate Ngiyaudi ka ngitalio a ngitunga alu angero ngakiro na iteni. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.14",
            "verseOrgIds": [
              "TIT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiuna ibore daang alotunga alu ikiuna, nakaneni emam ibore ikiuna alotunga alu eroko alu nyenupito ngakiro a Akuj, kainyo aroketa kolong ngitamen kech ka ngitai. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.15",
            "verseOrgIds": [
              "TIT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "TIT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwogasi ngitunga ngulu atamar kiyeni ngakiro a Akuj, nakaneni idodiunit eboyor kech atamar nyeyenete. Kikadakinete kesi nabo nyepupete ngakiro, nyepedorete kesi asubakin ibore niajokon tani wadiochichi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.16",
            "verseOrgIds": [
              "TIT.1.16"
            ]
          }
        }
      ]
    }
  ],
