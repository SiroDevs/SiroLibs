                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Alemun kolong ngesi kotere ngoni sodi kitoyuu anaronis kadaang, nabo kitiliwo ngitunga lukikiuna lu kirai ngikeng make, nabo kiitanit akisub naajokak.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
    {
