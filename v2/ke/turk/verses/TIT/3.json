              "items": [
                {
                  "text": "2 Tim 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ejoikinit ngitunga yok itatamasi akisub ngitichisio luajokak, taanyuneta ngiboro lu iitanitae, meere akiboi pas. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        },
        {
