            "sid": "JOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.6",
            "verseOrgIds": [
              "JOS.9.6"
            ]
          }
        },
