              "JOS.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachakis tamasi, “Kisubi sua kongina ekapolon, kainyo kipot atoyena dir atamar adungokini kolong Ekapolon Akuj na erai Akuj kus Musa ekasuban etich keng ebala, kiinakini esi akwap daang sodi taara ngitunga lu elomito neni daang, iloose ngaren. Kisubi sua kongina ani kiemitor sua esi, kipot sua kitobul. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi tokona ngakiro kosi ngaka akiding kus, tosubere sua ngakiro nakijoikinito esi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
              "JOS.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Yochua toik kesi kiratak Ngisirael nyear kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kikok neni, kitiliwo kesi ngikedalak, toliworos eyapanakinete Ngisirael ngakito tookonokinete ngakipi. Ayepeenete tani ngakito ka akiok ngakipi a ekeno a ngakipeyos. Arubakis kesi esubete etich logo ani kolong aseuni Ekapolon Akuj atamar kelipere ngesi, tanang akolongit napei tokona naga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        }
      ]
