              "items": [
                {
                  "text": "Etal 7:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni tolimut Ngisirael tamasi, “Kotere nyo kichamakinor ngoni? Tokona ngon ibooyete esi alo diyete kane.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        },
        {
          "name": "note",
