                "loc": "DEU.19.1+DEU.19.2+DEU.19.3+DEU.19.4+DEU.19.5+DEU.19.6+DEU.19.7+DEU.19.8+DEU.19.9+DEU.19.10+DEU.19.11+DEU.19.12+DEU.19.13"
              },
              "items": [
                {
                  "text": "19:1-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngirerea ngulu kesi lu aseunio toyuunotor Ngisirael ka itwaan cha daang a akwap a ache ni arukito ka kesi. Itwaan ni aari itwaan niche peiyechakinit, apedori ayuun kaina, kilany itwaan ni asaki atachakin akitu a itwaan ani earitae. Peapedorio akiar ngesi mati mono kititae alongaren ngitunga daang.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
