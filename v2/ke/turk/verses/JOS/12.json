          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Dor (lo eyei lokwaas a anam), ka Goimu (lo eyei Galilaya,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.23",
            "verseOrgIds": [
              "JOS.12.23"
            ]
          }
        },
