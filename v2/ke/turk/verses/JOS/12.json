              "type": "text"
            },
            {
              "text": "Galilaya;",
              "type": "text"
            },
            {
              "text": "igiritae apei a ngagiran anangorok Galilaya; igiritae Naeburaniae Giligal.",
              "type": "text"
            }
          ]
        },
        {
          "text": ") ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.23",
            "verseOrgIds": [
