        {
          "text": "ka Kedech, ka Yokineam (lo eyei Karimel), ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.22",
            "verseOrgIds": [
              "JOS.12.22"
            ]
          }
        },
