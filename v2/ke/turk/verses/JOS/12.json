          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Orima, ka Arad, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.14",
            "verseOrgIds": [
              "JOS.12.14"
            ]
          }
        },
        {
          "name": "verse",
