          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokaatokeng a Yapulet lo anyaritae Osam,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:35",
              "type": "text"
            },
            {
              "text": "Osam;",
              "type": "text"
            },
            {
              "text": "esibit ngagiran na iyookino kesi (kingolik epiding loa 32) Osam; ani Anaeburaniae, erai Elem.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ayakasi ngide lusapa nguomwon lu anyaritae Sopa, ka Imuna, ka Chelech ta Amal.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        }
      ]
    },
