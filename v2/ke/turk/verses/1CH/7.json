          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi lokaatokeng lo anyaritae Chomer ngide lusapa nguuni lu anyaritae Roga, ka Yeuba ta Aram.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
              "1CH.7.34"
            ]
          }
        }
