            "number": "29",
            "style": "v",
            "sid": "1CH 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Analesea a Ichar, Kenania ka talokookeng atiakakinitae ngakiro a ngitichisio alu esubio, alu ikote aweikin ekimar ka akitiak ngikesio a Ngisirael.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Analesea a Eburon, ka Achabia ta ngiyenet keng ngitomon ka ngikan-kaarei, lu araakasi daang ngikiliok lu ayenikinitae, kesi aweikinito etich a Ekapolon Akuj ka loa arieng daang alo Isirael, too angolol a Yorudan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeria ngesi arai arai ekapolon a ngalesea a Eburon. Ekaru lo a ngitomwon-omwon lo araakar Daudi ekapolon, apon tasakae angichun aur a ngalesea a Eburon. Apon taanyunae ngasigerea na ayenikinitae a ngitunga kangulu elomito Yaser nia akwap a Gilead . ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toseu ekapolon Daudi ngikapolok a ngawiyei wiyei ngabunge ngaarei ka ngamiae ngakan-kaarei lu ayenikinitae, lu araakasi ngiyenet a Yeria, sodi kitoweik kesi etich a Ekapolon Akuj ka lo a arieng daang alo Isirael, kide angolol Yorudan, nakwapea a Reuben, ka Gad ta Kide Manase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.32",
            "verseOrgIds": [
              "1CH.26.32"
            ]
          }
        }
