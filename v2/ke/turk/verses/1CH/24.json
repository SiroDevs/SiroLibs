        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.18",
            "verseOrgIds": [
              "1CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egiritae ngitunga ngulu tolosioneto kai a Akuj sodi tosuba ngitichisio lukolong esiakini apaakech Aron, loger lo adungunitor Ekapolon Akuj na erai Akuj a Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngirora a Ngilawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
