          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lugu kesi araakasi ngikapolok a ngawiyei lu etorunete nia Lawi. Arai Yedeya alesit a Amuram lo auriuni Chebuel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        }
      ]
    },
