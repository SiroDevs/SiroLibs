          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi lugu ngitunga a ngawiyei a Ngilawi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edia loapolon a awi, ka epei kata lokaatokeng, aramete ekura kotere etich kech, loger lo aramete ngimurok lu etorunete nia Aron. Araakasi Ngilawi ngiyenet kech. Ngikaanyunak a ngakiro kanguna kesi ekapolon Daudi, ka Sadok, ka Aimelek, ka ngikapolok a ngawiyei a ngimurok ta na Ngilawi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.31",
            "verseOrgIds": [
              "1CH.24.31"
            ]
          }
        }
      ]
    }
