          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akisiaun ani eyei loapolon, anyaritae talokookeng a Eburon, Yeria, ka Amaria, ka Yaasiel ta Yekameam.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
              "1CH.24.23"
            ]
          }
        }
      ]
    },
