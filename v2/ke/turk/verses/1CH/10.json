                  "text": "28:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " towou akingitun ani a Ekapolon Akuj. Kotere ngakiro nguna, taar Ekapolon Akuj ngesi, kitiliwo Daudi lokookeng a Yese ekapolon.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
