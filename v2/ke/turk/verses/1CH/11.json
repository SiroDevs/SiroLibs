          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aliwor Daudi ekapolon a Isirael ka Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pot ngitela daang a Isirael nia Daudi alo Eburon sodi tolimokis tamasi, “Kirai sua ngakoyo ka ngaakot kon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.1",
            "verseOrgIds": [
              "1CH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolong tani eringa Saul erai ekapolon, irikit iyong Ngisirael alojie. Abu nabo Ekapolon Akuj kichikak iyong atamar iliwor ekeyokon a ngitunga keng toliwor ekapolon kech.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.2",
            "verseOrgIds": [
              "1CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.63"
              },
              "items": [
                {
                  "text": "Yoch 15:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.21"
              },
              "items": [
                {
                  "text": "Katu 1:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi pot ngikarikok daang alo Isirael ni ayei ekapolon Daudi alo Eburon. Kikong Daudi achamakin ka Akuj, kidokakis kesi ngesi akimiet na etal nakou, loger losek echikakinitor Ekapolon Akuj kisitoru nia ekadwaran Samuel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyout ekapolon Daudi ka Ngisirael daang toloto akirem ere a Yerusalem. Ngirwa ngulu, anyaritae ere ngolo Yebus. Ngiebus lu araakasi ngikulepek a akwap kangina, aringa elomito neni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.4",
            "verseOrgIds": [
              "1CH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimokis Ngiebus Daudi atamar nyelomari ngesi jik tooma ere. Nakaneni tolema Daudi awas nakaagongon a Sion. Kotere ngakiro nguna, apon tanyarae neni, “Ere a Daudi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.5",
            "verseOrgIds": [
              "1CH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim Daudi tama, “Itwaan ni isiauni taar itwaan a Ngiebus, eliwor ekarikon a ngasigerea!” Abu Yoab lo enyaritae itiokeng Seruya torik ejie, toliwor ekarikon a ngasigerea. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.6",
            "verseOrgIds": [
              "1CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kona alomea Daudi tooma awas, apon tanyarae neni, “Ere a Daudi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.7",
            "verseOrgIds": [
              "1CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ngesi kisiriam adukuor napei alowae alo imuleleara tanang lowae lo alotooma. Toduk Yoab ngiwaitin luche a ere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.8",
            "verseOrgIds": [
              "1CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toliwor Daudi lokajwon noi kainyo arukito ngesi ka Akuj Namerikanyer.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngasigerea a Daudi nakajwok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lugu kesi eraakasi ngirora a ngasigerea a Daudi anakajwok. Ngasigerea nguna erukito aapei ka Ngisirael luche, apot kingarakis ngesi toliwor ekapolon, loger lo echikakinitor Ekapolon Akuj, kiganga kesi apolou keng togogonger.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyaritae asiger na a ekingaren Yachobeam lo emachar a Achimon, lo arai ekarikon “Aluuni”.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:11",
              "type": "text"
            },
            {
              "text": "Aluuni;",
              "type": "text"
            },
            {
              "text": "igiritae nakitab apei nangorot (kingolik 2 Samuel 23:8) atamar “Luuni”; ani Anaeburaniae erai “Lutomwon-uni”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitiji ngesi ngikiliok ngamiae ngauni a akwara sodi taar daang akitijiet apei. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo atupit lo a ekingaren aluuni kajwok noi ngesi Eleasar lokookeng a Dodo, lo emachar a Ao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.12",
            "verseOrgIds": [
              "1CH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebakete ngesi ka Daudi kitijwoto Ngipilisti alo Pas Damim. Ayei ngesi mana a erau esaa lo esiakineta Ngisirael amatar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.13",
            "verseOrgIds": [
              "1CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot ngesi ka ngirukitos keng toweikis Ngipilisti alokiding amana kitijwoto Ngipilisti. Kidwanga kesi Ngipilisti kotere Ekapolon Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akolongit apei, toloto ngasigerea ngache ngauni anasigerea anatomwon-uni kajwok noi nataaba na ebooyo Daudi, na ayei diyete aburibur anyaritae Adulam. Esaa ngolo, ayakasi ngajorei a Ngipilisti nadipo a Repaim. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.15",
            "verseOrgIds": [
              "1CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngirwa ngulu, ayei Daudi lomukura lo eriwokinitae awas nakaagongon, tolomite ajore a Ngipilisti Betleem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.16",
            "verseOrgIds": [
              "1CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Daudi kiito awi tolim tama, “Arai bo kainuni itwaan idio ngakipi alokare ana eyei Betleem dang!” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.17",
            "verseOrgIds": [
              "1CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot ngasigerea nauni kajwok noi kimingakis kitoro kiding adakar a Ngipilisti, tookut ngakipi alokare sodi iinut Daudi. Nakaneni towou Daudi akimat ngakipi nguna, pearai abu tobuko toliworos ngakipeyos ani a Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.18",
            "verseOrgIds": [
              "1CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim ngesi tama, “Nyamasi ayong ngakipi nugu jik! Ikokini ibore ngini akimat ngaakot a ngikiliok kalu alu ajalete ngawat kech tonyout akitu!” Abu ngesi tonger akimat ngakipi nguna. Ngakiro nguna idodiunito atitinyu a ngasigerea anauni kanguna.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abichai lo arai lokaatokeng a Yoab ngesi arai ekarikon a ngasigerea “Anatomwon-uni kajwok”. Etiji ngesi ngikiliok ngamiae ngauni a akwara taar sodi toliwor ngesi lokajwon noi ani eyakasi “Lutomwon-uni.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.20",
            "verseOrgIds": [
              "1CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngesi arai lokajwon noi ani eyakasi “Lutomwon-uni”. Abu ngesi toliwor ekarikon kech, nakaneni pearai ngesi lokajwon noi loger “Aluuni” a ekingaren.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.21",
            "verseOrgIds": [
              "1CH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.21",
            "verseOrgIds": [
              "1CH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya lo arai lokookeng a Yeoyada lo a ere a Kabiseel, arai asiger nakajwon noi. Asubi ngesi ngakiro naationok, aari tani ngikiliok a Ngiamor ngiarei lukajwok. Akolongit apei, ayei ibore ni ekoni eloch nakwap, abu ngesi toloma nadui taar engatuny. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.22",
            "verseOrgIds": [
              "1CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aari ngesi tani itwaan a akwap a Misiri. Arai itwaan ngini nilangir tarai aoyau keng ngamitae ngaarei, totingite akwara nalangir. Kitijik Benaya ngesi a aselej todema akwara anakan keng, taarea. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi nguna ngakiro naationok a Benaya alo arai epei “Alutomwon-uni”. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.24",
            "verseOrgIds": [
              "1CH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ngesi lo ayenikinitae anikech, nakaneni peekoni “Luuni”. Toseu Daudi ngesi topolok ngasigerea na eyokiyete ngesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitunga luche “Alutomwon-uni” kesi ta Asael lo arai lokaatokeng a Yoab, ka Elianan lo arai lokookeng a Dodo alo a Betleem, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.26",
            "verseOrgIds": [
              "1CH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Chamos lo elelea a Arod, ka Eles lo abunit alo Pelet, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.27",
            "verseOrgIds": [
              "1CH.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Ira lo arai lokookeng a Ikech alo ere a Tekoa, ka Abieser lo a ere a Anasos, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.28",
            "verseOrgIds": [
              "1CH.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Sibekai lo a emachar a Ucha, ka Ilai lo a emachar a Ao, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.29",
            "verseOrgIds": [
              "1CH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Maarai lo a akwap a Netopa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.30",
            "verseOrgIds": [
              "1CH.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Isai lo arai lokookeng a Ribai alo ebunit alo Gibea anakwap a Benjamen, ka Benaya lo a akwap a Pirason, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.31",
            "verseOrgIds": [
              "1CH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Urai lo abunit anadipoe ana eyakasi diyete ere a Gaach, ka Abiel lo abunit anadipo a Araba, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.32",
            "verseOrgIds": [
              "1CH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Asimapes lo a ere a Baurim, ka Aliaba lo abunit alo Chaalibon, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.33",
            "verseOrgIds": [
              "1CH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Achem",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.34",
            "verseOrgIds": [
              "1CH.11.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:34",
              "type": "text"
            },
            {
              "text": "Achem;",
              "type": "text"
            },
            {
              "text": "esibit ngagiran na iyookino kesi Achem; Anaeburaniae, erai talokookeng a Achem.",
              "type": "text"
            }
          ]
        },
        {
          "text": " lo abunit alo Gison, ka Yonasan lokookeng a Chagee lo a emachar a Arar, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.34",
            "verseOrgIds": [
              "1CH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Ayam lo arai lokookeng a Sakar alo a emachar a Arar, ka Elipal lo arai lokookeng a Ur, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.35",
            "verseOrgIds": [
              "1CH.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Eper lo abunit alo Mekera, ka Aija lo abunit alo Pelon, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.36",
            "verseOrgIds": [
              "1CH.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Esiro lo abunit alo Karimel, ka Naarai lo arai lokookeng a Esibai, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.37",
            "verseOrgIds": [
              "1CH.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Yoel lo arai lokaatokeng a Nasan, ka Mibiar lo arai lokookeng a Agiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.38",
            "verseOrgIds": [
              "1CH.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Selek lo a emachar a Amon, ka Naarai lo a ere a Beeros, lo atingit ngiboro a Yoab lu ejie, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.39",
            "verseOrgIds": [
              "1CH.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Ira, ka Gareb, lu araakasi daang ngika emachar a Yatir, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.40",
            "verseOrgIds": [
              "1CH.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Uria lo arai Eitit, ka Sabad lo arai lokookeng a Ailal, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.41",
            "verseOrgIds": [
              "1CH.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Adina lo arai lokookeng a Chisa (arai ngesi lo ayenikinitae alokitela a Reuben. Ayei ngesi ajore keng a ilope na arai ngasigerea ngatomwon-uni), ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.42",
            "verseOrgIds": [
              "1CH.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Anan lokookeng a Maaka, ka Yochapat lo a Misan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.43",
            "verseOrgIds": [
              "1CH.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Usia lo a Achitera, ka Chama ka Yeiel lu araakasi talokookeng a Osam alo a Aroer, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.44",
            "verseOrgIds": [
              "1CH.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Yediael lo arai lokookeng a Chimuri, ka lokaatokeng Yoa lu aponito alo Tis, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.45",
            "verseOrgIds": [
              "1CH.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Eliel lo abunit alo Maapa, ka Yeribai ka lokaatokeng Yochapia, lu araakasi talokookeng a Elinaam, ka Isima lo a akwap a Moab, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.46",
            "verseOrgIds": [
              "1CH.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Eliel, ka Obed ta Yaasiel lo abunit alo Soba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.47",
            "verseOrgIds": [
              "1CH.11.47"
            ]
          }
        }
      ]
    }
