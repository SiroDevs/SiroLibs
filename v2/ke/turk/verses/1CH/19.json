{
  "id": "1CH.19",
  "number": "19",
  "bookId": "1CH",
  "reference": "1 Ngakiro A Ngirwa 19",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
