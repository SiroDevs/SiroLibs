          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ner arai apakeng a Kich. Arai Kich apakeng a Saul. Ayakasi Saul ngide lusapa nguomwon lu anyaritae Yonasan, ka Malikichua, ka Abinadab ta Echibaal,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:33",
              "type": "text"
            },
            {
              "text": "Echibaal;",
              "type": "text"
            },
            {
              "text": "enyaritae ngesi Ichibochet alo 2 Samuel 2:8 ka ngipidinga luche alo 2 Sam.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasan arai apakeng a Meribaal,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:34",
              "type": "text"
            },
            {
              "text": "Meribaal;",
              "type": "text"
            },
            {
              "text": "enyaritae ngesi Mepiboches alo 2 Samuel 4:4 ka ngipidinga luche alo 2 Sam.",
              "type": "text"
            }
          ]
        },
        {
          "text": " alo arai apakeng a Mika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        }
