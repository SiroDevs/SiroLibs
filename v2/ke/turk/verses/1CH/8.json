          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beria ka Chema kesi araakasi ngikapolok a ngawiyei ana alomete lore a Aijalon, sodi kitwarakis ngitunga lu alomito lore a Gas. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.13",
            "verseOrgIds": [
              "1CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesea a Beria kesi Aio, ka Chachak, ka Yeremos, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.14",
            "verseOrgIds": [
              "1CH.8.14"
            ]
          }
        },
