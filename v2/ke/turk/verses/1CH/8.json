          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi Asel ngide lusapa ngikan-kapei lu anyaritae Asirikam, ka Bokeru, ka Ichimael, ka Chearia, ka Obadia ta Anam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani lokaatokeng a Asel lo anyaritae Echek, ayakasi ngide lusapa nguuni lu anyaritae Ulam, ka Yeuch ta Elipelet.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        }
      ]
