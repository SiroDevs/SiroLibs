            "sid": "EZK 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katolimok Ekapolon Akuj ayong akiroit tama, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.20",
            "verseOrgIds": [
              "EZK.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itwaan, todwar ngakiro naaronok ani a Sidon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
            "verseOrgIds": [
              "EZK.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok ngitunga a Sidon ngakiro na alimokinit ayong Ekapolon lo arai Ekapolon Akuj kesi abala:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.22",
            "verseOrgIds": [
              "EZK.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Epiario Isirael",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
