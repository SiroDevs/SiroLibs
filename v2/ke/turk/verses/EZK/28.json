            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim Ekapolon lo arai Ekapolon Akuj tama, “Abuuni ayong Ngisirael alobukui alu kolong apetakini ayong kesi, toyena ngibukui daang atamar etaleuno ayong. Elomete Ngisirael nakwap kech a ngikulepek nakolong ainakini ayong ekasuban etich kang Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
