          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katolimok ayong Ekapolon Akuj akiroit tama, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.1",
            "verseOrgIds": [
              "EZK.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itwaan, tolimok ekapolon a Tiro ngakiro na alimokinit ayong Ekapolon lo arai Ekapolon Akuj ngesi abala:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adakar ekapolon a Tiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
