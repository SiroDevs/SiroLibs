          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim Ekapolon Akuj tama, “Ngibukui lukidunyet a Isirael lukolong emenyarito Isirael, nyeringa nabo ikwaanikinosi ka ngiikwa ta ngirega towana Isirael. Toyeneta atamar arai ayong Ekapolon lo arai Ekapolon Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
