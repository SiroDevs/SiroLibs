            "number": "26",
            "style": "v",
            "sid": "EZK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erumeikini ayong angajep kon nangirit na alokidiama, sodi tokinimaner iyong tongop kona ikilakini kesi, kainyo eraakasi kesi ngitunga lukechanak. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.26",
            "verseOrgIds": [
              "EZK.3.26"
            ]
          }
        },
        {
          "name": "verse",
