            "sid": "EZK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim Akuj tama, “Itwaan, tanyam ibore ni kiinakinio, tanyam akitab naga, sodi tolot kisuruor Ngisirael.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayong atangaam, kainak ngesi akitab atanyam. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.2",
            "verseOrgIds": [
              "EZK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.10.9+REV.10.10"
              },
              "items": [
                {
                  "text": "Tood 10:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tolim ngesi tama, “Itwaan, tanyam akitab nakainak ayong iyong naga, kilelebik nakook kon.” Atanyam ayong, abob loger a akimiet a ao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor katolimok Akuj ayong tama, “Itwaan, kape nia Ngisirael tolimok ngakiro nacha kalimokini ayong iyong. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.4",
            "verseOrgIds": [
              "EZK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakamearit ayong iyong lobukui lu ianete angajep naparing, kori nakaagongon, pearai kamearit nia Ngisirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.5",
            "verseOrgIds": [
              "EZK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakamearit lobukui lukaalak lu ianete angajep naparing na nyiyeni iyong. Arai katomearite lotunga lu ikote ngulu, kiirarito kesi ngakiro kon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.6",
            "verseOrgIds": [
              "EZK.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni nyiirarete Ngisirael ngakiro kon, kainyo nyesakete akiirar tani nakang. Ichanaka kesi etioko ngitai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.7",
            "verseOrgIds": [
              "EZK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketiliwori tokona ayong iyong lokechanan nabo lo itiono loger kech. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.8",
            "verseOrgIds": [
              "EZK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketirokini ayong iyong loger a ataaba ana nyingunyakin, ketogogong loger a alumas. Nyiem kesi kori wara ngakonyen kech nyikitubul iyong kainyo eraakasi kesi ngitunga lukechanak.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.9",
            "verseOrgIds": [
              "EZK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.9",
            "verseOrgIds": [
              "EZK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torubak Akuj iruoro ebala, “Itwaan, todeta ngaki kiira ngakiro nakalimokini ayong iyong daang, sodi kirichak alotau. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.10",
            "verseOrgIds": [
              "EZK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor tolot lotunga kon lu eraakasi ngirikon anakwap anache, tolimok ngakiro na esuruori ayong Ekapolon lo arai Ekapolon Akuj kesi, nyekachitae erai kiirasi kori kemam.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor kekeu ayong etau a Akuj kidiama, eira etoil loapolon egirokini loger a arikirik a akwap, tama, “Kipuroe apolou a Ekapolon Akuj anadis!” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwa kerai etoil lo agiro loger a arikirik a akwap eka ngiborei alu eyarete esaa lo etapatar ngabeben kech ka agiro a ngatairio ana ayakasi lokwaasea kech. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kekeu ayong etau kayaa nikalonan. Atorotok ayong kanomito ngakiro etau, nakaneni katotikokin ayong agogongu a Ekapolon Akuj niationon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atanangu ayong lotunga lu eraakasi ngirikon lu alomito Tel Abib lokwaas a angolol a Kebar. Eruko ayong ka kesi a ngirwa a ngikan-kaarei, elikorit etau kotere ngakiro nakolong engolikini ka na eirari.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aliwor Esekiel eketeon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaunet a ngirwa a ngikan-kaarei, katolimok Ekapolon Akuj ayong akiroit tama, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.16",
            "verseOrgIds": [
              "EZK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itwaan, ketiliwo ayong iyong eketeon a Ngisirael. Tolimonok kesi ngakichikichiket daang na itorunete nakituk kang. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.17",
            "verseOrgIds": [
              "EZK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kalimok ayong itwaan niaronon atamar etoani, sodi nyiikilak iyong ngesi tapalikinea aronis keng toyuunor, etoani itwaan ngini anaronis keng, nakaneni iyong ngesi kapaikini ayong akitu keng. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.18",
            "verseOrgIds": [
              "EZK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pearai ani kikilak iyong itwaan niaronon towou ngesi areeun anaronis kori alorot keng aloaronon, etoani ngesi anaronis keng, nakaneni iyuun iyong.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.19",
            "verseOrgIds": [
              "EZK.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.19",
            "verseOrgIds": [
              "EZK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani keisiki itwaan ni etenoono ateneanut kisiak akisub ngakiro naaronok, sodi atolokak ayong ngesi nakiro naaronok, ani pekikilak iyong ngesi, etoani kotere akisech keng. Nyetamuni ayong ngakiro naajokak nakolong asubi ngesi. Nakaneni kapaikini ayong iyong akitu keng. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.20",
            "verseOrgIds": [
              "EZK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneni dang, ani kikilak iyong itwaan ni etenoono atamar nyeesech, sodi kiira ngesi, eyari ngesi dir kainyo eira ngakiro na ekilakinere, nabo iyuun iyong.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akuruwo Esekiel akiruorikin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katotikokin ayong agogongu a Ekapolon Akuj niationon, katolimok ayong tama, “Tonyou, tolot nadipo, kesuruori ayong iyong kaina.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.22",
            "verseOrgIds": [
              "EZK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.22",
            "verseOrgIds": [
              "EZK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi atonyou ayong atolot nadipo. Oitiakoi! Engolik ayong akwangis a Ekapolon Akuj, loger losek engolikinitor alokwaas a angolol a Kebar. Atadakakin ayong kwap atodo aloreet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.23",
            "verseOrgIds": [
              "EZK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolomu etau a Akuj nikang, ketonyou atowo. Katolimok ngesi ayong tama, “Kape togolokin kai kon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.24",
            "verseOrgIds": [
              "EZK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyong itwaan, kienio iyong a ngaunoi nyiipedo alosit alokiding ngitunga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
