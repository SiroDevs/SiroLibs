                "loc": "EZK.10.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.22+EZK.11.23"
              },
              "items": [
                {
                  "text": "11:22-23",
