                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.15"
              },
              "items": [
                {
                  "text": "Tood 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kitoru akwangis ngina lokidor lo alokide toloma kai a Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kekeu etau a Akuj ayong kayaa nalaar na alotooma, engolik akwangis a Akuj ileleba kai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eringa itwaan ngini ewei alodiyete kang, eira ayong etoil a Ekapolon Akuj kesuruorikini alokai keng ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.6",
            "verseOrgIds": [
              "EZK.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "tama, “Itwaan, nege erai ekicholong kang a apolou, nege edokokinit ayong ngakejen kang, eboikinor kiding Ngisirael jik. Nyeringa nabo Ngisirael isurumete ekiro kang ngileech jik, kori nyeringa nabo ngikapolok kech isurumete ekiro kang ngileech ani ilipeta ngakujo ngache kori ani enukanakineta ngawat",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.7",
            "verseOrgIds": [
              "EZK.43.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "43:7",
              "type": "text"
            },
            {
              "text": "enukanakineta ngawat;",
              "type": "text"
            },
            {
              "text": "kori akiduk ngasenon.",
              "type": "text"
            }
          ]
        },
        {
          "text": " a ngikapolok kech nege. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.7",
            "verseOrgIds": [
              "EZK.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isibakito ngikapolok kech ngakilori kech ka nakang. Kisibaka ngapirio kech ka nakang, abe toliwor awas bon kitiakit ayong ka kesi. Esurumete kesi ekiro kang ngileech a ngakiro anakikadakinete esubete kesi. Kotere nguna, amunyari ayong kesi a angoit kang. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.8",
            "verseOrgIds": [
              "EZK.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejoikinit tokona kesi epalikinete akilipit ngakujo nache sodi tachadasi ngawat a ngikapolok kech anikang. Ani kesubakis nguna, eboikin ayong kiding kech jik.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torubak Ekapolon Akuj ebala, “Iyong itwaan, kisisak Ngisirael ngakiro a akai a Akuj toyena lokojokon eger keng. Kimiek kesi kiruma ngileech kotere ngakiro naaronok asubete kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.10",
            "verseOrgIds": [
              "EZK.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiruma kesi ngileech kotere daang na asubete, kidodik kesi eger a akai a Akuj, ka eduke keng ta ngidorin keng lulomunet ka lupudoret, ka ekisikwaane keng ta eger lo erekinitere ngiboro daang. Kisisak kesi ngitalio a akai a Akuj daang ka ngakiro na iwapitae. Kigir ngakiro nguna daang kingolikineta kesi eger lo erekinitere sodi kiwapa ngitalio daang. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.11",
            "verseOrgIds": [
              "EZK.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etal a akai a Akuj logo: Aro daang na iriamit akai a Akuj alokidiama emoru, erai ni italeuno.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekeno a ngakipeyos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakitemiet a ekeno a ngakipeyos nugu, itemio loger lo etemere akai a Akuj. Ewae lo a ngalup a ekeno kiriam, echilitae ni itorete ngakipi, ni erai aoyau na ngalup ngasentimitae ngatomwon-kan tarai abalanyany ngasentimitae ngatomwon-kan, tarai aoyau na alokidiama ekeli lo a ekwaas ngasentimitae ngatomwon-arei ka ngakan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewae lo alokwap noi a ekeno napei alokidiama ewae lo esipor, arai aoyau na alokidiama amita apei. Ewae loche, abuaritae naabor alokeli ngasentimitae ngatomwon-kan kiriam, tarai aoyau na alokidiama ngamitae ngaarei. Ewae lo atupit ngolo, abuaritae naabor alokeli ngasentimitae ngatomwon-kan kiriam. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.14",
            "verseOrgIds": [
              "EZK.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewae lo alokidiama lo enomeenere ngakipeyos, arai aoyau na alokidiama ngamitae ngaarei. Ngaamwar na ajipito alowaitin aluomwon, aoyak epororito ewae loche alokidiama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariyan ngiwaitin lua lokidiama daang, araakasi ngamitae ngakan-kapei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1+EXO.27.2"
              },
              "items": [
                {
                  "text": "Apud 27:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.1"
              },
              "items": [
                {
                  "text": "2 Ngirwa 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariyan tani ngiwaitin lua lokiding daang araakasi ngamitae ngakan-kaarei, toyei ekeli lowaitin lua nikalapatan, lo arai aoyau keng ngasentimitae ngatomwon-arei ka ngakan. (Arai abalanyany ani itorito ngakipi ngasentimitae ngatomwon-kan.) Ngadoket na adokanarere lokeno, ayakasi lowae lo alokide.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akitaleun ekeno a ngakipeyos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katolimok Ekapolon lo erai Ekapolon Akuj ayong tama, “Itwaan, topupok ngakiro nakalimokini ayong iyong. Ngitalio a ekeno a ngakipeyos lugu: Akolongit na itoweyere ekeno, kitaleu kinom ngakipeyos ka awatakin ngaakot a ngibaren alu ipeyeo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngilawi lumurok taraakas ngalesea a Sadok make kesi epote ngaren kang akisub etich kang. Adungu ayong Ekapolon lo arai Ekapolon Akuj nguna. Nak kesi emong losorokit kipeyeto toliwor akipeyos a akisech. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.19",
            "verseOrgIds": [
              "EZK.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilemuni iyong ngaakot keng ngache kiwasak naamwar naomwon a ekeno, ka ngiwaitin lua lokiding, kisiriam ekeli keng daang. Eger ngolo ngesi itosegea iyong ka akitaleun ekeno a ngakipeyos. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
              "EZK.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilemuni iyong emong lo ipeyeo erai akipeyos a akisech, kinom ani eseunitae anikalapatan akai a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.21",
            "verseOrgIds": [
              "EZK.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akolongit na etupit ngina, ipeyoe iyong ekoroe lo emam ni ichwangakina toliwor akipeyos a akisech. Kitaleu ekeno a ngaakot a ekoroe loger lo itosegea ana emong. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.22",
            "verseOrgIds": [
              "EZK.43.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani irumori akitoseg ekeno, kipeye emong lo emam ni ichwangakina ka emesek lo emam ni ichwangakina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
            "verseOrgIds": [
              "EZK.43.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yau kesi nia Ekapolon Akuj. Ipurupurakinete ngimurok amakat kidiama kech kepeyokis ayong erai akipeyos. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ngirwa a ngikan-kaarei, ipeyoe iyong akolongit daang akine, ka emong ta emesek toliworos ngakipeyos a akisech. Ejoikinit daang eraakasi lu emam ni ichwangakina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ngirwa a ngikan-kaarei, itosegete ngimurok ekeno kitaleut kipeyoore. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
            "verseOrgIds": [
              "EZK.43.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 43:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.35+EXO.29.36+EXO.29.37"
              },
              "items": [
                {
                  "text": "Apud 29:35-37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Adaunet a ngirwa alukan-kaarei, elomario nakolongit na ngakan-kauni, kepeyokinete ngimurok ayong ngakipeyos na inomio ka ngakipeyos a ekisil. Sodi katacham ayong esi daang. Ayong Ekapolon lo arai Ekapolon Akuj alimu nguna.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.27",
            "verseOrgIds": [
              "EZK.43.27"
            ]
          }
        }
