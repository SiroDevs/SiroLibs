                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.13",
            "verseOrgIds": [
              "EZK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiborei ngulu, ayakasi ipei kech daang ngireetin nguomwon. Arai ereet lo ekingaren eka emong, lo a ngiarei eka itwaan, lo a nguuni eka engatuny, ani lo a nguomwon eka egole. ( ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi ngiborei lupei kolong engolikini ayong anangolol a Kebar.) Na ekurupupuneta ngiborei ngulu kidiama ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
            "verseOrgIds": [
              "EZK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka arotokin, kirukosi ngatairio dang ka kesi. Nacha epetareta ngiborei ngulu ngabeben kech esakete aporor, kirukosi ngatairio dang ka kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.16",
            "verseOrgIds": [
              "EZK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ewaatar ngiborei ngulu, towaa ngatairio dang. Erukonorete ngatairio ka ngiborei ngulu kainyo kesi arikito ngatairio.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi torotok akwangis a Ekapolon Akuj alokidor a akai, tolot towo alokidiama ngiborei ngulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Topetasi kesi ngabeben kech sodi toporosi analup eteorit ayong, kirukosi ka ngatairio. Towaa alokidor alo alokide akai a Akuj, toyei akwangis a Akuj a Isirael kidiama kech. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atoyen ayong ngiborei ngulu atamar kesi lukolong engolikini ayong ewaasi alokwap Akuj a Isirael anangolol a Kebar.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi ipei kech daang ngireetin nguomwon ka ngabeben ngoomwon ta ibore ni asibit akan a itwaan alokwap abebenit daang. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.21",
            "verseOrgIds": [
              "EZK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eliwor ngireetin, kesi lupei kolong nabo engolikini ayong anangolol a Kebar. Aloose ngiborei ngulu daang ngaren.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.22",
            "verseOrgIds": [
              "EZK.10.22"
            ]
          }
        }
      ]
    }
  ],
