          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliwor aoyau a awas a ewae alokwap ngamitae ngabunge ngaarei ka ngamiae ngaarei ta ngatomwon-kan. Epete ngidorin nguuni lowae ngolo lu eraakasi ekidor a Simeon, ka loa Isakar ta lo a Sebulun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
