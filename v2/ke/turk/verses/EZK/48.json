              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "epete ngidorin nguuni lu eraakasi ekidor a Reuben, ka lo a Yuda ta lo a Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliwor aoyau a awas ana alokide ngamitae ngabunge ngaarei ka ngamiae ngaarei ta ngatomwon-kan. Epete ngidorin nguuni lowae ngolo lu eraakasi ekidor a Yosep ka loa Benjamen ta lo a Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
