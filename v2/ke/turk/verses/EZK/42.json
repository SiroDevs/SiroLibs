  "bookId": "EZK",
  "reference": "Esekiel 42",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
