            "number": "6",
            "style": "v",
            "sid": "EZK 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ebala Ekapolon lo erai Ekapolon Akuj kona: Iramete kolong esi ngakan kus kichuro ani kikadakinitor akwap a Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.6",
            "verseOrgIds": [
              "EZK.25.6"
            ]
          }
        },
