              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi ngamaniyae eriamito. Arai aoyau kech ngamitae ngatomon ka ngaarei tarai abalanyany ngamitae ngaarei ka anus. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
