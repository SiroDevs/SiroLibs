                "loc": "REV.11.1"
              },
              "items": [
                {
                  "text": "Tood 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.15"
              },
              "items": [
                {
                  "text": "21:15",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
