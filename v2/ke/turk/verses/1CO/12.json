              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tominakisi noi ngainakinet natenoik.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
              "1CO.12.31"
            ]
