          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irukete aberu ka ekile keng ngirwa daang lu eyarea ekile keng. Nakaneni ani ketoana ekile keng, epedori ngesi achamun ekile lo cha esaki ngesi, kerai ekile ngolo ekiristoit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elakar aberu ngina noi erai pekius nabo. Eraakasi nguna na etami ayong, nakaneni ayeni ayong atamar eyei ayong dang Etau a Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
      ]
    }
