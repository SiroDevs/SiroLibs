              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.4",
            "verseOrgIds": [
              "1CO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokona mono a, Apolo ngesi ngae? Nabo Paulo ngesi ngae? Kirai sua ngikasubak etich a Akuj lu kingarakini esi tonupeta ngakiro a Akuj. Esubi ipei kosi daang etich lokolong edodikini Ekapolon atamar tosub. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.5",
            "verseOrgIds": [
              "1CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etakini ayong ekinyamit, tobukok Apolo ngakipi, nakaneni Akuj ngesi iturupuni ekinyamit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.6",
            "verseOrgIds": [
              "1CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngini itakini ka ngini ebukokini ngakipi, emam itwaan ekachit ngakiro kech. Akuj alope na eturupuni ngesi etenoono. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.7",
            "verseOrgIds": [
              "1CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriyan itwaan ni itae ka ni ebukokini ngakipi, einakini Akuj ipei kech daang ebachit itemem ka etich lo esubi ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.8",
            "verseOrgIds": [
              "1CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo kirai sua ngikaitotoi lu kisubi etich aapei ka Akuj, iraakasi esi amana keng.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.9",
            "verseOrgIds": [
              "1CO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo iraakasi esi akai a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.9",
            "verseOrgIds": [
              "1CO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotere ainakinet a ajokis a Akuj, esiak ayong eduke, loger a ekadukon alo echoiyarit eduke, nakaneni eduki itwaan iche nateak nakolong esiakini ayong. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.10",
            "verseOrgIds": [
              "1CO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo emam eduke eche nabo isiakini itwaan mati lokolong esiakin, ngesi Yesu Kiristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.11",
            "verseOrgIds": [
              "1CO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadukoru ngina, edukete ngiche a egolit kori akwangat na elalak ngaropiyae, kori ngamoru ngache naajokak noi. Ani ngiche, toduko a ngakito, kori a nginyia, kori ngakasirim. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.12",
            "verseOrgIds": [
              "1CO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etakanuuni etich a itwaan kadaang Akolongit na isileereunio Kiristo, kainyo Akolongit ngina, isileereuni akim etich a itwaan kadaang. Itemi akim ngina etich a itwaan taanyu atamar ikoni etich a itwaan ai! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.13",
            "verseOrgIds": [
              "1CO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani pekenomia akim ibore nikolong aduki itwaan ngini, eanyuni ekadukon ebachit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.14",
            "verseOrgIds": [
              "1CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.19"
              },
              "items": [
                {
                  "text": "1 Kor 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Kor 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni ani kenomia ibore ni aduki itwaan ngini, nyeanyuni ngesi ebachit, nakaneni eyuun ngesi elope, kikok ibore ni abuchun anakim.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.15",
            "verseOrgIds": [
              "1CO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.15",
            "verseOrgIds": [
              "1CO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyenete esi dir atamar iraakasi esi akai a Akuj, nabo ibooyi Etau a Akuj anikus! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.16",
            "verseOrgIds": [
              "1CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.13"
              },
              "items": [
                {
                  "text": "Yob 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani robo kinyasu itwaan akai a Akuj, inyasuni ngesi dang Akuj, kainyo italeuno akai a Akuj, nabo iraakasi esi ngikulepek akai keng. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.11"
              },
              "items": [
                {
                  "text": "Eosio 94:11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warasi nyiingalasi! Ani kitamit itwaan anikus atamar aos ngesi kotere epit lo a ngakwapea kanu, ejoikinit ngesi ebangaaner sodi tooseror na iteni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.18",
            "verseOrgIds": [
              "1CO.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo aosou a ngakwapea kanu erai abangaanut ani a Akuj. Loger lo igiritere nagiran kona, “Irumuni Akuj ngikoosok kisalu anamodeanut kech.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.19",
            "verseOrgIds": [
              "1CO.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igiritae nabo nagiran ngache kona, “Eyeni Ekapolon atamar eraakasi ngitamen alukoosok ngipasiek.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.20",
            "verseOrgIds": [
              "1CO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emam robo tokona itwaan epedori akiwoga kotere ngakiro na esubete ngitunga, kainyo erai ibore daang ikus: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.21",
            "verseOrgIds": [
              "1CO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "eraakasi Paulo ka Apolo ta Petero ngikus. Eraakasi ngakwapea nugu ta akiyar ka akitu, ka ngakiro na a ngirwa kalu ka namonan isidiunosi, eraakasi nugu daang ngakus, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.22",
            "verseOrgIds": [
              "1CO.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakaneni iraakasi esi ngika Kiristo, tarai Kiristo eka a Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.23",
            "verseOrgIds": [
              "1CO.3.23"
            ]
          }
        }
      ]
    }
  ],
