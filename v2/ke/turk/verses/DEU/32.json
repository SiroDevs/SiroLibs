            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.23+DEU.3.24+DEU.3.25+DEU.3.26+DEU.3.27"
              },
              "items": [
                {
                  "text": "Etal 3:23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ingolikini iyong akwap anikalonan, nakaneni nyilomari iyong nakwap na ainakini ayong Ngisirael.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
