            "number": "1",
            "style": "v",
            "sid": "DEU 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iraakasi esi ngitunga a Ekapolon Akuj ana erai Akuj kus. Ani igorosi esi tosutonokis kotere itwaan ni atoana, nyiidungudungoto ngawat kus kori nyiiluro loger a ngitunga aluche. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
