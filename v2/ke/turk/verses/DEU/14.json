              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kitegeleasi apei anatomon a ngalemet ana ekokete anamanat kus ekaru daang. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.22",
            "verseOrgIds": [
              "DEU.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi toloto ni aseu Ekapolon Akuj na erai Akuj kus toliwor ilipeenere ngesi, sodi tanyama kaneni alongaren keng alemunet apei anatomon a ngikinyam keng ka emuna lo epuritoe, ka akimiet ta ngiuriuna lu ekingaren a ngaatuk ka ngamesekin kus. Tosuba kongina kitatamatar arima Ekapolon Akuj na erai Akuj kus jiik. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
            "verseOrgIds": [
              "DEU.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keloner ni ilipeenere anawiyei kus, kitokuruwo esi akiwok alemunet apei anatomon a ngalemet ana kipiaritor esi Ekapolon Akuj, tosuba kona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togialasi ngalemet kus sodi yaasi ngaropiyae ni ilipeenere. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30+LEV.27.31+LEV.27.32+LEV.27.33"
              },
              "items": [
                {
                  "text": "Lawi 27:30-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Ekim 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Togieleta ibore nicha isakete esi, kerai ngimongin, kori ngimesekin, kori emuna lo epuritoe, kori epurot. Sodi kimuja esi ka ngitunga a ngawiyei kus alongaren Ekapolon Akuj na erai Akuj kus talakaros.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tochoikisi ngitunga a ekitela a Lawi lu elomito lorerea kus kainyo emam kesi ibore ni erai ikech. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaunet a ekaru alo a nguuni, yautu alemunet apei anatomon a ngalemet kus kadaang kikachakis lorerea kus. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erai akimuj ngina aka Ngilawi kainyo emam kesi ibore ni erai ikech. Erai akimuj ngina tani aka ngitunga a ngakwapea anache, ka ngikokiok, ta ngapuseru na elomito lorerea kus. Ejoikinit kesi epote tolemasi ibore daang ni esakete. Tosuba kongina sodi kitopia esi Ekapolon Akuj na erai Akuj kus anakiro kadaang.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
          }
        }
      ]
    }
