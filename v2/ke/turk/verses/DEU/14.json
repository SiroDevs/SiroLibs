              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.28"
              },
              "items": [
                {
                  "text": "Lawi 19:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.5"
              },
              "items": [
                {
                  "text": "21:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Iraakasi esi ngika Ekapolon Akuj ana erai Akuj kus. Kiseu ngesi esi toliworos ngitunga keng alotunga kadaang alu eyakasi nakwapea. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
