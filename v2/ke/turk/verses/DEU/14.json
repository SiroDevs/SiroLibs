            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.26"
              },
              "items": [
                {
                  "text": "34:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Nyiinyam ibarasit ni etoani bon. Kimiekisi ngitunga a ngakwapea anache lu elomito nakwap kus tanyama, kori togielakisi ngitunga ngiche lugelayek. Nakaneni iraakasi esi ngitunga luseuna a Ekapolon Akuj ana erai Akuj kus. Iraakasi esi ngitunga keng.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyiidorok ikale kori imesek a ngakile a itiokeng.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etal a alemunet a apei anatomon",
          "type": "text"
        }
      ]
    },
    {
