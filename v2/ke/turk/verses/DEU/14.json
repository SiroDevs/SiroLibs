    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngakiro na engeritoe esubio na etoanea itwaan",
          "type": "text"
        }
      ]
    },
    {
