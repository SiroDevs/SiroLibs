              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani ikongi iyong ani a Ekapolon Akuj ana erai Akuj kus, wara nyiisik akisub nguna ichikakini iyong atamar isubi, kainyo esaki Ekapolon Akuj na erai Akuj kus kirichak iyong akichikakinet ngina, nabo eliwor akisech erai pekirichak iyong. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emam akisech eyei erai pekikong iyong ani a Ekapolon Akuj, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakaneni ani kikong iyong a akiding kon a ilope, kirichak akikongiet ngina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
      ]
