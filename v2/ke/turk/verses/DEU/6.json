              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi kitodungok ngoni Ekapolon Akuj na erai Akuj yok atamar ewapa ngitalio lu daang nabo atokera ngesi. Ani kisubi ngoni kongina, kiyoki ngesi ngoni sodi kitajakaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
        {
          "name": "verse",
