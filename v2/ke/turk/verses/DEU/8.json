{
  "id": "DEU.8",
  "number": "8",
  "bookId": "DEU",
  "reference": "Akitamunet A Etal 8",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
