              "type": "tag",
              "attrs": {
                "loc": "EXO.20.25"
              },
              "items": [
                {
                  "text": "Apud 20:25",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
