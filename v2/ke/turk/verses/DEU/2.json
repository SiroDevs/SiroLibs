                "loc": "NUM.21.4"
              },
              "items": [
                {
                  "text": "Ekim 21:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kipot ekisidi atoreas atoloto nariet, kiwapit erot lo a apas a Akaba, loger lokolong kidungokinitor Ekapolon Akuj. Kipot erikasi ngirwa lukaalak kiwowoot anakwap ana a ngimukur a Edom.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sodi katolimok Ekapolon Akuj ayong ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "atamar, atoloto lowae lo alokwap kainyo kirika ngoni ngirwa lukaalak kiwowoot alomukur kangulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.3",
            "verseOrgIds": [
              "DEU.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katolimok ngesi ayong atamar kechikichik esi kona, ‘Anang esi ni itorioto nakwap na a ngimukur a Edom, nakwap a ngiyenet kus alu eraakasi ngalesea a Esau. Kiemete kesi esi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.4",
            "verseOrgIds": [
              "DEU.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakaneni nyiisiakis ejie ka kesi kainyo nyakainakini ayong esi akwap kech tani wadiochichi. Ainak ayong ngalesea a Esau akwap a Edom. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.5",
            "verseOrgIds": [
              "DEU.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.8"
              },
              "items": [
                {
                  "text": "Siak 36:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ipedorete esi akigiel akimuj ka ngakipi anikech.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kitamutu eger lo kipiarea Ekapolon Akuj na erai Akuj kus esi anakiro kadaang ana isuba esi. Kiyoki ngesi esi na ilatotor anariet kana. Iruko esi ka ngesi alokaru alutomwon-omwon, nabo iriamut esi ibore daang ni isakete.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.7",
            "verseOrgIds": [
              "DEU.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.7",
            "verseOrgIds": [
              "DEU.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sodi atotena ngaren atodepasi erot lo eteni lorerea a Elas ka Esionigeber tanang nanam a Amakat. Sodi atoreas atoloto lowae lo a kwap akide atoloto Moab. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.8",
            "verseOrgIds": [
              "DEU.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.37"
              },
              "items": [
                {
                  "text": "Siak 19:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katolimok Ekapolon Akuj ayong tama, ‘Nyiichan ngitunga a Moab lu eraakasi ngalesea a Loti, kori nyiitijikis kesi. Ainak ayong kesi ere a Ari, nabo emam akwap kech nakainakini ayong esi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.9",
            "verseOrgIds": [
              "DEU.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "( ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.9",
            "verseOrgIds": [
              "DEU.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alomito ngitunga lulangir-kooyak noi anyaritae Ngiemim neni. Alalak kesi noi nabo ajwoko. Aoyak kesi ekwaan ka Ngianak, lu araakasi ngibukui ngiche lulangir-kooyak noi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.10",
            "verseOrgIds": [
              "DEU.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyaritae kesi dang Ngirepai loger a Ngianak, nakaneni anyarito Ngimoab kesi Ngiemim. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.11",
            "verseOrgIds": [
              "DEU.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alomito sek Ngiori Edom, nakaneni apot ngalesea a Esau kiritasi kesi, tomunyasi kesi. Sodi toloma kesi neni loger lo etwarakineta Ngisirael ngimoe kech ekisidi anakwap ana ainakini Ekapolon Akuj kesi.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sodi atodokasi ekwakaye angolol a Sered loger lo kolong kilimokinitor Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.13",
            "verseOrgIds": [
              "DEU.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi ngikaru ngulu ngitomwon-uni ka ngikan-kauni napei kolong kirotokinio ngoni alo Kadech Barinea. Ngikiliok daang lukajwok a ngirwa kangulu atoakito loger lokolong alimunitor Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Ekim 14:28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abu Ekapolon Akuj tonger kesi tanang emunyari daang.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani etoakete daang, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.16",
            "verseOrgIds": [
              "DEU.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kitolimok Ekapolon Akuj ngoni tama, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.17",
            "verseOrgIds": [
              "DEU.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Ejoikinit esi itorete nakwap a Moab, a erot alo itori Ari. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.18",
            "verseOrgIds": [
              "DEU.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.38"
              },
              "items": [
                {
                  "text": "Siak 19:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ipete esi diyete akwap a Ngiamon alu eraakasi ngalesea a Loti. Nyiichan kori nyiitijwoto kesi kainyo emam akwap na ainak ayong kesi nakainakini ayong esi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.19",
            "verseOrgIds": [
              "DEU.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "( ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.19",
            "verseOrgIds": [
              "DEU.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyaritae akwap naga akwap a Ngirepai, erai ekiro ngolo eka ngitunga alu kolong alomito neni. Anyarito Ngiamon kesi Ngisamusumim. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.20",
            "verseOrgIds": [
              "DEU.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alangir kesi tooyak noi ekwaan ka Ngianak. Alalak kesi, nabo ajwoko. Abu Ekapolon Akuj tomunya kesi, sodi tolemasi Ngiamon akwap kech toloma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.21",
            "verseOrgIds": [
              "DEU.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubitor sek Ekapolon Akuj napei kiro nguna Ngiedomae lu araakasi ngalesea a Esau, lu elomito nakwap a ngimukur a Edom. Abu tomunya Ngiori sodi tolemasi Ngiedomae akwap toloma, eringa tokona kesi elomito neni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.22",
            "verseOrgIds": [
              "DEU.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitunga a ekwar alo elukakina nanam enyaritae Kirete, kesi aloma lokwaas a anam a Mediterenian. Apot kesi tomunyasi Ngiapim lusek alomito neni, sodi tolemasi akwap kech daang tanang lore a Gasa lo eyei lowae lo alokuju.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakitorio ngoni Moab abu Ekapolon Akuj kitolimok ngoni tama, ‘Kapesi tokona todokasi ekwakaye angolol a Arinon. Ewaak ayong Sion lo erai ekapolon a ere a Echibon, lo erai Eamorit, nakan kus, aapei ka akwap keng. Kitijikisi ngesi sodi tolemasi akwap keng toloma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.24",
            "verseOrgIds": [
              "DEU.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napei tokona jik, ewaakini ayong ebuloi lotunga awadaang, kotere esi. Eemi itwaan daang tamaranik napei iirarea esi kilimitoe.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Edwangete Ngisirael Sion lo arai ekapolon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sodi atomea ayong ngitunga anariet a Kedemos toloto lokapolon enyaritae Sion lo a ere a Echibon, toloto alimor akiroit nakisilet ebalasi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.26",
            "verseOrgIds": [
              "DEU.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘kimiekinae sua etoro nakwap kon. Kipori sua jik ewapa erot nakaneni nyikitubor. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitachi sua akimuj na kinyami ka ngakipi na kimasi. Ibore daang ni kisaki ngesi akitor nakwap kon, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "tanang kidokari ekwakaye angolol a Yorudan atolomasi nakwap nakiinakinit sua Ekapolon Akuj na erai Akuj kosi. Kichamakinete sua ngalesea a Esau lu alomito Edom, ka Ngimoab lu alomito Ari, kitachamakis kitori nakwap kech.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakaneni, towou Sion achamakin ngoni kitori nakwap keng. Abu Ekapolon Akuj na erai Akuj kus kitininik etau keng toliwor ngesi lokechanan, atolemareta akwap keng, na tokona eringa kilomit.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abu Ekapolon Akuj katolimok ayong tama, ‘Kingolik a, tolemasi tokona ekapolon Sion ka akwap keng kainak esi, tolemasi tokona akwap keng toloma.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.31",
            "verseOrgIds": [
              "DEU.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pot Sion ka ngitunga keng akitijwore ngoni alodiyete ere a Yaasa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.32",
            "verseOrgIds": [
              "DEU.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakaneni abu Ekapolon Akuj na erai Akuj yok kiwaak ngesi nakan yok, ataara ngoni ngesi ka talokookeng, ta ngitunga keng daang. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.33",
            "verseOrgIds": [
              "DEU.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipot nabo atoremo ka akinyasun ngirerea daang, ataara ngitunga daang, ngikiliok ka ngaberu ta ngide. Emam itwaan kiisik ngoni eyari. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.34",
            "verseOrgIds": [
              "DEU.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolemasi ngaatuk kech ka alemar ngiboro alorerea. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.35",
            "verseOrgIds": [
              "DEU.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon Akuj na erai Akuj yok kimiek ngoni atolemasi ngirerea daang napei ani eyei lo enyaritae Aroer, lo eyei lokeli a adipo a Arinon, ka ere lo alokiding adipo ngina, kinapar jik tanang Gilead. Emam ere lo abu awas keng togogonger kipiyo ngoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni nyeloto ngoni diyete akwap a Ngiamon kori lokwaasea a angolol a Yabok, kori lorerea a akwap a ngimukur, kori wache ni aringa Ekapolon Akuj na erai Akuj yok nyelimokina ngoni atamar atoloto.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
          }
        }
      ]
    }
