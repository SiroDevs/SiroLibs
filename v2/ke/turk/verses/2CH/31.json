              "2CH.31.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Ekim 28:1–29:39",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arumoret a ngakiro kanguna kadaang, apot Ngisirael daang lu ayakasi neni, toloto lorerea a Yuda daang tobwangabwangaasi ngapirio a ngamoru ka atubutub ngakisikwaanet a akuj anaberu anabe Achera, sodi kinyasut ngikenoi lu ipeyonokinere ngakujo nagelayek. Apot kesi tosuba ngakiro napei nguna anakwap a Yuda kadaang, ka ngakwapea a Benjamen, ka Epiraim ta Manase. Ani erumor tobongosi kesi nawiyei kech.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ekapolon Esekia torek atukuoru a ngimurok ka Ngilawi, totiakanak ipei kech daang etich keng. Ngitichisio ngulu kesi akipeyore ngakipeyos na inomio, ka ngakipeyos a ekisil, akilipeenen alokai a Akuj, akipuro Akuj ka abuakin alakara alowaitin alugelagelae a akai a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.12+NUM.18.13"
              },
              "items": [
                {
                  "text": "Ekim 18:12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abu Esekia tolemuunu alosipaan keng ngibaren lu alemunio eraakasi ngakipeyos na inomio ataparach daang ka atabong daang, ka lu epeyoo ngirwa lua Sabato, ka ngirwa lu esukukuu alo eanyungarere elap ta ngisukukui luche lu esakit etal a Ekapolon Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todungok ekapolon ngitunga a Yerusalem atamar tolemanakisi ngimurok ka Ngilawi ngalemunet na eraakasi ngakech, sodi tolemunotor kesi loger lo esakitor etal a Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napei adungunere ngakiro nguna, apot Ngisirael yaut ngainakinet na araakasi ngikinyam kech luajokak, ka emuna, ka akimiet a ngikito, ka akimiet a ao, ka ngalemet nache ta ngalemunet",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "31:5",
              "type": "text"
            },
            {
              "text": "ngainakinet ... ngalemunet;",
              "type": "text"
            },
            {
              "text": "araakasi ngainakinet ngaka ngimurok taraakas ngalemunet ngaka Ngilawi. (Kingolik Ekimar 18.)",
              "type": "text"
            }
          ]
        },
        {
          "text": " a ngiboro kech kadaang. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot tani ngitunga daang lu alomito lorerea a Yuda yaut ngalemunet a ngaatuk kech ka ngamesekin, yaut tani ngainakinet nakaalak noi sodi kitaleut toliworos ngaka Ekapolon Akuj ana erai Akuj kech. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esiakinete kesi ayaunun ngainakinet elap lo a nguuni sodi kidiatas tanang elap lo a ngikan-kaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ingolikinete ekapolon Esekia ka ngikapolok a arieng keng etiae a ngiboro alu alemunio, apot kesi kipuro Ekapolon Akuj ka Ngisirael lu eraakasi ngitunga keng. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ekapolon kisuruor ngimurok ka Ngilawi ngakiro a ngainakinet kanguna. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu emuron loapolon lo anyaritae Asaria lo arai alesit a Sadok, tolimok ekapolon tama, “Napei kolong esiakineta ngitunga ayaunun ngadekon kech kai a Akuj, kimuj sua kimwoko nabo edeun ngiboro lukaalak. Eyakasi ngiboro lugu kainyo epiarit Ekapolon Akuj ngitunga keng.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todungok ekapolon Esekia kesi atamar tosubakis ngidulae alokai a Akuj, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "sodi kiwaakis ngainakinet daang ka ngalemunet kikachakinae ejok. Abu Elawit epei lo anyaritae Konania toweik ngiboro ngulu. Lokaatokeng lo anyaritae Chimei ngesi engarakinit ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngilawi ngitomon kesi aseunitae akisub etich ka kesi. Anyaritae kesi Yeyel, ka Asasia, ka Naas, ka Asael, ka Yerimos, ka Yosabad, ka Eliel, ka Isimakia, ka Maas ta Benaya. Asubio ngakiro nguna daang loger lo adungunitotor ekapolon Esekia ka Asaria lo arai emuron loapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elawit lo anyaritae Kore lokookeng a Imuna lo arai asiger naketeon ekidor lo alo kide akai a Akuj, ngesi aweikinit ngainakinet na alemanakinio Ekapolon Akuj ka akikor ngainakinet nguna. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alorerea aluche alu alomito ngimurok, ayakasi Ngilawi lu engarakinito ngesi. Anyaritae kesi Eden, ka Miniamin, ka Yechua, ka Chemaya, ka Amaria ta Chekania. Akoranakinete kesi Ngilawi luche akimuj kitiriyana itemem ka ngitichisio lu atiakanakinitae kesi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "meere itemem ka ngimacharin. Akoranakinio akimuj ngina ngikiliok daang lu araakasi ngikaru kech ngitomwon-uni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "31:16",
              "type": "text"
            },
            {
              "text": "ngitomwon-uni;",
              "type": "text"
            },
            {
              "text": "Esibit igiritae nagiran ngitomwon-uni; igiritae Naeburaniae nguuni.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kori lu eporito, lu asubete ngitichisio alokai a Akuj akolongit daang itemem ka eger lo atiakanakinitae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiakanakinio ngimurok ngitichisio a ngimacharin, totiakakinae Ngilawi lokech a ngalooso. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigirae kesi daang aapei ka ngaberu kech, ka ngide ta ngitunga luche lu erikito kesi, kainyo erichunito kesi akitaleun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi ngitunga lu asubete etich lo akikor akimuj. Akoranakinete kesi ngikiliok daang lua ngawiyei a ngimurok, ka itwaan cha daang ni egiritae lomacharin a Ngilawi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakwap kadaang a Yuda, abu ekapolon Esekia tosub ngakiro na eyookino nabo na ajoikinito Ekapolon Akuj na erai Akuj keng. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tojoker etich keng daang, kainyo ibore ni asubi ngesi daang kotere akai a Akuj, kori Etal, asubi ngesi kotere amuno ka alemuna ani Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
      ]
    }
  ],
