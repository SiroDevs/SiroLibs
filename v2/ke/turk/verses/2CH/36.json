                }
              ]
            }
          ]
        },
        {
          "text": " Ani enangi ngirwa lua ngirupei, abu ekapolon Nebukadinesa toriko Yeoyakin Babilonia kitiliwo eenat. Tolema Nebukadinesa ebari a akai a Akuj. Ani erumor kitiliwo Nebukadinesa amae",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:10",
              "type": "text"
            },
            {
              "text": "amae keng;",
              "type": "text"
            },
            {
              "text": "igiritae Naeburaniae atamar lokaatokeng.",
              "type": "text"
            }
          ]
        },
        {
          "text": " keng a Yeoyakin lo anyaritae Sedekia, kitiliwo ekapolon a Yuda ka Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        }
