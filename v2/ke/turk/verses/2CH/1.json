                "loc": "EXO.38.1+EXO.38.2+EXO.38.3+EXO.38.4+EXO.38.5+EXO.38.6+EXO.38.7"
              },
              "items": [
                {
                  "text": "Apud 38:1-7",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akolongit ngina nakwaare, bu Akuj nia Solomon kingit tama, “Nyo isaki iyong kainak ayong iyong?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachu Solomon tama, “Idodiunit kolong iyong jiik amina naationon anika apakang Daudi, nabo kimiek tokona ayong elunyokin lokicholong keng, atoliwor ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.8",
            "verseOrgIds": [
              "2CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, Ekapolon Akuj na irai Akuj, kiyook ngakiro nakolong ichikakini iyong apakang. Kitiliwo iyong ayong ekapolon a ngitunga alukaalak noi etia asinyen. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.16"
              },
              "items": [
                {
                  "text": "Siak 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.14"
              },
              "items": [
                {
                  "text": "28:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakinae robo aosou ka achwaanu atopolokinio kesi. Ani kemam, ekokini ayong apolokini ngitunga lukon kaalak lugu ai?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Akuj Solomon tama, “Iseu iyong ibore niajokon. Akidwang iyong akisak ebari kori ngiboro luajokak, kori ekipur, kori akitu a ngimoe kon, kori tani ngirwa kon lu iyarea kiatakinae, ilimu iyong atamar isaki aosou ka achwaanu topolokinio ngitunga kang, lu ketiliwo ayong iyong ekapolon kech. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.11",
            "verseOrgIds": [
              "2CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.26"
              },
              "items": [
                {
                  "text": "1 Kapol 4:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kainakini ayong iyong aosou ka achwaanu. Kainakini nabo dang ebari ka ngiboro luajokak ta ekipur akidwang ngikapolok daang lukolong engarenete iyong ka lu isidiunosi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.12",
            "verseOrgIds": [
              "2CH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agogongu a Solomon ka ebari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.12",
            "verseOrgIds": [
              "2CH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi torotok Solomon ani elipeenere alo Gibeon, ani ayei eam a Akuj, sodi tobongo Yerusalem. Topolok ngesi Ngisirael kaneni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tochunak Solomon ngaurukukui na irito ngangolei abunget apei ka ngamiae ngoomwon ka ngasigerea nakameak ngangolei ngabunge ngatomon ka ngaarei. Kiwaak ngesi ngiche kech Yerusalem, sodi kiwaak ngiche lorerea lugelagelae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.14",
            "verseOrgIds": [
              "2CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngirwa lu araakar Solomon ekapolon, asojunito ngasua nakwangae alo Yerusalem loger a ngalup. Alalak nabo ngakito a ngichekereng loger lo elalakeata ngikuno anaukon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.15",
            "verseOrgIds": [
              "2CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aweikinito ngimuchurus a ekapolon Solomon egielit a ngangolei ana ayauniyo alo Musiri ka Kilikia,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
            "verseOrgIds": [
              "2CH.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:16",
              "type": "text"
            },
            {
              "text": "Musiri ka Kilikia;",
              "type": "text"
            },
            {
              "text": "ngakwapea ngaarei nangorok na eyakasi ni tokona erai kuju kide a Uturuki. Neni ngesi etuuriyeenere ngangolei ngirwa lua ekapolon Solomon.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
            "verseOrgIds": [
              "2CH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Etal 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ka ngaurukukui na eriuniyo alo Misiri. Agielanakinete kesi ngikapolok a Ngiiti ka Siria aurukuk apei ngakiloi ngakan-kapei a ngaropiyae, ani ngangolei ngakiloi 1.5 a ngaropiyae.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        }
      ]
    }
