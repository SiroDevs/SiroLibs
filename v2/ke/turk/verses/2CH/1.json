              },
              "items": [
                {
                  "text": "2 Sam 6:1-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.5+1CH.13.6+1CH.13.7+1CH.13.8+1CH.13.9+1CH.13.10+1CH.13.11+1CH.13.12+1CH.13.13+1CH.13.14"
              },
              "items": [
                {
                  "text": "1 Ngirwa 13:5-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "15:25–16:1",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu Solomon kipeyonok Ekapolon Akuj ngakipeyos alokeno alo a ngasua ananyangayek alongaren eam. Araakasi ngakipeyos nguna ngibaren abunget apei lu inomio nginerin daang. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
