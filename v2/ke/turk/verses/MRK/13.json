                  "text": "Tood 6:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Emeari ngesi ngimalaikae keng lowaitin daang a akwap, sodi tochunut ngitunga luseuna a Akuj alowae a epei a akwap tanang lowae loche. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        },
