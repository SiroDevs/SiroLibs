                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.9"
              },
              "items": [
                {
                  "text": "Lawi 20:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.16"
              },
              "items": [
                {
                  "text": "Etal 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ideparete esi akiwap etal a Akuj dio kiwapa ngakitatamet a ngitunga.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.8",
            "verseOrgIds": [
              "MRK.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.8",
            "verseOrgIds": [
              "MRK.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolimok Yesu kesi tama, “Eyei esi erot eche lo a aosou lo ipedoreta asegarit Alotal a Akuj sodi kiwapeta ngakitatamet kus a ngikulepek. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.9",
            "verseOrgIds": [
              "MRK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo kidungokinit esi Musa ebala, ‘Toker apakon ka itiokon,’ nakaneni, ‘Ngini iruoror apakeng ka itiokeng ngakiro naaronok, eario.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.10",
            "verseOrgIds": [
              "MRK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni itatamete esi atamar ani keyei itwaan ibore ni ingarakinea apakeng ka itiokeng, nakaneni tama, ‘Erai ibore ni enyaritae Koriban’ (eger keng atamar elemikinitae Akuj,) ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.11",
            "verseOrgIds": [
              "MRK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abe emam ngakiro erai pekingarak ngesi apakeng ka itiokeng. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.12",
            "verseOrgIds": [
              "MRK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloger kangolo, ngakiro na itatamete esi luche itiliworete Akiroit a Akuj apasit. Nakaneni eya ngakiro nache nakaalak na ikote nguna na isubete esi.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.13",
            "verseOrgIds": [
              "MRK.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngakiro na itoronete itwaan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.13",
            "verseOrgIds": [
              "MRK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tanyarau Yesu asepich a ngitunga nikeng nabo tolimok tama, “Topupokinae daang ayong toyeneta. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.14",
            "verseOrgIds": [
              "MRK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emam ibore nia anikalapatan ni elomari nakituk a itwaan ni epedori akitoron ngesi. Pearai ibore ni epuduni anakituk keng epedori akitoron ngesi.” [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.15",
            "verseOrgIds": [
              "MRK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keya ngaki nakiiraret, kiira robo!]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.16",
            "verseOrgIds": [
              "MRK.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.16",
            "verseOrgIds": [
              "MRK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erotokini ngesi anasepich a ngitunga toloma kai, tamasi ngirukitos keng kisaki kitatamikin eger a ngakitadapet kanguna. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.17",
            "verseOrgIds": [
              "MRK.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Yesu kesi tama, “Ikwa nyichwaaka esi dang nyidwangito luche a? Nyiyenete esi a? Emam ibore nia anikalapatan ni elomari nakituk a itwaan kitoron ngesi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.18",
            "verseOrgIds": [
              "MRK.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kainyo nyelomari lotau keng pearai elomari nakook sodi topudo anakwaan.” (Alolimune keng kongina, asaki Yesu toyenae dir atamar epedorio akinyam ngamuja daang.)",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.19",
            "verseOrgIds": [
              "MRK.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.19",
            "verseOrgIds": [
              "MRK.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolim nabo tama, “Erai ibore ni epuduni alotooma etau a itwaan ngesi itoroni ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo erai tooma lotau a itwaan ngesi eponitotor ngitamen luaronok lu epedorete akitusub ngesi ngakiro naaronok na ikote akoko, akiar, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.21",
            "verseOrgIds": [
              "MRK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "elomit, etereku ta ngakiro nache naaronok na ikote nugu, engalas, aloloat, arorokanut, eswamit, ekinis ta ekiwaanu, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.22",
            "verseOrgIds": [
              "MRK.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngakiro naaronok nu daang eponito alotau a itwaan sodi kitorono ngesi.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.23",
            "verseOrgIds": [
              "MRK.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anupit a aberu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.23",
            "verseOrgIds": [
              "MRK.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi torotok Yesu kaneni toten nakwap na ayei diye ngirerea a Tiro ka Sidon.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:24",
              "type": "text"
            },
            {
              "text": "Sidon;",
              "type": "text"
            },
            {
              "text": "nyigiritae nakitabea ngache nangorok ekiro be Sidon.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Toloma ngesi kai nakaneni peasaki ngesi itwaan tani ipei toyen atamar eyei ngesi neni. Nakaneni peapedori ngesi akiduk kaneni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiira aberu na akoporito ikoku keng ngikerep ngakiro a Yesu. Bu ngesi nikeng atipei tadakakin nakejen keng. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.25",
            "verseOrgIds": [
              "MRK.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pearai aberu ngina Ayaudit. Arai ngesi aka a akwap a Siria a ekitela alo enyaritae Poinike. Kimaima ngesi Yesu esaki kitwarak ngipean ani a nakookeng. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.26",
            "verseOrgIds": [
              "MRK.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni tatachak Yesu tama, “Kimiek mono esimuj ngide. Nyejoikinit akimuj a ngide echakakinio ngingokwo.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.27",
            "verseOrgIds": [
              "MRK.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.27",
            "verseOrgIds": [
              "MRK.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachu aberu ngina tama, “Ekaapaan, nakaneni enyamete tani ngingokwo lu eya kwap emeesa akimuj na epiyanunete ngide!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.28",
            "verseOrgIds": [
              "MRK.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.28",
            "verseOrgIds": [
              "MRK.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolimok Yesu ngesi tama, “Kotere akiroit na itachu iyong ngina, tobongo nawi. Apudosi ngipean anikoku kon!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.29",
            "verseOrgIds": [
              "MRK.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.29",
            "verseOrgIds": [
              "MRK.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolot ngesi nawi torukau ikoku keng eperi alojemu. Kebu Ekipe dir topudo anikeng.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.30",
            "verseOrgIds": [
              "MRK.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etojoki Yesu ekinim lopeeruoro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.30",
            "verseOrgIds": [
              "MRK.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torotok Yesu anakwap ana ayei diye ere a Tiro kitor lore lo enyaritae Sidon ka akwap a Ngirerea a Lutomon tanang nanam a Galilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
            "verseOrgIds": [
              "MRK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaut ngitunga ngiche nikeng itwaan nikinim ni peapedori tani akiruorikin. Kimaimaa kesi Yesu tamasi kidokok itwaan ngini akan keng topia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
            "verseOrgIds": [
              "MRK.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni toriko Yesu ngesi bon tachada alotunga. Kirepak ngimoyo keng naki a itwaan kangini. Kimaak ani erumor tatap angajep a itwaan kangini. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingolia Yesu kidiama nadis sodi kirema noi tolimok itwaan ngini tama, “Epipasa,” eger keng atamar, “Tangaar!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangaar ngaki, talaki angajep, sodi kiruorik niajokon. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
            "verseOrgIds": [
              "MRK.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi kichikichik Yesu ngitunga atamar nyeelimokis itwaan iche ngakiro nguna, nakaneni ani edungokini ngesi kesi atamar nyeelimosi ngakiro nguna, tolomakis kesi ekiruor lokojokon noi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.36",
            "verseOrgIds": [
              "MRK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tatalasi daang lu eirarete ngakiro nguna tamasi, “Kingolikisi eger lo esubea ngesi ibore daang niajokon!” Topodokis kesi ebaasi, “Epedori ngesi akisiirar lukinim ngakiro ka akisuruorikin lu nyiruorosi sek!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.37",
            "verseOrgIds": [
              "MRK.7.37"
            ]
          }
        }
      ]
    }
  ],
