          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni tokona, esileereun ngakiro na iteni nguna anagiran a ngikadwarak a Akuj ani nabo kotere ngakiro na adunguni Akuj na nyesaluni, eteyenun ngitunga a ngibukui alukaalak sodi tonupeta kesi daang ngakiro a Akuj kiwapa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.26",
            "verseOrgIds": [
              "ROM.16.26"
            ]
