              },
              "items": [
                {
                  "text": "Ekim 22:1-35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.1+NUM.16.2+NUM.16.3+NUM.16.4+NUM.16.5+NUM.16.6+NUM.16.7+NUM.16.8+NUM.16.9+NUM.16.10+NUM.16.11+NUM.16.12+NUM.16.13+NUM.16.14+NUM.16.15+NUM.16.16+NUM.16.17+NUM.16.18+NUM.16.19+NUM.16.20+NUM.16.21+NUM.16.22+NUM.16.23+NUM.16.24+NUM.16.25+NUM.16.26+NUM.16.27+NUM.16.28+NUM.16.29+NUM.16.30+NUM.16.31+NUM.16.32+NUM.16.33+NUM.16.34+NUM.16.35"
              },
              "items": [
                {
                  "text": "16:1-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikote kesi ngitoroi a anam lu ekulaate, nabo ileerete ngakiro kech na a ngileech loger a ngikurudoi. Ikote kesi ngikanyer lu ilato, lu asubaki Akuj nikirion chuch ni epete kesi jik. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.13",
            "verseOrgIds": [
              "JUD.1.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
