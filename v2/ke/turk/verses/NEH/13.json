              },
              "items": [
                {
                  "text": "Apud 34:11-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.1+DEU.7.2+DEU.7.3+DEU.7.4+DEU.7.5"
              },
              "items": [
                {
                  "text": "Etal 7:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Atodungok ayong Ngilawi atamar kitaleunos sodi toloto kiyoko ngidorin kirichakinere etal a Sabato.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Akuj kang, kitamunae kotere tani ngakiro nguna, sodi kitajalu kotere amina kon naapolon.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
