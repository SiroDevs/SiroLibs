              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimokinae Solomon kona, “Eemit Adonija ekapolon Solomon. Arwakin ngesi ngaamwar a ekeno a ngakipeyos ebala, ‘Asaki ayong kikong mono ekapolon Solomon anikang atamar nyakaari ayong.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.51",
            "verseOrgIds": [
              "1KI.1.51"
            ]
          }
        }
