                  "text": "2 Ngirwa 9:15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Loger lokolong a apakeng, abu ngesi tosechak Ekapolon Akuj, nabo kilomak Ngisirael nakisech.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
