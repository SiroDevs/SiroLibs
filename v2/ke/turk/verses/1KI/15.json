              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaru lo a ngiarei lo araakar Asa ekapolon a Yuda, toliwor Nadab lo arai lokookeng a Yeroboam ekapolon a Isirael. Topolok ngesi Isirael a ngikaru a ngiarei. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
