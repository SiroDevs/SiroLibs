          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loger a Yeroboam alosek engareni ngesi, abu Baacha tosechak Ekapolon Akuj, nabo kilomak Ngisirael nakisech.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
