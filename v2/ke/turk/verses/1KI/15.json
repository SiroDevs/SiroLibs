              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaru lo a nguuni lo araakar Asa ekapolon a Yuda, toliwor Baacha lokookeng a Aija ekapolon a Isirael. Topolok ngesi Isirael alo Tirisa a ngikaru a ngitomwon-arei ka nguomwon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
