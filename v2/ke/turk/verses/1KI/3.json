          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni tolim aberu nache tama, “Nyeinakinio itwaan ipei ikoku ngini, tapak!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
