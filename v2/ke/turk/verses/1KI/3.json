            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim ekapolon tama, “Inunae ayong ekileng.” Sodi inunae ekapolon ekileng. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.24",
            "verseOrgIds": [
              "1KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
