              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani aloger aminar aberu nalope ikoku keng, abu ngesi tolimok ekapolon tama, “Ekapolon kang, nyiar kare ikoku! Nak aberu naga!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
