          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim ekapolon tama, “Tapak ikoku ni eyari ngaarei, nak ewae epei aberu apei, nak ewae loche aberu nache.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        }
