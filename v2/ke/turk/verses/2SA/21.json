        },
        {
          "text": "Ani ekisidi kanguna, tojikinetei ka Ngipilisti ani enyaritae Gob. Alojie kangolo, taar Sibekai lo a Ucha itwaan nilangir-kooyan noi anyaritae Sap.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        }
      ]
