              "type": "text"
            }
          ]
        },
        {
          "text": "Tojikinetei nabo ka Ngipilisti ejie eche alo Gob. Abu Elianan lokookeng a Yair,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:19",
              "type": "text"
            },
            {
              "text": "Yair;",
              "type": "text"
            },
            {
              "text": "esibit igiritae Yair; igiritae Naeburaniae Yaareoregim.",
              "type": "text"
            }
          ]
        },
        {
          "text": " lo abunit alo Betleem, taar Golias lo a ere a Gas. Alangir akwara a Golias ekoni amorok akitoe nalangir eyei ni etokere ngiworui.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
