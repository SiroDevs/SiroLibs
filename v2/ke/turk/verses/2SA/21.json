          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimenya ngesi Ngisirael. Abu Yonasan, lo arai lokookeng alokaatokeng a Daudi alo anyaritae Chama taar ngesi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
            "verseOrgIds": [
              "2SA.21.21"
            ]
          }
        }
