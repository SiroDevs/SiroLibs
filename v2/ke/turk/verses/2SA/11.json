              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirari Besicheba atamar aar lokile keng, abu kigor tosutonok. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
