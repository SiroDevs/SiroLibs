                  "text": "Etal 4:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Itiliwo iyong Ngisirael ngitunga kon nakajik. Ani iyong Ekapolon Akuj, iliwor Akuj kech.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
