          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaut kesi ngiboro luperiet, ka ngatubwae nachukul, ta ngamoti nalupei. Yaut tani ngakanoi, ka erau ka ngakiria, ka epeipe lo epeitoe, ka ngimare ka auk a ngimare, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.28",
            "verseOrgIds": [
              "2SA.17.28"
            ]
          }
        },
        {
          "name": "verse",
