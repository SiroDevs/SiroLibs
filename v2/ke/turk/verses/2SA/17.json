              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Daudi tanang lore a Maanaim esaa lo adokareta Ngisirael ekwakaye Yorudan. ( ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
            "verseOrgIds": [
              "2SA.17.24"
            ]
          }
        },
