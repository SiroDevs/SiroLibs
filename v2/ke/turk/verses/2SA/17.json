              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Topero Abusalom ka ngitunga keng nakwap a Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.26",
            "verseOrgIds": [
              "2SA.17.26"
            ]
