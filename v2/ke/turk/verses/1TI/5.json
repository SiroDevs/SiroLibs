                "loc": "DEU.25.4"
              },
              "items": [
                {
                  "text": "Etal 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.10"
              },
              "items": [
                {
                  "text": "Mat 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.7"
              },
              "items": [
                {
                  "text": "Luk 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kikilak lu esecheenete alongaren ngitunga daang sodi toemeta luche. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.6"
              },
              "items": [
                {
                  "text": "Etal 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadungokinit ayong iyong ngakiro nugu kechikichiki alongaren Akuj ka Yesu Kiristo ta ngimalaikae lu italeuno atamar kiwap ngakiro nugu wara nyiipasak tani apei kori tominak itwaan iche anibore kadaang ani isubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.21",
            "verseOrgIds": [
              "1TI.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiimatakin akidokokin ngakan nakou a itwaan atipei erai isaki tosub etich a Ekapolon Yesu. Wara nyiiloma nasechesea a ngitunga aluche, kiboikin irai itwaan ni ikiuna.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
            "verseOrgIds": [
              "1TI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
            "verseOrgIds": [
              "1TI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wara nyiimat ngakipi make, nakaneni tamaseene emuna lodiochichi kotere akook kon ka ni idekanakinor iyong jiik.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ileerete ngasechesea a ngitunga a ngiche, erikito kesi loriras, nakaneni etakanunete ngasechesea a ngiche ekisidi. ",
          "type": "text",
