                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi toliworor itwaan ni esubi etich a Akuj ni esubakina eriyan, tosubea etich loajokon daang.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.17",
            "verseOrgIds": [
              "2TI.3.17"
            ]
