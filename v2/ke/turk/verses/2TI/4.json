                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kasubea ayong Alekisanda loketiakan ngasua ngakiro naaronok noi, esubea ngesi Ekapolon na itemem ka nakasubea ngesi ayong. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
