                {
                  "text": "2 Tim 1:16-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kimalakinae Prisila ka Akula ta ngitunga a awi a Onesiporo. ",
          "type": "text",
          "attrs": {
