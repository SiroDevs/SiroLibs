          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tochoik tani iyong ngesi lokojokon noi, kainyo ngesi kolong etepegi ngakiro kosi a adedengu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
