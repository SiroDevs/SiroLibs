        },
        {
          "text": " Luka bon kirukit ka ayong. Taanyu Mariko kirukut ka iyong, kainyo epedori ngesi akingarakin ayong alotich. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
