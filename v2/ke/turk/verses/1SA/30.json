          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ta Eburon. Yaa ngesi ngiboro ngulu lorerea daang lu kolong sek erimito ngesi ka ngitunga keng.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.31",
            "verseOrgIds": [
              "1SA.30.31"
            ]
