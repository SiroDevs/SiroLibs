              "1SA.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akolongit ngina ayei itwaan neni ni arai ipei a ngikasubak etich a Saul. Eratakinitae ngesi kaneni kainyo aya ngakiro a Akuj na asakitae ngesi tosubak. Anyaritae ngesi Doeg. Abunit Doeg alo Edom. Arai ngesi ekapolon a ngikeyokok a Saul.)",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
            "verseOrgIds": [
              "1SA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
            "verseOrgIds": [
              "1SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Daudi Aimelek tama, “Emam akwara kori ekileng itingit iyong kane lo apedori alemar a? Nyeyauna ayong ekileng kang kori ngiboro lujiet kainyo ekirikirakin ayong kotere ngakiro a ekapolon.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.8",
            "verseOrgIds": [
              "1SA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
