              },
              "items": [
                {
                  "text": "Luk 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi tolem emuron ngamugati na etaleunitoe na alemanakinio Akuj. Alemunio ngamugati nguna alomeesa a Akuj italeuno kilunyokinae ngache na aringa emoka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        },
