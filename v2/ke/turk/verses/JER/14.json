              "JER.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katodungok ayong Ekapolon Akuj atamar atolimok ngitunga kona,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imaimayete ngitunga Ekapolon Akuj",
          "type": "text"
        }
      ]
    }
