            "number": "1",
            "style": "v",
            "sid": "JER 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi ngakiro a akitab kana ngaka Yeremia alo arai lokookeng a Ilikia. Arai ngesi alesit a ngimurok a ere a Anasos anakwap a Benjamen. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Ekapolon Akuj Yeremia akiroit ekaru lo a ngitomon ka nguuni lo araakar Yosia lokookeng a Amon ekapolon a Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Kapol 22:3–23:27; 2 Ngirwa 34:8–35:19",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisuruor ngesi nabo na araakar Yeoyakim lokookeng a Yosia ekapolon a Yuda, ani ekisidi, kisuruor ngesi ngakisuruoret nakaalak, tanang ekaru lo a ngitomon ka epei na araakar Sedekia lokookeng a Yosia ekapolon a Yuda. Elap loa ngikan a ekaru kangolo, torikoe ngitunga a Yerusalem nakwap ache. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Kapol 23:36–24:7; 24:18–25:21",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7+2CH.36.8"
              },
              "items": [
                {
                  "text": "2 Ngirwa 36:5-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
