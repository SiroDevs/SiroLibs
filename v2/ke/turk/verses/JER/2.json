        },
        {
          "text": "Katolimok Ekapolon Akuj ayong akiroit tama, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.1",
            "verseOrgIds": [
              "JER.2.1"
            ]
          }
        },
        {
          "name": "verse",
