            "sid": "JER 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala Ekapolon Akuj kona, “Ngirwa ngulu, aliwor ayong Akuj a ngitela kadaang a Ngisirael, sodi toliworos kesi ngitunga kang.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngisien a Ekapolon Akuj ani a Ngisirael",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eanyunete ngitunga a Akuj ajako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
