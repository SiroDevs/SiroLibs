            "number": "23",
            "style": "v",
            "sid": "JER 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuj Namerikanyer na erai Akuj a Isirael, ebala kona, “Naabuunea ayong ngitunga nakwap kech, elimunete nabo anakwap a Yuda ka ngirerea keng kona,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.23",
            "verseOrgIds": [
              "JER.31.23"
            ]
          }
        }
      ]
    },
