                  "text": "Ese 18:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani erumor atokienyu ayong, engolia atorukau akwaan kelaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
