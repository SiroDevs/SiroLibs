          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elimokinit Ekapolon Akuj ngitunga a Yuda ka lu elomito Yerusalem ebala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.3",
            "verseOrgIds": [
              "JER.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebeyo eremio Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
