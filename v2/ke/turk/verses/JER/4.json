            "verseId": "JER.4.8",
            "verseOrgIds": [
              "JER.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala Ekapolon Akuj, “Akolongit ngina, ipirisaarosi ngitai a ngikapolok ka ngikarikok. Eriangakinosi ngimurok a Akuj, kuumwokis ngikadwarak.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
