          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo ebala Ekapolon Akuj kona, “Eliwor akwap daang alaireng, nakaneni nyenyasuni ayong lokojokon.)",
          "type": "text",
          "attrs": {
