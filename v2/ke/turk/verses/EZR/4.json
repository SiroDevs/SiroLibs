              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Reum dang lo arai ekarikon ka Chimchai lo arai ekegiran keng kigirakis Artachasta abarua naga, igirito ngakiro a Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
