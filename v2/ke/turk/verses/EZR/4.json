          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ngirwa lu araakar Artachasta lo a akwap a Persia ekapolon, apot Bichilam, ka Misiredas ka Tabeel, ta ngirukitos kech kigir abarua nia ekapolon Artachasta. Egiritae abarua ngina a Ngaramaik. Asakitae ilokonyio esaa lo isomaare.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:7",
              "type": "text"
            },
            {
              "text": "isomaare;",
              "type": "text"
            },
            {
              "text": "kori arai ngaramaik, nabo egiritae a Ngaramaik.",
              "type": "text"
            }
          ]
        }
      ]
    },
