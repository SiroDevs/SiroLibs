                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngirwa lu esiakinea Kerkesi aliwor ekapolon, apot ngimoe a ngitunga a Yuda ka Yerusalem kigira ngakiro na etitakinitotor kesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
