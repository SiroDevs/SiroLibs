              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolot Yakobo ni ayei apakeng alo Mamure, diyete ere a Ariba, ngesi atamar Eburon. Neni ngesi nikolong alomito Aburaam ka Isaka eraakasi ngipeyok. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi ngikaru lu ayarea Isaka amiat apei ka ngitomwon-kauni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
          }
        },
        {
