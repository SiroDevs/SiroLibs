              },
              "items": [
                {
                  "text": "Ebura 7:1-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi topia ngesi Aburam tolim tama,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.19",
            "verseOrgIds": [
              "GEN.14.19"
            ]
          }
        }
      ]
    }
