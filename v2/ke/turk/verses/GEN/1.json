                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Topia Akuj kesi, sodi tolimok tama, “Toureta, talalaketa nabo topetakinos wadaang, toreut ibore daang. Topolokisi ngikolia, ka ngikieny, ta ngiborei daang lu eliato analup.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.28",
            "verseOrgIds": [
              "GEN.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
