              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.21"
              },
              "items": [
                {
                  "text": "Yak 2:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tolim Aburaam tama, “Lokookang, elemuni Akuj alope imesek ni ipeyeo.” Apot kesi kirukosi aapei.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani enangunete kesi ni alimokinit Akuj, tosubak Aburaam ekeno a ngakipeyos kaneni kinapak ngakito kidiama ekeno. Toen ngesi lokookeng Isaka ani erumor kiperik kidiama ngakito na ayakasi lokeno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolem ngesi ekileng esaki akiar Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni tanyara emalaikat a Ekapolon Akuj ngesi anadis tama, “Aburaam, Aburaam.” Kiki ngesi tama, “Ayong lo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok emalaikat ngesi tama, “Wara nyiitap idia kori nyiiwan, kainyo ayen tokona atamar ikerit iyong Akuj, ngesi pekimikea iyong ayong lokookon lo erai epei bon.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikeu Aburaam akou taanyunga emesek lo angichakina ngaamwar keng namoni. Tolot Aburaam kirum emesek ngolo, tolem toliwor akipeyos, kilunyokin nados a lokookeng. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Aburaam neni ekiro be, “Kiinakini Akuj.”* Tani akolongit napei naga, ebalasi ngitunga, “Alomoru a Akuj, kiinakini ngesi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:14",
              "type": "text"
            },
            {
              "text": "Kiinakini ngesi;",
              "type": "text"
            },
            {
              "text": "kori itee.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanyara emalaikat a Ekapolon Akuj Aburaam na a ngaarei anadis ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "tama, “Ebala Ekapolon Akuj, ekong ayong alimunit ekiro kang atamar kapiari iyong ani isubea ngakiro nugu, nyimika iyong ayong lokookon lo erai epei bon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapiari ayong iyong dir, sodi etalala ngalesea kon loger a alalau a ngikanyer alu eyakasi nadis, ka asinyen na eyei lokwaas a anam. Idwangete ngalesea kon ngimoe kech. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.17",
            "verseOrgIds": [
              "GEN.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etamarete ngibukui a akwap daang topiarae kesi loger lo apiarea ayong ngalesea kon. Ikokinete nguna neni ani iwapitor iyong ngakiro kang.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.6.13+HEB.6.14"
              },
              "items": [
                {
                  "text": "Ebura 6:13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tobongo Aburaam ni ayakasi ngikasubak etich, tonyout kesi daang toloto Beer-cheba ni alomit Aburaam. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.12"
              },
              "items": [
                {
                  "text": "Ebura 11:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Tich 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
