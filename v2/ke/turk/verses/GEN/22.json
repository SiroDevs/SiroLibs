            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.17+HEB.11.18+HEB.11.19"
              },
              "items": [
                {
                  "text": "Ebura 11:17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani adaunet a ngakiro kanguna, kining Akuj Aburaam tanyara tama, “Aburaam.” Kiki ngesi tama, “Ayong lo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
