            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.7",
            "verseOrgIds": [
              "2PE.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.6+GEN.1.7+GEN.1.8+GEN.1.9"
              },
              "items": [
                {
                  "text": "Siak 1:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni adis ka akwap na tokona eyakasi, erai akiroit napei edungunit Akuj ngina eyakatar, sodi kinyasunere a akim. Iwaakinitae kesi idarito akolongit na iriraare ngitunga lu nyilipito Akuj kinyasunae. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.7",
            "verseOrgIds": [
              "2PE.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.11"
              },
              "items": [
                {
                  "text": "Siak 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.7",
            "verseOrgIds": [
              "2PE.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
