{
  "id": "LEV.25",
  "number": "25",
  "bookId": "LEV",
  "reference": "Ngilawi 25",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
