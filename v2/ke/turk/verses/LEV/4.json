            }
          ]
        },
        {
          "text": " Elemari ngesi nikataronon keng daang loger lo elemanarere nikataronon alobaren kadaang alu eario eraakasi akipeyos a ekisil. Ipeye ngesi alokeno a ngakipeyos sodi tojoik akukuny Ekapolon Akuj. Kotere eger ngolo, elemuni emuron akipeyos a akisech a itwaan, sodi torimakinae itwaan ngini.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
          }
        }
