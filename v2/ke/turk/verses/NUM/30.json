              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Musa nak ngikarikok a ngitela a Ngisirael ngitalio lugu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        },
        {
