          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitalio ngulu kesi ainakini Ekapolon Akuj Musa kotere ngakiro na ikongi aberu na nyiusitae, na eringa eyei nawi a apakeng kori aberu na iusitae.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
    }
