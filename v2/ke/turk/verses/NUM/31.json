              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ekimar a ngaatuk 36,000, toliworos na alemikinitae Ekapolon Akuj 72. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
