              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ekimar a ngaberu ana aringa nyepero ka ngikiliok 16,000, toliworos na alemikinitae Ekapolon Akuj 32. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
