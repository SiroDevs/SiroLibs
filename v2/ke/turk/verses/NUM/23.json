            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Balak Balaam tama, “Bua tokona, katoriko wache. Tokona ngon kichamakini Akuj iyong ilami kesi kaina kotere ayong.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi toriko ngesi Balaam kidiama emoru a Peor, lo erounit ariet. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
            "verseOrgIds": [
              "NUM.23.28"
            ]
          }
        },
        {
