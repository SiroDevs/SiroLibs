          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Balaam Balak tama, “Towo kane anakipeyos kon, sodi atolot ataanyun ka Akuj kaama.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
            "verseOrgIds": [
              "NUM.23.15"
