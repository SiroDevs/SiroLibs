          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachu Balaam tama, “Petakalimokinit ayong iyong atamar asubi ayong ngakiro daang nakalimokini Ekapolon Akuj a?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
