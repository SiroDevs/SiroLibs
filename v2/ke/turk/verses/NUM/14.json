                {
                  "text": "Yoch 14:9-12",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Erirae Ekapolon Akuj ngitunga ani eburaata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.25",
            "verseOrgIds": [
              "NUM.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Ekapolon Akuj Musa ka Aron tama, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.26",
            "verseOrgIds": [
              "NUM.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kesuburaate ngitunga luaronok lugu ayong tanang ori? Kaup ayong eburas a ngitunga kalu! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.27",
            "verseOrgIds": [
              "NUM.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok tokona kesi atamar abala ayong Ekapolon Akuj kona, ‘Ekongi ayong atamar ani kona ayarea ayong, kasubea esi ngakiro na isakete, ayong Ekapolon Akuj ngesi alimu nguna. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.28",
            "verseOrgIds": [
              "NUM.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itoakete esi sodi kiealakin ngawat kus nariet naga. Ani kona kisuburaata esi ayong, esi lu eraakasi ngikaru kus ngitomwon-arei ka lu iporito, emam tani ipei ni elomari nakwap ngina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.29",
            "verseOrgIds": [
              "NUM.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kechikakini kolong ayong esi atamar ilomete inaa, nakaneni tokona, emam tani ipei kus ni elomari neni mati Kaleb ka Yochua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.30",
            "verseOrgIds": [
              "NUM.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilimunete kolong esi atamar be kidemario ngide kus torikoe, nakaneni etananguni ayong kesi nakwap na ingero esi sodi toliwor awi kech. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.31",
            "verseOrgIds": [
              "NUM.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itoakete esi anariet kana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.32",
            "verseOrgIds": [
              "NUM.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliworosi ngide kus ngikeyokok anariet a ngikaru a ngitomwon-omwon, tanang esi daang itoakete. Eriamunete kesi ngichan ngulu kotere aronis kus. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.33",
            "verseOrgIds": [
              "NUM.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iriamunete esi ngichan kotere akisech kus a ngikaru a ngitomwon-omwon. Eliwor ekaru epei itemitoe ka akolongit apei a ngirwa alu kolong tomwon-omwon irebioto esi akwap. Iyenunete esi eger a aronis ana karemokinor ayong esi! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.34",
            "verseOrgIds": [
              "NUM.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.17"
              },
              "items": [
                {
                  "text": "Ebura 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ekongi ayong atamar asubakini nguna alotunga aluaronok alu apupokin akinger ayong kalu. Itoakete esi daang kane anariet. Ayong Ekapolon Akuj ngesi alimu nguna.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.36"
              },
              "items": [
                {
                  "text": "Tich 7:36",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitunga lukolong ameari Musa akireb akwap kesi ayaunete ngakiro naaronok, sodi kisuburata ngitunga Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.36",
            "verseOrgIds": [
              "NUM.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon Akuj inu kesi edeke loaronon, sodi totoaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.37",
            "verseOrgIds": [
              "NUM.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alotunga alutomon ka ngiarei kangulu, Yochua ka Kaleb make kesi apot toyara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aroyete Ngisirael akirem akwap",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani elimokini Musa Ngisirael ngakiro na alimuni Ekapolon Akuj, apot kesi kigoro noi tosutonokis. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.39",
            "verseOrgIds": [
              "NUM.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iwalari, tonyout kesi nataparach elilim toloto akirem akwap na a ngimukur ebalasi, “Kinyou tokona sua alosit nakwap nakolong kichikakini sua Ekapolon Akuj. Kicham sua atamar kisechit.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.40",
            "verseOrgIds": [
              "NUM.14.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.40",
            "verseOrgIds": [
              "NUM.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni tolim Musa tama, “Ani toliwor nyo peiwapeta esi ngakiro a Ekapolon Akuj? Kipiyori esi ibore daang! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.41",
            "verseOrgIds": [
              "NUM.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiilot. Kidwangete esi ngimoe kus kainyo nyirukito esi ka Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.42",
            "verseOrgIds": [
              "NUM.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani itijikinete esi Ngiamalek ka Ngikanaan, itoakete esi alojie. Nyirukete esi ka Ekapolon Akuj kainyo ingero esi akiwap ngesi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni apot kesi jik todokasi kidiama, toloto nakwap na a ngimukur, tarai bo tani nyenyouno asaduku a achamunet a Ekapolon Akuj ka Musa anadakar. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi apot Ngiamalek ka Ngikanaan lu alomito neni, kitijikis kesi kidwanga, kiritasi jik tananga Orima.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.45",
            "verseOrgIds": [
              "NUM.14.45"
            ]
          }
        }
      ]
    }
  ],
