          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot ngitunga daang toyena atamar atoana Aron, sodi tosutonokis a ngirwa a ngitomwon-uni kotere akitu keng.",
          "type": "text",
