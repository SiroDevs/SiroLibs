          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totupak ekitela a Sebulun. Eliab lo erai lokookeng a Elon ngesi erai ekarikon kech. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
