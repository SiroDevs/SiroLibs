          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ekimar a ngalooso kadaang a ngitunga a Yuda 186,400. Kesi isiaunete torotokis.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
