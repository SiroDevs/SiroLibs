            }
          ]
        },
        {
          "text": "Tolimok Ekapolon Akuj Musa ka Aron tama, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
