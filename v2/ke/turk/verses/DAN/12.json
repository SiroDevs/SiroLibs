              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor, abu ayong Daniel ataanyunga ngitunga ngiarei ewaasi alokwaas a angolol, ewei ipei alokwaas a epei a angolol, towei niche alokwaas aloche. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.5",
            "verseOrgIds": [
              "DAN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engit ayong itwaan ni ayei kuju angolol ni anapit ngiworui lukaanikak, atama, “Ori edaunotor ngakiro nakitubulete nugu?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
