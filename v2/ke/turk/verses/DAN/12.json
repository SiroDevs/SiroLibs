              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
