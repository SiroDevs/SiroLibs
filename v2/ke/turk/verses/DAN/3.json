          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingis ngesi tama, “Ani nyo eteo ayong ngitunga nguomwon eloose anakim? Nyeenen kesi nabo esibit nyewanan. Ani lo a nguomwon ikoni ikoku a ngakujo.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Epudun ngikiliok luuni kitiliworoe ngikapolok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
