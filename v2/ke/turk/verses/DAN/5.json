              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ekapolon Dario lo arai Emedit tolema apolou, eraakasi ngikaru keng ngitomwon-kapei ka ngiarei.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
