        },
        {
          "text": "Eger a ngakiro kanguna ngesi logo: MENE ngesi atamar emarun. Emaru Akuj ngirwa a apolou kon etasalu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        },
        {
          "name": "verse",
