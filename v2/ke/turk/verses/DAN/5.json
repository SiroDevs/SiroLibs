          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "TEKEL ngesi atamar apotis. Kitem iyong anaratilio ayen atamar emam iyong apotis. ",
          "type": "text",
