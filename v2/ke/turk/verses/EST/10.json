              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ekapolon Kerkesi kidesik ngitunga lugu akisub etich, ngitunga lua ekwaas a anam ka ngiwaitin luche a akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakiro naationok ka nakitalarete daang nakolong asubi ngesi, ka eger lokolong ainakinea ngesi Mordekai etich loapolon, igiritae nakitab na enyaritae Ngakiro a ngikapolok a Persia ka Media. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
