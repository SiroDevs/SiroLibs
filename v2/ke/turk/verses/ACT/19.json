    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo alo Epeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eringa Apolo eyei Korinto, torotok Paulo toped akwap na alona alokwaas a anam sodi tanangu Epeso. Torukau ngesi ngikanupak ngiche kaina ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.1",
            "verseOrgIds": [
              "ACT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kingit tama, “Ianyut kolong esi Etau a Akuj na kolong inupeta?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        }
      ]
    },
    {
