        },
        {
          "text": "akisub etich erai emeanara sodi kilunyokin lotich lo aisikini Yuda torei tolot ni asaki ngesi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
