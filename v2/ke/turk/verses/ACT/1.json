        },
        {
          "text": "Sodi tolimunoe ngitunga ngiarei, Yosep lo anyaritae Barisaba (lo arai ekiro eche Yusito) ka Matia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
