            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.9",
            "verseOrgIds": [
              "ACT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eringa kesi ekienyiyarito kidiama na alosio ngesi, towaa ngitunga ngiarei atipei alo diyete kech enapito ngiworui luakwaak. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.10",
            "verseOrgIds": [
              "ACT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tamasi, “Ngitunga a Galilaya, nyo iwaatar esi kaneni ikienyiyaritotor kidiama? Yesu lo ayaar nadis anikus lo, ebonguni loger lopei ianyungareta esi ngesi elosi nadis.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.11",
            "verseOrgIds": [
              "ACT.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Itwaan ni elunyokin lotich a Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.11",
            "verseOrgIds": [
              "ACT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobongosi kesi Yerusalem na aponeta alo Moru a ngikito a akimiet alo arai akilomitait apei alore. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.12",
            "verseOrgIds": [
              "ACT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ananguneta kesi lore, sodi todokasi kai na alokidiama na apereenete kesi. Araakasi kesi Petero ka Yoana ka Yakobo ka Andirea ka Pilip ka Tomas ka Bartolomayo ka Matayo ka Yakobo lokookeng a Alipayo ka Simon lo a atiakaru a Salote ta Yuda lokookeng a Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.2+MAT.10.3+MAT.10.4"
              },
              "items": [
                {
                  "text": "Mat 10:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.16+MRK.3.17+MRK.3.18+MRK.3.19"
              },
              "items": [
                {
                  "text": "Mar 3:16-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.14+LUK.6.15+LUK.6.16"
              },
              "items": [
                {
                  "text": "Luk 6:14-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Achunanakinosi kesi ilipito aapei ka ngaberu ngache ka Mariam itiokeng a Yesu ka ngikaitotoi keng.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
            "verseOrgIds": [
              "ACT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
            "verseOrgIds": [
              "ACT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaunet a ngirwa a ngidikidio, eriamito ngikanupak lu asibit amiat apei ka ngitomwon-arei. Sodi tonyou Petero tolim tama, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.15",
            "verseOrgIds": [
              "ACT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngikaitotoi kang, ajoikinit ngagiran iyookinosi loger lokolong adwarea Etau a Akuj ani a Daudi ngakiro a Yuda alo arikokini Yesu ngitunga lu erumunete. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai Yuda erukitos yok kainyo aseunitae atosuba ka ngoni etich.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
