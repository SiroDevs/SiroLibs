          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimonosi ngimeanara ngakiro a ayarun a Ekapolon Yesu a agogongu anaationon noi sodi topia Akuj kesi daang lokojokon noi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
