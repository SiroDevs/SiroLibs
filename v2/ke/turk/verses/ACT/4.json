          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emam itwaan anikech ni echana. Nakaneni lu aya ngamanat kori ngakais, togielasi yautu ngaropiyae na ariamunete, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
            "verseOrgIds": [
              "ACT.4.34"
            ]
          }
        },
