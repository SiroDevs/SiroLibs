              },
              "items": [
                {
                  "text": "Apud 22:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachu Paulo tama, “Ngitunga kang a Isirael, peayeni ayong atamar erai ngesi Emuron Loapolon. Igiritae nagiran kona, ‘Nyiiruoror ekapolon a ngitunga kon ngakiro naaronok.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
