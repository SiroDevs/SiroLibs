              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi torumo Paulo ekiruor a ngakiro ana alimuni tama, “Toyena robo atamar ayuuno na itorunit nia Akuj, esiporor lobukui lu nyerai Ngiyaudi. Epupokinete kesi!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
              "ACT.28.28"
            ]
