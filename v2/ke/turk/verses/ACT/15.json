                {
                  "text": "Tich 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kitor ngesi Siria ka Kilikia, ingaranakini ngitunga a ekanisa a ngakiro a Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.41",
            "verseOrgIds": [
              "ACT.15.41"
            ]
          }
