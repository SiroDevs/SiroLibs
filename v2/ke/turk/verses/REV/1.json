              "items": [
                {
                  "text": "Eosio 89:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kagatakinit tani nguna eponito ani a Yesu Kiristo alo erai ekaanyunan a Akuj lo emunoi, lo erai lo ekingaren iteyarunio alokatoak, lo erai ngesi epolokinit ngikapolok daang a akwap kana.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
