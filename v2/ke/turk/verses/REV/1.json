              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigir tokona na itee iyong, ngiboro lu eraakasi ngesi itee iyong tokona kangulu esubakinosi ekisidi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
