              "items": [
                {
                  "text": "Tood 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " sodi kitiliwo ngesi ngoni ngimurok a Akuj lu kisubi etich a Akuj ka apakeng. Min ekipur ka apolou nia Yesu Kiristo nakajik! Aamen. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
