                {
                  "text": "Dan 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.3"
              },
              "items": [
                {
                  "text": "Tood 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.7+REV.17.8+REV.17.9+REV.17.10+REV.17.11+REV.17.12"
              },
              "items": [
                {
                  "text": "7-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kilipa ngitunga daang emun loapolon ngolo kainyo ngesi ainakini etiengit ngolo apolou. Kilipa kesi tani etiengit ebalasi, “Ngae ikoni etiengit? Ngae itiji ngesi?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
