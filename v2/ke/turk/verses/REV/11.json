              "REV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikaanyunak luarei ngulu ngesi ngikito luarei a akimiet ka ngataae naarei ewaasi alongaren Ekapolon lo epolokinit akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kesak itwaan akiwan kesi, elomuni akim anakituk kech sodi tomunya ngimoe kech. Ani kotere erot ngolo, eario itwaan cha daang ni esaki akiwan kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.5",
            "verseOrgIds": [
              "REV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Kapol 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.17+EXO.7.18+EXO.7.19"
              },
              "items": [
                {
                  "text": "Apud 7:17-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.8"
              },
              "items": [
                {
                  "text": "1 Sam 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eyei kesi agogongu na egolioto adis, nyeeram akiru esaa lo iruorotor kesi ngakiro a Akuj. Eyei kesi tani agogongu na ibeloto ngileleae daang lu a ngakipi toliworos ngaakot, nabo eyei kesi agogongu na eyauneta ngakiro nakesiak nakwap, esaa daang lo esaketa kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
