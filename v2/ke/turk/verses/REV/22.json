              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isa 55:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ayong Yesu ngesi ameu emalaikat alimokin esi ngitunga a ngikanisae ngakiro nugu. Arai ayong ales a Daudi, ayong ngesi etop lokanokan a ataparach.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.16",
            "verseOrgIds": [
              "REV.22.16"
            ]
          }
        }
