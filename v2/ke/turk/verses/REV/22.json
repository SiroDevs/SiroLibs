          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epiaritae lu ilotarete ngiworui kech tosegeta tachamakinae enyamete ageor na a ekitoe alo a akiyar nabo kitoro lodorin tolomasi lore. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Isa 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni eyakasi lu ikote ngingokwo nikalapatan a ere, ka lu emuroote, ka lumalaae ta lukaarak, ka lu ilipeenete ngakujo nasubuna ta lu eliokoko, tominas alioko.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
      ]
    },
