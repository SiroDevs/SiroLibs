                "loc": "REV.1.8"
              },
              "items": [
                {
                  "text": "Tood 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.8"
              },
              "items": [
                {
                  "text": "2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.6"
              },
              "items": [
                {
                  "text": "Isa 44:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.48.12"
              },
              "items": [
                {
                  "text": "48:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ayong ngesi lo ekingaren ka lo a esal, akisiakinet ka esal.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
            "verseOrgIds": [
              "REV.22.13"
            ]
          }
        },
        {
          "name": "note",
