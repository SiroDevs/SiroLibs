                "loc": "2PE.3.13"
              },
              "items": [
                {
                  "text": "2 Pet 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Emiatari ngesi ngakiyo daang anakonyen kech. Engopi akitu jik, engopi apipilu ka akigoro ta ariaba. Angopia eboyor lokolong ngorot.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        },
