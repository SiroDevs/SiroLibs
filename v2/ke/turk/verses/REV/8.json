        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dio tokutak emalaikat lo a nguomwon aburuch keng. Taramae atiaket na a ngauni a akolong ka na a elap ta na a ngikanyer sodi tongopia atiaket na a ngauni a akicha anikech. Tongopia akicha a atiaket ana a ngauni a apaaran ka atiaket na a ngauni a akwaar.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
