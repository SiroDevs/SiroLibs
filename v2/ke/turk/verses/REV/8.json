        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dio engolia ayong, eira egole lo aporit alokiding adis irema ebala, “Oitiakoi kare! Abe etioko nginyas eanyunete lu ibooyete anakwap esaa lo ekutakineta ngimalaikae luuni idongito ngaburucho kech!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
      ]
    }
