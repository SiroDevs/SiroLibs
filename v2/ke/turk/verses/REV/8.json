              "attrs": {
                "loc": "EZK.38.22"
              },
              "items": [
                {
                  "text": "Ese 38:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tokutak emalaikat lo ekingaren aburuch keng. Totiyaun ngamoru a akiru ka akim, imorikina ka ngaakot tobukun kwap. Tonom atiaket apei ana a ngauni a akwap ka ngikito ta nginyia lukalibak daang.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dio tokutak emalaikat lo a ngiarei aburuch keng. Ibore ni asibit emoru loapolon anoki, tachakakinae nanam. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.12"
              },
              "items": [
                {
                  "text": "Isa 14:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kibelei atiaket apei ana a ngauni a anam toliwor ngaakot, totoaka atiaket apei ana a ngauni a ngitieng kadaang alu ayarete ayakasi nanam, kinyasunae atiaket apei ana a ngauni a ngatubwae.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokutak emalaikat lo a nguuni aburuch keng. Etop loapolon lo anoki loger a akinwaket, tachakun anadis, tachakakin natiaket apei ana a ngauni angangololin ka ngileleae a ngakipi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.15"
              },
              "items": [
                {
                  "text": "Yer 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (Enyaritae ekiro a etop kangolo “Adwaris.”) Kibelei atiaket na a ngauni a ngakipi todwarer, sodi totoaka ngitunga lukaalak ani amaasa ngakipi nguna, kainyo apot kibelos todwaraketa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.10"
              },
              "items": [
                {
                  "text": "Isa 13:10",
                  "type": "text"
                }
              ]
