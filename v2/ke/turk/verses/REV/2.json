              },
              "items": [
                {
                  "text": "31:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni kajoikinito ayong ngakiro nugu anikon: iremokino iyong na esubete Nginikolai loger lo aremokinookor ayong dang.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.6",
            "verseOrgIds": [
              "REV.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.6",
            "verseOrgIds": [
              "REV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani keya iyong ngaki nakiiraret, kiira robo ngakiro na elimokinit Etau a Akuj ngitunga a ngikanisae!",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani ngulu ipiunete naaronok, achamakini ayong enyamete ageor a ekitoe a akiyar alo erupunit Alomana a Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
      ]
    },
