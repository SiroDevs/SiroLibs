              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakaneni nyiiwapa esi luche lu iyakasi Tuatira akitatamet naaronon naga, eringa esi nyeyenuna ngakiro na enyarito ngiche, ‘Ngakiro namunonoe noi a Esiitan.’ Kalimokinit ayong esi atamar emam eogos eche ewaakini ayong nikus. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni kirichakisi lokojokon na ianyut esi tanang ngirwa lu abunio ayong. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ngulu ipiunete, lu erubakinete esubete na asaki ayong tanang losal, etiliwori ayong kesi ngikapolok a ngibukui. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "REV 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epolokinete kesi ngibukui a asuat anakapis, topetasi loger lo ebwangatar ngamoti nalupei kiealaros. Kikok eger lo aanyunea ayong dang apolou anika apakang. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
            "verseOrgIds": [
              "REV.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "REV 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.8+PSA.2.9"
              },
              "items": [
                {
                  "text": "Eosio 2:8-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ainakini ayong kesi etop lo a ataparach.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.28",
            "verseOrgIds": [
              "REV.2.28"
            ]
          }
        }
