                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ayei tani ngaren ekicholong ngolo ibore ni ekoni anam na a akiyo, ekoni amoru nakaparaparan noi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
