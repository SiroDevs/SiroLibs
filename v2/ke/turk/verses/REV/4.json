              },
              "items": [
                {
                  "text": "10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nipei bore ngini, engolik ayong akisingolikinet a Akuj ache, sodi ataanyunga ekidor lo angaara anadis.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
