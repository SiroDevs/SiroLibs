            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tasaka akisil ka itwaan daang, nabo tasaka akiboi eboyor lo italeuno, ani kiitun eboyor ngolo, emam itwaan eanyungari Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.14",
            "verseOrgIds": [
              "HEB.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tochoikinos sodi nyiibatarosi anajokis a Akuj. Warasi nyeemin itwaan ni ikoni ekitoe loadwaran lo erupuni sodi kisiak ngichan, toliworos ngikaalak lu nyitaleuno kotere ngichan ngulu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warasi nyeemin itwaan nimalaat kori ni nyekerit Akuj loger a Esau, alo kolong agialari apolou keng na araakar ikoku ni ekingaren kotere akimujet apei bon. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
            "verseOrgIds": [
              "HEB.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.30+GEN.27.31+GEN.27.32+GEN.27.33+GEN.27.34+GEN.27.35+GEN.27.36+GEN.27.37+GEN.27.38+GEN.27.39+GEN.27.40"
              },
              "items": [
                {
                  "text": "Siak 27:30-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Iyenete esi atamar asaki ngesi ekisidi atamar katopia apakeng, nakaneni tongeroi ngesi kainyo amam ngesi kona ilochi nasek apon tosubae. Asaki ngesi noi katopiar sodi kigor tani ngakiyo cholae. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.16+EXO.19.17+EXO.19.18+EXO.19.19+EXO.19.20+EXO.19.21+EXO.19.22"
              },
              "items": [
                {
                  "text": "Apud 19:16-22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
