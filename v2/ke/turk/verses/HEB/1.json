                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kainyo nyelimokina Akuj tani epei a ngimalaikae keng tama,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
