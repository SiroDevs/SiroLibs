                "loc": "JER.31.31+JER.31.32+JER.31.33+JER.31.34"
              },
              "items": [
                {
                  "text": "Yer 31:31-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni abala Akuj esechito ngitunga keng na alimunio tama,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
