          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokwap Sela, etorit ekukuor a Ngiedomae",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:36",
              "type": "text"
            },
            {
              "text": "Ngiedomae;",
              "type": "text"
            },
            {
              "text": "igiritae nakitab apei nangorot atamar Ngiedomae; igiritae Naeburaniae atamar Ngiamor.",
              "type": "text"
            }
          ]
        },
        {
          "text": " napak a Akirabim.",
          "type": "text",
