          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot ngitunga a ekitela a Naputal nyiiritasi ngitunga lu alomito lorerea a Bes Chemech ka Besanas. Apot ngitunga a Naputal kiboikinos aapei ka Ngikanaan ngulu nakaneni kidesikis akisub etich kech.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
