          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot ngitunga a ekitela a Acher nyiiritasi ngitunga lu alomito lorerea a Ako, ka Sidon, ka Alab, ka Akisib, ka Eliba, ka Apek, ta Reob. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot ngitunga a Acher kiboikinos aapei ka Ngikanaan ngulu kainyo apot nyiiritasi kesi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        }
      ]
    },
    {
