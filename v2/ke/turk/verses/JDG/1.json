        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot Ngiamor kijukasi ngitunga a ekitela a Dan nakwap na a ngimukur, sodi kiratakis kesi nyeetiyaunosi naroatin. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiboikinos Ngiamor lorerea a Aijalon, ka Chaalibim, ta moru a Eres, nakaneni apot ngitunga a Epiraim ka Manase topolokis kesi nabo kidesikis akisub etich kech.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        }
      ]
    },
