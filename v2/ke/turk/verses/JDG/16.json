          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pot talokaatokeng ka ngitunga a awi kech, luche tolemasi akwaan keng yaasi tanukakis kiding Sora ka Echitaol, naliel a Manoa alo arai apakeng. Arikit Samson Ngisirael a ngikaru a ngitomwon-arei.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
    }
