              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esi ngikiliok, tominakisi ngaberu kus nabo tochoito iliworosi lukaadengak anikech.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.19",
