          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyena atamar kiinakini Ekapolon Yesu esi ebachit lo idaritor ngesi ngitunga keng, kainyo Ekapolon Kiristo ngesi isubanakinete esi etich. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
