          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibore daang ni isubete esi, tosuba a ngitai kus kadaang, esibit etich a Ekapolon Yesu isubete esi, meere lo a ngitunga. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
