        },
        {
          "text": "Esi ngikauriak, warasi nyiiliworosi lu itililiyete ngide kus, kainyo ilounete kesi ngakiro ngitai.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.21",
            "verseOrgIds": [
              "COL.3.21"
