              "items": [
                {
                  "text": "1 Pet 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Esi ngaberu, kiwapa ngakiro a ngikiliok kus, kainyo ejoikina esi isubete kongina ani iraakatar ngakiristoi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
            "verseOrgIds": [
              "COL.3.18"
            ]
          }
        },
        {
