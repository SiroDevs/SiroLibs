          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni itwaan ni esubi naaronok, etachio itemem ka aronis keng, kainyo irirae Akuj itwaan daang a eger a epei.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.25",
