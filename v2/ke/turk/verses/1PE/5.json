              "1PE.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloger alopei kangolo, ejoikinit esi dang lusorok iwapete ngakiro a ngikasukou. Ejoikinit esi daang iliworosi lu itiditeuna ani eya luche sodi kingaranakinotor, kainyo igiritae nagiran a Akuj kona, “Itopegi Akuj lu iwogasi, nakaneni itaanyunit lu itiditeuna ajokis.” ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejoikinit robo esi itiditeunosi anakan a Akuj anakaagongon kingarakini, sodi kikeunea ngesi esi esaa lo esakitor ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.6",
            "verseOrgIds": [
              "1PE.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimiekineta ngesi ngichan kus daang, kainyo kiinakini ngesi esi ibore ni isakete.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosubakinos lokojokon, sodi tokienya irichuna! Kainyo irimit emoit kus Ekipe akwap loger a engatuny alo irurumae esaki itwaan ni enyami. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.8",
            "verseOrgIds": [
              "1PE.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warasi nyiilochokinosi ananupit kus sodi kitopega ngesi, kainyo iyenete esi atamar eanyunito lu eraakasi ngikanupak loger kus ngichan lu ikote lupei ngulu anakwapin kadaang. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.9",
            "verseOrgIds": [
              "1PE.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni ani kiboliare esi wadiochichi, Akuj na a ajokis kadaang, na kinyarae esi taanyut ekipur keng lo nyedaun ani imorikinotor aapei ka Kiristo, ngesi kitiliwori esi lu ikiuna, ka lu akigang, ka akitogogong ta akiturubakin igienosi Kiristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.10",
            "verseOrgIds": [
              "1PE.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emini agogongu nikeng jik! Aamen.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.11",
            "verseOrgIds": [
              "1PE.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emalas lo a esal",
          "type": "text"
        }
      ]
    },
