          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitunga daang lu aseuni Akuj kwa esi, kimalaate esi kane alo Babilon. Kimalae esi tani lokookang Mariko. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimalas niajokon kotere amina na ekiristoonu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
