            "number": "26",
            "style": "v",
            "sid": "2KI 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni tolimok Elicha ngesi tama, “Ikwa pekirukit ayong ka iyong alotau na atiyaunor itwaan ngini anaurukuk keng ana irito ngangolei kisiriam iyong a? Meere tokona akwaar naga nakidiaunet ngaropiyae ka ngiworui, kori ngamanat a ngikito a akimiet ka ngimusabib, kori ngamesekin ka ngaatuk, kori ngikasubak etich! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.26",
            "verseOrgIds": [
              "2KI.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitingi tokona iyong enomokere a Naaman toliwor ekon ka ngalesea kon jik!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
            "verseOrgIds": [
              "2KI.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
