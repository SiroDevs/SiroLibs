          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erotokini Geasi kaneni, todeakakin enomokere ngolo, tokwanger akwaan keng kea.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
            "verseOrgIds": [
              "2KI.5.27"
            ]
          }
