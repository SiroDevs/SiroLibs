            "number": "15",
            "style": "v",
            "sid": "2KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu emalaikat a Ekapolon Akuj tolimok Elija tama, “Kirukosi ka ngesi wara nyiem.” Abu Elija kirukosi ka ekarikon ngolo nia ekapolon Aasia, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "sodi tolimok ngesi tama, “Ebala Ekapolon Akuj kona, ‘Ani kona imearea iyong ngitunga akingitun ngakiro kon ani a Baalsebub ana erai akuj a ere a Ekiron, tosub emam Akuj na ingisi iyong ngakiro alo Isirael, kotere nguna, itoani iyong, nyijoker.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
