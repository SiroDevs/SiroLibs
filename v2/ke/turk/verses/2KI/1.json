          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomea ekapolon Aasia ekarikon eche arikit ngasigerea ngatomwon-kan, anyaraun Elija. Tolot",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:11",
              "type": "text"
            },
            {
              "text": "Tolot;",
              "type": "text"
            },
            {
              "text": "igiritae nakitab apei nangorot atamar tolot; igiritae Naeburaniae atamar tatachak.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ekarikon ngolo sodi tolimok Elija tama, “Itwaan a Akuj, kidungokinit ekapolon Aasia iyong atamar totiyaun.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
      ]
