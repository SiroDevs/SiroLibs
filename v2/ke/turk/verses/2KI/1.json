                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachakis kesi tamasi, “Anapit ngesi eleu a ngibaren, aenitae",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:8",
              "type": "text"
            },
            {
              "text": "Anapit ... aenitae;",
              "type": "text"
            },
            {
              "text": "kori arai ngesi itwaan niachakan a akwaan tanapite aruba namuny.",
              "type": "text"
            }
          ]
        },
        {
          "text": " a aruba anamuny.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim ekapolon Aasia tama, “Erai Elija lo a ere a Tichibe!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
