          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngirwa lu araakar ngesi ekapolon, kesi esiaunea Ekapolon Akuj tomea ekapolon Resin lo a Siria, ka ekapolon Peka lo a Isirael, esaki toremo Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
