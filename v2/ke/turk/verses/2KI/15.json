          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosechak ngesi Ekapolon Akuj kiwap ekitetemes loaronon a Yeroboam alo arai lokookeng a Nebat, alo arikokini Ngisirael akisech. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
