              "2KI.15.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.30"
              },
              "items": [
                {
                  "text": "2 Kapol 10:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eger ngolo ngesi eyookinor akichikakinet nakolong echikakini Ekapolon Akuj ekapolon Yeu ebala, “Eliworosi ngalesea kon ngikapolok a Isirael tanang nalesit na ngoomwon.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:12",
              "type": "text"
            },
            {
              "text": "nalesit na ngoomwon;",
              "type": "text"
            },
            {
              "text": "arai Sekaria etatait a Yeu lo a nguomwon.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chalum lo arai ekapolon a Isirael",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaru lo a ngitomwon-uni ka ngikan-koomwon lo araakar Usia ekapolon a Yuda, toliwor Chalum lo arai lokookeng a Yabech ekapolon a Isirael. Topolok ngesi Samaria a elap a epei.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyou Menaem lo arai lokookeng a Gadi alo Tirisa tanang Samaria, taar Chalum ani erumor kilunyokin nados keng toliwor ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakiro nache daang asubi Chalum, ka eger lo atukio ngesi akiar ekapolon, igiritae nakitab na enyaritae Ngakiro a Ngikapolok a Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani enyouni Menaem alo Tirisa, kinyasu ere a Tapua",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:16",
              "type": "text"
            },
            {
              "text": "Tapua;",
              "type": "text"
            },
            {
              "text": "igiritae nakitab apei nangorot atamar Tapua; ani Anaeburaniae, erai Tipisa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka ngitunga a ere kangolo ta ngakwapea na edunyatar, kainyo awounete ngitunga a ere kangolo angaar ekidor a ere. Abu ngesi tani topuwono ngakokies a ngaberu ana apotiyete.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Menaem lo arai ekapolon a Isirael",
          "type": "text"
        }
      ]
    },
