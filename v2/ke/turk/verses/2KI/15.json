              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosub Yosam ngakiro na ajoikinito Ekapolon Akuj, ani ewapitor ekitetemes a apakeng. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
