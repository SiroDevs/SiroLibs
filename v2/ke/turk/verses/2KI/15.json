              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakiro nache daang asubi Yosam, igiritae nakitab na enyaritae Ngakiro a Ngikapolok a Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
