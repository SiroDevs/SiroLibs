            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirarete Ngimoab atamar eponito ngikapolok luuni akirem kesi, apon tanyaraunae ngitunga daang lu epedorete akiting ngiboro lua ejie, napei aluuchik tanang luapolok, sodi kiriwokinae kesi lokukuoru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.21",
            "verseOrgIds": [
              "2KI.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ekienyunete Ngimoab ataparach nache, kingolikis ngakipi imakinit akolong itusubunit erengak ngaakot. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.22",
            "verseOrgIds": [
              "2KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tachalut kesi tamasi, “Erai ngaakot! Kejwoto ngikapolok luuni ngulu make taaras! Potu apana inaa atangatasi ngiboro!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
