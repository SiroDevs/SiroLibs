              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot ngibukui ngulu kilipa Ekapolon Akuj, ka ngakujo kech dang. Eringa tani tokona ngide kech ka ngalesea kech ilipito Ekapolon Akuj loger lopei ngolo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
      ]
