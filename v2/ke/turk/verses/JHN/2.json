          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingita ngikapolok a Ngiyaudi Yesu tamasi, “Ani kitoodikinet nakaililon isubakini iyong kidodik sua atamar kichamakinitae iyong dir isubi ngakiro nugu?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        }
      ]
