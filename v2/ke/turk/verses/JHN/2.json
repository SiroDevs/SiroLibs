          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingita kesi ngesi tamasi, “Ekoe! Akai na adukio a ngikaru ngitomwon-omwon ka ngikan-kapei, ngesi ibala iyong idukokini a ngirwa a nguuni a?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
              "JHN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
