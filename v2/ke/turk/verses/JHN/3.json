                "loc": "LUK.3.19+LUK.3.20"
              },
              "items": [
                {
                  "text": "Luk 3:19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngirwa ngulu, aringa Yoana nyeenikina lojela).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.24",
            "verseOrgIds": [
              "JHN.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.24",
            "verseOrgIds": [
              "JHN.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolomakis ngirukitos ngiche a Yoana apega ka Eyaudit epei kotere ngakiro a etal alo ilotare. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.25",
            "verseOrgIds": [
              "JHN.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.20"
              },
              "items": [
                {
                  "text": "Yoa 1:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi toloto nia Yoana tolimokis tamasi, “Eketataman, itamunit iyong itwaan ningoon iyakasi ka iyong ekwakaye a angolol a Yorudan, dio kiruor iyong ngakiro keng a? Abe ibatisae ngesi ngitunga tokona, nabo alot ngitunga daang nikeng!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.26",
            "verseOrgIds": [
              "JHN.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.26",
            "verseOrgIds": [
              "JHN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Yoana tama, “Emam itwaan eriamuni ibore pearai ni einakini Akuj ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.27",
            "verseOrgIds": [
              "JHN.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyenete esi ngikulepek atamar alimuni ngoon ayong sek atama, ‘Meere ayong Kiristo, nakaneni kameunio ayong engareniu ngesi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.28",
            "verseOrgIds": [
              "JHN.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeutan ngesi elope a ateran, nakaneni elakar lopae keng a ekeutan na epupio ekeutan iruoro. Nguna kesi etemokis alakara kang. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.29",
            "verseOrgIds": [
              "JHN.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejoikinit ngesi eyenikinio dio atoliwor ayong lo nyekayenikinitae.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.30",
            "verseOrgIds": [
              "JHN.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngolo ebunit Anadis",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.30",
            "verseOrgIds": [
              "JHN.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo ebunit alokidiama, epolot noi idwangit daang. Lo ebunit anakwap, erai eboyor keng eka akwap, nabo iruoro ngakiro a akwap. Ni ebunit anadis ngesi epolokinit daang. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.31",
            "verseOrgIds": [
              "JHN.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iruoro ngesi na engolik ka na eira, nakaneni emam itwaan tani ipei ni echamunit ngakiro keng. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.32",
            "verseOrgIds": [
              "JHN.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni itwaan cha daang ni echamunit ngakiro keng, idodiunit ngesi atamar Akuj ngesi erai aka iteni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.33",
            "verseOrgIds": [
              "JHN.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iruoro lo ameuni Akuj ngakiro a Akuj, kainyo ilelebi Akuj ngesi Etau keng peitemit. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emina Apa Lokookeng, nabo ainaki ngesi ibore daang. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.27"
              },
              "items": [
                {
                  "text": "Mat 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.22"
              },
              "items": [
                {
                  "text": "Luk 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni enupit Lokookeng eyei ngesi akiyar na nyedaun, ni nyenupit Lokookeng nyeanyuni akiyar, nakaneni emini anyunyura a Akuj nikeng.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        }
      ]
    }
