            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayei atubwa neni na eleleba emuna lo epuritoe loadwaran, sodi kirepakis ibore niyebuk tooma emuna loadwaran ngolo, nabo todupakis ibore ngini ngaren akitoe a isopo,*g** kikekis ngesi kiwaakis lopon keng. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani emasi Yesu emuna loadwaran ngolo, tolim ngesi tama, “Arumor.” Sodi kijuuru totoan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
