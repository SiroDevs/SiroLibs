          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor, tolimok Yesu erukitos ngolo tama, “Kingolik a, itiokon naga.” Napei ngina jik, toriko erukitos ngolo akimat ngina nawi keng.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        }
      ]
    },
