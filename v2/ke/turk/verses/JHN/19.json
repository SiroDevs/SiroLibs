              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.46"
              },
              "items": [
                {
                  "text": "Apud 12:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.12"
              },
              "items": [
                {
                  "text": "Ekim 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.20"
