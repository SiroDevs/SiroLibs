              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor ngakiro nguna, tolot Yosep lo arai itwaan a akwap ka Arimatea nia Pilato atamar asaki akwaan a Yesu. (Arai Yosep a Yesu nakaneni peayenete ngitunga kainyo aemit ngesi ngikapolok a Ngiyaudi.) Tolimok Pilato ngesi atamar tolema akwaan a Yesu, sodi tolot ngesi tolema. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirukosi Nikodemo ka Yosep, Nikodemo ngolo ngesi lokolong abunit nia Yesu nakwaare. Atingit ngesi ngakiloi esibit ngatomwon-uni a echuchuka ka ekinyaate lokaakunyon emorikina wapei. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
