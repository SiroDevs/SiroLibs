          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.21",
            "verseOrgIds": [
              "JHN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Pilato tama, “Egir ayong nguna loger lo egir.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        }
      ]
    },
