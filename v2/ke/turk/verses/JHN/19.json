              "items": [
                {
                  "text": "Eosio 34:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabo igiritae ngagiran ngache kona, “Ingolikinete ngitunga ngesi lokolong echumete.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
