                  "text": "Yoa 13:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na engolikinea Petero erukitos ngolo, kingit Yesu tama, “Ekapolon, ani bo logo, ikokini ai?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
