                "loc": "LEV.24.16"
              },
              "items": [
                {
                  "text": "Lawi 24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachakis tamasi, “Nyikisaki sua akimas iyong a ngamoru a etich a loajokon, pearai kisaki akimas iyong ani imenya iyong Akuj! Abe irai bo iyong itwaan, nyo isakea iyong aliwor Akuj!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.33",
            "verseOrgIds": [
              "JHN.10.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
