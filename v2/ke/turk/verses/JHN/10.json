                {
                  "text": "Yoa 1:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tasaka kesi nabo akirumun Yesu, nakaneni tobuchar ngesi anikech.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
