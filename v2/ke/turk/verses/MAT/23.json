              "items": [
                {
                  "text": "Yer 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kalimokinit esi atamar, napei tokona jik, nyikingolikinete esi ayong nabo tanang akolongit na itamareta: ‘Epiarit Akuj ngolo ebunit a ekiro a Ekapolon.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
