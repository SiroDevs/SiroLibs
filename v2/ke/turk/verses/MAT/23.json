              "items": [
                {
                  "text": "Luk 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kalimokinit ngakiro na iteni dir atamar, irirao ngitunga a ngirwa kalu kotere nguna daang! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.36",
            "verseOrgIds": [
              "MAT.23.36"
            ]
          }
        },
        {
