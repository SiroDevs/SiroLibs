              "items": [
                {
                  "text": "Mat 5:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kori ani kikong itwaan Adis, ekong ngesi ekicholong a Apolou a Akuj kangina ibooyi kaneni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.22",
            "verseOrgIds": [
              "MAT.23.22"
            ]
          }
        },
