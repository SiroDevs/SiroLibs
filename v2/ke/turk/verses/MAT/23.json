                "loc": "MAT.6.1"
              },
              "items": [
                {
                  "text": "Mat 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.38"
              },
              "items": [
                {
                  "text": "Ekim 15:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.8"
              },
              "items": [
                {
                  "text": "Etal 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kainyo itwaan cha daang ni itopolouno, itiditeunio, ani ni itiditeuna, itopolounio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.12",
            "verseOrgIds": [
              "MAT.23.12"
            ]
          }
        },
