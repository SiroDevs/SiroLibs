          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wae! Ngitunga a Yerusalem! Ngitunga a Yerusalem lu iarete ngikadwarak a Akuj nabo kimasa ngimeanara lu ameuni Akuj nikus a ngamoru! Ngiai ngirwa asakea ayong akilogakin ngakan kang lotunga kus daang, loger lo iudanakinea akokoroit ngitak keng tooma ngabeben keng, nakaneni nyechamuna esi asubi ayong kongina! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemiekinea tokona ayong esi akai kus ibooyi kongin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
