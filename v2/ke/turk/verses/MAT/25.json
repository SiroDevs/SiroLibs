              "items": [
                {
                  "text": "Luk 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani eliwor ekasuban etich lo erai pas lo, tochakasi ngesi nikalapatan naribu, kigor kaina tokirich ngikel.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        },
        {
