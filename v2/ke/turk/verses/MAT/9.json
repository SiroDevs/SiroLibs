                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.15"
              },
              "items": [
                {
                  "text": "Luk 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni tamasi Ngiparisayo, “Erai lokapolon a ngipean eanyunitor ngesi agogongu na itwaranakinea ngipean.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esieniyete Yesu ngitunga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erimit Yesu ngirerea daang ka ngadakarin. Etatami anakais a Atuk kech Ngakiro Naajokak a Apolou a Akuj. Nakaneni etangalenokini ngidekesinei ka ngilekesinei daang alotunga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na engolikinea ngesi asepich a ngitunga, kisienoto kesi ngesi noi ani echanatar tamam kona ingarakinotor, loger a ngamesekin ana emam ekeyokon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolimok ngesi ngirukitos keng tama, “Elalak ngalemet, nakaneni ekidioko ngulu esubete etich. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.23"
              },
              "items": [
                {
                  "text": "Mat 4:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.39"
              },
              "items": [
                {
                  "text": "Mar 1:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.44"
              },
              "items": [
                {
                  "text": "Luk 4:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kilipa robo elope a ngalemet tomea ngikalemak lukaalak lu echunakinete ngalemet keng.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.38",
            "verseOrgIds": [
              "MAT.9.38"
            ]
          }
        },
