          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Petero ngesi tama, “Ngitunga a akwap anache.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
              "MAT.17.26"
            ]
          }
        }
      ]
