          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Petero kesi tama, “Ee, ebukeene.” Naalomarea Petero kai, kiruorik Yesu ekingaren tama, “Simon! Esibit iyong kwaai? Ngae ebuki echur a ngikapolok a ngakwapea kanu? Ngikulepek a akwap kori ngitunga a akwap anache?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        }
      ]
    },
