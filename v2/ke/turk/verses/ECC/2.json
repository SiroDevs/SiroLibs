        },
        {
          "text": "Ibore niajokon noi anitwaan ngesi akimuj, tamat, sodi talakar alotich keng. Ayen atamar eponito nguna dang ani a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.24",
            "verseOrgIds": [
              "ECC.2.24"
            ]
