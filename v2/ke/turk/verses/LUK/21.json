        "style": "s1"
      },
      "items": [
        {
          "text": "Akitatama ngakiro a emeyen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
