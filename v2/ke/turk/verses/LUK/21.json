          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebuli ngitunga niaronon idarito ngakiro na epote nakwapea daang, kainyo emaranikini agogongu daang nakaanikan ka na eyei kidiama. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
