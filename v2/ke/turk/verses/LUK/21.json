              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngirwa ngulu, etatami Yesu jiik alokai a Akuj, ani naewaria topudo ngesi tolot akiper moru a ngikito a akimiet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloseenete ngitunga daang nataparach kai a Akuj akipup ngakiro keng.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
            ]
