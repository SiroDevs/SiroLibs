          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi etakanuni Lokookeng a Itwaan kingolikinae ngesi ebunit alotooma ngidowon ka agogongu naapolon ta akwangis a apolou. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
