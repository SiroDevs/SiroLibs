            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.9"
              },
              "items": [
                {
                  "text": "Mar 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.1"
              },
              "items": [
                {
                  "text": "4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Toloma Yesu natubwa apei, na arai aka Simon, tolimok ngesi tama, “Kijuka tachadar a lokwaas wadio. Kiboikin Yesu natubwa kitatam ngitunga.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.3",
            "verseOrgIds": [
              "LUK.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
