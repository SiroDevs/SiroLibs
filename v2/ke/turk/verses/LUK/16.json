                "loc": "MAT.5.32"
              },
              "items": [
                {
                  "text": "Mat 5:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10+1CO.7.11"
              },
              "items": [
                {
                  "text": "1 Kor 7:10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Itwaan daang ni elaki aberu keng, sodi kiut aberu ache, aliwor ekaloman asechaki aberu keng. Ekile lo iusi aberu nakolong alak lokile keng, erai ekaloman.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekabaran ka Losaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ayei kolong itwaan ni abarit, tanapite ngiworui lukaanikak esiritoe, kibooye ejakaana, elakara ngirwa daang. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.19",
            "verseOrgIds": [
              "LUK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayei neni dang ekebootonit lo anyaritae Losaro. Erikarito ngesi ngajemei akwaan daang korot, arikununio ngesi lokidor a itwaan anikabaran kangini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.20",
            "verseOrgIds": [
              "LUK.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitanit ngesi akinyam akimuj na achakuunun alomeesa a ekabaran kangolo. Aponeenete tani ngingokwo akime ngajemei keng. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.21",
            "verseOrgIds": [
              "LUK.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ekebootonit ngolo totoan, sodi yaasi ngimalaikae ngesi kiboikin diyete Aburaam, anadis. Abu ekabaran dang totoan, sodi tomurae. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.22",
            "verseOrgIds": [
              "LUK.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariaba ngesi noi lokojokon ani ayakasi ngikatoak. Nakaneni kingolia ngesi kidiama taanyunga Aburaam anialonan noi, ka Losaro irudakina diyete keng. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.23",
            "verseOrgIds": [
              "LUK.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolomak anyarit ebala, ‘Apa Aburaam, kisieni kare ayong! Tomeu Losaro kilumok ekimoin keng nakipi ngadi, sodi kitililim angajep kang, kainyo kapipilikinit ayong noi akim na!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.24",
            "verseOrgIds": [
              "LUK.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni abu Aburaam tolimok ngesi tama, ‘Lokooku, toyen atamar ibooyi kolong iyong niajokon iriamunit ibore daang, toriamunete Losaro ibore daang niaronon, ejakaana tokona ngesi kanege, nakaneni iyei iyong lochan iriaba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.25",
            "verseOrgIds": [
              "LUK.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanguna kadaang, eyei nege aaut nakooyen na iriwokina kiding yok, sodi ngulu esakete atamar kirotokini kane apotu nikus, nyepedorete, kori lu esakete aponere kaina nikosi ne, nyepedorete.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.26",
            "verseOrgIds": [
              "LUK.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak ekabaran ngolo ngesi tama, ‘Nakaneni kemaimai cha ayong iyong apa Aburaam atamar tomea Losaro nawi ka apa kang, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.27",
            "verseOrgIds": [
              "LUK.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni eya talokaato kang lukan: kimiek ngesi tolot kichikichik kesi atamar nyeepot nanam na a akim ka ariaba naga.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.28",
            "verseOrgIds": [
              "LUK.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Aburaam ngesi tama, ‘Eya talokaatokon etal a Musa ta ngagiran a ngikadwarak a Akuj, kimiek talokaatokon kiirasi anikech.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.29",
            "verseOrgIds": [
              "LUK.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak ekabaran ngolo tama, ‘Nyitemokino nguna apa Aburaam! Nakaneni ani kelot itwaan idio ni ayaru anakitu nikech, iteni eisikinete kesi ngasechesea kech.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
              "LUK.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Aburaam ngesi tama, ‘Ani pekiirasi Musa ka ngikadwarak a Akuj, nyepedorete akinup tani keyaru itwaan anakitu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.31",
            "verseOrgIds": [
              "LUK.16.31"
            ]
          }
        }
      ]
    }
