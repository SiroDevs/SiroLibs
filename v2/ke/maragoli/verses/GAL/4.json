            "number": "27",
            "style": "v",
            "sid": "GAL 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.27",
            "verseOrgIds": [
              "GAL.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GAL 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu munyi avaamitu vange, muveeye avana va Nyasaye kuli mativuli gi lisuuvirizwa lilie, kuli Isaka yaali. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.28",
            "verseOrgIds": [
              "GAL.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GAL 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ing'inga yeyo uyu mwana uwivulwa munzira ya kase yadambiza oyo uwivulwa kigira Roho wa Nyasaye, kandi gaveeye malala mere kalunu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.29",
            "verseOrgIds": [
              "GAL.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GAL 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Mang'oda Matakatifu gavoora ki? Gavoora, “Kunga mukali mutugwa harara nu mwana weve kigira mwana wu mukali mutugwa si alanyoola ku miandu ja baba weve harara nu mwana wu mukali muvoholore mba.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.30",
            "verseOrgIds": [
              "GAL.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GAL 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa, avaamitu vange, kunyi sikoveeye avana vu mukali mutugwa mba, navuzwa avu mukali muvoholore.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.31",
            "verseOrgIds": [
              "GAL.4.31"
            ]
          }
        }
