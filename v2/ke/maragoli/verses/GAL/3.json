          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi vosi avabatizwa mu lihambanywa harara na Kristo, kandi mumali kuva kuli Kristo mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
