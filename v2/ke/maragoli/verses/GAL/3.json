              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi vosi muveeye avana va Nyasaye kuvitira mu lisuuvira mu lihambanywa na Kristo Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
