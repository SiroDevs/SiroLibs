          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulwayago, sihaveeyeho kandi ni liavukana hagati ha Avayuda na vandu vizihiiri, mutugwa nu muvoholore anoho musaza nu mukali kandi mba. Vosi muveeye kindu kilala mu lihambanywa na Kristo Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
