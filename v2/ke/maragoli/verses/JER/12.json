        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia Yilirira ku Yahova Amuteva",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
