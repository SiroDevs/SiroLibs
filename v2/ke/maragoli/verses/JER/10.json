              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, munyi avandu va Isiraeli, muhuliri makuva ga Yahova amuvoleraa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.1",
            "verseOrgIds": [
              "JER.10.1"
            ]
          }
        },
