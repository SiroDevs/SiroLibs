          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa muvavoolere: “Avanyasaye yava avavura kolomba ligulu ni lirova navadivi kutura mu lirova kandi isi wiligulu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.11",
            "verseOrgIds": [
              "JER.10.11"
            ]
          }
        }
