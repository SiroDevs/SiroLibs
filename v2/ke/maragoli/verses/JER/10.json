          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Jerusalemi, munyi mumali mukumbelizwiyi! Muvungizi harara ivindu vienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.17",
            "verseOrgIds": [
              "JER.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
