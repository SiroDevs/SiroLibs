            "number": "18",
            "style": "v",
            "sid": "JER 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova azizaa kumusiuva ichova wikivala yiki; alamusionolanyia kali mulala kumunyi sialatigala mba. Yahova umali kovora.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.18",
            "verseOrgIds": [
              "JER.10.18"
            ]
