          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova avoora, “Madiku gaaza, lwa ndihaana mageri ku yavo vosi avakevwa vuzwa kuligodo - ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Egebeti, Ivuyuda, Edomu, Amoni, Moabu kandi avandu avamenyaa muchangalangwe nivivala vie ihale. Kigira izihiiri yizi ziosi nagiligali siziakevwa mba, kandi kali avandu vosi va Isiraeli sivakevwa mumwoyo mba.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
