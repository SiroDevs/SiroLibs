          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi ndaateva, “Yahova, kigira ki kivala chasambwa kandi chayumba kuli changalangwi, kunangwa umundu kali mulala sianyala kuvitiramu mba? Nivwaha oveeye umugeri kumanyiriza yaga? Nivwaha wawavoolera yaga kunangwa aduuki kovoolera avandi?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
