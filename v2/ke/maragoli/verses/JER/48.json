        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.46",
            "verseOrgIds": [
              "JER.48.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JER 48:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa mu madiku gaaza Yahova alilanyila Moabu uvutugi kandi. Yaga goosi nigo aga Yahova amali kovora ndi, galakoleka ku kivala cha Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.47",
