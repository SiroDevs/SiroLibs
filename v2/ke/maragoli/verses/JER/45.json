              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa kane lwa Jehoyakimu mwana wa Josia yaali mwami wi Ivuyuda, Baruki yang'oda aga inzi ndaali nimuvoleeye. Kunangwa ndaamuvolera ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi, Yahova, Nyasaye wa Isiraeli, yaali navooye, “Baruki, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivi ovola, ‘Inzi ndeke! Yahova amali komeeda ovovereri ku uvudinyu vwange. Inzi nduhi kigira likenya, kandi sinyala konyoora ovososi mba!’",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        }
      ]
    },
