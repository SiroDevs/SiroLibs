{
  "id": "JER.22",
  "number": "22",
  "bookId": "JER",
  "reference": "Jeremia 22",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
