              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Niiva musaza yagana nu mukaana mugima utateevwa kandi namugumira kuzinguru no kogona naye, ma vanyooleke, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
