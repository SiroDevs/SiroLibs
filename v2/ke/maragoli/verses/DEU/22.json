          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Navuzwa niiva musaza anyoora mukaana wateevwa nu kukwevwa mumbulimu ihale wi lidaala, kandi namugumira nokogona naye kuzinguru, musaza wakola inguuva yiyi aliitwa yeng'ine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utakola kindu ku mukaana oyo mba, kigira siakoli uvwoni uvugira yiitwi mba. Amakuva yaga gaveeye vuzwa kuli agu mulala wingiliraa nukwita mutende. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaza zana yagumira mukaana kuzinguru naagona naye; lwu mukaana yakuba zikwiri, sihaali ho numundu wamusola mba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
      ]
    },
