          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "alatungaa baba wu mukaana vukwi vwi vidonye amusini viefeza. Kuduuka amuleete kuva mukali weve, kigira yamala kumwonogonyia. Sialamukunga madiku gi livamwoyo lilie liosi mba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
