          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "hene yaho vombi valahirwa ichova wi lidaala na valaswe amagina, vakuzi. Mukaana alakuza kigira siyaakuba zikwiri akonywe kali niyaali mu lidaala mba. Kandi musaza alakuza kigira yonogonyi mukali wu musaza wundi. Munzira yiyi, mulatuliza uvudamanu yivu hagati hinyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
    {
