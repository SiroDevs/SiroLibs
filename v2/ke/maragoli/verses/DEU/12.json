    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Havundu, hukusigamira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yaga nigo malago agadukanaa mulonde muhuliri madiku goosi ga muveeye mwoyo mu kivala cha Yahova Nyasaye wa vaguuga vinyu amuhezaa mugalonde. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamudukira ligali havundu hoosi ha avandu vi zihiiri zindi vaasigamira avanyasaye vaavo ku vigulu vitambi, nokutugulu kandi isi wi misaala mivisi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.2",
            "verseOrgIds": [
              "DEU.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saambuli vwali vwavo, mwononyie ligali minaara mitakatifu jaavo ja magina, musaambe vifananyi viavo viu munyasaye wikikali Ashera kandi mutemanyie vifananyi viavo, kunangwa valavuli kuvisigamira kandi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutasigamiri Yahova Nyasaye winyu kuli avandu yava vasigamira avanyasaye vaavo mba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutura mu kivala chi zihiiri zienyu ziosi, Yahova alatovola havundu harara haduukana avandu vosi vazie imbiri weve nu kumusigamira ho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulahila yo visiuviliru vienyu viu kusambwa nivisiuviliru vienyu vindi, nezizaka zienyu nevihaanwa vienyu viduukiru, nevihaanwa viamwalagana na Yahova, vihaanwa viuvwihaani kandi vihaanwa viukutanga ivivulwa mu viayo vienyu vie zing'ombe kandi viamangodi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.6",
            "verseOrgIds": [
              "DEU.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazana yaho, Nyasaye winyu, umali kumugaasiza, munyi harara na avizinyumba zienyu, mulalira nokusangalira vindu vilahi viamumali kuyinzira aku vudinyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lwing'inga yeyo iduuka, mutakolaa kuli mwakolangi mba. Kuduuka kalunu, munyi mwosi mwasigamiraa Yahova vuzwa kuli muyanzaa ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.8",
            "verseOrgIds": [
              "DEU.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kigira mukikiri kwingira mu kivala cha Yahova Nyasaye winyu amuhezaa, uwa mulimenya mumirembe kandi mumuvwelemerizi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa mwambuka mugera gwa Jorodani, Yahova Nyasaye winyu alaleka muvuguli kivala zana kuva miandu kandi mulamenya yo. Alamukinga kutura ku vasigu vinyu vosi na mulamenya mu ni mirembe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova Nyasaye winyu alatovola havundu harara heng'ine haduukana, ha asigamirwa, kandi ahene yaho, kuduuka muleete ho kuye vindu viosi via inzi mali kumulaga: visiuviliru vienyu viukusambwa kandi visiuviliru vienyu vindi, zizaka zienyu kandi vihaanwa vidukiru via mwalagana na Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musangaliri uwene yeyo imbiri wa Yahova Nyasaye, munyi harara na avana vinyu vayaayi na vakana, avatumikiri vinyu vasaza na vakali, kandi vandu vinyumba ya Levi sivalava ni milimi jaavo aveene mba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwilindi gase mulahaana visiuviliru vienyu viu kusambwa vuli havundu hoosi ha muloraa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.13",
            "verseOrgIds": [
              "DEU.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuduuka muvihaane vuzwa havundu harara heng'ine ha Yahova alitovola mu kivala kilala chi zihiiri zienyu aveene. Hazana yaho niho aha muhaanira visiuviliru vienyu viu kusambwa, kandi mulakolera ho goosi aga ndamulaga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Navuzwa muveeye avavoholore ukwita nu kulira zinyama zienyu hoosi ha mumenyi. Munyala kulia zinyingi kuli Yahova Nyasaye winyu amuha. Munyi mwosi, avalahi na vadamanu kolondekana ni miruka jidiini, munyala kulia inyama ye embongo ni inyama yi kisusu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa mutatumikira masahi gazio kuli chukulia mba; kuduuka mugasundule ichova ku marova kuli amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaliira ku vihaanwa via muhaanaa ku Nyasaye mu madaala ginyu aha mumenyi mba: kali niiva izaka yuvuswage vwinyu anoho iwaini yinyu, anoho ya maguta gamuzeituni, anoho mitugu jitanga kwivulwa jie zing'ombe anoho magondi, anoho vihaanwa via mwalagana na Yahova anoho vihaanwa vienyu viu vuyanzi anoho vihaanwa vienyu vindi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi harara na avana vinyu, vatumikiri vinyu harara na vandu vinyuma ya Levi avamenyi mu madaala ginyu kuduuka muliri vihaanwa vienyu imbiri wa Yahova Nyasaye winyu havundu harara heng'ine hatovolwa kusigamira Yahova Nyasaye winyu. Mulasangalira uwene yeyo imbiri wa Yahova Nyasaye winyu ku viosi viamumali kokora. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhenze vulahi ligali, gase mulaleka vandu vinyumba ya Levi mu madiku goosi ga mumenya mu kivala chienyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lwa Yahova, Nyasaye winyu, avambalaliza kivala chienyu kuli yamusuuviriza muveeye vavoholole kulia inyama kuli munyala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva havundu harara hukusigamira yaho haveeye ihale ligali kutura ku munyi, maku, lwa muva nimwenya inyama, munyala kwita ndala ku zing'ombe anoho magondi ga Yahova amali kumuha, kandi munyala kulira inyama zana hango, kuli mali kumuvolera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu woosi, oveeye mulahi anoho mudamanu kolondekana ni miruka jidiini anyala kulia inyama yeyo, kuli anyala, inyama yikisusu anoho ye embongo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalia inyama na masahi gakiri mu mba, kigira livamwoyo liveeye mu masahi; kandi mutalia livamwoyo harara ninyama mba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.23",
            "verseOrgIds": [
              "DEU.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalia masahi yago mba. Mugasunduli ichova ku marova kuli amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.24",
            "verseOrgIds": [
              "DEU.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimulonda lilago yili, Yahova alayanzizwa na goosi galava malahi ku munyi harara ni visukululwi vienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuguli zisadaka zienyu ni vihaanwa viosi via mwalagana kuhaana ku Yahova, muhiri havundu hukusigamira Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhaane visiuviliru vienyu viu kusambwa viduukana kusaambirwa ku uvwali vwa Yahova. Amasahi gi visiuviliru vienyu kuduuka guufwi ku vwali vwa Yahova Nyasaye winyu; navuzwa munyala kulia inyama. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwilindi kandi muhuliri malago ga muheezaa yaga, kunangwa muduuki kuva vulahi harara ni visukululwi iviizaa inyima winyu mihiga ni mihiga, kigira mulava nimukoraa agaveeye malahi kandi gukuyaanzi Yahova, Nyasaye winyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
