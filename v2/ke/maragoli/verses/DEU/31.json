              "DEU.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Musa yimba ulwimbu yilu lwosi, avandu vosi va Isiraeli nivahulirizaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
            "verseOrgIds": [
              "DEU.31.30"
            ]
          }
        }
      ]
