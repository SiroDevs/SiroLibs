{
  "id": "MAL.2",
  "number": "2",
  "bookId": "MAL",
  "reference": "Malaki 2",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
