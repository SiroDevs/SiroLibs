{
  "id": "2CH.9",
  "number": "9",
  "bookId": "2CH",
  "reference": "2 Zing'Inga 9",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
