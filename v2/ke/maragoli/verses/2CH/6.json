          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lwa ugumira imbura ivuli kukuba kigira avandu vovo vamali kokokolera uvwoni, ma kandi lwa viganiraa nokoheenza Litembeli yili, nivakusaala mu liegehiza, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, Yahova, hulira lisaala liavo mwigulu ma usamihi uvwoni vwa vatumikiri vovo, avandu va Isiraeli ma uviigize vakole agaveeye malungi. Hene yaho, O, Yahova, tuma imbura ku kivala chicho cha waha avandu vovo kuli miandu ji mihiga ni mihiga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
