            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viju viosi vie izahabu kandi ifeza viali 5,469, via sheshebaru yavugula harara na vandu vi lihaminywa kutura Babiloni kuzia Jerusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
