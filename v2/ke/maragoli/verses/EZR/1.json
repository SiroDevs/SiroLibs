            "number": "1",
            "style": "v",
            "sid": "EZR 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwu kutanga gwa Sairasi yaali mwami wa Pasia, Yahova yaduukiza agayaali navooye kuvitira ku muporofeti Jeremia. Yakola Sairasi kuhaana lilaga yili kandi aviiki mu mang'oda nu kugatuma galandizwi havundu hoosi mu vwami vwivwe:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku aviimiliri vi zihiiri zie Ivuyuda kandi Benjamini, avasaalisi na vandu va Levi, kandi vosi ava Roho wa Nyasaye yaayugiza, vetegeka kuzia kwumbaka uvuhia Litembeli lia Yahova mu Jerusalemi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avatende vaavo vavakonya ni viju vie ifeza, izahabu, uvutugi, kandi imitugu harara ni viju vindi viu vuguli ovonene, komeeda ku viosi viavaali nivanyooye maziambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Sairasi kandi yiranyia viju vie Litembeli lia Yahova viu mwami Nebukadineza yaali nagingi kutura Jerusalemi navihili kuviviika mu Litembeli lia vanyasaye veve. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Sairasi yavugula viju yivi nahaana ku Miziredazi mulindi wi livikiru. Miziredazi yavaliza viju yivi ma nahaana ku Sheshibazari mwamihi wi Ivuyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Livaliza lie viju yivi viali kuli ndi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
