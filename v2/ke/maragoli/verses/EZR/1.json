        "style": "s1"
      },
      "items": [
        {
          "text": "Mwami Sairasi alaangaa Avayuda kwirana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
