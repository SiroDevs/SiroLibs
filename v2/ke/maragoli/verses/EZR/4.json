          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miyinzi ku Litembeli jaali nijimali kolekelizwa kuduuka mu muhiga gwa kaviri gwi liamiiha lia Daria mwami wa Pasia.",
          "type": "text",
          "attrs": {
