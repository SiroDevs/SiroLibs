          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonoho lwa ibarwa kutura ku mwami Aritasakises yasomwa imbiri wa Rehumu, Shimushai, navache, vazia vwangu Jerusalemi nivaniga Avayuda kolekera kwumbaka vuhia lidaala linene.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Litanga lie Miyinzi ku Litembeli",
          "type": "text"
        }
      ]
    },
