          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumu munene wi liihi, kandi Shimushai mung'odi wi kivala, yang'odera mwami Aritasakises ibarwa yiyi kigira Jerusalemi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
