            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu liamiiha liu mwami Aritasakises wa Pasia, Bishilamu, Miziredazi, Tabeeli, kandi navache vaavo vang'odera mwami ibarwa. Ibarwa yiyi yang'odwa mu lulimi lwa Vaharabu ma nigirung'anywa lwa yasomwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
