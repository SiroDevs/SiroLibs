          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Yuda yavimanyiliza ma navoora, “Avooye ga giligali. Genyekana inzi mbugiliri muyaayi wange Shela amuleete.” Yuda si yagona naye kandi mba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
