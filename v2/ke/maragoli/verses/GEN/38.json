            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vaali nivamuhila ichova, yatumana mang'ana vavoolere navizara weve: “Umundu mwene vindu yivi niyie wamba inda. Ohenze ku ma olole niviavwaha: imingiri nu muhuri kandi nimbimbu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
