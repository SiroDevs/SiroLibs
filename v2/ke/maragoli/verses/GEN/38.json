          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimbi inyima wi mieli jivaga mundu yavolera Yuda, “Navizara woovo Tamara yakolangi vulaya, na kalunu yavereka.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
      ]
