            "number": "46",
            "style": "v",
            "sid": "GEN 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabeka yavolera Isaka, “Inzi mbihirirwa na vakali avageni vi kivala cha Hiti. Niiva Yakobo alaleeta mukali mulala ku vakali yava, vwakaveeye vulahi inzi kukuza.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
