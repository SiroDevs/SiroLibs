        },
        {
          "text": "Yaga namita agivisukululwi via Adamu. Lwa Nyasaye yalomba umundu, ya mulomba mulifwana lilie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
