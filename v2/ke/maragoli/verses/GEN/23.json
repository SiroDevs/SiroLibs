        "style": "s1"
      },
      "items": [
        {
          "text": "Likuza Kandi Liyavirwa lia Sara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
