          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.20",
            "verseOrgIds": [
              "GEN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Yahova Nyasaye yaaha umundu zindolo zinyingi, kandi lwa yaali naakegona, yaatuliza ruvalu lulala liu mundu kandi niyiranyia ho inyama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.21",
            "verseOrgIds": [
              "GEN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalomba mukali kutura ku ruvalu kandi naamuletela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.22",
            "verseOrgIds": [
              "GEN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku umundu yavoola,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
