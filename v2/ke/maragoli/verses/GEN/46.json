          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Josefu yavolera avamwavo veve kandi navandi vosi avinyumba ya baba weve, “Inzi kuduuka nzie kovoolera mwami ndi avamwavo vange kandi avinyumba ya baba wange vosi, avaamenyaa mu Kanaani, vamali kuza ku inzi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi ndamuvolera ndi munyi muveeye avayi. Munyi mulinda mitugu kandi mumali koleta viayo ni mitugu jiinyu kandi vuli kindu chiinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 46:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwu mwami amulanga nukumuteva miyinzi ja mukora, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.33",
            "verseOrgIds": [
              "GEN.46.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 46:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu muvoolere ndi munyi mwaali vuzwa avayi kutura muvosoleri vwinyu, kuli avaguuga vinyu vaakora. Mu liiva kuli yili alaleka mumenye mukivala cha Gosheni.” Josefu yavoola yaga kigira avayi vaveeye livihilirizwa ku avandu va Egebeti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.34",
