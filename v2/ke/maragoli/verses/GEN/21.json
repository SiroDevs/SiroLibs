              "type": "text"
            }
          ]
        },
        {
          "text": "Inyima lwa vaali nivakalomba livugilizana yili ha Beerisheba, Abimeleki na Fikoli virana Filisitia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.32",
