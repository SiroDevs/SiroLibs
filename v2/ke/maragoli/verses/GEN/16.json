          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hagari yivulira Aburamu mwana muyaayi, ma namugulika lieta lilie Ishimaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu yaali ni mihiga 86 lwa Hagari yivula Ishimaeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
        }
