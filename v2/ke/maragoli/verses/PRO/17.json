          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu okolaa vuchamu kuva uvulungi kandi ukalagiraa avalugi, vombi vaveeye vu kuvihiliriza ku Yahova.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        }
      ]
    },
