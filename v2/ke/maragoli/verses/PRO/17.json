          "type": "text",
          "attrs": {
            "verseId": "PRO.17.17",
            "verseOrgIds": [
              "PRO.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu utaveeye novogeri niye unyala kuvungilira kutunga ligovi liu mundu wundi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.18",
            "verseOrgIds": [
              "PRO.17.18"
