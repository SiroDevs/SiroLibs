          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaveeye na vokonyi ki mundu musiru kutumikira mabese konyoora ovogeri kuvataveeye ni limanya?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        }
      ]
