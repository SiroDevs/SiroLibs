          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nutungiza uvudamanu havogono hu vulahi vudamanu si vulatula munyumba yooyo mba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
            ]
          }
        }
      ]
