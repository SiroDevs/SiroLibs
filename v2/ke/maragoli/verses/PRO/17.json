          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litanga lie lihing'ana liveeye kuli ligalira lia mazi; ugigariri nigakiri kuzia ihale.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
              "PRO.17.14"
            ]
          }
        }
      ]
