          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ovogeri voveeye kisinukiru chi livamwoyo ku mundu mugeri, navuzwa kogeliza kwigiza vandu vasiru nu kwononyia vwiyangu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.22",
            "verseOrgIds": [
              "PRO.16.22"
            ]
          }
        }
