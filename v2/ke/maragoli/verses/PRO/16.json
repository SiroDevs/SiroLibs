          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu mugeri amanyikanaa ku limanyiriza lilie. Amakuva geege manyingi malahi gamukolaa kuva wokogoonya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.21",
            "verseOrgIds": [
              "PRO.16.21"
            ]
          }
        }
