          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni vulahi ligali kuva no vogeri kandi ni limanya kuvita kuva ni zahabu harara ni ifeza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        }
      ]
    },
    {
