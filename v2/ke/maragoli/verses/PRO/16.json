              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu avageri vaganagana imbiri wa vakikiri komoloma; na ga vavola gaveeye gu kuyaanziza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.23",
