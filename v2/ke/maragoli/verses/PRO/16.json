              "type": "text"
            }
          ]
        },
        {
          "text": "Eveeyeho inzira elolekaa kuva inungi ku mundu, navuzwa keheri chayo keveeye likuza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.25",
