            "number": "17",
            "style": "v",
            "sid": "PRO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavo avaveeye avalahi vagenda kunzira itaveeye nuvudamanu; kunangwa muhenzerizi wamuzizaa, na munyala kuhonyia livamwoyo lienyu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lielola liduukiza mundu mulidiva, kandi liegingira likora mundu kugwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.18",
            "verseOrgIds": [
              "PRO.16.18"
            ]
          }
        }
      ]
    },
    {
