          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni vulahi kuva muhocha ma ove mudaka, kuvita kuva mulala ku vandu vi liegingira kandi konyoora ku mugavo gwi vilaanye viavo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.19",
