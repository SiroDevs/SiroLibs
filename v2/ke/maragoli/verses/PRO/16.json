          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhulirizi gawigizwaa, na ulanyora madanyi; usuuviri mu Yahova na mulava no vuyanzi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.20",
            "verseOrgIds": [
              "PRO.16.20"
            ]
          }
        }
      ]
    },
