        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vaveeye avasuuvirifu vaveeye mu mirembe kandi mu likingwa, navuzwa vandu vataveeye avasuuvirifu valanyooleka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
