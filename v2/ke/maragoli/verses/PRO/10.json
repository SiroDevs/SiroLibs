              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadanyi gelikola vulungi ni livamwoyo, navuzwa vwoni vuletaa vudamanu vunyingi.",
          "type": "text",
          "attrs": {
