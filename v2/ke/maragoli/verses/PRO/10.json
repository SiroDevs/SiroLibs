          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vovogeri vamoloma makuva gi kivuni, navuzwa vandu vasiru gavadukiraa vahevwe amageri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
