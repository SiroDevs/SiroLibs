              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vovogeri vanyoola limanya liosi, navuzwa makuva ga vasiru galetaa lidiviza himbi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
              "PRO.10.14"
