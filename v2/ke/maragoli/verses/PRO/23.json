          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huliriza baba woovo; alavula kuva oyo siwaali omenye mba. Lwa mama woovo ahindiraa umanyie vuyanzi vuvwo kuye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.22",
            "verseOrgIds": [
              "PRO.23.22"
            ]
          }
