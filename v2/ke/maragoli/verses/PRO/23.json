        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.34",
            "verseOrgIds": [
              "PRO.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulavoola, “Vakunduya, navuzwa sisaliyi mba, vakunguya navuzwa simbuliyi mba. Ndavuka ing'inga ki? Inzi ndeenya iwaini yindi nwi.”",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.35",
            "verseOrgIds": [
              "PRO.23.35"
            ]
          }
        }
      ]
