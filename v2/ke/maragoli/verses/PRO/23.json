          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utageriza komoloma makuva govogeri ku mundu musiru mba, kigira si alagavugilira mba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.9",
            "verseOrgIds": [
              "PRO.23.9"
            ]
          }
        }
      ]
    },
