          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wange, nuva mugeri ndava nuvuyanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndava niliegingira lwambulira nomoloma makuva govogeri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.16",
            "verseOrgIds": [
              "PRO.23.16"
            ]
          }
        }
      ]
