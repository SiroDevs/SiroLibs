      },
      "items": [
        {
          "text": "Lugano lwa -18-",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.28",
            "verseOrgIds": [
              "PRO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nivwaha oveeye nuvudinyu vunyingi? Nivwaha oveeye novovereri? Nivwaha oveeye nu vwigani? Nivwaha wigana? Nivwaha oveeye ni zingwagu vugira kindu chazileeta? Nivwaha oveeye ni zimoni zinzakanyu? ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29",
            "verseOrgIds": [
              "PRO.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni yavo avamenya ku iwaini. Yavo avazizaa kuzazama iwaini yasuganywa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.30",
            "verseOrgIds": [
              "PRO.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.30",
            "verseOrgIds": [
              "PRO.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utahenza iwaini neveeye inzakanyu mba, lwa itavagiraa mu kekombe yiginga ma yidoloka hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.31",
            "verseOrgIds": [
              "PRO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu limalirika ilakuluma kuli enzoka yu vusungu, kandi kuli kihirigoma. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.32",
            "verseOrgIds": [
              "PRO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulalora vindu vigeni, kandi ulamoloma vindu viu vuchamu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.33",
            "verseOrgIds": [
              "PRO.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulava kuli mundu ogoni hagati hi inyanza kandi kuli mundu ogoni kondongozi kwu mulage.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.34",
            "verseOrgIds": [
              "PRO.23.34"
            ]
          }
        }
      ]
    },
