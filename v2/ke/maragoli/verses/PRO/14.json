          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu wuvutima vwa vwangu akolaa vindu viuvusiru, navuzwa mundu wovogeri yikuziraa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.17",
            "verseOrgIds": [
              "PRO.14.17"
