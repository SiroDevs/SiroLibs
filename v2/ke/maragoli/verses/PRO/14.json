          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandu vovogeri velehaa kutura ku vudamanu, navuzwa vandu vasiru vaveeye vugira lielinda kandi vakora vwangu vugira kuganagana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.16",
            "verseOrgIds": [
              "PRO.14.16"
            ]
