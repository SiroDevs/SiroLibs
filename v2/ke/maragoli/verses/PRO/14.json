          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukali mugeri yumbaka inyumba yeeye, navuzwa mukali musiru asambula inyumba yeeye na makono geege mwene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
