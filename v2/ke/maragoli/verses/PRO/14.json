              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vatamanyi vanyoola madanyi gu vusiru vwavo, navuzwa avageri vanyola madanyi gi limanya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.18",
