          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vasiru sivahenderaa kokora vwoni, navuzwa vandu valungi vatevaa lisamiifwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
