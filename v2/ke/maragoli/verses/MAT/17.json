          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso na vigi veve vaduuka Kaperinaumi, avasololi vuvusuuru vwi Litembeli vazia ku Petero ni vamuteeva, “Mwigizi winyu atungaa uvusuru vwi litembeli?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.24",
            "verseOrgIds": [
              "MAT.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
