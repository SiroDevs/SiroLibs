              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso, yamala kovora amakuva yaga, Kiduma chagenya ligali ku amigizu geege. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.28",
            "verseOrgIds": [
              "MAT.7.28"
            ]
