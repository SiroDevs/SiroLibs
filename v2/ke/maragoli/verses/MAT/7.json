              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira siyigiza kuli avigizi vi Lilaga mba, navuzwa yaavigiza kuli umundu oveeye nu vunyali.",
          "type": "text",
          "attrs": {
