            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Navuzwa mundu ku vosi uhuliraa amakuva gange, kandi navula kugakola, aveeye kuli mundu musiru, uwumbakaa inyumba yeeye ku muyeke. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.26",
            "verseOrgIds": [
              "MAT.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbura yakuba, imigera nijizura imbuza enene nihuza, kandi nihuza ni zinguru ku inyumba yeyo, nayo yagwa, kandi liigwa liayo liali nu mufuumu munene ligali!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.27",
            "verseOrgIds": [
              "MAT.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uvunyali vwa Yeso",
          "type": "text"
        }
      ]
    },
