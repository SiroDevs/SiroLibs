          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yaavavererera, navadiira ku zimoni ziavo; ahene yaho, valora kandi ni vamulonda.",
          "type": "text",
