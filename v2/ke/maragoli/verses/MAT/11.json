          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iniira yange ni inyangu, kandi umusigo gwange goveeye umwangu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.30",
            "verseOrgIds": [
