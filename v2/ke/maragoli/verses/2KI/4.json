              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha yativura, “Vahe valie, kigira Yahova avoora ndi valalia kandi kilatigala ku.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
