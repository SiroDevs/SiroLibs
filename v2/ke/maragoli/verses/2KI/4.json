          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa mutumikiri zana yativura navoora, “Uganaganaa yiki kiladuuka avasaza imia ndala?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        }
      ]
    },
