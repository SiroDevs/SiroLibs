        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
