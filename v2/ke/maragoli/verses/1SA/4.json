  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1SA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Samweli yamoloma, avandu vosi va Isiraeli vahuliriza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Livugurwa lie Lisandugu lie Lilagana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ing'inga yene yeyo, avandu va Isiraeli vaali nuvulwani na vandu va Filisitia. Avandu va Isiraeli vumbaka hokososa haavo ha Ebeneza na avandu va Filisitia navo nivumbaka ha Afeki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Filisitia vavatulira, na inyima wu vulwani vululu, vaguuta vandu va Isiraeli kandi niviita ahimbi avasaza zielefu zine mu liihi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.2",
            "verseOrgIds": [
              "1SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa avatigara mwoyo virana hokososa, aviimiliri va Isiraeli vateevana nivavoora, “Kigira ki Yahova naleka Vandu va Filisitia vakuguute lidiku lia Lero? Gendi kuzie koleta Lisandugu lie Lilagana lia Yahova kutura Shilo, kunangwa ave harara ni kunyi kandi akohonyie kutura ku vasigu viitu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.3",
            "verseOrgIds": [
              "1SA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa vaatuma avatumwa Shilo kandi nivaleeta Lisandugu lie Lilagana lia Yahova Wanyala viosi, uwikaye ku endeve yu vwami igulu wa Vakerubi. Avayaayi va Eli vaviri, Hofini na Finiasi vaza harara ni Lisandugu lie Lilagana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Lisandugu lie Lilagana lia Yahova liaduuka mu hokososa, avandu va Isiraeli vosi vasangala ligali nivahanzuka nu mwoyo munene, kali lirova lialangilira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.5",
            "verseOrgIds": [
              "1SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Filisitia vahulira lihanzuka kandi vavoola, “Huliri ku lihanzuka yilio kutura mu hokososa ha avandu va Isiraeli! Gaveeye kovora ki?” Lwa vaduuka kumanya ndi Lisandugu lie Lilagana lia Yahova liali kuduuka mu hokososa ha Avaheburaina, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaali nuvuti ligali kandi vavoola, “Nyasaye umali kuuza hokososa haavo! Kunyi kuudivi! Kindu kuli yiki kikiri kwekoleka ku kunyi mba! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.7",
            "verseOrgIds": [
              "1SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nivwaha unyala ku kohonyia kutura ku vanyasaye vizingulu yavo? Vaveeye avanyasaye viita vandu va Egebeti mu changalangwe na maduywa manyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.8",
            "verseOrgIds": [
              "1SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muve avaluviriri, avandu va Filisitia! Mulwaane kuli avasaza; gase, kulagwa vatugwa ku Vaheburaina, kuli yavo vaali avatugwa viitu. Kunangwa mulwaane kuli avasaza.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa Avafilisitia valwaana vudinyu kandi nivaguuta avandu va Isiraeli, niviruka samulala kuduuka mu zingo ziavo. Liitwa liali linene ligali kuvita; Avasikari va Isiraeli zielefu salasini viitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.10",
            "verseOrgIds": [
              "1SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisandugu lie Lilagana lia Nyasaye liavugurwa, kandi avayaayi va Eli, Hofini na Finiasi vombi viitwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likuza lia Eli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu kutura mu ihiiri ya Benjamini yanyagula kutura mu kiguti chuvulwaani kuduuka Shilo naduuka yo lidiku liene yilio. Kumanyia ovovereri vwivwe yaali naatanduyi zinguvu zizie kandi naavaki vodohi ku mutwi gwigwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.12",
            "verseOrgIds": [
              "1SA.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli, uwaali nuvuha kumanya amakuva gi Lisandugu lie Lilagana, yaali niyikaye ku endeve ku lujinga lwi inzira nalindilira. Mundu oyo yalandiza makuva mu lidaala liosi, kandi avandu vosi, sa mulala, vaalira vudinyu nivizuuyi uvuti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.13",
            "verseOrgIds": [
              "1SA.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli yahulira liyoga lie lilira yilio, ma nateeva, “Liyoga yili liosi ni liaki?” Mundu oyo yanyagula kuzia ku Eli kumuvolera amakuva gaali nigekoleki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli yaali naveeye kalunu ni mihiga 98 kandi yaali ahimbi umboku ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.15",
            "verseOrgIds": [
              "1SA.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu zana yavoola, “Mali kohononoka kutura mu liihi kandi nyaguyi logendo lwosi kuduuka hano kalunu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli yamuteeva, “Ni ki chekoleki, muyaayi wange.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa oyo yativura, “Isiraeli viiruki kutura ku Vafilisitia; liali liguutwa lidamanu ligali ku kunyi! Komeeda ku agene yago, avayaayi vovo, Hofini na Finiasi vaali kwitwa; kandi Lisandugu lie Lilagana lia Nyasaye limali kuvugurwa!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa mundu oyo yatala Lisandugu lie Lilagana lia Nyasaye, Eli yagwira mugongo kutura ku endeve yeeye ahimbi ni kirivwa; naavunika ligoti lilie, ma nakuza kigira yaali musakulu kandi mukomeru. Yaali umwimiliri mu Isiraeli ku lwi mihiga 40.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likuza liu mukunzakali wa Finiasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navizara Eli, mukali wa Finiasi, yaali ni inda na ing'inga yeeye yu kwivura yaali ahimbi. Lwa yahulira ndi Lisandugu lie Lilagana lia Nyasaye limali kuvugurwa, ma kandi navizara weve harara numusaza weve vamali kukuza vombi, nonoho yaatanga lilumwa kandi niyiivura. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa yaali nakinda, avakali vamukonyanga kwivura vamuvolera, “Lema mwoyo! Onyooye mwana muyaayi!” Navuzwa siyativula kindu anoho kovora kindu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.20",
            "verseOrgIds": [
              "1SA.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagulika mwana zana oyo Ikabodi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.21",
            "verseOrgIds": [
              "1SA.4.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:21",
              "type": "text"
            },
            {
              "text": "Ikabodi:",
              "type": "text"
            },
            {
              "text": "Lieta lio Luheburaina; liveeye kovora sivoveeye vukumi mba.",
              "type": "text"
            }
          ]
        },
        {
          "text": " livaalaa “Uvukumi vwa Nyasaye vumali kutura mu Isiraeli”, kigira livugurwa lie Lisandugu lie Lilagana lia Nyasaye kandi likuza lia navizara, liu musaza weve. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.21",
            "verseOrgIds": [
              "1SA.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavoola “Vukumi vwa Nyasaye vumali kutura mu Isiraeli, kigira Lisandugu lie Lilagana lia Nyasaye limali kuvugurwa.”",
