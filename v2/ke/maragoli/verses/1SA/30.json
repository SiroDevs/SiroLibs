              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi avandu vaali mu madaala ga Horima, Borishani, Azaki, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
          }
