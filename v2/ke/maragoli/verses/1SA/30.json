          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi Rakali, ihiiri ya vandu va Jerahameeli, avandu va Keni, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
