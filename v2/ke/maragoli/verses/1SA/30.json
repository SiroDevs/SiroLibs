          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatuma vandu vaali mu lidaala lia Bezeli, mu Rama, kolovega lwi isavaalu wi Ivuyuda, kandi ku vandu vaali mu lidaala lia Jatiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
