          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroeri, Sifumozi, Eshitemoa, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
