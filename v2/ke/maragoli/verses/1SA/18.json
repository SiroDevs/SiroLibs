          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa yamanya naatia Daudi ligali kandi yagwa musigu weve ku madiku goosi ga yaali mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
