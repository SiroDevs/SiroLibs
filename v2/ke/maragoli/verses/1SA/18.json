              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saolo yamanyiriza vulahi ndi Yahova aveeye harara na Daudi, kandi mukaana weve Mikali yamuyanza ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
