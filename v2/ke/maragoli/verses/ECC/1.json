{
  "id": "ECC.1",
  "number": "1",
  "bookId": "ECC",
  "reference": "Kohelezu 1",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
