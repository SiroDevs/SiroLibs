          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa kaviri gwu vwamihi vwu mwami Asa wi Ivuyuda, muyaayi wu mwami Jeroboamu, Nadabu yakolwa mwami wa Isiraeli, na yamiha ku mihiga giviri ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadabu yakola Vwoni, ku Yahova kandi yakola vandu va Isiraeli kugwa mu vwoni. Kuli baba weve yakola",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
