          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vindu vindi viosi via Nadabu viang'odwa mu kitabu cha makuva ga kale ga vami va Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Asa wi Ivuyuda nu mwami Baasha wa Isiraeli vaali mu valwaana kazozo, ga vaali mu vwamihi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
