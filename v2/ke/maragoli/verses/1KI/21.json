          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihaali ho nu mundu wosi waluvilira nu mwoyo gwosi kokora vudamanu mu zimoni zia Yahova kuli Ahabu mba, na Jezebeli mukali weve yamuzuva mu vindu yivi viosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakola vwoni vwizisoni kuvita vwosi ligali mu lisigamira vifananyi, kuli vandu va amori vaali ni vakora, va Yahova yaali niyakunga kutura mu kivala zana lwa vandu va Isiraeli visunda imbiri kukivugula.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
