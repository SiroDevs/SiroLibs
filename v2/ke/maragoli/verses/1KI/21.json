          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu woosi oveeye mwiko woovo ukuzira mu lidaala linene, alaliivwa ni zimbwa, kandi mundu woosi ukuzira mu milimi, alaliivwa nizisoti.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        }
