          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yamuvolera, “Nyora lilola! Lisuuvira liilio likohonyi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.42",
            "verseOrgIds": [
              "LUK.18.42"
            ]
          }
        }
