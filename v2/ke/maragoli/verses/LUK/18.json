              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.33",
            "verseOrgIds": [
              "LUK.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa aviigi sivahulira kali kindu kilala ku vindu yivi mba; vaali nivavisiywi kivuni cha amakuva yaga, na sivamanyiriza niki cha Yeso yavoola mba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso ahonyia muvoku musavasavi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso yaali ahimbi kuduuka Jeriko, yaali ho mundu mulala mboku uwaali ni yikaye kundulu kwinzira naasavasavaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.35",
            "verseOrgIds": [
              "LUK.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa yahulira kiduma cha avandu nikivitaa, yateeva, “Nikindiki chekoleka?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.36",
            "verseOrgIds": [
              "LUK.18.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
