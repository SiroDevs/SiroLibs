          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa avandu vahulira yaga, vamuteeva, “Ku nivwaha unyala kohonywa?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.26",
            "verseOrgIds": [
              "LUK.18.26"
            ]
          }
        }
      ]
    },
    {
