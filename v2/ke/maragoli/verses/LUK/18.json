            "number": "26",
            "style": "v",
            "sid": "LUK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.26",
            "verseOrgIds": [
              "LUK.18.26"
            ]
