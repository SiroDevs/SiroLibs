          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.42",
            "verseOrgIds": [
              "LUK.18.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonoho uwaali mboku yalora lilie, ma nalonda Yeso, niyizominya Nyasaye. Lwa avandu vosi valora yaga, vizominya Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.43",
            "verseOrgIds": [
              "LUK.18.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso na Zakayo",
          "type": "text"
        }
      ]
