        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yamutivulira, “Agatanyalika ku avandu, ganyalika ku Nyasaye.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.27",
            "verseOrgIds": [
              "LUK.18.27"
            ]
          }
        }
