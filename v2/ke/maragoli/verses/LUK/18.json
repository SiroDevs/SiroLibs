          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso yalora yaga yavoola, “Voveeye vudinyu ku avatugi kwingira mu Vwami vwa Nyasaye!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.24",
            "verseOrgIds": [
              "LUK.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yee, voveeye vudinyu ligali kuvita mundu mutugi kwingira mu Vwami vwa Nyasaye, kuvita ing'amia kuvitira mu muluhu gwi isindani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.25",
            "verseOrgIds": [
              "LUK.18.25"
            ]
          }
        }
      ]
    },
    {
