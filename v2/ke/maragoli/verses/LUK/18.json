          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero yamuvolera, “Kunyi kwaleka viosi via kwaali navio, ma kwakolonda!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.28",
            "verseOrgIds": [
              "LUK.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.28",
            "verseOrgIds": [
              "LUK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yavavolera, “Agiligali muvooleraa, sihali nu mundu uwaleka inyumba yeeye, anoho mukali, anoho amwavo weve anoho aviivuli veve, anoho avana kigira Vwami vwa Nyasaye, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ulivula konyoora vinyingi ligali mu ing'inga ya kalunu, kandi konyoora livamwoyo litahera mba mu ing'inga yiza.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.30",
            "verseOrgIds": [
              "LUK.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso yamoloma lwa kavaga kigira likuza lilie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
