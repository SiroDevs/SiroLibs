              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa ihiiri ya Manase sivali vanyara kukunga avandu vamenya Bezishani, Tanaki, Dori, Ibuleamu Megido, harara nu tudaala twali ahimbi kugo; kigira vandu va Kanaani vazizagilira komenya mukivala yicho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vandu va Isiraeli vaali nivakava ni zinguru kuvita lwambiri, vaniga vandu va Kanaani kokora miyinzi kuzingulu, navuzwa sivali vanyara kuvakunga vosi mba.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
      ]
    },
