              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Amori vaniga avandu vihiiri ya Dani komenya mu kivala chivigulu, na sivavavugilira kuuza komenya mukeleremo mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
