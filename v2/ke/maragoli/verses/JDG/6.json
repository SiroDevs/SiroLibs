              "JDG.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'inga yeyo vandu va Midiani, Maleki, harara ni zihiiri zindi ziumwigendanyama, ziamanya niziivungizana, nivambuka Jorodani, nivamenya, mu livona lia Jezireeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.33",
            "verseOrgIds": [
              "JDG.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho wa Yahova yaza ku Gidioni, ma nakuba ikisiliva kulanga avasaza vi ihiiri ya Abiezeri vamulonde. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatumana kandi avatumwa mu kivala choosi cha Manase navateeva vamulonde. Yatumana avatumwa kandi kuzihiiri zia Asheri, Zabuloni na Nafutali; na vaza kuhambana naye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Gidioni yavolera Nyasaye, “Niiva ulasoola Isiraeli nu mukono gwange kuli ovooye, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.36",
            "verseOrgIds": [
              "JDG.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbikaa inguvu yu vwoya yi ligondi koloze lwakuhuuliraa ku ingano; niiva iliime lilava kunguvu yuvwoya yiyi mugamba mu mavwevwe, maku ndamanya ndi Ivi ulandumikira kosoola Isiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.37",
            "verseOrgIds": [
              "JDG.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa, ageene yaga nigo agaakoleka. Ulwa Gidioni yavuka mugamba kale naakamulura inguvu yu vwoya vwi ligondi, amazi gaturaa mu ibakuli indala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.38",
            "verseOrgIds": [
              "JDG.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Gidioni yavolera Nyasaye, “Utaluha ninzi mba, navuzwa umbugiliri ndeve vuzwa lulara lweng'ine: Leka ngelizi vuzwa kandi lulala nindumikiraa inguvu yu vwoya vwi ligondi yiyi. Ing'inga yiyi nyenya inguvu yuvwoya zana kalunu eve inyumu vuzwa, na hasi haiviikwa have ahaziliru.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.39",
            "verseOrgIds": [
              "JDG.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvudiku yivwo, Nyasaye yakola malala meere. Umugamba gwalonda ku, inguvu yuvwoya yaali inyumu, navuzwa hasi hayaviikwa haali ni lime.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.40",
            "verseOrgIds": [
              "JDG.6.40"
            ]
          }
        }
      ]
