          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Joashi yavolera vosi avamuhangalizaa, “Munyi muveeye kolovega lwa Baali? Mundu oveeye kolovega lwa Baali alakuza nivukiri kucha. Niiva Baali ni nyasaye, muleke mwene yikingi. Maku muvooleraa uvwali vwivwe nivwo vumali kusambulwa!” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.31",
            "verseOrgIds": [
              "JDG.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutura ulwene yilwo, Gidioni yamanyikana kuli Jerubali kigira Joashi yavoola, “Leka Baali mwene yikingi mwene; uvwali vwivwe nivwo vwasambulwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
