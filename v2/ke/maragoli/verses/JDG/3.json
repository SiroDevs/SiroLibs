              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku liene yilio, vita vandu va Moabu izielefu likomi avaari nizinguru ligali; na sihaali ho kali mundu mulala uwatigala mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
