{
  "id": "JDG.20",
  "number": "20",
  "bookId": "JDG",
  "reference": "Vakalagi 20",
  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JDG 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vandu va Isiraeli vetegeka Kulwaana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vosi va Isiraeli kutura Dani kolovega lwi ivaale kuduuka Beerisheba kolovega lwi savaalu, kandi kutura mu kivala cha Gileadi kolovega lwi vugwi vahulira umulango. Viivungikizana harara ha Mizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.1",
            "verseOrgIds": [
              "JDG.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aviimiliri vosi vizihiiri zia Isiraeli vaali ho mu lmuganda gwa vandu va Nyasaye, kandi vaali ho avasikari 400,000 avagendaa ku virenge. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.2",
            "verseOrgIds": [
              "JDG.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'inga yene yeyo, avandu va Benjamini vahulira ndi vandu va Isiraeli vandi vamali kwivungikiza ha Mizipa. Avandu va Isiraeli vateva kovooleri kuli makuva yaga gekoleka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.3",
            "verseOrgIds": [
              "JDG.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu wi ihiiri ya Levi wu mukali weve yaali niyitiiywi yavavolera, “Inzi harara nu mukali wandaviika kwazia Gibea mukivala cha Benjamini kogona yo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.4",
            "verseOrgIds": [
              "JDG.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avasaza va Gibea vaza konyenya ma ni vakumbiriza inyumba vudiku. Venya vaanziti; mu vwiyangu vwene yivwo, vonogonyia mukali wange, ma nakuza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.5",
            "verseOrgIds": [
              "JDG.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaavugura umuviri gwigwe ningotemaganyia mu vidonye, ma ninduma ekedonye chagwo kuvuli ihiiri ya Isiraeli kuli ziveeye komi na mbiri. Avandu yava vakoli ikindu ikidamanu kandi kitaduukanaa hagati hiitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.6",
            "verseOrgIds": [
              "JDG.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi hano vosi muveeye vandu va Isiraeli. Kunyala kokolaki?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vosi vasingira harara nivavoora, “Umundu woosi oveeye hano, sialilana yengo weve mba. Ave amenyi mu lihema anoho munyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.8",
            "verseOrgIds": [
              "JDG.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga nigo agakuziiza kola. Kulakuba ikura kumanya avandu vamanya vazie kulwaana vandu va Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.9",
            "verseOrgIds": [
              "JDG.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikidieli chi likomi cha vasaza mu Isiraeli valaleta ichukulia chu kutumikira mu liihi, na avandi valazia kulwaana Gibea ku lihiolo lia vamali kokora mu Isiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.10",
            "verseOrgIds": [
              "JDG.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku avandu vosi mu Isiraeli viivungikizana harara kulwaana ilidaala zana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izihiiri zia Isiraeli ziatuma vatumwa mu ihiiri ya Benjamini nivavoora, “Ni mahiolo ki yaga gamumali kokora? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.12",
            "verseOrgIds": [
              "JDG.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu mukohe avandu valumindi va Gibea yavo, kuduuki kuviita kunangwa kutulizi ikivi mu Isiraeli.” Navuzwa avandu va Benjamini vachaya agavavoolerwa na vandu va Isiraeli vandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.13",
            "verseOrgIds": [
              "JDG.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi vandu va Benjamini vivungikizana ha Gibea kutura mumadala gaavo kulwaana vandu va Isiraeli vandi ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.14",
            "verseOrgIds": [
              "JDG.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Benjamini vavungiza avasikari 26,000 kutura mu madaala gaavo mu lidiku liene yilio avaari ni vivavi kumeeda ku vasaza 700 avatovolwa avamenyaa mu Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.15",
            "verseOrgIds": [
              "JDG.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu yava vosi vaatovolwa avandu mia saba avalwaaniraa imikono mimosi. Vuli mulala kuvo yaali anyala kulasa iliisu lilala numugoye nilisingiiyi vugira kulihononokiza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.16",
            "verseOrgIds": [
              "JDG.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli ni tavaliziiyi mu ihiiri ya Benjamini, yavungiza avasikari 400,000 avukulwaana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uvulwani na vandu va Benjamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vazia havundu hukusigamira Yahova ha Bezeli, kandi nivateeva Nyasaye, “Hiiri ki idukanaa kwingilira vandu va Benjamini kutanga?” Yahova yativura, “Ihiiri ya Yuda.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa vandu va Isiraeli vatanga logendo mugamba gwalonda ku ma ni vazia kolomba hokososa ahimbi ni lidaala lia Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.19",
            "verseOrgIds": [
              "JDG.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vazia kwingilira vandu va Benjamini mu vulwani navo valohiza vasikari vulahi mu vwiyangu vwavo vwiliihi ha Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.20",
            "verseOrgIds": [
              "JDG.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iliihi lia Benjamini liatura mu lidaala, kandi nivakiri kwira vaali niviiti 22,000 zia vasikari va Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.21",
            "verseOrgIds": [
              "JDG.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa avandu va Isiraeli vidinyia kuli lwambiri nivelohizi havundu harara heere havaali nivelohizi lidiku liukutanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.22",
            "verseOrgIds": [
              "JDG.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vazia nivalilira Yahova kuduuka hamugorova, kandi nivamuteeva, “Gakuduukiraa kwilane muvulwani kulwaane vandu va Benjamini avaveeye avamwavo viitu?” Yahova yavavolera, “Tuli muzie kuvalwaana.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku vandu va Isiraeli visunda ahimbi ha vandu na Benjamini lidiku lia kaviri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.24",
            "verseOrgIds": [
              "JDG.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'inga yiyi lwa Avabenjamini vaatura Gibea kuuza kulwaana vandu va Isiraeli, Benjamini yita avandu 18,000 va Isiraeli avaari nivaavugura amigizu gu vulwani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.25",
            "verseOrgIds": [
              "JDG.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku vandu va Isiraeli, avandu vosi, vanigira ha Bezeli niviikuuraa. Vahonga yo nivikaye imbiri wa Yahova vugira kali kulia ichukulia kuduuka hamugorova. Vahaanira Yahova kihanwa chukusambwa kandi kihanwa chi murembe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vazia koteeva Yahova. Mu madiku yago Lisandugu lia Malago ga Nyasaye liali ha Bezeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.27",
            "verseOrgIds": [
              "JDG.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finiasi mwana wa Eliaza waali naveeye umulindi walio. Vateva Yahova, “Gaduukanaa kunyi kutuli kuzia kulwaana avaamitu vandu vi hiiri ya Benjamini kandi, anoho koleke?” Yahova yativura navoora, “Muvalwaane. Mugamba ndamuha uvuguuti.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa vandu va Isiraeli vaviika avasikari ahivisu ahimbi na Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.29",
            "verseOrgIds": [
              "JDG.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumadiku galondekanaa gavaga, avandu va Isiraeli vasulunguta kuzia mu vulwani ku na vandu va Benjamini na valohiza vasikari vaavo mu vwiyangu vuduukana kulwaana lidaala lia Gibea kuli vaakora maziambiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.30",
            "verseOrgIds": [
              "JDG.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Benjamini vaza kulwaana, navo vaatura ichova kutura mu lidaala. Kuli maziambiri, vatanga ukwita vandu va Isiraeli valala mu kiguti, kunzira izizaa Bezeli kandi kunzira izizaa Gibea. Avandu va Benjamini vita vandu va Isiraeli himbi salasini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.31",
            "verseOrgIds": [
              "JDG.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Benjamini vavoola, “Kuvaguuti kuli maziambiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa vandu va Isiraeli liirana inyima nukwivungikizana ha Balitamari, vandu va Isiraeli vaatura vwangu havaali nivivisi imadioli wa Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.33",
            "verseOrgIds": [
              "JDG.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu 10,000 avaatovolwa kuvudukiru vwavo kutura mu Isiraeli yoosi vingilira Gibea, nu uvulwani vwali vululu ligali. Avandu va Benjamini sivamanya vaveeye ahimbi kudivizwa mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.34",
            "verseOrgIds": [
              "JDG.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yakola vandu va Isiraeli kuguuta avandu va Benjamini avandu va Isiraeli vita vandu va Benjamini 25,100 lidiku yilio, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi vandu va Benjamini vamanya ndi vamali kuguutwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Avandu va Isiraeli vaguuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuganda munene gwi liihi lia vandu va Isiraeli gwisuunda inyima kutura ku vandu va Benjamini kigira vaali ni lisuuvira mu vandu vaali nivivisi ahimbi ha Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu yava vaatura havaali nivivisi nivanyagura kuzia kolovega lwa Gibea; vaasalana mu lidaala nu kwita vuli mundu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.37",
            "verseOrgIds": [
              "JDG.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuganda munene gwi liihi lia vandu va Isiraeli harara na vandu vaali nivivisi himbi ha Gibea vaali nivaviiki ho ikimanyiru. Lwavaalora ililesi linene liu mwochi nilitura mu lidaala, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.38",
            "verseOrgIds": [
              "JDG.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "vandu va Isiraeli vaali mu kiguti chu vulwani vatangiza iliihi. Kuduuka ing'inga yiyi, vandu va Benjamini vaali nivakiita vandu va Isiraeli salasini. Avandu va Benjamini vevoolera, “Yee, kumali kuvaguuta vuzwa kuli maziambiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.39",
            "verseOrgIds": [
              "JDG.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku ikimanyiru chaloreka; ililesi liu mwochi liatanga koloreka kutura mu lidaala. Avandu va Benjamini viikivuka wavatuli nivagenya kolola ilidaala liosi nilihiizaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.40",
            "verseOrgIds": [
              "JDG.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku avandu va Isiraeli vavagirung'ana, na vandu va Benjamini vaali nu vuti vonene ligali kigira vamanya vaali ahimbi kudivizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.41",
            "verseOrgIds": [
              "JDG.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Visunda inyima kutura ku vandu va Isiraeli kandi ni virukira mu kiguti, navuzwa sivahononoka mba. Vaanyoolerwa hagati hu muganda munene gwiliihi na vandu vaali nivaturaa mu lidaala nukudivizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.42",
            "verseOrgIds": [
              "JDG.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vagumira umusigu, kandi vugira kososa, vavakunga kuduuka ivugwi wa Gibea, nukuviita. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.43",
            "verseOrgIds": [
              "JDG.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avasikari 18,000 avasaza vuvulwani valoli vandu va Benjamini viitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.44",
            "verseOrgIds": [
              "JDG.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vandi viiruka ni vazia mukiguuti kuduuka ku Lwanda lwa Rimoni. Avandu va Benjamini izielefu zitano viitirwa kuzinzira. Avandu va Isiraeli valondelera ligali avaari nivatigaaye kuduuka ha Gidomu, nukwita avandu izielefu ziviri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.45",
            "verseOrgIds": [
              "JDG.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Benjamini 25,000 viitwa lidiku yilio, vosi ndio avasikari avaluviriri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa avandu 600 vanyaliza kohononoka mukiguuti kuduuka ku Lwanda lwa Rimoni, kandi vamenya mu mieli gine. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.47",
            "verseOrgIds": [
              "JDG.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli viirana ku vandu va Benjamini avatigara nivaviita vosi avasaza, avakali harara na vana, kali imitugu. Vasamba amadara goosi gavanyoolaa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.48",
            "verseOrgIds": [
              "JDG.20.48"
            ]
          }
        }
      ]
    }
