          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avalina vange vayaanze, lisuuvirizwa yili liosi lilomberwa kunyi. Kunangwa, gendi kwitakase kutura mu vudamanu vwosi vwu muviri, anoho vwu mu mioyo jietu, kove vatakatifu ligali, na komenye mu liitia Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.1",
            "verseOrgIds": [
              "2CO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uvusangari vwa Paolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.1",
            "verseOrgIds": [
              "2CO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiguli imioyo jinyu ku kunyi! Sikwayonera mundu kali mulala mba, sikwadiviza umundu kali mulala; kinga sikwagada nukunuula umundu kali mulala mba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.2",
            "verseOrgIds": [
              "2CO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbolaa yaga kumukalagira mba, kigira, kuli ndavoora maziambiri, kwamuyaanza ligali; kali sikeveeye ho ni kindu kinyala kukwavukanyia mba, kali nikuva mwoyo, anoho nikukuza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.3",
            "verseOrgIds": [
              "2CO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeeye nilisuvira linene ligali mu munyi. Mbeeye niliekonya linene ligali kigira munyi! Nzizuuyi kelemamwoyo ligali. Muvudinyu vwitu vwosi nzizuuyi uvusangari vonene ligali.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.4",
            "verseOrgIds": [
              "2CO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.4",
            "verseOrgIds": [
              "2CO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa kwaduka Makedonia si kwaali kunyala kosoosa mba. Vudinyu vwali ho havundu hoosi; ovolembani na vandi, kandi uvuti vwali mu mioyo jietu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.5",
            "verseOrgIds": [
              "2CO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye oleminyaa mioyo jikuzaa, yakoleminya mioyo kuliiza lia Tito ku kunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.6",
            "verseOrgIds": [
              "2CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sigaveeye ku liza lia Tito lienyine iliakoleminya mioyo, navuzwa kandi kigira amakuva ga yakovolera kuli mwamuzuva. Yakovolera kuli muveeye na mahooru amanene kandi kuli muveeye novovereri, kuli mwetegeki kosoola; kali kalunu mbeeye nu vusangali ligali.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali niiva ibarwa yange yeyo yamuvereriza, simberera kigira ndageng'oda mba. Yee, ndolaa ibarwa yeyo yamuvereriza, navuzwa ku ing'inga ngekeeke vuzwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.8",
            "verseOrgIds": [
              "2CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa kalunu mbeeye nu vuyanzi, sigaveeye kigira ndaamukora kuva no vovereri, navuzwa kigira vovereri vwinyu vwamulomba ni mwiganira. Vovereri vwinyu vwene yivwo, vwali kolondekana nu vulaliri vwa Nyasaye, navuzwa ovovereri yivwo vwamukola nimugirung'anyia zinzira zienyu. Ovovereri yivwo vwatumikirwa na Nyasaye, na sikwamusaliriza mba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.9",
            "verseOrgIds": [
              "2CO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vovereri vwa Nyasaye voletaa lieganira liu mwoyo kuduuka kovohonyi, navuzwa sivoleetaa liverera mba! Navuzwa ovovereri vwu mundu, voleta ilikuza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.10",
            "verseOrgIds": [
              "2CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loli ga Nyasaye yakola kigira vovereri, vwinyu, vuluviliri vwa mwanyoola; liiva liamwaali nalio kumanyia ndi muvura imbila, vutima vuti, liegomba kolola ndi vulungi vwekoleki, liegomba lia havulavu, vwihaani vwa mwanyoola, kandi kuli mwetegeka kuhaana mageri ku vandu vaakora vudamanu. Munyi mwayimanyia ndi simuveeye nimbala ku makuva yaga goosi mba.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.11",
            "verseOrgIds": [
              "2CO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.11",
            "verseOrgIds": [
              "2CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa, lwa ndaamung'odera ibarwa yeyo, siyaali kigira oyo woona, anoho kigira oyo wonerwa mba. Mu vwiyangu yivwo ndamug'odera kunangwa gaduuki koloeka havulavu, imbiri wa Nyasaye ndi munyi muveeye nu vwihaani kigira kunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.12",
            "verseOrgIds": [
              "2CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulwayago koleminyiywi mioyo ligali.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.13",
            "verseOrgIds": [
              "2CO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikoveeye koleminywa mioyo jietu vuzwa mba, navuzwa Tito kandi yakuyaanziza kuli mwamukonya niyitulira mu lihenda mwoyo lilie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.13",
            "verseOrgIds": [
              "2CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi nzekonyaa imbiri wa Tito kigira munyi na simbeeye soni kigira munyi mba. Navuzwa kuli kwamuvolera ivindu viosi vieligali kazozo, kulwayago, liekonya lietu imbiri wa Tito liloleki kuva lieligali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.14",
            "verseOrgIds": [
              "2CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa uvuyanzi vwivwe ku munyi vomedeka ligali lwa yizuliza kuli munyi mwosi mwali nimwetegeki kuhulira amigizu geege, kandi kuli mwamwingiriza nu vuti vunyingi, kandi ni lidegera. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.15",
            "verseOrgIds": [
              "2CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeeye nu vuyanzi ligali kigira kalunu nyara kusuuvira munyi ligali mu makuva goosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.16",
            "verseOrgIds": [
              "2CO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lihaana lia Avakristayo",
          "type": "text"
        }
      ]
    }
  ],
