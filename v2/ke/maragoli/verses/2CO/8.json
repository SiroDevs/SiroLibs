{
  "id": "2CO.8",
  "number": "8",
  "bookId": "2CO",
  "reference": "2 Vakorinzo 8",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2CO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avaamitu, kwenyaa munyi mumanye chi zimbavasi zia Nyasaye zimali kokora mu makanisa ga Makedonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaveeye ni ligerizwa linene liu vudinyu vunyingi vwa vavitira mu; navuzwa vudinyu vwavo vwali vonene kuvita ligali kigira kali niiva vaali vadaka ligali, vaali vahaani kuvita kegero mu lihaana liavo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.2",
            "verseOrgIds": [
              "2CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyara kumusuuviriza ndi, yava vaahana kuli vinyaliza, kali kuvita kegero chavaali vanyara kuhaana ku vulaliri vwavwo veene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.3",
            "verseOrgIds": [
              "2CO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaakogoonya nu mwoyo gwosi ligali nivenya vahevwe vwiyangu vwu kusanga mu vutumiki vwi likonya vandu va Nyasaye vaveeye mu Vuyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.4",
            "verseOrgIds": [
              "2CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yicho si chaavita kindu cha kwasuuvira ligali mba! Kutanga vihaana aveene ku Mwami; kandi ku vulaliri vwa Nyasaye, vihaana veene ku kunyi kandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.5",
            "verseOrgIds": [
              "2CO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira gene yago, kwagoonya Tito waali naatangi imiyinzi yijo mumunyi azizagiliri najo ligali, kandi amukonye kutwekiza vutumiki vwu vuyanzi yivu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.6",
            "verseOrgIds": [
              "2CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi avaveeye vatugi ligali mu vindu vinyingi: mu lisuuvira, mu limoloma, kandi mu limanya, nu muvugulu vwinyu vwosi kokora malahi muvuyaanzi vwinyu kukunyi. Kunangwa kwenyaa muve avahaani kandi mu vutumwa vwu vuyanzi yivu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simuhezaa malago mba, navuzwa nyenya kuvamanyia kuli vandi vaveeye nu vugulu vwo kokoonya vandu vandi. Ngerizaa kumanyia agiligali gu vuyanzi vwinyu kuli voveeye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.8",
            "verseOrgIds": [
              "2CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi mumanya zimbavasi ziu Mwami wiitu Yeso Kristo. Kali niyaali mutugi, yekola kuva mudaka kigira munyi. Na kigira uvudaka vwivwe, munyi muduuki kuva avatugi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zing'anagani ziange ziveeye ndi ni vulahi munyi mu malirizi agamwatanga kokora muhiga gwaavita. Munyi mwaali avimbiri, sigali ku likora vuzwa, navuzwa kuva kandi nilienya kokora. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.10",
            "verseOrgIds": [
              "2CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu gamudukira mumalirizi miyinzi yiji. Kuli mwaali nilienya lio kokoonya, gaduukanaa mukore zinguru kuli ndio. Mumalirizi kolondekana nu vuduukiru vwa muveeye navwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.11",
            "verseOrgIds": [
              "2CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu aveeye nilienya kuhaana, Nyasaye avugiliraa kihanwa chiche kolondekana ne kegero chanyala kuhaana; sianyala kuhaana chataveeye nacho mba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.12",
            "verseOrgIds": [
              "2CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi singerizaa kwanguhiza valala na ndwiki munyi misigo militu mba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.13",
            "verseOrgIds": [
              "2CO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira muveeye nu vunyingi ku ing'inga ya kalunu, nivulahi mukoonye avaveeye no vogeheru. Kunangwa, lwa muveeye no vogeheru, navo nivaveeye nu vutugi, valakamukoonye mu vogeheru vwinyu. Munzira yiyi vombi mulakakoonyane keleng'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.14",
            "verseOrgIds": [
              "2CO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli Mang'oda Matakatifu gavoora, “Uyu wavungiza vinyingi siyaali ni vinyingi viatigala ligali mba; kandi uyu wavungiza vikekeke siyaali no vogeheru ligali mba.”",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tito harara na avache veve vatumiywi Korinzo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa lisandiza live ku Nyasaye wavika mu Tito umwoyo gwu vugulu yigwo kuli gwa kunyi koveeye nagwo gwu kuvakonya! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.16",
            "verseOrgIds": [
              "2CO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sigaveeye vuzwa yaavugilira ga kwamuteeva akole, navuzwa umwene yaali nilienya linene lio kokoonya, kali nakalaga mulienya lilie mwene yaaze ku munyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.17",
            "verseOrgIds": [
              "2CO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harara naye, kutumaa amiitu mulala, wulusuma lwilwe lulahi kwilwaza Ivangeri ya Nyasaye, lwamanyikana mu makanisa goosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.18",
            "verseOrgIds": [
              "2CO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komeeda ku yago kandi, amali kotovolwa na makanisa kuzia harara ni kunyi lwa nakuhili kihanwa chu Vukristayo yiki. Kigira vukumi vwu Mwami, vuduuki kumanyikana ndi kwenyaa kokoonye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwilindi ligali kuvuli kudulwa nu mundu kali mulala mu liiva yakulindiraa mu kihanwa kilahi chi liehaana yiki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.20",
            "verseOrgIds": [
              "2CO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kivuni chi lienya lietu keveeye kokora agaveeye malungi; sigaveeye vuzwa imbiri wu Mwami yenyine mba, navuzwa imbiri wa vandu kandi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa, kutumaa amiitu Mukristayo wundi harara na vaamitu yavo. Kwamala kumugeriza haali kanyingi ma kwamunyoola ndi aveeye nilienya kokoonya kazozo. Kalunu kigira aveeye ni lisuuvira linene mu munyi, kandi aveeye nilienya ligali kokoonya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.22",
            "verseOrgIds": [
              "2CO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tito aveeye mulina kandi ayinziraa harara ninzi kokoonya munyi; kandi kigira avaamitu vandi vaazaa harara naye yavo, vaveeye avatumwa kutura mu makanisa, kandi valeta uvukumi ku Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.23",
            "verseOrgIds": [
              "2CO.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvamanyie vuyanzi vwinyu vudukiru kunangwa amakanisa goosi gaduuki kusuuvira; kandi kumanya ndi liekonya liange kigira munyi liveeye lieligali.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.24",
            "verseOrgIds": [
              "2CO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vokonyi ku Avakristayo mu Vuyuda",
          "type": "text"
        }
      ]
    }
  ],
