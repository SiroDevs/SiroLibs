              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Daudi yiizurwa nekevelera. Yanina kuduuka mu keng'oze keveeye kunzira yikirivwa. Lwa yaali nazizaa, yalira, “O, muyaayi wange! Muyaayi wange Abisolomu! Abisolomu, muyaayi wange! Ngano ninzi ukuzi mu vogono vuvwo muyaayi wange! O, muyaayi wange Abisolomu!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
        }
      ]
