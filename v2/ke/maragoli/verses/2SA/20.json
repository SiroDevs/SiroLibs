          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniramu yaali munene wi miyinzi jukunigwa; Jehoshafati muyaayi wa Ahiludi munene wo kolohiza vindu mu mang'oda; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
        {
