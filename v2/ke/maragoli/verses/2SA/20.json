              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu yaali mwimiliri wi liihi liosi lia Isiraeli; Benaya muyaayi wa Jehoyada yaali mwimiliri wa vasikari vukulinda Daudi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
