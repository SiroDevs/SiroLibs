              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyada yaali muyaayi wu Eliashibu, musaalisi munene; navuzwa mulala ku vayaayi va Jehoyada yaleeta mukaana wa Sanibalati, kutura mu lidaala lia Bezi-horoni. Kunangwa ndakunga Jehoyada kutura mu Jerusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wizulizi, O, Nyasaye wange, kuli avandu yavo vamali kwononyia miyinzi juvusaalisi ni lilagana lia walomba na vasaalisi kandi na vandu va Levi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndatakasa avandu kutura ku vindu viosi vigeni; ndalomba malago gu vuyinziri vwa vasaalisi na va Levi kunangwa sa mulala aduuki kumanya miyinzi jije; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalohiza iziingu zitumikaa kigira kusamba vihaanwa zileetwe ku ing'inga indahi idukanaa, kandi kigira avandu koleta vihaanwa viavo viuvuswage vwukutanga namakuyu gukutanga kwenga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unzizulizi yaga goosi, O, Nyasaye, na ongolere.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
