          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yakola ga Yahova yamulaga. Vazia mu kiguru cha Hori imbiri wa vandu vosi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.27",
            "verseOrgIds": [
              "NUM.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaatuliza ku Haruni zinguvu zio vusaalisi naviika muyaayi weve Elieza. Haruni yakuzira mu kiguru, navuzwa Musa na Elieza vasulunguta kutura mu kiguru nivilana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.28",
            "verseOrgIds": [
              "NUM.20.28"
            ]
          }
