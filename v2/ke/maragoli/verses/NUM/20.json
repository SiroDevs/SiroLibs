          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vugula Haruni nu mwana weve muyaayi Elieza muzie mu kiguru cha Hori, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.25",
            "verseOrgIds": [
              "NUM.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
