              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "muduuki yo, utulize zinguvu zio vusaalisi zia Haruni na uviiki mwana weve Elieza. Haruni azizaa kukuzira hene yaho.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.26",
            "verseOrgIds": [
              "NUM.20.26"
            ]
          }
        },
        {
