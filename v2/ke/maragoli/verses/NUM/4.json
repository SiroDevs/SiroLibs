              "type": "text"
            }
          ]
        },
        {
          "text": "Miyinzi jaavo gilava kuginga zimbaho zie Lihema, zimbohero, zitiru, mialiru, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
