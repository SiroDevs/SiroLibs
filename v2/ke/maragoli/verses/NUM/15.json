        "style": "s1"
      },
      "items": [
        {
          "text": "Malago Kigira Lihaana Kisiuviriru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.1",
            "verseOrgIds": [
              "NUM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "haane amalago yaga ku vandu va Isiraeli lwa vaduuka mu kivala cha yalaga alavaha vamenye mucho: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.2",
            "verseOrgIds": [
              "NUM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vahane ku Yahova igiriki, ligondi limigu, ligondi noho imburi vinyala kuhaanwa kuli vihaanwa viu kusambwa, noho vihaanwa viu kuduukiza liesuuha anoho kihanwa chu vuyanzi anoho kihanwa chi lisavo lia kazozo. Lifunya liu mwayu mulahi gwi vihaanwa yivi lilayaanziza yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku mundu woosi uhaana kihanwa chi ligondi noho imburi ku Yahova, alahaana harara nu uvusie vwu vuswage kiloguramu ndala uvuzuganyiywi mu na maguta lita ndala: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "harara na vuli ligondi limigu lie kihanwa chu kusambwa alahaana kandi iwaini ilita indala eve kuli kihanwa chu kunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.5",
            "verseOrgIds": [
              "NUM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa muhaana ligondi limigu, mulahaana harara nu vusie vwu vuswage zikiloguramu 2 vuzuganyiywi mu na maguta ilita indala ni inusu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "harara ni lita ndala ninusu yiwaini. Lifunya liu mwayu mulahi gwi vihaanwa yivi liyaanziza Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.7",
            "verseOrgIds": [
              "NUM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa muhaana igiriki eve kuli kihanwa chu kusambwa ku Yahova, noho kuli kihanwa chu kuduukiza liesuuha, anoho kihanwa chi mirembe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.8",
            "verseOrgIds": [
              "NUM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mulahaana harara nu vusie vwu vuswage zikiloguramu 3, uvuzuganyiywi mu na maguta zilita 2, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.9",
            "verseOrgIds": [
              "NUM.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "harara niwaini zilita 2. Lifunya liu mwayu mulahi gwi vihaanwa yivi liyaanziza Yahova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yivi nivio via muhaana harara na vuli igiriki, ligondi limigu, ligondi noho imburi ekole. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.11",
            "verseOrgIds": [
              "NUM.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Livaliza lie vindu yivi, lilameedeka kolondekana ni livaliza lie vihaanwa via muhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.12",
            "verseOrgIds": [
              "NUM.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli mundu woosi wivulwa ku vandu va Isiraeli, alakola gene yaga lwa aleetaa kihanwa chi viukulia ekeveeye ni lifunya liu mwayu mulahi liyaanziza Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mugeni woosi omenyi hagati hinyu mu makura ginyu goosi, na aveeye ni lienya kuhaana kihanwa chu kusambwa, ekeveeye chi lifunya liu mwayu mulahi liyaanziza Yahova, alakola ndio kolondekana na malago yaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vosi harara na vageni vamenyi hagati hinyu, valava na malago malala mere. Munyi vosi harara na vageni vamenyi hagati hinyu mulava kindu kilala imbiri wa Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malago malala mere galava ku munyi kandi ku vageni vamenyi hagati hinyu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
