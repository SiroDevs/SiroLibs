        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu alakola uvwoni vugira kumanya, alahaana imburi isuveni yu muhiga mulala eve kuli kihanwa chu vwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.27",
            "verseOrgIds": [
              "NUM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaalisi alakola muluka gwu kutakasa uvwoni vwu mundu uyu ku vwali, naye alasaamifwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
            "verseOrgIds": [
              "NUM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malago yaga galatumika ku vuli mundu okola uvwoni vugira kumanya; ave mundu wa Isiraeli noho mundu mugeni amenyi hagati haavo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.29",
            "verseOrgIds": [
              "NUM.15.29"
            ]
          }
        }
      ]
    },
