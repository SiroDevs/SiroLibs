            "sid": "NUM 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mukali waletwa alisuuha anaho alaga kwigaya kutura ku kindu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.10",
            "verseOrgIds": [
              "NUM.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "gamuduukira akole kindu choosi cha yisuha anaho chayalaga niiva musaza weve si alamugaya lwa hulira kuyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa niiva musaza weve alamugaya kutwekiza liesuuha lilie, sigamuduukira akole mba. Yahova alamusamiiha kigira musaza weve yamugaya kutwekiza liesuuha lilie. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaza weve aveeye nuvunyari kumuleka azizagiliri, anaho kumugaya kuzizagilira ni liesuuha anaho lilaga lia yaali nalombi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa niiva musaza weve alahulira liesuuha yili, ku lidiku yili mave nakikiri kumugaya, kuduuka akole vuli kindu choosi chamali kwisuuha anaho kulaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa niiva alagaya liesuuha kuduuka anyoore amageri kigira avuli kutwekiza liesuuha yili.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        }
      ]
