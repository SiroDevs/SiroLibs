          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukunzakali anaho mukali wakungwa nu musaza weve gamuduukira atwekizi liesuuha liayalomba kandi lilagana liosi liayigaya ku kindu chalio.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
