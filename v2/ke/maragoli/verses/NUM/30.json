        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mukaana ukikiri kuzia ilukali alisuuha mulienya lilie mwene naho kuvula kuganagana anaho kolomba lilagana kwigaya ku kindu, maku azie lukali, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.6",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gamuduukira akole vindu viosi via yisuha anaho via yalaga niiva musaza weve sialamugaya lwa hulira mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.7",
            "verseOrgIds": [
              "NUM.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa niiva musaza weve alahulira ma mugaye kutwekiza liesuuha yili, sigamuduukira agakole mba. Yahova alamusamiiha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
