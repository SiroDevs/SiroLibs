              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yahaana malago yaga ku vimiliri vi zihiiri zia vandu va Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
