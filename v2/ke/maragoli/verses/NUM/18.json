    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miyinzi ja Vasaalisi na vandu va Levi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Haruni, “Ivi, vayaayi vovo na vandu va Levi gamudukira munyore amageri kolondekana na mahiolo gu vutumiki mu lihema liange. Navuzwa ivi harara na vayaayi vovo mulanyola mageri kigira vutumiki kuli vasaalisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.1",
            "verseOrgIds": [
              "NUM.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olete aviiko vovo, ihiiri ya Levi, vayinziri nivi kandi vakokonye lwa ivi harara na vayaayi vovo mutumikaa mu lihema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.2",
            "verseOrgIds": [
              "NUM.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gavadukiraa kutwekiza minyinzi jaavo ku ivi kandi uvutumiki vwavo mu lihema, navuzwa sigavaduukira kudiira ku viju vitakatifu havundu Hatakatifu mba noho kwisunda himbi nu vwali mba. Ni vakora ndio vombi harara nivi mulitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.3",
            "verseOrgIds": [
              "NUM.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gavadukiraa vayinziri harara nivi kandi vatwekizi uvutumiki vwi miyinzi josi mu lihema, navuzwa umundu utaduukanaa sialayinzila nivi mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.4",
            "verseOrgIds": [
              "NUM.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivi na vayaayi vovo venyine gamuduukira mutwekizi uvutumiki vwa havundu Hatakatifu kandi ku vwali kunangwa vutima vwange vuvuli kwirana ku vandu va Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.5",
            "verseOrgIds": [
              "NUM.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi niye umali kotovola aviiko vovo ihiiri ya Levi, kutura mu vandu va Isiraeli vave kuli kihanwa ku ivi. Vatakaswa kigira inzi kunangwa vaduuki kokora miyinzi mu lihema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.6",
            "verseOrgIds": [
              "NUM.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa ivi harara na vayaayi vovo venyine mulatwekiza uvutumiki vwosi vwu vusaalisi ovolondekanaa nu vwali kandi ovoveeye havundu Hatakatifu ligali. Vindu yivi viveeye miyinzi jijo kigira mali kukuha kihanwa chu vusaalisi. Mundu woosi utaduukanaa, kwisunda ahimbi ni viju vitakatifu aliitwa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.7",
            "verseOrgIds": [
              "NUM.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ligavula lie Vihaanwa ku Vasaalisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.7",
            "verseOrgIds": [
              "NUM.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Haruni, “Wizulizi ndi ngoheza vidieli viosi viahaanwa ku inzi viavula kusambwa kuli visiuviliru. Mbihaana ku ivi harara ni visukululwi vivio kuli kidieli chicho mihiga ni mihiga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.8",
            "verseOrgIds": [
              "NUM.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yivi vilava vindu vienyu ku vindu viveeye vitakatifu ligali; vihaanwa viavula kusambwa nu muliru, vuli kihanwa chavo chu vuswage, vuli kihanwa chavo chu vwoni, vuli kihanwa chavo cha mahiolo, vindu viosi viletwaa ku inzi kuli vihaanwa vitakatifu niviivio harara na vayaayi vovo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.9",
            "verseOrgIds": [
              "NUM.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muliri vindu yivi havundu hatakatifu, kandi avasaza nivo venyine vanyara kuvilia; muvivuguli kuva vindu vitakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.10",
            "verseOrgIds": [
              "NUM.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.10",
            "verseOrgIds": [
              "NUM.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Komeeda ku yivi, vindu viosi viatakaswa via vandu va Isiraeli valeta kuinzi vilava vienyu. Mbihaana kuivi, avayaayi vovo kandi avakaana vovo mu ing'inga yoosi yiza. Mundu woosi winyumba yooyo oveeye mutakase anyala kuvilia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.11",
            "verseOrgIds": [
              "NUM.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.11",
            "verseOrgIds": [
              "NUM.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mbana kuivi vindu viosi vilahi viukutanga muligesa lia avandu va Isiraeli vahaana ku inzi vuli muhiga: amaguta ga muzeituni, iwaini kandi vuswage. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.12",
            "verseOrgIds": [
              "NUM.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viosi ni vivyo; mundu woosi wi nyumba yooyo oveeye mutakase anyala kuvilia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.13",
            "verseOrgIds": [
              "NUM.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.13",
            "verseOrgIds": [
              "NUM.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vuli kindu mu Isiraeli cha vula kutakaswa ku inzi ni chicho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vuli mwana wu kutanga noho umutugu gwukutanga gwa vandu va Isiraeli valeta ku inzi, viveeye vivio. Navuzwa gamuduukira muvugiliri umutungu gwu kugura vuli mwana wukutanga kandi gamuduukira muvugiliri umutungu gwu kugura vuli umutungu gwu kutanga ugutaveeye umutakase. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.15",
            "verseOrgIds": [
              "NUM.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vana vava nivaveeye mweli mulala gavadukiraa viirane kugulwa ku mutungu gwi vidonye vitano vie ifeza kolondekana nekegero chu mulihema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.16",
            "verseOrgIds": [
              "NUM.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa zing'ombe ziukutanga anoho amagondi ni zimburi siulilana kuvigula kandi mba. Yivi viosi viveeye viange kuduuka vihanwe kuli kisiuviriru. Uvisinzi na wuhi masahi gazio ku vwali ma usambe zitinya ziavio kuli kihanwa chi viukulia, kiveeye lifunya liu mwayu kuinzi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.17",
            "verseOrgIds": [
              "NUM.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama kutura kuvio ni yooyo kuli loveere kandi kinama chinyima chu mukono mulungi che kihanwa chu lugano lwa cho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.18",
            "verseOrgIds": [
              "NUM.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.18",
            "verseOrgIds": [
              "NUM.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mbihaana ku ivi, avayaayi vovo harara na vakana vovo, zing'inga ziosi ziza, vihaanwa viu lugano lwa vio, via vandu va Isiraeli valeta ku inzi. Yili ni lilagana litanyala kuvunagwa lia inzi mali kolomba nivi harara ni visukululwi vivio.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Haruni, “Siulanyora ku miandu ja wenyekaa uvuguli give jijo mba, kandi sikeveeye ho ne kedonye chu mulimi mu kivala cha Isiraeli cha onyoora mba. Inzi mbeeye Yahova, mbeeye viosi viawenyaa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ligavula lie Vihaanwa ku vandu va Levi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavoola, “Mali kuhaana ku vandu va Levi kidieli chi likomi chi vindu viosi via vandu va Isiraeli valeta ku inzi. Yiji nijo mitungu jaavo ku miyinzi javalindilaa Lihema liange liu kuvuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.21",
            "verseOrgIds": [
              "NUM.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vandi gavadukiraa vavuli kwisunda himbi ni lihema kandi muinzila yiyi valeletera madanyi ge likuza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.22",
            "verseOrgIds": [
              "NUM.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutura kalunu nu kuzizagilira ihiiri ya Levi valalinda Lihema kandi valalinda miyinzi jalio. Yaga na malago gamiihaa kuivi kazozo harara nivisukululwi vivio. Ihiiri ya Levi si ilava ni miandu jaavo ja kazozo mu kivala cha isiraeli mba.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.23",
            "verseOrgIds": [
              "NUM.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira mali kuhaana kuvo miandu ji kidieli chi likomi cha vandu va Isiraeli valeta ku inzi kuli kihanwa chu lugano lwa cho. Yaga nigo gajira nimbavolera sivalava ni miandu ja kazozo mu Isiraeli mba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kidieli cha Vandu va Levi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kovoolera vandu va Levi, “Lwa munyoora kidieli kutura ku vandu va Isiraeli cha inzi Yahova mbana ku munyi kuli imiandu, gamudukira muhaane kidieli chi likomi chu lugano lwa cho ku Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vihaanwa vienyu yivi vilafananywa ni vihaanwa viu vuswage viu mulimi alombaa kutura ku vuswage vuhia kandi iwaini imbia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.27",
            "verseOrgIds": [
              "NUM.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu inzira yiyi ulahaana kihanwa chu lugano lwa cho kidukanaa keve cha Yahova kutura kuvidieli viosi vionyoola kutura ku vandu va Isiraeli. Ulahaana vihaanwa viu lugano lwa vio viveeye via Yahova ku Haruni musaalisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gakuduukiraa uhaane ku Yahova kedonye keveeye kilahi ligali kandi kitakatifu kutura ku vuli kihanwa cha unyoola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa umala kuhaana kedonye keveeye kilahi, unyala kuviika vitigaye, kuli umulimi vitigaye namali kuhaana vihaanwa vivie ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.30",
            "verseOrgIds": [
              "NUM.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivi harara na vinyumba yooyo munyala kulira ivitigaye havundu hoosi, kigira viveeye mitungu jinyu kumiyinzi ja mukoraa mu lihema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi simulava na mahiolo lwa muvilia mba, niiva mulava ni muhaani vihaanwa vilahi ku Yahova. Navuzwa mulole ndi muvuli kwonogonyia vihaanwa vitakatifu via vandu va Isiraeli mulilia ku vihaanwa yivi ni mukikiri kuhaana kedonye chi vihaanwa vilahi ligali. Niiva mulakola ndio, munyi muliitwa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.32",
            "verseOrgIds": [
              "NUM.18.32"
            ]
          }
        }
      ]
    }
