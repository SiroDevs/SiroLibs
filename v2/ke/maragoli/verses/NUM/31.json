          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zibunda 30,500 zilava zia vasikari, 61 kuzio, zilava vusuuru vwa Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
