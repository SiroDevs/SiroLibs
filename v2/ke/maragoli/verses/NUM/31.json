          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli musaza wu vulwani yavugula vilaanye viayaali navuguyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
