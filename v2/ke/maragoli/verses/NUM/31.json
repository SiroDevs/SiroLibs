          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa koletaa viju vialombwa kutura ku ifeza, minyororo, visambo, ebede, zinono, zinale zio kumukono via vuli mulala kukunyi yavugula. Kuvihaana ku Yahova vive kuli mitungu ji livamwoyo lietu, kunangwa Yahova aduuki kukukinga.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
