              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandu vosi harara na vakali vagima avaari ni vakikiri kumanya mundu musaza vaali 32,000. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
