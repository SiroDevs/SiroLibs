          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa vugavuli vwa hagati ku vasaza vazia muliihi vulava; magondi ni zimburi 337,500 ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
