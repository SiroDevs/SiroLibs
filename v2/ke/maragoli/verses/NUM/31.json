          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi vakali vagima 16,000 valava ku vandu vu vulwani, 32 kuvo valava vusuuru vwa Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
              "NUM.31.40"
            ]
          }
        },
        {
          "name": "verse",
