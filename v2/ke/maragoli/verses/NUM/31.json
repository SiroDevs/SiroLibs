              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yivi ni vilaanye viavugulwa na vasaza vu vulwani komeeda ku viavivugulira: magondi ne zimburi 675,000 ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
            "verseOrgIds": [
              "NUM.31.32"
            ]
