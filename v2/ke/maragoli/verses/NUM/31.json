          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avalwaani valanyora zing'ombe 36,000, kandi 72 kuzio, zilava vusuuru vwa Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
