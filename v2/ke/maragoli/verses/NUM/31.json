          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku vimiliri vuvulwani vazia ku Musa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
          }
        },
        {
          "name": "verse",
