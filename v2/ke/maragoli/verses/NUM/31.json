          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni vavoola, “Mwami, kuuvalizi vandu vi liihi ma konyooye sihaveeye ho kali mulala wagota mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
