              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yahaana malago yaga ku Musa na Haruni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
