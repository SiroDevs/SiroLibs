        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vandu va Isiraeli vumbaka mahema gaavo, vuli mundu alalomba hokososera hehe isi we bendera yu muganda gwigwe harara ni vilolero via vaguuga vaavo. Valumbaka mahema gaavo kukumberiza Lihema liukuvuganiramu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        }
      ]
    },
    {
