            "sid": "NUM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihiiri ya Isakari ilumbaka himbi kuvo. Mwimiliri wavo naveeye Nezaneli muyaayi wa Zuari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.5",
            "verseOrgIds": [
              "NUM.2.5"
