              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihiiri yumbaka kulovega lwi Ivugwi wi liuva litongera, ilava ihiiri ye bendera yu muganda gwa Yuda. Mwimiliri wavo alava Nashoni muyaayi wa Aminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
