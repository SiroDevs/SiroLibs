          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku ihiiri ya Zabuloni ilava ahimbi ni ihiiri ya Isakari. Mwimiliri wavo naveeye Eliabu muyaayi wa Heloni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
