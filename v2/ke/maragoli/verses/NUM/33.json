          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatura Makelozi ni vazia ha Tahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.26",
            "verseOrgIds": [
              "NUM.33.26"
            ]
          }
        },
        {
          "name": "verse",
