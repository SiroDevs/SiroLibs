          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatura Rizima ni vazia ha Rimoni Perezi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.19",
            "verseOrgIds": [
              "NUM.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
