          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami wa Aradi wamenya Isavaalu wa Kanaani yahulira ndi avandu va Isiraeli vaali nivaaza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
