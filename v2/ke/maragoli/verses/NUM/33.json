          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutura Bezijeshimozi valomba hokososa ku luginga lwu mugera gwa Jorodani kolovega lwa Abeli Shitimu muvilelemo via Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
