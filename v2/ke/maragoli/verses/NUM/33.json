            "sid": "NUM 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatura ha Harada ni vazia Makelozi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.25",
            "verseOrgIds": [
              "NUM.33.25"
            ]
          }
        },
        {
          "name": "verse",
