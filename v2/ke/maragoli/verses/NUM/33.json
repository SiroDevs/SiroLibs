          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni yaali ni mihiga 123 lwa yakuzira mu kiguru cha Hori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
            "verseOrgIds": [
              "NUM.33.39"
            ]
          }
