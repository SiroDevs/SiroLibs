          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "vatura Alimoni Dibilazaimu ni vazia ha kiguru cha Abarimu nivakikiri kuduuka Nebo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.47",
            "verseOrgIds": [
              "NUM.33.47"
            ]
          }
        },
        {
          "name": "verse",
