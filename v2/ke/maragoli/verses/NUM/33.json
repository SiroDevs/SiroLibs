          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaatura Kelehazia ni vazia ha kiguru cha Shefari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.23",
            "verseOrgIds": [
              "NUM.33.23"
