          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Balaki yavolera Baalamu, “Usuyi kulaama vandu va Isiraeli, navuzwa nuyanza utavagasiza mba!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        }
