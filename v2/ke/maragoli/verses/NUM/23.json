          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavugana na Baalamu namuvolera chokovoora, ma niyiirana naamutuma ku Balaki kuhaana makuva ga Yahova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
            "verseOrgIds": [
              "NUM.23.16"
            ]
          }
        }
      ]
    },
