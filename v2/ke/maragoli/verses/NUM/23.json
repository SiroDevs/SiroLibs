          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki yavolera Baalamu, “Hamba ninzi na ndakuhila havundu handi kutura yaaha, mbula galayaanziza Nyasaye uvanaamili.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
