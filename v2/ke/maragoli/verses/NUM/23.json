          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalamu yavolera Balaki, “Nzumbakila vwali saba hano ma ondetere zigiriki saba na mamigu saba.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
