          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Balaki yavolera Baalamu, “Hamba ninzi kuzie havundu handi hunyala kololera valala ku vandu va Isiraeli. Uvanaamili kutura hene yaho.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki yaahira Baalamu mu kiguti cha Zofimu kondongozi yi kiguru cha Pisiga. Hene yaho yumbaka kandi vwali saba ma nahaana kihanwa chi giriki ni limigu ku vuli vwali.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalamu yavolera Balaki, “Singira hano himbi ni vihaanwa vivyo vyo kusamba, ninzi ndavugana na Nyasaye havundu hala.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
            "verseOrgIds": [
              "NUM.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
