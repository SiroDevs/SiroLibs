          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ugavuli kivala cha Kanaani hagati hi zihiiri, kolondekana nu vunyingi vwavo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.53",
            "verseOrgIds": [
              "NUM.26.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
