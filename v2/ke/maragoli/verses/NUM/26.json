          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Visukululwi via Yuda kolondekana ni viliango viavo vaali: Shela Perezi na Zera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.20",
            "verseOrgIds": [
