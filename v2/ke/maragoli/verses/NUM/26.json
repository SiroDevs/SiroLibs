          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.4",
            "verseOrgIds": [
              "NUM.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihiiri ya Rubeni muyaayi wu kutanga wa Yakobo: zihiiri zia Hanoki Palu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.5",
            "verseOrgIds": [
              "NUM.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezoroni kandi Karimi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.6",
            "verseOrgIds": [
              "NUM.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zihiiri yizi ziali avasaza 43,730, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.7",
            "verseOrgIds": [
              "NUM.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "visukululwi via Palu viali Eliabu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.8",
            "verseOrgIds": [
              "NUM.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na vayaayi veve vaali: Nemueli, Dazani, na Abiramu. Yava nivo avikiduma cha vandu vaatovora. Vambakana Musa na Haruni lwa vahambana nu muganda gwa Kora nivahing'ana na Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.9",
            "verseOrgIds": [
              "NUM.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lirova liguka ni livamira, kandi vakuza harara na Kora nu muganda gwigwe lwu muliru gwa diviza vandu 250. Vamanya nivagwa chukwiganihiza ku vandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.10",
            "verseOrgIds": [
              "NUM.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa avayaayi va Kora sivitwa mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.11",
            "verseOrgIds": [
              "NUM.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vihiiri ya Simioni Nemueli, Jamini, Jakini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.12",
            "verseOrgIds": [
              "NUM.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zera na Shauli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.13",
            "verseOrgIds": [
              "NUM.26.13"
            ]
          }
        }
      ]
