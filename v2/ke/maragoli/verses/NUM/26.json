        "style": "s1"
      },
      "items": [
        {
          "text": "Livaliza lia Kaviri lia Vandu va Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
