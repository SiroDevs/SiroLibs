            "sid": "NUM 26:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhaane kedonye kenene chi miandu ku ihiiri inene, kedonye kekekeeke ku ihiiri engekeeke. Vuli ihiiri ilanyoola miandu kolondekana nu vunyingi vwa vandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.54",
            "verseOrgIds": [
              "NUM.26.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 26:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa kivala kilagavulwa ku likuba ikura, kolondekana na mita ga vaguuga vaavo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.55",
            "verseOrgIds": [
              "NUM.26.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 26:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miandu jaavo gilagavulanywa kulikuba zikuura hagati hu vunyingi kandi vokekeeke vwi zihiiri.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.56",
            "verseOrgIds": [
              "NUM.26.56"
            ]
