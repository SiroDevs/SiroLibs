            "sid": "NUM 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu yakiring'anyia vandu vaali ni vililira imbiri wa Musa, yavoola, “Gendi kuzie kuvingilira kalunu na kuvuguli kivala yiki. Kunyi koveeye ni zinguru kandi kulakiguuta.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.30",
            "verseOrgIds": [
              "NUM.13.30"
            ]
          }
        }
      ]
