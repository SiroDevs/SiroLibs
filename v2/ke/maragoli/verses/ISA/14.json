{
  "id": "ISA.14",
  "number": "14",
  "bookId": "ISA",
  "reference": "Isaya 14",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "ISA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Avandu va Yahova viirana kutura mu vuhambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova alavelerera avandu veve Isiraeli, kandi alavatovola vave avandu veve omwene. Alavavika vamenye mu kivala chavo aveene, kandi avageni valaza komenya harara navo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.1",
            "verseOrgIds": [
              "ISA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zihiiri zindi zinyingi zilakonya avandu va Isiraeli kwirana mu kivala icha Yahova yavaha. Hene yaho, zihiiri zindi zilatumikira avandu va Isiraeli kuli avatugwa. Yavo avaari ni vagumira avandu va Isiraeli, kalunu Isiraeli ilavagumira, na vandu va Isiraeli valamiha ku yavo avavadambizaa ing'inga yindi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwami wa Babiloni mukihadisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova alasosiza avandu va Isiraeli kutura ku vusaliri nu vuzunu vwavo, kandi kutura ku miyinzi midinyu javanigirwa kokora. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwakola yaga, avandu va Isiraeli valakolera mwami wa Babiloni kehenyahenye nokovoora,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umwami umudambizi umali kugwa! Sialadambiza mundu kandi mba! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova umali koheriza zinguru zia avamihi vadamanu ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.5",
            "verseOrgIds": [
              "ISA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "avadambizaa avandu mu vutima, kandi si valekera kudambiza zihiiri zia vaali nivaguuti mba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.6",
            "verseOrgIds": [
              "ISA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu lirova liosi liveeye mu vusangali vwo vosoosi kandi ni mirembe, na vuli mundu yimbaa zinyimbu ziu vusangali. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.7",
            "verseOrgIds": [
              "ISA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali misaala ji midaragwa ja Lebanoni, jisangaliranga liigwa liu mwami wa Babiloni, kigira siaveeye ho mundu unyala kujitema mba, kigira umali kuzia!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.8",
            "verseOrgIds": [
              "ISA.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.8",
            "verseOrgIds": [
              "ISA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kihadisi chetegeki kuvugura mwami wa Babiloni. Mioyo midamanu ja yavo avaari vizingulu ku lirova jitangi kilage, kali mioyo ja vami vaakuza, jitulaa ku zindeve ziavo ziu vwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.9",
            "verseOrgIds": [
              "ISA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mioyo ja vami yava vosi jilamoloma nokovoolera mwami wa Babiloni, ndi, ‘Kalunu ivi oveeye mudedekere kuli kunyi! Oveeye mulala ku kunyi! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.10",
            "verseOrgIds": [
              "ISA.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivi Waali ni wahevwa luyali ligali harara ni zinyimbu ziuvukana zia wimbaa, navuzwa kalunu oveeye harara ni kunyi mu kihadisi. Ogoni ku kidali chi zing'ende kandi umali kukunikwa nu muling'eti gwi zing'ende.’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.11",
            "verseOrgIds": [
              "ISA.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.11",
            "verseOrgIds": [
              "ISA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwami wa Babiloni, eng'ereng'ani yu mumavwevwe, Ivi umali kutulwa hasi kutura mwigulu! Ing'inga ya kale ivi waguuta zihiiri ziosi, navuzwa kalunu umali kusiuvwa hasi ku lirova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.12",
            "verseOrgIds": [
              "ISA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivi wavoola mu mwoyo gugwo ndi, ‘Inzi ndazia mu ligulu, igulu wi zing'ereng'ani zia Nyasaye, ndaginga endeve yange yu vwami igulu; kandi ndikala kuli mwami ku kiguru chi livugana ihale wa Ivaale. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.13",
            "verseOrgIds": [
              "ISA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndazia igulu kuvita uvwerefu vwa malesi, kandi ndekola kuva kuli Nyasaye Wuvunyali.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.14",
            "verseOrgIds": [
              "ISA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa umali kwikizwa hasi mu luliva lwi kihadisi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.15",
            "verseOrgIds": [
              "ISA.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.15",
            "verseOrgIds": [
              "ISA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Avandu vakuza vakohenza nu kukwumika ligali. Valavoora ku ivi ndi, ‘Uyu niye umundu wasungusa lirova kandi nalomba uvwami ni vodegera? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.16",
            "verseOrgIds": [
              "ISA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu niye umundu wononyia amadara amanene, kandi nagirung'anyia kivala nikigwa changalangwe? Uyu niye umundu wavula kovoholora avahambe anoho kuvaleka vazie yengo?’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.17",
            "verseOrgIds": [
              "ISA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avami vosi vi lirova vayavirwa mu vilindwa viavo vilahi viu vwami, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.18",
            "verseOrgIds": [
              "ISA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "navuzwa ivi si oveeye ni kilindwa mba, muviri gwugwo gwa siuvwa ichova kugunda. Gwakunikwa ni miviri ja avasikari viitirwa mu vulwani ma vasiuvwa mu zimbangaywa zia magina, kandi jiduvagirwa hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.19",
            "verseOrgIds": [
              "ISA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivi siulatevwa kuli avami vandi mba, kigira wayononyia kivala chicho kandi wayita avandu vovo umwene. Kisukururwi cha yavo avakolaa uvudamanu sivalizulizwa kandi mba! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.20",
            "verseOrgIds": [
              "ISA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleke liitwa litange! Avana vu mwami uyu valakuza, kigira uvwoni vwa avaguuga vaavo. Siaveeye ho kali mulala uliamiiha lirova mba anoho kwumbaka amadara amanene mu lirova mba.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.21",
            "verseOrgIds": [
              "ISA.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyasaye aladiviza Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.21",
            "verseOrgIds": [
              "ISA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova Wuvunyali avoora, “Inzi ndingilira kivala cha Babiloni kandi ndakidiviza. Kindu kali kilala si kilatigala mucho mba, avana anoho mundu kali mulala sivalatigala mba. Inzi Yahova mali kovora. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakora kivala yiki kuva havundu hi vilungu komenya, kandi ndakekola kuva madavalia ga amazi, kandi ndeya kivala yiki na amenyo gu kudiviza. Inzi Yahova Wuvunyali mali kovora.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyasaye aladiviza avandu va Asiria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova Wuvunyali wisuhi ndi: “Ga inzi mali kolohiza galakoleka, kandi ga mali kotovola gekoleke galekoleka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
              "ISA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndadiviza avandu va Asiria avaveeye mu kivala change cha vandu vange Isiraeli, kandi ndavaduvagira hasi ku vigulu viange. Ndahaana vovoholore ku vandu vange kutura ku iniira ya avandu va Asiria, kandi ndatuliza misigo miliduhu kutura ku mavega gaavo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.25",
            "verseOrgIds": [
              "ISA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili ni lilohiza liange ku lirova liosi, kandi nanyiira mukono gwange kuhaana amageri ku zihiiri ziosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.26",
            "verseOrgIds": [
              "ISA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova Wuvunyali umali kotovola kuhaana amageri ku vandu va Asiria, na siaveeye ho mundu unyala kumugaya kokora yaga mba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.27",
            "verseOrgIds": [
              "ISA.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyasaye aladiviza avandu va Filisitia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.27",
            "verseOrgIds": [
              "ISA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili ni likuva lialandizwa mu muhiga gwu mwami Ahazi yakuza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.28",
            "verseOrgIds": [
              "ISA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi avandu va Filisitia, mutasangala kigira imbimbu imukuya imali kuvunika mba. Lwa enzoka indala ikuzaa, kihirigoma kiiza mu vogono vwayo. Kihirigoma yiki, kilatera livuyu limanya lialuri enzoka yu kuburuka nu muliru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.29",
            "verseOrgIds": [
              "ISA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova alava umwami ku vandu veve vadaka, kandi alaleka vamenye mu mirembe, navuzwa alatuma inzara enene ku vandu va Filisitia, na vosi valakuza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.30",
            "verseOrgIds": [
              "ISA.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.30",
            "verseOrgIds": [
              "ISA.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, munyi avandu vi lidaala linene lia Filisitia, mulire kandi mwanire ovokonyi! Uluguchi luzaa kutura Ivaale, oveeye iliihi litaveeye mu na vandu vataveeye nu vuti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.31",
            "verseOrgIds": [
              "ISA.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.31",
            "verseOrgIds": [
              "ISA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu alativulira ki avatumwa vi zihiiri kutura Filisitia? Kulavavoolera ndi, “Yahova umali kusingiliza musingi gwa Ziyoni, na avandu veve avadambizwa valirukirayo nokonyoora ovohonyi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.32",
            "verseOrgIds": [
              "ISA.14.32"
            ]
          }
        }
      ]
    }
