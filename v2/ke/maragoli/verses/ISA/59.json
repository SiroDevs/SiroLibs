{
  "id": "ISA.59",
  "number": "59",
  "bookId": "ISA",
  "reference": "Isaya 59",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "59",
        "style": "c",
