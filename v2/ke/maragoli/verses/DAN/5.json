            "number": "29",
            "style": "v",
            "sid": "DAN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonoho mwami Belishaza yahaana lilago ku vatumikiri veve vaviiki Danieli inguvu yu vwami yi rangi yu musambarao, kandi nivamwavala mu ligoti lilie munyororo gwa lombwa ku izahabu. Yamukola kuva munene wa kavaga mu vwamihi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.29",
            "verseOrgIds": [
              "DAN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vudiku vwene yivwo, mwami Belishaza wa Babiloni yitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
              "DAN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dariasi kutura mu kivala cha Medi, waali naveeye ni mihiga 62 ya vugula vwami.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
            "verseOrgIds": [
              "DAN.5.31"
            ]
          }
        }
