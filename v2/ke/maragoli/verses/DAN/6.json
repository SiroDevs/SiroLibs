              "type": "text"
            }
          ]
        },
        {
          "text": "Maku mwami yahaana malago vandu vosi vayaala Danieli vagumirwi kandi vasiuvwi harara na vakali vaavo na vana vaavo mu luhangaywa lwizura zisimba. Lwa vaali ni vakikiri kotonya mu luhangaywa, zisimba ziavamamira kandi nizivunanyia vigumba viavo viosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.24",
            "verseOrgIds": [
              "DAN.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku mwami Dariasi yang'odera vivala viosi, zihiiri ziosi ni zinimi ziosi navoora,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        }
