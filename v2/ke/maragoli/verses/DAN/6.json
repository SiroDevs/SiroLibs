          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbana malago ndi mu vwamihi vwange vwosi vuli mundu gamuduukira atie kandi ahaane luyali ku Nyasaye wa Danieli.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
