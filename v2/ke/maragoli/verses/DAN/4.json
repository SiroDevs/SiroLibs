            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuva yaga gaamanya ni gaava giligali. Mwami Nebukadineza ya kungwa mu vandu kandi yaya vunyasi kuli igiriki yu kulima. Lime liaguluka kuye, kandi liisu lilie liaviruka ligwa litambi kuli mavaha gi indizu, kandi masanda geege gatambiha kuli ga manyonyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nebukadineza Yizominya Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami yavoola, “Lwi mihiga 7 jaali ni jakavita,” ndahenza mu ligulu, kandi vulamu vwange vwirana. Ndizominya Nyasaye Wuvunyali kandi ndahaana luyali nu vukumi ku omenya mihiga ni mihiga. Alakamiihi mihiga ni mihiga kandi vwamihi vwivwe vulakahindili zing'inga ziosi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lwu vulamu vwange vwirana, luyali lwange, vonene vwange kandi vukumi vwange vwirana ku inzi. Vamiihi vange kandi vandu vamenyi munyumba yu vwami, vanzingiliza kandi ndilanyilwa zinguru ziu vwamihi vwange kali nu luyali lonene ligali kuvita maziambiri.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kalunu, Inzi Nebukadineza ndizominya, nimbana luyali kandi nu vukumi ku mwami wu mwigulu. Vuli kindu choosi chakolaa keveeye kilungi kandi chi likalaga lirungi, kandi agehizaa vuli mundu woosi oveeye ni liegingira.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.37"
            ]
          }
        }
      ]
