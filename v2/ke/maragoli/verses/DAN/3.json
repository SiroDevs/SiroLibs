          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami yavoola, “Nyasaye wa Sadaraka, Meshaka na Abedinego yizominywe! Yatuma engelosi yeeye nesoola vandu yava avamusuuvira, si vaatia malago gange mba. Vaviika livamwoyo liavo mu vuhimwa mulivula kusigamira Nyasaye wundi nataveeye nyasaye wavo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.28",
            "verseOrgIds": [
              "DAN.3.28"
            ]
          }
        }
