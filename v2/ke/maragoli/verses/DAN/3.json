          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kalunu ndagizaa ndi, mundu woosi wi kivala choosi, zihiiri ziosi, anoho lulimi lomoloma makuva gu kuchaya Nyasaye wa Sadaraka, Meshaka na Abedinego, vivero vivie viladonyanywa, na inyumba yeeye ilava kitumi cha makindi. Si aveeye ho na nyasaye wundi unyala kohonyia kuli ndi mba.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.29",
            "verseOrgIds": [
              "DAN.3.29"
            ]
          }
        }
