          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Navuzwa kigira ki ndolaa vandu vane vagendagenda mu muliru? Si vavoheywe mba, kandi si vaveeye ku ne kelolero chu kumanyia ndi vasaliriziywi mba. Mundu wa kane, alolekaa kuli engelosi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vasaza vavaga vavoholorwa no konenehizwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
