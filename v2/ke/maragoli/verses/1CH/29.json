          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yanenehiza Solomoni ligali imbiri wi ihiiri yoosi ya Isiraeli, nu kumuha uvukumi vwu vwami, uvwavula kuva ho ku mwami wundi woosi mu Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Liamiiha lia Daudi mu vwimbi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
