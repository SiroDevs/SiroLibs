  "reference": "1 Zing'Inga 22",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1CH 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Daudi yavoola, “Yaaha niho ahe Litembeli lia Yahova Nyasaye lilakave. Yivu nivwo vwali aha avandu va Isiraeli vaduukana kuhaanira ku vihaanwa viukusamba.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lietegeka kwumbaka Litembeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Daudi yahaana malago ku vageni vosi vamenyi mu kivala cha Isiraeli vavugane harara na yavavika ku miyinzi. Valala kuvo vavaaza magina gu kwumbakira Litembeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
            "verseOrgIds": [
              "1CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahaana kandi ivivia vinyingi okolomba misumari kigira miliango ji virivwa kandi ji vivohero vie zimbaho, kandi mugasa munyingi ligali kali si haali nu mulala uwaali unyala kugubima mba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalohiza ndi avandu va Tiro na Sidoni vamuleetere misaala minyingi ligali ji midaragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yevolera; “Muyaayi wange Solomoni aveeye mwana musoleri kandi vugira limanya; na Litembeli liumbakirwa Yahova kuduuka live linene kandi lilahi, na liu kwizominywa kandi liu vukumi mu zimoni zie zihiiri ziosi. Kunangwa ndalomba lietegekiza lia lio liosi.” Kunangwa Daudi yalomba vindu vinyingi mu lietegekiza uvwumbaki nakikiri kukuza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Daudi yatumana muyaayi weve Solomoni yaaze, kandi namuvolera yumbakiri Yahova Nyasaye wa Isiraeli Litembeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yamuvolera, “Mwana wange, Inzi mwene ndeenya kwumbaka Litembeli kuhaana luyali ku Yahova Nyasaye wange. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Yahova yambolera ndi ndamala kwiita avandu vanyingi ligali nu kulwaana amahi manyingi. Na ndio, kigira amasahi manyingi gandatahiza, sianyala koleka mwumbakiri Litembeli mba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa yanombera lisuuvirizwa. Yavoola, ‘Ulivuula muyaayi uliamiihi mu mirembe, kigira ndakamuhe mirembe kutura ku avasigu veve vosi. Lieta lilie lilakave Solomoni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:9",
              "type": "text"
            },
            {
              "text": "Solomoni:",
              "type": "text"
            },
            {
              "text": "Lieta yili litulaa ku lieta liu Luheburaina “Shalom”; liveeye kovora - “Mirembe no vosoosi.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kigira mu ing'inga yi liamiiha lilie, alakahe Isiraeli mirembe no vosoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwene uyu alakanyumbakiri Litembeli. Alakave mwana wange, na ndakave baba weve. Endeve yu vwami vwivwe ilaamiiha Isiraeli mihiga ni mihiga.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaazizagilira, “Kalunu, mwana wange, Yahova ave Nyasaye woovo harara ninze, kandi atwekize lisuuvirizwa lilie kandi akugasize mu limwumbakira Litembeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova Nyasaye woovo akohe limanya linyingi, kandi ovogeri kunangwa uduuki kwamiiha Isiraeli kolondekana ni Lilaga lilie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva ulahulira malago goosi ga Yahova yaaha Musa kigira Isiraeli, ulagasizwa ligali. Uguluhi ove wi zinguru kandi muluviliri. Utatia mba kandi utahenda mwoyo mba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulwi Litembeli, kuzinguru ziange mali kuvungiza kuvita zikilo 3,400,000 zie zahabu kandi kuvita zikilo 34,000,000 zie feza ukutumikirwa mu liumbaka Litembeli. Komeeda ukwene yikwo, haveeye ho kandi nu mugasa ni vivia vinyingi vinyala kuvula kuvalizwa. Mbeeye kandi ni zimbaho kandi na magina mulietegeka, navuzwa kuduuka ivi omeede ku ivindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivi oveeye na vayinziri vanyingi. Vaveeye ho avasaza vukuvaaza magina, avasiza vu kwumbakira magina, avasiza vu kutumikira zimbaho, kandi avasiza vi limanya linyingi kandi vi zing'ano ziosi avanyala kuyinzira, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.15",
            "verseOrgIds": [
              "1CH.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni zahabu ifeza, mugasa kandi kivia. Kalunu tanga miyinzi, na Yahova ave harara nive.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yavolera aviimiliri vosi va Isiraeli vakoonye muyaayi weve Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.17",
            "verseOrgIds": [
              "1CH.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavoola, “Yahova Nyasaye winyu yaveyange ni munyi kandi ukuheeye mirembe ku zimbega zizio. Yagila ninguuta avandu vosi avamenyaa mu kivala yiki, na vosi vaveeye avatumikiri vovo kandi va Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.18",
            "verseOrgIds": [
              "1CH.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu tumikira Yahova Nyasaye woovo nu mwoyo gugwo gwosi kandi na roho gugwo gwosi. Tanga iliumbaka Litembeli kunangwa ove unyala kuviika mu Lisandugu lie Lilagana lia Yahova, kandi viju vitakatifu vindi viosi ivitumikirwaa mu lisigamira Yahova.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
          }
        }
      ]
    }
  ],
