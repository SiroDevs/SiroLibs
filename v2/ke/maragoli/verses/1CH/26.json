          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu visukululwi via Izihari, Kenania na vayaayi veve vagavulilwa miyinzi ju kwamiiha: kulinda mang'oda, kumala ovosooro nu kuhambanyia avandu va Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
