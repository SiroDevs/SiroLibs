              "1CH.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu visukululwi va Heburoni, Hashabia harara na aviiko veve 1,700, avasaza vosi avadukiru, vaviikwa kusingilira uvulindi vwi miyinzi ja Yahova, kandi amakuva gu vuyinziri mu Isiraeli, Imadioli wu mugera gwa Jorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeria yaali mwimiliri wi Ivisukulurwi va Heburoni. Mu muhiga gwa arubaini gwa Daudi yaali mwami, litunyiriza liali ho ku aviiko vi zinyumba zia ivisukulurwi va Heburoni, makandi avasikari avadukiru avaari nu vwiko ni inyumba yiyi vaanyoolwa nivamenyi ha Jazeri mu kivala cha Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Daudi yatovola aviimiliri avadukiru vi zinyumba; kutura mu aviiko va Jeria 2,700 saba ma navavika kusingila uvulindi vwi miyinzi ja Yahova josi, makandi amakuva gi miyinzi mu Isiraeli Ivugwi wu mugera gwa Jorodani, vivala via Rubeni, Gadi na Ivugwi wa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.32",
            "verseOrgIds": [
              "1CH.26.32"
            ]
          }
        }
