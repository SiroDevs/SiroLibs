          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moza yivula Bineya, Bineya yivula Rafa, na Rafa yivula Elieza, na Elieza yivula Azeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        }
      ]
    },
