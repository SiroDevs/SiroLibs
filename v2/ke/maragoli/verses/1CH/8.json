          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Visukululwi va Shimei vaali harara na Jakimu, Zikiri, Zabadi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.19",
            "verseOrgIds": [
              "1CH.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elienai, Zilezai, Elieli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.20",
            "verseOrgIds": [
              "1CH.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
