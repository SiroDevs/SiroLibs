          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:34",
              "type": "text"
            },
            {
              "text": "Meribaali:",
              "type": "text"
            },
            {
              "text": "Meribaali liamanyikana kandi kuli Mefiboshezi mu 2 Samweli 4:4.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", Meribaali yivula Mika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        }
