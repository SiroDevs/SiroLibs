          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwavo Azeli, Esheki yivula vayaayi vavaga: Ulamu, Jeushi, na Elifeleti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
