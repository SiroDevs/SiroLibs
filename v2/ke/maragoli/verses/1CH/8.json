          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yava vaali aviimiliri va avizinyumba zia vaguuga vaavo mu makura goosi, avanene, avamenyaa mu Jerusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
            "verseOrgIds": [
              "1CH.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihiiri ya Benjamini vamenya mu Gibeoni na Jerusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
