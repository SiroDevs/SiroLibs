          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika yivula vayaayi vane: Pizoni, Meleki, Tarea, na Ahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        },
