          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri yivula Kishi, na Kishi yivula mwami Saolo. Saolo yivula avayaayi vane: Jonazani, Malikishua, Abinadabu, na Eshibaali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:33",
              "type": "text"
            },
            {
              "text": "Eshibaali:",
              "type": "text"
            },
            {
              "text": "Eshibaali yalangwa Ishiboshezi mu 2 Samweli 2:8 kandi havundu handi hoosi mu 2 Samweli.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
