          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Visukululwi va Jerohamu vaali mu na Shamusherai, Sheharia, Azalia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.26",
