          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanania, Elamu, Anzirozija, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.24",
            "verseOrgIds": [
              "1CH.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifudeia na Penueli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.25",
            "verseOrgIds": [
              "1CH.8.25"
            ]
          }
        }
      ]
    },
    {
