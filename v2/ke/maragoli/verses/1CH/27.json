          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili nilio lilohiza lia amita ga avamihi vi zihiiri zia Isiraeli:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        }
