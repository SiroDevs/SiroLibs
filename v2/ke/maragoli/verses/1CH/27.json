          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munene wu muganda gwa komi na mbiri, ku mweli gwa komi na mbiri, yaali Helidai kisukururwi cha Ozinieli kutura Netofazi. Gwaali muganda gwa vandu 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uvwamihi vwi zihiiri zia Isiraeli",
          "type": "text"
        }
      ]
    },
    {
