              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonazani, koza wa Daudi yaali muhaani wi ziganigani mugeri ligali kandi mwigizi wi Lilaga. Oyo na Jehieli, muyaayi wa Hakimoni, vaali avasingiliri vi lisoma lia avana va avami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahizofeli yakonya mwami na makuva; na Hushai kutura Akiti, yaali mulina wu mwami Daudi kandi umwideeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyima wi likuza lia Ahizofeli, Abiazari na Jehoyada muyaayi wa Benaya vaagwa vahaani vi zing'anagani. Joabu yaali munene wi liihi liu vwami.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
