          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azareli muyaayi wa Jerohamu yaali mwimiliri wi ihiiri ya Dani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
