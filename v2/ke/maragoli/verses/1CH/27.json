          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munene wu muganda gwa komi na moja, ku mweli gwa komi na moja yaali Benaya kutura Pirazoni, mu kivala chi ihiiri ya Efuraimu. Haali ho na vasaza vi liihi ine 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        }
