          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Daudi si yavaliza avandu vaavo avaari haasi hi mihiga sirini mba, kigira Yahova yaali niyasuuviriza kokora Isiraeli kuva vanyingi kuli zing'ereng'ana ziu mwigulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu muyaayi wa Zeruya yaatanga kuvaliza, navuzwa si yamala kokora ndio mba, nitali uvutima vonene vwa Nyasaye vwaduuka ku Isiraeli kigira agene yaga. Livaliza yili si liang'odwa mu vitabu viu mwami Daudi viu vwami.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vi miandu ju vwami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
