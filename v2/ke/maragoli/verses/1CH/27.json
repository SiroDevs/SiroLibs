          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili ni lilohiza lia mita ga avamiiha ku miandu juvwami:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
