            "number": "16",
            "style": "v",
            "sid": "1CH 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elieza muyaayi wa Zikiri yaali mwamihi ku ihiiri ya Rubeni; Shefatia muyaayi wa Maaka yaali mwamihi ku Ihiiri ya Simioni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        }
      ]
