          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaya muyaayi wa Obadia yaali mwimiliri wi ihiiri ya Zabuloni. Jeremozi muyaayi wa Azirieli yaali mwimiliri wi ihiiri ya Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
