            "sid": "1CH 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashabia muyaayi wa Kemueli, yaali mwimiliri wi ihiiri ya Levi, na Zadoku yaali mwimiliri wi ihiiri ya Haruni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
