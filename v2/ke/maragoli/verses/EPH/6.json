  "reference": "Vaefeso 6",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EPH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avana muhuliri aviivuli vinyu mu Mwami, kigira yili iliveeye lirungi ku munyi kokora. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.1",
            "verseOrgIds": [
              "EPH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Haane luyali ku baba winyu na mama winyu.” Yili liveeye lilaga liu kutanga iliveeye ni lisuuvirizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.2",
            "verseOrgIds": [
              "EPH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kunangwa goosi gaduuki kuva vulahi kumunyi, kandi muduuki kuhindira mu lirova.”",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi aviivuli, mutakola avana vinyu kuva nu vutima, navuzwa muvavirukizi kandi muvalindi mu liegiza kandi mu lieganihiza liu Vukristayo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Avatugwa na vanene vaavo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi avatugwa muhaane luyali ku vanene vinyu vu mu lirova kandi muvatie ligali. Mukore ndio nimioyo jinyu josi kuli mukutumikiraa Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.5",
            "verseOrgIds": [
              "EPH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutava vutumiki vwu kuyanziza vandu kigira mwenya vamuvugiliri mba, mukore kuli Nyasaye yenya nimioyo jinyu josi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.6",
            "verseOrgIds": [
              "EPH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukore miyinzi jinyu kuli vatugwa nu vuyanzi, kuli mwaali nimutumikira mwami; kandi gatava kuli mwatumikira mundu mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.7",
            "verseOrgIds": [
              "EPH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwizurizi ndi, Mwami alakahaane madanyi ku mundu woosi ave mutugwa anoho muvoholore.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.8",
            "verseOrgIds": [
              "EPH.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.8",
            "verseOrgIds": [
              "EPH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi avami, muvakolere avatugwa vinyu vindu zana yivi kandi, munzira ndala nzere vugira kutumikira litihiza. Mwizurizi kumanya ndi munyi harara na avatugwa vinyu muveeye nu Mwami mulala mwigulu, ukalagiraa mundu sa mulala keleng'ani vugira liyanzilira liosi.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Viuma viosi via Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agekeheri, avaamitu vange muve nizinguru mu Mwami kandi mu vonene vwi zinguru zizie. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.10",
            "verseOrgIds": [
              "EPH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiviki viuma viosi via Nyasaye amuhezaa, kunangwa muduuki kuhingira ku vudamanu vwa Setani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.11",
            "verseOrgIds": [
              "EPH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvulwani vwitu sivoveeye ku avandu, navuzwa ku mahi ga mademoni gu muvwerefu, uvwamihi, uvunyali kandi ku yavo avamiiha kivala chi kisundi yiki, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.12",
            "verseOrgIds": [
              "EPH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira yaga, mwiviki viuma viosi via Nyasaye, muduuki kunyala kuhingira uvulwani vwu musigu mu madiku madamanu kandi nimumaliyi kulwaana kuduuka ku keheri, mulasingira vudinyu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.13",
            "verseOrgIds": [
              "EPH.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.13",
            "verseOrgIds": [
              "EPH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa singiri vudinyu ni mwevohi agiligali kuli umusibi mu vikenge vienyu, kandi ni mwiviki uvulungi kuli isalamba, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.14",
            "verseOrgIds": [
              "EPH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi kuli vilatu vienyu mu virenge, mwetegeke kwilwaza Ivangeri yi mirembe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.15",
            "verseOrgIds": [
              "EPH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvita yaga goosi, mugiingi inguva yi lisuuvira kazozo, ya mulinyala kusiminyira uvuta ni mivano josi ju muliru ju mudamanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.16",
            "verseOrgIds": [
              "EPH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiviki igudwa yo vohonyi, kandi muvuguli kivavi cha Roho Mutakatifu, nacho ke veeye likuva lia Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.17",
            "verseOrgIds": [
              "EPH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaale zing'inga ziosi kuli Roho amwimilira; nimusavaa vokonyi ku Nyasaye, kigira yaga goosi mwetegeke kandi mutakuzi mioyo mba. Muhongere mu lisalira vandu va Nyasaye kazozo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.18",
            "verseOrgIds": [
              "EPH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaliri kandi kunangwa Nyasaye aduuki kuhaana ku inzi chanyala kovora lwa moloma nuvuluviliri, nokuvuula agaviswa gi Ivangeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.19",
            "verseOrgIds": [
              "EPH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira Ivangeri yiyi inzi mbeeye mutumwa kali niiva mbeeye muvuhambe kalunu. Musaliri nduuki kugevoola novuluviriri mu lilwaza Ivangeri kuli gandukira kovora.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Licheliza lio kumaliriza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukiko, amiitu wiitu muyanze, kandi oveeye mutumikiri musuuvirifu mu miyinzi ju Mwami, alamuvolera vindu viosi kigira inzi, kunangwa munyi muduuki kumanya kuli nzizagilira. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.21",
            "verseOrgIds": [
              "EPH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiki nicho kivuni kijiri nimutuma ku munyi muduuki kumanya kuli kunyi kuzizagiliraa kandi amudinyirizi.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye Baba kandi Mwami Yeso Kristo ahaane mirembe, uvuyanzi kandi lisuuvira ku avaamitu Vakrisitayo vosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
            "verseOrgIds": [
              "EPH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimbavasi zia Nyasaye zive na yavo vosi avayaanzaa Mwami wiitu Yeso Kristo, ni liyaanza litaveeye ne keheri.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.24",
            "verseOrgIds": [
              "EPH.6.24"
            ]
          }
        }
      ]
    }
  ],
