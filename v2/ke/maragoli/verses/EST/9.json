          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibarwa zana yang'oderwa Avayuda vosi, muvivala viosi 127 viu uvwami vwa Pasia, vwu umwami Ahasuero yamiha. Ibarwa yiyi yenyeraa Avayuda mirembe ni likingwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
