          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lilaga liu mwami ililago yili lialandizwa mu lidaala linene lia Susa, na avanyaguli vaahira amakuva yaga muvivala viosi via Ahasuero yamiha. Umwami na Hamani viikara harara ni vanwa iwaini lwi lidaala lia Susa liali niliveeye mu ligoyana ni ligenya linene ligali.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.15",
            "verseOrgIds": [
              "EST.3.15"
            ]
          }
        }
      ]
    }
