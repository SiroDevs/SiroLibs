    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hamani alohizaa kudiviza Avayuda muvwivisu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwi ivindu yivi viosi viali niviakakoleka, mwami Ahasuero yanenehiza Hamani muyaayi wa Hamedaza, uwi kisukururwi cha Agagi",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:1",
              "type": "text"
            },
            {
              "text": "Agagi:",
              "type": "text"
            },
            {
              "text": "Yaali mwami wa Avamaleki. Avandu veve vaali vasigu vanene va avandu va Isiraeli.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nukumuha endeve yuluyali yu kwamiiha vanene vandi vosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami yalaga avanene veve vosi kumanyia uluyali ku Hamani mu lisigama nu kwinama imbiri weve. Vosi vavugilira kokora ndio, nataveeye Modekai, yasura kusigama nu kwinama imbiri weve. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.2",
            "verseOrgIds": [
              "EST.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avanene vandi mu vutumiki vwu vwami vateva Modekai ikivuni kigira navula kuhulira lilaga liu mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.3",
            "verseOrgIds": [
              "EST.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamoloma ku Modekai vuli lidiku nivamugoonya aleke miima yijo, navuzwa yasura kuvugilirizana navo, yasura kokora ndio ku kivuni ndi, oyo yaali Muyuda, na sianyala kwinamira Hamani mba. Kunangwa, vamanya nivavolera Hamani amakuva yaga mbula valore niiva aliikuzira ku makuva yaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.4",
            "verseOrgIds": [
              "EST.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Hamani yanyoora ndi Modekai si azizanga kusigama nu kwinama imbiri weve, yaali nu vutima vonene ligali, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi lwa Hamani yamanya ndi, Modekai yaali Umuyuda, yamanya ndi ukuhaana amageri ku Modekai yeng'ine vuzwa sikulamuduuka mba. Yalohiza ukwita Avayuda vosi avaari mu vwamihi vwa Ahasuero mu Pasia.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa komi na mbiri gwi liamiiha liu Mwami Ahasuero, mu mweli gwa Nisani, gwukutanga mu muhiga mutakatifu, Hamani yalaga ikura ikubwi iyalangwa Purimu ku vanyoore ing'inga indahi yu kudiviza Avayuda. Kunangwa lidiku lia komi na tatu liu mweli gwa komi na mbiri, mweli gwa Adari, liatovolwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Hamani yavolera umwami, “Ihiiri ndala eveeye ho iyasalanywa mu vuli kivala cha ivi wamihaa. Amalago gaavo gaveeye lugano kutura ku aga vandu vandi. Kuvita goosi sivahulira amalago gu vwamihi mba. Kunangwa sivoveeye vulahi ivi wikuziri ku avandu yava mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva yaga galayaanziza ivi, umwami, haana lilago ling'odeywi kovora ndi yava vosi viitwi. Niiva ulakola ndio, inzi ngusuuvirizaa ligali ndi, ndatunga zikilo 340,000 ziefeza mu livikiru liu mwami kigira uvuyinziri yivu.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami yaatuliza imingiri yeeye ku kedete, iyaatumikirwa kuli umuhuri kumanyia ndi amang'oda yago gaveeye nu vunyali vwivwe, nagihaana ku Hamani, muyaayi wa Hamedaza, kisukururwi cha Agagi uwaali umusigu wa Avayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.10",
            "verseOrgIds": [
              "EST.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami yavolera Hamani, “Avandu harara na mabese gaavo, viosi ni vivio kola kuli ivi uyanza.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku lidiku lia komi na tatu liu mweli gwukutanga, Hamani yalanga avang'odi vu mwami kandi nasoma lilaga yili ligirung'anywi mu vuli lulimi lwa avandu kolondekana ni lilohiza lia mang'oda agatumikaa mu vwamihi nukutumwa ku avamihi vosi lilandizu lielilaga liu mwami yili liatulizwa mu lieta liu mwami Ahasuero kandi niliduywa ku muhuri gwi mingiri yeeye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.12",
            "verseOrgIds": [
              "EST.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avanyaguli vaanyaguliza lilaga yili ku vuli kivala chu mwami yamiha ku. Lilaga yili liali ndi ku lidiku lia komi na tatu liu mweli gwa Aderi, Avayuda vosi, avang'erere kandi avahindira, avakali na avana vakekeeke harara kuduuka viitwi ku lidiku lilala vuzwa. Gavadukiraa vasinzwi vugira liverererwa, na ivindu viavo viosi vilaanywi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaali mu lilaga zana gaduukanaa gamanyikane ku avandu vosi mu vuli kivala, kunangwa vuli mundu ave ni yetegeki lwi lidiku zana liduka.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
