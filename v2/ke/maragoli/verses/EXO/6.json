          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavoola, “Inzi mbeeye Yahova. Volera mwami wa Egebeti ivindu viosi via ngovolera.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
