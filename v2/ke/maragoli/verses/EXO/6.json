              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni na Musa vaali nivo ava Yahova yavolera, “Mwimiliri zihiiri zia Isiraeli kutura Egebeti.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
