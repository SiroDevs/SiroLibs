    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lihema lia Yahova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Olombe mugati mwi Lihema litakatifu liukuvuganira mu, Lihema liukwaganira mu ninzi, kutura ku vidonye likomi vie katani indahi, vianavwa kutura ku vwoya vwirangi ya bulu, muzambarao kandi inzakanyu. Uviiki ku amangirinya ga vakerubi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:1",
              "type": "text"
            },
            {
              "text": "Vakerubi:",
              "type": "text"
            },
            {
              "text": "Zingelosi.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olombe vuli kedonye keve keleng'ani, ni kindi keve nu vutambi vwi zimita likomi na ziviri nu vuvambalaru zimita ziviri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unave vidonye vitano kuvio vive kedonye kilala, kandi okole ndio ku vindi vitano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.3",
            "verseOrgIds": [
              "EXO.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olomba iviulu vie inguvu ya bulu kundulu ichova wa vuli kedonye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.4",
            "verseOrgIds": [
              "EXO.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uviiki iviulu amusini ku kedonye chukutanga kandi chakaviri viduuki koleng'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.5",
            "verseOrgIds": [
              "EXO.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olombe kandi vigumilu vie zahabu vindi 50 viukuhambanyira vidonye yivi kuva kedonye kilala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Olombe kikuniku chi Lihema kutura ku vidonye inguvu ivialombwa ku vwoya vwi zimburi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.7",
            "verseOrgIds": [
              "EXO.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olombe viosi vive vileng'anu, uvutambi vwi zimita likomi na zivaga nu vuvambalaru vove zimita ziviri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unave vidonye vitano kuvio vive inguvu ndala, nizindi sita zive kandi inguvu yindi. Ulingi kedonye cha sita haali kaviri imbiri wi Lihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.9",
            "verseOrgIds": [
              "EXO.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uviikaa iviulu amusini kundulu kwe kedonye chukumaliriza, kandi iviulu amusini kundulu kwe kedonye kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.10",
            "verseOrgIds": [
              "EXO.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olomba vigumiliru kuli zindoani ziu mugasa amusini muviiviki muviulu viung'anyie vidonye vindi yivio ku viduuki kolomba inguvu yukukunika eve indala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.11",
            "verseOrgIds": [
              "EXO.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu suungi inusu ye kedonye kitigaye inyima wi Lihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.12",
            "verseOrgIds": [
              "EXO.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedonye chi zisendimita amusini kiva nikitigala kuvuli lovega, keleleera kufuma zimbega zie Lihema.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Olombe viukufuuma vindi viviri, kilala che kesero chi ligondi limigu chagilunganywa nirangi nzakanyu ni kindi ne kesero kilahi, kutumika kuli kikuniku chi chova.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Olombe zimbaho zie Lihema zisingiri vulungi kutura ku lubaho lwi kikuma. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.15",
            "verseOrgIds": [
              "EXO.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli ifuremu ilava zimita zine uvutambi kandi uvuvambalaru vulava zisendimita sitini na sita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli furemu ilava nuvwungiru vuviri, kunangwa zifuremu zive zinyala kwung'anywa harara. Zifuremu ziosi zilava nuvwungiru yivu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.17",
            "verseOrgIds": [
              "EXO.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olombe zifuremu zie Lihema silini kolovega lwi Isavaalu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.18",
            "verseOrgIds": [
              "EXO.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olombe kandi vikalilu arubaini vwi ifeza isi wizifuremu sirini; viduku viviri isi wavuli ifuremu ndala kugumira viukwungira vialio viviri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.19",
            "verseOrgIds": [
              "EXO.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olombe zifuremu silini kolovega lwi Ivaale wi Lihema, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.20",
            "verseOrgIds": [
              "EXO.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nu vwikaliru vwazio arubaini vwifeza, viviri isi wa vuli furemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.21",
            "verseOrgIds": [
              "EXO.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira inyima wi Lihema kolovega lwimadioli, olombe zifuremu sita, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.22",
            "verseOrgIds": [
              "EXO.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "zifuremu ziviri ziu muzikona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.23",
            "verseOrgIds": [
              "EXO.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zifuremu ziu mukoona yizi zilung'anywa ha lwaalo ma zihambanywi ziosi vulahi kuduuka igulu. Zifuremu ziviri zilombanga zikona ziviri zilalombwa munzira yiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.24",
            "verseOrgIds": [
              "EXO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndio zilava ho zifuremu munane nu vwikaliru vwazio vwu mugase 16, viviri vilava isi wa vuli furemu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.25",
            "verseOrgIds": [
              "EXO.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.25",
            "verseOrgIds": [
              "EXO.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi olombe zimbohero ziu lubaho lwikikuma, zimbohero zitano kigira zifuremu ziveeye kolovega lulala lwi Lihema, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.26",
            "verseOrgIds": [
              "EXO.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi zitano kigira zifuremu ziveeye kolovega Lundi, kandi zimbohero zitano kigira zifuremu kundulu inyima kolovega lwi madioli wi Lihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.27",
            "verseOrgIds": [
              "EXO.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lovohero loveeye hagati hi zifuremu lulava kutura kundulu kwi lihema kuduuka kundulu kundi kwi Lihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.28",
            "verseOrgIds": [
              "EXO.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulavaka izahabu ku zifuremu, kandi uviiki ku zimingiri ziezahabu zigumiri zimbohero, iziduukanaa nazio zivakwe izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olombe Lihema kolondekana ni lifana lia ndakumanyia ku kiguru.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
            "verseOrgIds": [
              "EXO.26.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
