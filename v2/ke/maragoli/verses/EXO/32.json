          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa, “Vandu vosi vamali kokora vwoni ndatuliza amita gaavo mu kitabu change. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa kalunu uzie, kwimilira avandu vaduuki havundu ha mali kokovoolera. Wizulizi ndi engelosi wange alakwimilira; navuzwa mu ing'inga yiza lwa ndihaana mageri ku avandu yava kigira uvwoni vwavo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
      ]
