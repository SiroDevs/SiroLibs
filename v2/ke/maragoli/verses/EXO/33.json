{
  "id": "EXO.33",
  "number": "33",
  "bookId": "EXO",
  "reference": "Kutura 33",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
