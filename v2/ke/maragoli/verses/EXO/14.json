          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku yilio Yahova yahonyia avandu va Isiraeli kutura ku vandu va Egebeti, na avandu va Isiraeli vavalora nivaveeye avakuzu kulujinga lwinyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
