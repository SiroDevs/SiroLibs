    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lipasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa na Haruni mu Egebeti: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.1",
            "verseOrgIds": [
              "EXO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mweli gunu gulava umweli gwunyu gwukutanga ku muhiga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.2",
            "verseOrgIds": [
              "EXO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhaane malago yaga ku avandu vosi va Isiraeli: Ku lidiku lie likomi liu mweli gunu vuli mundu woosi kuduuka atovolere vandu avinyumba yeeye ekememe chiligondi anoho chimbuli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.3",
            "verseOrgIds": [
              "EXO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva vandu vinyumba yeeye vaveeye vakekeeke ligali kulia nukumala mutugu gwosi, oyo numutende oveeye ahimbi naye vanyara kugavulana mutugu, kolondekana nilivaliza liavandu vava nivaveeye ho kandi kedonye chavuli mundu anyala kulia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.4",
            "verseOrgIds": [
              "EXO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyala kotovola ligondi anoho imburi, navuzwa kuduuka eve neveeye muhiga mulala vuzwa kandi isaza itaveeye nimbala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.5",
            "verseOrgIds": [
              "EXO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku ha mugolova gwi lidiku lie likomi na jane liu mweli, avandu vosi va Isiraeli valiita mitugu yijo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.6",
            "verseOrgIds": [
              "EXO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu valavugula amasahi vavake ku maliva gi miliango kandi igulu wi miliango ji zinyumba mwavaliira zinyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.7",
            "verseOrgIds": [
              "EXO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vudiku yivwo, zinyama kuduuka zisambwe, maziliivwi ni zinguza zinduru kandi nu mugadi gutaveeye mu na mamera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.8",
            "verseOrgIds": [
              "EXO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutagilia imbisi anoho edekeywi namazi mba, navuzwa mulie isambiywi yoosi, mutwi, vilenge, kandi viumunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.9",
            "verseOrgIds": [
              "EXO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaleki ku inyama iduuki mugamba mba; niiva ilatigara ku, kuduuka isambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.10",
            "verseOrgIds": [
              "EXO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muduukana mugilie vwangu, kigira gamudukira mwiviki kwetegekera logendo, muve ni ivilato mu virenge vienyu, kandi zimbimbu mumakono ginyu. Mulie vwangu kigira liveeye lilia lie Lipasaka liu kuhaana luyali ku Inzi, Yahova.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vudiku yivwo ndavitira mukivala cha Egebeti, nukwita kindu kisaza choosi chukutanga mu liivulwa, ku vandu kandi ku mitugu, nukuhaana mageri ku vanyasaye va Egebeti. Inzi mbeeye Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.12",
            "verseOrgIds": [
              "EXO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasahi galiva kumaliva giviliango galakave kelolero chukumanyia zinyumba zia munyi mumenyi mu. Ulwandola amasahi, ndavita kumunyi vugira kumusaliriza ulwaamba nindivizaa vandu va Egebeti: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.13",
            "verseOrgIds": [
              "EXO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku yili lilava kuli liukwizuliza ku munyi; Gamudukira muligumili live kuli lidiku lie Lisavo ku Yahova. Mulalilinda kuli lilago mihiga ni mihiga.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisavo liu mugadi gutaveeye mu na Mamera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavoola, “Ku madiku saba mutalia mugadi guzuganyiywi mu na mamera mba, mulie vuzwa ugutaveeye mu na mamera. Mulidiku liukutanga gamudukira mutulizi amamera goosi mu zinyumba zienyu, kigira niiva mulala ku munyi mumadiku saba yaga alalia mugadi goveeye mu na mamera, sialava mulala ku avandu vange mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.15",
            "verseOrgIds": [
              "EXO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku liukutanga kandi lidiku lia saba, mulava nilivugana liukusigamira. Muyinzi gwosi sigulakoleka mumadiku yago mba, navuzwa munyala kwelombera viukulia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.16",
            "verseOrgIds": [
              "EXO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulindi lisavo yili, kigira liali lidiku lia ndaatuliza avandu vinyu vosi mu Egebeti. Zing'inga ziosi ziza, musangaliri lidiku yili kuli lisavo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.17",
            "verseOrgIds": [
              "EXO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutura ha mugolova gwilidiku lielikomi na jane liu mweli gwu kutanga kuduuka ku mugolova gwi lidiku lia sirini na moja, sigamuduukira mulie mugadi guzuganyiywi mu na mamera mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.18",
            "verseOrgIds": [
              "EXO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu madiku saba, amamera gatanyooleka ku mu zinyumba zienyu mba, kigira mundu woosi wa Isiraeli noho mugeni uva nalia kizuganyiywi mu na mamera, alatulizwa hagati ha avandu va Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.19",
            "verseOrgIds": [
              "EXO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalia chukulia kizuganyiywimu na mamera mba. Hamumenya hoosi, mulalia mugadi gutaveeye mu na mamera.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lipasaka liu kutanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Musa yalanga vimiliri vosi va Isiraeli navavoolera, “Vuli mulala ku munyi atovole kememe chi ligondi anoho chimbuli aduuki kukisinza kunangwa vandu vi zinyumba zienyu vaduuki kusangalira Lipasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.21",
            "verseOrgIds": [
              "EXO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvuguli kiganda cha amatu gu luvinu, muchini mubakuli eveeye mu na masahi ma muvake amasahi zana ku maliva gimiliango nukulubaho loveeye igulu wu muliango ogoveeye ku zinyumba zienyu. Mundu kali mulala kumunyi atatula munyumba yeeye mba kuduuka mugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.22",
            "verseOrgIds": [
              "EXO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yahova avitira mu Egebeti ukwita vandu va Egebeti, alalora amasahi ku maliva gi miliango kandi ku vibaho vie miliango zie zinyumba, na alavita ku viliango, kandi sialavugilira Engelosi kwingira mu zinyumba zienyu nukukwita vayaayi vinyu mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.23",
            "verseOrgIds": [
              "EXO.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi harara na vana vienyu kuduuka mulonde malago yaga mihiga ni mihiga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.24",
            "verseOrgIds": [
              "EXO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa mwingira mu kivala cha Yahova yamulaga alamuha, gamuduukira mukore muluka yigu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa avana vinyu valimuteeva ndi, ‘Muruka yigu govoora ki?’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.26",
            "verseOrgIds": [
              "EXO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulavativuliri ndi, ‘Yiki ni kisiuviriru chi lipasaka liu kuhaana luyali ku Yahova, kigira yavita ku zinyumba zia vandu va Isiraeli mu kivala cha Egebeti. Yita vandu va Egebeti navuzwa naleka kunyi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vinaminya mitwi jaavo nivasigamira Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku vazia ni vakora kuli Yahova yaali nalagi Musa na Haruni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likuza lia avana vayaayi vukutanga kwivulwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vudiku hagati Yahova yita avana vayaayi vosi avatanga kwivulwa mu kivala cha Egebeti, kutura ku muyaayi wu Mwami, uwaali avuguli endeve yu vwami inyima wa baba weve kuduuka ku muyaayi wukutanga kwivulwa muhambe oveeye mu vuhambe vugira lieriza; kali mitugu jiosi jukutanga kwivulwa jiitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.29",
            "verseOrgIds": [
              "EXO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvudiku yivwo, Mwami, vatumikiri veve, kandi vandu va Egebeti vandi vosi vavukizwa. Liali yo lilira linene mu kivala choosi cha Egebeti, kigira sihaali ho na hango hu Muegebeti ahu mukuzu muyaayi yavula kuvaho mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.30",
            "verseOrgIds": [
              "EXO.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvudiku vwene yivwo Mwami yalanga Musa na Haruni navavoolera, “Singiri muzie, munyi na vandu va Isiraeli vinyu! Tuli mukivala change; muzie kusigamira Yahova, kuli mwateeva. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.31",
            "verseOrgIds": [
              "EXO.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuguli amagondi ginyu, zimburi, kandi zing'ombe zienyu, ma muzie, ma musaliri ku uvugasu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.32",
            "verseOrgIds": [
              "EXO.12.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.32",
            "verseOrgIds": [
              "EXO.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandu va Egebeti vaniga avandu va Isiraeli vakole vwangu vatuli mukivala chavo; vavoola, “Kunyi kwosi kulakuza nimuvula kuzia.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.33",
            "verseOrgIds": [
              "EXO.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa avandu avaavugura vusie vwavo vwavula kuzuganyirwa mu namamera niviju viu kwuminyira ku migadi nivavilingira muzinguvu nivavigingira ku mavega gaavo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.34",
            "verseOrgIds": [
              "EXO.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandu va Isiraeli vaakora kuli Musa yaali navavooleye, kandi vaali ni vateevi vandu va Egebeti vavahe iviju vie ifeza ni viezahabu kandi zinguvu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.35",
            "verseOrgIds": [
              "EXO.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yalomba vandu va Egebeti nivahaana luyali ku vandu va Isiraeli kandi nivavaha ivia vavateeva. Munzira yiyi, vandu va Isiraeli vaavugura uvutugi vwa vandu va Egebeti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Avandu va Isiraeli vaturaa mu Egebeti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vatanga logendo kutura Ramesesi nivahenzi kuzia Sokozi. Vaali ahimbi avandu vasaza vaduuka zielefu mia sita vugira kuvaliza avakali na avana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.37",
            "verseOrgIds": [
              "EXO.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muganda gwa avandu vandi vazia harara navo ni mitugu minyingi ja amagondi, zimburi ni zing'ombe ziavo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.38",
            "verseOrgIds": [
              "EXO.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuminya migadi jitaveeye mu namamera nu vusie vwavaleeta kutura Egebeti, kigira vakungwa vwangu kutura Egebeti, na sivali ning'inga yokwetegekiza kolomba viukulia viavo anoho kwetegekiza lihumbi liu vusie vutaveeye mu na mamera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vaali ni vamenyi mu Egebeti ku mihiga 430. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku liu kumalirika lie mihiga 430, zihiiri ziosi zia avandu va Yahova ziatula mu kivala cha Egebeti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yivu vwali uvudiku vwa Yahova yavalinda nukuvatuliza mukivala cha Egebeti; uvudiku yivu vulava ukwizuliza Yahova ku mihiga josi jizaa kuli uvudiku vwa vandu va Isiraeli vaduukana kwizuliza nu kulinda amalago gi lipasaka lia Yahova.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalago gi Lipasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa na Haruni, “Yaga nigo amalago gilipasaka: ‘Mundu mugeni wihiiri yindi’ sialalia ku chukulia chi Lipasaka mba, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "navuzwa mutugwa woosi wa mwagula anyala kulia ku niiva mulataga kumukeva. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.44",
            "verseOrgIds": [
              "EXO.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumenya wi ing'inga engekeeke nu muyinziri utungwa sivalalia ku mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.45",
            "verseOrgIds": [
              "EXO.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chukulia choosi kuduuka kiliilwi munyumba ya kedekeywi mu; kandi kitahilwa ichova winyumba mba. Kandi mutavunanyia kigumba chienyama kali kilala mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.46",
            "verseOrgIds": [
              "EXO.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EXO 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandu vosi va Isiraeli kuduuka valie nukusangalira lisavo yili, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.47",
            "verseOrgIds": [
              "EXO.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EXO 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "navuzwa mundu utaakevwa sianyala kulia ku mba. Niiva mugeni wamenya hagati hinyu naye yenya kusanga kulia Lipasaka kukuminya Yahova, mulataga kokeva avayaayi vosi vinyumba yeyo. Naye alavugulwa kuli mulala uwivulwa mu kivala chiinyu cha Isiraeli na alasaanga mu lilia lienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malago malala mere yago galava kandi ku vandu va Isiraeli kandi kuvamenya aviivulwa mu kivala cha Isiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "EXO 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vosi vahulira ni vakora ndio kuli Yahova yalaga Musa na Haruni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "EXO 12:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lidiku yilio Yahova yaatuliza avandu va Isiraeli kutura Egebeti mu miganda jaavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        }
      ]
    }
