          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso yaali mu Jerusalemi mu lilia lie Lipasaka, avandu avanyingi vaamusuuvira inyima wokolola vilolekizu via yakola. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.23",
            "verseOrgIds": [
              "JHN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Yeso si yisuuviriza mwene kuvo mba, kigira yamanya avandu vosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.24",
            "verseOrgIds": [
              "JHN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si yenya mundu amulolekizire amakuva gu mundu wundi mba, kigira mwene yamanya vulahi amakuva goosi agaali mu mioyo jaavo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.25",
            "verseOrgIds": [
              "JHN.2.25"
            ]
          }
        }
