          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.23",
            "verseOrgIds": [
              "JHN.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
