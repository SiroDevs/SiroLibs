      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yamuvolera, “Usuuviyi kigira ondoli? Vaveeye nuvugasu yavo avasuuviyi nivakikiri kondola.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kivuni chi kitabu yiki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yakola vilolekizu vinyingi imbiri wa aviigi veve ivia vula kung'odwa mu kitabu yiki. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
            "verseOrgIds": [
              "JHN.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa yivi viang'odwa kunangwa munyi muduuki kusuuvira ndi Yeso ni Mesia. Mwana wa Nyasaye; na mu lisuuvira lienyu muye, mulava ni livamwoyo mu zie lieta lilie.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.31",
            "verseOrgIds": [
              "JHN.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso yaloleka ku aviigi saba",
          "type": "text"
        }
      ]
    }
