              "JHN.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.24",
            "verseOrgIds": [
              "JHN.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwigizwi oyo yisunda ahimbi ku Yeso, namuteeva, “Mwami, nivwaha?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.25",
            "verseOrgIds": [
              "JHN.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.25",
            "verseOrgIds": [
              "JHN.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yativura, “Oyo wanaambe ketonge chu mugadi cha ndongelizi mu bakuli yu munyu, niyie.” Kunangwa, yavugula ketonge chu mugadi, nadongeliza mu bakuli, naha Yuda, Mwana wa Simoni Esikarioti. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yuda yaali niyakamara kuvugura ketonge yicho, Setani yamugeriza. Yeso yamuvolera, “Ichawenyaa kokora, kola vwangu!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa sihaali ho nu mulala ku avaari komesa, uwamanya kivuni chagira Yeso navoora ndio mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.28",
            "verseOrgIds": [
              "JHN.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira Yuda yaali muviiki wa mabese, avalala kuvo vaganagana Yeso ya muvooleraa azie kugura vindu vienyeka mu lisavo, anoho ahaane kindu choosi ku avadaka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.29",
            "verseOrgIds": [
              "JHN.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.29",
            "verseOrgIds": [
              "JHN.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yuda yaali niyakavugula kedonye chu mugadi, yatura ichova vwangu. Ma vwali vudiku.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lilago lihia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yuda yaali niyakatula ichova, Yeso yavoola, “Kalunu uvukumi vwu Mwana wa Adamu vuvuuliki, kandi Nyasaye akuminyiywi muye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.31",
            "verseOrgIds": [
              "JHN.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva uvukumi vwa Nyasaye vuvuulikiyi mu Mwana, kandi ndio Nyasaye naye alalolekiza uvukumi vwu Mwana muye mwene, na alamukuminya vwangu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.32",
            "verseOrgIds": [
              "JHN.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.32",
            "verseOrgIds": [
              "JHN.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Avana vakekeeke vange, ngikiri ni munyi ku ing'inga engekeeke vuzwa, itigaaye. Mulakanyenye, navuzwa kuli ndavolera avanene va Avayuda, kalunu inzi muvooleraa kandi, ‘Uwanziza munyi simunyala kuzia yo mba!’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.33",
            "verseOrgIds": [
              "JHN.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kalunu muheezaa lilago lihia: muyaanzane aveene naveene. Kuli wa inzi ndamuyaanza, munyi kandi muyaanzane ndio. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.34",
            "verseOrgIds": [
              "JHN.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva muyaanzana aveene naveene, avandu vosi valamanya ndi munyi muveeye aviigi vange.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso Yaporofeta ndi Petero alamwambakana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petero yamuteeva, “Mwami, uzizaa hayi?” Yeso yamutivulira, “Wanzizaa siunyala kononda kalunu mba, navuzwa ulanonda lwinyima.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero yamuvolera, “Mwami, kigira ki sinyala kokolonda kalunu? Inzi nzetegeki kukuza naivi!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yamutivulira, “Hene ligali ulahaana livamwoyo liilio kigira inzi? Ngovolera agiligali, idaywa nikikiri kulagula, ulanyambakana haali kavaga.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.38",
            "verseOrgIds": [
              "JHN.13.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso aveeye inzira yukuzia ku Baba",
          "type": "text"
        }
      ]
    }
