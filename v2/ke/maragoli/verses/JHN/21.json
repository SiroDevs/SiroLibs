        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa, livoora yili lialanda ku valondi va Yeso ndi mwigi uyu sialakakuzi mba: navuzwa Yeso siyavola ndi mwigi uyu sialivula kukuza, nitali yavoola, “Niiva niyenyaa ave mwoyo kuduuka lwa ndirana, gaveeye ki ku ivi?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.23",
            "verseOrgIds": [
              "JHN.21.23"
            ]
          }
        }
      ]
    },
