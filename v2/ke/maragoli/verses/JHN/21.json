          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu niyie mwigi walolekiza vindu yivi naaving'oda. Nakunyi kumanyi aga yavoola gaveeye agiligali.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.24",
            "verseOrgIds": [
              "JHN.21.24"
            ]
