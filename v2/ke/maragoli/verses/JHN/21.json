            "number": "20",
            "style": "v",
            "sid": "JHN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahene yaho Petero yikivuka, nalora mwigi wa Yeso yayanza, navalonda. Mwigi uyu niyie uwaali ku ing'inga yi chukulia cha hamugorova, wikala himbi ligali na Yeso namuteeva, “Mwami, nivwaha ulikuzaama?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.20",
            "verseOrgIds": [
              "JHN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa, lwa Petero yamulola yateeva Yeso, “Mwami, nu mundu uyu aveeye ndi?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
