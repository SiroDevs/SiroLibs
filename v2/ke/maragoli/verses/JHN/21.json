          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yamutivulira, “Niiva inzi nyenya ave mwoyo kuduuka lwa ndirana, gaveeye ki ku ivi? Ivi ononde.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
