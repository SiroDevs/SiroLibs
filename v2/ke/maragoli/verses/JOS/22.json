              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaalisi Finiasi, na viimiliri vuluyali likomi avaari nivaazi naye kutura mu zihiiri likomi ziemadioli vahuliriza ku livaala liahaanwa na vandu kutura mu zihiiri zia Rubeni, Gadi, na Ivugwi wa Manase, kandi vigutizwa nalio ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finiasi muyaayi wu musaalisi Elieza yavoola, “Kalunu kumanya ndi Yahova aveeye nikunyi. Simwibaaye ku Yahova mba, nandio mumali kohonyia avandu va Isiraeli kutura ku mageri ga Yahova.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
