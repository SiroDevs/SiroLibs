  "bookId": "JOS",
  "reference": "Joshua 22",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JOS 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joshua Yavugilira zihiiri zie Ivugwi kuzia yengo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Joshua yalanga harara avandu vi zihiiri zia Rubeni, Gadi, ni Ivugwi wa Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavavolera, “Mumali kokora viosi via Musa, mutumikiri wa Nyasaye yamulaga mukore. Kandi mumali kuhulira amalago gange goosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ing'inga yiyi yoosi mukikiri koleka vandu va Isiraeli vache vinyu mba, navuzwa mumali kokora ga Yahova Nyasaye winyu yamuha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu, kuli yasuuviriza, Yahova Nyasaye umali kuha vandu va Isiraeli vache vinyu mirembe. Kunangwa yirani yengo mu kivala cha mwavugula kuva chienyu, kivala keveeye Ivugwi wu mugera gwa Jorodani, icha Musa, mutumikiri wa Yahova, yaaha munyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulole ndi mulonde lilaga lia Musa mutumikiri wa Yahova, yamulaga mukore: Muyanze Yahova Nyasaye winyu, mukore uvulariri vwivwe, muhuliri malago geege, muve avasuuvirifu kuye, kandi mumutumikiri nimioyo jinyu josi kandi na roho jinyu josi.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahene yaho Joshua yavagasiza kandi yavavugilira vazie yengo wavo na ni vazia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.6",
            "verseOrgIds": [
              "JOS.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.6",
            "verseOrgIds": [
              "JOS.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaali namali kuhaana kedonye chi kivala cha Bashani ku inusu yi ihiiri ya Manase, navuzwa inusu yindi Joshua yaali ni yavaha kivala keveeye kolovega lwi imadioli wu mugera gwa Jorodani harara ni zihiiri zindi. Lwa Joshua yavatuma yengo wavo, yavagasiza, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.7",
            "verseOrgIds": [
              "JOS.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "navoora, “Mwirane yengo winyu nuvutugi vwinyu vunyingi, mitugu jinyu minyingi, vivia, izahabu, harara ni zinguvu zinyingi ziosi, na mugavulane na avamwavo vinyu vilaanye via mwavugula kutura ku vasigu vinyu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.8",
            "verseOrgIds": [
              "JOS.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.8",
            "verseOrgIds": [
              "JOS.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa avandu vi zihiiri zia Rubeni, Gadi ni inusu yi ihiiri ya Manase yi Ivugwi virana yengo. Valeka avandu vandi vosi va Isiraeli ha Shilo mu kivala cha Kanaani nivirana mu kivala chavo aveene, kivala cha Gileadi, icha vaali nivavugura kuli Yahova yaali niyavalaga kuvitira ku Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uvwali ha mugera gwa Jorodani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwi zihiiri zia Rubeni, Gadi, ni inusu ya Manase yi Ivugwi vaduuka ha Gelilozi, nivakikiri kolovega lwi Imadioli, mukivala cha Kanaani, vumbaka uvwali vonene ligali ahene yaho ahimbi ku mugera. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.10",
            "verseOrgIds": [
              "JOS.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vandi vosi vavolerwa ndi, “Huliri! Avandu vi zihiiri zia Rubeni, Gadi, ni inusu ya ihiiri ya Manase vi Ivugwi vamali kwumbaka uvwali ha Gelilozi, kolovega lwiitu lwu mugera gwa Jorodani!” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.11",
            "verseOrgIds": [
              "JOS.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vasaza vosi vi zihiiri ziosi zie imadioli vahulira yaga, vaza vosi harara ha Shilo kulwaana avandu vi zihiiri zie Ivugwi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku avandu va Isiraeli vaatuma Finiasi, muyaayi wu musaalisi Elieza, kwimilira muganda kuzia ku avandu vizihiiri zia Rubeni, Gadi na Manase vi Ivugwi, mu kivala cha Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.13",
            "verseOrgIds": [
              "JOS.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaatuma Finiasi muyaayi wa Elieza musaalisi harara nu mwimiliri munene mulala kutura mu vuli ihiiri ku zihiiri ziavo likomi. Aviimiliri yava vaali avandu vuluyali na vuli mulala yaali mwimiliri wi inyumba hagati hi zihiiri viavo zia Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazia mu kivala cha Gileadi, ku vandu va Rubeni, Gadi, ni inusu ya Manase wi Ivugwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.15",
            "verseOrgIds": [
              "JOS.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu limoloma mu vogono vwa vandu vosi va Yahova vavavolera, nimukora kindu kidamanu yiki ku Yahova? Mumali kwibaala ku Yahova ku lieyumbakira uvwali yivu! “Mugirung'ani nokoleka kolonda Nyasaye wa Isiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwizurizi uvwoni vwitu ha Peori, lwa Yahova yaaha avandu veve mwene amageri nuvulwaye vwukutihiza nu kwita avandu vanyingi? Kukilwaala kigira uvwoni yivwo sivwaduuka? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzizaa kusuura kolonda Yahova lero? Kalunu nimwibaala ku Yahova, alava nu vutima vonene nu mundu samulala mu Isiraeli mugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulwa yaga, niiva kivala chienyu sikiduukanaa kusigamira mu, hambi yinu mu kivala cha Yahova, ahi Lihema lilie liveeye. Muvuguli ku kivala keveeye hagati hiitu. Navuzwa muvuli kwibaala ku Yahova anoho mulombe kunyi avibaali kutura mu kunyi ku liumbaka uvwali komeeda ku vwali vwa Yahova Nyasaye witu mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwizurizi kuli Akani muyaayi wa Zera yasura kuhulira lilaga lia Yahova yavolera kunyi, kudiviza vindu viosi iviakalagirwa mu lidaala linene lia Jeriko! Yahova yaaha avandu vosi va Isiraeli amageri ku agene yago. Akani siyaali niyie yeng'ine uwakuza kigira uvwoni vwivwe mba. Avandu va Isiraeli vandi vanyingi kandi vaakuza kigira uvwoni vwa Akani.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vi zihiiri zia Rubeni, Gadi ni Ivugwi wa Manase vativulira aviimiliri vi zihiiri zie madioli: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.21",
            "verseOrgIds": [
              "JOS.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wuvunyali aveeye Nyasaye! Aveeye Yahova! Amanya ichagira nikokola yaga, ma kandi kwenyaa na munyi mumanye kandi! Nikuva nikwibaala ku Yahova, na nikuvamanyia lilagana lietu na Yahova, mutaleka kunyi kove mwoyo kandi mba, Mukwiti lufwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva sikwahulira Yahova kandi nikwiyumbakira uvwali vwitu aveene kuduuki kusambira ku visiuviliru anoho kuvutumikiri kigira vihaanwa viuvuswage anoho vihaanwa vie mirembe, leki Yahova mwene ahaane ku kunyi amageri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa, kwakora ndio kigira kwaali nuvuti ndi mu zing'inga ziza, visukululwi vinyu valakavoolere aviitu, ‘Munyi muveeye na lisanga ki mu Yahova Nyasaye wa Isiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalomba mugera gwa Jorodani gove lwako hagati hiitu ni munyi avandu vi zihiiri zia Rubeni na Gadi muveeye na ki ku Yahova, Nyasaye wa Isiraeli?’ Kunangwa visukululwi vienyu vilakokole aviitu koleka kusigamira Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa sikwumbaka uvwali kigira kusamba visiuviliru anoho kolomba vihaanwa mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.26",
            "verseOrgIds": [
              "JOS.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa kwavwumbaka vuduuki kuva kelolero ku vandu viitu kandi avinyu, kandi kigira amakura galiiza inyima wiitu, ndi ligali kusigamira Yahova mu Lihema lilie itakatifu ni vihaanwa vietu viukusambwa, nivisiuviliru kandi vihaanwa viemirembe. Yaga gaali vuzwa ukwigalira visukululwi vinyu vivuli kovora ndi aviitu sivaveeye ni kidieli mu Yahova mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iganagani yitu yaali ndi niiva yaga galekoleka, visukululwi vietu vilakavoole, ‘Heenzi! Avaguuga vetu valomba uvwali vufanaa vuzwa kuli uvwali vwa Yahova Nyasaye. Sivwaali kigira lisaamba vihaanwa anoho kigira visiuviliru, navuzwa kuli kelolero ku vandu viitu kandi avienyu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikwakibaaye ku Yahova ligali mba anoho koleke kumulonda lero ku liumbaka uvwali kusambira ku vihaanwa, anaho kigira vihaanwa viuvuswage anoho visiuviliru mba. Sikwakumbaki uvwali vundi ukuvita uvwali vwa Yahova vusingiyi imbiri wi Lihema liu kuvuganira mu naye.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        }
      ]
    },
