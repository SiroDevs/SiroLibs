            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli vigutizwa ligali nago kandi vizominya Nyasaye. Sivamoloma kandi amakuva gukuzia mu liihi kudiviza kivala uwa vandu va Rubeni na Gadi vaali nivamenyi mba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
