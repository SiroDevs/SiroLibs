              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Finiasi na viimiliri valeka avandu vi ihiiri ya Rubeni na Gadi, mu kivala cha Gileadi, kandi nivirana Kanaani ku avandu va Isiraeli, nivavahilira amakuva ga vanyoola.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
