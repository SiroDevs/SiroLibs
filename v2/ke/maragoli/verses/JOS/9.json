          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu kigira koveeye hasi hi zinguru zienyu, mukokole icha muganaganaa keveeye kilahi kandi kilungi.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
