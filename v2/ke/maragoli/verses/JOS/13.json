          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaali nahaani kedonye chi kivala ku inusu yi ihiiri ya Manase yi Ivugwi kuva miandu jaavo ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kivala chavo chaduuka ivaale kutura ku vwami vwosi vwi lidaala linene lia Mahanaimu kandi chaali harara nu vwamihi vwa Bashani vwa Ogu, mwami wa Bashani, harara nutudaala 60 twa Jairi mu Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
