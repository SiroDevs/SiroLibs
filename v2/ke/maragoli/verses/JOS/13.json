              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio Musa yagavulira avandu va Isiraeli kivala choosi cha Moabu ekeveeye Ivugwi wa Jeriko mu livona lia Jorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
