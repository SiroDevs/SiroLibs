{
  "id": "JOS.13",
  "number": "13",
  "bookId": "JOS",
  "reference": "Joshua 13",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
