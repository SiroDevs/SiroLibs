          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku inusu yi ihiiri ya Manase, iyaatula ku kisukururwi chaali harara ni inusu ya Gileadi, harara na Ashitarozi kandi Edirei, madaala manene gu vwamihi vwa Ogu mu Bashani. Kivala yiki choosi chahaanwa ku ihiiri yi kisukururwi cha Makiri muyaayi wa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
      ]
