        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ligavulwa lie kivala keveeye madioli wa Jorodani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili ni ligavulwa lie kivala cha Kanaani ekeveeye imadioli wa Jorodani chagavulwa hagati ha vandu va Isiraeli. Musaalisi Elieza, Joshua muyaayi wa Nuni, harara na aviimiliri vi zihiiri zia vandu va Isiraeli vagavulana kivala yiki hagati ha vandu vosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli Yahova yaali nalagi Musa, vivala vie zihiiri tisa na inusu iziveeye imadioli wa Jorodani viagavulwa ku likuba ikura. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaali naheeye zihiiri ziviri ni inusu imiandu jaavo ivugwi wa Jorodani, navuzwa siyaali nahaani ku imiandu josi ku ihiiri ya Levi hagati ha ziosi mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira avayaayi va Josefu vaali nivagwiyi zihiiri ziviri, Manase na Efuraimu. Ihiiri ya Levi sivanyoola kedonye chi kivala choosi kuva miandu jaavo mba, nitali amadara go komenya mu geng'ine, ni milimi juvulimu kigira mitugu jaavo ni viayo viavo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa avandu va Isiraeli vagavulana kivala kuli Yahova yaali nalagi Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joshua ahaanaa ku Kalebu lidaala linene lia Heburoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku lilala avandu valala kutura mu ihiiri ya Yuda vaza ku Joshua ha Giligali. Mulala kuvo, yaali Kalebu muyaayi wa Jefune umukenizi. Yamuvolera, “Umanya aga Yahova yavolera Musa lwa kwaali nikukikiri mu Kadeshi Barinea kigira ivi ninzi ku Musa, mundu wa Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaali nimbeeye ni mihiga arubaini lwa Musa mutumikiri wa Yahova yanduma kutura Kadeshi Barinea kutunyiriza kivala yiki. Kandi ndavolera avandu amakuva agiligali na agu vusuuvirifu kigira aga kwaali nikololi ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa avasaza vazia harara ninzi, vaakora avandu nivava nu vuti ligali. Inzi ndahulira Yahova Nyasaye ligali nu vusuuvirifu vwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira ndakora ndio, Musa yasuuviriza ndi visukululwi viange harara ninzi kulanyoola kivala cha ndagenda ku kuva miandu jietu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa kalunu, henza. Ni mihiga arubaini na tano kutura Yahova navoora ndio ku Musa. Yilwo lwali lwa vandu va Isiraeli vaali nivavitira mu changalangwe, na Yahova, kuli yasuuviriza, umali kumbika kuva mwoyo kutura ing'inga yeyo. Mbenza! Mbeeye ni mihiga samanini na tano. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mbeeye nizinguru kalunu kuli ndaali lwa Musa yanduma ichova. Ngikiri vuzwa nizinguru kali ku vulwani vwosi anoho ku kindi choosi ikitulira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa kalunu, mbe kivala chi kiguru icha Yahova yandaga ku lidiku yilio lwa avandu vange harara ninzi kwahaana amakuva giitu. Kwakovoolera ulwene yilwo ndi ihiiri ya imindu minene ligali, avalangwa vandu va Anaki vaali yo mu madaala manene gizimbinga. Hawundi Yahova alangoonya, kuvakunga vatuli, kuli yahova yaali navooye.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua yagasiza Kalebu muyaayi wa Jefune kandi naamuha lidaala linene lia Heburoni kuva mwandu gwigwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heburoni likikiri vuzwa lia kisukururwi cha Kalebu muyaayi wa Jefune, Mukenizi kigira yahulira nukutia Yahova Nyasaye wa Isiraeli nu vusuuvirifu vwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku maziambiri, Heburoni lialangangwa lidaala linene lia Ariba",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:15",
              "type": "text"
            },
            {
              "text": "Ariba:",
              "type": "text"
            },
            {
              "text": "Yili ni lieta liu mundu wu muviri munene wi kivala cha Anaki.",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvulwani vwalekera ni mirembe jaali mu kivala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
  ],
