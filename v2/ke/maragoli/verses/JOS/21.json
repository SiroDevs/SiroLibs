            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vahevwa kandi madaala manene gaviri kutura mu kivala cha imadioli wa Manase: Tanaki, na Gazurimoni, harara ni vivala viu vwayiru viago.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.25",
