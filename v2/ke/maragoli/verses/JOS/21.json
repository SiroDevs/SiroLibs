          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadara manene gi ihiiri ya Levi harara ni vivala viu vwayiru muvivala via vandu va Isiraeli gaali goosi arubaini. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli lilala ku amadara yaga goosi liali ni vivala viu vwayiru viago ivialikumbiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vandu va Isiraeli Vavugura Kivala Kuva Chavo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
