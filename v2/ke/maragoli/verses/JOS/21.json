          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vi ihiiri ya Kohazi vanyoola madaala manene goosi likomi, harara nivivala viu vwayiru viago.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
