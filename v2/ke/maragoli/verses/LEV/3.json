            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu wa Isiraeli woosi atalia ku itinya anoho masahi mba. Yili ni Lilago lia vandu va Isiraeli vosi vaduukana valindi madiku goosi havundu hoosi ha vava nivamenyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.17",
            "verseOrgIds": [
              "LEV.3.17"
            ]
          }
        }
      ]
