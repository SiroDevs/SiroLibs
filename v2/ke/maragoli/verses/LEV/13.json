          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "alaga ndi vwogizwi kandi kindu chogiziywi yicho kuduuka kiviikwi ihale ku madiku gandi saba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
