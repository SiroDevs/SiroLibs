          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva liisu liu musaza litula ku mutwi gwigwe mu vweni, aveeye vuzwa nekemeeni. Aveeye mulahi kolondekana ni miima. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
