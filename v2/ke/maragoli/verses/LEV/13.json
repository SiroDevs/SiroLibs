          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu amali kusambika ligodo, ma inyama imbisi hazana igwi indavu anoho yu vwakanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.24",
            "verseOrgIds": [
              "LEV.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "musaalisi alamuhenzeliza. Niiva maswa gaveeye havundu yaho gamali kugirung'ana kandi galoleka kuyavuguka kuvita ligodo lihakumbirizi, yivwo voveeyevulwaye vwo vogere, uvumali kutangira havundu hasambiki yaho, musaalisi alamulandiza kuva mudamanu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.25",
            "verseOrgIds": [
              "LEV.13.25"
            ]
          }
        }
      ]
