          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "anoho ku kedonye choosi chinguvu yu vwoya anoho yikatani anoho ku kesero anoho ku kindu choosi chalombwa ku kesero, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
