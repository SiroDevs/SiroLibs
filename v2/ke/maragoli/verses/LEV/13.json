          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwu musaza anoho mukali aveeye namavoondo malavu ku ligodo lilie, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
