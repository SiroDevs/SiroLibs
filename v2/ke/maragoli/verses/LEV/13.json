              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva liisu liu mundu nilitura imbiri anoho inyima wu mutwi gwigwe, yaga siganyala kumukola kuva mudamanu mba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
