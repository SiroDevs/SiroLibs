            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa niiva lwa avohenzeliza, ma anyoore ndi vuguku zana sivulaandi mba, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
