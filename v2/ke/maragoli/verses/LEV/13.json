          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa niiva ingwagu yu vulavu nu vwakanyu elolekaa ku kemeeni, yivuo voveeye vulwaye vwo vogere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
