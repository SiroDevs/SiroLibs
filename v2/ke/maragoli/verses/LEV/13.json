          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "musaalisi alamulandiza kuva mudamanu kigira aveeye nu vulwaye vwo vogere ku mutwi gwigwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
