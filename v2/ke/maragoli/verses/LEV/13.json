          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "niiva vwakava nivoveeye vwu vulimu anoho vwakanyiliru, voveeye vuguku vulandaa; kuduuka musaalisi amanywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
