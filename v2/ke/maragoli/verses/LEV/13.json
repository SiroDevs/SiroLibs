              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yahaana ku Musa na Haruni malago yaga:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        }
