            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alavohenzeliza kandi ku lidiku lia saba, niiva vuguku yivu vulaandi, kindu cha voveeye ku yicho keveeye kidamanu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
