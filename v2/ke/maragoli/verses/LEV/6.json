            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "volera Haruni harara na vayaayi veve ndi, yaga nigo malago ku vihaanwa viu vwoni: Inyama yi kihanwa chu uvwoni isinzirwi ivaale hi vihaanwa viukusambwa visinzirwaa. Yiki ni kihanwa kitakatifu ligali.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        }
