          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaalisi uhaanaa kisiuviriru yiki kigira uvwoni, alakilira havundu hatakatifu hu mugizi gwi Lihema liu kwaganira mu na Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu woosi anoho kindu choosi kidiira ku nyama yumutugu yiyi kilakolwa kitakatifu. Niiva masahi gayo guuhika kunguvu, kuduuka inguvu yeyo ifuyirwi havundu hatakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.27"
            ]
          }
        }
      ]
    },
