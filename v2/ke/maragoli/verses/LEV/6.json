              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yahaana malago yaga ku Musa:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        }
      ]
