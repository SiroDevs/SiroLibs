              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yalaga Musa navoora, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
