      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'inga ya Apolo yaali mu Korinzo, Paolo yaali navitiraa mu kivala yicho ma naduuka Efeso. Yanyoora yo vandu avasuuviraa valala ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.1",
            "verseOrgIds": [
              "ACT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "navateeva, “Lwa mwasuuvira mwavugula Roho Mutakatifu?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamutivulira, “Awa! Kali lihulira vuzwa Roho Mutakatifu aveeye kunu kukikiri kuhulira ku.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paolo yavoola, “Ku mwanyoola libatizwa lia lugano ki?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamutivulira, “Libatizwa lia Yohana.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paolo yavoola kandi, “Libatiza lia Yohana liali liu kumanyia ndi avandu vamali kwiganira. Yohana yavolera avandu va Isiraeli, uyu waali niyazaa inyima weve, naye ni Yeso.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.4",
            "verseOrgIds": [
              "ACT.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.4",
            "verseOrgIds": [
              "ACT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vahulira yaga, vabatizwa mu lieta liu Mwami Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.5",
            "verseOrgIds": [
              "ACT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Paolo yavika makono geege kuvo, Roho Mutakatifu yika kuvo, nivatanga livoora mu zinimi ziavukani na amakuva ga Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.6",
            "verseOrgIds": [
              "ACT.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vosi harara vaali ahimbi avandu likomi na vaviri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ing'inga yi mieli jivaga Paolo yazizaa mu lisinagogi, na amolomaa nu vuluviliri nokogoonya avandu vavugiliri amakuva gu Vwami vwa Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.8",
            "verseOrgIds": [
              "ACT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa avalala kuvo ni kilage ni, vasuura kusuuvira; vatanga konyega miigizu gu Mwami Yeso imbiri wa avandu. Kunangwa Paolo yahuka kuvo, naahira halovega aviigi veve, namolomaa navo kazozo munyumba ya amasomo ya Tairano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.9",
            "verseOrgIds": [
              "ACT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaazizagilira kokora yaga ku ing'inga yi mihiga giviri; kuduuka vandu vosi ku avamenyaa Asia, vombi Avayuda na Avaguriki, vahulira likuva liu Mwami.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.10",
            "verseOrgIds": [
              "ACT.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Avana va Sikeva vageriza kukuunga amademoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.10",
            "verseOrgIds": [
              "ACT.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye yakola vilolekizu viokogenyia kuvitira mu makono ga Paolo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.11",
            "verseOrgIds": [
              "ACT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali avandu vaavugura vitambaya ni zinguvu zindi ziatula ku muviri gwa Paolo yatumikiraa, nivahilira avalwaye vaavo, navo vahonywa vulwaye vwavo; na vandu avaari na mademoni gaturaa kuvo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.12",
            "verseOrgIds": [
              "ACT.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Avayuda valala avavodong'anaa hoosi, ni vakunga mademoni kandi, vageriza kutumikira lieta liu Mwami Yeso ku vandu avaari na mademoni. Vavoolera mademoni zana: “Mulagaa ku lieta lia Yeso wa Paolo yilwaza.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.13",
            "verseOrgIds": [
              "ACT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avana saba va Sikeva, Muyuda, Musaalisi Munene, vaali avalala ku vandu avakolaa ndio.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.14",
            "verseOrgIds": [
              "ACT.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.14",
            "verseOrgIds": [
              "ACT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa lidemoni liavavoolera, “Ndamanya Yeso, kandi ndamanya Paolo. Navuzwa munyi nivwaha?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.15",
            "verseOrgIds": [
              "ACT.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.15",
            "verseOrgIds": [
              "ACT.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu waali niyagumirwa ni lidemoni oyo yavatuumira naavavita ni zinguru, navaguuta vosi. Avana va Sikeva viruka kutura munyumba yeyo nivaveeye chahonyo kandi nivizuuyi zing'oma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.16",
            "verseOrgIds": [
              "ACT.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vosi va Efeso, Avayuda na Avaguriki, vamanya makuva yaga. Vosi vaali nu vuti, nivakuminya Mwami Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.17",
            "verseOrgIds": [
              "ACT.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandu avasuuviraa avanyingi vaza niviyama havulavu vindu via vaali nivakora. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.18",
            "verseOrgIds": [
              "ACT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanyingi kuvo avaari nivakora uvusigitiri kale, valeta harara vitabu viavo, nivavisaamba ku muliru imbiri wa vandu vosi. Vavaliza vuguli vwi vitabu yivio, nivanyoora viduuka zisiringi zielefu amusini. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.19",
            "verseOrgIds": [
              "ACT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ndio likuva liu Mwami liameeda kulaanda niliva ni zinguru kuvita ligali.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kivihiri mu Efeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyima wa makuva yago, Paolo yatovola kuzia Jerusalemi, naavitira Makedonia na Akaya. Yavoola, “Nimali kuduuka yo, galaniga kuzia Rumi kandi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa avandu vaviri kuvo avaari avatumikiri veve, Timateo na Erasito, yavatuma kuzia Makedonia, naye mwene yaatigara na amenyaa Asia ku ing'inga idukanaa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madiku yago nigo gi kivihiri kinyingi chaali mu Efeso, kigira miigizu gu Mwami Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.23",
            "verseOrgIds": [
              "ACT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaali ho mulombi wi vindu viefeza mulala walangwa Demeturo, uwaali ni miyinzi jo kolomba vifananyi viefeza vie Litembeli lia nyasaye wi kikali walangwa Aritemi. Miyinzi yijo jaleetela Demeturo na avayinziri veve mabese manyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.24",
            "verseOrgIds": [
              "ACT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Demeturo yavuganyia avayinziri yavo harara na avandi avaari ni miyinzi ju lugano yilu, na avavoolera, “Avasaza munyi, mumanyi linyola lietu litula ku miyinzi yiji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.25",
            "verseOrgIds": [
              "ACT.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu muloraa kandi muhulira ivindu via Paolo akolaa, sihaveeye hano mu Efeso mweng'ine, navuzwa kuduuka mu Asia mwosi. Paolo uyu agonyaa nagirung'anyia avandu vanyingi, na avoora ndi avanyasaye valombwa na avandu si vaveeye avanyasaye kali hakuzu mba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.26",
            "verseOrgIds": [
              "ACT.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vudinyu sivoveeye kigira miyinzi jietu jenyine ijizizaa konyoora lieta lidamanu mba; navuzwa kandi likuva yili linyala kokora Litembeli liu umunyasaye wikikali ulangwa Atemesi wa Asia na uwi lirova liosi lisigamira sialahevwa luyali mba, kandi munyasaye oyo usigamirwaa na vandu vosi mu Asia nu mulirova alanyaagwa vunyasaye vwu vukumi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.27",
            "verseOrgIds": [
              "ACT.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.27",
            "verseOrgIds": [
              "ACT.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vahulira yaga vizura uvutima, nivatanga kuhanzuka, numwoyo munene, nivavoora “Munene kuvita ni Aritemi wa Efeso!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.28",
            "verseOrgIds": [
              "ACT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidaala liosi lizula kivihiri. Vamanya nivagumira Gayo na Arisitariko, avandu va Makedonia, avagendaa harara na Paolo, nivavakwesa vwangu nivingira munyumba yi mikinu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.29",
            "verseOrgIds": [
              "ACT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paolo mwene yenya kuzia imbiri wa avandu, navuzwa vandu avasuuviri vamwigalira. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.30",
            "verseOrgIds": [
              "ACT.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Valala ku vanene va Asia avaari avalina veve, vahilira Paolo amakuva nivamugoonya ativiika mu vudinyu kuzia munyumba yi mikinu mba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.31",
            "verseOrgIds": [
              "ACT.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'inga yene yeyo avandu vosi vavura kuhulirizana; avalala vahanzuka nivavoora yaga, na avandi yaga; kuduuka kiyaalo nikizula ligoyana nikivihiiri. Avanyingi kuvo kali sivamanya kivuni chagira ni vavuganira harara mba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.32",
            "verseOrgIds": [
              "ACT.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avalala ku Avayuda vasuguma Alekisanda imbiri, kutura mu kiduma kandi valala ku avaari mu kiduma vamuhanzukira nivaganagana niyie watangiza kilage. Alekisanda yaginga mukono vandu vaduuki kukiring'ana kunangwa ahaane liekinga imbiri wa avandu vosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.33",
            "verseOrgIds": [
              "ACT.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa lwa vamanyiriza ndi aveeye Muyuda, vosi vahanzuka nu mwoyo mulala, nivavoora, “Munene aveeye Aritemi wa Efeso!” Vazizagilira kuhanzuka ndio ku ing'inga yi zisa ziviri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.34",
            "verseOrgIds": [
              "ACT.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.34",
            "verseOrgIds": [
              "ACT.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyima mung'odi wi lidaala yakiring'anyia avandu, navavoolera, “ Munyi avandu va Efeso, mundu woosi amanyi ndi lidaala lia Efeso yili nilio liveeye mulindi wi litembeli lia nyasaye Aritemi, kandi mulindi wi kifananyi chaguluka kutura mwigulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.35",
            "verseOrgIds": [
              "ACT.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si ali ho nu unyala kwambakana amakuva yaga. Kunangwa, kiring'ani; mutakola kindu choosi madidikana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.36",
            "verseOrgIds": [
              "ACT.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumali kuleeta avandu yava hano kali niiva sivali kwiva vindu vie litembeli, anoho konyega nyasaye wiitu wi kikali Aritemi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.37",
            "verseOrgIds": [
              "ACT.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa niiva Demeturo harara na avasiza vache nivava nivaveeye na makuva gaavo ga vayaaliraa avandu yava, iviina viveeye ho, na aveene vanyara kuzia kuyaarana uwene yeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.38",
            "verseOrgIds": [
              "ACT.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa nimuva nimuveeye nu vudinyu vundi, muvuhiri mu kiyaalo kidukanaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.39",
            "verseOrgIds": [
              "ACT.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira kunyi kunyala kuyaalwa kolombi kivihiri cha makuva ga lero. Kivihiri yiki sikeveeye ni kivuni kidukanaa, kandi sikunyala kuhaana vivuni vivugilirwa ivileeti kivihiri yiki mba.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.40",
            "verseOrgIds": [
              "ACT.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa yamala kovora yaga yavolera vandu vazie.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.41",
            "verseOrgIds": [
              "ACT.19.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paolo yaazizaa Makedonia kandi Ivuguriki",
          "type": "text"
        }
      ]
    }
  ],
