          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vaali nivamulasa amagina, Sitefano yasaala navoora, “Mwami Yeso, vugula mwoyo gwange!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.59",
            "verseOrgIds": [
