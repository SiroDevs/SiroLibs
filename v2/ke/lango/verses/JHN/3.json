              "items": [
                {
                  "text": "Luk. 10.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Papo maro Wod, otyeko miyo jami luŋ aluŋa i ciŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano ame ye Wod, tye kede kwo a perakino nakanaka; dano a mom woro Wod, mom bino neno kwo, ento akemo Obaŋa tye i kome.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
