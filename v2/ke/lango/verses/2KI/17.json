              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rok magi rik te bedo woro Rwot kun oworo daŋ obaŋegi mogo ame opao apaa; itinogi daŋ te bedo timo amannono, anaka ikwaegi, kun otimo gin ame kwarigi obedo timo naka atot tin.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
