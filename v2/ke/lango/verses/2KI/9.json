          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akajia rik ocako bedo abaka me Juda i mwaka me apar wie acel me loc a Joram wot Akab.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        }
