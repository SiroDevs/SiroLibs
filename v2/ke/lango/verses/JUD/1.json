              "JUD.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JUD 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwogo bed baŋ ŋat a twero gwokowu aboŋo rette, dok twero miyo icuŋ wunu aboŋo roccoro i nyim kwogo mere ilelo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.24",
            "verseOrgIds": [
              "JUD.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JUD 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwogo, dit, loc kede twer obed baŋ Obaŋa acel keken Alarwa pi Yecu Kricito Rwotwa, geye a mom ru oketo lobo, aman, kede waŋ i wan. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.25",
            "verseOrgIds": [
              "JUD.1.25"
            ]
          }
        }
