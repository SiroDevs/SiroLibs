            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen kadi amanno, jo-ni daŋ i kite acellono, i lek ame gin leko, olilo komgi, okwero loc Obaŋa daŋ oko, dok ote yeto wegi kwogo-gu. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
