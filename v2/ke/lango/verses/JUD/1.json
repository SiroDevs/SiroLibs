              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baŋ jo ame olwoŋo ame bedo i mar Obaŋa Papo kede i gwok a Yecu Kricito.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
