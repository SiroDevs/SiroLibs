                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bala rik Codoma kede Gomora kede paco adoŋo ame omanogi ote donyo i tim me coco kede par areco a mom me anywalli, ote ŋolligi can me mac a mom to, gin obedo calo anen baŋ jo luŋ.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        }
