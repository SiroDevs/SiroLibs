              "EXO.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.2+EXO.6.3"
              },
              "items": [
                {
                  "text": "Yaa 6.2-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muca te penyo Obaŋa ni, “Kara ka an abino wot baŋ jo Icrael ate kobbigi ni Obaŋa a kwariwu ocwaa baŋwu an abino kobbigi ŋo ka ce gin dok openya ni, ‘Nyiŋe kara ŋa?’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.13",
            "verseOrgIds": [
              "EXO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.4"
              },
              "items": [
                {
                  "text": "Nyut 1.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Obaŋa te dokki Muca ni, “Atye Gira Acalo Atye. Kobbi jo Icrael ni ‘Atye ocwaa baŋwu.’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.14",
            "verseOrgIds": [
              "EXO.3.14"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.14",
            "verseOrgIds": [
              "EXO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obaŋa dok te kobbi Muca ni, ‘Myero ikobbi jo Icrael ni, “Rwot",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.15",
            "verseOrgIds": [
              "EXO.3.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.15",
              "type": "text"
            },
            {
              "text": "Leb Eburania: YHWH (Yawe)",
              "type": "text"
            },
            {
              "text": "ame gonyere ni, RWOT",
              "type": "text"
            }
          ]
        },
        {
          "text": "”, ame en Obaŋa a kwariwu, Obaŋa Iburaim, Obaŋa Icaka kede Obaŋa Yakobo, ocwaa baŋwu.’ Mannono bino bedo nyiŋa atwal; ibino lwoŋa wunu amannono i ka re ducu, naka ikwaewu daŋ luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.15",
            "verseOrgIds": [
              "EXO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wot icok odoŋe a jo Icrael ite tittigi ni, ‘Rwot ame Obaŋa a kwariwu, Obaŋa Iburaim, Obaŋa Icaka kede Obaŋa Yakobo, onyutte kene baŋa kun kobba ni, An ikoma doŋ atyeko neno gin a jo Miciri tye atimo i komwu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.16",
            "verseOrgIds": [
              "EXO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "doŋ atyeko moko me kwanyowu oko i lobo me Miciri, kan ame otye ka wunowu iye. Abino terowu i lobo a jo Kanaan, jo Kitti, jo Amor, jo Periji, jo Kivi, kede jo Jebuc, lobo ame opoŋ i cak kede moo kic.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.17",
            "verseOrgIds": [
              "EXO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odoŋe me Icrael bino gire ye koppi. Yin myero doŋ iwot karacel kedgi baŋ abaka me Miciri ite wot kobbe ni, ‘Wan orwatte kede Rwot, ame obedo Obaŋa a jo Eburania. Tim ber iyewa owot wot me nino adek i tim, me owot omi motwa ame oŋolo me yalo Rwot Obaŋawa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.18",
            "verseOrgIds": [
              "EXO.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋeo ni abaka me Miciri mom bino ye iwoto wunu ka mom odio adia i ciŋ atek, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.19",
            "verseOrgIds": [
              "EXO.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "pi mannono, an abino ryeyo ciŋa, abino pwodo jo Miciri i kite kwone taŋo luŋ ame abino tiyo i komgi. Icennere gin bino ye iwoto wunu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.20",
            "verseOrgIds": [
              "EXO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.35+EXO.12.36"
              },
              "items": [
                {
                  "text": "Yaa 12.35-36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok abino miyo cuny jo Miciri bedo yom i kom jowu. Mom obino miyo iwoto wunu ciŋwu nono i kare me yawu i Miciri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.21",
            "verseOrgIds": [
              "EXO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dako acel acel bino kwayo dako wadgi, kede dako ame bedo i ode, wel me ryal kede me jabu kede boŋŋi abeco a myero irukki itinowu awobe kede anyira. Man bino miyo iyako wunujami ajo Miciri.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.22",
            "verseOrgIds": [
              "EXO.3.22"
            ]
          }
        }
      ]
    }
  ],
