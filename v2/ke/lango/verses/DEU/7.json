                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet. 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Pien wunu ibedo wunu jo acil; wun ibedo wunu jo a Rwot Obaŋawu. Rwot Obaŋawu otyeko yerowu i akina rok luŋ ame tye i lobo me ibed wunu jo mere en ikome. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mar a Rwot rikomoko i komwu, te yerowu, mom pi welwu ame pol kato me a rok ocele, wun en ame onwoŋo doŋ inok wunu meicel i kom rok ocele luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento pien Rwot Obaŋawu rikomarowu, te gwoko kwoŋŋere a rik ekwoŋo baŋ kwariwu, en omio en okwanyowu kede teko me ciŋe, te lakorowu oko i ot me opii i ciŋ Parao, abaka me Miciri, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5+EXO.20.6"
              },
              "items": [
                {
                  "text": "Yaa 20.5-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6+EXO.34.7"
              },
              "items": [
                {
                  "text": "34.6-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Wel 14.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9+DEU.5.10"
              },
              "items": [
                {
                  "text": "Lodo 5.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Myero doŋ iŋe wunu ni Rwot Obaŋawu, en Obaŋa ame genne, ame gwoko cikere mere, dok daŋ gwoko marrere a mom lokere baŋ lwagi jo tutumia ame mare, dok daŋ mako cikkere luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento culo kwor i kom jo ame dage, kun nekogi oko. En mom bino weko ŋat a dage, en bino culo kwor i kome. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi mannono myero igwokere wunu i cobo cikkere, kede icwillere, kede gin ame ociko, ame acikowu kede tin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
