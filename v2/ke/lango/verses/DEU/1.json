              "DEU.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.18"
              },
              "items": [
                {
                  "text": "Eb. 3.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kare ame Rwot rik owinyo kop ame ikobo wunu, akemo omako, omio te kwoŋ ni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Mom tye ŋattoro i akina lwagi jo man areco-ni ame bino neno lobo aber ame rik akwoŋo ni abino miyo baŋ kwariwu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.35",
            "verseOrgIds": [
              "DEU.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kono ka Kaleb wot a Jepune keken. En bino neno, dok daŋ abino miyo lobo ame yam tyene onyono baŋe kede baŋ itino mere, pien en obedo lubo Rwot iyore ducu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akemo rik daŋ te mako Rwot naka i koma pirwu, eka te kobo ni, ‘Akadi yin daŋ mom ibino tuno i lobo-naca. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.37",
            "verseOrgIds": [
              "DEU.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa wot a Nuni ame konyi bino tuno iye; yin myero imi cunye bed tek, pien en bino miyo jo Icrael gamo lobo-naca me bedo megi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.38",
            "verseOrgIds": [
              "DEU.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itino ame wun ikobo wunu ni bino doko gin ame okworwu bino yako, itino ame aman mom romo poko gin aber kede gin arac, gin en ame bino wot kuno; abino miyo lobo-naca baŋgi, eka te bedo megi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.39",
            "verseOrgIds": [
              "DEU.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aco wun, lokere iwot wunu i dye tim tutuŋ Nam Arema.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wun rikite gamo wunu doga ni, ‘Wan doŋ otyeko balo baŋ Rwot, obino wot lweny kite ame Rwot Obaŋawa ocikowa kede.’ Ŋat acel acel rik te tweye i jami mere me lweny kun tamo ni bedo yot me wot kwaro lobo obedo kidikidi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Rwot rik te kobbe ni, ‘Kob baŋgi ni, Mom ibino wot wunu kuno, dok daŋ mom ibino lweny wunu, pien an mom abino wot kedwu i akinawu; mannono bino miyo okworwu loowu oko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en gin ame rik akobbiwu, cite wun giwu rikite jem wunu, kun ikwero wunu winyo gin ame Rwot ociko oko; rikite nwette wunu wot kwaro lobo obedo kidikidi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Amor ame onwoŋo bedo i lobo obedo kidikidi kuno te bino i komwu, ote ryemowu calo kic, ote keketowu oko i Ceir tuno kede naka i Korma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rik ibin idwogo wunu, ite bino kok wunu i nyim Rwot; cite Rwot mom daŋ te winyo kokowu, te daŋ kwero ciko yite oko i kopwu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mannono te miyowu bedo ri i Kadec pi kare alac meicel.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.46",
            "verseOrgIds": [
              "DEU.1.46"
            ]
          }
        }
      ]
    }
