        },
        {
          "text": "Man en kop ame Rwot okobo baŋ Jeremia adwarpiny i kom bino a Nebukadnejar, abaka me Babulon me bino lweny i kom lobo me Miciri: Rwot okobo ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
