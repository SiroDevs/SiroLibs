          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waraga man oya i baŋ Paulo ame akwena a Kricito Yecu pi cik Obaŋa Alarwa kede Yecu Kricito ame genwa ocuŋ i kome.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        }
      ]
    },
    {
