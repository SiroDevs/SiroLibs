                "loc": "MAT.24.30"
              },
              "items": [
                {
                  "text": "Mat. 24.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Nyut 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Abino onyo cuny me kica kede cuny me kwac i kom doggola a Daudi kede i kom jo ame bedo i Jerucalem, me wek ka gin oneno ŋat ame gin ocobo, gin okum pire, acalli ŋat ame kumo pi attinnere ame onywalo acel keken, dok me gin koke atek ateka, acalli ŋat ame koko atin kao. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino-nono kumo bino bedo dwon meicel i Jerucalem, acalli kumo pi Adad-rimmon i bar me Megiddo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lobo bino kumo kun doggola acel acel kumo kengi; jo me doggola a Daudi pat kun mongi daŋ kumo pat; jo me doggola a Natan pat kun mongi daŋ kumo pat; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo me doggoa a Levi pat kun mongi daŋ kumo pat; jo me doggola a Cimei pat kun mongi daŋ kumo pat; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "karacel kede doggola luŋ ame odoŋ, doggola acel acel bino kumo kengi kengi, kun mongi daŋ kumo kengi kengi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
