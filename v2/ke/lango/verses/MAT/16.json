              "items": [
                {
                  "text": "Lak. 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien dano ame mito laro kwo mere, bino rwenyo kwo mere arwenya, ento dano ame rwenyo kwo mere pira, bino nwoŋo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kara bino konyo dano kede ŋo ka ocamo lobo luŋ kun kwo mere omao oko? Onyo ŋo ame dano bino miyo pi dwoggo kwo mere? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
