                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien Wot a dano bino dwogo kede kwogo a Pappere karacel kede omalaika mere; i kare-nono bino culo dano acel acel kun lubo kit tic a yam etio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
