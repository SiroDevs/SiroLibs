              },
              "items": [
                {
                  "text": "Mat. 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.33"
              },
              "items": [
                {
                  "text": "23.33",
                  "type": "text"
