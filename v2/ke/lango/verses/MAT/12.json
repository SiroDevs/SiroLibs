              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.7"
              },
              "items": [
                {
                  "text": "Luk. 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.45"
              },
              "items": [
                {
                  "text": "6.45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wun itino ororo, itwero wunu kobo kop aber nino, ame kono wun jo areco? Pien kop ame ocokere i cunyi, en ame dog daŋ kobo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.34",
            "verseOrgIds": [
              "MAT.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano aber kwanyo gin aber i akina jami abeco ame en okano dano arac kwanyo gin arac i akina jami areco ame en okano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.35",
            "verseOrgIds": [
              "MAT.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akobbiwu ni kop ducu ame jo kobo aboŋo gwokere iye, obino piddigi pire i nino me ŋolo kop; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.36",
            "verseOrgIds": [
              "MAT.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien kop ame ikobo bino miyo iloo kop, dok kop ame ikobo bino miyo kop loyi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.37",
            "verseOrgIds": [
              "MAT.12.37"
            ]
          }
        }
      ]
    },
