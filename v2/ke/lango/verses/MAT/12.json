        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi mannono, akobbiwu ni, bal acel acel a jo tio kede ayet ducu ame oyeto kede Obaŋa, obino timogi iye kica, ento ayet ame oyeto kede Cuny Acil mom obino timo iye jo kica. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.31",
            "verseOrgIds": [
              "MAT.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.10"
              },
              "items": [
                {
                  "text": "Luk. 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok dano ame kobo kop arac i kom Wot a dano obino timo kica, ento dano ame kobo kop arac i kom Cuny Acil mom obino timo kica, kadi i kare man, onyo i kare a bino i nyim.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.32",
            "verseOrgIds": [
              "MAT.12.32"
            ]
          }
        }
      ]
    },
