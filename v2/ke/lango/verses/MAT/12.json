                  "text": "Luk. 6.44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Myero iŋe wunu ni yat aber nyige daŋ beco, yat arac nyige daŋ reco; pien yat ŋeye I kom nyige. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.33",
            "verseOrgIds": [
              "MAT.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
