    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icennere Yecu okobbi lwak kede jo a lube ni, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.1",
            "verseOrgIds": [
              "MAT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Opwony cik kede Oparicayo bedo i kom a Muca; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.2",
            "verseOrgIds": [
              "MAT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "pi mannono kop ducu ame gin pwonyowu kede, ti wunu daŋ ite mako wunu, ento gin ame gin tio, kur iti wunu; pien gin kobo akoba keken, mom otio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.3",
            "verseOrgIds": [
              "MAT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin tweo yec apek, a yeyo tek, ote keto i wi gwok jo, ento gin ikomgi mom koŋ oniŋo kede nyako ciŋgi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.4",
            "verseOrgIds": [
              "MAT.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.1"
              },
              "items": [
                {
                  "text": "Mat. 6.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.38"
              },
              "items": [
                {
                  "text": "Wel 15.38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.8"
              },
              "items": [
                {
                  "text": "Lodo 6.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ticgi ducu gin tio ka ni jo nengi; pien oyaro pulakterigi",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23.5",
              "type": "text"
            },
            {
              "text": "Pulakteri:",
              "type": "text"
            },
            {
              "text": "cao del ame kop Obaŋa tye i yie. Ojudaya tweo i tur nyimgi kede i ciŋgi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bedo alac, omedo ayayak me boŋŋigi bedo aboco meicel, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "dok daŋ omaro kabedo me kwogo i dog cem, kede kome me dito i kacokere, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.6",
            "verseOrgIds": [
              "MAT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "dok omito ni jo motgi i cuk, dok daŋ ni jo wadgi lwongi ni, Rabbi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.7",
            "verseOrgIds": [
              "MAT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wun mom myero lwoŋwu ni, Rabbi, pien apwonywu tye acel, wun ducu omego. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.8",
            "verseOrgIds": [
              "MAT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok daŋ kur ilwoŋ wunu dano moro ni papawu i wi lobo, pien Papawu tye acel, en ame tye i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.9",
            "verseOrgIds": [
              "MAT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok daŋ kur lwoŋowu ni opwony, pien apwonywu tye acel, en Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.10",
            "verseOrgIds": [
              "MAT.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.26+MAT.20.27"
              },
              "items": [
                {
                  "text": "Mat. 20.26-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.35"
              },
              "items": [
                {
                  "text": "Mar. 9.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.43+MRK.10.44"
              },
              "items": [
                {
                  "text": "10.43-44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.26"
              },
              "items": [
                {
                  "text": "Luk. 22.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano ame adwoŋ a loo i akinawu myero bed aticwu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.11"
              },
              "items": [
                {
                  "text": "Luk. 14.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.14"
              },
              "items": [
                {
                  "text": "18.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano ame kette kene ni etye malo, obino dwoke piny, ento ŋat a mwolle kene, obino tine malo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.12",
            "verseOrgIds": [
              "MAT.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.12",
            "verseOrgIds": [
              "MAT.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibino wunu neno can, wun opwony-cik kede Oparicayo, wun ogoba! Pien iceggi wunu jo doggola loc me polo oko; wun ikomwu mom idonyo wunu iye, dok daŋ igeŋo wunu jo a mito donyo iye oko. [",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.13",
            "verseOrgIds": [
              "MAT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibino neno wunu can, wun opwony-cik kede Oparicayo, wun ogoba! Pien imao wunu udi a mon a coggi oto, dok ikwao wunu Obaŋa nakanaka me gobagoba; kop ame obino ŋolo i wiwu bino bedo pek akato.] ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.14",
            "verseOrgIds": [
              "MAT.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibino wunu neno can, wun opwonycik kede Oparicayo, wun ogoba! Pien iloŋo wunu piny i wi nam kede peto piny i wi tela pi miyo dano acel loko dini mere me dwog i megwa, ento ka doŋ olokere, imie wunu doko atin me Geena ame rom aroma kedwu tyen aryo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.15",
            "verseOrgIds": [
              "MAT.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.15",
            "verseOrgIds": [
              "MAT.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibino wunu neno can, wun ope jo a waŋwu oto, ame ikobo wunu ni, ‘Ka dano okwoŋo kede ot Obaŋa, kopporo bedo mom iye, ento ka okwoŋo kede jabu me ot Obaŋa, kwoŋŋere bino make,’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.16",
            "verseOrgIds": [
              "MAT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun otowaŋ amiŋ! Kara mene a pire dwoŋ akato, jabu onyo ot Obaŋa ame omio jabu bedo acil? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.17",
            "verseOrgIds": [
              "MAT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok wun ikobo wunu ni, ‘Ka dano okwoŋo kede keno lam, kopporo mom iye, ento ka okwoŋo kede mot ame omio ame opyelo i wie, kwoŋŋere bino make,’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.18",
            "verseOrgIds": [
              "MAT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun jo a waŋwu oto! Kara mene ame pire dwoŋ akato, mot ame omio onyo keno me lam, ame en a mio mot omio iye bedo acil? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.19",
            "verseOrgIds": [
              "MAT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano ame okwoŋo kede keno me lam, nwoŋo okwoŋo kede keno anaka gin ame opyelo iye luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.20",
            "verseOrgIds": [
              "MAT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano ame kwoŋo kede ot Obaŋa, nwoŋo okwoŋo kede ot Obaŋa anaka ŋat a bedo iye daŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.21",
            "verseOrgIds": [
              "MAT.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.1"
              },
              "items": [
                {
                  "text": "Ica. 66.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.34"
              },
              "items": [
                {
                  "text": "Mat. 5.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano ame kwoŋo kede polo, nwoŋo okwoŋo kede kom me loc Obaŋa anaka ŋat ame bedo iye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.22",
            "verseOrgIds": [
              "MAT.23.22"
            ]
          }
        }
      ]
    },
