            "verseOrgIds": [
              "MAT.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kur itam wunu ni abino me kelo kuc i lobo; mom abino me kela kuc, ento pala me romo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.34",
            "verseOrgIds": [
              "MAT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.6"
              },
              "items": [
                {
                  "text": "Mik. 7.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien an abino poko akina dano kede pappere, dok nyako kede tottere, kede ci-wod gin kede tattere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.35",
            "verseOrgIds": [
              "MAT.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok okwor a dano bino bedo jo me paco mere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.36",
            "verseOrgIds": [
              "MAT.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano ame maro pappere onyo tottere kata mom romo bedo danona; kede dano ame maro wode onyo nyare kata, mom daŋ romo bedo danona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.37",
            "verseOrgIds": [
              "MAT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.24"
              },
              "items": [
                {
                  "text": "Mat. 16.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.34"
              },
              "items": [
                {
                  "text": "Mar. 8.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.23"
              },
              "items": [
                {
                  "text": "Luk. 9.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano a mom yeo yataria mere, te lubo kede ŋea mom romo bedo danona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.38",
            "verseOrgIds": [
              "MAT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
