                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ŋat ame jolowu, nwoŋo ojolo an; ŋat a jolo an, ojolo ŋat ame oora. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.40",
