              },
              "items": [
                {
                  "text": "Mat. 16.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.35"
              },
              "items": [
                {
                  "text": "Mar. 8.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.24"
              },
              "items": [
                {
                  "text": "Luk. 9.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.33"
              },
              "items": [
                {
                  "text": "17.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Lak. 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano ame onwoŋo kwo mere, bino rwenyo kwo mere arwenya; ento ŋat ame rwenyo kwo mere pira, bino nwoŋo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.39",
            "verseOrgIds": [
              "MAT.10.39"
            ]
          }
        }
      ]
