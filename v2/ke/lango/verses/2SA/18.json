              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akimac te redo kun kobbi abaka ni, “Jami ducu owoto aber.” En te ryebere piny i nyim abaka kun nyime gudo lobo, te kobo ni, “Pwoo Rwot Obaŋani, ame omio yin abaka iloo jo ame onwoŋo ojem i komi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaka Daudi te penye ni, “Woda Abicalom tye aber?” Akimac te kobo ni, “Kare ame Yoab ora an amironi, awinyo twon wo adwoŋ meicel, cite mom aŋeo ŋo ame otimere.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaka te kobbe ni, “Aco koŋ doŋ bin icuŋ kan.” En te wot cuŋ kan ame onyutte.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        }
      ]
    },
