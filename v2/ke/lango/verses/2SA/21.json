          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
