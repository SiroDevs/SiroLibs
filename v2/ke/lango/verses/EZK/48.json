          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "I tutuŋ to tye iye dogcel Acer, Gad kede Naputali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        },
        {
