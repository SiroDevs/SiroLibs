              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedo daŋ i Jiklag, kede i Mekona, kede i pacci ame tye i ŋetgi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
