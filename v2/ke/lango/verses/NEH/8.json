          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo mere odoŋe atekere ame loo doggola a kwarigi, karacel kede olamdog, kede jo Levi, owoto baŋ Ejira, me owot oni odoco gin ame cik mito ni jo tim, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
            {
              "text": "14",
