              "NEH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakere i nino me agege ame gin ogeo bedo kede i gonye tuno kede i nino me agikki mere, gin obedo kwano dul i buk me cik Obaŋa, Gin okwero ecuban me gonye pi nino abiro, eka i nino me aboro mere gin te bedo kede cokere adwoŋ, kite ame tye kede i buk cik.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
