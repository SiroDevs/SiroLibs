                  "text": "4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Epapira abuc wadwa i Kricito Yecu omoti, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
            "verseOrgIds": [
              "PHM.1.23"
            ]
          }
        },
