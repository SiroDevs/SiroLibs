                "loc": "JHN.19.15"
              },
              "items": [
                {
                  "text": "Lak. 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kadi bed gin rik mom onwoŋo kopporo i kome a romo miyo oŋolle to, gin okwao Pilato ni myero mi nek oko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.28",
            "verseOrgIds": [
              "ACT.13.28"
            ]
          }
        },
        {
