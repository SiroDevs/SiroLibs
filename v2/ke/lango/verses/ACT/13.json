              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.25",
            "verseOrgIds": [
              "ACT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omegona, ikwae Iburaim kede wun jo ocele ame ilworo wunu Obaŋa, kop man me larre ocwalliwa wunu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.26",
            "verseOrgIds": [
              "ACT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien jo a bedo i Jerucalem kede odoŋegi, rik mom oŋee, dok daŋ mom oniaŋ kop odwarpiny ame rik obedo kwannigi cabit i cabit. Gin gigi te miyo kop odwarpiny cobere kakare pi ŋolo kop loye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.27",
            "verseOrgIds": [
              "ACT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.22+MAT.27.23"
              },
              "items": [
                {
                  "text": "Mat. 27.22-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.13+MRK.15.14"
              },
              "items": [
                {
                  "text": "Mar. 15.13-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.21+LUK.23.22+LUK.23.23"
              },
              "items": [
                {
                  "text": "Luk. 23.21-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
