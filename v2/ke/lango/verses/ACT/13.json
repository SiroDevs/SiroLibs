              "attrs": {
                "loc": "JHN.19.38+JHN.19.39+JHN.19.40+JHN.19.41+JHN.19.42"
              },
              "items": [
                {
                  "text": "Lak. 19.38-42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A doŋ gin ocobo ginnoro ducu a rik ocoo i kome, gin te kwanye oko i kom yataria, pyele i lyel. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.29",
            "verseOrgIds": [
              "ACT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Obaŋa gire obin ocere oko iyi akina a jo oto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.30",
            "verseOrgIds": [
              "ACT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.3"
              },
              "items": [
                {
                  "text": "Tic 1.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En rik te bedo nen pi nino apol baŋ jo a nwaŋ obino kede i Galilaya kun owoto i Jerucalem; amanni jo-nono doŋ cadennere baŋ jo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wan doŋ okelliwu amut aber ni mano, gin ame rik Obaŋa ociko baŋ kwariwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Jab. 2.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "en doŋ ocobo oko kakare baŋwa wan ikwaegi, i cero Yecu, acalo rik ocoo i abuli me aryo ni,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare ame gin doŋ okato oko, lwak te kwayo ni kop man myero dok tittigi i cabit a bino ca. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.42",
            "verseOrgIds": [
              "ACT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "A doŋ cokere oket oko, Ojudaya apol kede jo olokere i dini Ojudaya ame woro Obaŋa rik te lubo Paulo gin kede Baranaba; gin rik te bedo kop kedgi kun oeukuro cunygi me medde bedo i kica Obaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka i ceŋ me aryo mere, jo me boma luŋ obuco cokere karacel pi winyo kop Obaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.44",
            "verseOrgIds": [
              "ACT.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite Ojudaya ka oneno lwak apol, nyeko te makogi atek, ote pyem i Paulo kun oyete ayeta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.45",
            "verseOrgIds": [
              "ACT.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo kede Baranaba te kop i tekcuny ni, “Onwoŋo myero yam koŋ oge rabbiwu kop Obaŋa. Ento kit ame wun giwu ibolo wunu oko teŋe, kun mom itamo wunu ni iromo wunu nwoŋo kwo a perakino nakanaka, wan doŋ olokere giwa baŋ Orok. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.46",
            "verseOrgIds": [
              "ACT.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.6"
              },
              "items": [
                {
                  "text": "Ica. 42.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.6"
              },
              "items": [
                {
                  "text": "49.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien Rwot ocikowa ni:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
              "ACT.13.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
              "ACT.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Orok owinyo, oyomoro yigi atek, ote keto kwogo i kop Obaŋa. Jo luŋ a nwaŋ oyero pi kwo a perakino nakanaka te doko jo oye Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.48",
            "verseOrgIds": [
              "ACT.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "ACT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kop a Rwot rik te lal i lobo-nono luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.49",
            "verseOrgIds": [
              "ACT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "ACT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojudaya rik te cupo monnogo a ŋeye, a woro Obaŋa, kede odoŋe me boma-nono; gin rik te tugo jo me wuno Paulo gin kede Baranaba, eka ote ryemogi oko i bomagi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.50",
            "verseOrgIds": [
              "ACT.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "ACT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.14"
              },
              "items": [
                {
                  "text": "Mat. 10.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.11"
              },
              "items": [
                {
                  "text": "Mar. 6.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.5"
              },
              "items": [
                {
                  "text": "Luk. 9.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.11"
              },
              "items": [
                {
                  "text": "10.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Paulo-gi te teŋo apua me tyengi i komgi, ote wot gigi i Ikonio. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.51",
            "verseOrgIds": [
              "ACT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "ACT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olub Yecu rik te lelo, Cuny Acil te poŋ i yigi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.52",
            "verseOrgIds": [
              "ACT.13.52"
            ]
          }
        }
      ]
    }
