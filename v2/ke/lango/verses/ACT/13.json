            "style": "v",
            "sid": "ACT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.57+MAT.27.58+MAT.27.59+MAT.27.60+MAT.27.61"
              },
              "items": [
                {
                  "text": "Mat. 27.57-61",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.42+MRK.15.43+MRK.15.44+MRK.15.45+MRK.15.46+MRK.15.47"
              },
              "items": [
