                "loc": "JOB.12.14"
              },
              "items": [
                {
                  "text": "Yubu 12.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ban amalaika a lwak oye an ame tye i Piladelpia co ni mano:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Man kop a ŋat acil kede me ateni, ame tye kede agony a Daudi, ŋat ame ka oyabo, ŋattoro mom dok bino cego, dok ka ocego, ŋattoro mom dok bino yabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“An aŋeo ticci ducu. Nen, doŋ aketo i nyimi doggola ame oyabo, ame ŋattoro mom twero cego. Aŋeo ni tekoni nok, ento kadi amanno, ityeko mako koppa, dok pe ru ikwero nyiŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.8",
            "verseOrgIds": [
              "REV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.23"
              },
              "items": [
                {
                  "text": "Ica. 49.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.14"
              },
              "items": [
                {
                  "text": "60.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.4"
              },
              "items": [
                {
                  "text": "43.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nen ba, abino miyo jo me eryoŋet a Catan ame miye ni gin Ojudaya, aco kun nono, pien gin ogoba, nen, abino miyogi bino ryebere piny i te tyeni, me gin oniaŋ ni an kara amari. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.9",
            "verseOrgIds": [
              "REV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien yin imako koppa me diyo cuny, an daŋ abino gwoki oreme i kare me omo yic ame abino i wi podo luŋ, me temo jo ame bedo i wi lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.10",
            "verseOrgIds": [
              "REV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino oyotoyot. Lid atek gin ame itye kede, me ŋattoro kur ma tok kwogoni oko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.11",
            "verseOrgIds": [
              "REV.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.2"
              },
              "items": [
                {
                  "text": "Nyut 21.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.2"
              },
              "items": [
                {
                  "text": "Ica. 62.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.15"
              },
              "items": [
                {
                  "text": "65.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ŋat ame oloo, abino miyo doko pagi i ot Obaŋana, daŋ mom dok bino ya iye. Abino coyo i kome nyiŋ Obaŋana, kede nyiŋ boma Obaŋana, en Jerucalem anyen ame bino piny ya i polo i baŋ Obaŋana kede dok nyiŋa anyen an ikoma. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.12",
            "verseOrgIds": [
              "REV.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat a tye kede yit, myero owiny kop ame Cuny Acil okobo baŋ lwak oye an ducu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.13",
            "verseOrgIds": [
              "REV.3.13"
            ]
          }
        }
      ]
    },
