              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baŋ amalaika a lwak oye an ame tye i Caradic co ni mano:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.1",
            "verseOrgIds": [
              "REV.3.1"
            ]
          }
        }
