                "loc": "PRO.8.22"
              },
              "items": [
                {
                  "text": "Caro. 8.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baŋ amalaika a lwak oye an ame tye i Laodikia co ni mano:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Man kop oya i baŋ Amen, ame en acaden ame genne kede me ateni, gin ducu ame Obaŋa oketo ogeye i kome.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘An aŋeo ticci ducu. Yin mom iŋic, mom daŋ ilyet gire. Onwoŋo twero bedo ber kono iŋic onyo ilyet. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.15",
            "verseOrgIds": [
              "REV.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi bedoni amomor, kun mom ilyet, mom iŋic daŋ, abino ŋuli gira oko i doga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.16",
            "verseOrgIds": [
              "REV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yin ikobo ni, “An gira a won abar, an doŋ alony oko, mom doŋ tye ginnoro ame amito.” Aco kono mom iŋeo ni yin ŋat ame piny oloo, icono jo, yin acan, waŋi oto, ibedo onoro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.17",
            "verseOrgIds": [
              "REV.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi mano amii ryeko me wilo i baŋa jabu acil ame olio i mac, me ite doko alonyo. Wil daŋ i baŋa boŋŋi atar me arukani me wumo lewic me bedoni onoro kur nen, kede dok yattoro me awira i waŋi, me inen piny. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.18",
            "verseOrgIds": [
              "REV.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.12"
              },
              "items": [
                {
                  "text": "Caro. 3.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.6"
              },
              "items": [
                {
                  "text": "Eb. 12.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "An gira agoo jo ame amaro, apwonyogi; myero doŋ iket teko, iŋut oko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.19",
            "verseOrgIds": [
              "REV.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen, acuŋ i dogolla kun atwomo. Ka ce ŋattoro owinyo dwona, eka te yabo doggola, abino katto baŋe, eka ate cem kede kun en daŋ camo keda.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat ame oloo, abino miyo en bedo karacel kade i kom me locca, kite acalo an rik aloo, eka ate bedo wan i Pappa i kom me loccere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat ame tye kede yit, myero owiny kop ame Cuny Acil okobo baŋ lwak oye an ducu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.22",
            "verseOrgIds": [
              "REV.3.22"
            ]
          }
        }
      ]
    }
