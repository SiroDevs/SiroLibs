                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.7+REV.17.8+REV.17.9+REV.17.10+REV.17.11+REV.17.12"
              },
              "items": [
                {
                  "text": "7-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok ate neno lee moro ame adonnyo iyi nam, ame tye i tuŋe apar kede wie abiro, kun tok kwogo apar me loc tye i tuŋe-nogo luŋ; i wie acel acel daŋ tye iye nyinnoro ame nyuto acae i kom Obaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.4+DAN.7.5+DAN.7.6"
              },
              "items": [
                {
                  "text": "Dan. 7.4-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lee ame anenonu rik cal i kwac, tyene cal i tyen dubu, doge cal i dog eŋato. Twon twol iyiliyili ca te miyo baŋe teko mere, kede kom loccere, kede twer adwoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wie acel iloki ogoo oneko oko, ento kan ame owano a romo neke onwoŋo doŋ ocaŋ oko. Lobo luŋ te wapo lee-nono kun owuro awura. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.3",
            "verseOrgIds": [
              "REV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo oworo twon twol iyiliyili ca, pien en omio twerrere baŋ lee-nono, dok daŋ ote woro lee kun okobo ni, “Ŋa kara a cal i Iee-ni, dok ŋa a twero lweny kede?”",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
