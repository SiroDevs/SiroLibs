              ]
            }
          ]
        },
        {
          "text": "“Nen, an doŋ a ceggi bino, kun aketa daŋ motta me pwoc, me ami ŋat acel acel ame oporo tic a en otio. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
