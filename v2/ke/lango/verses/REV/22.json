                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo ame lwoko rukgi oko me gin obed i twer me camo yat me kwo, kede me donyo i boma kun obeo i dog cel, jo-nono tye kede winyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oko i ne boma tye iye otim tim gwogwok, otim tim jojok, ococo, onek jo, owor cal jogi kede jo luŋ ame maro gin me goba, dok tio.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
      ]
