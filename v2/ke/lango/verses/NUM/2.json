          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ame jo mere okwano oromo tutumia pyeraŋwen nono kede mia abic nono. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
            "verseOrgIds": [
              "NUM.2.19"
            ]
          }
        },
        {
