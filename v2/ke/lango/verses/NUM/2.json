          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo ame bino bino guro kemagi aceggi kedgi bino bedo jo me atekere a Manace; atel a Manace obedo Gamaliel wot a Pedajur, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
