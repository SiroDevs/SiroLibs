          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo ame bino guro kemagi aceggi kedgi bino bedo jo me atekere a Cimeon; atel a jo Cimeon obedo Celumiel wot a Juricadia, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
