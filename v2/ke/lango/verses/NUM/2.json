          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ame jo mere okwano oromo tutumia pyeraŋwen wie abic kede mia abicel i pyerabic nono. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
            ]
