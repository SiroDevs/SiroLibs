          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka dok atekere a Benjamin; atel a jo Benjamin obedo Abidan wot a Gideoni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
            "verseOrgIds": [
