          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ame jo mere okwano oromo tutumia pyeradek wie aryo kede mia aryo nono. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
