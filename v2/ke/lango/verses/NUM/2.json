          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Epraim en ame bino bedo i te benderagi tuŋ to kun oguro eryoŋet eryoŋet; atel a jo Epraim obedo Elimaca wot Amikud, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.18",
            "verseOrgIds": [
              "NUM.2.18"
            ]
          }
        },
        {
          "name": "verse",
