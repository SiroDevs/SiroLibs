            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nino ducu en obedo ka pwony i ot Obaŋa dyeceŋ, ento dyewor en woto buta i wi kidi ame olwoŋo kidi me Jeituni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
