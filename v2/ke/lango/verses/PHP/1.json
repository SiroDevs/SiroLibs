          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien en omiowu winyo pi Kricito, mom winyo me ye en keken, cite dok winyo me neno can pire. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.29",
