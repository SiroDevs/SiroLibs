              "JOS.13.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Wel 32.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12"
              },
              "items": [
                {
                  "text": "Lodo 3.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo Reuben kede jo Gad karacel kede nucu me atekere a Manace ocele otyeko nwoŋo lobo ame gin bino leyo me bedo megi ame rik Muca omiogi loka Jordan tuŋ kide, kite a rik Muca amiro a Rwot omiogi: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.8",
            "verseOrgIds": [
              "JOS.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "cakere i Areor ame tye i dog luŋ me Amon, kede boma ame tye i dye luŋŋono, karacel kede lobo luŋ me Medeba, ame otiŋere, opette, tuno naka i Dijon; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.9",
            "verseOrgIds": [
              "JOS.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede boma a Cikon abaka a jo Amor, ame en obedo abaka me Kecbon, tuno i waŋ lobo a jo Ammon; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.10",
            "verseOrgIds": [
              "JOS.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede Gilead, kede lobo a jo Gecur kede jo Maaka, kede kidi Kermon luŋ, kede Bacan luŋ tuno kede i Caleka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.11",
            "verseOrgIds": [
              "JOS.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede lobo abaka Og luŋ ame loo lobo Bacan kun bedo i Aciterot kede Edrei; en kene ame rik odoŋ i akina jo Repa. Muca onwoŋo oloo magi, te daŋ mayo lobogi oko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.12",
            "verseOrgIds": [
              "JOS.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite jo Icrael rik mom oryemo jo Gecur kede jo Maaka. Jo Gecur kede jo Maaka pwod bedo i akina jo Icrael naka atot tin.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
