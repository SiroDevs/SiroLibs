        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
            "verseOrgIds": [
              "JOS.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "A doŋ magi luŋ otum Yocwa wot a Nuni, amiro a Rwot te doŋ to oko kun onwoŋo mwaka me dittere oromo mia acel kede apar. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.49+JOS.19.50"
              },
              "items": [
                {
                  "text": "Yoc. 19.49-50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin rik te yike i lobo mere ame rik omie i Timnat-cerak i lobo me Epraim obedo kidikidi, ame tye tuŋ anyarodi me kidi me Gaac.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
      ]
