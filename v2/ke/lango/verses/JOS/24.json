            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Icrael rik otiyi Rwot i kare a Yocwa luŋ, kede i kare odoŋe luŋ a rik lubo Yocwa, oweko pwod kwo dok daŋ oŋeo ginnoro ame Rwot otio pi Icrael.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
