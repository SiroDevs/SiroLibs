              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabulon rik mom oryemo jo ame onwoŋo bedo i Kitron, akadi jo ame onwoŋo bedo i Nakalol; ento jo Kaanan obedo i akinagi, ote doko opiigi kun otio tic atek me opii opii.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
