          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acer rik mom oryemo jo ame onwoŋo bedo i Akko, akadi jo ame onwoŋo bedo i Cidon, akadi jo Arab, onyo me Akjib, onyo me Kelba, onyo me Apik, onyo me Rekob. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento jo Acer obedo i akina jo Kaanan ame gin onwoŋo obedo wegi lobo-nono, pien jo Acer rik mom oryemogi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        }
      ]
