                  "text": "36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien wan oŋeo ŋat ame okobo ni, “An ame abino culo kwor, an abino lunyo icen,” dok ni, “Rwot bino ŋolli jo mere kop.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me lworo meicel, ipoto i ciŋ Obaŋa akwo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakare, koŋ ipoyo wunu kare okato, kite a rik ikanyakino wunu, kun ilwenyo wunu kede lwak can apol, i kare a doŋ acara Obaŋa otyeko menyowu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
            "verseOrgIds": [
              "HEB.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare ocele rik oyetowu dok owunowu i nyim lwak, kare ocele inotte wunu kede jo ame otimogi amannono. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien kica rik omakowu i kom obuc, dok daŋ yiwu obedo yom ata kadi oyako jamiwu, pien wun giwu onwoŋo iŋeo wunu ni itye wunu kede jami ocele abeco akato magu, dok ame bino perakino. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ ba, kur iwuc wunu tekcunywu oko, pien bino kelo mot abup me pwoc. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
              "HEB.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyakino en gin a mitte meicel i tuŋ baŋwu, me iti wunu gin ame Obaŋa mito, ite nwoŋo wunu gin a rik en ociko pire, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
            "verseOrgIds": [
              "HEB.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
