              },
              "items": [
                {
                  "text": "Abak. 2.3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "acalo rik ocoo ni,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
