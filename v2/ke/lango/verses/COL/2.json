              "COL.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.1+EPH.2.2+EPH.2.3+EPH.2.4+EPH.2.5"
              },
              "items": [
                {
                  "text": "Ep. 2.1-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun ame rik onwoŋo daŋ ito wunu oko pi balwu kede pi mom liro riŋo komwu, aman doŋ Obaŋa omio ikwo wunu oko karacel kede wegi twer ducu. Kede Kricito, kun daŋ otimowa kica i balwa ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.13",
            "verseOrgIds": [
              "COL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.15"
              },
              "items": [
                {
                  "text": "Ep. 2.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waraga me bannyi ame ocoo i wiwa pi cik a rik omio kop oloowa, en oweo gire oko; ocwao oko teŋe kun oguro oko i kom yataria. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.14",
            "verseOrgIds": [
              "COL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kricito doŋ omao jami me romo oko i baŋ jogi ame oloc kede wegi twer, kun ŋatte kannaler i kom yataria ni doŋ eloogi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        }
      ]
    },
    {
