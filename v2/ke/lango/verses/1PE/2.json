                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.14"
              },
              "items": [
                {
                  "text": "Tit. 2.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.2"
              },
              "items": [
                {
                  "text": "Ica. 9.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cite wun ibedo wunu rok ame oyero, olamdog abaka, rok acil, jo Obaŋa ame mere ikome, me wek irab wunu pi tic me kwogo a ŋat olwoŋowu iya i piny acol me idony wunu i lero mere me awura. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.23"
              },
              "items": [
                {
                  "text": "Koc. 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yam mom ibedo wunu jo Obaŋa, cite aman wun, doŋ idoko wunu jo mere; yam mom otimowu kica, cite aman doŋ otimowu kica.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun ame amaro, abako doga baŋwu, acalo wun wele, mom jo me lobo man, kwer wunu mit me kom oko ame romo kede tipowu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bed wunu i kite abeco i akina jo a mom ŋeo Obaŋa, me wek ka ce gin oyetowu ni wun otim gin arac, gin onen ticwu aber, daŋ omi kwogo baŋ Obaŋa i nino ame en bino roto iye lobo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi Rwotwa, myero imiye wunu i te loc me twer ducu a tye iyi akina lwak; baŋ aloc adwoŋ, pien en ame loo jo luŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.13",
            "verseOrgIds": [
              "1PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede baŋ oloc ame en ocwalo pi keto can i kom jo a timo gin areco, kede pwoyo jo a timo gin abeco. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.14",
            "verseOrgIds": [
              "1PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien Obaŋa mito ni itim wunu gin aber, me imi wunu jo amiŋ a kwia piny liŋ oko. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.15",
            "verseOrgIds": [
              "1PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwowu bed kwo a jo a loye kengi, kun mom itio wunu kede lockenwu pi timo tim arac; cite bed wunu bala opii Obaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.16",
            "verseOrgIds": [
              "1PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wor wunu jo luŋ. Maru omegowu. Lworu Obaŋa. Woru aloc adwoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun omiro, miye wunu i te loc odoŋewu kede woro luŋ, mom ka baŋ jo okica kede amwol keken, ento baŋ ogero daŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.18",
            "verseOrgIds": [
              "1PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien man en gin ame opwoo, ka ce dano kanyo rem pien cunye tye i kom Obaŋa, ka owune kun mom obalo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.19",
            "verseOrgIds": [
              "1PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kara myero pwowu i ŋo, ka idio wunu cunywu ka opwodowu pi bal? Cite ka ce idiyo cunywu ka ineno wunu can pi timo gin aber, mano en Obaŋa pwoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.20",
            "verseOrgIds": [
              "1PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien olwoŋowu pi mannono; pien Kricito daŋ oneno can pirwu, owekkiwu anen me aluba, me iwap wunu yore. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.21",
            "verseOrgIds": [
              "1PE.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.9"
              },
              "items": [
                {
                  "text": "Ica. 53.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balloro mom a en otimo, lebe daŋ mom okobo goba. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.7"
              },
              "items": [
                {
                  "text": "Ica. 53.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka jo oyete, mom oyetogi. Ka oneno can, mom oburo jo; cite omiye kene baŋ ŋat aŋolo kop atir. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.23",
            "verseOrgIds": [
              "1PE.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.5"
              },
              "items": [
                {
                  "text": "Ica. 53.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
