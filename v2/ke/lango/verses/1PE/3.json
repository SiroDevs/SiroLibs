                "loc": "COL.3.18"
              },
              "items": [
                {
                  "text": "Kol. 3.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amannono daŋ, wun mon miye wunu i te loc a cogwu, me wek ka ce mogo i akinagi mom lubo kop Obaŋa, otwero lokere pi kite a mongi, kadi bed gin mom okobo kopporo i doggi, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka gin oneno kitewu acil dok me woro. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.9"
              },
              "items": [
                {
                  "text": "1 Tem. 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rukwu mom bed me oko, acalo kedo yer wic, rwako tigo jabu, ruko boŋŋi abeco, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "cite rukwu bed i kite me cuny a mom nen. Ruk ame mom balle en cuny amwol, ame liŋ mot; mano en ame wellere dwoŋ i nyim Obaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien i kare acon, mon acil ame omoko gengi i kom Obaŋa yam rukere i kittono, kun daŋ omiye i te loc a coggi, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.12"
              },
              "items": [
                {
                  "text": "Age. 18.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "acalo Cara rik winyo dog Iburaim, kun pake ni, “Adwoŋŋa.” Wun daŋ aman wun itino mere, ka itimo wunu gin aber, kun mom ginnoro miowu lworo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
      ]
    },
    {
