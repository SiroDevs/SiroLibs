            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi gin rwode ame oya i baŋ Ecau, kun lubere kede atekeregi kede kabedogi, kede nyiŋgi, rwot Timna, rwot Alwa, rwot Yetet, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
