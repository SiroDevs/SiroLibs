          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lebeka te kobbi Icaka ni, “An gira kite anyira a jo Kitti doŋ oola oko. Ka Yakobo daŋ dok bino nyomo nya jo Kitti, ame rom aroma i mon ocele me lobo man, kwona doŋ konnyere bino bedo mom.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
      ]
