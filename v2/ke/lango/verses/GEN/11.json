          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Arpakcad doŋ otyeko ri mwaka pyeradek wie abic me dittere, onywalo Cela, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arpakcad ori mwaka mia aŋwen kede adek a doŋ otyeko nywalo Cela, dok rik daŋ omedo nywalo awobe kede anyira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
