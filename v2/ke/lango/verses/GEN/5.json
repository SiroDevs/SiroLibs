        },
        {
          "text": "Kare ame Ceji doŋ ori oromo mwaka mia acel kede abic, onywalo Enoci. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
