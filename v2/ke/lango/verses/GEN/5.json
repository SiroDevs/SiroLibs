          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ŋe nywalo Enoci, Ceji ori mwaka mia aboro kede abiro, dok rik daŋ omedo nywalo awobe kede anyira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
