                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.6"
              },
              "items": [
                {
                  "text": "Mar. 10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oketogi co kede mon, omiogi gum, dok te cako nyiŋgi ni Dano i nino ame oketogi iye-nono. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare ame Adam doŋ ori oromo mwaka mia acel kede pyeradek, onywalo awobi ame cal kede en ikome; te cako nyiŋe Ceji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka Adam i kare ame en doŋ otyeko nywalo Ceji rik oromo mia aboro, dok rik daŋ omedo nywalo awobe kede anyira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi mannono, mwaka Adam luŋ ame ori kede i lobo te doŋ to, romo mia aboŋwen kede pyeradek.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
      ]
    },
