          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi mannono, mwaka a Ceji luŋ ame ori kede i lobo te to, romo mia aboŋwen kede apar wie aryo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
