        },
        {
          "text": "Man en coc ame nyuto ikwae Adam, I kare ame Obaŋa keto dano, ocweo dano i callere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
