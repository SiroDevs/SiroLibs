                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17+DEU.5.18+DEU.5.19"
              },
              "items": [
                {
                  "text": "Lodo 5.17-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Olev. 19.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien maginogo ni, “Kur icod cot, Kur inek, Kur ikwal, Kur imit jami a ŋat ocele,” kede icwillogo ocele luŋ onotte karacel i kop man ni, “Mar dano wadwu acalo imarre keni.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amar jo mom timo dano wadgi arac; pi mannono, mar en a cobo cik.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiu man kun iŋeo wunu kare ame otye iye, ni, caa doŋ orommiwu me cooko i waŋ nino; pien onyoni larre mewa doŋ onoko ceggi, kato i kare a rik okwoŋo ye iye Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dyewor doŋ ceggi tum, piny doŋ mito ru. Doŋ obolu tic me piny acol oko, oruku jami romo me dyeceŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olubu kite a myero me dyeceŋ, aboŋo gat me yomcuny arac kede mero, aboŋo tiŋo luk kede tim me tarwaŋ, aboŋo daa kede nyeko. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruku Rwot Yecu Kricito acalo rukwu me romo, dok kur itam wunu pi kwowu me anywalli pi cobo mittere.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
        }
      ]
    }
  ],
