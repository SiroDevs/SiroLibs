      },
      "items": [
        {
          "text": "Waan Qulqulluu fi Waan Xuraaʼaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
