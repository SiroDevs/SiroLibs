          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis itti fufee akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wanni nama 'xureessu' waan nama keessaa baʼuu dha.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.20",
                "verseOrgIds": [
                  "MRK.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yaadni hamaan keessa namaatii, garaa namaa keessaa baʼaatii; innis halalummaa, hanna, nama ajjeesuu, ejja,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.21",
                "verseOrgIds": [
                  "MRK.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.21",
            "verseOrgIds": [
              "MRK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "doqnummaa, hammina, gowwoomsaa, jireenya gad dhiisii, hinaaffaa, maqaa nama balleessuu, of tuulummaa fi gowwummaa.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.22",
                "verseOrgIds": [
                  "MRK.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.22",
            "verseOrgIds": [
              "MRK.7.22"
            ]
          }
        },
        {
