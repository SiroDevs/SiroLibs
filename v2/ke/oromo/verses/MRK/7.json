          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wantoonni hamoon kunneen hundinuu nama keessaa baʼu; namas 'ni xureessu.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.23",
