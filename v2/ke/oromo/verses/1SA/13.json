  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saamuʼeel Saaʼolitti Dheekkamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol yeroo mootii taʼetti umuriin isaa waggaa soddoma ture; innis waggaa afurtamii lama Israaʼelin bulche.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol namoota kuma sadii Israaʼel keessaa filate; kumni lama Mikmaasii fi biyya gaaraa Beetʼeelitti Saaʼol wajjin, kumni tokko immoo biyya Beniyaam keessatti Gibeʼaatti Yoonaataan wajjin turan. Namoota kaan garuu gara mana mana isaaniitti deebise.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.2",
            "verseOrgIds": [
              "1SA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaataan qubata waraana Filisxeemotaa kan Gibeʼaa keessa ture sana dhaʼe; Filisxeemonnis waaʼee kanaa dhagaʼan. Kana irratti Saaʼol, \"Ibroonni hundinuu haa dhagaʼani!\" jedhee biyyattii guutuu keessatti malakata afuufsise.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.3",
            "verseOrgIds": [
              "1SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼel hundinuus oduu, \"Saaʼol qubata waraana Filisxeemotaa dhaʼeera; Israaʼelis Filisxeemota biratti balfameera\" jedhu dhagaʼan. Namoonnis Saaʼol duukaa buʼuuf Gilgaalitti walitti qabaman.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonnis Israaʼeloota waraanuuf gaariiwwan kuma soddoma, namoota gaarii oofan kuma jaʼaa fi loltoota akka cirracha galaanaa baayʼataniin hiriiran. Ol baʼaniis karaa baʼa Beet Aawwen iddoo Mikmaas jedhamu qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Israaʼel yommuu akka haalli isaan keessa jiran sodaachisaa taʼee fi akka loltoonni isaanii sardamaa jiran arganitti holqa keessa, qoraattii keessa, kattaa keessa, bowwaa keessaa fi boolla keessa dhokatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibroonni tokko tokko immoo Yordaanos ceʼanii biyya Gaadii fi Giliʼaad dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 13:7"
      },
      "items": [
        {
          "text": "Saaʼol garuu Gilgaalitti hafe; loltoonni isa wajjin turan hundinuus sodaadhaan hollachaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma yeroo Saamuʼeel murteesse sanaatti bultii torba eege; Saamuʼeel garuu gara Gilgaal hin dhufne; namoonni Saaʼolis bibittinnaaʼuu jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
            "verseOrgIds": [
              "1SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis, \"Aarsaa gubamuu fi aarsaa nagaa as naa fidaa\" jedhe. Innis aarsaa gubamu ni dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma Saaʼol aarsaa dhiʼeessee xumureen Saamuʼeel dhufe. Saaʼolis isa simachuuf gad baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.10",
            "verseOrgIds": [
              "1SA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saamuʼeel, \"Ati maal gochuu kee ti?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 13:11"
      },
      "items": [
        {
          "text": "Saaʼolis deebisee akkana jedhe; \"Ani yeroon akka sabni bibittinnaaʼe, akka ati yeroo murteeffametti hin dhufinii fi akka Filisxeemonni Mikmaasitti walitti qabaman argetti,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Filisxeemonni Gilgaalitti natti dhufan; anis surraa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.13.12",
                "verseOrgIds": [
                  "1SA.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "hin kadhanne' jedheen yaade. Kanaafuu aarsaa gubamu dhiʼeessuun dirqama natti taʼe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saamuʼeelis akkana jedhe; \"Ati waan siif hin malle hojjete; ajaja",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.13.13",
                "verseOrgIds": [
                  "1SA.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee siif kenne hin eegne; utuu ajaja isaa eegdee jiraattee inni mootummaa kee Israaʼel irratti jabeessee bara baraan ni dhaaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu mootummaan kee jabaatee hin dhaabatu;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.13.14",
                "verseOrgIds": [
                  "1SA.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nama akka fedhii garaa isaa taʼe argateera; sababii ati ajaja",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.13.14",
                "verseOrgIds": [
                  "1SA.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "hin eeginiif inni dura deemaa saba isaa godhatee isa muudateera.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Saamuʼeel Gilgaal dhiisee gara Gibeʼaa ishee biyya Beniyaam keessatti argamtuutti ol baʼe; Saaʼolis namoota isa wajjin turan ni lakkaaʼe. Baayʼinni isaaniis gara nama dhibba jaʼa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israaʼeloonni Meeshaa Waraanaa Hin Qabanne",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Filisxeemonni Mikmaas keessa qubatanii turanitti Saaʼol, ilmi isaa Yoonaataanii fi namoonni isaan wajjin turan biyya Beniyaam Gibeʼaa keessa turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gareen weerartootaa iddoo sadiitti qoodamanii qubata Filisxeemotaatii baʼan. Gareen tokko gara Ofraa kan biyya Shuuʼaali keessa jiru sanaatti qajeele;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
              "1SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "gareen lammaffaan karaa Beet Horoonitti, gareen sadaffaan immoo karaa daarii irraangadee Sulula Zebooʼiim kan fuullee gammoojjiitti geessu irra buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Filisxeemonni, \"Ibroonni goraadee yookaan eeboo ofii isaaniitiif hin tumsiifatin!\" jedhanii turaniif Israaʼel hunda keessatti namni sibiila tumu tokko iyyuu hin argamne.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.19",
            "verseOrgIds": [
              "1SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Israaʼeloonni hundi maarashaa isaanii, gasoo isaanii, dhagaraa fi haamtuu isaanii qarsiifachuuf gara Filisxeemotaatti gad buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatiin ittiin maarashaa fi gasoo qarsiifatan saqilii tokko irraa harka sadii keessaa harka lama; qorbii, dhagaraa fi meeshaa ittiin qotiyyoo tuttuqan qarsiifachuuf immoo saqilii tokko irraa harka sadii keessaa harka tokko kaffalu turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu guyyaa waraanaa Saaʼolii fi Yoonaataan malee loltuun tokko iyyuu goraadee yookaan eeboo hin qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.22",
            "verseOrgIds": [
              "1SA.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoonaataan Filisxeemota Rukutuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafuma sana gareen Filisxeemotaa tokko gara malkaa Mikmaasitti gad buʼe.",
