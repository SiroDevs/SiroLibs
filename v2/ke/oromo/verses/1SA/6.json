          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Taabonni Gara Israaʼelitti Deebiʼe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taabonni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.1",
            "verseOrgIds": [
              "1SA.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.1",
                "verseOrgIds": [
                  "1SA.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Filisxeem keessa jiʼa torba ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.1",
            "verseOrgIds": [
              "1SA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonnis lubootaa fi ilaaltota waamanii, \"Taabota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.2",
            "verseOrgIds": [
              "1SA.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.2",
                "verseOrgIds": [
                  "1SA.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "maal haa goonu? Iddoo isaatti haala akkamiitiin akka deebifnu nutti himaa\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.2",
            "verseOrgIds": [
              "1SA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis deebisanii, \"Yoo taabota Waaqa Israaʼel deebiftan, kennaa yakkaa wajjin malee duwwaa isaa hin deebisinaa; ergasii isin ni fayyitu; harki isaas maaliif akka isin irraa hin kaafamin ni beektu\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.3",
            "verseOrgIds": [
              "1SA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonnis, \"Kennaan yakkaa kan nu erginuuf maal taʼuu qaba?\" jedhanii gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.4",
            "verseOrgIds": [
              "1SA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 6:4"
      },
      "items": [
        {
          "text": "Isaanis akkana jedhanii deebisan; \"Sababii dhaʼichi isinii fi bulchitoota keessan rukute tokkuma taʼeef akkuma baayʼina bulchitoota Filisxeemotaatti dhiitoo warqee shananii fi hantuuta warqee shan ergaa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.4",
            "verseOrgIds": [
              "1SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fakkii dhiitoo fi fakkii hantuutaa kanneen biyya balleessaa jiranii hojjedhaa; Waaqa Israaʼeliif immoo ulfina kennaa. Yoos inni harka isaa isin irraa, waaqota keessanii fi biyya keessan irraa ni kaasa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.5",
            "verseOrgIds": [
              "1SA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin maaliif akka namoota Gibxiitii fi akka Faraʼoon mataa jabeeyyii taatu? Yeroo Waaqayyo adaba cimaadhaan isaan adabetti, isaan akka Israaʼeloonni gara barbaadan deemaniif hin eeyyamneefii?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.6",
            "verseOrgIds": [
              "1SA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu gaarii haaraa fi saawwan hoosisan kan waanjoon takkumaa irra hin kaaʼamin lama qopheessaa. Saawwan sanas gaarii sanatti camadaa; jabboota isaanii garuu gara manaatti biraa deebisaatii itti cufaa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.7",
            "verseOrgIds": [
              "1SA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taabota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.8",
            "verseOrgIds": [
              "1SA.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.8",
                "verseOrgIds": [
                  "1SA.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sanas fuudhaatii gaarii irra kaaʼaa; miʼa warqee aarsaa yakkaatiif ergitan sanas sanduuqa taabota Waaqayyoo bira jiru keessa kaaʼaa. Akka inni karaa barbaade deemuufis gad dhiisaa;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.8",
            "verseOrgIds": [
              "1SA.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "garuu ija isa irraa hin buqqifatinaa. Yoo inni gara biyya isaa gara Beet Shemeshitti qajeele rakkina guddaa kana",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.9",
            "verseOrgIds": [
              "1SA.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotu",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.9",
                "verseOrgIds": [
                  "1SA.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nutti fide. Yoo gara sanatti qajeeluu baate garuu dhaʼichi kun akkuma tasaa nutti dhufe malee Waaqayyo nutti hin fidne.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.9",
            "verseOrgIds": [
              "1SA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkasuma godhan. Saawwan lamaan fuudhanii gaariitti camadan; jabboota isaanii manatti deebisanii itti cufan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.10",
            "verseOrgIds": [
              "1SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis taabota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.11",
            "verseOrgIds": [
              "1SA.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.11",
                "verseOrgIds": [
                  "1SA.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sana gaariitti feʼan. Sanduuqa hantuuta warqeetii fi fakkii iitoo baatu sanas isa wajjin feʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.11",
            "verseOrgIds": [
              "1SA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saawwan sunis karaa qabatanii utuu bitaa mirgatti hin gorin marʼachaa gara Beet Shemeshitti qajeelan. Bulchitoonni Filisxeemotaas hamma daarii Beet Shemeshitti isaan faana buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.12",
            "verseOrgIds": [
              "1SA.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanattis namoonni Beet Shemeshi sulula keessaa qamadii haamaa turan; isaanis yommuu ol jedhanii taabota sana arganitti akka malee gammadan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.13",
            "verseOrgIds": [
              "1SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaariin sunis lafa qotiisaa Iyyaasuu nama Beet Shemeshi bira gaʼee kattaa guddaa tokko cina dhaabate. Namoonnis muka gaarii sanaa falaxanii saawwan sana aarsaa gubamu godhanii",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.14",
            "verseOrgIds": [
              "1SA.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.14",
                "verseOrgIds": [
                  "1SA.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.14",
            "verseOrgIds": [
              "1SA.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Lewwotaas taabota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.15",
            "verseOrgIds": [
              "1SA.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.15",
                "verseOrgIds": [
                  "1SA.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sanduuqicha miʼa warqee baatu sana wajjin gad buusanii kattaa guddaa irra kaaʼan; gaafuma sanas namoonni Beet Shemeshi aarsaa gubamuu fi qalma",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.15",
            "verseOrgIds": [
              "1SA.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.15",
                "verseOrgIds": [
                  "1SA.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.15",
            "verseOrgIds": [
              "1SA.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulchitoonni Filisxeemotaa shanan erga waan kana hunda arganii booddee gaafuma sana Eqroonitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.16",
            "verseOrgIds": [
              "1SA.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iiti warqee kan Filisxeemonni aarsaa yakkaa godhanii",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.17",
            "verseOrgIds": [
              "1SA.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.17",
                "verseOrgIds": [
                  "1SA.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ergan kanaa dha; isaanis tokko Ashdoodiif, tokko Gaazaaf, tokko Eqrooniif, tokko Gaatiif, tokko immoo Ashqalooniif ergan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.17",
            "verseOrgIds": [
              "1SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayʼinni hantuutota warqees akkuma baayʼina magaalaawwan Filisxeemotaa kanneen bulchitoota shananiif kennamaniitti ture. Magaalaawwan dallaa jajjaboo qaban kunneenis gandoota of jalaa qabu ture. Kattaan guddichi isaan taabota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.18",
            "verseOrgIds": [
              "1SA.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.18",
                "verseOrgIds": [
                  "1SA.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": "isa irra kaaʼan sunis lafa qotiisaa Iyyaasuu namicha Beet Shemeshi keessatti hamma harʼaatti dhugaa baatuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.18",
            "verseOrgIds": [
              "1SA.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis sababii isaan taabota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.19",
            "verseOrgIds": [
              "1SA.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.19",
                "verseOrgIds": [
                  "1SA.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa ilaalaniif namoota Beet Shemeshi dhaʼee isaan keessaa nama torbaatama ajjeese. Sababii",
          "type": "text",
          "attrs": {
