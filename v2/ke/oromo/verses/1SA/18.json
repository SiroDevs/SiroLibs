  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saaʼol Daawititti Hinaafuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga Daawit Saaʼol wajjin haasaʼee fixatee booddee, lubbuun Yoonaataan lubbuu Daawititti maxxante; Yoonaataanis akkuma lubbuu ofii isaatti isa jaallate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis gaafa sanaa jalqabee Daawitin ofitti fudhate; akka inni gara mana abbaa isaatti deebiʼus hin eeyyamneef.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.2",
            "verseOrgIds": [
              "1SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaataan sababii akka mataa isaatti isa jaallateef Daawit wajjin kakuu seene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.3",
            "verseOrgIds": [
              "1SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaataanis qoloo uffatee ture of irraa baasee kittaa isaa, goraadee isaa, iddaa isaatii fi sabbata isaa dabalee Daawitiif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit iddoo Saaʼol itti isa erge hunda dhaqee ni milkaaʼa ture. Saaʼolis namoota waraanaa irratti isa sadarkaa ol aanaa kenneef. Wanni kunis saba hundaa fi tajaajiltoota Saaʼol hunda gammachiise.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.5",
            "verseOrgIds": [
              "1SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartoonnis erga Daawit Filisxeemicha ajjeesee booddee yommuu namoonni gara mana ofii isaaniitti deebiʼanitti magaalaawwan Israaʼel hunda keessaa masiinqoo fi dibbee qabatanii faarfannaa gammachuutiin faarfachaa fi shuubbisaa Saaʼol mooticha simachuuf baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.6",
            "verseOrgIds": [
              "1SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartoonni sunis wal jalaa qabanii:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 18:7"
      },
      "items": [
        {
          "text": "\"Saaʼol kumaatama ajjeese;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 18:7"
      },
      "items": [
        {
          "text": "Daawit immoo kuma kumaatamaa ajjeese\" jedhanii faarfatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol akka malee aare; jechi kunis isa hin gammachiifne. Innis, \"Isaan Daawitiif kuma kumaatama kennan; anaaf garuu kumaatama qofa kennan. Mootummaa fudhachuu malee maaltu isa hafe?\" jedhee yaade.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.8",
            "verseOrgIds": [
              "1SA.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasii jalqabee Saaʼol ija hinaaffaatiin Daawitin ilaala ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.9",
            "verseOrgIds": [
              "1SA.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa itti aanutti hafuurri hamaan Waaqa biraa humnaan Saaʼolitti dhufe. Innis mana isaa keessatti raajii dubbachaa ture; Daawit immoo akkuma duraan godhu sana baganaa taphachaa ture. Saaʼolis eeboo harkatti qabatee ture;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.10",
            "verseOrgIds": [
              "1SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis, \"Ani Daawitin keenyanittan hodha\" jedhee waan yaadeef eeboo itti darbate. Daawit garuu yeroo lama isa duraa miliqe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis Daawitin sodaate;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.12",
                "verseOrgIds": [
                  "1SA.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Saaʼolin dhiisee Daawit wajjin tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Saaʼol Daawitin fuula ofii isaa duraa fageessee ajajaa kumaa isa godhe; Daawitis loltoota hoogganee ni baʼa; ni galas ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.13",
            "verseOrgIds": [
              "1SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.14",
                "verseOrgIds": [
                  "1SA.18.14"
                ]
              }
            }
          ]
        },
        {
          "text": "isa wajjin tureef inni waan hojjetu hundumaan ni milkaaʼa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis yeroo akka inni milkaaʼe argetti isa ni sodaate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.15",
            "verseOrgIds": [
              "1SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼelii fi Yihuudaan hundi garuu Daawitin ni jaallatan; inni fuula isaanii dura ni baʼa; ni galas tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis Daawitiin, \"Meerab intalli koo hangafti kunoo ti; ati jagnummaan lola",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.17",
            "verseOrgIds": [
              "1SA.18.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.17",
                "verseOrgIds": [
                  "1SA.18.17"
                ]
              }
            }
          ]
        },
        {
          "text": "loli malee ani ishee sitti nan heerumsiisa\" jedhe. Saaʼol, \"Harki Filisxeemotaa isa irratti haa kaʼu malee ani harka koo isa irratti hin kaasu\" jedhee yaadaa tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.17",
            "verseOrgIds": [
              "1SA.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit garuu Saaʼoliin, \"Soddaa mootii taʼuuf ani eenyu? Maatiin koo yookaan gosti abbaa koo Israaʼel keessatti maali?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.18",
            "verseOrgIds": [
              "1SA.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu yommuu yeroon itti Meerab intalli Saaʼol Daawititti heerumtu dhiʼaatetti isheen Adriiʼeel nama biyya Mehoolaatitti heerumte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miikaal intalli Saaʼolis Daawitin jaallattee turte; Saaʼolis yeroo waaʼee kanaa dhagaʼetti ni gammade.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.20",
            "verseOrgIds": [
              "1SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Akka isheen kiyyoo isatti taatuu fi akka harki Filisxeemotaa isa argatuuf ani ishee isatti nan heerumsiisa\" jedhee yaade. Kanaafuu Saaʼol Daawitiin, \"Ati amma soddaa koo taʼuuf carraa lammaffaa qabda\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.21",
            "verseOrgIds": [
              "1SA.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Saaʼol, \" 'Kunoo mootiin sitti gammada; tajaajiltoonni isaa hundinuus si jaallatu; ati amma soddaa isaa taʼi' jedhaatii dhoksaadhaan Daawititti himaa\" jedhee tajaajiltoota isaa ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.22",
            "verseOrgIds": [
              "1SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis irra deebiʼanii waan kana Daawititti himan; Daawit garuu, \"Soddaa mootii taʼuun waanuma salphaa seetanii? Ani hiyyeessa; nama hamma kanatti beekamus miti\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.23",
            "verseOrgIds": [
              "1SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajaajiltoonni Saaʼol waan Daawit jedhe isatti himan;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.24",
            "verseOrgIds": [
              "1SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol immoo, \" 'Mootichi diinota isaa haaloo baʼuuf misaa Filisxeemotaa dhibba tokko malee gabbara biraa tokko illee sirraa hin barbaadu' jedhaatii Daawititti himaa\" jedhe. Karoorri Saaʼol akka Daawit harka Filisxeemotaatti kufu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.25",
            "verseOrgIds": [
              "1SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu tajaajiltoonni sun waan kana Daawititti himanitti, Daawit soddaa mootii taʼuuf ni gammade. Kanaafuu utuu yeroon isaa hin gaʼin,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitii fi namoonni isaa dhaqanii Filisxeemota dhibba lama ajjeesan. Daawitis soddaa mootii taʼuuf jedhee misaa Filisxeemota ajjeefamanii hunda fidee mootichatti kenne. Kana irratti Saaʼol intala isaa Miikaalin isatti heerumsiise.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol yommuu akka",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.28",
                "verseOrgIds": [
                  "1SA.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Daawit wajjin jiruu fi akka Miikaal isa jaallate hubatetti,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammas akka malee isa sodaate; bara jireenya isaa kan hafe hundas diina isaa taʼee jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajjoonni waraana Filisxeemotaas yeroo hedduu waraanaaf ni baʼu turan; yeroo isaan waraanaaf baʼan hundas Daawit qondaaltota Saaʼol kaan caalaa moʼannaa argata ture; maqaan isaas baayʼee beekame.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.30",
            "verseOrgIds": [
              "1SA.18.30"
            ]
          }
        }
      ]
    }
