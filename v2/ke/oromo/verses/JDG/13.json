        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhalachuu Saamsoon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni ammas fuula",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.1",
                "verseOrgIds": [
                  "JDG.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjetan; kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.1",
                "verseOrgIds": [
                  "JDG.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "waggaa afurtama dabarsee harka Filisxeemotaatti isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namicha gosa Daan keessaa dhalatee Zoraa jiraatu kan Maanoʼaa jedhamu tokkotu ture; niitiin isaas dhabduu ijoollee tokko illee hin qabne turte.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.2",
            "verseOrgIds": [
              "JDG.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.3",
            "verseOrgIds": [
              "JDG.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.3",
                "verseOrgIds": [
                  "JDG.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "isheetti mulʼatee akkana jedheen; \"Kunoo ati dhabduu ijoollee hin qabnee dha; garuu ulfooftee ilma deessa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.3",
            "verseOrgIds": [
              "JDG.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa ati akka daadhii wayinii yookaan dhugaatii nama macheessu hin dhugne yookaan waan xuraaʼaa tokko illee hin nyaanne of eeggadhu;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.4",
            "verseOrgIds": [
              "JDG.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati ulfoofte ilma daʼuuf jirtaatii. Qarabaan tokko iyyuu mataa isaa hin tuqin; inni gaafa dhalatee jalqabee Naaziricha taʼuudhaan kan Waaqaaf addaan baafame taʼaatii; inni harka Filisxeemotaatii Israaʼeloota furuu jalqaba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin sunis gara dhirsa ishee dhaqxee akkana jettee itti himte; \"Nama Waaqaa tokkotu gara koo dhufe. Innis ergamaa Waaqayyoo fakkaatee akka malee nama sodaachisa. Ani akka inni eessaa dhufe isa hin gaafanne; innis maqaa isaa natti hin himne.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.6",
            "verseOrgIds": [
              "JDG.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu inni, 'Ati ulfooftee ilma deessa. Egaa siʼachi daadhii wayinii yookaan dhugaatii nama macheessu hin dhugin; waan xuraaʼaas hin nyaatin; sababiin isaas inni gaafa dhalatee jalqabee hamma duʼutti Naaziricha Waaqaa taʼaatii' naan jedhe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maanoʼaanis, \"Yaa Gooftaa, akka namichi Waaqaa kan ati gara keenyatti ergite sun ammas dhufee akka nu itti mucaa dhalatu sana guddisuu qabnu nu barsiisuuf akka nuuf ergitu sin kadhadha\" jedhee",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.8",
                "verseOrgIds": [
                  "JDG.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kadhate.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis Maanoʼaa dhagaʼe; ergamaan Waaqayyoo sunis utuu isheen lafa qotiisaa keessa teessuu gara dubartii sanaa deebiʼee dhufe; dhirsi ishee Maanoʼaan garuu ishee wajjin hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.9",
            "verseOrgIds": [
              "JDG.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartittiinis dhirsa isheetti himuuf ariifattee, \"Kunoo! Namichi guyyaa kaan natti mulʼate sun as jira!\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.10",
            "verseOrgIds": [
              "JDG.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maanoʼaanis kaʼee niitii isaa duukaa buʼe. Innis yommuu namicha bira gaʼetti, \"Namni niitii kootti dubbate siʼii?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 13:11"
      },
      "items": [
        {
          "text": "Innis, \"Anuma\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Maanoʼaan, \"Yeroo dubbiin kee raawwatamutti seerri mucichi ittiin jiraatuu fi hojiin inni hojjetu maali?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.12",
            "verseOrgIds": [
              "JDG.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.13",
            "verseOrgIds": [
              "JDG.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.13",
                "verseOrgIds": [
                  "JDG.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee deebise; \"Niitiin kee waan ani itti hime hunda gochuu qabdi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.13",
            "verseOrgIds": [
              "JDG.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen waan muka wayinii irraa argamu tokko illee nyaachuu hin qabdu; daadhii wayinii yookaan dhugaatii nama macheessu dhuguu yookaan waan xuraaʼaa kam iyyuu nyaachuu hin qabdu. Isheen waan ani ishee ajaje hunda gochuu qabdi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.14",
            "verseOrgIds": [
              "JDG.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maanoʼaanis ergamaa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15",
            "verseOrgIds": [
              "JDG.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.15",
                "verseOrgIds": [
                  "JDG.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Hamma nu korbeessa reʼee xinnaa isaa siif qopheessinutti nuu turi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15",
            "verseOrgIds": [
              "JDG.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.16",
                "verseOrgIds": [
                  "JDG.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Ati na tursitu illee, ani nyaata kee kam iyyuu hin nyaadhu. Garuu yoo aarsaa gubamu qopheessuu feete, isa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.16",
                "verseOrgIds": [
                  "JDG.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessi\" jedheen. Maanoʼaan akka inni ergamaa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.16",
                "verseOrgIds": [
                  "JDG.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "taʼe hin beekne ture.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sana booddee Maanoʼaan ergamaa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.17",
                "verseOrgIds": [
                  "JDG.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Akka nu yeroo dubbiin ati dubbatte fiixaan baʼutti ulfina siif kenninuuf maqaan kee eenyu?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Ati maaliif maqaa koo gaafatta? Inni akka malee dinqii dha\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maanoʼaanis korbeessa reʼee xinnaa isaa kennaa midhaanii wajjin geessee kattaa irratti",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.19",
