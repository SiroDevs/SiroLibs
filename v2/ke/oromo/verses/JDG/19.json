          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni waan kana arge hundi, \"Erga Israaʼeloonni Gibxii baʼanii jalqabee wanni akkasii takkumaa argamee yookaan hojjetamee hin beeku. Waaʼee isaa yaadaa! Hubadhaas! Waan gochuu qabnus nutti himaa!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.30",
            "verseOrgIds": [
              "JDG.19.30"
            ]
          }
        }
