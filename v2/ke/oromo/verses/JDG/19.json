          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yommuu mana isaa gaʼetti haaduu fudhatee saajjatoo isaa sana buusaa buusaatti iddoo kudha lamatti kukkutee guutummaa biyya Israaʼelitti erge.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
          }
        },
        {
          "name": "verse",
