                "verseId": "JDG.2.20",
                "verseOrgIds": [
                  "JDG.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼelitti akka malee dheekkamee akkana jedhe; \"Waan sabni kun kakuu ani abbootii isaatiif gale sana cabsee anas dhagaʼuu dideef,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.20",
            "verseOrgIds": [
              "JDG.2.20"
            ]
          }
        },
        {
