            "sid": "JDG 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.1",
            "verseOrgIds": [
              "JDG.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.1",
                "verseOrgIds": [
                  "JDG.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Gilgaalii Bookiimitti ol baʼee akkana jedhe; \"Ani Gibxii isin baasee biyya ani abbootii keessaniif kennuuf kakadhe sanatti isin fideera. Akkanas nan jedhe; 'Ani kakuu isin wajjin gale sana gonkumaa hin diigu;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.1",
            "verseOrgIds": [
              "JDG.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "isinis warra lafa kana irra jiraatan wajjin kakuu hin galinaa; iddoo aarsaa isaanii garuu caccabsaa.' Taʼus isin naaf hin ajajamne. Isin maaliif waan kana gootan?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.2",
            "verseOrgIds": [
              "JDG.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani amma akka fuula keessan duraa ariʼee isaan hin baafne isinitti nan hima; isaan iddaa isinitti taʼu; waaqonni isaanii immoo kiyyoo isinitti taʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.3",
            "verseOrgIds": [
              "JDG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.4",
                "verseOrgIds": [
                  "JDG.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "waan kana Israaʼeloota hundatti dubbatetti namoonni sagalee isaanii ol fudhatanii booʼan;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaanis iddoo sana Bookiim jedhanii waaman. Achittis",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.5",
                "verseOrgIds": [
                  "JDG.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "aarsaa dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajajamuu Diduu fi Moʼatamuu",
          "type": "text"
        }
      ]
    },
    {
