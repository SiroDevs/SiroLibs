          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani siʼachi saboota Iyyaasuun yeroo duʼetti isaan gidduutti dhiise sana isaan duraa ariʼee hin baasu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.21",
            "verseOrgIds": [
              "JDG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa saboota kanaatiinis akka isaan akkuma abbootii isaanii karaa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.22",
                "verseOrgIds": [
                  "JDG.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": "eeganii irra deddeebiʼanii fi akka isaan hin eegne ilaaluuf jedhee Israaʼelin nan qora.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
