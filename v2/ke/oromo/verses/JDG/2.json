    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga Iyyaasuun Israaʼeloota gad dhiisee booddee tokkoon tokkoon isaanii biyyattii dhaaluuf gara dhaala ofii isaanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.6",
            "verseOrgIds": [
              "JDG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uummanni bara jireenya Iyyaasuu guutuu fi bara maanguddoota erga inni duʼee as hafanii jiraatanii waan guddaa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.7",
                "verseOrgIds": [
                  "JDG.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼeliif godhe argan sunis",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.7",
                "verseOrgIds": [
                  "JDG.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "tajaajilan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun ilmi Nuuni garbichi",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.8",
            "verseOrgIds": [
              "JDG.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.8",
                "verseOrgIds": [
                  "JDG.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "waggaa dhibba tokkoo fi kudhanitti duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.8",
            "verseOrgIds": [
              "JDG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis lafa dhaala isaa Timnaat Herees kan biyya gaaraa Efreemitti karaa kaaba Tulluu Gaʼaashitti argamtu sanatti isa awwaalan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga dhaloonni sun guutuun gara abbootii isaaniitti walitti qabamanii booddee dhaloonni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.10",
                "verseOrgIds": [
                  "JDG.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "hin beekin yookaan waan inni saba Israaʼeliif godhe hin beekin kan biraa kaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonnis fuula",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
            "verseOrgIds": [
              "JDG.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.11",
                "verseOrgIds": [
                  "JDG.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjetan; Baʼaaliinis ni tajaajilan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
            "verseOrgIds": [
              "JDG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
              "JDG.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.12",
                "verseOrgIds": [
                  "JDG.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaanii kan Gibxii isaan baase sana ni dhiisan. Waaqota adda addaa kanneen saboota naannoo isaanii jiraatanii duukaa buʼan; ni waaqeffatanis.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
              "JDG.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyonis",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.12",
                "verseOrgIds": [
                  "JDG.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "dheekkamsaaf kakaasan;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
              "JDG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan isa dhiisanii Baʼaalii fi Ashtooretin waaqeffataniiruutii.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.13",
            "verseOrgIds": [
              "JDG.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.14",
                "verseOrgIds": [
                  "JDG.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼelootatti dheekkamee saamtota isaan saamanitti dabarsee isaan kenne. Diinota naannoo isaanii kanneen isaan of irraa ittisuu hin dandeenye hundatti isaan gurgure.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.14",
            "verseOrgIds": [
              "JDG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Israaʼeloonni lolaaf baʼanitti akkuma inni duraan kakate sanatti harki",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.15",
            "verseOrgIds": [
              "JDG.2.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.15",
                "verseOrgIds": [
                  "JDG.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": "isaanitti hammaatee akka isaan moʼataman godha ture. Isaanis rakkina guddaa keessa buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.15",
            "verseOrgIds": [
              "JDG.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.16",
                "verseOrgIds": [
                  "JDG.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "abbootii murtii kanneen saamtota jalaa isaan baasan isaaniif kaase.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.16",
            "verseOrgIds": [
              "JDG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu waaqota biraa wajjin sagaagalanii isaan waaqeffatan malee abbootii murtii sana hin dhaggeeffanne. Karaa abbootiin isaanii",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.17",
            "verseOrgIds": [
              "JDG.2.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.17",
                "verseOrgIds": [
                  "JDG.2.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ajajamuudhaan irra deemaa turan sana irraa dafanii jalʼatan; isaan waan abbootiin isaanii godhan hin goone.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.17",
            "verseOrgIds": [
              "JDG.2.17"
            ]
          }
        },
