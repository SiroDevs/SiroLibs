  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JDG 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saboonni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.1",
            "verseOrgIds": [
              "JDG.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.1",
                "verseOrgIds": [
                  "JDG.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼeloota waraana Kanaʼaan keessatti deemsifame kam iyyuu irratti hirmaatanii hin beekin hunda qoruuf jedhee idduma isaan turanitti hambise kanneenii dha;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.1",
            "verseOrgIds": [
              "JDG.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis akka Israaʼeloonni kanaan dura waraana keessatti hirmaatanii hin beekin muuxannoo argataniif waan kana godhe;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.2",
            "verseOrgIds": [
              "JDG.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanneen utuu hin baʼin achumatti hafanis: bulchitoota Filisxeemotaa shanan, Kanaʼaanota hunda, Siidoonotaa fi Hiiwota Tulluu Baʼaal Hermoonii jalqabanii hamma balbala Hamaatitti gaarran Libaanoon gubbaa jiraatanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.3",
            "verseOrgIds": [
              "JDG.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan kunneen warra Israaʼeloonni ajaja",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.4",
                "verseOrgIds": [
                  "JDG.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kan inni karaa Museetiin abbootii isaaniif kennee ture sana eeguu fi eeguu baachuu isaanii ittiin qoramanii ilaalamaniif hambifamanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Israaʼeloonni Kanaʼaanota, Heetota, Amoorota, Feerzota, Hiiwotaa fi Yebuusota gidduu jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.5",
            "verseOrgIds": [
              "JDG.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis intallan jaraa fuudhan; intallan ofii isaanii immoo ilmaan isaaniitti heerumsiisan; waaqota isaaniis ni waaqeffatan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otniiʼeel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni fuula",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.7",
                "verseOrgIds": [
                  "JDG.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjetan;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.7",
                "verseOrgIds": [
                  "JDG.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaanii irraanfatanii Baʼaalii fi Asheeraa waaqeffatan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aariin",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.8",
            "verseOrgIds": [
              "JDG.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.8",
                "verseOrgIds": [
                  "JDG.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼelootatti bobaʼe; kanaafuu mootii Phaadaan Arraam Kuushan-Rishaataayimitti dabarsee isaan gurgure; Israaʼeloonnis waggaa saddeeti isa jalatti bulan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.8",
            "verseOrgIds": [
              "JDG.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.9",
                "verseOrgIds": [
                  "JDG.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu yeroo isaan gara isaatti iyyatanitti nama isaan furu tokko jechuunis obboleessa Kaaleb quxisuu, Otniiʼeel ilma Qenaz sana akka inni isaan furuuf kaaseef.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.9",
            "verseOrgIds": [
              "JDG.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.10",
                "verseOrgIds": [
                  "JDG.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "isa irra buʼe; kanaafuu inni abbaa murtii Israaʼelootaa taʼee duulaaf baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.10",
                "verseOrgIds": [
                  "JDG.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Kuushan-Rishaataayim mooticha Phaadaan Arraam sana dabarsee harka Onniiʼelitti kenne; innis isa moʼate.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu biyyi sun hamma Otniiʼeel ilmi Qenaz duʼutti waggaa afurtama nagaa argate.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naaʼod",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas Israaʼeloonni fuula",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.12",
            "verseOrgIds": [
              "JDG.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.12",
                "verseOrgIds": [
                  "JDG.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjetan; sababii isaan waan hamaa kana hojjetaniif",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.12",
            "verseOrgIds": [
              "JDG.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.12",
                "verseOrgIds": [
                  "JDG.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akka Egloon mootiin Moʼaab harka isaa isaanitti cimsuuf dabarsee isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.12",
            "verseOrgIds": [
              "JDG.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Amoonotaa fi Amaaleqoota walitti qabatee Israaʼeloota waraane; isaanis Magaalaa Meexxii qabatan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.13",
            "verseOrgIds": [
              "JDG.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni waggaa kudha saddeet Egloon mootii Moʼaab jalatti bulan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni ammas gara",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.15",
            "verseOrgIds": [
              "JDG.3.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.15",
                "verseOrgIds": [
                  "JDG.3.15"
                ]
              }
            }
          ]
        },
        {
          "text": "iyyatan; innis nama isaan furu tokko jechuunis Eehuud nama harka bitaachaa, ilma Geeraa sana gosa Beniyaam keessaa isaanii kaase. Israaʼeloonnis akka inni Egloon mootii Moʼaab sanaaf gibira geessu Naaʼodin ergan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.15",
            "verseOrgIds": [
              "JDG.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eehuudis goraadee gama lamaan qara qabu kan meetira walakkaa dheeratu tolfatee uffata isaa jalaan tafa mirgaatti hidhate.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.16",
            "verseOrgIds": [
              "JDG.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibira sana Egloon mooticha Moʼaab namicha akka malee furdaa ture sanaaf dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.17",
            "verseOrgIds": [
              "JDG.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaʼod erga gibira sana dhiʼeessee booddee namoota baataniifii dhufan geggeesse.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.18",
            "verseOrgIds": [
              "JDG.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu iddoo dhagaan baafamu kan Gilgaal biratti argamu bira gaʼee duubatti deebiʼuudhaan, \"Yaa mootii ani waan dhoksaatti sitti himu tokko qaba\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 3:19"
      },
      "items": [
        {
          "text": "Mootichis, \"Calʼisaa!\" jedhe; warri isa bira turan hundinuus isa dhiisanii baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu mootichi kutaa mana isaa iddoo qabbanaaʼaa tokko kophaa isaa taaʼee jiruu Eehuud itti dhiʼaatee, \"Ani ergaa Waaqa biraa siif ergame qaba\" jedheen. Egloonis teessoo isaa irraa ol kaʼe;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.20",
            "verseOrgIds": [
              "JDG.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eehuud harka isaa bitaa diriirsee tafa mirga isaa irraa goraadee luqqifatee garaa mootichaa keessa fullaase.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
            "verseOrgIds": [
              "JDG.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabannoon isaas utuu hin hafin garaa seenee sibiilli isaa duubaan baʼe. Naaʼod goraadicha garaa mootichaa keessaa hin buqqifne; moorris goraadee sana haguugee ture.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.22",
            "verseOrgIds": [
              "JDG.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Eehuud Egloonitti balbala cufee karaa borootiin baʼee qajeele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga Eehuud deemee booddee tajaajiltoonni mootichaa dhufan; balbala kutaa mana ol aanuus akkuma inni cufamee jirutti argan. Isaanis, \"Tarii inni mana boolii gad taaʼee jira taʼa\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamma dadhabanittis eegan; garuu waan inni utuu balbala hin banin tureef furtuu fudhatanii balbala banan. Kunoo gooftaan isaanii duʼee lafa irra diriiree ture.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma isaan dhaabatanii eegaa jiranuu Eehuud fagaatee deeme. Karaa lafa dhagaan itti soofamuutiin darbee gara Seʼiiraatti baqate.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.26",
            "verseOrgIds": [
              "JDG.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yommuu achi gaʼetti biyya gaaraa Efreem keessatti malakata afuufe; Israaʼeloonnis hooggantummaa isaatiin biyya gaaraa sana irraa isa wajjin gad buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.27",
            "verseOrgIds": [
              "JDG.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eehuudis, \"Diina keessan Moʼaabin",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.28",
            "verseOrgIds": [
              "JDG.3.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JDG.3.28",
                "verseOrgIds": [
                  "JDG.3.28"
                ]
              }
            }
          ]
        },
        {
          "text": "dabarsee harka keessanitti isinii kenneeraatii na duukaa buʼaa!\" jedheen. Isaanis malkaa Yordaanos kan gara Moʼaabitti geessu sana qabatanii nama tokko illee achiin darbuu dhowwan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.28",
            "verseOrgIds": [
              "JDG.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti Moʼaabota hundi isaanii jajjaboo fi humna qabeeyyii taʼan kuma kudhan fixan; namni tokko iyyuu isaan jalaa hin baane.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa sana Moʼaab harka Israaʼelitti galfamte; biyyattiinis waggaa saddeettamaaf nagaa argatte.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shamgaar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eehuuditti aanee Shamgaar ilmi Anaat kaʼe; innis ulee ittiin qotiyyoo tuttuqaniin Filisxeemota dhibba jaʼa fixe. Akkasiinis Israaʼeloota baraare.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.31",
            "verseOrgIds": [
              "JDG.3.31"
            ]
          }
        }
      ]
    }
  ],
