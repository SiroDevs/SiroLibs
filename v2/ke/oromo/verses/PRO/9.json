  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "PRO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogummaa fi Gowwummaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaan mana ishee ijaarratte;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:1"
      },
      "items": [
        {
          "text": "utubaa ishee torbanis dhagaa irraa qopheeffate.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen horii qalattee daadhii wayinii ishee bulbulatte;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:2"
      },
      "items": [
        {
          "text": "maaddii ishee illee qopheeffatte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajaajiltoota ishee dubarran ergattee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:3"
      },
      "items": [
        {
          "text": "fiixee magaalaa irraa lallabde.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen warra qalbii hin qabneen akkana jetti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 9:4"
      },
      "items": [
        {
          "text": "\"Isin warri homaa hin beekne hundi as kottaa!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottaatii nyaata koo nyaadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:5"
      },
      "items": [
        {
          "text": "daadhii wayinii ani bulbuladhe illee dhugaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa gowwummaa keessanii sana dhiisaatii jiraadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:6"
      },
      "items": [
        {
          "text": "karaa hubannaa irra deemaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni nama namatti qoosu gorsu kam iyyuu ni arrabsama;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:7"
      },
      "items": [
        {
          "text": "namni nama hamaa ifatu kam iyyuu ni salphata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati nama namatti qoosu hin ifatin; inni si jibbaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:8"
      },
      "items": [
        {
          "text": "nama ogeessa ifadhu; inni si jaallataatii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama ogeessa gorsi; inni ittuma caalchisee ogeessa taʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:9"
      },
      "items": [
        {
          "text": "nama qajeelaaf barumsa kenni; inni beekumsa isaatti dabalaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PRO.9.10",
                "verseOrgIds": [
                  "PRO.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuun jalqaba ogummaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:10"
      },
      "items": [
        {
          "text": "isa Qulqulluu Sana beekuun hubannaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa kootiin barii jireenya keetii ni dheerata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:11"
      },
      "items": [
        {
          "text": "jireenya kee irrattis waggoonni ni dabalamuutii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati nama ogeessa taate, ogummaan kee si badhaasa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:12"
      },
      "items": [
        {
          "text": "yoo ati kan namatti qoostu taate suma qofatu gidirama.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin gowwaan oduu baayʼifti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:13"
      },
      "items": [
        {
          "text": "isheen raatuu homaa hin beeknee dha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen balbala mana ishee dura,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:14"
      },
      "items": [
        {
          "text": "fiixee magaalaa gubbaa barcuma irra teessee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra achiin darban, kanneen qajeelanii",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:15"
      },
      "items": [
        {
          "text": "daandii isaanii irra deeman waamti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen warra qalbii hin qabneen akkana jetti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 9:16"
      },
      "items": [
        {
          "text": "\"Isin warri homaa hin beekne hundi as kottaa!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaan hatan ni miʼaawa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.17",
            "verseOrgIds": [
              "PRO.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:17"
      },
      "items": [
        {
          "text": "nyaanni dhoksaan nyaatanis guddoo namatti tola!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.17",
            "verseOrgIds": [
              "PRO.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu akka warri duʼan achi jiran,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.18",
            "verseOrgIds": [
              "PRO.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:18"
      },
