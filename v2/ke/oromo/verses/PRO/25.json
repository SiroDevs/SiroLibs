  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "PRO 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Fakkeenya Solomoon Dabalataa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fakkeenyawwan kunneen fakkeenyawwan Solomoon kanneen namoonni Hisqiyaas, mooticha Yihuudaa garagalchanii dha:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.1",
            "verseOrgIds": [
              "PRO.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa dhoksuun Waaqaaf ulfina isaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.2",
            "verseOrgIds": [
              "PRO.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:2"
      },
      "items": [
        {
          "text": "waa sakattaʼanii bira gaʼuun immoo ulfina moototaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.2",
            "verseOrgIds": [
              "PRO.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma samiiwwan ol dheeratanii",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.3",
            "verseOrgIds": [
              "PRO.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:3"
      },
      "items": [
        {
          "text": "laftis gad fagaatu sana, yaadni moototaa qoratamee bira hin gaʼamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.3",
            "verseOrgIds": [
              "PRO.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meetii irraa xurii baasi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:4"
      },
      "items": [
        {
          "text": "ergasii tumtuun qodaa tolchuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama hamaa fuula mootii duraa balleessi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:5"
      },
      "items": [
        {
          "text": "ergasii teessoon isaa qajeelummaadhaan ni jabaata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuula mootii duratti ol of hin qabin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
            "verseOrgIds": [
              "PRO.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:6"
      },
      "items": [
        {
          "text": "iddoo namoota gurguddaas hin dhaabatin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
            "verseOrgIds": [
              "PRO.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni fuula namoota bebeekamoo duratti si salphisuu irra,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:7"
      },
      "items": [
        {
          "text": "yoo inni, \"As ol kottu\" siin jedhe wayyaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PRO 25:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 25:7"
      },
      "items": [
        {
          "text": "Ati waan ija keetiin argite,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "daftee mana murtiitti hin fidin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 25:8"
      },
      "items": [
        {
          "text": "yoo ollaan kee si qaanesse,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:8"
      },
      "items": [
        {
          "text": "dhuma irratti ati maal gochuu dandeessa?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhimma kee ollaa kee wajjin falmadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.9",
            "verseOrgIds": [
              "PRO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:9"
      },
      "items": [
        {
          "text": "iccitii nama kaanii immoo hin baasin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.9",
            "verseOrgIds": [
              "PRO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo kanaa achii namni waan sana dhagaʼee si qaanessa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.10",
            "verseOrgIds": [
              "PRO.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:10"
      },
      "items": [
        {
          "text": "maqaan hamaan siif kenname sunis sirraa hin baʼu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.10",
            "verseOrgIds": [
              "PRO.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin yeroo isaatti dubbatame,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.11",
            "verseOrgIds": [
              "PRO.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:11"
      },
      "items": [
        {
          "text": "akkuma hudhaa warqee kan meetii irratti hojjetamee ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.11",
            "verseOrgIds": [
              "PRO.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifanni nama ogeessaa gurra dhaggeeffatuuf,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:12"
      },
      "items": [
        {
          "text": "lootii warqee yookaan faaya warqee qulqulluu ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan amanamaan tokko warra isa ergataniif",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:13"
      },
      "items": [
        {
          "text": "akkuma qabbana cabbii kan yeroo midhaan haamanii ti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:13"
      },
      "items": [
        {
          "text": "inni hafuura gooftota isaa haaromsaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni kennaa namaaf hin kennineen boonu tokko",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.14",
            "verseOrgIds": [
              "PRO.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:14"
      },
      "items": [
        {
          "text": "akkuma duumessaa fi bubbee bokkaa hin qabnee ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.14",
            "verseOrgIds": [
              "PRO.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obsaan bulchaa tokko garaa laafifachuun ni dandaʼama;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.15",
            "verseOrgIds": [
              "PRO.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:15"
      },
      "items": [
        {
          "text": "dubbiin malaan dubbatame lafee ni cabsa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.15",
            "verseOrgIds": [
              "PRO.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damma yoo argatte hamma si gaʼu nyaadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.16",
            "verseOrgIds": [
              "PRO.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:16"
      },
      "items": [
        {
          "text": "yoo baayʼiftee nyaatte ni diddigda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.16",
            "verseOrgIds": [
              "PRO.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ollaa keetii dhaquu hin baayʼisin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.17",
            "verseOrgIds": [
              "PRO.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:17"
      },
      "items": [
        {
          "text": "yoo ati miilla itti baayʼifte inni si jibba.",
