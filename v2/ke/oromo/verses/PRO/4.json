  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PRO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogummaan Waan Hunda Caalti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ilmaan ko, mee gorsa abbaan namaaf kennu dhagaʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:1"
      },
      "items": [
        {
          "text": "qalbeeffadhaatii hubannaa argadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani barumsa gaarii isinii nan kenna;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:2"
      },
      "items": [
        {
          "text": "kanaafuu barsiisa koo hin dhiisinaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ani mucaa xinnaa taʼee mana abbaa koo turetti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:3"
      },
      "items": [
        {
          "text": "yeroo ani daaʼima dhiiga taʼee haadha kootiif ilma tokkicha turetti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni akkana jedhee na barsiise;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "\"Garaa kee guutuudhaan dubbii koo jabeessii qabadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "seera koo eegi; ati ni jiraattaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaa argadhu; hubannaas argadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:5"
      },
      "items": [
        {
          "text": "dubbii koo hin dagatin yookaan irraa hin jalʼatin.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaa hin dhiisin; isheen si eegdii;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:6"
      },
      "items": [
        {
          "text": "ishee jaalladhu; isheenis si tiksitii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaan waan hunda caalti; kanaafuu ogummaa argadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:7"
      },
      "items": [
        {
          "text": "Yoo isheen waan ati qabdu hunda si baasifte illee hubannaa argadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaa kabaji; inni ol si guddisaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:8"
      },
      "items": [
        {
          "text": "isa hammadhu; innis si kabajaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen kallacha bareedaa mataa kee irra siif keessi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:9"
      },
      "items": [
        {
          "text": "gonfoo miidhagaa illee siif kenniti.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ilma ko dhagaʼi; waan ani jedhu illee fudhadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:10"
      },
      "items": [
        {
          "text": "barri jireenya keetiis ni baayʼataa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani karaa ogummaa irra sin qajeelcha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:11"
      },
      "items": [
        {
          "text": "daandii qajeelaa irras sin buusa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ati deemtu, tarkaanfiin kee hin ittifamu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:12"
      },
      "items": [
        {
          "text": "yoo fiigdu illee ati hin gufattu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qajeelfama jabeessii qabadhu; gad hin dhiisin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:13"
      },
      "items": [
        {
          "text": "waan inni jireenya kee taʼeef jabeessii eeggadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daandii hamootaa irra miilla kee hin dhaabin",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:14"
      },
      "items": [
        {
          "text": "yookaan karaa jalʼootaa irra hin deemin.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irraa fagaadhu; irras hin deemin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:15"
      },
      "items": [
        {
          "text": "irraa goriitii karaa kee irra qajeeli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan waan hamaa hojjetan malee rafuu hin dandaʼaniitii;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:16"
      },
      "items": [
        {
          "text": "isaan hamma nama gufachiisanitti hirriba hin argatan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan buddeena hamminaa nyaatu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:17"
      },
      "items": [
        {
          "text": "daadhii wayinii kan dabaan argame dhugu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaan qajeeltotaa akkuma ifa barii barraaqaa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:18"
      },
      "items": [
        {
          "text": "kan hamma saafaatti ittuma fufee ifaa deemuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
