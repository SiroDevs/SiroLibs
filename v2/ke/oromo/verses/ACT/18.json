  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "ACT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Qorontos Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana booddee Phaawulos Ateenaa kaʼee Qorontos dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.1",
            "verseOrgIds": [
              "ACT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achittis Yihuudii Aqiilaa jedhamu kan biyya Phonxoositti dhalate tokko argate; Aqiilaan kunis sababii Qilaawudewoos akka Yihuudoonni hundinuu biyya Roomaa keessaa baʼan ajajeef dhiʼoo niitii isaa Phirisqilaa wajjin Iixaaliyaadhaa dhufe. Phaawulosis isaan ilaaluu dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.2",
            "verseOrgIds": [
              "ACT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis waan akkuma isaanii hojjetaa dunkaanaa tureef achi jiraatee isaan wajjin hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.3",
            "verseOrgIds": [
              "ACT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa Sanbataa hundas mana sagadaa keessatti falmee Yihuudootaa fi Giriikota amansiisa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.4",
            "verseOrgIds": [
              "ACT.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos yeroo Siilaasii fi Xiimotewos Maqedooniyaadhaa dhufanitti akka Yesuus kun Kiristoos",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.5",
            "verseOrgIds": [
              "ACT.18.5"
            ]
          }
        },
        {
          "text": "taʼe Yihuudootaaf dhugaa baʼaa dubbicha lallabuutti ni jabaata ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.5",
            "verseOrgIds": [
              "ACT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Yihuudoonni isaan mormanii isa arrabsanittis garuu Phaawulos uffata isaa hurgufatee, \"Dhiigni keessan matuma keessan irra haa jiraatu! Ani qulqulluu dha; ammaa jalqabee gara Namoota Ormaa nan dhaqa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.6",
            "verseOrgIds": [
              "ACT.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis achii baʼee mana namicha Waaqa waaqeffatu kan maqaan isaa Tiitoo jedhamu tokkoo dhaqe; manni namicha sanaas mana sagadaatti aana ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.7",
            "verseOrgIds": [
              "ACT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriisphoos bulchaan mana sagadaa sanaas warra mana isaa jiraatan hunda wajjin Gooftaatti amane; namoota Qorontos kanneen Phaawulosin dhagaʼan keessaa baayʼeen isaanii amananii cuuphaman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.8",
            "verseOrgIds": [
              "ACT.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkan tokko Gooftaan akkana jedhee mulʼataan Phaawulositti dubbate;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.9",
            "verseOrgIds": [
              "ACT.18.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hin sodaatin; dubbadhu malees hin calʼisin.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.18.9",
                "verseOrgIds": [
                  "ACT.18.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.9",
            "verseOrgIds": [
              "ACT.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sababii ani si wajjin jiruuf namni tokko iyyuu si miidhuuf jedhee si hin tuqu; ani magaalaa kana keessaa nama baayʼee qabaatii.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.18.10",
                "verseOrgIds": [
                  "ACT.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.10",
            "verseOrgIds": [
              "ACT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Phaawulos dubbii Waaqaa isaan barsiisaa waggaa tokkoo fi walakkaa achi ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.11",
            "verseOrgIds": [
              "ACT.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Gaaliyoon bulchaa Akaayaa turetti Yihuudoonni tokkummaadhaan Phaawulositti kaʼanii mana murtiitti isa dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.12",
            "verseOrgIds": [
              "ACT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Namichi kun akka isaan karaa seeraan ala taʼeen Waaqa waaqeffataniif namoota sossobaa jira\" jedhanii isa himatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.13",
            "verseOrgIds": [
              "ACT.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu Phaawulos dubbachuuf jedhee afaan banachuutti jiruu Gaaliyoon Yihuudootaan akkana jedhe; \"Yaa Yihuudoota, utuu dubbiin kun waaʼee balleessaa hojjechuu yookaan waaʼee yakka guddaa taʼee ani silaa obsaan isinan dhagaʼa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.14",
            "verseOrgIds": [
              "ACT.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaffiin keessan garuu waan waaʼee jechootaa, waaʼee maqaawwaniitii fi waaʼee seera keessanii taʼeef kana isinuu fixadhaa; ani waan akkanaatiif abbaa murtii hin taʼuutii.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.15",
            "verseOrgIds": [
              "ACT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mana murtii keessaa gad isaan baase.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.16",
            "verseOrgIds": [
              "ACT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan hundi bulchaa mana sagadaa sanatti jechuunis Soosteenesitti garagalanii fuula mana murtii duratti isa tumuu jalqaban. Wanni kun garuu xinnuma illee Gaaliyoo hin yaaddessine.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.17",
            "verseOrgIds": [
              "ACT.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phirisqilaa, Aqiilaa fi Apholoos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos yeroo muraasa Qorontos keessa ture. Ergasiis obboloota biraa deemee Phirisqilaa fi Aqiilaa wajjin dooniidhaan Sooriyaa dhaqe; innis waan wareega qabuuf utuu hin deemin Kanchireʼaatti mataa haaddate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.18",
            "verseOrgIds": [
              "ACT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis yeroo Efesoon gaʼanitti Phirisqilaa fi Aqiilaa achitti dhiisee ofii isaatii garuu mana sagadaa seenee Yihuudootaan mormaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.19",
            "verseOrgIds": [
              "ACT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isaan akka inni yeroo dheeraa isaan bira turu kadhatanitti immoo dhagaʼuu dide.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.20",
            "verseOrgIds": [
              "ACT.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akkuma isaan biraa deemeen, \"Yoo Waaqni jedhe ani deebiʼee nan dhufa\" jedheen; dooniidhaanis Efesoonii kaʼee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.21",
            "verseOrgIds": [
              "ACT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Qiisaariyaa geenyaan ol baʼee waldaa kiristaanaa dubbise; ergasiis Anxookiiyaatti gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.22",
            "verseOrgIds": [
              "ACT.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos erga Anxookiiyaa keessa takka bubbulee booddee achii kaʼee barattoota hunda jajjabeessaa biyya Galaatiyaatii fi Firiigiyaa hunda keessa iddoo tokko irraa iddoo kaanitti nanaannaʼaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.23",
            "verseOrgIds": [
              "ACT.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidduudhuma sana Yihuudiin Iskindiriyaatti dhalate kan Apholoos jedhamu tokko gara Efesoon dhufe; innis nama arraba qajeelu, kan Katabbiiwwan Qulqulluu gad fageenyaan beeku ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.24",
            "verseOrgIds": [
              "ACT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi kun duraan karaa Gooftaa baratee ture; inni yoo cuuphaa Yohannis qofa beeke illee hafuura hoʼaadhaan waaʼee Yesuus qajeelchee dubbachaa, barsiisaas ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.25",
            "verseOrgIds": [
              "ACT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana sagadaa keessattis sodaa malee dubbachuu jalqabe; Phirisqilaa fi Aqiilaanis yommuu isa dhagaʼanitti mana isaaniitti isa waamanii karaa Waaqaa isa duraa caalaatti sirriitti addeessaniif.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.26",
            "verseOrgIds": [
              "ACT.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Apholoos Akaayaa dhaquu barbaadetti obboloonni isa jajjabeessanii akka barattoonni achi jiran sun isa simataniif xalayaa barreessaniif. Innis achi gaʼee warra ayyaana Waaqaatiin amananii turaniif gargaarsa guddaa taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.27",
            "verseOrgIds": [
              "ACT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akka Yesuus kun Kiristoos taʼe Katabbiiwwan Qulqulluudhaan mirkaneessaa, jabaatee ifaan ifatti Yihuudootaan mormee amansiisaa tureetii.",
