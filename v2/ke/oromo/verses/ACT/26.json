  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "ACT 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agriiphaan Phaawulosiin, \"Akka ati ofii keetiif dubbattu siif eeyyamameera\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.1",
            "verseOrgIds": [
              "ACT.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 26:1"
      },
      "items": [
        {
          "text": "Phaawulosis harkaan mallattoo kennee akkana jedhee falmachuu jalqabe;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.1",
            "verseOrgIds": [
              "ACT.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Agriiphaa Mooticha, ani sababii waan Yihuudoonni ittiin na himatan hunda falmachuudhaaf jedhee harʼa fuula kee dura dhaabadhuuf akka ayyaantuu tokkoottin of ilaala.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.2",
            "verseOrgIds": [
              "ACT.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis waan ati duudhaa fi wal mormii Yihuudootaa hunda keessa beektuufii dha. Kanaafuu ani akka ati obsaan na dhaggeeffattu sin kadhadha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani ijoollummaa kootii jalqabee saba koo keessatti, Yerusaalem keessattis akkamitti akka jiraachaa ture Yihuudoonni hundinuu ni beeku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.4",
            "verseOrgIds": [
              "ACT.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani akka Fariisicha tokkootti akkuma sirna garee akka malee amantaa keenyatti cichu sanaatti jiraadhe isaanuu bara dheeraa waan na beekaniif, yoo fedhii qabaatan dhugaa baʼuu ni dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.5",
            "verseOrgIds": [
              "ACT.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas ani waadaa Waaqni abbootii keenyaaf gale sana waan abdadhuuf qoratamuuf dhiʼaadheen as jira.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.6",
            "verseOrgIds": [
              "ACT.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waadaan kun isuma gosoonni keenya kudha lamaan halkanii guyyaa Waaqa tajaajiluutti jabaatanii raawwatamuu isaa arguu hawwan sanaa dha. Yaa Agriiphaa Mooticha, Yihuudoonnis sababuma abdii kanaatiif na himachaa jiru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.7",
            "verseOrgIds": [
              "ACT.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka Waaqni warra duʼan duʼaa kaasu isin maaliif akka waan hin amanamne tokkootti herregdu?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani mataan koo iyyuu maqaa Yesuus nama Naazreetiitiin mormuudhaaf akka waan dandaʼamu hunda gochuu qabu nan amana ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni ani Yerusaalem keessatti hojjedhes kanuma; ani taayitaa luboota hangafoota irraa argadheen qulqulloota baayʼee mana hidhaatti naquu qofa utuu hin taʼin yeroo isaan ajjeefaman iyyuu dubbicha irratti walii galaan ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.10",
            "verseOrgIds": [
              "ACT.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka isaan adabamaniif yeroo baayʼee mana sagadaa tokko irraa gara mana sagadaa biraatti darbaa, akka isaan amantii isaanii arrabsaniifis isaan dirqisiisaan ture. Ani waan akka malee isaanitti aaraa tureef hamma magaalaawwan biyya alaatti illee deemee isaan ariʼachaan ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anis gaafa tokko kanumaaf jedhee taayitaa fi ergama luboota hangafoota biraa fudhadhee utuun Damaasqoo deemaa jiruu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.12",
            "verseOrgIds": [
              "ACT.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaa mooticha, ani utuman karaa deemaa jiruu gara saafaatti ifa ifa aduu caalaa ibsu tokko isaa samii irraa naannoo koottii fi naannoo warra na wajjin deemaniitti ibsu arge.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.13",
            "verseOrgIds": [
              "ACT.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundi keenya lafatti kukkufne; anis sagalee afaan Ibraayisxiitiin",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.14",
            "verseOrgIds": [
              "ACT.26.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Yaa Saaʼol, yaa Saaʼol, ati maaliif na ariʼatta? Arfii wayii dhiituun suma miidha'",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.14",
                "verseOrgIds": [
                  "ACT.26.14"
                ]
              }
            }
          ]
        },
        {
          "text": "naan jedhu tokkon dhagaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.14",
            "verseOrgIds": [
              "ACT.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anis, 'Yaa Gooftaa ati Eenyu?' jedheen gaafadhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 26:15"
      },
      "items": [
        {
          "text": "\"Gooftaanis deebisee akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Ani Yesuus isa ati ariʼattuu dha.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.15",
                "verseOrgIds": [
                  "ACT.26.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma kaʼii miilla keetiin dhaabadhu. Ani akka ati tajaajilaa koo taatee, waaʼee koos waan argitee fi waan ani sitti mulʼisuuf jiru dhugaa baatuuf si muuduuf jedhee sitti mulʼadheera.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.16",
                "verseOrgIds": [
                  "ACT.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani saba keetii fi Namoota Ormaa kanneen gara isaaniitti si ergu jalaa sin baasa.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.17",
                "verseOrgIds": [
                  "ACT.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Atis ija isaanii bantee dukkana keessaa gara ifaatti, humna Seexanaa jalaas gara Waaqaatti isaan deebifta; kunis akka isaan dhiifama cubbuu argatanii fi akka isaan warra natti amanuun qulqullaaʼan gidduutti dhaala argataniif.'",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.18",
                "verseOrgIds": [
                  "ACT.26.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu yaa Agriiphaa Mooticha, ani mulʼata samii irraa dhufe sanaaf ajajamuu hin didne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.19",
            "verseOrgIds": [
              "ACT.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka isaan qalbii jijjiirratanii gara Waaqaatti deebiʼaniif, qalbii jijjiirrachuu isaaniis akka hojiidhaan mirkaneessaniif jalqabatti warra Damaasqootti, warra Yerusaalemiitti, warra Yihuudaa guutuutti akkasumas Namoota Ormaatti lallabeera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin Yihuudoonni mana qulqullummaa keessatti na qabanii na ajjeesuu yaalaniifis kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu hamma guyyaa harʼaatti gargaarsa Waaqaa qaba; kanaafuu ani dhaabadhee xinnaa guddaaf dhugaa baʼaan jira. Ani waan raajonnii fi Museen 'Ni taʼa' jedhanii dubbataniin alatti waan tokko illee hin dubbadhu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akka Kiristoos",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        },
        {
          "text": "dhiphachuu qabu, akka inni warra duʼan keessaa kaʼuudhaan kan jalqabaa taʼee saba isaatii fi Namoota Ormaatiif ifa labsuu dha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma Phaawulos akkasitti falmachaa jiruu Fesxoos sagalee guddaan, \"Phaawulos, ati maraatteerta! Barumsi kee guddaan sun si maraachisaa jira\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.24",
            "verseOrgIds": [
              "ACT.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis akkana jedhee deebise; \"Yaa Fesxoos kabajamaa, ani hin maraanne; wanni ani dubbachaa jirus dhugaa dha; sirrii dhas.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.25",
            "verseOrgIds": [
              "ACT.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii mootichi waan kana beekuuf, ani ifatti baasee isatti himuu nan dandaʼa. Sababii wanni kun suuqatti hin hojjetaminiif ani akka waan kana keessaa tokko iyyuu isa duraa hin dhokatin nan amana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.26",
            "verseOrgIds": [
              "ACT.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Agriiphaa Mooticha, ati raajota ni amantaa? Akka ati amantu ani iyyuu beeka.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.27",
            "verseOrgIds": [
              "ACT.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agriiphaanis Phaawulosiin, \"Ati yeruma gabaabaa keessatti Kiristaana na gochuu yaaddaa?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.28",
            "verseOrgIds": [
              "ACT.26.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis deebisee, \"Yeroo gabaabaattis taʼu dheeraatti, si qofa utuu hin taʼin akka warri na dhagaʼaa jiran hundinuu foncaa kanaan hidhamuu malee akkuma koo akka taʼan ani Waaqa nan kadhadha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootichi, bulchaanii fi Barniiqeen, akkasumas warri isaan wajjin tataaʼaa turan ol kaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis yeroo gad baʼanitti, \"Namichi kun waan duʼaan yookaan hidhaan isa gaʼu tokko illee hin hojjenne\" wajjin jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agriiphaanis Fesxoosiin, \"Namichi kun utuu Qeesaaritti ol iyyachuu baatee silaa ni hiikama ture\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
            "verseOrgIds": [
              "ACT.26.32"
            ]
          }
        }
      ]
    }
