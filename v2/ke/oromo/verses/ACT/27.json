  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "ACT 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Roomaa Dhaquu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu dooniin Iixaaliyaa dhaquun keenya murteeffametti, Phaawulosii fi warri hidhaman biraa ajajaa dhibbaa kan Yuuliyoos jedhamu tokkotti dabarfamanii kennaman; innis miseensa kutaa waraanaa \"Awugisxoos\" jedhamu tokkoo ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.1",
            "verseOrgIds": [
              "ACT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus doonii Adraamiixoosii kaʼee gara buufatawwan doonii kanneen qarqara galaana biyya Asiyaa dhaquuf kaʼe tokko yaabbannee deemuu jalqabne. Arisxirokoos namichi Maqedooniyaa kan Tasaloniiqee jiraatu tokkos nu wajjin ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.2",
            "verseOrgIds": [
              "ACT.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa itti aanutti Siidoonaatti galle; Yuuliyoosis Phaawulosiif garaa laafee akka inni michoota isaa bira dhaqee waan isa barbaachisu argatu eeyyameef.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.3",
            "verseOrgIds": [
              "ACT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus dooniin achii kaanee waan bubbeen fuula keenya duraan nutti bubbisaa tureef Qophiroosiin daʼannee dabarre.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.4",
            "verseOrgIds": [
              "ACT.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga galaana Kiilqiyaa fi Phamfiliyaa irra dooniin darbinee booddee magaalaa Miiraa kan Luuqiiyaa keessatti argamtu geenye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.5",
            "verseOrgIds": [
              "ACT.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajaan dhibbaa sunis doonii Iskindiriyaa kan Iixaaliyaa dhaquutti jiru tokko achitti argatee nu yaabbachiise.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.6",
            "verseOrgIds": [
              "ACT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus guyyaa hedduu suuta jennee dooniin deemnee rakkinaan naannoo Kiniidoos geenye; yommuu bubbeen karaa sana irra darbuu nu dhowwettis Salmoonee biraan gara daʼoo Qareexitti qajeelle.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.7",
            "verseOrgIds": [
              "ACT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakkina guddaadhaanis qarqara galaanichaa irra darbinee iddoo \"Buufata doonii gaarii\" jedhamu kan magaalaa Laasiyaa biraa tokkotti baane.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroon dheeraan badeera; sababii yeroon sun erga Soomni darbee taʼeef dooniidhaan karaa deemuun sodaachisaa taʼeera; kanaafuu Phaawulos akkana jedhee isaan akeekkachiise;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.9",
            "verseOrgIds": [
              "ACT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa jarana, ani akka karaan keenya kun badiisa of keessaa qabu, akka inni doonichattii fi miʼa qofatti utuu hin taʼin jireenya keenyatti illee balaa guddaa fiduuf deemu nan arga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.10",
            "verseOrgIds": [
              "ACT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajaan dhibbaa sun garuu qooda waan Phaawulos jedhe dhagaʼu gorsa ooftuu dooniitii fi gorsa abbaa doonii fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.11",
            "verseOrgIds": [
              "ACT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii buufanni doonii sun ganna achi turuuf mijaaʼaa hin taʼiniif baayʼeen isaanii Finiiqeetti galanii ganna achitti dabarsuu abdatanii akka nu ittuma fufnee dooniin deemnu murteessan. Buufanni Qareexi kun fuulli isaa gara kibba dhiʼaattii fi gara kaaba dhiʼaatti deebiʼee ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bubbee Galaana Irraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo bubbeen kibbaa suuta bubbisuu jalqabetti waan kaayyoo isaanii guutachuu dandaʼan seʼanii hiituu doonii hiikanii Qareexi biraan qarqara galaana irra darban.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.13",
            "verseOrgIds": [
              "ACT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu hin turinis bubbeen hamaan, \"Awuraaqiis\" jedhamu tokko biyya bishaaniin marfamte sana irraa gad bubbise.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.14",
            "verseOrgIds": [
              "ACT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dooniin sunis bubbeedhaan qabamee gara bubbee sanaatti deemuu dadhabe; kanaafuu akka inni bubbeen fudhatamuuf ittuma dhiifne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.15",
            "verseOrgIds": [
              "ACT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus biyya bishaaniin marfamte xinnoo Qeedaa jedhamtu tokkoon daʼannee rakkina guddaadhaan bidiruu doonichaa oolchuu dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.16",
            "verseOrgIds": [
              "ACT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni sunis bidiruu sana dooniitti ol baasanii akka dooniin sun gargar hin diigamneef funyoon xaxanii walitti hidhan. Isaanis tima cirracha Sirtiisitti buʼuu sodaatanii hiituu doonii galaanatti gad buusanii akka dooniin sun bubbeen oofamtuuf ittuma dhiisan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.17",
            "verseOrgIds": [
              "ACT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan bubbeen sun akka malee nutti jabaachaa deemeef isaan guyyaa itti aanutti doonii sana irraa feʼiisa guuranii bishaanitti dadarbachuu jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.18",
            "verseOrgIds": [
              "ACT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa sadaffaatti immoo miʼa doonii sanaa harkuma ofii isaaniitiin dadarbatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.19",
            "verseOrgIds": [
              "ACT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu waan utuu aduu yookaan urjii hin argin guyyaa hedduu turree fi waan bubbeen nutti jabaateef dhuma irratti abdii badiisa ooluuf qabnu hunda ni kutanne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis erga namoonni sun agabuu isaanii yeroo dheeraa turanii booddee gidduu isaanii dhaabatee akkana jedhe; \"Yaa jarana, isin utuu gorsa koo dhageessanii Qareexii kaʼuu hin qabdan ture; silaa balaa fi badiisa kana hundumaa irraa of oolchitu turtan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.21",
            "verseOrgIds": [
              "ACT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu ani akka isin jabaattan isinan gorsa; doonicha malee isin keessaa lubbuun nama tokkoo iyyuu hin baduutii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.22",
            "verseOrgIds": [
              "ACT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan Waaqa ani kan isaa taʼee fi isa tajaajilu sanaa tokko eda dhufee na cina dhaabatee,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.23",
            "verseOrgIds": [
              "ACT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Yaa Phaawulos, hin sodaatin; ati Qeesaar dura dhaabachuu qabdaatii; kunoo, Waaqni warra si wajjin deemaa jiran hunda gaarummaa isaatiin sitti kenneera' naan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.24",
            "verseOrgIds": [
              "ACT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf yaa jarana jabaadhaa! Ani akka wanni kun akkuma natti himame sana taʼu Waaqa nan amanaatii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.25",
            "verseOrgIds": [
              "ACT.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus biyya bishaaniin marfamte tokkotti buʼuun keenya hin oolu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dooniin Caccabuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkan kudha afuraffaatti utuu galaana Adiriyaa irra asii fi achi oofamaa jirruu gara halkan walakkaatti warri doonii irra hojjetan sun waan gara lafaatti dhiʼaatan seʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.27",
            "verseOrgIds": [
              "ACT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan funyoo ittiin gad fageenya galaanaa ilaalan gad buusanii akka galaanni sun meetira soddomii torba gad fagaatu argan; yeroo gabaabaa booddee ammas funyoo sana gad buusanii akka gad fageenyi galaanichaa meetira digdamii saddeet taʼe argan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.28",
            "verseOrgIds": [
              "ACT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis kattaatti buuna jedhanii sodaatanii hiituu doonii afur dugda duubaan doonii irraa gad buusan. Akka lafti bariituufis kadhatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.29",
            "verseOrgIds": [
              "ACT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri doonii irra hojjetanis bidiruu keessaa baqachuuf jedhanii waan fuula doonii duraan hiituu doonii buusan fakkaatanii bidiruu sana galaana keessa buusan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.30",
            "verseOrgIds": [
              "ACT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos immoo ajajaa dhibbaatii fi loltootaan, \"Yoo namoonni kunneen doonii keessatti hafan malee isin badii ooluu hin dandeessan\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.31",
            "verseOrgIds": [
              "ACT.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu loltoonni sun funyoo bidirichi ittiin hidhamee ture sana irraa kutanii galaanatti gad ishee dhiisan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.32",
            "verseOrgIds": [
              "ACT.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara barii lafaattis Phaawulos akka namoonni hundinuu waa nyaataniif isaan kadhate; akkanas jedheen; \"Isin bultii kudha afran darban yaaddaʼaa, utuu waa tokko illee hin nyaatin agabuu keessan ooltanii bultaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.33",
            "verseOrgIds": [
              "ACT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf ani akka isin waa nyaattaniif isin kadhadha. Nyaanni jiraachuuf isin barbaachisaatii. Isin keessaa nama kam iyyuu rifeensa mataa isaa keessaa tokko iyyuu hin baduutii.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.34",
            "verseOrgIds": [
              "ACT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis erga waan kana dubbatee booddee buddeena fuudhee hunduma isaanii duratti Waaqa galateeffate; kutatees nyaachuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.35",
            "verseOrgIds": [
              "ACT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan hundinuu jajjabaatanii ofumaan waa nyaatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.36",
            "verseOrgIds": [
              "ACT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walumatti nu nama 276 taanee doonii sana keessa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.37",
            "verseOrgIds": [
              "ACT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis erga nyaatanii quufanii booddee qamadii feʼamee ture sana galaanatti naqanii akka dooniin salphatu godhan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.38",
            "verseOrgIds": [
              "ACT.27.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis yommuu lafti bariitetti galoo galaanaa kan kuufama cirrachaa qabu tokko argan malee biyyi fuula isaanii dura jiru sun eessa akka taʼe hin hubanne; doonii sanas yoo isaanii dandaʼame dhiibanii qarqara galaanaatti baasuu murteessan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.39",
            "verseOrgIds": [
              "ACT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu funyoo hiituu doonii kutanii galaana keessatti gad dhiisan; yeruma sana funyoo batoon ittiin hidhame sana hiikan; ergasiis sharaa karaa fuula doonii duraan jiru sana qilleensatti ol fuudhanii gara kuufama cirrachaatti qajeelan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.40",
            "verseOrgIds": [
              "ACT.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu dooniin sun iddoo itti galaanni lama wal gaʼutti tima cirrachaatti buʼee lafa tuqe. Mataan isaa achitti qabamee sochoʼuu dide; dudga duubni isaa immoo humna dhaʼaa galaanaatiin dhaʼamee caccabe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.41",
            "verseOrgIds": [
              "ACT.27.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonnis akka warra hidhaman sana keessaa namni tokko iyyuu bishaan daakee baqatee jalaa hin baaneef isaan ajjeesuuf karoorfatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.42",
            "verseOrgIds": [
              "ACT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu ajajaan dhibbaa sun waan Phaawulosin duʼa oolchuu fedheef akka isaan waan karoorfatan sana hin goone dhowwe; innis akka warri bishaan daakuu dandaʼan duraan dursanii doonii irraa utaalanii gara lafaatti baʼan ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.43",
            "verseOrgIds": [
              "ACT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka warri hafan immoo saanqaa yookaan caccabaa dooniitiin achi gaʼan ajaje; haala kanaan hundi isaanii nagaan lafatti baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.44",
            "verseOrgIds": [
              "ACT.27.44"
            ]
          }
        }
      ]
    }
  ],
