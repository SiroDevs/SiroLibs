    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiyaas yeroo mootii taʼetti nama waggaa saddeetii ture; Yerusaalem keessa taaʼees waggaa soddomii tokko bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.2",
                "verseOrgIds": [
                  "2CH.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan qajeelaa ni hojjete; utuu mirgatti yookaan bitaatti hin gorinis karaa abbaa isaa Daawit irra deeme.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni mootii taʼee waggaa saddeettaffaatti utuma umurii dargaggummaa keessa jiruu Waaqa abbaa isaa Daawit barbaaduu jalqabe. Waggaa kudha lammaffaatti immoo Yihuudaa fi Yerusaalem keessaa iddoowwan sagadaa kanneen gaarran irraa, siidaawwan Aasheeraa, waaqota tolfamoo fi fakkiiwwan baqfamanii tolfaman ni balleesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qajeelfama isaatiinis iddoowwan aarsaa Baʼaal diigaman; iddoowwan aarsaa ixaanaa kanneen achi irra turan caccabsee siidaawwan Aasheeraa, waaqota tolfamoo fi fakkiiwwan hurreesse. Wantoota kanneenis daakee bulleessee awwaala warra isaaniif aarsaa dhiʼeessaa turanii irratti bittinneesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafee lubootaas iddoowwan aarsaa isaanii irratti guggube. Haala kanaanis Yihuudaa fi Yerusaalemin qulqulleesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan Minaasee, kan Efreemii fi Simiʼoon kanneen hamma Niftaalemitti jiranii fi akkasumas diigamaa naannoowwan isaanii keessatti",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "iddoowwan aarsaa fi siidaawwan Aasheeraa ni jijjigse; waaqota tolfamoo daaraa godhe; iddoowwan aarsaa ixaanaa kanneen guutummaa Israaʼel keessa jiran hundas ni caccabse. Ergasiis Yerusaalemitti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiyaas mootii taʼee waggaa kudha saddeettaffaatti erga biyyattii fi mana qulqullummaa qulqulleessee booddee mana",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.8",
                "verseOrgIds": [
                  "2CH.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa haaromsuuf Shaafaan ilma Azaliyaa, Maʼaseyaa bulchaa magaalaa fi Yooʼaa ilma Yooʼaahaaz galmeessaa sana erge.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis gara Hilqiyaa lubicha ol aanaa dhaqanii maallaqa mana qulqullummaa Waaqaatiif fidame sana itti kennan; maallaqa kanas Lewwota balbala eegantu saboota Minaasee irraa, kan Efreem irraa, hambaawwan Israaʼel hunda irraa, saba Yihuudaa fi kan Beniyaam hunda irraa akkasumas jiraattota Yerusaalem irraa walitti qabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis maallaqa sana namoota akka hojii mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.10",
                "verseOrgIds": [
                  "2CH.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": "toʼataniif muudamanitti imaanaa kennan. Namoonni kunneenis hojjettoota mana qulqullummaa haaromsanii akka duriitti deebisaniif ni kaffalu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas akka isaan ijaarsa mootonni Yihuudaa akka diigamu godhan sanaaf dhagaa soofame, laaxaawwan, mukkeen sutaa fi dareeraawwan bitaniif ogeeyyii mukaa fi ijaartotatti maallaqa kennan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni sunis amanamummaadhaan hojicha hojjetan. Lewwota sanyii Meraarii keessaa Yahaatii fi Obaadiyaan akkasumas sanyii Qohaati keessaa Zakkaariyaasii fi Meshulaam akka jara sana hojjechiisaniif isaan irratti muudaman. Lewwonni meeshaa faarfannaa taphachuu beekan hundis",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "itti gaafatamtoota hojjettoota hojii humnaa taʼanii hojjettoota hojii garaa garaa illee toʼachaa turan. Lewwonni tokko tokkos barreessitoota, qondaaltotaa fi eegdota balbalaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitaabni Seeraa Argamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
