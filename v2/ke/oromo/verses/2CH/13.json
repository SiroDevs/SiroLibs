    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara mootummaa Yerobiʼaam keessa waggaa kudha saddeettaffaatti Abiyaan mootii Yihuudaa taʼe;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis Yerusaalem keessa jiraatee waggaa sadii ni bulche. Maqaan haadha isaa Miikaayaa ture; isheen intala Uuriiʼeel namicha Gibeʼaa sanaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 13:2"
      },
      "items": [
        {
          "text": "Abiyaa fi Yerobiʼaam gidduu waraanatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiyaan humna waraanaa kan namoota lola dandaʼan kuma dhibba afur of keessaa qabuun duule; Yerobiʼaam immoo loltoota ciccimoo kuma dhibba saddeetiin baʼee isa eegate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiyaan Gaara Zemaaraayim kan biyya gaaraa Efreem irra dhaabatee akkana jedhe; \"Yerobiʼaamii fi Israaʼel hundi mee na dhaggeeffadhaa!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin akka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.5",
                "verseOrgIds": [
                  "2CH.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel sun mootummaa Israaʼel Daawitii fi sanyiiwwan isaatiif kakuu soogiddaan bara baraan kenne hin beektanii?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus Yerobiʼaam ilmi Nebaat tajaajilaan Solomoon ilma Daawit sun gooftaa isaatti ni fincile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Rehooboʼaam ilmi Solomoon ijoollee waa murteeffachuu fi isaaniin mormuufis dandeettii hin qabneetti kashlabboonni faayidaa hin qabne tokko tokko naannoo isaatti walitti qabamanii isaan morman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin amma mootummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.8",
                "verseOrgIds": [
                  "2CH.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kan sanyii Daawit harka jiruun mormuuf yaadaa jirtan. Isin dhugumaan tuuta guddaa dha; fakkiiwwan jabbiiwwan warqee kanneen akka isaan waaqota keessan isinii taʼaniif Yerobiʼaam isiniif tolche sanas of biraa qabdu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin garuu luboota",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.9",
                "verseOrgIds": [
                  "2CH.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", ilmaan Arooniitii fi Lewwota of keessaa baaftanii akkuma namoota biyyoota kaanii luboota ofii keessanii hin muudannee? Namni dibicha loonii tokkoo fi korbeeyyii hoolaa torba qabatee of qulqulleessuu dhufu kam iyyuu waan waaqota hin taʼin sanaaf luba taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nuuf garuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.10",
                "verseOrgIds": [
                  "2CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaquma keenya; nu isa hin dhiifne. Luboonni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.10",
                "verseOrgIds": [
                  "2CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "tajaajilanis ilmaan Aroon; Lewwonni immoo isaan ni gargaaru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan ganamaa fi galgala hunda aarsaa gubamuu fi ixaana urgaaʼu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.11",
                "verseOrgIds": [
                  "2CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ni dhiʼeessu. Minjaala akka seeraatti qulqullaaʼe irra buddeena kaaʼanii galgala galgala immoo ibsaa baattuu ibsaa kan warqee irraa hojjetame irra jiru ni qabsiisu. Nu ajaja",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.11",
                "verseOrgIds": [
                  "2CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaa ni eegna; isin garuu isa dhiiftaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni nu wajjin jira; inni qajeelchaa keenya. Luboonni isaas malakata isaanii afuufanii waraana isinitti ni waamu. Yaa namoota Israaʼel isin hin milkooftaniitii,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.12",
                "verseOrgIds": [
                  "2CH.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii keessanii hin lolinaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobiʼaam yeroo kanatti akka isaan utuma inni fuula Yihuudaa duraan jiruu karaa dugda duubaatiin isaan marsaniif loltoota isaa jaratti ni erge.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yihuudaa garagalanii akka duraa fi duubaan marfaman ni argan. Isaanis gara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.14",
                "verseOrgIds": [
                  "2CH.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ni iyyatan; luboonni immoo malakata isaanii ni afuufan;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni Yihuudaas iyya waraanaa ni dhageessisan. Waaqnis iyya isaaniitiin Yerobiʼaamii fi Israaʼeloota hunda fuula Abiyaa fi Yihuudaa duraa ni barbadeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.15",
            "verseOrgIds": [
              "2CH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni fuula Yihuudaa duraa ni baqatan; Waaqnis dabarsee harka Yihuudootaatti isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiyaa fi namoonni isaa akka malee isaan miidhan; kanaafuu loltoota Israaʼel ciccimoo keessaa namni kuma dhibba shan ni dhume.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
            "verseOrgIds": [
              "2CH.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola sana irrattis namoonni Israaʼel akka malee ni dhaʼaman; namoonni Yihuudaa garuu sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.18",
            "verseOrgIds": [
              "2CH.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.18",
                "verseOrgIds": [
                  "2CH.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaanii abdataniif ni moʼatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.18",
            "verseOrgIds": [
              "2CH.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
