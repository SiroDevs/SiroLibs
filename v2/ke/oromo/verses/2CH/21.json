              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooraam erga mootummaa abbaa isaa irratti jabaatee dhaabatee booddee obboloota isaa hundaa fi qondaaltota Israaʼel tokko tokko goraadeedhaan ni fixe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooraam yeroo mootii taʼetti umuriin isaa waggaa soddomii lama ture; innis Yerusaalem keessa taaʼee waggaa saddeet ni bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.5",
            "verseOrgIds": [
              "2CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma manni Ahaab godhee ture sana karaa mootota Israaʼel duukaa buʼe; intala Ahaab fuudhee tureetii. Fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.6",
                "verseOrgIds": [
                  "2CH.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "durattis waan hamaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.7",
                "verseOrgIds": [
                  "2CH.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sababii Daawit wajjin kakuu galeef mana Daawit balleessuun fedhii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.7",
                "verseOrgIds": [
                  "2CH.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "hin turre. Inni isaa fi sanyii isaatiif ibsaa bara baraa dhaabuuf kakuu galee ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yehooraam keessa Edoom Yihuudaatti fincilee mootii ofii isaa moosifate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.8",
            "verseOrgIds": [
              "2CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Yehooraam qondaaltota isaatii fi gaariiwwan isaa hunda wajjin achi dhaqe. Warri Edoomis isaa fi ajajjoota gaariiwwan isaa marsan; inni garuu halkaniin kaʼee isaan ni dhaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.9",
            "verseOrgIds": [
              "2CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edoom hamma harʼaatti illee akkuma Yihuudaatti finciletti jira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 21:10"
      },
      "items": [
        {
          "text": "Libnaanis sababii Yehooraam",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.10",
                "verseOrgIds": [
                  "2CH.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaa dhiiseef yeruma sanatti fincile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulluuwwan Yihuudaa irrattis iddoowwan sagadaa ijaaree akka namoonni Yerusaalem sagaagalan gochuudhaan Yihuudaa karaa irraa jalʼise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooraamis xalayaa Eeliyaas raajicha biraa ergame tokko ni argate; xalayaan sunis akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 21:12"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.12",
                "verseOrgIds": [
                  "2CH.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni abbaa kee Daawit akkana jedha: 'Ati karaa abbaa kee Yehooshaafaax irra yookaan karaa Aasaa mooticha Yihuudaatti hin adeemne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati garuu karaa mootota Israaʼel irra deemuudhaan akkuma manni Ahaab godhe sana Yihuudaa fi saba Yerusaalem sagaagalchiifte. Obboloota kee miseensota mana abbaa keetii kanneen sirra wayyan sana illee ni fixxe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.13",
            "verseOrgIds": [
              "2CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.14",
                "verseOrgIds": [
                  "2CH.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "amma saba kee, ilmaan kee, niitota kee fi waan ati qabdu hunda dhaʼicha hamaadhaan dhaʼuuf jira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati mataan kee iyyuu dhukkuba marʼumaanii kan guyyaa guyyaadhaan hammaachaa deemuun qabamta; dhuma irrattis dhukkubichi marʼumaan kee alatti yaasa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.16",
                "verseOrgIds": [
                  "2CH.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Filisxeemotaa fi Araboota saba Itoophiyaatti dhiʼoo jiraatan Yehooraamitti ni kaase.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
            "verseOrgIds": [
              "2CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Yihuudaa dhaʼanii qabatan; miʼa masaraa mootii keessatti argamu hunda, ilmaanii fi niitota isaa wajjin boojiʼanii ni fudhatan. Ilma isaa Ahaaziyaa isa quxisuu sana malee ilmi tokko iyyuu hin hafneef.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kana hundaa booddee",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.18",
                "verseOrgIds": [
                  "2CH.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dhukkuba marʼumaanii kan hin fayyineen Yehooraamin ni dhaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis oolee bulee dhuma waggaa lammaffaatti sababii dhukkuba hamaa sanaatiif marʼumaan isaa keessaa ni kufe; akka malees dhiphatee ni duʼe. Namoonni isaa akka abbootii isaatiif godhan sana ulfina isaatiif jedhanii ibidda hin bobeessine.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooraam yeroo mootii taʼetti nama waggaa soddomii lamaa ture. Innis Yerusaalem keessa taaʼee waggaa saddeet ni bulche. Yeroo inni duʼetti namni tokko iyyuu isaaf hin gaddine; innis Magaalaa Daawit keessatti awwaalame malee lafa mootonni itti awwaalamanitti hin awwaalamne.",
          "type": "text",
