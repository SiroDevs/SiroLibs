    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis tokkoo tokkoo isaanii akka isaan akkuma hojii lubummaa isaaniitti yookaan akkuma hojii Lewwummaa isaaniitti aarsaa gubamuu fi aarsaa nagaa dhiʼeessaniif, akka isaan karra iddoo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.2",
                "verseOrgIds": [
                  "2CH.31.2"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraatuu duratti tajaajilaniif, akka isaan galata galchanii fi akka isaan faarfannaa galataa faarfataniif lubootaa fi Lewwota garee gareedhaan ramade.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis akkuma Seera",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.3",
                "verseOrgIds": [
                  "2CH.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti barreeffame sanatti, aarsaa gubamu kan ganamaa fi galgalaa akkasumas aarsaa gubamu kan Sanbatootaa, Ayyaana Baatiiwwan Haaraa fi guyyaa ayyaana murteeffameetiif qabeenya ofii isaa irraa ni kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka luboonnii fi Lewwonni Seera",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiif",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.4",
                "verseOrgIds": [
                  "2CH.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "of kennuu dandaʼaniif namoota Yerusaalem keessa jiraatan akka isaan qooda jaraaf malu kennaniif ni ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma ajajni sun baʼeenis Israaʼeloonni mataa midhaan isaanii kan jalqabaa irraa, daadhii wayinii haaraa irraa, zayitii fi damma irraa akkasumas waan lafa qotiisaa irraa argamu hunda irraa arjummaadhaan kennan. Waan hunda irraa harka kudhan keessaa harka tokko guddisanii ni fidan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Israaʼelii fi Yihuudaa warri magaalaawwan Yihuudaa keessa jiraatanis loonii fi bushaayee isaanii irraa harka kudhan keessaa harka tokko, akkasumas waan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.6",
                "verseOrgIds": [
                  "2CH.31.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaaniitiif qulqulleeffame irraa harka kudhan keessaa harka tokko ni fidan; ni tuulanis.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis hojii kana jiʼa sadaffaatti jalqabanii jiʼa torbaffaatti fixan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasii fi qondaaltonni isaa yommuu dhufanii tuullaawwan sana arganitti",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.8",
                "verseOrgIds": [
                  "2CH.31.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ni galateeffatan; saba isaa Israaʼelinis ni eebbisan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis waaʼee tuullaa sanaa lubootaa fi Lewwota gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "maatii Zaadoq keessaa Azaariyaa lubichi hangafni akkana jedhee deebise; \"Erga namoonni kennaa isaanii gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.10",
                "verseOrgIds": [
                  "2CH.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": "fidduu jalqabanii as nu nyaata gaʼaa fi irraa hafaa arganneerra; sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.10",
                "verseOrgIds": [
                  "2CH.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": "saba isaa eebbiseef hambaan akka malee guddaan kun hafeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis akka isaan mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.11",
                "verseOrgIds": [
                  "2CH.31.11"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti mankuusaalee qopheessan ajaje; isaanis ni qopheessan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis ergasii buusii, kennaa harka kudhan keessaa harka tokkoo fi kennaawwan qulqulleeffaman amanamummaadhaan fidan. Wantoota kanneen irrattis Konaneyaan Lewwichi itti gaafatamaa ture; obboleessi isaa Shimeʼiin immoo sadarkaadhaan itti aanaa isaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehiiʼeel, Azaziyaa, Nahaati, Asaaheel, Yeriimooti, Yoozaabaad, Eliiʼeel, Yismakiyaa, Mahatii fi Benaayaa, Konaneyaa fi obboleessa isaa Shimeʼii jalatti toʼattoota taʼanii Hisqiyaas mootichaa fi Azaariyaa itti gaafatamaa mana qulqullummaa Waaqaatiin muudaman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooraahi ilmi Yimnaa Lewwichi, eegduun Karra Baʼaa sun kennaa fedhiidhaan Waaqaaf kenname irratti, akkasumas buusii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.14",
                "verseOrgIds": [
                  "2CH.31.14"
                ]
              }
            }
          ]
        },
        {
          "text": "godhamee fi kennaawwan qulqulleeffaman qooduu irratti itti gaafatamummaa qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeden, Miiniyaamiin, Yeeshuuʼaan, Shemaaʼiyaan, Amariyaa fi Shekaaniyaan magaalaawwan lubootaa keessatti luboota michoota isaaniitiif guddaa fi xinnaa akkuma tokkotti garee garee isaaniitti isaaniif qooduudhaan amanamummaadhaan isa gargaaran.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana malees dhiirota umuriin isaanii waggaa sadii fi sanaa ol taʼe kanneen maqaan isaanii galmee hidda dhalootaa keessa jiru warra akkuma itti gaafatamummaa isaanii fi ramaddii isaaniitti qooda hojii isaanii kan guyyaa guyyaa hojjetamu hojjechuuf mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.16",
                "verseOrgIds": [
                  "2CH.31.16"
                ]
              }
            }
          ]
        },
        {
          "text": "seenuu dandaʼan hundaaf akkasuma ni qoodan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboota maatii isaaniitiin galmee hidda dhalootaa keessatti galmeeffamanii fi Lewwota umuriin isaanii waggaa digdamaa fi sanaa ol taʼeefis akkuma itti gaafatamummaa fi qooda hojii isaaniitti ni ramadaniif.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonni kunneen ijoollee isaanii xixinnoo, niitota isaanii, ilmaan isaaniitii fi intallan isaanii kanneen waldaa guutuu keessa jiran hunda wajjin ni galmeeffaman; isaan of qulqulleessuudhaan amanamoo turaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
