              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaas waan kana guutummaa Yihuudaa keessatti ni hojjete; innis waan fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.20",
                "verseOrgIds": [
                  "2CH.31.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa duratti gaarii, qajeelaa fi amanamaa taʼe ni hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis mana qulqullummaa Waaqaa keessa hojjechuunis taʼu, seeraa fi ajajawwaniif ajajamuudhaan waan hojjete hunda keessatti Waaqa isaa barbaaduudhaaf garaa isaa guutuudhaan ni hojjete; kanaafuu inni ni milkaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
