  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2CH 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaan waggaa torbaffaatti jabina ofii isaa ni argisiise. Innis ajajjuuwwan dhibbaa jechuunis Azaariyaa ilma Yirooham, Ishmaaʼeel ilma Yehohaanaan, Azaariyaa ilma Oobeed, Maʼaseyaa ilma Adaayaa fi Eliishaafaax ilma Zikrii wajjin kakuu seene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis guutummaa Yihuudaa keessa deemanii magaalaawwan hunda keessaa Lewwotaa fi hangafoota maatiiwwan Israaʼel walitti ni qaban. Yommuu isaan Yerusaalem gaʼanittis,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "waldaan guutuun mana qulqullummaa Waaqaa keessatti mooticha wajjin kakuu seene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 23:3"
      },
      "items": [
        {
          "text": "Yehooyaadaanis akkana isaaniin jedhe; \"Akkuma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.3",
                "verseOrgIds": [
                  "2CH.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "waaʼee sanyii Daawit waadaa gale sanatti, ilmi mootichaa mootii ni taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni isin gochuu qabdan isa kana: Isin lubootaa fi Lewwota guyyaa Sanbataa hojiitti ramadamtan keessaa harka sadii keessaa harki tokko karra,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.4",
            "verseOrgIds": [
              "2CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "harka sadii keessaa harki tokko masaraa mootummaa, harka sadii keessaa harki tokko immoo karra 'Karra Hundee' jedhamu sana eegaa; namoonni kaan hundi immoo oobdii mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.5",
                "verseOrgIds": [
                  "2CH.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti argamuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubootaa fi Lewwota hojii irra jiran malee namni tokko iyyuu mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.6",
                "verseOrgIds": [
                  "2CH.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "hin seenin; isaan sababii qulqullaaʼaniif seenuu ni dandaʼu; warri kaan hundi garuu waan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.6",
                "verseOrgIds": [
                  "2CH.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "isaan ajaje eeguu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni tokkoon tokkoon isaanii miʼa lolaa harkatti qabatanii mootichatti naannaʼanii dhadhaabachuu qabu. Namni mana qulqullummaa seenu kan biraa kam iyyuu haa ajjeefamu. Lafa inni dhaqu hundatti mootichatti dhiʼoo jiraadhaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonnii fi namoonni Yihuudaa hundinuu akkuma Yehooyaadaan lubichi ajaje sana ni godhan. Sababii Yehooyaadaan lubichi gareewwan eegumsaa keessaa tokko illee gad hin dhiisiniif tokkoon tokkoon isaaniis namoota isaanii warra guyyaa Sanbataatiin hojiitti bobbaʼanii fi warra hojii irraa boqotan ni fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.8",
            "verseOrgIds": [
              "2CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis eeboowwan, gaachanawwan gurguddaa fi xixinnaa Daawit Mootichaa kanneen mana qulqullummaa Waaqaa keessa turan ajajjuuwwan dhibbaatiif ni kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.9",
            "verseOrgIds": [
              "2CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka namoonni hundi miʼa lolaa harkatti qabatanii karaa kibba mana qulqullummaatii hamma karaa kaaba mana qulqullummaatti iddoo aarsaatii fi mana qulqullummaa biratti mootichatti naannaʼanii dhaabatan ni godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.10",
            "verseOrgIds": [
              "2CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaa fi ilmaan isaa ilma mootichaa fidanii mataa isaa irra gonfoo kaaʼan; isaanis garagalcha kakuu itti kennanii akka inni mootii taʼe ni labsan. Isa dibaniis, \"Mootichi bara baraan haa jiraatu!\" jedhanii ni iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataaliyaan yommuu waca namoota fiiganii mooticha leellisanii dhageessetti, isaan bira gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.12",
                "verseOrgIds": [
                  "2CH.23.12"
                ]
              }
            }
          ]
        },
        {
          "text": "dhaqxe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo isheen ilaaltetti mootichi balbala irra utubaa isaa bira dhaabatuu ni argite. Qondaaltonnii fi warri malakata afuufan mooticha bira turan; namoonni biyya sanaa hundinuus gammadanii malakata afuufaa turan; faarfattoonni immoo meeshaa muuziiqaatiin faarfannaa qajeelchaa turan. Kana irratti Ataaliyaan uffata ishee tarsaaftee, \"Kun maltummaa dha! Kun maltummaa dha!\" jettee iyyite.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.13",
            "verseOrgIds": [
              "2CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaan lubichis, \"Hiriira gidduudhaa baasaatii ishee fidaa; nama ishee irra dhufu kam iyyuu goraadeedhaan ajjeesaa\" jedhee ajajjuuwwan dhibbaa kanneen kutaawwan loltootaa sana irratti ramadaman erge. Lubichi, \"Mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.14",
                "verseOrgIds": [
                  "2CH.23.14"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti ishee hin ajjeesinaa\" jedhee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isaan akkuma isheen karra \"Karra Fardaa\" jedhamu kan masaraa mootii duraa geesseen qabanii achumatti ishee ni ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.15",
            "verseOrgIds": [
              "2CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaan akka inni, sabnii fi mootichis saba",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.16",
                "verseOrgIds": [
                  "2CH.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "taʼaniif kakuu ni dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni hundinuu gara galma Baʼaal dhaqee diige. Isaanis iddoowwan aarsaatii fi waaqota tolfamoo caccabsanii Mataan lubicha Baʼaal sana illee iddoowwan aarsaa duratti ni ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.17",
            "verseOrgIds": [
              "2CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Yehooyaadaan luboota Lewwota turan kanneen Daawit mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.18",
                "verseOrgIds": [
                  "2CH.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti ramadee ture sanatti itti gaafatamummaa mana qulqullummaa ni kenne; isaan akkuma Seera Musee keessatti barreeffame sanatti aarsaa gubamu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.18",
                "verseOrgIds": [
                  "2CH.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessuu qabu; Daawit akka isaan gammachuu fi faarfannaadhaan aarsaa kana dhiʼeessan ajajee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas inni akka namni karaa kamiin iyyuu xuraaʼe tokko iyyuu ol hin seenneef balbala mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
            "verseOrgIds": [
              "2CH.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.19",
                "verseOrgIds": [
                  "2CH.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "dura eegdota ni dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
            "verseOrgIds": [
              "2CH.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 23:20"
          },
