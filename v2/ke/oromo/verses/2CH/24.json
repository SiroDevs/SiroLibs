    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaash yeroo mootii taʼetti nama umuriin isaa waggaa torbaa ture; innis Yerusaalem keessa taaʼee waggaa afurtama ni bulche. Maqaan haadha isaa Ziibiyaa ture; isheenis nama Bersheebaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.1",
            "verseOrgIds": [
              "2CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaash bara Yehooyaadaa lubichaa hunda keessa waan fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.2",
                "verseOrgIds": [
                  "2CH.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti qajeelaa taʼe hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaan niitota lama isaaf file; innis ilmaanii fi intallan ni dhalche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo xinnoo booddees Yooʼaash mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.4",
                "verseOrgIds": [
                  "2CH.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "haaromsuuf murteesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis lubootaa fi Lewwota walitti waamee, \"Gara magaalaawwan Yihuudaa dhaqaatii maallaqa waggaa waggaadhaan mana qulqullummaa Waaqa keessanii haaromsuuf oolu Israaʼeloota hunda irraa walitti qabaa. Kanas ammuma godhaa\" isaaniin jedhe. Lewwonni garuu dafanii hin goone.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi Yehooyaadaa lubicha hangafticha waamee, \"Ati maaliif akka Lewwonni gibira Museen garbichi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.6",
                "verseOrgIds": [
                  "2CH.24.6"
                ]
              }
            }
          ]
        },
        {
          "text": "fi yaaʼiin Israaʼel akka dunkaana dhuga baʼumsaatiif baafamu murteessan sana Yihuudaa fi Yerusaalem irraa walitti qaban hin godhin?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sana ilmaan Ataaliyaa dubartittii hamtuu sanaa mana qulqullummaa Waaqaa cabsanii seenanii miʼoota qulqulleeffaman illee Baʼaalin tajaajiluuf itti ni fayyadaman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi akka isaan sanduuqa maallaqni itti walitti qabamu hojjetanii karaa alaatiin balbala mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.8",
                "verseOrgIds": [
                  "2CH.24.8"
                ]
              }
            }
          ]
        },
        {
          "text": "bira kaaʼan ni ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan qaraxa Museen garbichi Waaqaa sun yeroo gammoojjii keessa turanitti Israaʼeloota ajaje sana",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.9",
                "verseOrgIds": [
                  "2CH.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": "fidaniif Yihuudaa fi Yerusaalem keessatti labsiin tokko ni baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni hundii fi sabni hundi buusii isaanii gammachuudhaan fidanii hamma inni guututti sanduuqicha keessa ni buusan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.10",
            "verseOrgIds": [
              "2CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu sanduuqichi Lewwotaan gara qondaaltota mootiitti fidamee qondaaltonni sun akka maallaqni baayʼeen isa keessa jiru arganitti barreessaan mootichaa fi ajajaan lubicha hangafaa dhufanii maallaqa sana sanduuqa keessaa garagalchanii sanduuqicha iddoo isaatti deebisu ture. Isaanis guyyuma guyyaan akkas godhanii maallaqa akka malee baayʼee walitti ni qaban.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.11",
            "verseOrgIds": [
              "2CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichii fi Yehooyaadaanis maallaqa sana warra mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.12",
                "verseOrgIds": [
                  "2CH.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "hojjechiisuuf itti gaafatamummaa fudhatanitti ni kennan. Isaanis mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.12",
                "verseOrgIds": [
                  "2CH.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "haaromsuudhaaf namoota dhagaa cabsanii fi ogeeyyii hojii mukaa, akkasumas mana qulqullummaa haaromsuudhaaf hojjettoota sibiilaa fi naasii ittiin ni qaxaran.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojjettoonni qaxaraman waan jabaatanii hojjetaniif hojiin sun isaaniif ni milkaaʼe. Mana qulqullummaa Waaqaas akkuma duraan turetti deebisanii ni haaromsan; ni jabeessanis.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.13",
            "verseOrgIds": [
              "2CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga fixanii booddees maallaqa hafe fidanii mootichaa fi Yehooyaadaatti ni kennan; maallaqa sanaanis miʼoota mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.14",
                "verseOrgIds": [
                  "2CH.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": "jechuunis miʼoota tajaajilaa fi kan aarsaan gubamu ittiin dhiʼeeffamu akkasumas caabiiwwan, miʼoota warqee fi meetii ittiin ni hojjetan. Isaanis bara Yehooyaadaa keessa utuu gargar hin kutin mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.14",
                "verseOrgIds": [
                  "2CH.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti aarsaa gubamu dhiʼeessaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaanis bara dheeraa jiraatee dulloomee waggaa dhibba tokkoo fi soddomatti ni duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.15",
            "verseOrgIds": [
              "2CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis sababii Israaʼel keessatti Waaqaa fi mana qulqullummaa isaatiif waan gaarii hojjeteef Magaalaa Daawit keessatti mootota biratti ni awwaalame.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hammina Yooʼaash",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga Yehooyaadaan duʼee booddee qondaaltonni Yihuudaa dhufanii amanamummaa mootichaaf qaban ni ibsan; innis isaan dhaggeeffate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.17",
            "verseOrgIds": [
              "2CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.18",
                "verseOrgIds": [
                  "2CH.24.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaanii dhiisanii siidaawwan Aasheeraa fi waaqota tolfamoo ni waaqeffatan. Sababii balleessaa isaaniifis dheekkamsi Waaqaa Yihuudaa fi Yerusaalemitti ni dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan gara isaatti saba deebisaniif",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.19",
                "verseOrgIds": [
                  "2CH.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "raajota isaanitti erge; raajonnis isaanitti rageessan; isaan garuu dhagaʼuu hin barbaanne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Hafuurri Waaqaa Zakkaariyaas ilma Yehooyaadaa lubichaa irra ni buʼe. Innis kaʼee fuula uummataa dura dhaabatee, \"Waaqni akkana jedha: 'Isin maaliif ajaja",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.20",
                "verseOrgIds": [
                  "2CH.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "eeguu diddani? Isin hin milkooftan. Sababii isin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.20",
                "verseOrgIds": [
                  "2CH.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiiftaniif innis isin dhiiseera' \" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu isatti mariʼatanii ajaja mootichaatiin oobdii mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.21",
                "verseOrgIds": [
                  "2CH.24.21"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti dhagaadhaan tumanii isa ni ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaash mootichi arjummaa Yehooyaadaan abbaan Zakkaariyaas isaaf godhe sana hin yaadanne; qooda kanaa inni ilma isaa ni ajjeese; innis yeroo duʼutti, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.22",
                "verseOrgIds": [
                  "2CH.24.22"
                ]
              }
            }
          ]
        },
        {
          "text": "waan kana haa argu; haaloos haa baʼu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuma waggaa sanaattis loltoonni Sooriyaa Yooʼaashitti ni duulan; Yihuudaa fi Yerusaalem qabatanii hooggantoota sabaa hunda ni fixan. Isaanis waan boojiʼan hunda gara Damaasqootti mootii isaaniitti ni ergan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonni Sooriyaa namoota xinnoo qabatanii dhufan illee",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.24",
                "verseOrgIds": [
                  "2CH.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "loltoota akka malee baayʼee harka isaaniitti dabarsee ni kenne. Sababii Yihuudoonni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.24",
                "verseOrgIds": [
                  "2CH.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaanii dhiisaniif Yooʼaashitti murtiin murame.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Sooriyaa yommuu baʼanitti Yooʼaashin akka malee madeessanii ni deeman. Qondaaltonni isaas sababii inni ilma Yehooyaadaa lubichaa ajjeeseef isatti mariʼatanii siree isaa irratti isa ajjeesan. Kanaafuu inni duʼee Magaalaa Daawit keessatti ni awwaalame; garuu iddoo awwaala moototaatti hin awwaalamne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri isatti mariʼatanis Zaabaad ilma Shimeʼaati dubartii Amoon sanaa fi Yehoozaabaad ilma Shimriiti dubartii Moʼaab sanaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seenaan ilmaan isaa, raajiiwwan waaʼee isaa dubbataman hedduunii fi seenaan haaromfamuu mana qulqullummaa Waaqaa kitaaba seenaa moototaa keessatti barreeffameera. Amasiyaa ilmi isaa iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
      ]
    }
  ],
