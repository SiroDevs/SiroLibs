      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 36:23"
      },
      "items": [
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.23",
                "verseOrgIds": [
                  "2CH.36.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni samii mootummoota lafa irraa hunda naaf kenneera; akka ani Yihuudaa keessatti Yerusaalemitti mana qulqullummaa isaaf ijaaruufis na muudeera. Saba isaa keessaa nama gidduu keessanitti argamu kam iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.23",
                "verseOrgIds": [
                  "2CH.36.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni isaa isa wajjin haa taʼu; innis ol haa baʼu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        }
      ]
