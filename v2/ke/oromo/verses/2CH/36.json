    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaakiin yeroo mootii taʼetti umuriin isaa waggaa kudha saddeet ture; innis Yerusaalem keessa taaʼee jiʼa sadii fi bultii kudhan bulche. Fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.9",
                "verseOrgIds": [
                  "2CH.36.9"
                ]
              }
            }
          ]
        },
        {
          "text": "durattis waan hamaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Birraa keessas Nebukadnezar Mootichi nama itti ergee miʼoota mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.10",
                "verseOrgIds": [
                  "2CH.36.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kanneen gatii guddaa qaban wajjin gara Baabilon isa fichisiise; Zedeqiyaa obboleessa abbaa Yehooyaakiin sana immoo Yihuudaa fi Yerusaalem irratti mootii godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        }
      ]
    },
