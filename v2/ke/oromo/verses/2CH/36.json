              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Qiiros mootichi Faares akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
