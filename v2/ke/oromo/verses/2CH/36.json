    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooʼaahaaz yeroo mootii taʼetti umuriin isaa waggaa digdamii sadii ture; innis Yerusaalem keessa taaʼee jiʼa sadii bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Gibxi immoo Yerusaalem keessatti teessoo isaa irraa isa buuse; Yihuudaa irrattis gibira meetii taalaantii dhibba tokkoo fi warqee taalaantii tokko mure.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Gibxis Eliiyaaqiim obboleessa Yehooʼaahaaz Yihuudaa fi Yerusaalem irratti mootii godhe; innis maqaa Eliiyaaqiim geeddaree Yehooyaaqiim jedheen. Nekkoonis Yoʼahaz obboleessa Eliiyaaqiim fuudhee Gibxitti geesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehooyaaqiim Mooticha Yihuudaa",
          "type": "text"
        }
      ]
    },
    {
