                "verseOrgIds": [
                  "2CH.36.22"
                ]
              }
            }
          ]
        },
        {
          "text": "akka dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.22",
                "verseOrgIds": [
                  "2CH.36.22"
                ]
              }
            }
          ]
        },
        {
          "text": "kan afaan Ermiyaasiin dubbatame sun raawwatamuuf jedhee bara Qiiros mooticha Faares keessa waggaa jalqabaatti akka inni mootummaa isaa hunda keessa labsii tokko dabarsuu fi akka labsiin sunis barreeffamuuf hafuura Qiiros mooticha Faares ni kakaase; labsiin sunis akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
