          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedeqiyaa yeroo mootii taʼetti nama waggaa digdamii tokkoo ture; innis Yerusaalem keessa taaʼee waggaa kudha tokko bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.12",
                "verseOrgIds": [
                  "2CH.36.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa duratti waan hamaa ni hojjete; fuula Ermiyaas raajicha dubbii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.12",
                "verseOrgIds": [
                  "2CH.36.12"
                ]
              }
            }
          ]
        },
        {
          "text": "isatti dubbate sanaa durattis gad of hin qabne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas Nebukadnezar Mooticha maqaa Waaqaatiin isa kakachiisee turetti illee ni fincile. Inni mataa jabaatee gara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.13",
                "verseOrgIds": [
                  "2CH.36.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼelitti deebiʼuu ni dide.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana malees dura buutonni lubootaa hundii fi uummanni wantoota jibbisiisoo saboota kaanii hunda duukaa buʼuu fi mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.14",
                "verseOrgIds": [
                  "2CH.36.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kan inni Yerusaalem keessatti qulqulleesse sana xureessuudhaan ittuma caalchisanii amanamummaa dhaban.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufaatii Yerusaalem",
          "type": "text"
        }
      ]
    },
