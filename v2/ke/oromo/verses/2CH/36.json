            "sid": "2CH 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis sabni biyya sanaa Yehooʼaahaaz ilma Yosiyaas fuudhanii Yerusaalem keessatti iddoo abbaa isaa buusanii mootii isa godhan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        }
      ]
    },
    {
