  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "2CH 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Yehooshaafaax mootiin Yihuudaa nagaadhaan gara masaraa isaa Yerusaalemitti deebiʼetti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.1",
            "verseOrgIds": [
              "2CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehuun raajichi ilmi Hanaanii sun isa simachuuf baʼee akkana isaan jedhe; \"Ati nama hamaa gargaaruu fi warra",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.2",
            "verseOrgIds": [
              "2CH.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.2",
                "verseOrgIds": [
                  "2CH.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": "jibban jaallachuu qabdaa? Kanaafuu dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.2",
            "verseOrgIds": [
              "2CH.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.2",
                "verseOrgIds": [
                  "2CH.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sitti dhufeera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.2",
            "verseOrgIds": [
              "2CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus waan ati siidaawwan Aasheeraa barbadeessitee fi sababii garaan kee Waaqa barbaaduudhaaf qophaaʼaa taʼeef wanni gaariin si biratti argameera.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehooshaafaax Abbootii Murtii Muude",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshaafaax Yerusaalem keessa jiraate; innis Bersheebaadhaa hamma biyya gaaraa Efreemitti saba gidduu deemee akka isaan gara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.4",
            "verseOrgIds": [
              "2CH.19.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.4",
                "verseOrgIds": [
                  "2CH.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaaniitti deebiʼan godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.4",
            "verseOrgIds": [
              "2CH.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis biyya sana keessatti magaalaawwan Yihuudaa kanneen dallaa jabaa qaban hundatti abbootii murtii muude.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.5",
            "verseOrgIds": [
              "2CH.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkanas jedheen; \"Waan hojjettan qalbeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.6",
            "verseOrgIds": [
              "2CH.19.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.6",
                "verseOrgIds": [
                  "2CH.19.6"
                ]
              }
            }
          ]
        },
        {
          "text": "isa yeroo isin murtii kennitanitti isin wajjin jiru sanaaf jettaniiti malee namaaf jettanii murtii hin kennitaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.6",
            "verseOrgIds": [
              "2CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.7",
                "verseOrgIds": [
                  "2CH.19.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuun isin keessa haa jiraatu. Sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.7",
                "verseOrgIds": [
                  "2CH.19.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenya bira dabni yookaan wal caalchisuun yookaan mattaʼaa fudhachuun hin jirreef of eeggannaadhaan murtii kennaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshaafaax akkasumas Yerusaalem keessatti akka isaan seera",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.8",
                "verseOrgIds": [
                  "2CH.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "eegsisanii dubbii wal dhabiisaatiif illee araara buusaniif Lewwota, lubootaa fi hangafoota maatiiwwan Israaʼel tokko tokko muude. Isaanis Yerusaalem keessa jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee isaan ajaje; \"Isin amanamummaa fi garaa guutuun",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.9",
                "verseOrgIds": [
                  "2CH.19.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachaa tajaajiluu qabdu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Himatawwan namoota biyya keessanii kanneen magaalaa keessa jiraatan irraa waaʼee dhiiga dhangalaasuu yookaan waaʼee seeraa, waaʼee ajajawwanii, waaʼee labsii yookaan qajeelcha diduu irratti gara keessan dhufan, akka isaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.10",
                "verseOrgIds": [
                  "2CH.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": "cubbuu hin hojjenneef akeekkachiisaa. Yoo kanaa achii dheekkamsi isaa isinii fi obboloota keessanitti ni dhufaa. Waan kana godhaa; isinis cubbuu hin hojjettan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waan kan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.11",
                "verseOrgIds": [
                  "2CH.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": "taʼe kam irratti iyyuu Amariyaan lubichi hangafti, waan kan mootii taʼe kam irratti iyyuu Zebaadiyaan ilmi Ishmaaʼeel hoogganaan gosa Yihuudaa isin irratti muudamaniiru; Lewwonni immoo qondaaltota taʼanii fuula keessan dura ni tajaajilu. Jabaadhaa hojjedhaa;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.19.11",
                "verseOrgIds": [
                  "2CH.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": "warra waan gaarii hojjettan wajjin haa jiraatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        }
      ]
    }
  ],
