    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis Yerusaalem keessatti iddoo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.1",
                "verseOrgIds": [
                  "2CH.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "abbaa isaa Daawititti mulʼatetti Tulluu Mooriyaa irratti mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.1",
                "verseOrgIds": [
                  "2CH.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ijaaruu jalqabe. Iddoon kunis iddoo Daawit oobdii Ornaa namicha gosa Yebuus sanaa irratti qopheessee dha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis bara mootummaa isaa keessa waggaa afuraffaatti, bultii lammaffaa jiʼa lammaffaatti ijaaruu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis mana qulqullummaa Waaqaa ijaaruudhaaf jedhee hundee dheerinni isaa akka safartuu duriitti dhundhuma jaatama taʼee dhundhuma digdama balʼatu ni buuse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gardaafoon fuula mana qulqullummaa dura tures lafa irra dheerinni isa akkuma balʼina mana qulqullummaatti dhundhuma digdama, ol dheerinni isaa immoo dhundhuma dhibba tokkoo fi digdama ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 3:4"
      },
      "items": [
        {
          "text": "Innis keessa manichaatti warqee qulqulluu uffise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutaa guddaa mana sanaattis muka birbirsaa maxxansee warqee qulqulluu itti uffise; fakkii meexxiitii fi foncaatiinis ni miidhagse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana qulqullummaa sanas dhagaawwan gati jabeeyyiitiin ni bareeche. Warqeen inni itti fayyadames warqee Farwaayim ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis dareeraawwan, michichilawwan balbalaa, dhaaba manaatii fi cufaawwan mana qulqullummaatti warqee uffise; keenyan manaa sana irrattis fakkii Kiirubeelii soofe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Iddoo Iddoo Hunda Caalaa Qulqulluu taʼe ijaare; lafa irra dheerinni iddoo sanaas balʼina mana qulqullummaatiin wal qixxee taʼee dheerinni isaa dhundhuma digdama, balʼinni isaa immoo dhundhuma digdama ture. Keessa isaa illee warqee qulqulluu taalaantii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "text": "dhibba jaʼa itti uffise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mismaaronni warqees saqilii shantama ulfaatu ture. Kutaawwan ol aananittis akkasumas warqee uffise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo Iddoo Hunda Caalaa Qulqulluu taʼe keessatti kiirubeelii lama hojjechiisee warqee itti uffise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoochoon kiirubeelii lamaanii walumatti dhundhuma digdama ture. Qoochoon kiirubii jalqabaa tokkichi dhundhuma shan dheeratee keenyan mana qulqullummaa tuqa; qoochoon isaa kaan immoo dhundhuma shan dheeratee Qoochoon kiirubii lammaffaa tuqa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas qoochoon kiirubii lammaffaa inni tokko dhundhuma shan dheeratee gama kaaniin keenyan mana qulqullummaa tuqa; qoochoon isaa kaan immoo dhundhuma shan dheeratee qoochoo kiirubii jalqabaa sanaa tuqa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoochoowwan kiirubeelii kanneenii dhundhuma digdamii shan diriirfaman. Kiirubeeliin kunneenis fuula isaanii gara galma guddichaatti deebifatanii miilla isaaniitiin dhaabatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis kirrii bifa cuquliisaa, dhiilgee, bildiimaa fi quncee talbaa haphii irraa golgaa hojjetee fakkii kiirubeelii isa irratti tolche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis fuula mana qulqullummaa duratti utubaawwan lama kanneen walumatti dhundhuma soddomii shan dheeratan tolche; tokkoon tokkoon isaaniis guutuu dhundhuma shan dheeratu mataa irraa qabu turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Foncaa wal keessa loofames hojjetee mataa utubaawwanii irra kaaʼe. Akkasumas roomaanoota dhibba tokko hojjetee foncaa sanatti qabsiise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis utubaawwan sana tokko karaa kibbaatiin kaan immoo karaa kaabaatiin fuula mana qulqullummaa dura dhadhaabe. Utubaa karaa kibbaatiin Yaakiin kan karaa kaabaatiin immoo Boʼeez jedhee moggaase.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
      ]
    }
  ],
