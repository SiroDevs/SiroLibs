  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JOS 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gosoonni Gara Baʼa Biiftuu Biyyatti Deebiʼan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Iyyaasuun gosa Ruubeen, gosa Gaadii fi walakkaa gosa Minaasee walitti waamee",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkana jedheen; \"Isin waan Museen garbichi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.2",
                "verseOrgIds": [
                  "JOS.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ajaje hundumaa hojjettaniirtu; waan ani isin ajaje hundas naa ajajamtaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin bara dheeraaf, hamma harʼaatti illee obboloota keessan hin daganne; ajaja",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.3",
                "verseOrgIds": [
                  "JOS.22.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan isinii kennes eegdaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.4",
                "verseOrgIds": [
                  "JOS.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan akkuma waadaa gale sanatti obboloota keessan boqochiiseera; isin biyya Museen garbichi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.4",
                "verseOrgIds": [
                  "JOS.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Yordaanos gamaa isinii kenne sanatti gara mana keessaniitti deebiʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.5",
                "verseOrgIds": [
                  "JOS.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan jaallattaniif, akka karaa isaa hunda irra deemtaniif, akka ajajawwan isaa eegdaniif, akka isatti maxxantanii fi akka garaa keessan guutuu fi lubbuu keessan guutuudhaan isa tajaajiltaniif ajajaa fi seera Museen garbichi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.5",
                "verseOrgIds": [
                  "JOS.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "isinii kenne sana jabeessaa eegaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Iyyaasuun eebbisee gad isaan dhiise; isaanis gara mana isaaniitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.6",
            "verseOrgIds": [
              "JOS.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen walakkaa gosa Minaaseetiif Baashaan keessaa lafa kennee ture; Iyyaasuun immoo walakkaa kaaniif Yordaanosiin gama lixaatti obboloota isaanii cinatti lafa kenne. Iyyaasuun yommuu gara mana isaaniitti isaan ergetti isaan eebbise;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.7",
            "verseOrgIds": [
              "JOS.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkanas jedheen; \"Qabeenya keessan guddaa jechuunis horii baayʼee, meetii, warqee, naasii fi sibiila akkasumas uffata baayʼee fudhadhaa galaatii boojuu diinota keessan irraa boojitan sana obboloota keessan wajjin qooddadhaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.8",
            "verseOrgIds": [
              "JOS.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu gosti Ruubeen, gosti Gaadii fi walakkaan gosa Minaasee gara biyya ofii isaanii gara Giliʼaad ishee akkuma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.9",
                "verseOrgIds": [
                  "JOS.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Museetiin ajajetti argatan sanaatti deebiʼuuf jedhanii Shiiloo ishee Kanaʼaan keessaa sanatti Israaʼeloota dhiisanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Ruubeen, gostii Gaadii fi walakkaan gosa Minaasee yommuu Galiilooti biyya Kanaʼaan keessaa kan Yordaanos biraa sana gaʼanitti, iddoo aarsaa guddaa isaa Yordaanos biratti tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.10",
            "verseOrgIds": [
              "JOS.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni yommuu akka isaan gama Israaʼelootaatiin daarii Kanaʼaan irratti Galiilooti ishee Yordaanos cinaa sanatti iddoo aarsaa tolchan dhagaʼanitti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.11",
            "verseOrgIds": [
              "JOS.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "guutummaan waldaa Israaʼel isaanitti duuluuf Shiilootti walitti qabaman.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Israaʼeloonni Fiinehaas ilma Eleʼaazaar lubichaa sana gara gosa Ruubeen, gosa Gaadii fi gara walakkaa gosa Minaasee warra Giliʼaad keessa jiraatanitti ergan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.13",
            "verseOrgIds": [
              "JOS.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isa wajjinis hangafoota kudhan, tokkoo tokkoo gosa Israaʼeliif nama tokko ergan; tokkoon tokkoon isaaniis hangafa balbala maatii Israaʼel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Giliʼaaditti gosa Ruubeen, gosa Gaadii fi walakkaa gosa Minaasee bira dhufanii akkana isaaniin jedhan:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.15",
            "verseOrgIds": [
              "JOS.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Guutummaan waldaa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.16",
                "verseOrgIds": [
                  "JOS.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: 'Isin akkamitti akkanaan amanamummaa Waaqa Israaʼel wajjin qabdan sana cabsitu? Isin akkamitti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.16",
                "verseOrgIds": [
                  "JOS.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa garagaltanii isatti finciluudhaan ofii keessaniif iddoo aarsaa tolfattu?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cubbuun Pheʼoor keessatti hojjetame sun nu hin gaʼuu? Dhaʼichi saba",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.17",
                "verseOrgIds": [
                  "JOS.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": "irra buʼu iyyuu, nu hamma harʼaatti cubbuu sana irraa of hin qulqulleessine.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin ammas",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.18",
                "verseOrgIds": [
                  "JOS.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa garagaluu keessanii?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 22:18"
      },
      "items": [
        {
          "text": "\" 'Yoo isin harʼa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.18",
                "verseOrgIds": [
                  "JOS.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "finciltan inni immoo bori hawaasa Israaʼel hundatti ni dheekkama.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo lafti isin qabattan sun xuroofte, gara lafa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "iddoo dunkaanni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "dhaabatuu kottaatii nu wajjin lafa qoodadhaa. Garuu iddoo aarsaa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaa malee iddoo aarsaa biraa ofii keessanii tolfattanii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "yookaan nutti hin fincilinaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Aakaan ilmi Zaaraa waan dhowwamaa taʼe fudhachuudhaan cubbuu hojjetetti waldaa Israaʼel hundatti dheekkamsi hin dhufnee? Namni sababii cubbuu isaatiin duʼe isa qofa miti.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti gosti Ruubeen, gosti Gaadii fi walakkaan gosa Minaasee akkana jedhanii hangafoota maatiiwwan Israaʼeliif deebisan;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.21",
            "verseOrgIds": [
              "JOS.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni waaqotaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni waaqotaa ni beeka! Israaʼelis haa beeku! Yoo wanni kun",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "finciluuf yookaan isaa ajajamuu diduuf taʼe harʼa nu hin hambisin.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo nu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.23",
                "verseOrgIds": [
                  "JOS.22.23"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa deebiʼuuf jennee, aarsaa gubamuu fi kennaa midhaanii, yookaan aarsaa nagaa achi irratti dhiʼeessuuf iddoo aarsaa ofii keenyaa tolfannee jiraanne,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.23",
                "verseOrgIds": [
                  "JOS.22.23"
                ]
              }
            }
          ]
        },
        {
          "text": "mataan isaa itti nu haa gaafatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sababiin nu waan kana gooneef ijoolleen keessan gara fuula duraatti ijoollee keenyaan akkana jedhu taʼa jennee sodaannee ti; 'Isin",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.24",
                "verseOrgIds": [
                  "JOS.22.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼel irraa maali qabdu?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "nuu fi isin jechuunis isin gosa Ruubeenii fi gosa Gaad gidduu Yordaanos daarii godhee dhaabeera! Isin",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa qooda tokko illee hin qabdan.' Kanaafuu ijoolleen keessan akka ijoolleen keenya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuu dhiisan godhu taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sababiin nu, 'Kottaa qophoofnee iddoo aarsaa tokko tolfannaa; garuu iddoon aarsaa kun kan aarsaan gubamu yookaan qalmi irratti dhiʼeeffamuu miti' jenneefis kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.26",
            "verseOrgIds": [
              "JOS.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa biraa immoo akka iddoon aarsaa kun akka nu aarsaa keenya kan gubamu, qalma keenyaa fi aarsaa nagaatiin iddoo qulqulluu isaatti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.27",
                "verseOrgIds": [
                  "JOS.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "waaqeffannuuf nu, isinii fi dhaloota dhufu gidduutti dhugaa baatuu taʼuuf. Kana booddee ijoolleen keessan ijoollee keenyaan, 'Isin",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.27",
                "verseOrgIds": [
                  "JOS.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa qooda tokko illee hin qabdan' jechuu hin dandaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nus akkana jenne; 'Yoo isaan baroota dhufuuf jiran keessa nuun yookaan dhaloota keenyaan akkas jedhan, mee fakkii iddoo aarsaa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.28",
                "verseOrgIds": [
                  "JOS.22.28"
                ]
              }
            }
          ]
        },
        {
          "text": "kan abbootiin keenya aarsaa gubamu yookaan qalma irratti dhiʼeessuuf utuu hin taʼin akka inni nuu fi isin gidduutti dhuga baatuu taʼuuf tolchan kana ilaalaa jennaan.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iddoo aarsaa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.29",
                "verseOrgIds": [
                  "JOS.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaa kan dunkaana isaa qulqulluu dura dhaabatu sana malee harʼa iddoo aarsaa kan aarsaan gubamu, kennaan midhaaniitii fi qalmi irratti dhiʼeeffamu kan biraa tolchuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.29",
                "verseOrgIds": [
                  "JOS.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "fincillee isa irraa garagaluun nurraa haa fagaatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiinehaas lubichi, qajeelchitoonni sabaatii fi hangafoonni maatiiwwan Israaʼel yommuu waan gosti Ruubeen, gosti Gaadii fi gosti Minaasee jedhan dhagaʼanitti ni gammadan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiinehaas ilmi Eleʼaazaar lubichaas ijoollee Ruubeeniin, ijoollee Gaadii fi ilmaan Minaaseetiin, \"Nu harʼa sababii isin waan kana keessatti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.31",
                "verseOrgIds": [
                  "JOS.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "amanamummaa hin dhiisiniif akka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.31",
                "verseOrgIds": [
                  "JOS.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "nu wajjin jiru beekneerra. Isin amma Israaʼeloota harka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.31",
                "verseOrgIds": [
                  "JOS.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "jalaa baaftaniirtu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Fiinehaas ilmi Eleʼaazaar lubichaa fi qajeelchitoonni sun ijoollee Ruubeenii fi ijoollee Gaad wajjin Giliʼaaditti wal gaʼii godhatanii gara Kanaʼaanitti deebiʼanii oduu achii fidan Israaʼelootatti himan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
