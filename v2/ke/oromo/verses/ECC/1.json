        },
        {
          "text": "Anis akkana jedheen yaade; \"Kunoo, ani nama anaan dura Yerusaalemin bulchaa ture kam iyyuu caalaa guddadhee ogummaas dabaladheera; ani muuxannoo ogummaatii fi beekumsaa guddaa argadheera.\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
