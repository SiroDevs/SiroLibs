  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ECC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wanti Hundinuu Faayidaa Hin qabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbii lallabaa ilma Daawit, isa Yerusaalem keessaatti mootii taʼe sanaa:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lallabichi, \"Faayidaa hin qabu!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "Faayidaa hin qabu!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "Guutumaan guutuutti faayidaa hin qabu!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "Wanni hundinuu faayidaa hin qabu\" jedha.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hojii isaa kan aduudhaa gaditti",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:3"
      },
      "items": [
        {
          "text": "itti dadhabu hunda keessaa, buʼaa maalii argata?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaloonni ni dhufa; dhaloonni ni darba;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:4"
      },
      "items": [
        {
          "text": "lafti garuu bara baraan jiraatti.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biiftuun ni baati; biiftuun ni lixxi;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:5"
      },
      "items": [
        {
          "text": "gara baate sanatti deebiʼuufis ni ariifatti.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bubbeen gara kibbaatti bubbisa;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "gara kaabaattis ni deebiʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "innis naannaʼuma naannaʼee deema;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "karaa isaa irras deddeebiʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagni hundi galaanatti yaaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "galaanni garuu hin guutu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "Lageen garuma dhufanitti",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "deebiʼanii yaaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni hundinuu hamma namni tokko",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "dubbachuu dandaʼu caalaa dadhabsiisaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "Iji argee hin quufu;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "yookaan gurri dhagaʼee hin guutu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni duraan ture ammas ni taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:9"
      },
      "items": [
        {
          "text": "wanni duraan hojjetame ammas ni hojjetama;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:9"
      },
      "items": [
        {
          "text": "aduudhaa gaditti wanni haaraan tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni namni tokko, \"Ilaa! Wanni kun haaraa dha\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "jechuu dandaʼu kam iyyuu jiraa?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "Wanni kun duraanuu bara dheeraan dura as ture;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "bara keenyaan dura iyyuu asuma ture.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni bara durii hin yaadataman;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "kanneen dhufuuf jiranis",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "warra isaan duubaan dhufaniin hin yaadataman.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogummaan Faayidaa Hin qabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani Lallabaan, Yerusaalem keessatti mootii Israaʼelin ture.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waan samii gaditti hojjetame hunda ogummaadhaan quʼadhee qoradhee bira gaʼuuf of kenneen ture. Waaqni baʼaa ulfaataa akkamii nama irra kaaʼe!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waan aduudhaa gaditti hojjetame hunda argeera; hundi isaanii iyyuu faayidaa hin qaban; kun akkuma nama bubbee ariʼuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni jalʼifame tokko deebiʼee hin qajeelfamu;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:15"
      },
      "items": [
        {
          "text": "wanni hin jirres lakkaaʼamuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
