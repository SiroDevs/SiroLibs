            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani ogummaa, maraatummaa fi gowwummaa hubachuufin of kenne; garuu ani akka wanni kunis bubbee ariʼuu taʼe nan baradhe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
