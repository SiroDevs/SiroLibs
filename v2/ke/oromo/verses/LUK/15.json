        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Hoolaa Badee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
