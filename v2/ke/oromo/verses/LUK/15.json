      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko warri qaraxa fuudhanii fi cubbamoonni hundi Yesuusin dhaggeeffachuudhaaf isa biratti walitti qabamaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.1",
            "verseOrgIds": [
              "LUK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnii fi barsiistonni seeraa garuu, \"Namichi kun cubbamoota simata; isaan wajjinis ni nyaata\" jedhanii guunguman.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedhee fakkeenya kana isaanitti hime;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.3",
            "verseOrgIds": [
              "LUK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin keessaa namni hoolota dhibba qabu tokko yoo hoolaan tokko jalaa bade, hoolota sagaltamii sagallan kaan lafa tikaatti dhiisee hamma hoolaa bade sana argatutti kan barbaaduu hin deemne eenyu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.4",
                "verseOrgIds": [
                  "LUK.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.4",
            "verseOrgIds": [
              "LUK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yommuu argatus gammadee gatiittii isaa irratti baatee,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.5",
                "verseOrgIds": [
                  "LUK.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.5",
            "verseOrgIds": [
              "LUK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mana isaatti gala. Innis michoota isaatii fi olloota isaa walitti waamee, 'Ani hoolaa koo kan bade sana argadheeraatii na wajjin gammadaa' jedha.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.6",
                "verseOrgIds": [
                  "LUK.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.6",
            "verseOrgIds": [
              "LUK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani isinittin hima; sababii qajeeltota qalbii jijjiirrachuun isaan hin barbaachifne sagaltamii sagalii irra sababii cubbamaa qalbii jijjiirratu tokkootiif samii keessatti gammachuun guddaan akkasuma ni taʼa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.7",
                "verseOrgIds": [
                  "LUK.15.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Saantima Badee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yookaan mee dubartii saantima meetii kudhan qabdu jalaa tokko badeera haa jennuu; isheen ibsaa qabsiifattee, manas hartee hamma saantima sana argatutti jabeessitee hin barbaaddattuu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.8",
                "verseOrgIds": [
                  "LUK.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.8",
            "verseOrgIds": [
              "LUK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isheenis yommuu argatutti michoota isheetii fi olloota ishee walitti waamtee, 'Ani saantima koo kan bade sana argadheeraatii na wajjin gammadaa' jetti.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.9",
                "verseOrgIds": [
                  "LUK.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.9",
            "verseOrgIds": [
              "LUK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani isinittin hima; sababii cubbamaa qalbii jijjiirratu tokkootiif ergamoonni Waaqaa akkasuma ni gammadu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.10",
                "verseOrgIds": [
                  "LUK.15.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Ilma Badee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus ittuma fufee akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.11",
            "verseOrgIds": [
              "LUK.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namicha ilmaan lama qabu tokkotu ture.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.11",
                "verseOrgIds": [
                  "LUK.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.11",
            "verseOrgIds": [
              "LUK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ilmi quxisuun abbaa isaatiin 'Yaa abbaa ko, qabeenya kee irraa qooda na gaʼu naa kenni' jedhe. Abbaanis qabeenya isaa lamaan isaaniitiif ni hire.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.12",
                "verseOrgIds": [
                  "LUK.15.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ilmi quxisuun sunis utuu hin turin waan qabu hunda walitti qabatee biyya fagoo dhaqe; achittis qabeenya isaa jireenya bashannanuu irratti balleesse.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.13",
                "verseOrgIds": [
                  "LUK.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.13",
            "verseOrgIds": [
              "LUK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Erga inni waan hunda fixee booddee beelli hamaan biyya sanatti buʼe; innis rakkachuu jalqabe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.14",
                "verseOrgIds": [
                  "LUK.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.14",
            "verseOrgIds": [
              "LUK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaafuu dhaqee lammiiwwan biyyasii keessaa isa tokkotti gale; namichi sunis akka inni booyyee tiksuuf lafa tikaatti isa erge.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.15",
                "verseOrgIds": [
                  "LUK.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.15",
            "verseOrgIds": [
              "LUK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gurbichis qola booyyeen nyaattu sana nyaatee garaa guutachuu kajeela ture; garuu namni tokko iyyuu waa isatti hin kennu ture.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.16",
                "verseOrgIds": [
                  "LUK.15.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Innis yommuu of beeketti akkana jedhe; 'Tajaajiltoonni mana abbaa kootti qacaraman hammamitu buddeena gaʼee irraa hafu qaba! Ani garuu asitti beelaan nan duʼa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.17",
                "verseOrgIds": [
                  "LUK.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.17",
            "verseOrgIds": [
              "LUK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani kaʼeen abbaa kootti deebiʼee akkana jedhaan; \"Yaa abbaa ko, ani samii fi sitti cubbuu hojjedheera.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.18",
                "verseOrgIds": [
                  "LUK.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.18",
            "verseOrgIds": [
              "LUK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Siʼachi ilma kee jedhamuun naaf hin malu; tajaajiltoota kee keessaa akka isa tokkootti na ilaali.\" '",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.19",
                "verseOrgIds": [
                  "LUK.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.19",
            "verseOrgIds": [
              "LUK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Innis kaʼee gara abbaa isaa dhaqe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.20",
                "verseOrgIds": [
                  "LUK.15.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 15:20"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Garuu utuu inni fagoo jiruu abbaan isaa isa argee akka malee garaa laafeef; gara ilma isaattis fiigee itti marmee dhungate.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.20",
                "verseOrgIds": [
                  "LUK.15.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
