              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Abbaan isaas akkana jedheen; 'Yaa ilma koo ati yeroo hunda anuma wajjin jirta; wanni ani qabu hundinuus kanuma kee ti.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.31",
                "verseOrgIds": [
                  "LUK.15.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
              "LUK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garuu obboleessi kee inni duʼee ture kun waan jireenyatti deebiʼeef nu gammaduu fi ililchuu qabna. Inni badee ture; amma immoo argameera.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.32",
                "verseOrgIds": [
                  "LUK.15.32"
                ]
              }
            }
