              "text": "15:4‑7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MAT.18.12-MAT.18.14"
              },
