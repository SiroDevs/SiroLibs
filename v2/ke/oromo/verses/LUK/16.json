              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Abrahaamis, 'Isaan yoo Musee fi raajota hin dhageenye, yoo namni tokko warra duʼan keessaa kaʼe illee hin amanan' jedheen.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.31",
                "verseOrgIds": [
