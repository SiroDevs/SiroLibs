              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Innis hambaa maaddii sooressa sanaa irraa harcaʼu illee nyaachuu ni kajeela ture; saroonni iyyuu dhufanii madaa isaa arraabu turan.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.21",
                "verseOrgIds": [
                  "LUK.16.21"
                ]
              }
            }
          ]
        }
