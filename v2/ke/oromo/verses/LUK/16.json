        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Karra isaa dura immoo namichi hiyyeessi Alʼaazaar jedhamu kan dhagni isaa hundi mammadaaʼe tokko ciisaa ture.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.20",
                "verseOrgIds": [
