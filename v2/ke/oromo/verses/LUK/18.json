      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 18:41"
      },
      "items": [
        {
          "text": "Namichis, \"Yaa Gooftaa, ani arguun barbaada\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.41",
            "verseOrgIds": [
              "LUK.18.41"
            ]
