        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akka ani maal siif godhu barbaadda?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.41",
                "verseOrgIds": [
                  "LUK.18.41"
                ]
              }
