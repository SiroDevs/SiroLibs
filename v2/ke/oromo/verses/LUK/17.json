        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ilmi Namaa guyyaa isaatti akkuma balaqqeessi balaqqeessaʼee gama tokkoo hamma gama kaaniitti samii ibsuu ni taʼaatii.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.24",
                "verseOrgIds": [
