        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inni garuu duraan dursee akka malee dhiphachuu fi dhaloota kanaan tuffatamuu qaba.",
