        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dubartoonni lama walii wajjin midhaan daaku; isheen tokko ni fudhatamti; kaan immoo ni hafti.",
