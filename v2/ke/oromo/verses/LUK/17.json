        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Hamma gaafa Nohi doonii seeneetti namoonni nyaachaa, dhugaa, fuudhaa, heerumaas turan. Bishaan badiisaas dhufee hunda isaanii balleesse.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.27",
                "verseOrgIds": [
