    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnis mootummaan Waaqaa yoom akka dhufu Yesuusin gaafatan; innis akkana jedhee deebiseef;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mootummaan Waaqaa namatti mulʼachaa hin dhufu;",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.20",
                "verseOrgIds": [
                  "LUK.17.20"
                ]
