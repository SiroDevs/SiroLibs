        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bara Looxis akkasuma ture; namoonni nyaachaa, dhugaa, bitachaa, gurgurachaa, biqiltuu dhaabbachaa, manas ijaarrachaa turan.",
