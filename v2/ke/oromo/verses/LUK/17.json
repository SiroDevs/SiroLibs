{
  "id": "LUK.17",
  "number": "17",
  "bookId": "LUK",
  "reference": "Luqaas 17",
  "copyright": "Biblica® Hiikkaa Ammayyaa Banamaa Haaraa™, Loqoda Dhiʼaa Mirgi seeraan eegama © 2022 Biblica, Inc. Biblica® Open New Oromo Contemporary Version™, Western Copyright © 2022 by Biblica, Inc. \"Biblica\" jechuun mallattoo eenyummaa kan Biblica, Inc., Waajjira Eeyyamaa fi Mallattoo Eenyummaa kan Ameerikaa keessaatti galmeessee dha. Eeyyamaan itti fayyadamu. \"Biblica\" is trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "LUK 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cubbuu, Amantii, Dirqama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus barattoota isaatiin akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wantoonni akka namoonni gufatan godhan dhufuun hin oolu; garuu nama wantoonni kunneen karaa isaatiin dhufaniif wayyoo!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.1",
                "verseOrgIds": [
                  "LUK.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inni warra xixinnaa kanneen keessaa tokko illee gufachiisuu mannaa dhagaan daakuu morma isaatti hidhamee galaanatti utuu darbatamee isaa wayya ture.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.2",
                "verseOrgIds": [
                  "LUK.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.2",
            "verseOrgIds": [
              "LUK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaafuu of eeggadhaa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.3",
                "verseOrgIds": [
                  "LUK.17.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yoo obboleessi kee yakka sitti hojjete isa ifadhu; yoo inni qalbii jijjiirrate immoo dhiifama godhiif.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.3",
                "verseOrgIds": [
                  "LUK.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.3",
            "verseOrgIds": [
              "LUK.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo inni guyyaa tokkotti yeroo torba cubbuu sitti hojjetee yeroo torbanuu sitti deebiʼee, 'Ani qalbii nan jijjiirradha' siin jedhe dhiifama godhiif.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.4",
                "verseOrgIds": [
                  "LUK.17.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamoonnis Gooftaadhaan, \"Amantii keenya nuu guddisi\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.5",
            "verseOrgIds": [
              "LUK.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee deebise;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.6",
            "verseOrgIds": [
              "LUK.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin amantii xinnoo hamma ija sanaaficaa illee yoo qabaattan, muka qilxuu kanaan, 'Buqqaʼiitii galaana keessa dhaabami!' jechuu dandeessu; innis isinii ajajama.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.6",
                "verseOrgIds": [
                  "LUK.17.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin keessaa namni tokko garbicha lafa qotu yookaan kan hoolota tiksu qaba haa jennu; inni yeroo garbichi sun alaa galutti, 'Dafii kottuutii taaʼii waa nyaadhu' jedhaanii?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.7",
                "verseOrgIds": [
                  "LUK.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.7",
            "verseOrgIds": [
              "LUK.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Qooda kanaa inni garbicha sanaan, 'Irbaata naa qopheessi; hamma ani nyaadhee dhugutti marxifadhuutii na tajaajili; sana booddee ati ni nyaattaa; ni dhugdas' hin jedhuunii?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.8",
                "verseOrgIds": [
                  "LUK.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.8",
            "verseOrgIds": [
              "LUK.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namichis sababii garbichi sun waan ajajame sana raawwateef isa ni galateeffataa?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.9",
                "verseOrgIds": [
                  "LUK.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.9",
            "verseOrgIds": [
              "LUK.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaafuu isinis yommuu waan ajajamtan hunda raawwattanitti, 'Nu garboota faayidaa hin qabnee dha; waanuma hojjechuu qabnu qofa hojjenne' jedhaa.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.10",
                "verseOrgIds": [
                  "LUK.17.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lamxaaʼonni Kudhan Fayyuu Isaanii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus utuu Yerusaalem dhaquu Samaariyaa fi Galiilaa gidduu darbaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.11",
            "verseOrgIds": [
              "LUK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma inni ganda tokko seeneenis, namoonni lamxaaʼan kudhan isatti dhufan. Isaanis fagoo dhadhaabatanii,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.12",
            "verseOrgIds": [
              "LUK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "sagalee isaanii ol fudhatanii, \"Yesuus yaa Gooftaa, nuu naʼi!\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.13",
            "verseOrgIds": [
              "LUK.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yommuu isaan argetti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dhaqaatii lubootatti of argisiisaa!\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.14",
                "verseOrgIds": [
                  "LUK.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen; isaanis utuma deemaa jiranuu qulqullaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaas inni tokko yommuu fayyuu isaa argetti sagalee guddaadhaan Waaqaaf ulfina kennaa deebiʼee dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.15",
            "verseOrgIds": [
              "LUK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adda isaatiinis miilla Yesuus irratti gombifamee isa galateeffate; innis nama Samaariyaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.16",
            "verseOrgIds": [
              "LUK.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedhee gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kurnanuu qulqullaaʼaniiru mitii? Yoos warri hafan sagallan eessa dhaqan?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.17",
                "verseOrgIds": [
                  "LUK.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nama ormaa kana malee namni deebiʼee Waaqaaf galata galchu tokko iyyuu hin argamnee?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.18",
                "verseOrgIds": [
                  "LUK.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.18",
            "verseOrgIds": [
              "LUK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.19",
            "verseOrgIds": [
              "LUK.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaʼii deemi; amantiin kee si fayyiseeraatii\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.19",
                "verseOrgIds": [
                  "LUK.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.19",
            "verseOrgIds": [
              "LUK.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhufaatii Mootummaa Waaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
