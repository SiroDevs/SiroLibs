        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akkuma bara Nohi taʼe sana, yeroo Ilma Namaattis akkasuma ni taʼa.",
