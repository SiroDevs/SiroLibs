        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani isinittin hima; halkan sana namoonni lama siree tokko irra ni rafu; inni tokko ni fudhatama; kaan immoo ni hafa.",
