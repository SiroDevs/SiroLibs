          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "namoonnis, 'Mootummaan Waaqaa kunoo as jira' yookaan 'Kuunnoo achi jira' hin jedhan; mootummaan Waaqaa isin gidduu jiraatii.\"",
              "type": "text",
              "attrs": {
