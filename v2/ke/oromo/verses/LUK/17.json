        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namoonni, 'Inni kuunnoo achi jira!' yookaan 'Kunoo as jira' isiniin jedhu; isin garuu hin dhaqinaa; isaan duukaas hin buʼinaa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.23",
                "verseOrgIds": [
                  "LUK.17.23"
                ]
              }
            }
