        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Guyyaa sana namni bantii manaa irra jiru kan mana keessaa miʼa qabu miʼa sana fudhachuuf gad buʼuu hin malu. Akkasuma immoo namni lafa qotiisaa keessa jiru tokko iyyuu waan tokkoof illee manatti hin deebiʼin.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.31",
