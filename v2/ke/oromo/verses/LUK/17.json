        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni lubbuu isaa eeggachuu yaalu kam iyyuu lubbuu isaa ni dhaba; namni lubbuu isaa dhabu kam iyyuu lubbuu isaa ni turfata.",
              "type": "text",
              "attrs": {
