            "number": "1",
            "style": "v",
            "sid": "AMO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu Gooftaan iddoo aarsaa bira dhaabatuu nan arge; innis akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "\"Akka buusaawwan balbalaa raafamaniif",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "fiixee utubaa dhaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "Mataa nama hundaa irratti gad isaan harcaasi;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "warra hafe immoo anatu goraadeedhaan fixa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "Tokkoon isaanii iyyuu baqatanii hin baʼan;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "isaan keessaa namni tokko iyyuu hin miliqu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isaan boolla qilee qotatan iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "harki koo achii isaan fuudha.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "Yoo isaan samiitti ol baʼan iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "ani achii gad isaan nan buusa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isaan fiixee Qarmeloos irra",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "dhokatan iyyuu, ani achii adamsee qabee",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "gad isaan nan fida.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "Yoo isaan galaana jala na dhokatan iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "ani akka inni achitti isaan idduuf bofa itti nan ajaja.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo diinonni isaanii boojiʼanii isaan fudhatan,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "achitti goraadee isaan fixxu itti nan ajaja.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "AMO 9:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "\"Ani waan gaariidhaaf utuu hin taʼin",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "waan hamaadhaaf ija koo isaan irra nan buusa.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
