    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "isheenis ni baqxi;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
