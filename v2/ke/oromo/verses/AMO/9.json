          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.5",
                "verseOrgIds": [
                  "AMO.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu lafa ni tuqa;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
