            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa saba Israaʼel, dubbii",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.1",
                "verseOrgIds": [
                  "AMO.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "isiniin mormuudhaan, maatii ani biyya Gibxii baasee fide hundaan mormuudhaan dubbate kana dhagaʼaa:",
