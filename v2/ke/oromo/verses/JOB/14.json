  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JOB 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nama dubartoota irraa dhalate,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:1"
      },
      "items": [
        {
          "text": "barri isaa gabaabaa fi kan rakkinaan guutamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma daraaraa ni biqila; ni coollagas;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:2"
      },
      "items": [
        {
          "text": "akkuma gaaddidduu ariifatee darba malee hin turu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji kee nama akkasii xiyyeeffatee ilaalaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:3"
      },
      "items": [
        {
          "text": "Ati murtiif fuula kee duratti isa fiddaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eenyutu waan xuraaʼaa keessaa waan qulqullaaʼaa baasuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:4"
      },
      "items": [
        {
          "text": "Namni tokko iyyuu hin dandaʼu!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barri jireenya namaa murtaaʼaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:5"
      },
      "items": [
        {
          "text": "baayʼinni jiʼoota isaas si bira jira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:5"
      },
      "items": [
        {
          "text": "daangaa inni darbuu hin dandeenye daangessiteefii jirta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamma inni akka hojjetaa tokkootti bara isaa raawwatutti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:6"
      },
      "items": [
        {
          "text": "fuula kee isa irraa deebifadhu; isas dhiisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mukni illee abdii qaba:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:7"
      },
      "items": [
        {
          "text": "Yoo murame deebiʼee ni lata;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:7"
      },
      "items": [
        {
          "text": "dameen isaa haaraanis hin gogu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo gufuun isaa lafa keessatti dulloomee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:8"
      },
      "items": [
        {
          "text": "gufuun isaa biyyoo keessatti tortore iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "foolii bishaaniitiin lata;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:9"
      },
      "items": [
        {
          "text": "akka biqiltuuttis damee ni baafata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni garuu duʼee awwaalama;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:10"
      },
      "items": [
        {
          "text": "lubbuun isaa keessaa baati; innis hin jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma bishaan galaanaa gogu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:11"
      },
      "items": [
        {
          "text": "yookaan lagnis dhumee gogu sana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "namnis akkasuma ni ciisa; hin kaʼus;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "hamma samiiwwan darbanittis hin dammaqu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "yookaan hirribaa hin kaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Maaloo utuu awwaala keessa na dhoksitee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "hamma dheekkamsi kee darbutti na haguugdee!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "Maaloo utuu beellama naa kennitee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "ergasii immoo na yaadattee!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko yoo duʼe deebiʼee ni jiraataa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:14"
      },
      "items": [
        {
          "text": "Ani hamma haaromfamni koo dhufutti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:14"
      },
      "items": [
        {
          "text": "bara rakkoo koo hunda obsaan nan eeggadha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati na waamta; anis si jalaa nan owwaadha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
              "JOB.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:15"
      },
      "items": [
        {
          "text": "hojii harka keetiis ni hawwita.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
              "JOB.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sana ati tarkaanfii koo ni lakkoofta;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.16",
            "verseOrgIds": [
              "JOB.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:16"
      },
      "items": [
        {
          "text": "cubbuu koo garuu hin toʼattu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.16",
            "verseOrgIds": [
              "JOB.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
