  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "JOB 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliihuun ittuma fufee akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.1",
            "verseOrgIds": [
              "JOB.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani akka qooda Waaqaa wanni jedhamu hedduun jiru",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:2"
      },
      "items": [
        {
          "text": "sitti nan argisiisaatii mee xinnoo naa obsi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani beekumsa koo fagoodhaa nan fida;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:3"
      },
      "items": [
        {
          "text": "qajeelummaa Uumaa kootiis nan labsa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka dubbiin koo soba hin taʼin mirkaneeffadhu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:4"
      },
      "items": [
        {
          "text": "kan beekumsaan hirʼina hin qabne tokko si wajjin jira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waaqni jabaa dha; garuu eenyun iyyuu hin tuffatu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:5"
      },
      "items": [
        {
          "text": "inni jabaa dha; kaayyoo isaattis cimee dhaabata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hamoota hin jiraachisu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:6"
      },
      "items": [
        {
          "text": "warra rakkataniif garuu murtii qajeelaa ni kenna.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ija isaa qajeeltota irraa hin buqqifatu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:7"
      },
      "items": [
        {
          "text": "mootota wajjin teessoo irra isaan teessisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:7"
      },
      "items": [
        {
          "text": "bara baraanis ol isaan guddisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo namoonni foncaadhaan hidhaman,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:8"
      },
      "items": [
        {
          "text": "yoo funyoo rakkinaatiinis hidhaman,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni hojii isaanii,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:9"
      },
      "items": [
        {
          "text": "daba isaan of tuulummaan hojjetanis isaanitti ni hima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gurra isaanii sirreeffama dhaggeeffachuuf ni bana;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:10"
      },
      "items": [
        {
          "text": "akka isaan waan hamaa irraa qalbii jijjiirratanis ni ajaja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yoo ajajamanii isa tajaajilan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:11"
      },
      "items": [
        {
          "text": "bara jireenya isaanii badhaadhummaan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:11"
      },
      "items": [
        {
          "text": "umurii isaaniis gammachuudhaan fixatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ajajamuu baatan garuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:12"
      },
      "items": [
        {
          "text": "goraadeedhaan badu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:12"
      },
      "items": [
        {
          "text": "beekumsa malees ni duʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Warri garaan isaanii Waaqa irraa fagaate, aarii of keessatti kuufatu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:13"
      },
      "items": [
        {
          "text": "yommuu inni foncaan isaan hidhutti illee gargaarsa barbaachaaf hin iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan dargaggummaa isaanii keessa duʼu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:14"
      },
      "items": [
        {
          "text": "jireenyi isaaniis xuraaʼota gidduutti bada.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu warra dhiphatan dhiphina isaanii keessaa baasa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:15"
      },
      "items": [
        {
          "text": "rakkoo isaanii keessattis isaanitti dubbata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inni dhiphina keessaa si baasee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:16"
      },
      "items": [
        {
          "text": "gara lafa balʼaa dhiphina hin qabneetti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:16"
      },
      "items": [
        {
          "text": "maaddii coomaan guutametti si geessa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu murtiin hamootaaf malu sirra tuulameera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:17"
      },
      "items": [
        {
          "text": "murtii fi haqni si qabataniiru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
