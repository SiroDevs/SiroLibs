  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JOB 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bildaad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bildaad Shuhaahichi akkana jedhee deebise:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.1",
            "verseOrgIds": [
              "JOB.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati hamma yoomiitti waan akkasii dubbatta?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:2"
      },
      "items": [
        {
          "text": "Dubbiin kee bubbee jabaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni murtii qajeelaa jalʼisaa ree?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:3"
      },
      "items": [
        {
          "text": "Waaqni Waan Hunda Dandaʼu waan qajeelaa jalʼisaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu ijoolleen kee cubbuu isatti hojjetanitti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:4"
      },
      "items": [
        {
          "text": "inni adabbii cubbuu isaaniitti dabarsee isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati garuu yoo Waaqa barbaadatte,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:5"
      },
      "items": [
        {
          "text": "Waaqa Waan Hunda Dandaʼu yoo waammatte,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo ati qulqulluu fi qajeelaa taate,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:6"
      },
      "items": [
        {
          "text": "inni waaʼee keetiif ammuma kaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:6"
      },
      "items": [
        {
          "text": "jireenya qajeelummaa kees siif deebisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jalqabni kee xinnaa taʼu illee,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:7"
      },
      "items": [
        {
          "text": "dhumni kee baayʼee guddaa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhaloota darbe gaafadhu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:8"
      },
      "items": [
        {
          "text": "waan abbootiin isaanii qoratanii bira gaʼanis hubadhu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nu waan kaleessa dhalanneef waa tokko illee hin beeknuutii;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:9"
      },
      "items": [
        {
          "text": "baroonni keenyas lafa irratti akkuma gaaddidduu ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan si hin barsiisanii? Sittis hin himanii?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:10"
      },
      "items": [
        {
          "text": "Dubbii garaa isaanii keessa jirus hin dubbatanii?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhallaadduun lafa caffee hin taʼinitti guddataa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:11"
      },
      "items": [
        {
          "text": "Shambaqqoonis bishaan malee lalisaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan utuma guddachaa jiranuu, utuu hin muramin,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:12"
      },
      "items": [
        {
          "text": "biqiltuuwwan kaan dura dafanii gogu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhumni warra Waaqa irraanfataniis akkasuma taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:13"
      },
      "items": [
        {
          "text": "abdiin warra Waaqa hin beeknees ni bada.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abdiin isaa akkuma salphaatti cita;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:14"
      },
      "items": [
        {
          "text": "ofitti amanachuun isaas manʼee sariitii ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni manʼee isaatti irkata; manʼeen sun garuu hin dhaabatu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:15"
      },
      "items": [
        {
          "text": "itti maxxanas; manʼeen sun garuu dandaʼee isa hin baatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akka biqiltuu aduu keessatti bishaan obaafamee lalisuutti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:16"
      },
      "items": [
        {
          "text": "dameewwan isaa lafa biqiltuu irra diriirfatuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hidda isaa tuullaa dhagaatti marata;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:17"
      },
      "items": [
        {
          "text": "kattaa gidduus iddoo jiraatu ni barbaaddata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu inni iddoo isaatii badutti garuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.18",
            "verseOrgIds": [
              "JOB.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:18"
      },
      "items": [
        {
          "text": "iddoon sun, 'Ani si argee hin beeku' jedhee isa gana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.18",
            "verseOrgIds": [
              "JOB.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 8:19"
