  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JOB 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyoob haasaa isaa itti fufee akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.1",
            "verseOrgIds": [
              "JOB.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani jiʼoota darban, bara Waaqni na eege sana",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:2"
      },
      "items": [
        {
          "text": "akkamin hawwa ture,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo ibsaan isaa mataa koo irratti ife, anis ifa isaatiin",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:3"
      },
      "items": [
        {
          "text": "dukkana keessa darbee yeroon deeme,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo ani nama jabaa ture,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:4"
      },
      "items": [
        {
          "text": "yeroo michummaan Waaqaa mana koo eebbise,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo Waaqni Waan Hunda Dandaʼu na wajjin ture,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:5"
      },
      "items": [
        {
          "text": "yeroo ijoolleen koo naannoo koo turan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo daandiin koo dhadhaadhaan jiifame,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:6"
      },
      "items": [
        {
          "text": "yeroo kattaanis laga zayitii ejersaa naaf yaase.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yeroo ani gara karra magaalaatti gad baʼee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:7"
      },
      "items": [
        {
          "text": "oobdii sabaa keessa barcuma koo irra taaʼe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "dargaggeeyyiin na arganii karaa irraa goru;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:8"
      },
      "items": [
        {
          "text": "maanguddoonnis kaʼanii dhaabatu ture;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hangafoonni sabaa dubbii afaanitti qabatanii",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:9"
      },
      "items": [
        {
          "text": "harka isaanii afaan irra kaaʼatu ture;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sagaleen namoota bebeekamoo hin dhagaʼamu ture;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:10"
      },
      "items": [
        {
          "text": "arrabni isaaniis laagaa isaaniitti ni maxxana ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni na dhagaʼu kam iyyuu na jaja;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:11"
      },
      "items": [
        {
          "text": "kanneen na arganis na galateeffatu ture;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani hiyyeessa gargaarsa barbaachaaf booʼu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:12"
      },
      "items": [
        {
          "text": "nama abbaa hin qabne kan namni isa gargaaru tokko iyyuu hin jirre fureeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni duʼuu gaʼe na eebbiseera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:13"
      },
      "items": [
        {
          "text": "ani akka garaan haadha hiyyeessaa gammachuun ililchus godheera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qajeelummaa akka uffata kootti uffadheera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:14"
      },
      "items": [
        {
          "text": "murtiin qajeelaan immoo uffata koo fi marata mataa koo ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani nama jaameef ija,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:15"
      },
      "items": [
        {
          "text": "okkolaaf immoo miilla taʼeen ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani rakkataadhaaf abbaan ture;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:16"
      },
      "items": [
        {
          "text": "nama ormaatiif illee nan falman ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qarriffaa nama hamaa nan cabse;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:17"
      },
      "items": [
        {
          "text": "waan inni qabates afaan isaatii buuseera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani akkana jedheen yaadee ture; 'Manuma koo keessattin duʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:18"
      },
      "items": [
        {
          "text": "barri jireenya kootiis akkuma cirrachaa baayʼata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiddi koo gad fagaatee bishaan qaqqaba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.19",
            "verseOrgIds": [
              "JOB.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:19"
      },
