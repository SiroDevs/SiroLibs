      },
      "items": [
        {
          "text": "namni aduu humna guutuun iftu ilaaluu dandaʼu tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
