      "attrs": {
        "style": "q2",
        "vid": "JOB 37:20"
      },
      "items": [
        {
          "text": "Namni kam iyyuu liqimfamuuf ni gaafataa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.20",
            "verseOrgIds": [
              "JOB.37.20"
