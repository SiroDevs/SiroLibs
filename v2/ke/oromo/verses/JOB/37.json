          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani dubbachuu fedhu isatti himamuu qabaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.20",
            "verseOrgIds": [
              "JOB.37.20"
