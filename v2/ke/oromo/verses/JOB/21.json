  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JOB 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iyyoob",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyoob akkana jedhee deebise:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.1",
            "verseOrgIds": [
              "JOB.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dubbii koo qalbeeffadhaa dhaggeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:2"
      },
      "items": [
        {
          "text": "kun waan isin ittiin na jajjabeessitan haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ani dubbadhu naa obsaa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:3"
      },
      "items": [
        {
          "text": "erga ani dubbadhee booddee isin natti qoosuu dandeessu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhugumaan kan ani komadhu namaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:4"
      },
      "items": [
        {
          "text": "Ani maaliif obsa hin dhabne ree?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ilaalaatii dinqisiifadhaa; harka keessanis",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:5"
      },
      "items": [
        {
          "text": "afaan keessan irra kaaʼadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yommuu waan kana yaadu nan sodaadha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:6"
      },
      "items": [
        {
          "text": "hollannaanis na qabata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamoonni maaliif itti fufanii lubbuun jiraatu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:7"
      },
      "items": [
        {
          "text": "Maaliif dulloomanii humnas argachaa deemu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen isaanii naannoo isaaniitti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:8"
      },
      "items": [
        {
          "text": "sanyiin isaaniis fuula isaanii duratti jabaatanii dhaabatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manni isaanii nagaa dha; waan sodaatu illee hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:9"
      },
      "items": [
        {
          "text": "uleen Waaqaas isaan hin tuqxu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kormi isaanii dhalchuu hin dadhabu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:10"
      },
      "items": [
        {
          "text": "saawwan isaanii ni dhalu; hin gatatanis.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan ijoollee isaanii akkuma bushaayeetti bobbaasu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:11"
      },
      "items": [
        {
          "text": "daaʼimman isaanii immoo ni burraaqu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dibbee fi kiraaraan sirbu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:12"
      },
      "items": [
        {
          "text": "sagalee ululleetiinis ni gammadu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan bara isaanii badhaadhummaadhaan fixatu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:13"
      },
      "items": [
        {
          "text": "nagaadhaanis ni awwaalamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼu illee isaan Waaqaan akkana jedhu; 'Nu dhiisi!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:14"
      },
      "items": [
        {
          "text": "Nu karaa kee beekuuf fedhii hin qabnu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka nu isa tajaajilluuf Waaqni waan Hunda Dandaʼu eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:15"
      },
      "items": [
        {
          "text": "Nu isa kadhannee maal arganna?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badhaadhummaan isaanii garuu isaan harka hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:16"
      },
      "items": [
        {
          "text": "kanaafuu ani gorsa hamootaa irraa nan fagaadha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Garuu ibsaan hamootaa yoom iyyuu ni dhaamaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:17"
      },
      "items": [
        {
          "text": "Balaan yoom iyyuu isaanitti dhufaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:17"
      },
      "items": [
        {
          "text": "Waaqnis dheekkamsa isaatiin badiisa isaanitti fidaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akkuma cidii fuula qilleensaa duraa ti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:18"
      },
      "items": [
        {
          "text": "akkuma habaqii bubbeen hamaan fudhatee deemuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 21:19"
          },
