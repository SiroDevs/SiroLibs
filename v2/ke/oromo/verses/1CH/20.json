    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Birraa keessa yeroo mootonni waraanaaf baʼanitti Yooʼaab humnoota waraanaa qajeelchee biyya Amoonotaa barbadeesse; ergasiis dhaqee Rabbaa marse; Daawit garuu Yerusaalemitti hafe. Yooʼaabis Raabbaa waraanee daaraa ishee godhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis mataa mootii isaanii irraa gonfoo fudhate; gonfoon sun hamma warqee taalaantii tokkoo ulfaatee dhagaawwan gati jabeeyyiis of irraa qaba ture; gonfichis mataa Daawit irra kaaʼame. Innis magaalaa sana keessaa boojuu akka malee baayʼee fudhatee",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoota achi keessa turanis gad yaasee akka isaan magaaziidhaan, gasoo sibiilaatii fi qottoodhaan hojii hojjetan godhe. Daawit magaalaawwan Amoonotaa hunda keessattis akkasuma godhe. Ergasii Daawitii fi loltoonni isaa hundinuu Yerusaalemitti ni deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waraana Filisxeemotatti Baname",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
