    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit ajajjoota isaa hunda ajajjoota kumaatii fi ajajjoota dhibbaa wajjin ni mariʼate.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.1",
            "verseOrgIds": [
              "1CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii inni yaaʼii Israaʼel guutuudhaan akkana jedhe; \"Yoo wanni kun waan gaarii isinitti fakkaatee fi yoo fedhii",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.2",
                "verseOrgIds": [
                  "1CH.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaa taʼe, kottaa mee akka isaan dhufanii nutti dabalamaniif obboloota keenya kanneen guutummaa biyya Israaʼel keessatti hafanitti akkasumas lubootaa fi Lewwota isaan wajjin magaalaawwanii fi lafa dheeda isaanii keessa jiraatanitti ergaa haa erginu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taabota Waaqa keenyaa deebifnee haa fidannu; nu bara mootummaa Saaʼol keessa isa hin barbaaneetii.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii wanni kun saba hundatti waan qajeelaa fakkaateef guutummaan yaaʼii sanaa waan kana gochuudhaaf walii gale.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Daawit taabota Waaqaa Kiriyaati Yeʼaariimii fiduudhaaf Israaʼeloota Laga Shihoorii kan biyya Gibxiitti argamuu jalqabee hamma karra Hamaatiitti jiran hunda walitti qabe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitii fi Israaʼeloonni isa wajjin turan hundi taabota Waaqa kiirubeelii gidduu teessoo irra jiru sanaa jechuunis taabota Maqaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.6",
                "verseOrgIds": [
                  "1CH.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "waamamu sana achii fiduuf jedhanii gara Baʼaalaa jechuunis gara Kiriyaati Yeʼaariim ishee Yihuudaa keessaa sanaa ni dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis taabota Waaqaa sana gaarii haaraatti feʼanii mana Abiinaadaabiitii ni baasan; Uzaa fi Ahiiyoon gaarii sana oofaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitii fi Israaʼeloonni hundinuu humna isaanii guutuudhaan faarfannaa fi baganaadhaan, kiraaraa fi dibbeedhaan, kilillee fi malakataan fuula Waaqaa duratti gammadanii shuubbisaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isaan oobdii Kiidoon bira gaʼanitti waan sangoonni gufataniif Uzaan taabota sana qabuuf harka isaa hiixate.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Uzaan taabota irra harka isaa kaaʼeef dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.10",
                "verseOrgIds": [
                  "1CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Uzaatti bobaʼe; innis isa rukute; kanaafuu inni achumatti fuula Waaqaa duratti ni duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis sababii",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.11",
                "verseOrgIds": [
                  "1CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akka malee Uzaatti dheekkameef ni aare; iddoon sun hamma harʼaatti Phereez Uzaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "text": "jedhamee waamama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis gaafa sana Waaqa sodaatee, \"Ani akkamittan taabota Waaqaa gara mana kootti fiduu dandaʼa?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka taabonni isa wajjin Magaalaa Daawit keessa jiraatuuf ofitti hin fudhanne. Qooda kanaa gara mana Oobeed Edoom namicha Gitii sanaatti geesse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taabonni Waaqaas jiʼa sadii maatii Oobeed Edoom wajjin mana isaa keessa ture;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.14",
                "verseOrgIds": [
                  "1CH.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "warra mana isaa jiraatanii fi waan inni qabu hunda ni eebbise.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        }
      ]
    }
  ],
