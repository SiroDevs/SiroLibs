    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uffata Qulqulluu Luba Ol Aanaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis utuu Iyyaasuun lubichi ol aanaan fuula ergamaa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.1",
                "verseOrgIds": [
                  "ZEC.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dura dhaabatee, Seexanni immoo isa himachuuf karaa harka mirga isaa dhaabatuu na argisiise.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.2",
                "verseOrgIds": [
                  "ZEC.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Seexanaan akkana jedhe; \"Seexana nana,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.2",
                "verseOrgIds": [
                  "ZEC.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "si haa ifatu!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.2",
                "verseOrgIds": [
                  "ZEC.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "inni Yerusaalemin filate si haa ifatu! Namichi kun mukukkula ibidda bobaʼu keessaa butame mitii?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun yeroo ergamaa Waaqayyoo sana dura dhaabatetti uffata xuraaʼaa uffatee ture.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan Waaqayyoo sunis warra isa dura dhaabachaa turan sanaan, \"Uffata isaa xuraaʼaa isa irraa baasaa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 3:4"
      },
      "items": [
        {
          "text": "Innis ergasii Iyyaasuudhaan, \"Kunoo ani cubbuu kee sirraa fuudhee uffata miidhagaa sittin uffisa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis, \"Mataa isaa irra marata qulqulluu kaaʼaafii\" nan jedhe. Kanaafuu isaan utuma ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.5",
                "verseOrgIds": [
                  "ZEC.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sun achi dhaabatee jiruu, marata qulqulluu mataa isaa irra kaaʼanii uffata itti uffisan.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.6",
                "verseOrgIds": [
                  "ZEC.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sunis ajaja kana Iyyaasuuf kenne:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.7",
                "verseOrgIds": [
                  "ZEC.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu akkana jedha; 'Ati yoo karaa koo irra deemtee ajaja koo eegde, mana koo ni bulchita; itti gaafatamaa oobdii koo ni taata; anis warra as dhadhaabatan kana gidduutti iddoo siif nan kenna.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yaa Iyyaasuu lubicha ol aanaa, atii fi gareen kee warri fuula kee dura tataaʼan, namoonni waan dhufuuf jiruuf mallattoo taʼan waan kana dhaggeeffadhaa. Ani tajaajilaa koo Damee sana nan fida.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhagaa ani fuula Iyyaasuu dura kaaʼe ilaalaa! Dhagaa tokkicha sana irra ija torbatu jira; anis barreeffama isa irratti nan qiriixa' jedha",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.9",
                "verseOrgIds": [
                  "ZEC.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu; 'cubbuu biyya kanaas guyyuma tokkotti nan balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bara sana tokkoon tokkoon namaa muka wayiniitii fi muka harbuu isaa jala taaʼuuf ollaa isaa ni waammata' jedha",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.10",
                "verseOrgIds": [
                  "ZEC.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        }
      ]
    }
  ],
