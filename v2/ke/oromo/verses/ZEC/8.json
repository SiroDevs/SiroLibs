              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "jiraattonni magaalaa tokkoo gara magaalaa biraa dhaqanii, 'Kottaa mee",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
