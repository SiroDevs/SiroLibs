          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.18",
                "verseOrgIds": [
                  "ZEC.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuu gara koo dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 8:19"
          },
          "items": [
