        {
          "text": "Waan Hunda Dandaʼu akkana jedha: \"Uummanni hedduunii fi jiraattonni magaalaa hedduun ammas ni dhufu;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
