      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ermiyaasii fi Phaashihuur",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaashihuur lubichi, ilmi Imeerii inni mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.1",
                "verseOrgIds": [
                  "JER.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti bulchaa hangafa ture sun yommuu Ermiyaasii waan kana raaju dhagaʼetti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka Ermiyaas raajichi tumamee Karra Beniyaam isa ol aanu kan mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.2",
                "verseOrgIds": [
                  "JER.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "biratti argamu sana keessatti miilli isaa jirma lama gidduu galee hidhamu godhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaasis guyyaa itti aanu yeroo Phaashihuur jirma lamaan gidduudhaa isa baasetti akkana jedheen; \"Maqaan",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.3",
                "verseOrgIds": [
                  "JER.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "siif baase Maagormiisaabiib malee Phaashihuur miti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.4",
                "verseOrgIds": [
                  "JER.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhaatii; 'Ani akka ati ofii keetii fi michoota keetti sodaachisaa taatu sin godha; yeroo isaan goraadee diinota isaaniitiin dhuman ijuma keetiin argita. Ani Yihuudaa hunda dabarsee mootii Baabiloniitti nan kenna; innis Baabilonitti isaan geessa yookaan goraadeedhaan isaan fixa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani qabeenya magaalaa kanaa hunda jechuunis oomisha ishee hunda, waan gatii guddaa qabu hundaa fi badhaadhummaa mootota Yihuudaa hunda dabarsee diinota isaaniitti nan kenna. Isaanis boojiʼanii fudhatanii Baabilonitti isaan geessan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.5",
            "verseOrgIds": [
              "JER.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Phaashihuur ati, warri mana kee jiraatan hundis boojiʼamtanii Baabilonitti geeffamtu. Atii fi michoota kee warri ati raajii sobaa dubbatteef hundi achitti duutanii awwaalamtu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gungummii Ermiyaas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.7",
                "verseOrgIds": [
                  "JER.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ati na gowwoomsite;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "anis nan gowwoomfame;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "ati humnaan na caaltee na moʼatte.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "Ani guyyaa guutuu waan kolfaa nan taʼe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "namni hundis natti qoosa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yeroon dubbadhu hunda nan iyya;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "\"Goolii, badiisa\" jedhees nan labsa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "Kanaafuu dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.8",
                "verseOrgIds": [
                  "JER.20.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "guyyaa guutuu arrabsoo fi tuffii natti fide.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo ani, \"Ani maqaa isaa hin dhaʼu",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "yookaan siʼachi maqaa isaatiin hin dubbadhu\" jedhe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "dubbiin isaa onnee koo keessatti akka ibiddaa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "akkuma ibidda lafee koo keessatti ukkaamsameera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "Ani of keessatti isa qabachuu nan dadhabe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "dhuguma iyyuu ani hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani hasaasa, \"Karaa hundaan sodaa!",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "Isa balaaleffadhaa! Isa haa balaaleffannu!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "jedhu hedduu nan dhagaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "Michoonni koo hundi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "\"Inni ni gowwoomfama taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "nus ergasii isa ni moʼanna;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "haaloo keenya illee ni baafanna\" jechaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "kufaatii koo eeggatu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.11",
                "verseOrgIds": [
                  "JER.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu akkuma goota humna qabeessa tokkootti",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "na wajjin jira;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:11"
      },
      "items": [
        {
          "text": "kanaafuu warri na adamsan ni gufatu malee hin moʼatan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:11"
      },
      "items": [
        {
          "text": "Isaan baayʼee qaaneffaman; hin milkaaʼaniitii;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
