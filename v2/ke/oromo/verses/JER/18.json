      "attrs": {
        "style": "q1",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "bara badiisa isaanii keessa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
