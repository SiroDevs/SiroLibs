          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
