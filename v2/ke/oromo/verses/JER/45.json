          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati, 'Anaaf wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.45.3",
                "verseOrgIds": [
                  "JER.45.3"
                ]
              }
            }
          ]
        },
        {
          "text": "dhibee koo irratti gadda natti dabaleera; ani aaduudhaan laafee boqonnaa dhabeera' jette.",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 45:4"
          },
          "items": [
            {
