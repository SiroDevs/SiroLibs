                "verseId": "JER.45.2",
                "verseOrgIds": [
                  "JER.45.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel akkana siin jedha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
