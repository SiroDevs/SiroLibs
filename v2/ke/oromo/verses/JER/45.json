          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Baaruk,",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
