  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JER 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiʼa torbaffaa keessa Ishmaaʼeel ilmi Naataaniyaa, ilma Eliishaamaa kan sanyii moototaa irraa dhalatee fi ajajjoota loltoota mootichaa keessaa tokko ture sun namoota kudhan wajjin Gedaaliyaas ilma Ahiiqaam bira Miisphaa dhufe. Achittis utuma wajjin waa nyaatanuu",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmaaʼeel ilmi Naataaniyaatii fi namoonni kurnan isa wajjin turan sun kaʼanii goraadeedhaan Gedaaliyaas ilma Ahiiqaam, ilma Shaafaan isa mootiin Baabilon bulchaa kutaa biyyaa godhee muude sana rukutanii ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmaaʼeel akkasumas Yihuudoota Gedaaliyaas wajjin Miisphaa turan hundaa fi loltoota Baabilonotaa kanneen achi turan illee ni fixe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedaaliyaas ajjeefamee guyyaa itti aanutti utuu namni tokko iyyuu hin beekin,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni areeda isaanii haaddatanii, wayyaa isaanii tatarsaasanii, of cicciran Saddeettamni kennaa midhaaniitii fi ixaana qabatanii Sheekemii, Shiiloo fi Samaariyaadhaa gara mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.41.5",
                "verseOrgIds": [
                  "JER.41.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmaaʼeel ilmi Naataaniyaas jara simachuuf Miisphaadhaa booʼaa gad baʼe. Yommuu isaan argettis \"Gara Gedaaliyaas ilma Ahiiqaam kottaa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo isaan magaalaa sana seenanitti immoo Ishmaaʼeel ilmi Naataaniyaatii fi namoonni isa wajjin turan jara sana gogorraʼanii boolla bishaaniitti gad darbatan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni utuu hin ajjeefamin hafan kudhan garuu Ishmaaʼeeliin, \"Nu hin ajjeesin! Nu qamadii fi garbuu, zayitii fi damma lafa qotiisaa keessa dhokfanne qabnaatii\" jedhan. Kanaafuu inni gad isaan dhiise; warra kaan wajjinis isaan hin ajjeefne.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolli bishaanii Ishmaaʼeel reeffa namoota Gedaaliyaas wajjin ajjeefaman sanaa hunda itti naqe sun boolla bishaanii Aasaan Mootichi ittiin Baʼishaan mooticha Israaʼel of irraa dhowwuuf hojjetate ture. Ishmaaʼeel ilmi Naataaniyaa boolla bishaanii sana reeffa namaatiin guute.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmaaʼeel namoota Miisphaa keessaa hafan hunda intallan mootichaatii fi warra achitti hafan kanneen Nebuzaradaan ajajaan eegumsaa sun Gedaaliyaas ilma Ahiiqaam isaan irratti shuumee ture hunda boojiʼe. Ishmaaʼeel ilmi Naataaniyaas isaan fudhatee gara Amoonotaatti ceʼuuf kaʼee qajeele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoohaanaan ilmi Qaareyaatii fi ajajjoonni waraanaa kanneen isa wajjin turan hundi yeroo waaʼee yakka Ishmaaʼeel ilmi Naataaniyaa hojjete hundaa dhagaʼanitti",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoota isaanii hunda fudhatanii Ishmaaʼeel ilma Naataaniyaa loluu dhaqan. Isaanis haroo Gibeʼoon guddicha biratti isa qaqqaban.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Ishmaaʼeel wajjin turan hundi yommuu Yoohaanaan ilma Qaareyaatii fi ajajjoota loltootaa kanneen isa wajjin turan arganitti ni gammadan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Ishmaaʼeel Miisphaadhaa boojiʼee ture hundis isa biraa deebiʼanii gara Yoohaanaan ilma Qaareyaa dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu Ishmaaʼeel ilmi Naataaniyaatii fi namoota isaa keessaa saddeeti Yoohaanaan jalaa miliqanii gara Amoonotaatti baqatan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gara Gibxitti Baqachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoohaanaan ilmi Qaareyaatii fi ajajjoonni loltoota warri isa wajjin turan hundi namoota Miisphaa warra Ishmaaʼeel ilmi Naataaniyaa erga Gedaaliyaas ilma Ahiiqaam ajjeesee booddee boojiʼe kaan hunda fuudhanii deeman; isaanis loltoota, dubartoota, ijoollee fi qondaaltota mana murtii kanneen Yoohaanaan Gibeʼoonii deebisee fidee dha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis achii kaʼanii gara Gibxitti qajeeluudhaan Beetlihem biratti Geeroti Kimhaam keessa boqotan;",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis Baabilonota jalaa miliquuf ture. Isaan sababii Ishmaaʼeel ilmi Naataaniyaa sun Gedaaliyaas ilma Ahiiqaam isa mootiin Baabilon biyyattii irratti bulchaa godhee shuume sana ajjeeseef jara sodaatan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
