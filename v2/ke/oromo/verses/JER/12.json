              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isaan haala jireenya saba koo akka gaarii baratanii akkuma duraan saba koo Baʼaaliin kakachuu barsiisan sana, 'Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
