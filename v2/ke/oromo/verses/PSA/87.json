    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Xiyoon, Haadha Sabootaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Faarfannaa Ilmaan Qooraahi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 87:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundeen magaalaa isaa tulluu qulqulluu irra jira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.1",
            "verseOrgIds": [
              "PSA.87.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 87:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.2",
                "verseOrgIds": [
                  "PSA.87.2"
                ]
              }
            }
          ]
        },
        {
          "text": "iddoo jireenya Yaaqoob hunda caalaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:2"
      },
      "items": [
        {
          "text": "karrawwan Xiyoon jaallata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 87:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa magaalaa Waaqaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:3"
      },
      "items": [
        {
          "text": "waaʼee keetiif wanni kabajamaan akkana jedhamee ni dubbatama:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 87:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani Raʼaabii fi Baabilonin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "warra na beekan gidduutti maqaa nan dhaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "kunoo, Filisxeemii fi Xiiroos Itoophiyaa wajjin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "'Namichi kun achitti dhalate' jedhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 87:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhugumaan waaʼee Xiyoon,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "\"Inni kunii fi inni sun ishee keessatti dhalatan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "Waaqni Waan Hunda Olii mataan isaa iyyuu ishee dhaaba\" jedhama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 87:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.6",
                "verseOrgIds": [
                  "PSA.87.6"
                ]
              }
            }
          ]
        },
        {
          "text": "yeroo saboota galmeessutti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:6"
      },
      "items": [
        {
          "text": "\"Namichi kun achitti dhalate\" jedhee barreessa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 87:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri faarfatanii fi warri meeshaa muuziiqaa taphatan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:7"
      },
      "items": [
        {
          "text": "\"Burqaan koo hundi si keessatti argama\" jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    }
  ],
