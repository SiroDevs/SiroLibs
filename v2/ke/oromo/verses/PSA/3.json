          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni baayʼeen, \"Waaqni isa hin baraaru\" jedhanii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
