          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.1",
                "verseOrgIds": [
                  "PSA.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", diinonni koo akkam baayʼatu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.1",
            "verseOrgIds": [
              "PSA.3.2"
