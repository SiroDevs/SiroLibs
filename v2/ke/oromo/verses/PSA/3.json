    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Faarfannaa Daawit yeroo ilma isaa Abesaaloom jalaa baqatetti faarfate.",
          "type": "text"
        }
      ]
    },
