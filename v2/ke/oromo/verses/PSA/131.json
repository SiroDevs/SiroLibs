      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "akkuma daaʼimni harma haadha isaa guusan tokko haadhatti irkatee boqotu sana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
