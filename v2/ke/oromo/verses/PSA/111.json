      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "Ani waldaa tolootaatii fi wal gaʼii keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
