              "attrs": {
                "verseId": "PSA.111.1",
                "verseOrgIds": [
                  "PSA.111.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nan galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
