      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:7"
      },
      "items": [
        {
          "text": "ajajni isaa hundinuus amanamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 111:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis bara baraa hamma bara baraatti jabaatanii dhaabatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:8"
      },
      "items": [
        {
          "text": "amanamummaa fi qajeelummaadhaanis hojjetamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 111:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni saba isaatiif furii ergeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "kakuu isaas bara baraan ajajeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "maqaan isaa qulqulluu fi sodaachisaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
