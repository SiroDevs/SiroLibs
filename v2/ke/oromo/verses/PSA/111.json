            "sid": "PSA 111:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni warra isa sodaataniif nyaata kenna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:5"
      },
      "items": [
        {
          "text": "kakuu isaas bara baraan ni yaadata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
