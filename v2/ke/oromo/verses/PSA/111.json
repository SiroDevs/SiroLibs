      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "garaa koo guutuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
