    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Xiyoon Tulluu Waaqayyoo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Weedduu. Faarfannaa Ilmaan Qooraahi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaa Waaqa keenyaa keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:1"
      },
      "items": [
        {
          "text": "tulluu isaa qulqulluu irrattis,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.1",
                "verseOrgIds": [
                  "PSA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": "guddaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:1"
      },
      "items": [
        {
          "text": "waan hundaa olittis galanni isaaf mala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulluun Xiyoon gara kaabaatti argama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "dheerina isaatiinis ni bareeda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "Innis gammachuu addunyaa hundaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "magaalaa Mooticha Guddaatis.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni daʼannoo ishee keessa jira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:3"
      },
      "items": [
        {
          "text": "inni daʼannoo ishee taʼuu isaa argisiiseera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootonni humna walitti daratanii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:4"
      },
      "items": [
        {
          "text": "tokkummaadhaan itti qajeelan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis ishee arganii dinqifatan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:5"
      },
      "items": [
        {
          "text": "sodaataniis baqatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achittis akkuma muddama dubartii ciniinsifattuutti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:6"
      },
      "items": [
        {
          "text": "hollannaan isaan qabate.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atis bubbee baʼa biiftuutiin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:7"
      },
      "items": [
        {
          "text": "dooniiwwan Tarshiish caccabsite.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma dhageenye sana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "magaalaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.8",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuu keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "magaalaa Waaqa keenyaa keessatti, akkasuma argineerra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "Waaqni bara baraan jabeessee ishee dhaaba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqayyo, nu mana qulqullummaa kee keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:9"
      },
      "items": [
        {
          "text": "jaalala kee kan hin geeddaramne sana irra deddeebinee yaadna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqayyo, galanni kee akkuma maqaa keetii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:10"
      },
      "items": [
        {
          "text": "handaara lafaa gaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:10"
      },
      "items": [
        {
          "text": "harki kee mirgaas qajeelummaan guutameera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii murtii keetiitiif,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:11"
      },
      "items": [
        {
          "text": "Tulluun Xiyoon haa gammaddu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:11"
      },
      "items": [
        {
          "text": "intallan Yihuudaas haa ililchan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xiyoon irra naannaʼaa; naannoo ishee irras adeemaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.12",
            "verseOrgIds": [
              "PSA.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:12"
      },
      "items": [
        {
          "text": "gamoowwan ishees lakkaaʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.12",
            "verseOrgIds": [
              "PSA.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaloota itti aanutti akka himtaniif,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:13"
      },
      "items": [
        {
          "text": "dallaa eegumsa ishee sirriitti hubadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:13"
      },
      "items": [
        {
          "text": "galma ishees ilaalaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 48:14"
          },
          "items": [
