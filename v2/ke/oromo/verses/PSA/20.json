    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kadhannaa Mootiif Kadhatame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa rakkinaatti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.1",
                "verseOrgIds": [
                  "PSA.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "deebii siif haa kennu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:1"
      },
      "items": [
        {
          "text": "maqaan Waaqa Yaaqoobis si haa eegu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni iddoo qulqulluudhaa gargaarsa siif haa ergu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:2"
      },
      "items": [
        {
          "text": "Xiyoon irraas jabina siif haa kennu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarsaa kee hunda siif haa yaadatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:3"
      },
      "items": [
        {
          "text": "qalma kee kan gubamus siif haa fudhatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawwii garaa keetii siif haa kennu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:4"
      },
      "items": [
        {
          "text": "karoora kee hundas fiixaan siif haa baasu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu ati moʼattutti ililchinee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:5"
      },
      "items": [
        {
          "text": "maqaa Waaqa keenyaatiin faajjii keenya ol fudhanna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 20:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 20:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.5",
                "verseOrgIds": [
                  "PSA.20.6"
                ]
              }
            }
          ]
        },
        {
          "text": "waan ati kadhattu hundumaa siif haa kennu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.6",
                "verseOrgIds": [
                  "PSA.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": "dibamaa isaa fayyisu amma beeka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "Waaqayyo humna nama fayyisu kan harka isaa mirgaa keessa jiru sanaan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "samii isaa qulqulluu keessaa deebii ni kennaaf.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni tokko tokko gaariiwwan amanatu; kaan immoo fardeen amanatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:7"
      },
      "items": [
        {
          "text": "nu garuu maqaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.7",
                "verseOrgIds": [
                  "PSA.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaa amananna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan gufatanii kufu; nu garuu ol kaana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:8"
      },
      "items": [
        {
          "text": "jabaannees ni dhaabanna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.9",
                "verseOrgIds": [
                  "PSA.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ati mootiidhaaf moʼannaa kenni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:9"
      },
      "items": [
        {
          "text": "Yommuu nu si waammannuttis deebii nuu kenni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        }
      ]
    }
  ],
