      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:4"
      },
      "items": [
        {
          "text": "gatii isaaniif malu isaanumatti deebisi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
