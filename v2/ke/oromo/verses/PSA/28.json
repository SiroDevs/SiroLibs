          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka hojii isaaniitti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:4"
      },
      "items": [
        {
          "text": "akkuma hojii isaanii hamaa sanaattis deebisiif;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:4"
      },
      "items": [
        {
          "text": "akkuma hojii harka isaaniitti kenniif;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
