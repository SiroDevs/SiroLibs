      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:9"
      },
      "items": [
        {
          "text": "tiksee isaanii taʼii bara baraan isaan baadhu.",
          "type": "text",
          "attrs": {
