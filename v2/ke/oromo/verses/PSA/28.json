      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "garaan koo isa amanata; anis gargaarsa argadheera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "Garaan koo baayʼee gammada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
