          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.28.7",
                "verseOrgIds": [
                  "PSA.28.7"
                ]
              }
            }
          ]
        },
        {
          "text": "jabina koo fi gaachana koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
