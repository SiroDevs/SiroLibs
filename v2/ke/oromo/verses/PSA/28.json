      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:5"
      },
      "items": [
        {
          "text": "inni isaan diiga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:5"
      },
      "items": [
        {
          "text": "deebisees isaan hin ijaaru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
