            "number": "6",
            "style": "v",
            "sid": "PSA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis handaara samiiwwanii tokkoo baatee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
