    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Waaqayyo Biiftuu Qajeelummaati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samiiwwan ulfina Waaqaa odeessu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:1"
      },
      "items": [
        {
          "text": "bantiin samiis hojii harka isaa labsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaan tokko guyyaa kaanitti odeessa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:2"
      },
      "items": [
        {
          "text": "halkan tokkos halkan kaanitti beekumsa mulʼisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haasaan yookaan dubbiin hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:3"
      },
      "items": [
        {
          "text": "sagaleen isaaniis hin dhagaʼamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus sagaleen isaanii lafa hundumaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "dubbiin isaaniis handaara addunyaa gaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "Inni samiiwwan keessatti biiftuudhaaf dunkaana dhaabe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "biiftuunis akkuma misirricha dinqa isaatii baʼuutii fi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:5"
      },
      "items": [
        {
          "text": "akkuma moʼataa fiigicha dorgomutti gammadu tokkoo ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
