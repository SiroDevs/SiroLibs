  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "83",
        "style": "c",
        "sid": "PSA 83"
      },
      "items": [
        {
          "text": "83",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 83",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kadhannaa Diinota Israaʼel Irratti Dhiʼaate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Faarfannaa Asaaf.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 83:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi gab hin jedhin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:1"
      },
      "items": [
        {
          "text": "yaa Waaqi, hin calʼisin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:1"
      },
      "items": [
        {
          "text": "akkasumattis hin dhiisin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 83:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diinonni kee akkam akka kakaʼan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:2"
      },
      "items": [
        {
          "text": "warri si jibbanis akkam akka mataa ol qabatan ilaali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 83:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan saba keetti daba karoorfatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:3"
      },
      "items": [
        {
          "text": "warra ati eegdutti mariʼatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 83:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Kottaa akka maqaan Israaʼel lammata hin yaadatamneef,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:4"
      },
      "items": [
        {
          "text": "akka isaan saba hin taaneef isaan barbadeessinaa\" jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 83:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yaada tokkoon walii galu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:5"
      },
      "items": [
        {
          "text": "sittis ni gurmaaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 83:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaanis dunkaanota Edoom, Ishmaaʼeeloota,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:6"
      },
      "items": [
        {
          "text": "Moʼaabii fi gosa Aggaar,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 83:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gebaal, Amoonii fi Amaaleq,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:7"
      },
      "items": [
        {
          "text": "Filisxeemii fi namoota biyya Xiiroos wajjin turan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 83:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Asooriis, ilmaan Looxiitiif irree jabaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:8"
      },
      "items": [
        {
          "text": "taʼuudhaaf isaanitti makaman.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 83:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akkuma Midiyaanin goote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:9"
      },
      "items": [
        {
          "text": "akkuma laga Qiishooniitti Siisaaraa fi Yaabiinin goote sana isaan godhi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 83:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan Eendooritti dhumanii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:10"
      },
      "items": [
        {
          "text": "akkuma kosii lafaa taʼan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 83:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gurguddoota isaanii akka Hereebiitii fi Zeʼeeb,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:11"
      },
      "items": [
        {
          "text": "ilmaan mootota isaanii immoo akka Zebaa fi Zalmunaa godhi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 83:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan warra, \"Kottaa, lafa tika Waaqaa fudhannee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:12"
      },
      "items": [
        {
          "text": "kan dhuunfaa keenyaa godhannaa\" jedhanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 83:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa ko, akka awwaara bubbeen fudhatuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:13"
      },
      "items": [
        {
          "text": "akka habaqii qilleensi bittinneessuu isaan godhi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 83:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma ibiddi bosona balleessu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:14"
      },
      "items": [
        {
          "text": "yookaan akkuma arrabni ibiddaa tulluuwwan gubu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 83:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "atis akkasuma aarii keetiin isaan gugsi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:15"
      },
      "items": [
        {
          "text": "bubbee keetiin isaan sodaachisi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 83:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.83.16",
                "verseOrgIds": [
                  "PSA.83.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", akka isaan maqaa kee barbaaddataniif,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:16"
      },
      "items": [
        {
          "text": "fuula isaanii qaaniin haguugi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 83:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yeroo hunda qaanaʼanii haa dhiphatan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.17",
            "verseOrgIds": [
              "PSA.83.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
