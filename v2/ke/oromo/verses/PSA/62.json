    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Waaqa Qofa Abdachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura buʼaa faarfattootaatiif. Yeduutuuniif. Faarfannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubbuun koo Waaqa qofa eeggatti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:1"
      },
      "items": [
        {
          "text": "fayyinni koos isa biraa naa dhufa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kattaan kootii fi fayyinni koo isa qofa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:2"
      },
      "items": [
        {
          "text": "inni daʼoo koo ti; ani gonkumaa hin raafamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin hamma yoomiitti nama miitu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "Hamma yoomiitti akka keenyan manaa kan duufeetti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "akka dallaa raafameettis lafaan isa dhaʼuu barbaaddu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 62:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan aangoo isaa guddaa sana irraa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "guutummaatti gad isa deebisuu barbaadu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "isaan sobatti ni gammadu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "Afaan isaaniitiin ni eebbisu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "garaa isaaniitiin garuu ni abaaru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubbuun koo Waaqa qofa obsaan eeggatti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:5"
      },
      "items": [
        {
          "text": "abdiin koo isa biraa dhufaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 62:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kattaan kootii fi fayyinni koo isa qofa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:6"
      },
      "items": [
        {
          "text": "inni daʼoo koo ti; ani hin raafamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 62:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fayyinni kootii fi ulfinni koo harka Waaqaa keessa jira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:7"
      },
      "items": [
        {
          "text": "kattaan koo jabaan, iddoon ani itti kooluu galu Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 62:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa namoota, yeroo hunda isa amanadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "garaa keessanis fuula isaa duratti dhangalaasaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "Waaqni iddoo nu itti kooluu galluudhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 62:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa tuffatamaa irraa dhalachuun homaa miti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "gosa kabajamaa irraa dhalachuunis sobuma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "yoo madaaliidhaan madaalaman",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "lachanuu qilleensa caalaa salphatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 62:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan saamichaan argattan hin amanatinaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "waan hatameenis hin koorinaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "Yoo qabeenyi keessan guddate illee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "qalbii keessan isa irra hin kaaʼatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 62:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni yeroo tokko dubbate;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "ani immoo yeroo lama nan dhagaʼe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "kunis akka humni kan Waaqaa taʼee dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 62:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Gooftaa araarri kan kee ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "Ati dhugumaan tokkoo tokkoo namaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "akkuma hojii isaatti gatii isaa ni kennitaaf.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    }
  ],
