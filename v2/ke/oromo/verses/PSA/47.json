    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Waaqayyo Mootii Addunyaa ti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura buʼaa faarfattootaatiif. Faarfannaa Ilmaan Qooraahi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin saboonni hundinuu harka keessan rukutaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:1"
      },
      "items": [
        {
          "text": "sagalee ol fudhadhaatii gammachuudhaan Waaqaaf ililchaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.47.2",
                "verseOrgIds": [
                  "PSA.47.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Waan Hundaa Olii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:2"
      },
      "items": [
        {
          "text": "Mootichi guddaan lafa hundumaa, sodaachisaadhaatii!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni saboota nu jala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:3"
      },
      "items": [
        {
          "text": "namootas miilla keenya jala galcheera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis nu warra Yaaqoob isa inni jaallate sanaaf ulfina taaneef,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:4"
      },
      "items": [
        {
          "text": "dhaala keenya nuu fileera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni ililleedhaan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.47.5",
                "verseOrgIds": [
                  "PSA.47.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sagalee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:5"
      },
      "items": [
        {
          "text": "malakataatiin ol baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faarfannaa galataa Waaqaaf faarfadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:6"
      },
      "items": [
        {
          "text": "faarfannaa galataa faarfadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 47:6"
      },
      "items": [
        {
          "text": "faarfannaa galataa Mootii keenyaaf faarfadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:6"
      },
      "items": [
        {
          "text": "faarfannaa galataa faarfadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni Mootii lafa hundaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:7"
      },
      "items": [
        {
          "text": "faarfannaa galataa hubannaadhaan faarfadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni saboota irratti Mootii dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:8"
      },
      "items": [
        {
          "text": "Waaqni teessoo isaa qulqulluu irra taaʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni sabootaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "akkuma saba Waaqa Abrahaamitti walitti qabamu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "mootonni lafa irraa kan Waaqaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "innis guddisee ol ol jedheera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    }
