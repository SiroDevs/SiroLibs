      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:11"
      },
      "items": [
        {
          "text": "\"Ani ilmaan kee keessaa isa tokko teessoo kee irra nan teessisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
