      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:12"
      },
      "items": [
        {
          "text": "ilmaan isaaniis akkasuma bara baraa hamma bara baraatti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "teessoo kee irra ni taaʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
