      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:3"
      },
      "items": [
        {
          "text": "namoota duʼa hin oolle",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "warra isin gargaaruu hin dandeenye irra hin kaaʼatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
