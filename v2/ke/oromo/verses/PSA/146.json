          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yeruma lubbuun isaan keessaa baatu gara lafaatti deebiʼu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
