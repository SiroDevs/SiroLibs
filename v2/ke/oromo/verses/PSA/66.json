    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Waaqa Galateeffachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura buʼaa faarfattootaatiif. Faarfannaa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin lafti hundinuu ililleedhaan gara Waaqaatti iyyaa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.1",
            "verseOrgIds": [
              "PSA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulfina maqaa isaa faarfadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:2"
      },
      "items": [
        {
          "text": "galata isaatiifis ulfina kennaa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqaan akkana jedhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "\"Hojiin kee akkam sodaachisaa dha!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "Sababii humni kee guddaa taʼeef,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "diinonni kee fuula kee duratti hollatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti hundinuu siif sagadu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:4"
      },
      "items": [
        {
          "text": "faarfannaa galataa siif faarfatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:4"
      },
      "items": [
        {
          "text": "maqaa keetiifis faarfatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottaatii waan Waaqni hojjete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:5"
      },
      "items": [
        {
          "text": "hojii sodaachiisaa inni namaaf hojjete ilaalaa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni galaana lafa gogaatti geeddare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:6"
      },
      "items": [
        {
          "text": "isaanis miilla isaaniitiin laga ceʼan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:6"
      },
      "items": [
        {
          "text": "kottaa isatti haa gammannu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni bara baraan humna isaatiin bulcha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:7"
      },
      "items": [
        {
          "text": "iji isaas saboota ilaala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:7"
      },
      "items": [
        {
          "text": "finciltoonni ol ol of hin qabin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa saboota, Waaqa keenya eebbisaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:8"
      },
      "items": [
        {
          "text": "sagaleen isa galateeffatus haa dhagaʼamu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni lubbuu keenya jiraachiseera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:9"
      },
      "items": [
        {
          "text": "miilla keenyas mucucaachuu oolcheera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqayyo, ati nu qorteertaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:10"
      },
      "items": [
        {
          "text": "akkuma meetiis nu qulqulleessiteerta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati kiyyootti nu galchiteerta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:11"
      },
      "items": [
        {
          "text": "dugda keenya irras baʼaa keesseerta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka namoonni mataa keenya yaabbatan gooteerta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:12"
      },
      "items": [
        {
          "text": "nu ibiddaa fi bishaan keessa dabarre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:12"
      },
      "items": [
        {
          "text": "ati garuu iddoo badhaadhummaatti nu fidde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis qalma gubamu qabadhee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "mana qulqullummaa kee nan seena;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:13"
      },
      "items": [
        {
          "text": "wareega koos siif nan galcha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis wareega yeroo ani rakkina keessa turetti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:14"
      },
      "items": [
        {
          "text": "arrabni koo waadaa galee afaan koos dubbatee dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis horii coccoomoo, qalma gubamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:15"
      },
      "items": [
        {
          "text": "korbeeyyii hoolaa immoo aarsaa godhee siif nan dhiʼeessa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:15"
      },
      "items": [
        {
          "text": "jibootaa fi reʼoota illee aarsaa siifin dhiʼeessa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
