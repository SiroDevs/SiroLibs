                "verseId": "PSA.122.9",
                "verseOrgIds": [
                  "PSA.122.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaatiif jedhee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
