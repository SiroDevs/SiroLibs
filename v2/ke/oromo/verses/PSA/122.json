          "text": "Mana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
