          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkana jedhaa nagaa Yerusaalemiif kadhadhaa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:6"
      },
      "items": [
        {
          "text": "\"Warri si jaallatan nagaan haa jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 122:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dallaa kee keessa nagaan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:7"
      },
      "items": [
        {
          "text": "masaraa mootummaa keetii keessa immoo tasgabbiin haa jiraatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 122:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani obboloota kootii fi michoota kootiif jedhee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:8"
      },
      "items": [
        {
          "text": "\"Nagaan si keessa haa jiraatu\" nan jedha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
