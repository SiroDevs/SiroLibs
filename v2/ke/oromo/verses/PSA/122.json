          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teessoowwan murtii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
