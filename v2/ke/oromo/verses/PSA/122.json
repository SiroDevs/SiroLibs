      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:5"
      },
      "items": [
        {
          "text": "teessoowwan mana Daawit achi dhaabatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
