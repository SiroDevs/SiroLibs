                "verseId": "PSA.122.1",
                "verseOrgIds": [
                  "PSA.122.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dhaqnaa\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
