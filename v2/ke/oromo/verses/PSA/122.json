      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:9"
      },
      "items": [
        {
          "text": "ani akka wanni gaariin siif taʼu nan hawwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
