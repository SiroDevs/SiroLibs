      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "saba isaa ni marsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
