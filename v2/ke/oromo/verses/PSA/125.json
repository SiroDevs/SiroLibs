                "verseId": "PSA.125.2",
                "verseOrgIds": [
                  "PSA.125.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ammaa jalqabee hamma bara baraatti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
