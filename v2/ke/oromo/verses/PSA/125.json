      "attrs": {
        "style": "q2",
        "vid": "PSA 125:4"
      },
      "items": [
        {
          "text": "warra garaa isaaniitiin toloota taʼaniifis waan gaarii godhi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
