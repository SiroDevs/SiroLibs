                "verseId": "PSA.125.4",
                "verseOrgIds": [
                  "PSA.125.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", warra gaariif,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
