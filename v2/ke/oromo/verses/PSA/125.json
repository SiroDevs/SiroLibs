                "verseOrgIds": [
                  "PSA.125.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akkuma warra hammina hojjetan balleessu jaras ni balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
