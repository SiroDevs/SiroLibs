          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.1",
                "verseOrgIds": [
                  "PSA.125.1"
                ]
              }
            }
          ]
        },
        {
          "text": "amanatan akka Tulluu Xiyoon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:1"
      },
      "items": [
        {
          "text": "kan hin raafamne, kan bara baraan jiraatu sanaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
