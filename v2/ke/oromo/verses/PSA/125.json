          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra karaa micciiramaatti garagalan garuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
