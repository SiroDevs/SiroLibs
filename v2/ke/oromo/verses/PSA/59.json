      "attrs": {
        "style": "q2",
        "vid": "PSA 59:13"
      },
      "items": [
        {
          "text": "hamma handaara lafaatti ni beekama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.14"
            ]
