      "attrs": {
        "style": "q2",
        "vid": "PSA 92:7"
      },
      "items": [
        {
          "text": "jalʼoonni hundinuus yoo daraaran iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
