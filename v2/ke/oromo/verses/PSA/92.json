      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:3"
      },
      "items": [
        {
          "text": "sagalee baganaatiinis labsuun gaarii dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
