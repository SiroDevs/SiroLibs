                "verseId": "PSA.92.1",
                "verseOrgIds": [
                  "PSA.92.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", galateeffachuun, yaa Waaqa Waan Hundaa Olii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
