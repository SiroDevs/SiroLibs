        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.92.4",
                "verseOrgIds": [
                  "PSA.92.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ati hojii keetiin na gammachiiftaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
