      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:13"
      },
      "items": [
        {
          "text": "oobdii Waaqa keenyaa keessattis itti tolee misanii jiran.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.13",
            "verseOrgIds": [
              "PSA.92.14"
            ]
          }
        }
      ]
    },
