      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:6"
      },
      "items": [
        {
          "text": "gowwaanis hin hubatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
