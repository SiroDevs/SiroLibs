      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:4"
      },
      "items": [
        {
          "text": "ani sababii hojii harka keetiitiif gammachuudhaan nan faarfadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
