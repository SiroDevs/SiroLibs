          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan amma iyyuu bara dullumaa keessa ija naqatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.14",
            "verseOrgIds": [
              "PSA.92.15"
            ]
          }
        }
      ]
    },
    {
