      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:1"
      },
      "items": [
        {
          "text": "maqaa keetiif faarfachuun gaarii dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
