          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni qalbii hin qabne waan kana beekuu hin dandaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
