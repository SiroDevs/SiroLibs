  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "1CO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israaʼeloota Irraa Haa barannu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota, akka abbootiin keenya hundi duumessa jala turan, akka hundi isaaniis galaana keessa darban akka isin utuu hin beekin haftan ani hin barbaadu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundi isaaniis kan Musee taʼuuf duumessaa fi galaanaan cuuphaman.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundi isaaniis nyaata hafuuraa tokkicha nyaatan.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.3",
            "verseOrgIds": [
              "1CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundi isaaniis dhugaatii hafuuraa tokkicha dhugan. Isaan kattaa hafuuraa isa isaan wajjin deemaa ture irraa dhuganiiruutii; kattaan sunis Kiristoos ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
            "verseOrgIds": [
              "1CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼu iyyuu waan Waaqni hedduu isaaniitti hin gammadiniif isaan lafa gammoojjii keessatti dhuman.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni kunneen akka nu akkuma isaanii waan hamaa hin hawwineef fakkeenya nuu taʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan keessaa namoonni tokko tokko godhan sana isin waaqota tolfamoo hin waaqeffatinaa; kunis akkuma, \"Namoonni nyaachuu fi dhuguuf tataaʼan; sirbuufis kaʼan\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.7",
            "verseOrgIds": [
              "1CO.10.7"
            ]
          }
        },
        {
          "text": "jedhamee barreeffamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.7",
            "verseOrgIds": [
              "1CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan keessaa namoonni tokko tokko halalummaa raawwatanii guyyaa tokkotti namoonni 23,000 dhuman sana, nu halalummaa raawwachuu hin qabnu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.8",
            "verseOrgIds": [
              "1CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan keessaa tokko tokko Gooftaa qoranii bofaan ajjeefaman sana nu Gooftaa qoruu hin qabnu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin akka isaan keessaa tokko tokko guungumanii isa nama balleessuun balleeffaman sana hin guunguminaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun hundi akka fakkeenya taʼuuf isaan irratti raawwatame; nuu warra dhumni baraa itti dhufeef immoo akka of eeggannaa taʼuuf barreeffame.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu namni waan dhaabate of seʼu akka hin kufneef of haa eeggatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.12",
            "verseOrgIds": [
              "1CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qorama nama irra gaʼu malee qoramni tokko iyyuu isinitti hin dhufne. Waaqnis amanamaa dha; inni akka isin waan baachuu hin dandeenyeen qoramtan isin hin godhu. Yommuu qoramtanitti garuu inni akka isin obsuu dandeessaniif karaa ittiin keessaa baatan isiniif qopheessa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waaqota Tolfamoo Irraa Fagaachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu yaa michoota ko, isin waaqota tolfamoo waaqeffachuu irraa baqadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.14",
            "verseOrgIds": [
              "1CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani namoota hubannaa qabanittin dubbadha; waan ani dubbadhu isinuu murteessaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.15",
            "verseOrgIds": [
              "1CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xoofoon eebbaa kan nu eebbifnu sun dhiiga Kiristoos wajjin tokkummaa qaba mitii? Buddeenni nu caccabsinu sunis foon Kiristoos wajjin tokkummaa qaba mitii?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.16",
            "verseOrgIds": [
              "1CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan buddeenni tokko qofti jiruuf, nu baayʼee taanu iyyuu dhagnuma tokko; hundi keenya buddeenuma tokkicha sana irraa hirmaannaatii.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.17",
            "verseOrgIds": [
              "1CO.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee saba Israaʼel ilaalaa: Warri aarsaa irraa nyaatan sun iddoo aarsaa irraa qooda qabu mitii?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
            "verseOrgIds": [
              "1CO.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa maal jechuu koo ti? Nyaanni waaqota tolfamoof aarsaa dhiʼeeffamu wayi moo ree yookaan Waaqni tolfamaan wayi moo ree jechuu kootii?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.19",
            "verseOrgIds": [
              "1CO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkas miti; aarsaan namoonni ormaa dhiʼeessan hafuurota hamoodhaaf malee Waaqaaf miti; ani akka isin hafuurota hamoo wajjin tokkummaa qabaattan hin barbaadu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.20",
            "verseOrgIds": [
              "1CO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin xoofoo Gooftaatii fi xoofoo hafuurota hamoo dhuguu hin dandeessan; maaddii Gooftaatii fi maaddii hafuurota hamoo irrattis hirmaachuu hin dandeessan.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.21",
            "verseOrgIds": [
              "1CO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu Gooftaa hinaaffaaf kakaafnaa? Nu isa caalaas jabaannaa?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.22",
            "verseOrgIds": [
              "1CO.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bilisummaa Amantootaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wanni hundinuu anaaf eeyyamamaa dha;\" kan faayidaa qabu garuu waan hunda miti. \"Wanni hundinuu anaaf eeyyamamaa dha;\" kan nama fayyadu garuu waan hunda miti.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko iyyuu waan warra kaaniif gaarii taʼe barbaaduu qaba malee waan ofii isaatiif gaarii taʼe barbaaduu hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.24",
            "verseOrgIds": [
              "1CO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu gaaffii qalbii keessaa tokko illee hin kaasin waan gabaa fooniitti gurguramu kam iyyuu nyaadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.25",
            "verseOrgIds": [
              "1CO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laftii fi wanni lafa irra jiru hundinuu kan Gooftaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.26",
            "verseOrgIds": [
              "1CO.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra hin amanin keessaa yoo namni tokko nyaataaf isin affeere, isinis yoo dhaquu barbaaddan dhaqaa; utuu gaaffii qalbii keessaa tokko illee hin kaasin waan isin duratti dhiʼeeffame kam iyyuu nyaadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.27",
            "verseOrgIds": [
              "1CO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo namni tokko, \"Kun waaqota tolfamoodhaaf dhiʼeeffame\" isiniin jedhe, sababii namicha isinitti hime sanaatii fi sababii qalbiitiif waan sana hin nyaatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.28",
            "verseOrgIds": [
              "1CO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanas qalbii namicha sanaati malee kan keeti jechuu koo miti. Maaliif qalbii nama biraatiin bilisummaa kootti murama ree?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.29",
            "verseOrgIds": [
              "1CO.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ergan galateeffachuudhaan nyaata sana irratti hirmaadhee maaliifan waan ittiin Waaqa galateeffadhuun balaaleffatama ree?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
