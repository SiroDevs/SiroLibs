  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1TI 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulaagaa Phaaphaasotaa fi Daaqonootaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jechi, \"Eenyu iyyuu yoo Phaaphaasii taʼuu hawwe, hojii gaarii hawwa\" jedhu kun amanamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa Phaaphaasiin kan mudaa hin qabne, kan niitii tokkittii qabu, amala qabeessa, kan of qabu, kabajamaa, kan keessummaa simatu, kan barsiisuu dandaʼu,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kan hin machoofne, kan goolii kaasu utuu hin taʼin obsa qabeessa, kan lola hin jaallannee fi kan maallaqa hin jaallanne taʼuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.3",
            "verseOrgIds": [
              "1TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis maatii ofii isaa sirriitti bulfatee akka ijoolleen isaa kabaja maluun isaaf ajajaman mirkaneessuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko yoo maatii ofii isaa akka itti bulfatu hin beekne inni akkamitti waldaa kiristaanaa Waaqaa eeguu dandaʼaa?",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akka of jajuudhaan afuufamee murtii diiyaabiloos keessatti hin kufneef nama dhiʼoo amane hin taʼin.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.6",
            "verseOrgIds": [
              "1TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka hin tuffatamnee fi akka kiyyoo diiyaabiloos keessattis hin kufneef warra alaa biratti maqaa gaarii haa qabaatu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqonoonnis akkasuma namoota kabajaman, warra afaan lama hin dubbanne, warra dhugaatii daadhii wayiniitiin hin fudhatamnee fi warra buʼaa hin malle argachuuf hin tattaaffanne taʼuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaada qulqulluunis icciitii amantii jabeessanii qabachuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis duraan dursanii haa qorataman; ergasiis yoo mudaan tokko iyyuu isaan irratti hin argamin daaqonoota taʼanii haa tajaajilan.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.10",
            "verseOrgIds": [
              "1TI.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas dubartoonni isaanii kabajamoo, kanneen maqaa nama hin balleessine, amala qabeeyyii fi waan hundaan amanamoo taʼuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqoniin tokko dhirsa niitii tokkittii, kan ijoollee isaatii fi warra mana isaa jiraatan sirriitti bulchu taʼuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.12",
            "verseOrgIds": [
              "1TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri daaqonummaan sirriitti tajaajilan ulfina guddaa, amantii Kiristoos Yesuusitti qabaniin immoo ija jabina guddaa argatu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sababii Phaawulos Qajeelcha Kennuuf",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akkan dafee gara kee dhufu abdadhee qajeelfama kana siif nan barreessa;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.14",
            "verseOrgIds": [
              "1TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanas tarii yoo ani ture, namni tokko akkamitti akka mana Waaqaa keessa jiraachuu qabu akka beektuufin siif barreessa; manni Waaqaa kunis waldaa Waaqa jiraataa isa utubaa fi hundee dhugaa taʼee dha.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqatti buluun shakkii tokko malee icciitii guddaa of keessaa qaba; kunis,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "Inni fooniin mulʼate;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "Hafuuraan mirkaneeffame;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "ergamoota Waaqaatu isa arge;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "saboota keessatti lallabame;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "addunyaa irratti itti amaname;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "ulfinaan ol fudhatame.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    }
  ],
