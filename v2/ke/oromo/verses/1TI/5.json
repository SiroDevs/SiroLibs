        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maanguddootaa fi Dargaggoota",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dulloome tokko akka waan inni abbaa kee taʼeetti gorsi malee hin ifatin. Dargaggootas akka obbolootaatti ilaali;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.1",
            "verseOrgIds": [
              "1TI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "dubartoota dullooman akka haadhotiitti, dubartoota shamarran akka obboleettotaatti qulqullummaa guutuun ilaali.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.2",
            "verseOrgIds": [
              "1TI.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haadhota Hiyyeessaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haadhota hiyyeessaa kanneen dhugumaan rakkattoota taʼan kabaji.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.3",
            "verseOrgIds": [
              "1TI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu haati hiyyeessaa tokko yoo ijoollee yookaan akkoowwan qabaatte ijoolleen kunneen maatii isaanii gargaaruu fi warra isaaniitiif gatii deebisuudhaan amantii isaanii hojiin mulʼisuuf duraan dursanii barachuu qabu; kun Waaqa gammachiisaatii.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.4",
            "verseOrgIds": [
              "1TI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haati hiyyeessaa kan dhugumaan rakkattuu taatee kophaa ishee hafte abdii ishee Waaqa irra kaaʼattee halkanii guyyaa kadhannaa fi gargaarsa Waaqaa gaafachuu itti fufti.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.5",
            "verseOrgIds": [
              "1TI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haati hiyyeessaa kan jireenya gammachuutti of gattu garuu utuma jirtuu iyyuu duuteerti.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.6",
            "verseOrgIds": [
              "1TI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka namni tokko iyyuu mudaa hin qabaanneef ajaja kana kenni.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.7",
            "verseOrgIds": [
              "1TI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni firoota isaa keessumattuu miseensota maatii isaa warra isatti aannan hin gargaarre kam iyyuu amantii ganeera; inni nama hin amanne caalaattis hamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.8",
            "verseOrgIds": [
              "1TI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haati hiyyeessaa tokko yoo umuriin ishee waggaa jaatamaa ol taʼee akkasumas niitii dhirsa tokkichaa turte taate malee maqaan ishee galmee haadhota hiyyeessaa irratti hin galmeeffamin;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.9",
            "verseOrgIds": [
              "1TI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas isheen hojii gaarii hojjechuudhaan jechuunis ijoollee guddisuudhaan, keessummaa simachuudhaan, miilla qulqullootaa dhiquudhaan, warra rakkatan gargaaruudhaan, karaa hundumaanis hojii gaarii hojjechuu keessatti of kennuudhaan kan beekamte taʼuu qabdi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.10",
            "verseOrgIds": [
              "1TI.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haadhota hiyyeessaa",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.11",
            "verseOrgIds": [
              "1TI.5.11"
            ]
          }
        },
        {
          "text": "kanneen shamarran taʼan garuu hin galmeessin. Isaan yommuu hawwiin foonii Kiristoos irraa gargar isaan baasutti deebiʼanii heerumuu barbaaduutii.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.11",
            "verseOrgIds": [
              "1TI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaanis isaan waan kakuu isaanii kan jalqabaa cabsaniif murtii ofitti fidu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.12",
            "verseOrgIds": [
              "1TI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana malees manaa gara manaatti labanii dhibaaʼummaa baratu. Dhibaaʼummaa qofa utuu hin taʼin waan dubbachuun isaaniif hin malle dubbachuudhaan nama hamatu; dhimma namaa keessas galu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.13",
            "verseOrgIds": [
              "1TI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu haadhonni hiyyeessaa kanneen ijoollummaa qaban akka carraa maqaa nu balleessuu diinaaf hin kennineef ani akka isaan heeruman, akka ijoollee daʼanii fi akka mana isaanii bulfatan nan gorsa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.14",
            "verseOrgIds": [
              "1TI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni tokko tokko Seexana duukaa buʼuuf jedhanii duraanuu karaa irraa goraniiru.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.15",
            "verseOrgIds": [
              "1TI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin amantu kam iyyuu yoo haadhota hiyyeessaa maatii ishee keessaa qabaatte, akka waldaan kiristaanaa haadhota hiyyeessaa kanneen dhugumaan rakkattoota taʼan gargaartuuf isheen isaan haa gargaartuu malee akka waldaa kiristaanaatti baʼaa taʼan hin godhin.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.16",
            "verseOrgIds": [
              "1TI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jaarsolii Waldaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaarsoliin sirriitti waldaa kiristaanaa bulchan keessumattuu warri hojiin isaanii lallabuu fi barsiisuu taʼe ulfina dachaa argachuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.17",
            "verseOrgIds": [
              "1TI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katabbiin Qulqulluun, \"Qotiyyoo midhaan siribsiisuutti jiru afaan hin hidhin;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "text": "\" akkasumas, \"Hojjetaaf mindaa isaa argachuun ni mala",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "text": "\" jedhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo dhuga baatota lamaan yookaan sadiin mirkaneeffame malee himata jaarsa tokko mormuun dhiʼeeffamu kam iyyuu hin fudhatin.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.19",
            "verseOrgIds": [
              "1TI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka warri kaan sodaataniif namoota cubbuu hojjetan fuula namoota hundaa duratti itti dheekkami.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka ati waan tokko iyyuu loogiidhaan hin goonee fi akka wal caalchisuu malee ajajawwan kanneen eegduuf fuula Waaqaatii fi fuula Kiristoos Yesuus duratti, fuula ergamoota filatamanii durattis sin gorsa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.21",
            "verseOrgIds": [
              "1TI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eenyu irra iyyuu harka kaaʼuuf hin ariifatin; cubbuu nama biraa keessatti hin hirmaatin. Qulqullummaadhaanis of eeggadhu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
            "verseOrgIds": [
              "1TI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii garaa keetiitii fi dhukkuba ammumaa amma sitti kaʼu sanaatiif daadhii wayinii xinnoo ishee dhugi malee bishaan qofa hin dhugin.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cubbuun namoota tokko tokkoo duraan dursee ifatti mulʼata; isaan dura darbees lafa murtii gaʼa; cubbuun warra kaanii garuu duuba irratti beekama.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.24",
            "verseOrgIds": [
              "1TI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojiin gaariinis akkasuma ifatti mulʼata; kan ifatti hin mulʼannes dhokfamee hafuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.25",
            "verseOrgIds": [
              "1TI.5.25"
            ]
          }
        }
      ]
    }
  ],
