      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seera Dhukkuba Gogaa kan Namatti Darbuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "LEV.13.1",
                "verseOrgIds": [
                  "LEV.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee fi Arooniin akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni yoo gogaa dhagna isaa irraa iitoo yookaan finniisa yookaan baarolee qabaatee wanni sun gogaa dhagna isaa irratti gara lamxiitti geeddarame, namichi sun gara Aroon lubichaatti yookaan ilmaan isaa luboota keessaa gara isa tokkootti haa geeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.2",
            "verseOrgIds": [
              "LEV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni sun madaa gogaa dhagna namichaa irra jiru haa qoru; yoo rifeensi madaa sana irra jiru addaatee madaan sun gogaa keessa darbee foonitti gad seene, dhukkubni sun dhukkuba lamxii ti. Lubichis erga isa qoree booddee akka inni akka seeraatti xuraaʼaa taʼe haa labsu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.3",
            "verseOrgIds": [
              "LEV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo baaroleen gogaa namichaa irra jiru addaatee garuu gogaa keessa darbee foonitti gad hin seenin, yoo rifeensi madaa sana irra jirus hin addaatin, lubichi namicha madaaʼe sana bultii torba kophaatti baasee haa tursu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.4",
            "verseOrgIds": [
              "LEV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii torbaffaatti immoo lubichi isa haa qoru; lubni yoo akka madaan sun hin geeddaraminii fi akka inni gogaa namichaa irra hin faffacaʼin arge ammas bultii torba kophaatti baasee isa haa tursu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.5",
            "verseOrgIds": [
              "LEV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma illee lubichi bultii torbaffaatti namicha haa qoru; kunoo, yoo madaan sun qooree gogaa irra hin faffacaʼin, lubichi akka namichi qulqulluu taʼe haa labsu; wanni sun cittoo dha. Namichi wayyaa isaa haa miiccatu; inni ni qulqullaaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.6",
            "verseOrgIds": [
              "LEV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu inni erga qulqulluu taʼuun isaa akka labsamuuf lubatti of argisiisee booddee yoo cittoon sun gogaa isaa irra faffacaʼe inni amma illee lubatti of argisiisuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.7",
            "verseOrgIds": [
              "LEV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubichis isa haa qoru; yoo cittoon sun gogaa irra faffacaʼee jiraate lubichi akka inni xuraaʼaa taʼe haa labsu; wanni kun lamxii dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni yoo lamxii qabaate inni lubatti fidamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.9",
            "verseOrgIds": [
              "LEV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubichi isa haa qoru; kunoo yoo iiti adiin kan rifeensa addeesse gogaa irra jiraatee fi foon iita sanaa diimatee mulʼate,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.10",
            "verseOrgIds": [
              "LEV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "wanni sun dhukkuba gogaa kan hin fayyinee dha; lubichis akka namichi xuraaʼaa taʼe haa labsu. Waan inni duraanuu xuraaʼaa taʼeef lubichi kophaatti baasee isa tursuun barbaachisaa miti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhukkubni sun hamma lubni arguu dandaʼutti gogaa isaa irra yoo faffacaʼee gogaa namicha madaaʼe sanaa mataadhaa hamma miillaatti haguuge,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.12",
            "verseOrgIds": [
              "LEV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "lubichi isa haa qoru; kunoo yoo dhukkubni sun guutumaan guutuutti dhagna namichaa wal gaʼe inni akka namichi qulqulluu taʼe haa labsu. Waan dhagni isaa guutuun addaateef namichi sun qulqulluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.13",
            "verseOrgIds": [
              "LEV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu yeroo iita foon isaa keessaan diimatee mulʼatu qabaatu xuraaʼaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.14",
            "verseOrgIds": [
              "LEV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubichi yeroo foon diimatee mulʼatu argutti akka namichi sun xuraaʼaa taʼe haa labsu; foon diimate xuraaʼaa dha; namichis lamxii qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.15",
            "verseOrgIds": [
              "LEV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yookaan yoo foon diimaan geeddaramee addaate namichi lubatti of argisiisuu haa dhaqu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.16",
            "verseOrgIds": [
              "LEV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubnis isa haa qoru; yoo madaan sun addaate lubichi akka namichi madaaʼe sun qulqulluu taʼe haa labsu; namichis ni qulqullaaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni gogaa isaa irraa dhullaa yoo qabaatee dhullaan sun fayyee jiraate,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.18",
            "verseOrgIds": [
              "LEV.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo iddoo dhullaan ture sanatti iiti adiin yookaan baaroleen diimaan adiin mulʼate inni lubatti of haa argisiisu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.19",
            "verseOrgIds": [
              "LEV.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubnis isa haa qoru; kunoo yoo wanni sun waan gogaa keessa darbee foon seene fakkaatee rifeensi isa keessaas addaate lubichi akka inni xuraaʼaa taʼe haa labsu. Wanni kun dhukkuba lamxii iddoo dhullaan turetti baʼee dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.20",
            "verseOrgIds": [
              "LEV.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yommuu lubni baarolee sana qorutti, kunoo yoo rifeensi adiin irra hin jiraatinii fi yoo baaroleen sun utuu gogaa darbee foon hin seenin qooree jiraate lubni kophaatti baasee bultii torba isa haa tursu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.21",
            "verseOrgIds": [
              "LEV.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo baaroleen sun gogaa irra faffacaʼe, lubichi akka namni sun xuraaʼaa taʼe haa labsu; kun dhukkuba namatti darbuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.22",
            "verseOrgIds": [
              "LEV.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu baaroleen sun yoo hin geeddaraminii fi yoo hin faffacaʼin, inni godaannisa dhullaa sanaa ti; lubnis akka namichi qulqulluu taʼe haa labsu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.23",
            "verseOrgIds": [
              "LEV.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yoo namni gogaa isaa irraa gubaa qabaatee foon diimaa iddoo gubamaa sanaa irratti baaroleen diimaan adiin yookaan adiin mulʼate,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.24",
            "verseOrgIds": [
              "LEV.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "lubni baarolee sana haa qoru; kunoo yoo rifeensi achi irra jiru addaatee baaroleen sunis gogaa keessa darbee foon seene wanni kun lamxii iddoo gubate sana irratti baʼuu dha. Lubichi akka namni sun xuraaʼaa taʼe haa labsu; dhukkubni kun dhukkuba lamxii ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.25",
            "verseOrgIds": [
              "LEV.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo lubni iddoo gubate sana qoree rifeensi adiin baarolee sana irra hin jiraatinii fi yoo baaroleen sun utuu gogaa keessa darbee foon hin seenin qooree jiraate lubichi namicha sana kophaatti baasee bultii torba haa tursu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.26",
            "verseOrgIds": [
              "LEV.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa torbaffaatti lubichi isa haa qoru; yoo baaroleen sun gogaa irra faffacaʼee jiraate lubni sun akka namichi xuraaʼaa taʼe haa labsu; dhukkubni kun dhukkuba lamxii ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.27",
            "verseOrgIds": [
              "LEV.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus yoo baaroleen sun hin geeddaraminii fi utuu gogaa irra hin faffacaʼin bade wanni kun iitoo gubaa sana keessa baʼee dha. Lubichi akka namichi qulqulluu taʼe haa labsu; wanni kun godaannisa gubaa sanaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.28",
            "verseOrgIds": [
              "LEV.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yoo dhiirri yookaan dubartiin mataa irraa yookaan areeda irraa madaa qabaatan,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "lubni madaa sana haa qoru; kunoo yoo madaan sun gogaa keessa darbee foon seenee rifeensi achi irra jiru keelloo fakkaatee qaqalʼate, lubichi akka namichi sun xuraaʼaa taʼe haa labsu; kun hooqxoo mataa yookaan areedaa kan namatti darbuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo lubni madaa akkanaa qorutti kunoo yoo madaan sun waan gogaa darbee foon seene hin fakkaatinii fi yoo rifeensi gurraachi tokko iyyuu madaa sana irra hin jiraatin lubni sun namicha hooqxoon qabe sana kophaatti baasee bultii torba haa tursu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa torbaffaatti lubni madaa sana haa qoru; kunoo yoo hooqxoon sun hin faffacaʼin, yoo rifeensi keelloon achi irra hin jiraatinii fi hooqxoon sun waan gogaa keessa darbee foon seene hin fakkaatin,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "namichi sun iddoo madaaʼe sana qofa dhiisee mataa isaa haa haadatu; lubni sunis ammas namicha sana kophaatti baasee bultii torba haa tursu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa torbaffaattis lubni sun hooqxoo sana haa qoru; kunoo yoo hooqxoon sun gogaa irra hin faffacaʼinii fi waan gogaa keessa darbee foon seene hin fakkaatin lubichi akka namichi sun qulqulluu taʼe haa labsu; namichi wayyaa isaa haa miiccatu; innis ni qulqullaaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu erga akka namichi qulqulluu taʼe labsamee booddee yoo hooqxoon sun gogaa irra faffacaʼe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "lubni isa haa qoru; kunoo yoo hooqxoon sun gogaa irra faffacaʼee jiraate lubichi rifeensa keelloo sakattaʼuu hin qabu; namichi sun xuraaʼaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akka hubannaa lubichaatti hooqxoon sun geeddaramuu baatee rifeensi gurraachi irratti biqillaan hooqxoon sun fayyeera; namichis qulqulluu dha; lubnis akka inni qulqulluu taʼe haa labsu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yommuu dhiirri yookaan dubartiin gogaa dhagna isaa irraa baarolee qabaatanitti,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "lubni isaan haa qoru; kunoo yoo baaroleen sun adii daalacha taʼe kun cittoo gogaa irratti baʼe kan nama hin miinee dha; namichis qulqulluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni yoo rifeensi mataa isaa dhumee molaaʼe inni qulqulluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
              "LEV.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo rifeensi mataa isaa fuula duraan irraa dhumee molaaʼes inni qulqulluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu inni yoo moluu mataa isaa irraa yookaan moluu adda isaa irraa madaa adii diimatu qabaate wanni kun lamxii moluu mataa isaa yookaan moluu adda isaa keessaa baʼuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni isa haa qoru; kunoo yoo madaan iitaʼe kan mataa isaa irraa yookaan adda isaa irraa sun akkuma lamxii gogaa irratti baʼee adii diimatu taʼe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "namichi dhukkubsataa fi xuraaʼaa dha. Sababii madaa mataa namichaa irra jiru sanaatiifis akka namichi xuraaʼaa taʼe lubni sun haa labsu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni lamxii akkasii qabu uffata tatarsaʼaa haa uffatu; rifeensa mataa isaatti waa hin maratin; afaan isaas haguuggatee, 'Ani xuraaʼaa dha! Ani xuraaʼaa dha!' jedhee haa iyyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.45",
            "verseOrgIds": [
              "LEV.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hamma dhukkubni sun irra jirutti xuraaʼaa dha; kophaa isaa haa jiraatu; qubata keessaas baʼee ala haa jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lamxii Uffata Irratti Mulʼatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yoo uffanni suufii irraa yookaan quncee talbaa irraa hojjetame kam iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "uffanni quncee talbaa irraa yookaan suufii irraa dhaʼame yookaan wal keessa loofamee hojjetame kam iyyuu, gogaan yookaan wanni gogaa irraa hojjetame kam iyyuu lamxii qabaate,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo dhukkubni uffata irra yookaan gogaa irra yookaan uffata dhaʼame irra yookaan wal keessa loofamee hojjetame irra yookaan miʼa gogaa irra jiru sun magariisa taʼe yookaan diimate wanni kun waan lamxii taʼeef lubatti haa argisiifamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubnis lamxii sana qoree miʼa dhukkubaan faalame sana kophaatti baasee bultii torba haa tursu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa torbaffaatti lubichi lamxii sana haa qoru; yoo lamxiin sun uffata irra yookaan wayyaa dhaʼame irra yookaan uffata wal keessa loofamee hojjetame irra yookaan gogaa waan kamiif iyyuu fayyadu irra faffacaʼe wanni kun lamxii hamaa dha; miʼi sunis xuraaʼaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii lamxiin sun hamaa taʼeef lubichi uffata yookaan wayyaa suufii irraa yookaan quncee talbaa irraa hojjetame yookaan wal keessa loofamee hojjetame yookaan miʼa gogaa irraa hojjetame kan dhukkuba sanaan faalame kam iyyuu haa gubu; miʼi sunis gubamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Garuu yeroo lubni lamxii sana qorutti kunoo yoo lamxiin sun uffata irra yookaan wayyaa dhaʼame irra yookaan wal keessa loofamee hojjetame irra yookaan miʼa gogaa irraa hojjetame irra faffacaʼuu baate,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "lubichi akka miʼi lamxiidhaan faalame sun miiccamu haa ajaju. Ergasii immoo miʼa sana kophaatti baasee ammas bultii torba haa tursu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga miʼi lamxiidhaan faalame sun miiccamee booddee lubichi miʼa sana haa qoru; lamxiin sun yoo faffacaʼu baate illee bifti isaa geeddaramuu baannaan uffanni sun xuraaʼaa dha. Yoo lamxiin sun gama tokkoon yookaan gama kaaniin miʼa sana faalee jiraate, miʼi sun ibiddaan haa gubamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga miʼi sun miiccamee booddee yeroo lubni qorutti yoo lamxiin sun badee jiraate lubichi iddoo lamxiidhaan faalame sana uffata yookaan gogaa yookaan wayyaa dhaʼame yookaan wal keessa loofamee hojjetame irraa haa tarsaasu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo lamxiin sun deebiʼee uffata irratti yookaan wayyaa dhaʼame irratti yookaan wal keessa loofame hojjetame irratti yookaan miʼa gogaa irraa hojjetame kam iyyuu irratti argame, lamxiin sun faffacaʼaa jira; wanni lamxii qabu ibiddaan haa gubamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LEV 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uffanni yookaan wayyaan dhaʼame yookaan wal keessa loofamee hojjetame yookaan miʼi gogaa irraa hojjetame kan miiccamee lamxiin irraa bade kam iyyuu ammas haa miiccamu; innis ni qulqullaaʼa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
              "LEV.13.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LEV 13:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kun seera akka uffanni suufii irraa yookaan quncee talbaa irraa hojjetame, wayyaan dhaʼame yookaan wal keessa loofamee hojjetame yookaan miʼi gogaa irraa hojjetamee lamxiidhaan faalame kam iyyuu xuraaʼaa taʼee fi akka hin taʼin labsuuf kennamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.59",
            "verseOrgIds": [
              "LEV.13.59"
            ]
          }
        }
      ]
