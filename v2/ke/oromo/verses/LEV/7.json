          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni kam iyyuu yoo dhiiga nyaate saba ofii isaa keessaa haa balleeffamu.' \"",
          "type": "text",
          "attrs": {
