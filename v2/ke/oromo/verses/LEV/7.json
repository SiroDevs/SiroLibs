          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Israaʼelootaan akkana jedhi; 'Namni aarsaa nagaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
