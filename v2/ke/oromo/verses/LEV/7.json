                "verseId": "LEV.7.29",
                "verseOrgIds": [
                  "LEV.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
