        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Yakkaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Seerri aarsaa yakkaa kan waan hunda caalaa qulqulluu taʼe sanaa kana:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.1",
            "verseOrgIds": [
              "LEV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarsaan yakkaa iddoo aarsaan gubamu itti qalamutti haa qalamu; dhiigni isaa immoo gama hundaan iddoo aarsaatti facaafamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.2",
            "verseOrgIds": [
              "LEV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moorri isaa hundinuus aarsaa taʼee dhiʼeeffamuu qaba; kunis duboo fi moora miʼa garaa haguugu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.3",
            "verseOrgIds": [
              "LEV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kalee lamaanii fi moora isaan irra jiru kan mudhiitti dhiʼaatu, haguuggiin tiruu kan kaleewwan wajjin baʼu wal faana haa dhiʼaatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.4",
            "verseOrgIds": [
              "LEV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubichis aarsaa ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.5",
            "verseOrgIds": [
              "LEV.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.5",
                "verseOrgIds": [
                  "LEV.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼaatu godhee iddoo aarsaa irratti haa gubu; kun aarsaa yakkaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.5",
            "verseOrgIds": [
              "LEV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiirri gosa lubootaa taʼe kam iyyuu foon kana nyaachuu dandaʼa; kun garuu iddoo qulqulluutti nyaatamuu qaba; aarsaan kun waan hunda caalaa qulqulluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.6",
            "verseOrgIds": [
              "LEV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Seerri aarsaan cubbuutii fi aarsaan yakkaa ittiin dhiʼeeffamu tokkuma; aarsaawwan kunneenis kan luba ittiin araara buusuu taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.7",
            "verseOrgIds": [
              "LEV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni namaaf jedhee aarsaa gubamu dhiʼeessu tokko gogaa aarsaa gubamu sanaa ofii isaatiif haa fudhatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.8",
            "verseOrgIds": [
              "LEV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kennaan midhaanii kan barbadaa ibiddaa irratti yookaan eelee irratti yookaan beddee irratti bilchaate kam iyyuu luba isa dhiʼeessuuf haa kennamu;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.9",
            "verseOrgIds": [
              "LEV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kennaan midhaanii kam iyyuu jechuunis kan zayitiin itti makame yookaan goggogaan ilmaan Aroon hundaaf wal qixxee haa kennamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Nagaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Seerri aarsaa nagaa kan namni tokko ittiin",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.11",
                "verseOrgIds": [
                  "LEV.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessuu qabu kana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Inni yoo galata galchuuf aarsaa dhiʼeeffate, aarsaa galataa kana wajjin maxinoo zayitiin itti makame, bixxillee raacitii malee tolfamee zayitiin irra dibamee fi maxinoo daakuu bullaaʼaa kan akka gaarii sukkuumamee zayitiin itti makame haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.12",
            "verseOrgIds": [
              "LEV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarsaa nagaa kan galataaf dhiʼeeffatu wajjinis kennaa maxinoo raacitii qabu haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.13",
            "verseOrgIds": [
              "LEV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarsaa hunda keessaa tokko tokko fuudhee akka kennaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.14",
            "verseOrgIds": [
              "LEV.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.14",
                "verseOrgIds": [
                  "LEV.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffamu tokkootti haa fidu; kunis luba dhiiga aarsaa nagaa facaasu sanaaf haa kennamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.14",
            "verseOrgIds": [
              "LEV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Foon aarsaa nagaa kan galataaf dhiʼeeffamu gaafuma dhiʼaate sana nyaatamee dhumuu qaba; wanni tokko iyyuu isa irraa hafee buluu hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.15",
            "verseOrgIds": [
              "LEV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo aarsaan isaa wareega guuttachuuf yookaan aarsaa fedhiidhaan dhiʼaatu taʼe, aarsaan sun guyyuma inni dhiʼeesse nyaatamuu qaba; kan hafe garuu guyyaa itti aanu nyaatamuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.16",
            "verseOrgIds": [
              "LEV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Foon aarsaa sana irraa hamma guyyaa sadaffaatti hafe gubamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.17",
            "verseOrgIds": [
              "LEV.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Foon aarsaa nagaa sana irraa yoo wanni tokko iyyuu guyyaa sadaffaatti nyaatame aarsaan sun hin fudhatamu. Kun sababii xuraaʼaa taʼeef nama dhiʼeesse sanaaf fudhatama hin qabaatu. Namni foon sana irraa nyaatu itti gaafatama.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Foon waan akka seeraatti xuraaʼaa taʼe kam iyyuu tuqe hin nyaatamin; foon sun gubamuu qaba. Foon kaan garuu namni akka seeraatti qulqulluu taʼe kam iyyuu nyaachuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.19",
            "verseOrgIds": [
              "LEV.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu namni xuraaʼaan yoo foon aarsaa nagaa kan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.20",
            "verseOrgIds": [
              "LEV.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.20",
                "verseOrgIds": [
                  "LEV.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffame nyaate, inni saba ofii keessaa haa balleeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.20",
            "verseOrgIds": [
              "LEV.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni yoo waan xuraaʼaa jechuunis xuraaʼummaa namaa yookaan horii xuraaʼaa yookaan waan xuraaʼaa kam iyyuu, waan jibbisiisaa tuqee ergasii immoo foon aarsaa nagaa kan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.21",
                "verseOrgIds": [
                  "LEV.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼaate keessaa nyaate namni sun saba ofii keessaa haa balleeffamu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moorrii fi Dhiigni Hin Sooratamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.22",
                "verseOrgIds": [
                  "LEV.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.22",
            "verseOrgIds": [
              "LEV.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Israaʼelootaan akkana jedhi; 'Moora loonii yookaan kan hoolaa yookaan kan reʼee kamii iyyuu hin nyaatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.23",
            "verseOrgIds": [
              "LEV.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Coomni horii duʼee argamee yookaan bineensi ajjeesee waan biraaf haa oolu; isin garuu isa nyaachuu hin qabdan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.24",
            "verseOrgIds": [
              "LEV.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni horii ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.25",
            "verseOrgIds": [
              "LEV.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.25",
                "verseOrgIds": [
                  "LEV.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffame irraa cooma isaa nyaate kam iyyuu saba ofii isaa keessaa haa balleeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.25",
            "verseOrgIds": [
