    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Gubamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.1",
                "verseOrgIds": [
                  "LEV.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee waamee dunkaana wal gaʼii keessaa akkana jedhee itti dubbate;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.1",
            "verseOrgIds": [
              "LEV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Israaʼelootatti dubbadhu; akkanas jedhiin: 'Isin keessaa namni kam iyyuu yommuu horii keessaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.2",
                "verseOrgIds": [
                  "LEV.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kennaa dhiʼeessutti karra loonii yookaan bushaayee keessaa haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo kennaan sun qalma gubamu kan karra loonii taʼe, namichi sun korma hirʼina hin qabne haa dhiʼeessu. Akka aarsaan sun fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.3",
            "verseOrgIds": [
              "LEV.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.3",
                "verseOrgIds": [
                  "LEV.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti fudhatama argatuufis balbala dunkaana wal gaʼii duratti haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.3",
            "verseOrgIds": [
              "LEV.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichis mataa horii aarsaa gubamuuf dhiʼeeffamu sanaa irra harka isaa haa kaaʼu; kunis araara isaaf buusuuf qooda isaa fudhatama argata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.4",
            "verseOrgIds": [
              "LEV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.5",
                "verseOrgIds": [
                  "LEV.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti korma haa qalu; ilmaan Aroon luboonni dhiiga sana fuudhanii iddoo aarsaa kan balbala dunkaana wal gaʼii dura jirutti gama hundaan haa facaasan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis aarsaa gubamu sana irraa gogaa baasee kutaa kutaatti murmura.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.6",
            "verseOrgIds": [
              "LEV.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Aroon lubichaa immoo iddoo aarsaa irratti ibidda qabsiisanii qoraan irra haa naqan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis ilmaan Aroon luboonni kutaa murmurame, mataa fi cooma isaas qoraan iddoo aarsaa irratti bobaʼu irra tarree haa naqan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
            "verseOrgIds": [
              "LEV.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis miʼa garaatii fi miilla qalma sanaa bishaaniin haa dhiqu; lubichis hunda isaa iddoo aarsaa irratti haa gubu. Kunis aarsaa gubamu kan ibiddaan dhiʼaatuu fi kan urgaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.9",
                "verseOrgIds": [
                  "LEV.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "toluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo aarsaan sun qalma gubamu kan bushaayee jechuunis hoolaa yookaan reʼee taʼe namichi dhiʼeessu sun korma hirʼina hin qabne haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.10",
            "verseOrgIds": [
              "LEV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis gama kaaba iddoo aarsaatiin fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.11",
            "verseOrgIds": [
              "LEV.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.11",
                "verseOrgIds": [
                  "LEV.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti haa qalu; ilmaan Aroon luboonni immoo gama hundaan dhiiga isaa iddoo aarsaatti haa facaasan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.11",
            "verseOrgIds": [
              "LEV.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi sunis kutaa kutaatti haa murmuru; lubichi immoo mataa fi cooma isaa qoraan iddoo aarsaa irratti bobaʼaa jiru irra tarree haa naqu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.12",
            "verseOrgIds": [
              "LEV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis miʼa garaatii fi miilla qalma sanaa bishaaniin haa dhiqu; lubichi immoo hunda isaa fidee iddoo aarsaa irratti haa gubu. Kunis aarsaa gubamu kan ibiddaan dhiʼaatuu fi kan urgaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.13",
                "verseOrgIds": [
                  "LEV.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "toluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo aarsaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.14",
            "verseOrgIds": [
              "LEV.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.14",
                "verseOrgIds": [
                  "LEV.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼaatu sun qalma gubamu kan simbirrootaa taʼe namichi sun gugee yookaan gugee sookkee haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.14",
            "verseOrgIds": [
              "LEV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubichi sun gara iddoo aarsaatti haa fidu; mataa isaas micciiree irraa haa kutu; ergasii immoo iddoo aarsaa irratti haa gubu; dhiigni isaa immoo iddoo aarsaa cinatti haa coccobu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.15",
            "verseOrgIds": [
              "LEV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miʼa garaa isaa baallee isaa wajjin baasee karaa baʼa biiftuutiin iddoo aarsaa cinatti lafa daaraan jirutti haa gatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.16",
            "verseOrgIds": [
              "LEV.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa qoochoo isaatiin haa baqaqsu; garuu guutumaan guutuutti gargar hin baasin; ergasii lubichi iddoo aarsaa irratti qoraan bobaʼaa jiru irratti haa gubu. Kunis aarsaa gubamu kan ibiddaan dhiʼaatuu fi kan urgaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.17",
            "verseOrgIds": [
              "LEV.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "LEV.1.17",
                "verseOrgIds": [
                  "LEV.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "toluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.17",
            "verseOrgIds": [
              "LEV.1.17"
            ]
          }
        }
      ]
    }
  ],
