      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "oomishni Abbayyaa Xiiroosiif galii ture;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
