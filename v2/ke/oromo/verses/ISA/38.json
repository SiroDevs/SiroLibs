    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa Hisqiyaas dhukkubsatee duʼuu gaʼee ture. Isaayyaas ilmi Amoos raajichi gara isaa dhaqee, \"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.1",
                "verseOrgIds": [
                  "ISA.38.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Mana kee tottolfadhu; ati ni duuta malee hin fayyituutii\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis fuula isaa gara keenyan manaatti garagalfatee akkana jedhee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.2",
                "verseOrgIds": [
                  "ISA.38.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kadhate;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.3",
                "verseOrgIds": [
                  "ISA.38.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", akka ani amanamummaa fi garaa tokkoon fuula kee dura jiraadhee waan fuula kee duratti gaarii taʼes hojjedhe yaadadhu.\" Hisqiyaasis hiqqifatee ni booʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.4",
                "verseOrgIds": [
                  "ISA.38.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara Isaayyaas dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhaqiitii akkana jedhii Hisqiyaasitti himi; '",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.5",
                "verseOrgIds": [
                  "ISA.38.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni abbaa kee Daawit akkana jedha: Ani kadhannaa kee dhagaʼeera; imimmaan kees argeera; ani umurii kee irratti waggaa kudha shan siifan dabala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani siʼii fi magaalaa kana harka mooticha Asooriitii nan baasa. Ani magaalaa kana nan eega.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kun mallattoo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.7",
                "verseOrgIds": [
                  "ISA.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "kan akka inni waan waadaa gale sana guutu mirkaneessuuf",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.7",
                "verseOrgIds": [
                  "ISA.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa siif kennamee dha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka gaaddidduun aduu tarkaanfii kurnan gulantaa Aahaaz irraan gad buʼe sana dugda duubatti deebiʼu nan godha.' \" Kanaafuu gaaddidduun tarkaanfii kurnan gad buʼee ture sun dugda duubatti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barreeffama Hisqiyaas mootichi Yihuudaa erga dhukkubsatee fayyee booddee barreesse:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis, \"Walakkaa umurii kootiitti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:10"
      },
      "items": [
        {
          "text": "ani siiʼool seenuun qabaa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:10"
      },
      "items": [
        {
          "text": "Bara jireenya koo kan hafes dhabuun qabaa?\" nan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akkanan jedhe; \"Ani biyya jiraattotaa keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "lammata",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.11",
                "verseOrgIds": [
                  "ISA.38.11"
                ]
              }
            }
          ]
        },
        {
          "text": "hin argu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "ani siʼachi sanyii namaa hin ilaalu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "yookaan warra addunyaa kana irra jiraatan wajjin hin jiraadhu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manni koo akkuma dunkaana tiksootaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "buqqifamee narraa fudhatameera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "Ani akkuma wayyaa dhooftuu jireenya koo marmareera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "inni miʼa wayyaa dhooftuu irraa na kuteera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "ati halkanii guyyaa na balleessita.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani hamma bariitti obsaan nan eeggadhe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:13"
      },
      "items": [
        {
          "text": "inni garuu akka leencaa lafee koo hunda caccabse;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:13"
      },
      "items": [
        {
          "text": "ati halkanii guyyaas na balleessita.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka simbirroo yookaan akkuma daalotee nan wace;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:14"
      },
      "items": [
        {
          "text": "akka gugee boossuus nan aade;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:14"
      },
      "items": [
        {
