    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isaayyaasii fi Ijoollee Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.1",
                "verseOrgIds": [
                  "ISA.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana naan jedhe; \"Gabatee guddaa tokko fuudhiitii isa irratti, 'Maheer-Shaalaal-Haash-Baaz'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "text": "jedhii qubee beekamaadhaan barreessi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka isaan dhuga baatota amanamoo taʼaniif Uuriyaa lubichaa fi Zakkaariyaas ilma Yeberekiyaa nan waammadha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis raajittii bira nan gaʼe; isheenis ulfooftee ilma deesse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.3",
                "verseOrgIds": [
                  "ISA.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana naan jedhe; \"Maqaa isaa Maheer-Shaalaal-Haash-Baaz jedhii moggaasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu mucaan kun 'Aabboo' yookaan 'Aayyoo' jechuu hin beekin dura qabeenyi Damaasqootii fi boojuun Samaariyaa mootii Asooriin fudhatama.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.5",
                "verseOrgIds": [
                  "ISA.8.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ammas akkana jedhee natti dubbate:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.5",
            "verseOrgIds": [
              "ISA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sabni kun bishaan Shilooʼaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "kan suuta yaaʼu sana dhiisee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "Reziinii fi ilma Remaaliyaatti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "gammadeeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu Gooftaan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "lolaa guddaa kan laga Efraaxiis jechuunis mootii Asoor",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "ulfina isaa hunda wajjin saba kanatti fida.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "Lolaan sunis guutee boʼoo isaa irra yaaʼee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "ededa isaa hunda irra dhangalaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolaan sunis hamma morma gaʼutti guutee irra dhangalaʼee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "keessa darbuudhaan waan hundumaa haxaaʼee Yihuudaatti geessa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "Yaa Amaanuʼel!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "Qoochoon isaa balʼifamee guutummaa biyya keetii ni haguuga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa saboota, burkutaaʼaa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Isin warri biyya fagoo jirtan hundi dhaggeeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Waraanaaf hidhadhaa; taʼus burkutaaʼaa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Waraanaaf hidhadhaa; taʼus burkutaaʼaa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariʼadhaa; garuu faayidaa hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:10"
      },
      "items": [
        {
          "text": "karoorfadhaa; garuu fiixaan hin baʼu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:10"
      },
      "items": [
        {
          "text": "Waaqni nu wajjin jiraatii.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.11",
                "verseOrgIds": [
                  "ISA.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "harka isaa jabaa sanaan natti dubbatee akka ani karaa saba kanaa irra hin deemneef akkana jedhee na akeekkachiiseeraatii:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
            "verseOrgIds": [
              "ISA.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin waan uummanni kun fincila jedhu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "hundaan fincila hin jedhinaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "waan isaan sodaatan hin sodaatinaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "hin raafaminaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kan isin akka qulqulluutti ilaaluu qabdan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.13",
                "verseOrgIds": [
                  "ISA.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu tokkicha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:13"
      },
      "items": [
        {
          "text": "kan isin sodaachuu qabdan isuma;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:13"
      },
      "items": [
        {
          "text": "kan isin hollachuufii qabdanis isuma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni iddoo qulqulluu taʼa;",
          "type": "text",
