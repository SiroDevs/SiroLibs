      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "\"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
