      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "na jajjabeessiteertaatii sin galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
