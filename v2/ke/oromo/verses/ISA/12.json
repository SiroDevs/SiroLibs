              "type": "text",
              "attrs": {
                "verseId": "ISA.12.1",
                "verseOrgIds": [
                  "ISA.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ati natti aartee turte;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
