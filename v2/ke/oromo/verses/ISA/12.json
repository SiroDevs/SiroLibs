          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.5",
                "verseOrgIds": [
                  "ISA.12.5"
                ]
              }
            }
          ]
