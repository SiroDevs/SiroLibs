          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhugumaan Waaqni fayyina koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
