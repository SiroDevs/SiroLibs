          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "isin gidduutti guddaadhaatii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:6"
      },
      "items": [
        {
          "text": "sagalee ol fudhadhaatii gammachuudhaan faarfadhaa.\"",
          "type": "text",
          "attrs": {
