    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Raajii Gibxii fi Itoophiyaadhaan Mormu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara ajajaan muummichi Sargoon mooticha Asooriin ergame sun gara Ashdood dhufee lolee ishee qabate sana keessa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
              "ISA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroodhuma sanatti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.20.2",
                "verseOrgIds": [
                  "ISA.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Isaayyaas ilma Amoosiitiin dubbate. Innis, \"Uffata gaddaa dhagna kee irraa, kophees miilla kee irraa baasi\" jedheen. Innis akkasuma godhe; qullaa fi miilla duwwaa asii fi achi deeme.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.20.3",
                "verseOrgIds": [
                  "ISA.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe; \"Akkuma garbichi koo Isaayyaas, akka Gibxii fi Itoophiyaaf mallattoo fi akeekkachiisa taʼuuf jedhee waggaa sadii qullaa fi miilla duwwaa deeme sana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasuma mootiin Asoor boojiʼamtoota Gibxii fi baqattoota Itoophiyaa dargaggeessaa fi jaarsa, qullaa fi miilla duwwaa hambisee teessuma isaanii illee qullaa godhee fudhatee deeme; kun warra Gibxiitiif qaanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
            "verseOrgIds": [
              "ISA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Itoophiyaa amanatanii Gibxiin boonan ni sodaatu; ni qaanaʼus.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafas warri qarqara galaanaa irra jiraatan akkana jedhu; 'Warra nu itti irkanne, warra mooticha Asoor jalaa nu baasu jennee gargaarsaaf itti baqanne sana irra waan gaʼe mee ilaalaa! Yoos nu akkamitti jalaa baʼuu dandeenya?' \"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.6",
            "verseOrgIds": [
              "ISA.20.6"
            ]
          }
        }
      ]
    }
  ],
