            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "gosa Zebuuloon keessaa 12,000,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
