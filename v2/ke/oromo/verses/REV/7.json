  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "REV 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Namoonni 144,000 Chaappeffaman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis ani utuu ergamoonni afur golee lafaa afran irra dhaabatanii akka bubbeen lafatti yookaan galaanatti yookaan muka kamitti iyyuu hin bubbifne bubbee lafaa afran dhowwanuu nan arge.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan chaappaa Waaqa jiraataa qabu kaan immoo utuu karaa baʼa biiftuutiin ol baʼuu nan arge. Innis ergamoota afran akka isaan lafaa fi galaana miidhaniif humni kennameef sana sagalee guddaadhaan waamee,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hamma nu adda tajaajiltoota Waaqa keenyaa irratti chaappaa goonutti lafa yookaan galaana yookaan muka hin miidhinaa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis baayʼina warra chaappeffamanii dhagaʼe: gosa Israaʼel hunda keessaa 144,000 ture.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa Yihuudaa keessaa 12,000,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:5"
      },
      "items": [
        {
          "text": "gosa Ruubeen keessaa 12,000,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:5"
      },
      "items": [
        {
          "text": "gosa Gaad keessaa 12,000,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
