          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni akkana jedhee dubbii kana hunda dubbate:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.1",
            "verseOrgIds": [
              "EXO.20.1"
            ]
          }
        }
