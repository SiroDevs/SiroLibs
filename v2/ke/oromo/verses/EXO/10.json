                "verseOrgIds": [
                  "EXO.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenya waaqeffachuuf isaan keessaa tokko tokkotti fayyadamna; hamma achi geenyutti",
          "type": "text",
          "attrs": {
