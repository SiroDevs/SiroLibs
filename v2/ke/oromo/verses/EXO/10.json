        },
        {
          "text": "immoo Museedhaan, \"Akka dukkanni Gibxi irra buʼuuf harka kee gara samiitti diriirsi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
