                "verseId": "EXO.10.25",
                "verseOrgIds": [
                  "EXO.10.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaaf aarsaa fi qalma gubamu dhiʼeessinuuf nuu eeyyamuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
