          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen harka isaa gara samiitti diriirse; dukkanni limixiin isaa guyyaa sadii Gibxi guutuu haguuge.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
