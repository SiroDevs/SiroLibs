                "verseId": "EXO.4.27",
                "verseOrgIds": [
                  "EXO.4.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Arooniin, \"Ati Musee simachuuf gara gammoojjii dhaqi!\" jedhe. Innis dhaqee Tulluu Waaqaa irratti Musee argatee isa dhungate.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sana Museen dubbii",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.28",
                "verseOrgIds": [
                  "EXO.4.28"
                ]
              }
            }
          ]
        },
        {
          "text": "akka inni dubbatuuf isa erge hundaa fi mallattoowwan akka inni hojjetuuf isa ajaje hunda Aroonitti hime.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
