          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaanis ni amanan. Jarris yommuu akka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.31",
                "verseOrgIds": [
                  "EXO.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "saba Israaʼel ilaalee fi akka inni rakkina isaaniis arge dhagaʼanitti gad jedhanii sagadan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
