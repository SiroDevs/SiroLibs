        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen, \"Yoo isaan, '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.1",
                "verseOrgIds": [
                  "EXO.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sitti hin mulʼanne' jedhanii na amanuu yookaan na dhagaʼuu didan hoo?\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.2",
                "verseOrgIds": [
                  "EXO.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Wanti harka kee keessa jiru sun maali?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:2"
      },
      "items": [
        {
          "text": "Museen immoo, \"Ulee dha\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.3",
                "verseOrgIds": [
                  "EXO.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Lafa buusi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:3"
      },
      "items": [
        {
          "text": "Museen lafa buufnaan uleen sun bofa taʼe; innis irraa baqate.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.4",
                "verseOrgIds": [
                  "EXO.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu Museedhaan, \"Harka kee hiixadhuutii eegee isaa qabi\" jedhe. Museenis hiixatee bofa sana qabe; bofti sunis harka isaa keessatti deebiʼee ulee taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.4",
            "verseOrgIds": [
              "EXO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.5",
                "verseOrgIds": [
                  "EXO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"kun akka isaan",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.5",
                "verseOrgIds": [
                  "EXO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni abbootii isaanii, Waaqni Abrahaam, Waaqni Yisihaaq, Waaqni Yaaqoob sitti mulʼate akka amananiif\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.6",
                "verseOrgIds": [
                  "EXO.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan, \"Harka kee bobaa kee keessa kaaʼadhu\" jedhe. Museenis harka isaa bobaa isaa keessa kaaʼate; yommuu inni baafatettis, kunoo harki isaa lamxii akka cabbii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Museedhaan, \"Harka kee deebisii bobaa kee keessa kaaʼadhu\" jedhe; Museenis deebisee harka isaa bobaa isaa keessa kaaʼate; yommuu inni baafatettis, kunoo harki isaa deebiʼee akkuma dhagna isaa isa kaanii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.7",
            "verseOrgIds": [
              "EXO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.8",
                "verseOrgIds": [
                  "EXO.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe; \"Isaan yoo si amanuu baatanii mallattoo isa jalqabaa fudhachuu didan mallattoo lammaffaa ni amanu taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isaan mallattoo kana lamaan amanuu baatanii si dhagaʼuu didan bishaan laga Abbayyaa budduuqsiitii lafa gogaa irratti dhangalaasi. Bishaan ati lagicha irraa budduuqsite sunis lafa gogaa irratti dhiiga taʼa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.9",
            "verseOrgIds": [
              "EXO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.10",
                "verseOrgIds": [
                  "EXO.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Yaa Gooftaa, ani duris taʼu yookaan erga ati garbicha keetti dubbachuu jalqabdee as nama arraba qajeelu miti. Ani nama afaan isaa hidhamee arrabni isaas itti ulfaatuu dha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.11",
                "verseOrgIds": [
                  "EXO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana isaan jedhe; \"Kan afaan namaa uume eenyu? Kan akka namni arrab-didaa taʼu yookaan duudu godhu eenyu? Kan agartuu ijaa namaaf kennu yookaan jaamsu eenyu? Anuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.11",
                "verseOrgIds": [
                  "EXO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "mitii?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma dhaqi; ani afaan kee wajjin nan taʼa; waan ati jettus sin barsiisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
            "verseOrgIds": [
              "EXO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen garuu, \"Yaa Gooftaa, maaloo nama biraa ergi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.13",
            "verseOrgIds": [
              "EXO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.14",
                "verseOrgIds": [
                  "EXO.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee irratti bobaʼe; innis akkana jedhe; \"Obboleessi kee Aroon Lewwichi jira mitii? Ani akka inni akka gaariitti dubbatu nan beeka. Kunoo, inni gara kee dhufuutti jira. Inni yommuu si argutti ni gammada.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati isatti dubbatee afaan isaa keessa dubbii ni keessa; anis afaan keetii fi afaan isaa wajjin nan taʼa; waan isin hojjettanis isin nan barsiisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.15",
            "verseOrgIds": [
              "EXO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni uummatatti siif dubbata; inni afaan siif taʼa; ati immoo isaaf akka Waaqaa ni taata.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati ulee ittiin mallattoo argisiiftu kana harkatti qabadhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
            "verseOrgIds": [
              "EXO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Museen Gibxitti Deebiʼe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen gara abbaa niitii isaa gara Yetrootti deebiʼee, \"Akka ani gara saba koo warra Gibxi jiraatanitti deebiʼee hamma ammaatti lubbuun jiraachuu isaanii arguuf maaloo naa eeyyami\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:18"
      },
      "items": [
        {
          "text": "Yootooris, \"Nagaan dhaqi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.19",
                "verseOrgIds": [
                  "EXO.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Midiyaanitti Museedhaan, \"Namoonni si ajjeesuu barbaadan hundi duʼaniiruutii Gibxitti deebiʼi\" jedhee ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Museen niitii isaatii fi ilmaan isaa fuudhatee harree irra kaaʼee Gibxitti deebiʼe. Innis ulee Waaqaa harkatti qabatee ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.20",
            "verseOrgIds": [
              "EXO.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.21",
                "verseOrgIds": [
                  "EXO.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe; \"Ati yeroo Gibxitti deebitutti dinqiiwwan ani akka ati hojjetuuf humna siif kenne sana hunda fuula Faraʼoon duratti hojjedhu. Ani garuu akka inni saba sana gad hin lakkifne mata jabeessa isa nan godha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.21",
            "verseOrgIds": [
              "EXO.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati Faraʼooniin akkana jedhi; '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.22",
                "verseOrgIds": [
                  "EXO.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Israaʼel ilma koo hangafa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "anis, \"Akka ilmi koo na tajaajiluuf gad lakkisi\" jedhee sitti himeera. Ati garuu isa gad lakkisuu didde; kanaafuu, kunoo ani ilma kee hangafa nan ajjeesa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.23",
            "verseOrgIds": [
              "EXO.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
