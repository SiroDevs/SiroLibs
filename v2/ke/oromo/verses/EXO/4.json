          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musee fi Aroon maanguddoota Israaʼel hunda walitti qaban;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.29",
            "verseOrgIds": [
              "EXO.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroonis waan",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.30",
                "verseOrgIds": [
                  "EXO.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Museetti hime hunda jaratti hime. Mallattoowwanis fuula namootaa duratti hojjete;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
