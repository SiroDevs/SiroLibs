                "verseId": "EXO.4.24",
                "verseOrgIds": [
                  "EXO.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa irratti iddoo bultiitti Museetti dhufee isa ajjeesuu barbaade.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziphooraa garuu dhagaa qara qabu fudhattee qola dhagna ilma ishee kuttee ittiin miilla Musee tuqxe. Isheenis, \"Ati dhugumaan anaaf misirricha dhiigaati\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.26",
                "verseOrgIds": [
                  "EXO.4.26"
                ]
              }
            }
          ]
        },
        {
          "text": "isa dhiise. Yeroo sana isheen waaʼee dhagna qabaatiif, \"Misirricha dhiigaa ti\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        }
      ]
