              "text": "25:31‑39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
