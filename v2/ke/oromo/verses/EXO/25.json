    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baattuu ibsaas warqee qulqulluu irraa tolchi; baattuun ibsaa kunis tumamee haa tolfamu; somaa isaa, damee isaa, waciitii isaa, hudhaa isaatii fi daraaraa isaa warqeedhuma sana irraa tolchi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.31",
            "verseOrgIds": [
              "EXO.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bitaa mirga baattuu ibsaa sana keessaas dameewwan jaʼa jechuunis sadii gama tokkoon, sadii immoo gama kaaniin haa baafaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.32",
            "verseOrgIds": [
              "EXO.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xoofoowwan lawuzii fakkaatan kanneen tokkoon tokkoon isaanii hudhaa fi daraaraa qaban sadii damee tokko irratti, waciitiiwwan lawuzii fakkaatan kanneen tokkoon tokkoon isaanii hudhaa fi daraaraa qaban sadii immoo damee kaan irratti tolchi; dameewwan jaʼaan baattuu ibsaa irraa babbaʼan hunda irrattis akkasuma tolchi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.33",
            "verseOrgIds": [
              "EXO.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xoofoowwan hudhaa fi daraaraa qaban kanneen bifa lawuziitiin hojjetaman afur baattuu ibsaa sana irra haa jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hudhaan tokko cimdii jalqabaa kan dameewwan baattuu ibsaa irraa babbaʼan jala, hudhaan lammaffaan cimdii lammaffaa jala, hudhaan sadaffaan immoo cimdii sadaffaa jala ture. Walumaa galatti dameewwan jaʼatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hudhaawwanii fi dameewwan hundinuu baattuu ibsaa sana wajjin warqeedhuma qulqulluu tumame tokko irraa haa tolfaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Atis ibsaawwan torba tolchiif; akka lafa fuula isaanii dura jiru ibsaniifis baattuu ibsaa irra isaan dhadhaabi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni ittiin daaraa isaa dhadhaʼanii fi caabiin daaraa sana baattu warqee qulqulluu irraa haa hojjetaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baattuun ibsaatii fi miʼi isaa hundi warqee qulqulluu taalaantii tokkootiin haa hojjetamani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atis akkuma fakkeenya tulluu irratti sitti argisiifame sanaatti hojjechuu kee mirkaneeffadhu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
            "verseOrgIds": [
              "EXO.25.40"
            ]
          }
        }
      ]
    }
