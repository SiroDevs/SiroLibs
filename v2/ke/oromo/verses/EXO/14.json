          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaan sun iddoo isaatti deebiʼee gaariiwwanii fi abbootii fardaa jechuunis loltoota Faraʼoon kanneen Israaʼeloota duukaa buʼanii galaana seenan sana hunda liqimse. Isaan keessaas namni tokko iyyuu hin hafne.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.28",
            "verseOrgIds": [
              "EXO.14.28"
            ]
          }
        }
