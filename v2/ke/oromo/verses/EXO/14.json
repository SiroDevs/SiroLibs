          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan rakkinaan oofaniifis gommaa gaariiwwan isaanii irraa baase. Warri Gibxis, \"Waan",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
