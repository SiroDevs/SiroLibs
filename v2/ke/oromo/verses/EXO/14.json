                "verseOrgIds": [
                  "EXO.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "haxaaʼee galaanatti isaan naqe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
