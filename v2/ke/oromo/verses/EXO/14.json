                "verseOrgIds": [
                  "EXO.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "utubaa ibiddaatii fi duumessaa keessaa loltoota Gibxi sana gad ilaalee gara itti goran isaan wallaalchise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
