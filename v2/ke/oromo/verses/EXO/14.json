                "verseOrgIds": [
                  "EXO.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "gama Israaʼelootaa dhaabatee warra Gibxi lolaa jiruuf kottaa isaan duraa baqannaa\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        }
