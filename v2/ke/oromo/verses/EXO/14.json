                "verseOrgIds": [
                  "EXO.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan, \"Akka bishaanonni warra Gibxi irra, gaariiwwanii fi abbootii fardaa isaanii irra garagalaniif harka kee galaana irratti diriirsi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
