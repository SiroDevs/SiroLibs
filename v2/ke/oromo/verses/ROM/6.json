  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "ROM 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cubbuuf Duʼuu, Kiristoosiin Immoo Jiraachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa maal jenna ree? Akka ayyaanni baayʼatuuf ittuma fufnee cubbuu haa hojjennuu?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.1",
            "verseOrgIds": [
              "ROM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonkumaa hin taʼu! Nu warri cubbuuf duune, siʼachi akkamitti cubbuu jala jiraanna?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.2",
            "verseOrgIds": [
              "ROM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yookaan nu warri Kiristoos Yesuusitti cuuphamne hundi akka duʼa isaattis cuuphamne isin hin beektanii?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.3",
            "verseOrgIds": [
              "ROM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu akkuma Kiristoos ulfina Abbaatiin warra duʼan keessaa kaafame sana nus akka jireenya haaraa jiraannuuf cuuphaadhaan duʼa isaa keessatti hirmaannee isa wajjin awwaalamne.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.4",
            "verseOrgIds": [
              "ROM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu erga duʼa isaatiin akkasitti isa wajjin tokko taane, duʼaa kaʼuu isaatiinis akkasuma isa wajjin tokko ni taana.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.5",
            "verseOrgIds": [
              "ROM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka dhagni cubbamaan balleeffamuuf, nus akka siʼachi garboota cubbuu hin taaneef akka namummaan keenya moofaan sun isa wajjin fannifame ni beekna;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.6",
            "verseOrgIds": [
              "ROM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "namni duʼe cubbuu irraa bilisoomeeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.7",
            "verseOrgIds": [
              "ROM.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa nu yoo Kiristoos wajjin duune, akka isa wajjin jiraannus ni amanna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.8",
            "verseOrgIds": [
              "ROM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiristoos warra duʼan keessaa waan kaʼeef, akka inni deebiʼee hin duune ni beeknaatii; duutis siʼachi isa irratti gooftummaa hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.9",
            "verseOrgIds": [
              "ROM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni duʼa duʼe sana siʼa tokko yeroo hundaaf cubbuuf duʼe; jireenya jiraatu sana garuu Waaqaaf jiraata.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.10",
            "verseOrgIds": [
              "ROM.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis akkasuma akka cubbuuf duutanitti, Kiristoos Yesuusiin garuu akka Waaqaaf jiraattota taatanitti of hedaa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.11",
            "verseOrgIds": [
              "ROM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isin akka fedhii isaa hamaadhaaf hin ajajamneef dhagna keessan kan duʼa hin oolle irratti cubbuu hin moosisinaa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.12",
            "verseOrgIds": [
              "ROM.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka warra duʼa irraa gara jireenyaatti fidamaniitti Waaqaaf of dhiʼeessaa malee kutaa dhagna keessanii miʼa jalʼinaa gootanii cubbuuf hin dhiʼeessinaa; garuu kutaa dhagna keessanii miʼa qajeelinaa godhaatii Waaqaaf dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.13",
            "verseOrgIds": [
              "ROM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin ayyaana jala jirtu malee waan seera jala hin jirreef, cubbuun isin irratti gooftummaa hin qabaatu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.14",
            "verseOrgIds": [
              "ROM.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Garboota Qajeelummaa Taʼuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa maal haa taʼu ree? Nu sababii ayyaana jala malee seera jala hin jirreef cubbuu haa hojjennuu? Gonkumaa hin taʼu!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.15",
            "verseOrgIds": [
              "ROM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cubbuu gara duʼaatti nama geessuufis taʼu yookaan ajajamuu gara qajeelummaatti nama geessuuf, yommuu akka garbootaatti nama tokkoof ajajamuuf of kennitanitti, nama ajajamtaniif sanaaf akka garboota taatan hin beektanii?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.16",
            "verseOrgIds": [
              "ROM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin yoo garboota cubbuu turtan illee amma garuu barumsa itti kennamtan sanaaf waan garaa guutuun ajajamtaniif Waaqaaf galanni haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.17",
            "verseOrgIds": [
              "ROM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin cubbuu irraa bilisoomtanii garboota qajeelummaa taataniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.18",
            "verseOrgIds": [
              "ROM.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii isin uumamaanuu dadhaboo taataniif ani jecha namaa galuun nan dubbadha; akkuma kutaa dhagna keessanii xuraaʼummaa fi hammina guddachaa deemuuf garba gootanii dhiʼeessaa turtan sana ammas kutaa dhagna keessanii qajeelummaa gara qulqullummaatti geessuuf garba godhaatii dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.19",
            "verseOrgIds": [
              "ROM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin yeroo garboota cubbuu turtanitti, qajeelummaa irraa bilisa turtan.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.20",
            "verseOrgIds": [
              "ROM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan amma itti qaanoftan kana irraa yeroo sana buʼaa maalii argattan ree? Dhumni waan sanaa duʼaatii!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.21",
            "verseOrgIds": [
              "ROM.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu waan cubbuu irraa bilisoomtanii garboota Waaqaa taataniif faayidaan isin argattan gara qulqullummaatti isin geessa; dhumni isaas jireenya bara baraa ti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.22",
            "verseOrgIds": [
              "ROM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mindaan cubbuu duʼaatii; kennaan Waaqaa garuu karaa Gooftaa keenya Kiristoos Yesuusiin jireenya bara baraa ti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.23",
            "verseOrgIds": [
              "ROM.6.23"
            ]
          }
        }
      ]
    }
  ],
