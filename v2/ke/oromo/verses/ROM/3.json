  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "ROM 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amanamummaa Waaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa Yihuudii taʼuun faayidaa maalii qaba? Yookaan buʼaan dhagna qabaa maalii?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.1",
            "verseOrgIds": [
              "ROM.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa hundaanuu buʼaa guddaa qaba! Jalqabatti dubbiin Waaqaa Yihuudootatti imaanaa kenname.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.2",
            "verseOrgIds": [
              "ROM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaa tokko tokko yoo hin amanin maal ree? Amantii dhabuun isaanii amanamummaa Waaqaa ni balleessaa?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.3",
            "verseOrgIds": [
              "ROM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonkumaa hin taʼu! Namoonni hundinuu sobdoota, Waaqni immoo dhugaa qabeessa haa taʼu. Kunis akkuma,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 3:4"
      },
      "items": [
        {
          "text": "\"Akka ati dubbii keetiin dhuga qabeessa taatuuf,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 3:4"
      },
      "items": [
        {
          "text": "yommuu murtiitti dhiʼaattuttis akka moʼattuuf\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ROM 3:4"
      },
      "items": [
        {
          "text": "jedhamee barreeffamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo jalʼinni keenya qajeelina Waaqaa ifa baase garuu maal jenna ree? Waaqni dheekkamsa isaa nutti fiduun isaa qajeelina dhabeetii? Kanas ani akka namaattin dubbadha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.5",
            "verseOrgIds": [
              "ROM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonkumaa hin taʼu! Utuu akkas taʼee silaa Waaqni akkamitti addunyaatti muruu dandaʼa ree?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.6",
            "verseOrgIds": [
              "ROM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko, \"Yoo soba kootiin dhuga qabeessummaan Waaqaa guddatee ulfinni isaas baayʼate maaliif hamma ammaatti akka cubbamaa tokkootti natti murama ree?\" jedhee falma taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.7",
            "verseOrgIds": [
              "ROM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis isa namoonni tokko tokko, \"Isaan, 'Akka wanni gaariin dhufuuf hammina haa hojjennu?' jedhu\" jedhanii nurratti odeessisanii dha. Murtiin isaanitti muramus waanuma maluu dha!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.8",
            "verseOrgIds": [
              "ROM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Namni Kam iyyuu Qajeelaa miti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa maal jenna ree? Nu Yihuudoonni warra kaan caallaa? Gonkumaa akkas miti! Akka Yihuudoonnii fi Giriikonni hundinuu cubbuu jala jiran duraan dursinee mirkaneessineerraatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.9",
            "verseOrgIds": [
              "ROM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis kan akkana jedhamee barreeffamee dha:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.10",
            "verseOrgIds": [
              "ROM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 3:10"
      },
      "items": [
        {
          "text": "\"Qajeelaan tokko iyyuu hin jiru; namni tokko iyyuu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.10",
            "verseOrgIds": [
              "ROM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "namni hubannaa qabu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.11",
            "verseOrgIds": [
              "ROM.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 3:11"
      },
      "items": [
        {
          "text": "kan Waaqa barbaadu tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.11",
            "verseOrgIds": [
              "ROM.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundinuu dogoggoraniiru;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.12",
            "verseOrgIds": [
              "ROM.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 3:12"
      },
      "items": [
        {
          "text": "walumatti warra faayidaa hin qabne taʼaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.12",
            "verseOrgIds": [
              "ROM.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 3:12"
      },
      "items": [
        {
          "text": "namni waan gaarii hojjetu tokko iyyuu hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.12",
            "verseOrgIds": [
              "ROM.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 3:12"
      },
      "items": [
        {
          "text": "tokkumti iyyuu hin jiru.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.12",
            "verseOrgIds": [
              "ROM.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laagaan isaanii awwaala banamaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.13",
            "verseOrgIds": [
              "ROM.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 3:13"
      },
      "items": [
        {
          "text": "arraba isaaniitiin ni gowwoomsu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.13",
            "verseOrgIds": [
              "ROM.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 3:13"
      },
      "items": [
        {
          "text": "\"Hadhaan buutii hidhii isaanii jala jira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.13",
            "verseOrgIds": [
              "ROM.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Afaan isaanii abaarsaa fi hadhaaʼummaan guutame.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.14",
            "verseOrgIds": [
              "ROM.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Miilli isaanii dhiiga dhangalaasuutti ariifata;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.15",
            "verseOrgIds": [
              "ROM.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "badiisaa fi gadadootu karaa isaanii irra jira;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.16",
            "verseOrgIds": [
              "ROM.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "karaa nagaas hin beekan.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.17",
            "verseOrgIds": [
              "ROM.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waaqa sodaachuun ija isaanii dura hin jiru.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.18",
            "verseOrgIds": [
              "ROM.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka afaan hundi cufamuu fi akka addunyaan hundinuu murtii Waaqaa jala galuuf, wanni seerri jedhu hundinuu akka warra seera jala jiraniif dubbatu ni beekna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.19",
            "verseOrgIds": [
              "ROM.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafis eenyu iyyuu seera eeguudhaan fuula Waaqaa duratti qajeelaa hin taʼu; seeratu cubbuu nu hubachiisaatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.20",
            "verseOrgIds": [
              "ROM.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qajeelummaa Amantiin Argamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu qajeelummaan Waaqaan kennamu kan seeraan adda taʼe, kan Seerrii fi Raajonni dhugaa baʼaniif mulʼateera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.21",
            "verseOrgIds": [
              "ROM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qajeelummaan Waaqaa kun amantiidhaan warra Yesuus Kiristoositti amanan hundaaf kennama; nama wal caalchisuun hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.22",
            "verseOrgIds": [
              "ROM.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "sababii hundi isaanii iyyuu cubbuu hojjetaniif isaan ulfina Waaqaa irraa citaniiruutii;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.23",
            "verseOrgIds": [
              "ROM.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaanis ayyaana Waaqaa isa furama karaa Kiristoos Yesuusiin toluma kennameefiin qajeeltota taasifamaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.24",
            "verseOrgIds": [
              "ROM.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiiga isaatti amantii qabaachuudhaanis akka inni aarsaa araaraa taʼuuf Waaqni isa dhiʼeesse. Waan kana gochuun isaas cubbuu kanaan dura hojjetame utuu hin adabin waan obsaan bira darbeef qajeelina isaa argisiisuuf jedhee ti;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.25",
            "verseOrgIds": [
              "ROM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni yeroo ammaa qajeelummaa isaa argisiisuu fi akka nama Yesuusitti amanus qajeelaa taʼuu isaa labsuuf waan kana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.26",
            "verseOrgIds": [
              "ROM.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seerri Kennamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoos of tuuluun eessa jira ree? Inni hafeera. Seera kamiin? Seera eeguudhaan moo? Miti; seera amantiitiin malee.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.27",
            "verseOrgIds": [
              "ROM.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu akka namni seera eeguudhaan utuu hin taʼin amantiidhaan qajeelaa taasifamu ni amannaatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.28",
            "verseOrgIds": [
              "ROM.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni Waaqa Yihuudootaa qofa moo? Inni Waaqa Namoota Ormaas mitii? Eeyyee, inni Waaqa Namoota Ormaatis;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.29",
            "verseOrgIds": [
              "ROM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "egaa kan dhagna qabates amantiin, kan dhagna hin qabatinis amantiidhuma sanaan qajeelaa kan taasisu Waaquma tokkicha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.30",
            "verseOrgIds": [
              "ROM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoos nu amantii kanaan seera sana cabsinaa ree? Gonkumaa akkas miti! Seericha ni cimsina malee.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.31",
            "verseOrgIds": [
              "ROM.3.31"
            ]
          }
        }
      ]
    }
