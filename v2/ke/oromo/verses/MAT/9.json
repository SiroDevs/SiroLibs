    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu inni waan kana dubbachaa jiruu, bulchaan mana sagadaa tokko dhufee fuula isaa duratti jilbeenfatee, \"Intalli koo ammuma na duraa duute. Garuu kottuutii harka kee ishee irra kaaʼi; isheenis ni jiraattii\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.18",
            "verseOrgIds": [
              "MAT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus kaʼee barattoota isaa wajjin isa duukaa buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.19",
            "verseOrgIds": [
              "MAT.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, dubartiin dhiigni ishee waggaa kudha lama dhangalaʼaa ture tokko dugda isaa duubaan dhuftee handaara uffata isaa tuqxe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.20",
            "verseOrgIds": [
              "MAT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis garaa ishee keessatti, \"Ani yoon uffatuma isaa illee tuqe nan fayya\" jettee yaaddee turteetii.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.21",
            "verseOrgIds": [
              "MAT.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis garagalee ishee ilaalee,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa intalaa, amantiin kee si fayyiseeraatii jabaadhu!\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.22",
                "verseOrgIds": [
                  "MAT.9.22"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen. Dubartiin sunis yeruma sana fayyite.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis yommuu mana bulchaa mana sagadaa sanaa seenee warra ulullee afuufanii fi uummata wacu argetti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.23",
            "verseOrgIds": [
              "MAT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Asii deemaa! Intalattiin rafteerti malee hin duunee\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.24",
                "verseOrgIds": [
                  "MAT.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe. Isaan garuu isatti kolfan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.24",
            "verseOrgIds": [
              "MAT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga namoonni gad baafamanii booddees inni ol seenee harka intalattii qabe; isheenis kaatee dhaabatte.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.25",
            "verseOrgIds": [
              "MAT.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oduun waaʼee kanaas biyya sana guutuu keessa facaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.26",
            "verseOrgIds": [
              "MAT.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Jaamota Lama Fayyisuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus utuu achii kaʼee deemaa jiruu, jaamonni lama isa duukaa buʼanii, \"Yaa Ilma Daawit nu maari!\" jedhanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.27",
            "verseOrgIds": [
              "MAT.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu inni mana seenettis jaamonni sun gara isaa dhufan; innis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akka ani waan kana gochuu dandaʼu ni amantuu ree?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.28",
                "verseOrgIds": [
                  "MAT.9.28"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee isaan gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 9:28"
      },
      "items": [
        {
          "text": "Isaanis, \"Eeyyee, yaa Gooftaa!\" jedhanii deebisaniif.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis ija isaanii qaqqabee,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akkuma amantii keessanii isiniif haa taʼu\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.29",
                "verseOrgIds": [
                  "MAT.9.29"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji isaaniis ni baname. Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
              "MAT.9.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akka namni tokko iyyuu waan kana hin beekne of eeggadhaa\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.30",
                "verseOrgIds": [
                  "MAT.9.30"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee jabeessee isaan akeekkachiise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
              "MAT.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarri garuu achii baʼanii biyya sana hunda keessatti waaʼee isaa odeessan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.31",
            "verseOrgIds": [
              "MAT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu isaan gad baʼuutti jiranuu jarri tokko nama hafuura hamaadhaan qabamee dubbachuu hin dandeenye tokko Yesuusitti fidan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.32",
            "verseOrgIds": [
              "MAT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi sunis erga hafuurri hamaan isa keessaa baafamee booddee ni dubbate. Namoonnis, \"Wanni akkanaa gonkumaa Israaʼel keessatti hin argamne\" jedhanii dinqifatan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
              "MAT.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonni garuu, \"Inni hangafa hafuurota hamootiin hafuurota hamoo baasa\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hojjettoonni Muraasa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus manneen sagadaa isaanii keessatti barsiisaa, wangeela mootummaa lallabaa, akkasumas dhibee fi dhukkuba hunda irraa namoota fayyisaa magaalaawwanii fi gandoota hunda keessa deeme.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yommuu tuuta namootaa argetti garaa laafeef; isaan akkuma hoolota tiksee hin qabneetti dhiphatanii, gatamaniis turaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoota isaatiinis akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Midhaan walitti qabamu baayʼee dha; hojjettoonni garuu muraasa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.37",
                "verseOrgIds": [
                  "MAT.9.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaaf akka Gooftaan midhaan sanaa gara lafa qotiisaa midhaan isaatti hojjettoota erguuf isa kadhadhaa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.38",
                "verseOrgIds": [
                  "MAT.9.38"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
