                {
                  "text": "Luq 5:18‑26",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus bidiruu yaabbatee galaana ceʼee gara magaalaa isaa dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.1",
            "verseOrgIds": [
              "MAT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, jarri tokko nama dhagni irratti duʼee siree irra ciisu tokko gara isaa fidan. Yesuusis yommuu amantii isaanii argetti namichaan,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.2",
            "verseOrgIds": [
              "MAT.9.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ilma koo jabaadhu; cubbuun kee siif dhiifameeraatii\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.2",
                "verseOrgIds": [
                  "MAT.9.2"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.2",
            "verseOrgIds": [
              "MAT.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti barsiistota seeraa keessaa tokko tokko garaa isaanii keessatti, \"Kunoo, namichi kun Waaqa arrabsa!\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.3",
            "verseOrgIds": [
              "MAT.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis yaada isaanii beekee akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.4",
            "verseOrgIds": [
              "MAT.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin maaliif garaa keessan keessatti waan hamaa yaaddu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.4",
                "verseOrgIds": [
                  "MAT.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.4",
            "verseOrgIds": [
              "MAT.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Cubbuun kee siif dhiifameera' jechuu moo 'Kaʼii deemi' jechuutu salphaa dha?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.5",
                "verseOrgIds": [
                  "MAT.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.5",
            "verseOrgIds": [
              "MAT.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani garuu akka Ilmi Namaa cubbuu namaaf dhiisuudhaaf lafa irratti taayitaa qabu akka beektan nan barbaada.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.6",
                "verseOrgIds": [
                  "MAT.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Kanaafuu inni namicha dhagni irratti duʼe sanaan,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.6",
            "verseOrgIds": [
              "MAT.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaʼi; siree kee fudhadhuutii mana keetti gali\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.6",
                "verseOrgIds": [
                  "MAT.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.6",
            "verseOrgIds": [
              "MAT.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichis kaʼee mana isaatti gale.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.7",
            "verseOrgIds": [
              "MAT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonnis yommuu waan kana arganitti ni dinqifatan; Waaqa taayitaa akkasii namaaf kenneefis ulfina kennan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.8",
            "verseOrgIds": [
              "MAT.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waamamuu Maatewos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.9.9-MAT.9.13"
          },
          "items": [
            {
              "text": "9:9‑13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MRK.2.14-MRK.2.17"
              },
              "items": [
                {
                  "text": "Mar 2:14‑17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.5.27-LUK.5.32"
              },
              "items": [
                {
                  "text": "Luq 5:27‑32",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus achii kaʼee utuu deemuu namicha Maatewos jedhamu tokko utuu inni iddoo itti qaraxa walitti qaban taaʼuu argee,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na duukaa buʼi\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.9",
                "verseOrgIds": [
                  "MAT.9.9"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen. Maatewosis kaʼee isa duukaa buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Yesuus mana Maatewositti irbaata nyaachaa turetti, qaraxxoonnii fi cubbamoonni baayʼeen dhufanii isaa fi barattoota isaa wajjin nyaatan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.10",
            "verseOrgIds": [
              "MAT.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonni yommuu waan kana arganitti, \"Barsiisaan keessan maaliif qaraxxootaa fi cubbamoota wajjin nyaata?\" jedhanii barattoota isaa gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.11",
            "verseOrgIds": [
              "MAT.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo waan kana dhageenyaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.12",
            "verseOrgIds": [
              "MAT.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ogeessi fayyaa warra dhukkubsataniif malee warra fayyaa qabaniif hin barbaachisu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.12",
                "verseOrgIds": [
                  "MAT.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.12",
            "verseOrgIds": [
              "MAT.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garuu dhaqaatii dubbiin, 'Ani araaran fedha malee aarsaa hin fedhu'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.13",
                "verseOrgIds": [
                  "MAT.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.13",
            "verseOrgIds": [
              "MAT.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "jedhu sun maal jechuu akka taʼe hubadhaa. Ani cubbamoota waamuufin dhufe malee qajeeltota waamuuf hin dhufneetii.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.13",
                "verseOrgIds": [
                  "MAT.9.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaaffii Waaʼee Soomaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.9.14-MAT.9.17"
          },
          "items": [
            {
              "text": "9:14‑17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MRK.2.18-MRK.2.22"
              },
              "items": [
                {
                  "text": "Mar 2:18‑22",
                  "type": "text"
