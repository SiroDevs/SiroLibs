              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Buddeena ijoollee fuudhanii saroota dura buusuun sirrii miti\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.26",
                "verseOrgIds": [
                  "MAT.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        }
      ]
