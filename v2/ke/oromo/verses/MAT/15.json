          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis iddoo sanaa kaʼee gara biyya Xiiroosii fi Siidoonaatti qajeele.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.21",
            "verseOrgIds": [
              "MAT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, dubartiin Kanaʼaan tokko naannoo sanaa gara isaa dhuftee iyyaa, \"Yaa Gooftaa, yaa Ilma Daawit, intalli koo hafuura hamaadhaan qabamtee akka malee dhiphachaa jirti; na maari!\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.22",
            "verseOrgIds": [
              "MAT.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus garuu deebii tokko illee hin kennineef. Barattoonni isaas gara isaa dhufanii, \"Kunoo isheen iyyaa nu faana deemtiitii achi deebisi\" jedhanii isa kadhatan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.23",
            "verseOrgIds": [
              "MAT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni immoo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.24",
            "verseOrgIds": [
              "MAT.15.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani hoolota mana Israaʼel kanneen badan sana qofaafan ergame\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.24",
                "verseOrgIds": [
                  "MAT.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.24",
            "verseOrgIds": [
              "MAT.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
