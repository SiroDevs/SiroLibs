    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Fariisonnii fi barsiistonni seeraa tokko tokko Yerusaalemii gara Yesuus dhufanii,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.1",
            "verseOrgIds": [
              "MAT.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Barattoonni kee maaliif duudhaa maanguddootaa cabsu? Isaan yommuu buddeena nyaatanitti harka hin dhiqataniitii!\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.2",
            "verseOrgIds": [
              "MAT.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedhee deebise;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.3",
            "verseOrgIds": [
              "MAT.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isinis maaliif duudhaa keessaniif jettanii ajaja Waaqaa cabsitu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.3",
                "verseOrgIds": [
                  "MAT.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.3",
            "verseOrgIds": [
              "MAT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Waaqni, 'Abbaa keetii fi haadha keetiif ulfina kenni;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.4",
                "verseOrgIds": [
                  "MAT.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.4",
            "verseOrgIds": [
              "MAT.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "namni abbaa isaa yookaan haadha isaa arrabsu kam iyyuu haa ajjeefamu'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.4",
                "verseOrgIds": [
                  "MAT.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.4",
            "verseOrgIds": [
              "MAT.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "jedheeraatii.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.4",
                "verseOrgIds": [
                  "MAT.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.4",
            "verseOrgIds": [
              "MAT.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin garuu yoo namni kam iyyuu akka wanni silaa abbaa isaatiif yookaan haadha isaatiif kennamuu malu 'Waaqaaf kennameera' jedhee dubbate,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.5",
                "verseOrgIds": [
                  "MAT.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.5",
            "verseOrgIds": [
              "MAT.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "inni waan sanaan abbaa isaatiif yookaan haadha isaatiif ulfina kennuu hin qabu jettu. Akkanaanis isin duudhaa keessaniif jettanii dubbii Waaqaa busheessitu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.6",
                "verseOrgIds": [
                  "MAT.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.6",
            "verseOrgIds": [
              "MAT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yaa fakkeessitoota! Isaayyaas yommuu waaʼee keessan raajii dubbatetti sirrii ture; innis akkana jedhe:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.7",
                "verseOrgIds": [
                  "MAT.15.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Uumanni kun hidhii isaatiin na kabaja;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.8",
                "verseOrgIds": [
                  "MAT.15.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 15:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "garaan isaa garuu narraa fagoo jira.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.8",
                "verseOrgIds": [
                  "MAT.15.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaan akkanumaan na waaqeffatu;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.9",
                "verseOrgIds": [
                  "MAT.15.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 15:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "barsiisni isaaniis sirnuma namaa ti.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.9",
                "verseOrgIds": [
                  "MAT.15.9"
                ]
              }
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.9",
                "verseOrgIds": [
                  "MAT.15.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis tuuta sana ofitti waamee akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.10",
            "verseOrgIds": [
              "MAT.15.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dhagaʼaa; hubadhaas.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.10",
                "verseOrgIds": [
                  "MAT.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.10",
            "verseOrgIds": [
              "MAT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Waan afaan namaa keessaa baʼutu nama xureessa malee wanni afaan namaa seenu nama hin xureessu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.11",
                "verseOrgIds": [
                  "MAT.15.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii barattoonni gara isaa dhufanii, \"Ati akka Fariisonni dubbii kana dhagaʼanii mufatan beektaa?\" jedhanii gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.12",
            "verseOrgIds": [
              "MAT.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis deebisee akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.13",
            "verseOrgIds": [
              "MAT.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Biqiltuun abbaan koo inni samii irraa hin dhaabin hundinuu ni buqqifama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.13",
                "verseOrgIds": [
                  "MAT.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.13",
            "verseOrgIds": [
              "MAT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaan dhiisaa; isaan qajeelchitoota jaamota. Jaamaan yoo jaamaa qajeelche, isaan lachuu boolla keessa buʼu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.14",
                "verseOrgIds": [
                  "MAT.15.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phexrosis, \"Mee hiikkaa fakkeenya kanaa nuu ibsi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.15",
            "verseOrgIds": [
              "MAT.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo akkana jedhee isaan gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.16",
            "verseOrgIds": [
              "MAT.15.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isinis hamma ammaatti hin hubattanii?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.16",
                "verseOrgIds": [
                  "MAT.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.16",
            "verseOrgIds": [
              "MAT.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akka wanni afaan seenu kam iyyuu garaa seenee achumaan darbee dhagna keessaa baʼu hin argitanii?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.17",
                "verseOrgIds": [
                  "MAT.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.17",
            "verseOrgIds": [
              "MAT.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wanni afaan namaatii baʼu garuu nama keessaa baʼa; namichas ni xureessa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.18",
                "verseOrgIds": [
                  "MAT.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.18",
            "verseOrgIds": [
              "MAT.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sababiin isaas yaadni hamaan jechuunis ajjeesuun, ejjummaan, halalummaan, hanni, sobaan dhugaa baʼuun, maqaa nama balleessuun garaa namaa keessaa baʼaatii.",
              "type": "text",
              "attrs": {
