              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ati garuu yeroo soomtu mataa kee dibadhu; fuula kees dhiqadhu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.17",
                "verseOrgIds": [
                  "MAT.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kunis akka sooma kee sana abbaa kee isa namatti hin mulʼanne malee namni hin beekneefii dha. Abbaan kee inni waan dhoksaatti hojjetamu argu sun gatii kee ifaan ifatti siif kenna.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.18",
                "verseOrgIds": [
                  "MAT.6.18"
                ]
              }
            }
          ]
        }
      ]
    },
