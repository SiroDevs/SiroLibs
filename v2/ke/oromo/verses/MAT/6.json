    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin iddoo itti bilii fi daanaʼoon balleessituu fi iddoo itti hattuun cabsitee hattu lafa irratti badhaadhummaa ofii keessaniif hin kuufatinaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.19",
                "verseOrgIds": [
                  "MAT.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garuu iddoo itti bilii fi daanaʼoon nyaattee hin balleessinee fi iddoo itti hattuun cabsitee hin hanne samii irratti badhaadhummaa ofii keessaniif kuufadhaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.20",
                "verseOrgIds": [
                  "MAT.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Idduma badhaadhummaan kee jiru sana garaan kees jiraatii.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.21",
                "verseOrgIds": [
                  "MAT.6.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Iji ibsaa dhagnaa ti. Iji kee fayyaa taanaan, dhagni kee guutuun ifaan guutama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.22",
                "verseOrgIds": [
                  "MAT.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo iji kee fayyaa hin taʼin garuu, dhagni kee guutuun ni dukkanaaʼa. Erga ifni si keessa jiru sun dukkanaaʼee, dukkanni sun hammam haa jabaatu ree!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.23",
                "verseOrgIds": [
                  "MAT.6.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namni gooftota lama tajaajiluu dandaʼu tokko iyyuu hin jiru. Isa tokko jibbitee isa kaan jaallattaatii; yookaan isa tokkoof of kennitee isa kaan immoo tuffatta. Isinis Waaqaa fi Maallaqa tajaajiluu hin dandeessan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.24",
                "verseOrgIds": [
                  "MAT.6.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hin Yaaddaʼinaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
