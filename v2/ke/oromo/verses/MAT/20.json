              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis haati ilmaan Zabdewoos ilmaan ishee wajjin gara Yesuus dhuftee jilbeenfattee waa isa kadhatte.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        }
      ]
