  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "MAT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Warra Iddoo Dhaaba Wayinii Keessa Hojjetanii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mootummaan samiis abbaa lafaa kan iddoo dhaabaa wayinii isaatti hojjettoota qacarachuuf jedhee barii obboroo manaa baʼe tokko fakkaata.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.1",
                "verseOrgIds": [
                  "MAT.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Innis guyyaatti diinaarii",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.2",
                "verseOrgIds": [
                  "MAT.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.2",
            "verseOrgIds": [
              "MAT.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "tokko tokko isaanii kaffaluuf hojjettoota sanaan walii galee gara iddoo dhaabaa wayinii isaatti isaan erge.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.2",
                "verseOrgIds": [
                  "MAT.20.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namichi sunis gara saʼaatii sadiitti gad baʼee namoota hojii malee iddoo gabaa dhadhaabatan kanneen biraa arge.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.3",
                "verseOrgIds": [
                  "MAT.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.3",
            "verseOrgIds": [
              "MAT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Isinis dhaqaatii iddoo dhaabaa wayinii kootii keessa hojjedhaa; anis waan isiniif malu isiniifin kaffalaa' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.4",
                "verseOrgIds": [
                  "MAT.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.4",
            "verseOrgIds": [
              "MAT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaanis ni dhaqan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.5",
                "verseOrgIds": [
                  "MAT.20.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ammas gara saʼaatii jaʼaa fi gara saʼaatii sagaliitti gad baʼee akkasuma godhe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.5",
                "verseOrgIds": [
                  "MAT.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.5",
            "verseOrgIds": [
              "MAT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naannoo saʼaatii kudha tokkoottis gad baʼee namoota hojii malee dhadhaabatan biraa argee, 'Isin maaliif guyyaa guutuu hojii malee as dhadhaabattu?' jedhee isaan gaafate.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.6",
                "verseOrgIds": [
                  "MAT.20.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isaanis, 'Sababii namni tokko illee nu hin qacaratiniif' jedhanii deebisan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.7",
                "verseOrgIds": [
                  "MAT.20.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inni immoo, 'Isinis dhaqaatii iddoo dhaabaa wayinii kootii keessa hojjedhaa' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.7",
                "verseOrgIds": [
                  "MAT.20.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yommuu galgalaaʼetti abbaan iddoo dhaabaa wayinii sanaa hoogganaa hojii isaatiin, 'Hojjettoota waami; warra gara dhumaatti qacaramanii jalqabii hamma warra dura qacaramaniitti mindaa isaanii kaffaliif' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.8",
                "verseOrgIds": [
                  "MAT.20.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Warri gara saʼaatii kudha tokkootti qacaraman sunis dhufanii tokkoon tokkoon isaanii diinaarii tokko tokko fudhatan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.9",
                "verseOrgIds": [
                  "MAT.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.9",
            "verseOrgIds": [
              "MAT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Warri jalqabatti qacaraman yommuu dhufanitti waan warra kaan caalaa argatan seʼan. Garuu tokkoon tokkoon isaanii diinaarii tokko tokko fudhatan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.10",
                "verseOrgIds": [
                  "MAT.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.10",
            "verseOrgIds": [
              "MAT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaan yommuu diinaarii sana fudhatanitti abbaa lafaa sanatti guunguman.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.11",
                "verseOrgIds": [
                  "MAT.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.11",
            "verseOrgIds": [
              "MAT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaanis, 'Warri gara dhumaatti qacaraman kunneen saʼaatii tokko qofa hojjetan; ati garuu nu warra dadhabbii hojichaatii fi hoʼa guyyaa obsine isaaniin wal qixxeessite' jedhaniin.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.12",
                "verseOrgIds": [
                  "MAT.20.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inni garuu hojjettoota sana keessaa isa tokkoon, 'Yaa michuu ko, ani waan tokkoon illee si hin miine. Ati diinaarii tokkoon naan walii hin gallee?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.13",
                "verseOrgIds": [
                  "MAT.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.13",
            "verseOrgIds": [
              "MAT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Qooda kee fudhadhuu deemi; ani namicha isa gara dhumaa kanaafis hammuma siif kenne sana kennuufii nan barbaada.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.14",
                "verseOrgIds": [
                  "MAT.20.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.14",
            "verseOrgIds": [
              "MAT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani qarshii kootiin waan barbaade gochuuf mirga hin qabuu? Yookaan sababii ani arjaa taʼeef hinaaftaa?' jedhe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.15",
                "verseOrgIds": [
                  "MAT.20.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akkasuma warri dhumaa warra jalqabaa ni taʼu; warri jalqabaa immoo warra dhumaa ni taʼu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.16",
                "verseOrgIds": [
                  "MAT.20.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Yeroo Sadaffaa Waaʼee Duʼa Isaa Duraan Dursee Dubbate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.20.17-MAT.20.19"
          },
          "items": [
            {
              "text": "20:17‑19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MRK.10.32-MRK.10.34"
              },
              "items": [
