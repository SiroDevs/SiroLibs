  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "MAT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Dubarran Kurnanii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yeroo sanatti mootummaan samii dubarran kudhan kanneen ibsaa isaanii fudhatanii misirricha simachuudhaaf gad baʼan fakkaata.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.1",
                "verseOrgIds": [
                  "MAT.25.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaan keessaas shan gowwoota, shan immoo ogeeyyii turan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.2",
                "verseOrgIds": [
                  "MAT.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Warri gowwoonni ibsaa isaanii fudhatan malee zayitii hin fudhanne.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.3",
                "verseOrgIds": [
                  "MAT.25.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Warri ogeeyyiin garuu ibsaa isaanii wajjin zayitii qodaatti qabatanii turan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.4",
                "verseOrgIds": [
                  "MAT.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Misirrichi sun turraan hundumti isaanii mugan; ni rafanis.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.5",
                "verseOrgIds": [
                  "MAT.25.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Halkan walakkaattis sagaleen guddaan, 'Kunoo, misirrichi dhufeera! Baʼaatii isa simadhaa!' jedhu tokko dhagaʼame.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.6",
                "verseOrgIds": [
                  "MAT.25.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dubarri sun hundinuus kaʼanii ibsaa isaanii qopheeffatan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.7",
                "verseOrgIds": [
                  "MAT.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Warri gowwoonni sun warra ogeeyyiidhaan, 'Ibsaan keenya nu duraa dhaamuutti jiraatii zayitii keessan irraa xinnoo nuu kennaa' jedhan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.8",
                "verseOrgIds": [
                  "MAT.25.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Warri ogeeyyiinis deebisanii, 'Hin kenninu; tarii wanni nuu fi isin gaʼu hin jiru taʼaatii. Qooda kanaa warra gurguran bira dhaqaatii ofii keessaniif bitadhaa' jedhaniin.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.9",
                "verseOrgIds": [
                  "MAT.25.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Garuu utuma isaan zayitii bitachuu dhaquutti jiranuu misirrichi dhufe. Dubarri qophaaʼanis isa wajjin galma cidha fuudhaatti ol galan. Balballis ni cufame.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.10",
                "verseOrgIds": [
                  "MAT.25.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ergasii dubarran kaanis dhufanii, 'Yaa Gooftaa, yaa Gooftaa, balbala nuuf bani!' jedhaniin.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.11",
                "verseOrgIds": [
                  "MAT.25.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inni garuu deebisee, 'Dhuguman isinitti hima; ani isin hin beeku' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.12",
                "verseOrgIds": [
                  "MAT.25.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kanaafuu isin sababii guyyaa sana yookaan saʼaatii sana hin beekneef dammaqaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.13",
                "verseOrgIds": [
                  "MAT.25.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Taalaantii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.25.14-MAT.25.30"
          },
          "items": [
            {
              "text": "25:14‑30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwi –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.19.12-LUK.19.27"
              },
              "items": [
                {
                  "text": "Luq 19:12‑27",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ammas mootummaan samii nama biyya fagoo dhaqu tokko fakkaata; namichis garboota isaa waamee qabeenya isaa imaanaa itti kennate.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.14",
                "verseOrgIds": [
                  "MAT.25.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tokkoo tokkoo isaaniittis akkuma dandeettii isaaniitti, isa tokkotti taalaantii shan, isa kaanitti taalaantii lama, isa kaanitti immoo taalaantii tokko kennee kaʼee deeme.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.15",
                "verseOrgIds": [
                  "MAT.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namichi taalaantii shan fudhate sun, yeroodhuma sana dhaqee ittiin daldalee taalaantii biraa shan irraa buufate.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.16",
                "verseOrgIds": [
                  "MAT.25.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inni taalaantii lama fudhates akkasuma taalaantii biraa lama irraa buufate.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.17",
                "verseOrgIds": [
                  "MAT.25.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namichi taalaantii tokko fudhate garuu dhaqee lafa qotee maallaqa gooftaa isaa dhokse.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.18",
                "verseOrgIds": [
                  "MAT.25.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yeroo dheeraa booddee gooftaan garboota sanaa deebiʼee herrega isaan bira jiru herregate.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.19",
                "verseOrgIds": [
                  "MAT.25.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namichi taalaantii shan fudhatee ture sun taalaantii biraa shan fidee, 'Yaa gooftaa, ati taalaantii shan imaanaa natti kennitee turte. Ani immoo kunoo, taalaantii shan irraa buufadheera' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.20",
                "verseOrgIds": [
                  "MAT.25.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gooftaan isaas deebisee, 'Yaa garbicha gaarii fi amanamaa, waan gaarii hojjette! Ati waan akka malee xinnoo irratti amanamaa taateerta; ani immoo waan baayʼee irratti sin muuda. Kottuutii gammachuu gooftaa keetiitti gali!' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.21",
                "verseOrgIds": [
                  "MAT.25.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namichi taalaantii lama fudhatee tures dhufee, 'Yaa gooftaa, ati taalaantii lama imaanaa natti kennitee turte; ani immoo kunoo, taalaantii biraa lama irraa buufadheera' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.22",
                "verseOrgIds": [
                  "MAT.25.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gooftaan isaas deebisee, 'Yaa garbicha gaarii fi amanamaa, waan gaarii hojjette! Ati waan xinnoo irratti amanamaa taateerta; ani immoo waan baayʼee irratti sin muuda. Kottuutii gammachuu gooftaa keetiitti gali!' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.23",
                "verseOrgIds": [
                  "MAT.25.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namichi taalaantii tokkicha fudhatee tures dhufee akkana jedhe; 'Yaa gooftaa, ati nama gara jabeessa iddoo itti hin facaasinii galfattu, iddoo itti hin bittinneessiniis walitti qabattu akka taate nan beeka.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.24",
                "verseOrgIds": [
                  "MAT.25.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaafuu ani sodaadhee dhaqeen taalaantii kee lafa keessa dhokse. Taalaantiin kee kunoo ti.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.25",
                "verseOrgIds": [
                  "MAT.25.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gooftaan isaas deebisee akkana jedhe; 'Yaa garbicha hamaa dhibaaʼaa! Ati akka ani iddoon itti hin facaasinii galfadhu, iddoon itti hin bittinneessiniis walitti qabadhu beektaa?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.26",
                "verseOrgIds": [
                  "MAT.25.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoos akka ani yommuun deebiʼutti dhala isaa wajjin fudhadhuuf silaa maallaqa koo warra baankii bira naa kaaʼuu qabda ture.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.27",
                "verseOrgIds": [
                  "MAT.25.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Kanaaf taalaanticha isa harkaa fuudhaatii namicha taalaantii kudhan qabuuf kennaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.28",
                "verseOrgIds": [
                  "MAT.25.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kan qabu kamiif iyyuu itti dabalamee ni kennama; irraa hafaas ni qabaataatii. Kan hin qabne garuu wanni inni qabu iyyuu irraa fudhatama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.29",
                "verseOrgIds": [
                  "MAT.25.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garbicha faayidaa hin qabne kana dukkana alaatti gad darbadhaa; achittis booʼichaa fi ilkaan qaruutu taʼa.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.30",
                "verseOrgIds": [
                  "MAT.25.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hoolotaa fi Reʼoota",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ilmi Namaa yommuu ulfina isaatiin ergamoota Waaqaa hunda wajjin dhufutti, teessoo isaa kan ulfinaa irra ni taaʼa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.31",
                "verseOrgIds": [
                  "MAT.25.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Saboonni hundinuu fuula isaa duratti walitti qabamu; innis akkuma tikseen tokko hoolotaa fi reʼoota gargar footu sana namoota gargar ni foʼa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.32",
                "verseOrgIds": [
                  "MAT.25.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inni hoolota karaa mirga isaa, reʼoota immoo karaa bitaa isaa ni dhaabachiisa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.33",
                "verseOrgIds": [
                  "MAT.25.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yeroo sana Mootichi warra mirga isaa jiraniin akkana jedha; 'Isin warri Abbaan koo eebbise kottaa mootumicha uumamuu addunyaatii jalqabee isinii qopheeffame sana dhaalaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.34",
                "verseOrgIds": [
                  "MAT.25.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sababiin isaas ani beelofnaan isin nyaata naaf kennitan; dheebonnaan waan ani dhugu naaf kennitan; ani keessummaan ture; isin immoo na simattan;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.35",
                "verseOrgIds": [
                  "MAT.25.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ani daarraan daara na baaftan; dhukkubsannaan na gaafattan; hidhamnaan dhuftanii na ilaaltan.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.36",
                "verseOrgIds": [
                  "MAT.25.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Qajeeltonni sunis deebisanii akkana jedhaniin; 'Yaa Gooftaa, yoom beeloftee si arginee waan ati nyaattu siif kennine? Yookaan yoom dheebottee si arginee waan ati dhugdu siif kennine?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.37",
                "verseOrgIds": [
                  "MAT.25.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoom keessummaa taʼuu kee arginee si simanne? Yookaan yoom daartee si arginee daara si baafne?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.38",
                "verseOrgIds": [
                  "MAT.25.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoom dhukkubsattee yookaan hidhamtee si arginee dhufnee si ilaalle?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.39",
                "verseOrgIds": [
                  "MAT.25.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mootiin sunis deebisee, 'Ani dhuguman isinitti hima; waan obboloota koo warra nama hundumaa gad taʼan kanneen keessaa isa tokkoof gootan kam iyyuu naaf gootan' jedhaan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.40",
                "verseOrgIds": [
                  "MAT.25.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ergasiis warra bitaa isaa jiraniin akkana jedha; 'Isin yaa abaaramoo, na duraa badaatii ibidda bara baraa isa diiyaabiloosii fi ergamoota isaatiif qopheeffametti galaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.41",
                "verseOrgIds": [
                  "MAT.25.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani beelofnaan isin waan ani nyaadhu naaf hin kennineetii; ani dheebonnaan waan ani dhugu naaf hin kennineetii;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.42",
                "verseOrgIds": [
                  "MAT.25.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ani keessummaan ture; isin na hin simanne; ani daarraan isin daara na hin baafne; dhukkubsannaan yookaan hidhamnaan dhuftanii na hin ilaalle.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.43",
                "verseOrgIds": [
                  "MAT.25.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
