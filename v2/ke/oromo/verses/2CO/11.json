            "sid": "2CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damaasqoo keessatti namichi mooticha Areexaas jalatti bulchaa biyyaa ture na qabsiisuuf jedhee magaalaa namoota Damaasqoo eegsisaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
