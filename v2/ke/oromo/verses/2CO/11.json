          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu foddaa dallaa keessaan guuboodhaan gad buufamee harka isaa jalaa baʼe.",
          "type": "text",
          "attrs": {
