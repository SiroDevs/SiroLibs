  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EST 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mordekaayi Ulfina Argate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkan sana mootichi rafuu hin dandeenye; kanaafuu inni akka isaan kitaaba seenaa kan waaʼee mootummaa isaa barreeffame isaaf dubbisan ni ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.1",
            "verseOrgIds": [
              "EST.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitaaba sana keessattis Mordekaayi akka Bigtaanaa fi Tereshi xuʼaashiiwwan balbala eegan kanneen Ahashweroos Mooticha ajjeesuuf mariʼatan sana lamaan saaxilee ture barreeffamee argame.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.2",
            "verseOrgIds": [
              "EST.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Yoos Mordekaayi sababii waan kanaatiif ulfina yookaan kabaja maalii argate ree?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:3"
      },
      "items": [
        {
          "text": "Tajaajiltoonni isaa immoo, \"Wanni tokko iyyuu hin godhamneef\" jedhanii deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Eenyutu oobdii kana keessa jira?\" jedhee gaafate. Yeroo sana Haamaan waaʼee Mordekaayiin muka dhaabe sana irratti fannisuu mootichatti himuuf jedhee oobdii masaraa mootummaa isa gara alaa seenee ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.4",
            "verseOrgIds": [
              "EST.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajaajiltoonni mootichaa, \"Haamaanitu oobdii keessa dhaabatee jira\" jedhanii deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:5"
      },
      "items": [
        {
          "text": "Mootichis, \"Isa ol galchaa\" jedhee ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis yeroo Haamaan ol galetti, \"Nama mootichi kabajuu barbaaduuf maaltu godhamuufii qaba?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:6"
      },
      "items": [
        {
          "text": "Haamaanis, \"Namni mootichi na caalchisee kabaju eenyu?\" jedhee ofi keessatti yaade.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Haamaan akkana jedhee mootichaaf deebise; \"Nama mootichi kabajuu jaallatuuf,",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.7",
            "verseOrgIds": [
              "EST.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "uffata mootummaa kan mootichi uffatuu fi farda mootummaa kan mootichi yaabbatu haa fidan; fardi gonfoon mootii mataatti kaaʼameef haa dhufuuf.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.8",
            "verseOrgIds": [
              "EST.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii uffannii fi fardi sun qondaaltota mootichaa kanneen qondaaltota hunda caalaa beekamoo taʼan keessaa isa tokkotti imaanaan haa kennamuuf; isaan immoo nama mootichi ulfina kennuufii barbaadu sanatti uffata sana haa uffisan; farda yaabbachiisaniis, 'Wanni nama mootichi ulfina kennuufii barbaaduuf godhamu kana!' jedhanii labsaa daandiiwwan magaalattii irra fuula isaa dura haa deeman.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.9",
            "verseOrgIds": [
              "EST.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis akkana jedhee Haamaanin ajaje; \"Dafii dhaqii uffataa fi farda sana fuudhiitii akkuma jette sana Mordekaayi Yihuudicha karra mootii dura taaʼu sanaaf godhi. Waan jette sana keessaa tokko illee hin hambisin.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Haamaan dhaqee uffataa fi farda sana fuudhe. Innis uffata sana Mordekaayiitti uffisee fardas yaabbachiisee, \"Wanni nama mootichi ulfina kennuufii barbaaduuf godhamu kanaa dha!\" jedhee labsaa daandii magaalaa irra fuula isaa dura deeme.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Mordekaayi gara karra mootichaatti deebiʼe. Haamaan garuu gaddaan mataa haguuggatee ariitiidhaan manatti gale;",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan isa irra gaʼe hundas niitii isaa Zeresh fi michoota isaa hundatti hime.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:13"
      },
      "items": [
        {
          "text": "Gorsitoonni isaatii fi niitiin isaa Zosaaraan, \"Sababii Mordekaayi inni kufaatiin kee fuula isaa duratti jalqabe sun sanyii Yihuudaa taʼeef ati isaan mormuu hin dandeessu; ati dhugumaan ni badda!\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma isaan isa wajjin dubbachaa jiranuu xuʼaashiiwwan mootichaa dhufanii gara cidha Asteer qopheessitee turte sanaatti Haamaan ariifachiisan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
      ]
    }
  ],
