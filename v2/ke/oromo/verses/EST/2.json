    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asteer Niitii Mootii Taate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahashweroos Mootichi erga aariin isaa qabbanaaʼee booddee waan Waashtiin gootee fi labsii inni waaʼee ishee labse ni yaadate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irrattis tajaajiltoonni mootichaa akkana jedhanii yaada dhiʼeessan; \"Dubarran babbareedoon mootichaaf haa barbaadaman.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan kutaalee biyyaa mootichaa hunda keessaa dubarran babbareedoo hunda gara Suusaa magaalaa guddoo iddoo dubartoonni jiraatanitti fidaniif mootichi itti gaafatamtoota haa muudu; isaanis Heegaayi xuʼaashii mootichaa itti gaafatamaa dubartoota sana jalatti haa ajajaman; dubarran sanaafis kunuunsi miidhaginaa haa godhamu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis durbi mooticha gammachiiftu iddoo Waashtiin buutee niitii mootii haa taatu.\" Gorsi kunis mooticha ni gammachiise; innis akkuma jedhame sana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti gosa Beniyaam keessaa namichi Yihuudaa ilmi Yaaʼiir, ilmi Shimeʼii, ilmi Qiish kan Mordekaayi jedhamu tokko Suusaa magaalaa muummittii keessa jiraata ture;",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis warra Yehooyaakiin mooticha Yihuudaa wajjin Yerusaalemii Nebukadnezar mooticha Baabiloniin boojiʼamanii fudhataman keessaa tokko ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.6",
            "verseOrgIds": [
              "EST.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaayis, durbii Hadasaa jedhamtu kan sababii isheen abbaa fi haadha hin qabneef ofitti fudhate tokko qaba ture. Durbi Asteer jedhamtee beekamtu kun dhaabaa fi bifaan jaallatamtuu turte; yeroo abbaa fi haati ishee duʼanitti Mordekaayi ofitti fudhatee akkuma intala ofii isaatti guddifate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.7",
            "verseOrgIds": [
              "EST.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ajajnii fi labsiin mootichaa dhagaʼametti dubarran hedduun gara Suusaa magaalaa gudditiitti fidamanii harka Hegeetti kennaman. Asteeris gara masaraa mootichaatti geeffamtee Heegaayi itti gaafatamaa dubartootaa sanatti imaanaa kennamte.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.8",
            "verseOrgIds": [
              "EST.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Durbi sunis isa gammachiiftee fuula isaa duratti fudhatama argatte. Innis yommusuma dibata miidhagina isheetiif taʼuu fi nyaata addaa kenneef. Dubartoota ishee tajaajilan kanneen masaraa mootichaa keessaa filataman torbas isheedhaaf ramade; ishee fi tajaajiltoota ishee sana gara mana dubartootaa kan mana hunda caalaa filatamaa taʼeetti geesse.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.9",
            "verseOrgIds": [
              "EST.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Mordekaayi akka isheen hin himne ishee dhowweef Asteer saba isheetii fi maalummaa maatii ishee hin himne.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.10",
            "verseOrgIds": [
              "EST.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaayis haala Asteer keessa jirtuu fi waan ishee irra gaʼe beekuudhaaf guyyuma guyyaadhaan fuula oobdii mana dubartootaa dura jiru sana irra deddeebiʼaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Durbi tokko utuu dabareen isheen itti fuula Ahashweroos Mootichaa duratti dhiʼeeffamtu hin gaʼin dura akkuma seera dubartootaaf kaaʼame sanaatti kunuunsa miidhaginaa kan jiʼa kudha lamaa fixuu qabdi ture; isheenis jiʼa jaʼa zayitii qumbiitiin, jiʼa jaʼa immoo shittoo fi dibata garaa garaatiin miidhagfamuu qabdi ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.12",
            "verseOrgIds": [
              "EST.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haalli itti durbi tokko mooticha bira dhaqxu akkana ture: Wanni isheen mana dubartootaatii fudhattee gara masaraa mootichaa dhaquu feetu kam iyyuu ni kennamaaf ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.13",
            "verseOrgIds": [
              "EST.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis galgala achi dhaqxee ganama immoo gara kutaa mana dubartootaa kan harka Shaʼasgaazi xuʼaashii itti gaafatamaa saajjatoowwan sana jala jiru kaaniitti deebiti turte; yoo mootichi itti gammadee maqaadhaan waame malee isheen gara mootichaatti hin deebitu turte.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.14",
            "verseOrgIds": [
              "EST.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu dabareen Asteer intalli Abiihaayil obboleessa abbaa Mordekaayi kan Mordekaayi akkuma intala ofii isaatti guddifate sun itti mooticha bira dhaqxu gaʼetti isheen waan Heegaayi xuʼaashiin mootichaa inni itti gaafatamaa mana dubartootaa ture sun gorse malee waan tokko illee hin gaafanne. Asteeris fuula nama ishee argu hundaa duratti fudhatama argatte.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.15",
            "verseOrgIds": [
              "EST.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis bara mootichaa keessa waggaa torbaffaa jiʼa kurnaffaa Teebeeti jedhamu keessa gara mana jireenyaa Ahashweroos Mootichaatti dhiʼeeffamte.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.16",
            "verseOrgIds": [
              "EST.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis dubartoota kaan hunda caalaa Asteerin jaallate; isheenis dubarran qulqulluu kaan hunda caalaa fuula isaa duratti surraa fi fudhatama argatte. Kanaafuu inni gonfoo mootummaa mataa ishee irra kaaʼeefii qooda Waashtiin ishee mootittii taasise.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.17",
            "verseOrgIds": [
              "EST.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis mootichi ulfina Asteeriitiif jedhee qondaaltota isaatii fi tajaajiltoota isaatiif cidha guddaa qopheesse. Innis ayyaana kana guutummaa kutaalee biyyaa keessatti labse; akkuma arjooma mootiitti kennaas kenne.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.18",
            "verseOrgIds": [
              "EST.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mordekaayi Mala Ifatti Baasuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu dubarran qulqulloonni sun yeroo lammaffaa walitti qabamanitti Mordekaayi karra mootichaa dura taaʼaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.19",
            "verseOrgIds": [
              "EST.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asteer garuu akkuma Mordekaayi ishee gorse sanatti maalummaa maatii isheetii fi saba ishee hin himne; Asteer akkuma yeroo inni ishee guddise sanaatti ajaja Mordekaayi eegaa turteetii.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.20",
            "verseOrgIds": [
              "EST.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Mordekaayi karra mootichaa dura taaʼaa turetti qondaaltonni mootichaa warri balbala eegaa turan lamaan jechuunis Bigtaanaa fi Tereshi aaranii Ahashweroos Mooticha ajeessuuf malatan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.21",
            "verseOrgIds": [
              "EST.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaayi garuu waaʼee mala kanaa beekee Asteer Mootittiitti hime; Asteer immoo maqaa Mordekaayiin waan kana mootichatti himte.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.22",
            "verseOrgIds": [
              "EST.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo wanni sun qoratamee dhugaa taʼee argametti qondaaltonni sun lamaanuu muka irratti fannifaman. Wanni kun hundinuu fuula mootichaa duratti kitaaba seenaa keessatti barreeffame.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.23",
            "verseOrgIds": [
              "EST.2.23"
            ]
          }
        }
      ]
    }
  ],
