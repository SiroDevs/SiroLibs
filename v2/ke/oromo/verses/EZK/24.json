        "vid": "EZK 24:11"
      },
      "items": [
        {
          "text": "okkotee duwwaa sana cilee bobaʼu irra kaaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
