    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dareewwan Lubootaaf Ramadaman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sana booddee namichi sun karaa kaabaatiin gara oobdii alaatti na baasee gara fuullee dareewwan oobdii mana qulqullummaa fi gara fuullee ijaarsa alaa kan karaa kaabaa jiruutti na fide.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijaarsi balballi isaa gara kaabaatti garagalu sun dheerina dhundhuma dhibba tokkoo fi balʼina dhundhuma dhibba tokko qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutaa oobdii isa gara keessaa kan dhundhuma digdamaa keessaa fi kutaa fuullee madabii oobdii kan gara alaa jiru keessa sadarkaa sadiin darbiin tokko darbii kaanitti garagalee ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dareewwan sana fuula duraanis karaan mana keessaan nama baasu kan dhundhuma kudhan balʼatee dhundhuma dhibba tokko dheeratutu ture. Balbalawwan isaaniis karaa kaabaatiin turan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii darbiiwwan sun iddoo dareewwan kanneen gara gadii irraa fi gamoo isa gidduu irraa qabatan caalaa dareewwan olii jalaa qabataniif dareewwan olii dhidhiphoo dha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dareewwan darbii sadaffaa irra jiran akka oobdiiwwanii utubaawwan hin qaban ture; kanaafuu darbiiwwan gara gadiitii fi walakkaa jiran caalaa lafa xinnaa qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6",
            "verseOrgIds": [
              "EZK.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keenyan karaa alaa tokkos dareewwanii fi oobdii gara alaa fuullee jira ture; innis dareewwan sana fuula duraan dhundhuma shantamaa dheerata ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.7",
            "verseOrgIds": [
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheerinni dareewwan oobdii alaatti aananii tarreedhaan jiranii dhundhuma shantama, tarreen mana qulqullummaatti aanee jiru immoo dhundhuma dhibba tokko dheerata ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu oobdii alaatii ol seenanitti, balballi karaa baʼaatiin gara dareewwan gadiitti nama seensisu tokko ni argama ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa kibbaatiinis dheerina dallaa oobdii gara alaa qabatee, oobdii mana qulqullummaa qabatee fuullee dallaa gara alaatiin dareewwan",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "fuula isaanii duraan karaa namni irra darbu qabantu ture. Dareewwan kunneenis akkuma dareewwan karaa kaabaa sanaa turan; isaanis dheerinaa fi balʼina, karaa ittiin gad baʼanii fi guddina wal fakkaatu qabu turan. Balbalawwan karaa kaabaa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "balbalawwan dareewwan karaa kibbaa wajjin wal fakkaatu turan. Karaa namni irra darbu kan dallaa gara baʼaatti ijaarameen wal cina deemuun fuullee jiru kan ittiin dareewwan seenan tokkotu jira ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis inni akkana naan jedhe; \"Dareewwan kaabaatii fi kibbaa kanneen gara oobdii mana qulqullummaatti garagalanii jiran sun dareewwan lubootaa, iddoo itti luboonni warri fuula",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.42.13",
                "verseOrgIds": [
                  "EZK.42.13"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti dhiʼaatan aarsaa aarsaa hunda caalaa qulqulluu taʼe nyaatanii dha. Isaanis aarsaa aarsaa hunda caalaa qulqulluu taʼe jechuunis kennaa midhaanii, aarsaa cubbuutii fi aarsaa yakkaa achi kaaʼu; iddoon sun qulqulluudhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonni iddoo qulqulluu sana takkaa seennaan hamma uffata ittiin tajaajilan sana of irraa baasanitti gara oobdii gara alaatti hin baʼan; wayyaan sun qulqulluudhaatii. Isaan utuu iddoo uummataaf ramadametti hin dhiʼaatin uffata biraa uffachuu qabu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni erga waan mana qulqullummaa keessa jiru safaree xumuree booddee karaa balbala baʼaatiin na baasee naannoo sana hunda safare.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.15",
            "verseOrgIds": [
              "EZK.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kallattii baʼaas ulee ittiin safaraniin safare; wanni inni safares dhundhuma dhibba shan taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kallattii gara kaabaas safaree safarri sun ulee safaraatiin dhundhuma dhibba shan taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.17",
            "verseOrgIds": [
              "EZK.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kallattii kibbaatiinis safaree safarri sun ulee ittiin safaraniin dhundhuma dhibba shan taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.18",
            "verseOrgIds": [
              "EZK.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii inni gara kallattii dhiʼaatti garagalee safaree, safarri sun ulee ittiin safaraniin dhundhuma dhibba shan taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.19",
            "verseOrgIds": [
              "EZK.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu inni iddoo kallattii afraniin jiru safare. Iddoon sun dallaa iddoo qulqulluu, iddoo xuraaʼaa irraa addaan baasu kan dheerinni isaa dhundhuma dhibba shan, balʼinni isaas dhundhuma dhibba shan qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
          }
        }
      ]
    }
  ],
