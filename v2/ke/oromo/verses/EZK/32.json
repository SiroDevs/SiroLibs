        "vid": "EZK 32:15"
      },
      "items": [
        {
          "text": "biyyattiin waan ishee keessa jiru hunda dhabdutti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        }
