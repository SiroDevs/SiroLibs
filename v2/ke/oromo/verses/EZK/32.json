        "vid": "EZK 32:15"
      },
      "items": [
        {
          "text": "yommuu ani waan achi jiraatu hunda dhaʼutti",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
