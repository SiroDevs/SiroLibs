          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis guyyaa torbaaf iddoo aarsaatiif araara buusanii isa qulqulleessuu qabu; akkasittis isa qulqulleessu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
            "verseOrgIds": [
              "EZK.43.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
