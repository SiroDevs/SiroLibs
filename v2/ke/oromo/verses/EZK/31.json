      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "hidda isaa hunda marsanii yaaʼanii",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "bishaan isaanii",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "gara mukkeen bosonaa hundaatti ergu.",
