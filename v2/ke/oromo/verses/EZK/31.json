          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu inni mukkeen bosonaa hundaan olitti",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
