            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.18",
                "verseOrgIds": [
                  "EZK.31.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
