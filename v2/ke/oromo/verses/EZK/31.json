      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "inni bishaan baayʼee argatee babalʼateeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
