      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "bineensonni dirree hundi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
