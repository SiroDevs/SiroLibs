  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JHN 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Miilla Barattoota Isaa Dhiqe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroon sun Ayyaana Faasiikaatiin dura ture. Yesuusis akka addunyaa kana keessaa gara Abbaa dhaquudhaaf saʼaatiin isaa gaʼe ni beeke. Innis warra kan isaa taʼan kanneen addunyaa keessa turan ni jaallate; hamma dhumaattis isaan jaallate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.1",
            "verseOrgIds": [
              "JHN.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo irbaataatti diiyaabiloos akka inni Yesuusin dabarsee kennuuf Yihuudaa Keeriyoticha ilma Simoon keessa duraan dursee yaada kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.2",
            "verseOrgIds": [
              "JHN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akka Abbaan waan hunda harka isaatti kenne, akka Waaqa biraa dhufee fi akka gara Waaqaatti deebiʼu illee beeka ture;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.3",
            "verseOrgIds": [
              "JHN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaaf irbaata irraa kaʼee, wayyaa isaa kan irraan uffate of irraa fuudhee lafa kaaʼe; fooxaas mudhiitti hidhate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.4",
            "verseOrgIds": [
              "JHN.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii gabateetti bishaan naqatee miilla barattootaa dhiquu fi fooxaa mudhiitti hidhate sanaanis haquu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.5",
            "verseOrgIds": [
              "JHN.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gara Simoon Phexros dhufe; Phexrosis, \"Yaa Gooftaa, situ miilla koo naa dhiqaa?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.6",
            "verseOrgIds": [
              "JHN.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo deebisee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.7",
            "verseOrgIds": [
              "JHN.13.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waan ani hojjechaa jiru ati amma hin beektu; booddee garuu ni hubatta\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.7",
                "verseOrgIds": [
                  "JHN.13.7"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.7",
            "verseOrgIds": [
              "JHN.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phexrosis, \"Hin taʼu; ati gonkumaa miilla koo naa hin dhiqxu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 13:8"
      },
      "items": [
        {
          "text": "Yesuusis deebisee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yoo ani siif dhiquu baadhe ati na biraa qooda hin qabaattu\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.8",
                "verseOrgIds": [
                  "JHN.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoon Phexrosis deebisee, \"Yaa Gooftaa, yoos harka koo fi mataa koos malee miilla koo qofa hin taʼin\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.9",
            "verseOrgIds": [
              "JHN.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namni dhagna isaa dhiqate tokko miilla isaa qofa dhiqachuu isa barbaachisa; dhagni isaa guutuun qulqulluu dha. Isin qulqulluu dha; garuu hunda keessan miti\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.10",
                "verseOrgIds": [
                  "JHN.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis nama dabarsee isa kennuuf jiru beeka tureetii; sababiin inni,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.11",
            "verseOrgIds": [
              "JHN.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Qulqulluun hunda keessan miti\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.11",
                "verseOrgIds": [
                  "JHN.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheefis kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.11",
            "verseOrgIds": [
              "JHN.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis erga miilla isaanii dhiqee booddee, uffata isaa uffatee iddoo isaatti deebiʼee taaʼe. Akkanas jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.12",
            "verseOrgIds": [
              "JHN.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin waan ani isiniif godhe hubattanii?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.12",
                "verseOrgIds": [
                  "JHN.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.12",
            "verseOrgIds": [
              "JHN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin, 'Barsiisaa', 'Gooftaas' naan jettu; anis waan isuma isin jettan taʼeef isin dhuguma jettan.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.13",
                "verseOrgIds": [
                  "JHN.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.13",
            "verseOrgIds": [
              "JHN.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoos erga ani Gooftaa fi Barsiisaan keessan miilla keessan isinii dhiqee, isinis akkasuma miilla walii dhiquu qabdu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.14",
                "verseOrgIds": [
                  "JHN.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.14",
            "verseOrgIds": [
              "JHN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akkuma ani isinii godhe kana isinis akka gootaniif ani fakkeenya isinii kenneera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.15",
                "verseOrgIds": [
                  "JHN.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.15",
            "verseOrgIds": [
              "JHN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani dhuguman, dhuguman isinitti hima; garbichi gooftaa isaa hin caalu; ergamaanis kan isa erge hin caalu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.16",
                "verseOrgIds": [
                  "JHN.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.16",
            "verseOrgIds": [
              "JHN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Egaa isin yoo waan kana beektanii hojii irra oolchitan isin eebbifamoo dha.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.17",
                "verseOrgIds": [
                  "JHN.13.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Akka Dabarfamee Kennamu Duraan Dursee Dubbate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani waaʼee hunda keessanii dubbachaa hin jiru; ani warran filadhe nan beeka. Kun garuu dubbiin Katabbii Qulqulluu kan, 'Inni buddeena koo nyaate koomee isaa natti ol fudhate'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.18",
                "verseOrgIds": [
                  "JHN.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.18",
            "verseOrgIds": [
              "JHN.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "jedhu sun akka guutamuuf.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.18",
                "verseOrgIds": [
                  "JHN.13.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin yommuu wanni kun taʼutti akka ani Isa taʼe akka amantaniif utuu inni hin taʼin amma isinitti nan hima.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.19",
                "verseOrgIds": [
                  "JHN.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.19",
            "verseOrgIds": [
              "JHN.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani dhuguman, dhuguman isinitti hima; kan nama ani ergu kam iyyuu simatu hundinuu na simata; kan na simatu hundis isa na erge sana simata.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.20",
                "verseOrgIds": [
                  "JHN.13.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis erga kana dubbatee booddee hafuuraan jeeqamee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.21",
            "verseOrgIds": [
              "JHN.13.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani dhuguman, dhuguman isinitti hima; isin keessaa tokko dabarsee na kenna\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.21",
                "verseOrgIds": [
                  "JHN.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee dhugaa baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.21",
            "verseOrgIds": [
              "JHN.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonni akka inni waaʼee eenyuu dubbate wallaalanii wal ilaalan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.22",
            "verseOrgIds": [
              "JHN.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoota keessaas inni Yesuus isa jaallatu tokko Yesuusitti irkatee maaddiitti dhiʼaatee ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.23",
            "verseOrgIds": [
              "JHN.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoon Phexrosis, \"Mee eenyuu jechuu isaa akka taʼe isa gaafadhu!\" jedhee nyaaraan barataa sanatti hime.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.24",
            "verseOrgIds": [
              "JHN.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis qoma Yesuusiitti hirkatee, \"Yaa Gooftaa, eenyu innii?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.25",
            "verseOrgIds": [
              "JHN.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis deebisee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namichi ani buddeena afaan kaaʼata tokkoo caabii keessa cuuphee kennuuf isa\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.26",
                "verseOrgIds": [
                  "JHN.13.26"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe. Innis buddeena caabii keessa cuuphee Yihuudaa ilma Simoon Keeriyotichaatiif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudaas akkuma inni buddeenicha fudhateen Seexanni itti gale.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 13:27"
      },
      "items": [
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waan gochuuf jirtu dafii godhi\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.27",
                "verseOrgIds": [
                  "JHN.13.27"
                ]
              }
            }
          ]
        },
        {
          "text": "isaan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra nyaataaf tataaʼan keessaas namni tokko iyyuu waan inni akkas isaan jedheef hin hubanne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.28",
            "verseOrgIds": [
              "JHN.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Yihuudaan korojoo maallaqaa baachaa tureefis isaan keessaa namoonni tokko tokko waan Yesuus, akka inni waan Ayyaanaaf barbaachisu bitu yookaan akka inni hiyyeeyyiif waa kennu isatti hime seʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.29",
            "verseOrgIds": [
              "JHN.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudaanis akkuma buddeena sana fudhateen gad baʼe. Yeroon sunis halkan ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Akka Phexros Isa Ganu Duraan Dursee dubbate",
          "type": "text"
        }
      ]
    },
