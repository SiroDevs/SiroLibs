    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa jalqaba torban sanaa ganama barii utuma dukkanaaʼee jiruu Maariyaam isheen Magdalaa gara awwaalaa dhaqxee akka dhagaan afaan awwaala sanaa irraa fuudhame argite.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.1",
            "verseOrgIds": [
              "JHN.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isheen fiigaa gara Simoon Phexrosii fi gara barataa biraa kan Yesuus isa jaallate sanaa dhaqxee, \"Gooftaa awwaala keessaa fudhataniiru; eessa akka isa kaaʼanis hin beeknu!\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.2",
            "verseOrgIds": [
              "JHN.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Phexrosii fi barataan kaan baʼanii gara awwaalichaa dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.3",
            "verseOrgIds": [
              "JHN.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lachan isaanii iyyuu ni fiigu turan; barataan kaan garuu Phexros bira darbee fiiguudhaan dursee iddoo awwaalaa sana gaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.4",
            "verseOrgIds": [
              "JHN.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis gad jedhee ilaalee huccuu quncee talbaa irraa hojjetame lafatti arge malee awwaalicha keessa hin seenne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.5",
            "verseOrgIds": [
              "JHN.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoon Phexros immoo isa duubaan dhufee awwaalicha keessa seene. Huccuu sanas lafatti arge;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.6",
            "verseOrgIds": [
              "JHN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkanumas huccuu mataa Yesuusitti maramee ture arge. Huccuun sunis kophaa isaa dachaafamee iddoo biraa ture malee huccuu quncee talbaa irraa hojjetame sana bira hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.7",
            "verseOrgIds": [
              "JHN.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis barataan biraa inni jalqabatti awwaalicha bira gaʼe sun keessa seene. Innis argee amane.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.8",
            "verseOrgIds": [
              "JHN.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akka Yesuus warra duʼan keessaa kaʼu Katabbii Qulqulluu irraa amma iyyuu hin beekne tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.9",
            "verseOrgIds": [
              "JHN.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Maariyaam Ishee Magdalaatti Mulʼate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonni sunis gara mana isaaniitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maariyaam garuu alaan awwaala bira dhaabattee booʼaa turte. Utuma boossuus awwaallatti gad jettee ilaalte;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.11",
            "verseOrgIds": [
              "JHN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "isheenis ergamoota lama kanneen uffata adaadii uffatanii iddoo reeffi Yesuus kaaʼamee ture sana, inni tokko mataa duraan, kaan immoo miilla jalaan taaʼan argite.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.12",
            "verseOrgIds": [
              "JHN.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Dubartii nana, maaliif boossa?\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 20:13"
      },
      "items": [
        {
          "text": "Isheen immoo, \"Gooftaa koo fudhataniiru; eessa akka isa kaaʼanis ani hin beeku\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu waan kana dubbattee of irra gara galtettis Yesuusin isaa achi dhaabatu argite; garuu Yesuus taʼuu isaa hin beekne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.14",
            "verseOrgIds": [
              "JHN.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dubartii nana, maaliif boossa? Eenyun barbaadda?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.15",
                "verseOrgIds": [
                  "JHN.20.15"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 20:15"
      },
      "items": [
        {
          "text": "Isheen immoo, nama iddoo biqiltuu keessa hojjetu seetee, \"Yaa gooftaa, ati yoo isa fuutee jiraatte, akka ani dhaqee fudhadhuuf eessa akka isa keesse natti himi\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Maariyaam!\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.16",
                "verseOrgIds": [
                  "JHN.20.16"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 20:16"
      },
      "items": [
        {
          "text": "Isheenis isatti gara galtee afaan Ibraayisxiitiin,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "\"Rabbuunii!\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.16",
                "verseOrgIds": [
                  "JHN.20.16"
                ]
              }
            }
          ]
        },
        {
          "text": "jetteen. Hiikkaan isaas \"Barsiisaa\" jechuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.17",
            "verseOrgIds": [
              "JHN.20.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani amma illee waan gara Abbaatti ol hin baʼiniif na hin tuqin. Garuu obboloota koo bira dhaqiitii, 'Ani gara Abbaa kootii fi Abbaa keessaniitti, gara Waaqa kootii fi Waaqa keessaniitti ol nan baʼa' jedheera jedhiitii isaanitti himi\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.17",
                "verseOrgIds": [
                  "JHN.20.17"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.17",
            "verseOrgIds": [
              "JHN.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maariyaam isheen Magdalaas gara barattootaa dhaqxee, \"Ani Gooftaa argeera!\" jette. Akka inni waan kana isheen jedhes isaanitti himte.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.18",
            "verseOrgIds": [
              "JHN.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Barattoota Isaatti Mulʼate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa jalqaba torban sanaa galgala utuu barattoonni waan Yihuudoota sodaataniif balbala cufatanii walitti qabamanii jiranuu Yesuus dhufee isaan gidduu dhaabatee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.19",
            "verseOrgIds": [
              "JHN.20.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nagaan isiniif haa taʼu\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.19",
                "verseOrgIds": [
                  "JHN.20.19"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.19",
            "verseOrgIds": [
              "JHN.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis erga waan kana dubbatee booddee harka isaatii fi cinaacha isaa isaanitti argisiise. Barattoonnis yommuu Gooftaa arganitti akka malee gammadan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.20",
            "verseOrgIds": [
              "JHN.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus amma illee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.21",
            "verseOrgIds": [
              "JHN.20.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nagaan isiniif haa taʼu! Akkuma Abbaan na erge sana anis isinan erga\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.21",
                "verseOrgIds": [
                  "JHN.20.21"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.21",
            "verseOrgIds": [
              "JHN.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis erga waan kana jedhee booddee Hafuura isaanitti baafatee akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.22",
            "verseOrgIds": [
              "JHN.20.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hafuura Qulqulluu fudhadhaa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.22",
                "verseOrgIds": [
                  "JHN.20.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.22",
            "verseOrgIds": [
              "JHN.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo isin namootaaf cubbuu isaanii dhiiftan isaaniif ni dhiifama; yoo isaaniif dhiisuu baattan immoo isaaniif hin dhiifamu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.23",
                "verseOrgIds": [
                  "JHN.20.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Toomaasitti Mulʼate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo Yesuus dhufetti warra Kudha Lamaan keessaa Toomaas inni Didimoos jedhamu tokko barattoota wajjin hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.24",
            "verseOrgIds": [
              "JHN.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu barattoonni warri kaan, \"Nu Gooftaa argineerra!\" jedhanii isatti himan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 20:25"
      },
      "items": [
        {
          "text": "Inni garuu, \"Ani iddoo mismaaraan waraaname harka isaa irratti argu malee, quba koo iddoo mismaaraa sana keessa kaaʼu malee, harka koos cinaacha isaa keessa kaaʼu malee hin amanu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa saddeeti booddee barattoonni isaa ammas mana keessa turan; Toomaasis isaan wajjin ture. Utuma balbalichi cufamee jiruus Yesuus ol galee isaan gidduu dhaabatee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.26",
            "verseOrgIds": [
              "JHN.20.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nagaan isiniif haa taʼu!\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.26",
                "verseOrgIds": [
                  "JHN.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.26",
            "verseOrgIds": [
              "JHN.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Toomaasiin,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.27",
            "verseOrgIds": [
              "JHN.20.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Quba kee as fidi; harka koo ilaali. Harka kee diriirfadhuutii cinaacha koo keessa kaaʼi. Amani malee amantii hin dhabin\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.27",
                "verseOrgIds": [
                  "JHN.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.27",
            "verseOrgIds": [
              "JHN.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toomaas immoo, \"Gooftaa koo! Waaqa koo!\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ati waan na argiteef amante; warri utuu hin argin amanan eebbifamoo dha\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.20.29",
                "verseOrgIds": [
                  "JHN.20.29"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus barattoota isaa duratti mallattoowwan biraa kanneen kitaaba kana keessatti hin barreeffamin hedduu hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
            "verseOrgIds": [
              "JHN.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni kunneen garuu akka Yesuus inni Kiristoos",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.31",
            "verseOrgIds": [
              "JHN.20.31"
            ]
          }
        },
        {
          "text": "Ilma Waaqaa taʼe akka amantaniif, amanuudhaanis akka maqaa isaatiin jireenya qabaattaniif barreeffame.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.31",
            "verseOrgIds": [
              "JHN.20.31"
            ]
          }
        }
      ]
    }
  ],
