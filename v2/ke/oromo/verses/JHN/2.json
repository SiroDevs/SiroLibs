  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JHN 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Bishaan Gara Daadhii Wayiniitti Geeddaruu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa sadaffaatti Qaanaa Galiilaa keessa cidha gaaʼelaatu",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.1",
            "verseOrgIds": [
              "JHN.2.1"
            ]
          }
        },
        {
          "text": "ture. Haati Yesuusiis achi turte;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.1",
            "verseOrgIds": [
              "JHN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusii fi barattoonni isaa gara cidha sanaatti waamamanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.2",
            "verseOrgIds": [
              "JHN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Daadhiin wayinii dhumetti haati Yesuus, \"Jarri daadhii wayinii hin qaban\" isaan jette.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.3",
            "verseOrgIds": [
              "JHN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo deebisee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.4",
            "verseOrgIds": [
              "JHN.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dubartii nana! Maal godhi naan jetta? Yeroon koo amma illee hin geenye\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.2.4",
                "verseOrgIds": [
                  "JHN.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.4",
            "verseOrgIds": [
              "JHN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haati isaas tajaajiltootaan, \"Waanuma inni isinitti himu hunda godhaa\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.5",
            "verseOrgIds": [
              "JHN.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaniiwwan dhagaa jaʼa sirna qulqulleessuu Yihuudootaatiif achi dhaabamanii turan; tokkoon tokkoon isaaniis gara liitiroo 75 hamma 115 qabata ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.6",
            "verseOrgIds": [
              "JHN.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus tajaajiltootaan,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.7",
            "verseOrgIds": [
              "JHN.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gaaniiwwanitti bishaan guutaa\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.2.7",
                "verseOrgIds": [
                  "JHN.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe; isaanis hamma afaan gaaniiwwaniitti guutan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.7",
            "verseOrgIds": [
              "JHN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.8",
            "verseOrgIds": [
              "JHN.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Egaa budduuqsaatii abbaa cidhaatti kennaa\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.2.8",
                "verseOrgIds": [
                  "JHN.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.8",
            "verseOrgIds": [
              "JHN.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 2:8"
      },
      "items": [
        {
          "text": "Isaanis akkasuma godhan;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.8",
            "verseOrgIds": [
              "JHN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "abbaan cidhaas bishaan gara daadhii wayiniitti geeddarame sana afaaniin qabee ilaale. Daadhiin wayinii sun eessaa akka dhufe tajaajiltoota bishaan waraabanitu beeka malee abbaan cidhaa sun hin beeku ture. Innis misirricha waamee",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.9",
            "verseOrgIds": [
              "JHN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkana jedheen; \"Namni hundi daadhii wayinii isa gaarii jalqabatti dhiʼeessee, erga keessumoonni machaaʼanii booddee immoo daadhii isa laafaa dhiʼeessa; ati garuu daadhii gaarii hamma ammaatti tursite.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.10",
            "verseOrgIds": [
              "JHN.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus mallattoowwan isaa keessaa isa jalqabaa kana Qaanaa Galiilaa keessatti hojjete. Ulfina isaas ni mulʼise; barattoonni isaas isatti amanan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.11",
            "verseOrgIds": [
              "JHN.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Mana Qulqullummaa Qulqulleessuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
