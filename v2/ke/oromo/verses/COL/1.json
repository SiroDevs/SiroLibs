  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "COL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos isa fedhii Waaqaatiin ergamaa Kiristoos Yesuus taʼee fi obboleessa keenya Xiimotewos irraa,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara qulqulloota, obboloota Kiristoosiin amanamoo taʼan kanneen Qolosaayis jiraataniitti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po",
        "vid": "COL 1:2"
      },
      "items": [
        {
          "text": "Abbaa keenya Waaqa biraa ayyaannii fi nagaan isiniif haa taʼu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Galataa fi Kadhannaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu yommuu isiniif kadhannutti Waaqa, Abbaa Gooftaa keenya Yesuus Kiristoos yeroo hunda ni galateeffanna;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "amantii isin Kiristoos Yesuusitti qabdanii fi jaalala isin qulqulloota hundaaf qabdan sana dhageenyeerraatii;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis sababii abdii samii keessatti isinii kuufame sanaatiif; isin waaʼee abdii kanaa duraanuu dubbii dhugaa, wangeela keessatti dhageessaniirtu;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wangeelli kunis isin bira gaʼeera. Wangeelli kunis gaafa isin isa dhageessanii dhugumaan ayyaana Waaqaa hubattanii jalqabee akkuma isin gidduutti hojjechaa ture sana addunyaa guutuu keessattis ija naqachaa fi guddachaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanas tajaajilaa jaallatamaa hidhata keenya taʼe Ephaafiraa irraa barattaniirtu; innis Kiristoosiif tajaajilaa amanamaa taʼee iddoo keenya kan buʼee dha;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni waaʼee jaalala keessan kan Hafuurri isinii kenne sanaas nutti himeera.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii kanaaf nu gaafa waaʼee keessan dhageenyee jalqabnee isinii kadhachuu fi akka Waaqni karaa ogummaatii fi hubannaa hafuuraa hundaan beekumsa fedhii isaatiin isin guutu kadhachuu hin dhiifne.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.9",
            "verseOrgIds": [
              "COL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akka isin hojii gaarii hundaan ija naqachaa, Waaqa beekuudhaanis guddachaa, jireenya Gooftaaf maluu fi kan karaa hundaan isa gammachiisu jiraattaniif;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
              "COL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "isinis jajjabinaa fi obsa guddaa akka qabaattaniif, akkuma aangoo isaa ulfina qabeessa sanaatti humna hundaan jabaachaa, gammadaas",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa Abbaa kan akka isin mootummaa ifaa keessatti qulqulloota wajjin dhaala keessatti hirmaattan isin dandeessise sana galateeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.12",
            "verseOrgIds": [
              "COL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni taayitaa dukkanaa jalaa nu baasee gara mootummaa Ilma inni jaallatuutti nu dabarseeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.13",
            "verseOrgIds": [
              "COL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nus isumaan furama, jechuunis dhiifama cubbuu arganneerra.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ol aantummaa Ilma Waaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni fakkaattii Waaqa hin mulʼanne sanaa ti; uumama hundaafis hangafa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni hundinuu isumaan uumameetii: Wanni samii keessaa fi lafa irraa, wanni mulʼatuu fi hin mulʼanne, teessoowwan yookaan humnoonni yookaan bulchitoonni yookaan taayitaawwan, wanni hundinuu isumaan, isumaaf uumaman.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.16",
            "verseOrgIds": [
              "COL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan hunda dura jira; wanni hundinuu isumaan wal qabatee dhaabata.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.17",
            "verseOrgIds": [
              "COL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni mataa dhagna isaa, mataa waldaa kiristaanaa ti; waan hunda irratti ol aantummaa akka qabaatuufis inni kan jalqabaa ti; warra duʼan keessaa kaafamuudhaanis hangafa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni guutummaan isaa hundi isa keessa jiraachuu isaatti gammadeeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.19",
            "verseOrgIds": [
              "COL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "dhiiga isaa kan fannoo irratti dhangalaʼe sanaanis nagaa buusuudhaan waan lafa irra jiru yookaan waan samii keessa jiru hunda karaa isaatiin ofitti araarseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis dur amala keessan hamaa sanaan Waaqatti orma taatanii yaada keessaniinis diinota turtan.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.21",
            "verseOrgIds": [
              "COL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu qulqulloota mudaa hin qabnee fi warra hirʼina hin qabne godhee fuula isaa duratti isin dhiʼeessuuf dhagna foon Kiristoosiin, karaa duʼa isaatiin isin araarseera;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.22",
            "verseOrgIds": [
              "COL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis yoo isin amantii keessaniin itti fuftan, yoo jabaattanii dhaabattanii fi yoo isin abdii wangeelaa irraa hin sochoone taʼa. Wangeelli kunis isuma isin dhageessanii fi isuma samii gaditti uumama hundatti lallabamee dha; ani Phaawulosis wangeeluma kanaaf tajaajilaa taʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Waldaa Kiristaanaatiif Dhamaʼuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani amma isiniif dhiphachuu kootti nan gammada; waan dhiphina Kiristoos dhagna isaatiif jechuunis waldaa kiristaanaatiif jedhee dhiphate sana keessaa hirʼates ani foon kootiin nan guuta.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.24",
            "verseOrgIds": [
              "COL.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergama Waaqni natti kenneen ani akka dubbii Waaqaa guutummaatti isinii dhiʼeessuuf tajaajilaa waldaa kiristaanaa taʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "COL 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "dubbiin kunis icciitii barootaa fi dhaloota jalaa dhokfamee turee dha; amma garuu qulqulloota isaatti mulʼifameera.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.26",
            "verseOrgIds": [
              "COL.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "COL 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni badhaadhummaan ulfina icciitii kanaa hammam guddaa akka taʼe Namoota Ormaa gidduutti qulqulloota isaatti beeksisuu filateera; icciitiin kunis Kiristoos, abdii ulfinaa isa isin keessa jiruu dha.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.27",
            "verseOrgIds": [
              "COL.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "COL 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus isuma lallabna; nama hunda kan guutumaan guutuutti Kiristoositti bilchaataa taʼe akka dhiʼeessinuuf, tokkoo tokkoo namaa ogummaa hundaan gorsaa barsiisna.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.28",
            "verseOrgIds": [
              "COL.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "COL 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani akkuma hojii humna isaa kan ciminaan na keessatti hojjetu sanaatti carraaqaa nan dhimma.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.29",
            "verseOrgIds": [
              "COL.1.29"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "COL.2",
    "number": "2",
