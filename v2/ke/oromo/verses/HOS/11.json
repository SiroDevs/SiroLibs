  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "HOS 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jaalala Waaqni Israaʼeliif Qabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Israaʼel yeroo daaʼima turetti, ani isa nan jaalladhe;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:1"
      },
      "items": [
        {
          "text": "ani Gibxii ilma koo waameera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu hammuma ani itti deddeebiʼee isaan waamu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "isaan narraa fagaachaa deeman.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "Isaan Baʼaaliif aarsaa dhiʼeessanii",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "fakkiiwwaniif ixaana aarsan.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kan irree isaanii qabee Efreemin",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "miillaan deemuu barsiise anuma;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "isaan garuu akka ani",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "isaan fayyise hin hubanne.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani funyoo gara laafina namaatiin,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "hidhaa jaalalaatiinis isaan nan harkise;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "ani morma isaanii irraa waanjoo fuudhee",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "isaan sooruuf gadan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isaan qalbii jijjiirrachuu waan didaniif",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:5"
      },
      "items": [
        {
          "text": "Gibxitti hin deebiʼan;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:5"
      },
      "items": [
        {
          "text": "Asoor garuu isaan bulcha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goraadeen magaalaawwan isaanii keessatti balaqqisa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:6"
      },
      "items": [
        {
          "text": "raajota sobduu isaanii ni barbadeessa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:6"
      },
      "items": [
        {
          "text": "karoora isaaniis ni fashaleessa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni koo narraa deebiʼuuf kutateera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:7"
      },
      "items": [
        {
          "text": "Yoo isaan Waaqa Waan Hundaa Olii waammatan iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:7"
      },
      "items": [
        {
          "text": "inni gonkumaa ol isaan hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Efreem ani akkamiinan dandaʼee si dhiisa?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Yaa Israaʼel ani akkamiinan dabarsee si kenna?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Ani akkamiinan dandaʼee akka Adimaa si godha?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Akkamiinan akka Zebooʼiim si godha?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Garaan koo na keessatti geeddarameera;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "gara laafinni ani siif qabu guddateera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani dheekkamsa koo sodaachisaa sana gad hin dhiisu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "yookaan ani deebiʼee Efreemin hin balleessu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "Ani Waaqa malee nama miti;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "ani Isa Qulqulluu gidduu kee jiruu dha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "Ani dheekkamsaan hin dhufu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "HOS.11.10",
                "verseOrgIds": [
                  "HOS.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "duukaa buʼu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "inni akkuma leencaa aada;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "yommuu inni aadutti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "ilmaan isaa hollachaa lixa biiftuutii dhufu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akkuma simbirroo Gibxi irraa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:11"
      },
      "items": [
        {
          "text": "akkuma gugee ollachaa",
