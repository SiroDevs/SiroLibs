  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼel muka wayinii dagaage ture;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "inni matuma isaatiif ija naqata.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "Akkuma iji isaa baayʼateen",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "inni iddoo aarsaa hedduu ijaarrate;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "akkuma lafti isaa gabbatteen",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "utubaawwan waaqeffannaa isaa miidhagfate.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garaan isaanii gowwoomsaadhaan guutameera;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "isaan amma yakka isaanii baadhachuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.10.2",
                "verseOrgIds": [
                  "HOS.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "iddoo aarsaa isaanii ni diiga;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "utubaawwan waaqeffannaa isaaniis ni barbadeessa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii isaan akkana jedhu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "\"Nu sababii",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "HOS.10.3",
                "verseOrgIds": [
                  "HOS.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuu didneef mootii hin qabnu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "Garuu utuu mootii qabaanne iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "inni silaa maal nuuf godha?\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan waan hedduu waadaa galu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "kakuu sobaas seenanii",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "walii galtee uummatu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "kanaafuu seera dhabeeyyiin",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "akkuma aramaa summii qabu kan lafa qotiisaa keessaatti latu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Samaariyaa keessa jiraatan",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "sababii waaqa tolfamaa fakkii jabbii",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "kan Beet Aawwen keessaa sanaatiif sodaatu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "Sabni ishee isheedhaaf booʼa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "Luboonni ishee ejjitoonni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "warri ulfina isheetiin gammadan sunis",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "sababii isheen isaan irraa boojiʼamteef ni booʼu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabbichis akka harka fuudhaatti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Yaariim mootichaaf Asooritti geeffama.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Efreem ni salphifama;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Israaʼel waaqota ishee kanneen muka irraa tolfamaniif ni qaanofti.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samaariyaa fi mootiin ishee",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:7"
      },
      "items": [
        {
          "text": "akkuma hoomacha bishaan irraatti fudhatamanii badu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoowwan sagadaa kanneen Awween ni barbadeeffamu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "kunis cubbuu Israaʼel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Qoraattii fi sokorruun irratti biqilee",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "iddoo aarsaa isaanii haguuga.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Yeroo sana namoonni tulluuwwaniin, \"Nurratti jigaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "gaarraniin immoo, \"Nu dhoksaa!\" jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Israaʼel isin bara Gibeʼaatii jalqabdanii",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "cubbuu hojjettaniirtu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "ammas achumatti haftaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
