    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "\"Biyyattii keessa amanamummaan,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "jaalallii fi Waaqa beekuun hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaaruu, sobuu fi ajjeesuu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "hannaa fi ejja qofatu jira;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "isaan kakuu hunda ni cabsu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "dhiiga dhangalaasuutu baayʼata.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii kanaaf biyyattiin ni gadditi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "warri ishee keessa jiraatan hundis ni badu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "bineensonni bosonaa, simbirroonni samiitii fi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "qurxummiin galaanaa dhumaa jiru.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Garuu namni tokko iyyuu dubbii hin kaasin;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "namni tokko iyyuu nama kaan hin himatin;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "sabni keessan",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "akkuma nama luba himatu tokkoo ti.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati halkanii fi guyyaa gufatta;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "raajonnis isin wajjin gufatu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "Kanaafuu ani haadha kee nan balleessa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "sabni koo beekumsa dhabuudhaan badeera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "HOS 4:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "\"Waan ati beekumsa tuffatteef",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "anis akka ati luba naaf hin taaneef si tuffadheera;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "sababii ati seera Waaqa keetii gatteef",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "anis ilmaan kee nan gata.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonni akkuma baayʼachaa deemaniin,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "akkasuma cubbuu natti hojjechuu baayʼisan;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "isaan ulfina isaanii salphinatti geeddaraniiru.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan cubbuu saba kootii nyaatu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:8"
      },
      "items": [
        {
          "text": "hammina isaaniis ni hawwu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kunis akkuma sabaa, akkuma lubootaa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "Anis sababii karaa isaaniitiif",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "lachan isaanii iyyuu nan adaba;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "hojii isaaniis isaanumatti nan deebisa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
