        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moʼaab Fincile",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooraam ilmi Ahaab bara Yehooshaafaax mooticha Yihuudaa keessa waggaa kudha saddeettaffaatti Samaariyaa keessatti mootii Israaʼel taʼee waggaa kudha lama bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.1",
            "verseOrgIds": [
              "2KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooraam fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.2",
            "verseOrgIds": [
              "2KI.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.2",
                "verseOrgIds": [
                  "2KI.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete; garuu akka abbaa fi haati isaa hojjetan sana miti. Inni siidaa Baʼaal kan abbaan isaa hojjechiise sana balleesseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.2",
            "verseOrgIds": [
              "2KI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus cubbuu Yerobiʼaam ilma Nebaat kan inni saba Israaʼel hojjechiise sana cimsee qabate malee irraa hin deebine.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Meeshaan mootichi Moʼaab hoolota horsiisa ture; inni waggaa waggaatti xobbaallaa hoolaa kuma dhibba tokkoo fi rifeensa korbeeyyii hoolaa kuma dhibba tokko mootii Israaʼeliif gibira kenna ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.4",
            "verseOrgIds": [
              "2KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga Ahaab duʼee garuu mootichi Moʼaab mootii Israaʼelitti ni fincile.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.5",
            "verseOrgIds": [
              "2KI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu yeroo sanatti Yehooraam mootichi Samaariyaadhaa kaʼee saba Israaʼel hunda duulaaf hiriirse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.6",
            "verseOrgIds": [
              "2KI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Mootiin Moʼaab natti fincileera; Moʼaabin loluudhaaf ati na wajjin ni baataa?\" jedhee Yehooshaafaax mooticha Yihuudaatti ergaa ergate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.7",
            "verseOrgIds": [
              "2KI.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 3:7"
      },
      "items": [
        {
          "text": "Yehooshaafaaxis, \"Ani si wajjin nan baʼa; ani akkuma kee ti; sabni koos akkuma saba keetii ti; fardeen koos akkuma fardeen keetii ti\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.7",
            "verseOrgIds": [
              "2KI.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Karaa kamiin yaana?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 3:8"
      },
      "items": [
        {
          "text": "Yehooraam immoo, \"Karaa Gammoojjii Edoomiitiin\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootiin Israaʼel mootii Yihuudaatii fi mootii Edoom wajjin kaʼee qajeele. Erga guyyaa torba irra nanaannaʼanii booddee loltoonni sun ofii isaaniitiif yookaan horii isaaniitiif bishaan tokko illee hin qaban ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootiin Israaʼel, \"Wayyoo kaa!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.10",
                "verseOrgIds": [
                  "2KI.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "nu mootota sadanuu dabarsee mootii Moʼaabitti kennuudhaaf walitti nu waamee?\" jedhee iyye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshaafaax garuu, \"Raajiin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.11",
                "verseOrgIds": [
                  "2KI.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kan nu karaa isaatiin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.11",
                "verseOrgIds": [
                  "2KI.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "waa gaafannu tokko iyyuu as hin jiruu?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 3:11"
      },
      "items": [
        {
          "text": "Qondaalli mootii Israaʼel tokkos, \"Elsaaʼi ilmi Shaafaax as jira. Inni Eeliyaasiif bishaan harkaa buusa ture\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshaafaaxis, \"Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.12",
                "verseOrgIds": [
                  "2KI.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": "isa bira jira\" jedhe. Kanaafuu mootiin Israaʼel, Yehooshaafaaxii fi mootiin Edoom gara Elsaaʼitti gad buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi mootii Israaʼeliin, \"Nu maal wal irraa qabna? Ati gara raajota abbaa keetiitii fi gara raajota haadha keetii dhaqi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.13",
            "verseOrgIds": [
              "2KI.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 3:13"
      },
      "items": [
        {
          "text": "Mootiin Israaʼel, \"Akkas miti;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.13",
            "verseOrgIds": [
              "2KI.3.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.13",
                "verseOrgIds": [
                  "2KI.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nu mootota sadanuu dabarsee Moʼaabitti kennuudhaaf walitti nu waameeraatii\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.13",
            "verseOrgIds": [
              "2KI.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi immoo akkana jedhee deebise; \"Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.14",
                "verseOrgIds": [
                  "2KI.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu kan ani isa tajaajilu sanaa; ani utuu Yehooshaafaax mooticha Yihuudaatiif ulfina kennuu baadhee silaa garagalee si hin ilaalu yookaan wayittuu si hin hedun ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu nama baganaa taphatu tokko naa fidaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.15",
            "verseOrgIds": [
              "2KI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 3:15"
      },
      "items": [
        {
          "text": "Utuma namichi sun baganaa taphachaa jiruu harki",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.15",
            "verseOrgIds": [
              "2KI.3.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.15",
                "verseOrgIds": [
                  "2KI.3.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Elsaaʼi irra buʼe;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.15",
            "verseOrgIds": [
              "2KI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis akkana jedhe; \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.16",
            "verseOrgIds": [
              "2KI.3.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.16",
                "verseOrgIds": [
                  "2KI.3.16"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Sulula kana keessatti boolla hedduu qotaa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.16",
            "verseOrgIds": [
              "2KI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.17",
                "verseOrgIds": [
                  "2KI.3.17"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhaatii: Isin bubbee yookaan bokkaa hin argitan; taʼus sululli kun bishaaniin guutama; isin, loon keessanii fi horiin keessan kaan ni dhugdu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.17",
            "verseOrgIds": [
              "2KI.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kun fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.18",
            "verseOrgIds": [
              "2KI.3.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.3.18",
                "verseOrgIds": [
                  "2KI.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan salphaa dha; inni Moʼaabinis dabarsee harka keessanitti ni kenna.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.18",
            "verseOrgIds": [
              "2KI.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin magaalaa dallaan itti ijaarame hundaa fi magaalaawwan hunda ni moʼattu. Muka gaarii hunda ni murtu; burqaa hunda gogsitanii lafa qotiisaa gaarii hunda dhagaan balleessitu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.19",
            "verseOrgIds": [
              "2KI.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa itti aanu ganama gara saʼaatii aarsaan itti dhiʼeeffamuutti kunoo karaa Edoomiin bishaan gad ni dhangalaʼe! Biyyi sunis bishaaniin guutamte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Moʼaabonni hundi akka mootonni sun isaan loluu dhufan dhagaʼan; kanaafuu dargaggeessas taʼu jaarsi miʼa lolaa baachuu dandaʼu hundi walitti waamamee daangaa irratti walitti qabame.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.21",
            "verseOrgIds": [
              "2KI.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isaan ganama barii kaʼanitti biiftuun bishaan sana irratti baʼaa turte. Bishaan sunis Moʼaabota gama jiranitti akkuma dhiigaa diimatee mulʼate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.22",
            "verseOrgIds": [
              "2KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Wanni sun dhiiga! Mootonni sun wal lolanii wal fixuun isaanii hin oolu. Kanaafuu yaa Moʼaab boojuudhaaf kaʼi!\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo Moʼaabonni qubata Israaʼel gaʼanitti, Israaʼeloonni itti kaʼanii lolan; jarri sunis ni baqatan. Israaʼeloonnis biyya sana weeraranii Moʼaabota gogorraʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
              "2KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkasiin magaalaawwan balleessan; tokkoon tokkoon namaas lafa qotiisaa gaggaarii hunda irratti dhagaa darbatee lafti qotiisaa sun dhagaadhaan guutame. Isaan burqaawwan hunda gogsanii muka gaggaarii hunda ciran. Qiir Hareesheti qofatu dhagaa ishee wajjin hafe; taʼus namoonni furrisaa qaban marsanii ishee dhaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.25",
            "verseOrgIds": [
              "2KI.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Moʼaab yommuu akka lolli isatti jabaate argetti mooticha Edoomitti cabsee seenuuf namoota goraadee hidhatan dhibba torba fudhatee qajeele; jarri garuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.26",
            "verseOrgIds": [
              "2KI.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis ilma isaa hangafa kan iddoo isaa buʼee mootii taʼuuf jiru fudhatee dallaa magaalaa sanaa irratti aarsaa gubamu godhee dhiʼeesse. Dheekkamsi guddaanis Israaʼelitti dhufe. Isaanis dugda duubatti deebiʼanii biyya isaaniitti ni galan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.27",
            "verseOrgIds": [
              "2KI.3.27"
            ]
          }
        }
      ]
    }
  ],
