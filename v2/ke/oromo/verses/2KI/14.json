            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.26",
                "verseOrgIds": [
                  "2KI.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "akka tokkoon tokkoon nama Israaʼel keessa jiraatuu, garbas taʼu birmaduun akka malee rakkachaa jiru arge; namni isaan gargaaru tokko iyyuu hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.27",
                "verseOrgIds": [
                  "2KI.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "waan maqaa Israaʼel samii jalaa nan balleessa hin jedhiniif harka Yerobiʼaam ilma Yooʼaashiitiin isaan baase.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
