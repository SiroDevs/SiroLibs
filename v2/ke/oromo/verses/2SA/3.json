  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "2SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saaʼolii fi mana Daawit gidduu waraana bara dheeraatu ture. Yeroo Daawit jabaachaa deemetti manni Saaʼol immoo dadhabaa deeme.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit Kebroonitti ijoollee dhalche; isaanis:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2SA 3:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:2"
      },
      "items": [
        {
          "text": "Inni hangafni Amnoon isa Ahiinooʼam Yizriʼeelittiin deessee dha;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.2",
            "verseOrgIds": [
              "2SA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni lammaffaan Kiliʼaab ilma Abiigayiil isheen Naabaal namichi biyya Qarmeloos irraa duʼe sun deessee dha;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:3"
      },
      "items": [
        {
          "text": "sadaffaan Abesaaloom ilma Maʼakaa kan intalli Talmaayi mooticha Geshuur sun deessee dha;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "afuraffaan Adooniyaa ilma Hagiit;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:4"
      },
      "items": [
        {
          "text": "shanaffaan Shefaaxiyaa ilma Abiixaal;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "jaʼaffaan Yitreʼaam ilma Eglaa niitiin Daawit deessee dha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2SA 3:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf",
        "vid": "2SA 3:5"
      },
      "items": [
        {
          "text": "Isaan kunneen Kebroonitti Daawitiif dhalatan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abneer Garee Daawit Taʼe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo mana Saaʼolii fi mana Daawit gidduu waraanni turetti Abneer mana Saaʼol irratti humna isaa jabeeffachaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis intala Ayyaa kan Riixiphaa jedhamtu saajjatoo godhatee ture. Iish-Booshetis Abneeriin, \"Ati maaliif saajjatoo abbaa kootii wajjin rafte?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneer immoo waan Iish-Booshet akkas jedheef akka malee aaree akkana jedhe; \"Ani mataa saree Yihuudaatii? Ani hamma harʼaatti mana abbaa kee Saaʼoliif, mana maatii isaatii fi mana firoota isaatiif amanamaa dha. Siʼi illee dabarsee Daawititti hin kennine. Ati garuu amma waaʼee dubartii kanaatiif na himatta!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ani akka abdiin Waaqni Daawitiif kenne sun raawwatamu gochuu baadhe",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.9",
                "verseOrgIds": [
                  "2SA.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Abneer irratti waan hamaa haa godhu; sana caalaa iyyuu isatti haa fidu;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wanni Waaqni kakuudhaan isa abdachiise sunis mana Saaʼol irraa mootummaa fuudhee Daanii jalqabee hamma Bersheebaatti Israaʼelii fi Yihuudaa irratti teessoo Daawit jabeessee dhaabuu dha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iish-Booshet waan isa sodaateef Abneeritti waan tokko illee dubbachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Abneer, \"Biyyattiin kan eenyuu ti? Na wajjin walii galtee godhadhu; anis akka Israaʼel guutumaan guutuutti gara kee goru sin gargaaraa\" jedhee Daawititti ergamoota erge.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.12",
            "verseOrgIds": [
              "2SA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis, \"Gaarii dha; ani si wajjin walii galtee nan godhadha. Garuu waan tokko sin gaafadha; kunis ati yommuu gara koo dhuftutti jalqabatti Miikaal intala Saaʼol naa fidi; yoo kanaa achii gara koo hin dhufin\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.13",
            "verseOrgIds": [
              "2SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Daawit, \"Niitii koo ishee ani misaa Filisxeemota dhibba tokkootiin kaadhimadhe Miikaalin naa ergi\" jedhee Iish-Booshet ilma Saaʼolitti ergamoota erge.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.14",
            "verseOrgIds": [
              "2SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Iish-Booshet nama ergee dhirsa ishee Phaltiiʼeel ilma Laayish irraa ishee fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.15",
            "verseOrgIds": [
              "2SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhirsi ishees hamma magaalaa Bahuuriimitti booʼaa ishee duukaa buʼe. Abneeris, \"Mana keetti deebiʼi!\" jedheen. Kanaafuu inni ni deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneer maanguddoota Israaʼel wajjin mariʼatee akkana jedhe; \"Isin kanaan dura akka Daawit mootii keessan taʼu hawwaa turtan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.17",
            "verseOrgIds": [
              "2SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.18",
                "verseOrgIds": [
                  "2SA.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'Ani garbicha koo Daawitiin saba Israaʼel harka Filisxeemotaatii akkasumas harka diinota isaanii hundaa keessaa nan baasa' jedhee abdachiiseeraatii isin waan kana galmaan gaʼaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneer namoota Beniyaam birattis ni dubbate. Ergasiis Kebroon dhaqee waan Israaʼeloonnii fi manni Beniyaam hundi gochuu barbaadan Daawititti hime.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.19",
            "verseOrgIds": [
              "2SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Abneer namoota isaa digdama wajjin Kebroon dhufetti, Daawit isaa fi namoota isaatiif cidha qopheesse.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.20",
            "verseOrgIds": [
              "2SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneeris Daawitiin, \"Ani kaʼee deemee akka isaan gooftaa koo mootii wajjin kakuu galanii fi akka ati warra garaan kee fedhe hunda irratti mootii taatuuf Israaʼeloota hunda walitti nan qaba\" jedhe. Kanaaf Daawit isa geggeesse; innis nagaadhaan deeme.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yooʼaab Abneerin Ajjeese",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Daawitii fi Yooʼaab yommuu suma boojuu hedduu fudhatanii duulaa galan. Abneer garuu Daawit wajjin Kebroon hin turre; Daawit isa geggeessee inni nagaan deemeeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.22",
            "verseOrgIds": [
              "2SA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaabii fi loltoonni isa wajjin turan hundi yommuu achi gaʼanitti akka Abneer ilmi Neer mooticha bira dhufee mootichi nagaan isa geggeesse isatti himame.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.23",
            "verseOrgIds": [
              "2SA.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Yooʼaab gara mootichaa dhaqee akkana jedhe; \"Maali gochuu kee ti? Kunoo Abneer gara kee dhufee ture. Ati Maaliif isa geggeessite? Inni amma deemeera!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.24",
            "verseOrgIds": [
              "2SA.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati Abneer ilma Neer ni beekta; inni si gowwoomsee sochii keetii fi waan ati gochaa jirtu hunda basaasuudhaaf dhufe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaabis Daawit biraa baʼee Abneer duubaan ergamoota erge; isaanis boolla bishaanii kan Siiraa biraa isa deebisan. Daawit garuu waan kana hin beekne.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.26",
            "verseOrgIds": [
              "2SA.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Abneer Kebroonitti deebiʼettis Yooʼaab waan kophaatti isa wajjin haasaʼuu barbaade fakkeessee gara karraatti isa baase. Achittis haaloo dhiiga obboleessa isaa Asaaheel baasuuf garaa keessa isa waraane; innis ni duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.27",
            "verseOrgIds": [
              "2SA.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Daawit yommuu waan kana dhagaʼetti akkana jedhe; \"Anii fi mootummaan koo bara baraan dhiiga Abneer ilma Neer irraa fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.28",
                "verseOrgIds": [
                  "2SA.3.28"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti qulqulluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cubbuun dhiiga isaa mataa Yooʼaabii fi mana abbaa isaa hundaa irra haa gaʼu! Namni madaa malaa yaasu yookaan lamxii qabu yookaan namni uleetti rarraʼee deemu yookaan namni goraadeen ajjeefamu yookaan namni waan nyaatu dhabu mana Yooʼaabii hin dhabamin.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.29",
            "verseOrgIds": [
              "2SA.3.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii inni lola Gibeʼoon irratti obboleessa isaanii Asaaheelin ajjeeseef Yooʼaabii fi obboleessi isaa Abiishaayi Abneerin ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis Yooʼaabii fi namoota isa wajjin turan hundaan, \"Uffata keessan tarsaasaatii uffata gaddaa uffadhaa; fuula Abneer durattis booʼaa\" jedhe. Daawit mootichis reeffa Abneer geggeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Abneerin Kebroonitti awwaalan; mootichis awwaala Abneer irratti iyyee booʼe; namoonni hundinuus ni booʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis faaruu gaddaa kana akkana jedhee Abneeriif faarse:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 3:33"
      },
      "items": [
        {
          "text": "\"Abneer akka duʼa nama yaraa tokkootti duʼuu qabaa?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harki kee hin hidhamne;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "miilli kee foncaadhaan hin gaadiʼamne.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "Ati akkuma nama fuula hamootaa duratti kufu tokkootti kufte.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "Namoonni hundinuu amma illee ni booʼaniif.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara saafaattis namoonni hundi dhufanii akka inni waa nyaatuuf Daawitin kadhatan; inni garuu, \"Yoo ani hamma biiftuun lixxutti buddeena yookaan waan biraa afaan kootiin qabe Waaqni waan hamaa natti haa fidu; kana caalaa iyyuu natti haa fidu!\" jedhee kakate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.35",
            "verseOrgIds": [
              "2SA.3.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni hundinuu waan kana arganii gammadan; dhugumaan wanni mootichi godhe hundi isaan gammachiise.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.36",
            "verseOrgIds": [
              "2SA.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu gaafa sana namoonni hundii fi Israaʼel hundi akka ajjeefamuu Abneer ilma Neer keessatti mootichi qooda hin qabne beekan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.37",
            "verseOrgIds": [
              "2SA.3.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis namoota isaatiin akkana jedhe; \"Isin akka guyyaa harʼaa ilmi mootiitii fi namni guddaan tokko Israaʼel keessaa kufe hin beeknee?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.38",
            "verseOrgIds": [
              "2SA.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani mootii dibame taʼu illee harʼa nama dadhabaa dha; ilmaan Zeruuyaa kunneen natti jabaataniiru.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.39",
                "verseOrgIds": [
                  "2SA.3.39"
                ]
              }
            }
          ]
        },
        {
          "text": "nama waan hamaa hojjetuuf akkuma hammina hojii isaatti isaaf haa kennu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        }
      ]
    }
  ],
