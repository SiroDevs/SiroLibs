          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo hunda dhuma waggaa sadaffaatti waan waggaa sana keessa galfatte kudhan keessaa tokko fuudhiitii magaalaawwan keessatti kuusi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akka Lewwonni qooda yookaan dhaala ofii isaanii hin qabne, alagoonni, ijoolleen abbaa hin qabnee fi niitonni dhirsoonni isaanii irraa duʼan warri magaalaawwan keessa jiraatan nyaatanii quufanii fi akka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.14.29",
                "verseOrgIds": [
                  "DEU.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee hojii harka keetii hundaan si eebbisuuf.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
          }
        }
      ]
