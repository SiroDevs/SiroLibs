        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waaqota Biraa waaqeffachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo raajiin yookaan namni abjuudhaan waan dhufaa jiru himu tokko gidduu keessanitti argamee mallattoowwan yookaan dinqii isinitti hime,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.1",
            "verseOrgIds": [
              "DEU.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo mallattoon yookaan dinqii inni isinitti hime sun raawwatamee innis, \"Kottu waaqota biraa kanneen ati duraan hin beekne duukaa buunee haa waaqeffannu\" siin jedhe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.2",
            "verseOrgIds": [
              "DEU.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati dubbii raajii yookaan nama abjootu sanaa hin dhaggeeffatin;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.3",
                "verseOrgIds": [
                  "DEU.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee akka isin garaa keessan guutuu fi yaada keessan guutuudhaan isa jaallattan qoruuf waan kana godhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.4",
                "verseOrgIds": [
                  "DEU.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan duukaa buʼaa; isa sodaadhaa. Ajajawwan isaa eegaa; isaaf ajajamaa; isa tajaajilaa; isattis maxxanaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.4",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajaan yookaan namichi abjuu abjootu sun, sababii akka isin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.5",
                "verseOrgIds": [
                  "DEU.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan kan biyya Gibxiitii isin baasee biyya garbummaa jalaa isin fure sanatti finciltan dubbateef ajjeefamuu qaba; inni karaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.5",
                "verseOrgIds": [
                  "DEU.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan akka duukaa buutan isin ajaje irraa isin jalʼisuuf yaaleera; hamaa of keessaa balleessi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo obboleessi kee yookaan ilmi kee yookaan intalli kee yookaan niitiin kee kan ati jaallattu yookaan michuun kee, \"Kottu waaqota biraa kanneen atis taatu abbootiin kee hin beekin waaqeffannaa\" jedhee dhoksaadhaan si dogoggorsuu barbaade,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.6",
            "verseOrgIds": [
              "DEU.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo inni waaqota saboota naannoo keetii, kanneen dhiʼoo yookaan fagoo jiran, warra daarii lafaa tokkoo hamma daarii lafaa kaaniitti jiranii waaqeffanna, siin jedhe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.7",
            "verseOrgIds": [
              "DEU.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "tole hin jedhiniif yookaan isa hin dhagaʼin. Hin naʼiniif. Isaaf hin hilin yookaan harka irra hin qabin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.8",
            "verseOrgIds": [
              "DEU.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati isa ajjeesuu qabda. Isa ajjeesuufis jalqabatti harki kee, itti aansees harki saba hundaa haa kaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.9",
            "verseOrgIds": [
              "DEU.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan inni akka ati",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.10",
                "verseOrgIds": [
                  "DEU.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee kan Gibxi, biyya garbummaatii si baase sana irraa garagaltu godheef dhagaadhaan tumii isa ajjeesi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Israaʼeloonni hundi dhagaʼanii ni sodaatu; si gidduudhaas eenyu iyyuu deebiʼee waan hamaa akkasii hin hojjetu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
            "verseOrgIds": [
              "DEU.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati magaalaawwan akka ati keessa jiraattuuf",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.12",
                "verseOrgIds": [
                  "DEU.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee siif kennu keessaa tokkotti iyyuu utuu akkas jedhamuu dhageesse,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo namoonni hamoon isin gidduudhaa kaʼanii, \"Kottaa waaqota biraa kanneen isin hin beekne waaqeffannaa\" jedhanii saba magaalaa isaanii dogoggorsu taʼe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.13",
            "verseOrgIds": [
              "DEU.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "dubbii sana iyyaafadhu; qoradhu; sirriitti gaafadhu. Kunoo, yoo dubbiin sun dhugaa taʼee wanni jibbisiisaan kun gidduu keetti hojjetamuun isaa mirkanaaʼe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.14",
            "verseOrgIds": [
              "DEU.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati namoota magaalaa sana keessa jiraatan hunda goraadeedhaan fixi; magaalaa sana illee namoota isheetii fi horii ishee wajjin guutumaan guutuutti barbadeessi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.15",
            "verseOrgIds": [
              "DEU.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miʼa boojuu kan magaalaa sanaa argame hunda walakkaa oobdii isheetti walitti qabiitii magaalaa sana guutuu boojuu ishee wajjin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.16",
                "verseOrgIds": [
                  "DEU.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetiif aarsaa guutummaan gubamu godhiitii gubi. Isheen bara baraan barbadooftee haa haftu; deebitees hin ijaaramin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.17",
                "verseOrgIds": [
                  "DEU.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dheekkamsa isaa sodaachisaa irraa deebiʼuuf wanni abaarame tokko harka keetti hin argamin; inni siif araarama; garaa siif laafa; akkuma abbootii keetiif kakatetti si baayʼisa;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis waan ati ajajawwan isaa kanneen ani harʼa siif kennu hunda eegdee fuula isaa duratti waan qajeelaa hojjechuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.18",
                "verseOrgIds": [
                  "DEU.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetiif ajajamtuuf.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.19"
            ]
          }
        }
      ]
    }
  ],
