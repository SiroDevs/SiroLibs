    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati yeroo hunda dhuma waggaa torbaffaatti gatii namaaf dhiisuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akkanatti taʼa: namni liqii kennu hundii liqii ollaa isaa nama Israaʼeliif liqeesse dhiisuufii qaba. Sababii yeroon",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.2",
                "verseOrgIds": [
                  "DEU.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kan itti gatiin namaaf dhiifamu labsameef inni ollaa isaa yookaan obboleessa isaa Israaʼelicha irraa waan isaaf liqeesse hin gaafatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati waan alagaaf liqeessite gaafachuu ni dandeessa; garuu waan obboleessi kee sirraa liqeeffate dhiisuufii qabda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus waan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.4",
                "verseOrgIds": [
                  "DEU.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee biyya akka ati dhaaltuuf siif kennu irratti akka malee si eebbisuuf hiyyeessi gidduu keetti hin argamu;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis yoo ati guutumaan guutuutti",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.5",
                "verseOrgIds": [
                  "DEU.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetiif ajajamtee fi yoo ati ajajawwan ani harʼa siif kennu kanneen hunda eegde qofa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.6",
                "verseOrgIds": [
                  "DEU.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee akkuma si abdachiisetti si eebbisuuf ati saboota baayʼeedhaaf liqeessita malee tokko irraa iyyuu hin liqeeffattu. Ati saboota baayʼee bulchita malee isaan si hin bulchan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.7",
                "verseOrgIds": [
                  "DEU.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee siif kennu keessatti yoo obboloota kee gidduu hiyyeessi jiraate obboleessa kee sana irratti garaan kee hin jabaatin yookaan isa gargaaruu irraa harka kee hin deebifatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda kanaa harka kee isaaf diriirsiitii waan isa gaʼu liqeessiif.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.8",
            "verseOrgIds": [
              "DEU.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka yaadni hamaan, \"Waggaan torbaffaan, waggaan itti gatiin namaaf dhiifamu sun dhiʼaateera\" jedhu si keessatti kuufamee ati akkasiin obboleessa kee rakkataa ija hamaadhaan ilaaltee gargaaruu hin dhiifne of eeggadhu. Inni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.9",
            "verseOrgIds": [
              "DEU.15.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.9",
                "verseOrgIds": [
                  "DEU.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ol iyyata; kunis cubbuu sitti taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.9",
            "verseOrgIds": [
              "DEU.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati arjummaadhaan isaaf kenni; yommuu kennituufis garaan kee hin gaabbin; sababii kanaaf",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.10",
                "verseOrgIds": [
                  "DEU.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee hojii kee hundaa fi waan harki kee qabate hundaan si eebbisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoom iyyuu taanaan hiyyeeyyiin lafa irra ni jiraatu. Kanaafuu ani akka ati harka kee obboloota keetiif, hiyyeeyyii fi rakkattoota biyya keetiitiif diriirfattu sin ajaja.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
            "verseOrgIds": [
              "DEU.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Garboota Bilisoomsuu",
          "type": "text"
        }
      ]
    },
