      },
      "items": [
        {
          "text": "Waggaa Itti Gatiin Namaaf Dhiifamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
