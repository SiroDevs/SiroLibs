      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sabootatti Murame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bara sana keessa, yeroo sanatti,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:1"
      },
      "items": [
        {
          "text": "ani yommuun boojuu Yihuudaatii fi",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "Yerusaalem deebisutti,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "saboota hunda walitti qabeen",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "gara Sulula Yehooshaafaaxitti",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "gad isaan nan buusa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "Anis achitti sababii dhaala koo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "sababii Israaʼeliif isaanitti nan mura;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "isaan saboota gidduutti saba koo",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "bittinneessanii biyya koos gargar qooddataniiruutii.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan uummata kootti ixaa buufatanii",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "ijoollee dhiiraas sagaagalummaatti geeddarataniiru;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "akka dhuganiif dubara illee daadhii wayiniitti gurguratan.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Xiiroosii fi Siidoonaa, isin kutaaleen Filisxeem hundinuu, amma maal narraa qabdu? Isin waan ani godheef haaloo na baafachaa jirtuu? Yoo isin haaloo na baafachaa jirtu taʼe ani dafee ariitiidhaan waan isin hojjettan sana matuma keessanittin deebisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin meetii fi warqee koo guurrattanii qabeenya koo filatamaas mana waaqeffannaa keessanitti geeffattaniirtuutii.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin biyya isaanii irraa isaan fageessitanii uummata Yihuudaatii fi Yerusaalem Giriikotatti gurgurattan.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.6",
            "verseOrgIds": [
              "JOL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunoo, ani biyya isin itti isaan gurgurattan keessaa isaan baasee waan isin hojjettan sana matuma keessanitti nan deebisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.7",
            "verseOrgIds": [
              "JOL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ilmaanii fi intallan keessan saba Yihuudaatti nan gurgura; isaan immoo saba fagoo jiru kan Saabaa jedhamutti dabarsanii isaan gurguratu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOL.3.8",
                "verseOrgIds": [
                  "JOL.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "dubbateeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kana saboota gidduutti labsaa:",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "Waraanaaf qophaaʼaa!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "Gootota kakaasaa!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "Loltoonni hundi dhiʼaatanii haa lolan.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maarashaa keessan tumaatii goraadee godhadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:10"
      },
      "items": [
        {
          "text": "haamtuu keessanis tumaatii eeboo godhadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:10"
      },
      "items": [
        {
          "text": "Namni laafaan,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:10"
      },
      "items": [
        {
          "text": "\"Ani jabaa dha!\" haa jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin saboonni qixa hundaan dafaa kottaattii",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:11"
      },
      "items": [
        {
          "text": "achitti walitti qabamaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOL 3:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:11"
      },
      "items": [
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOL.3.11",
                "verseOrgIds": [
                  "JOL.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", loltoota kee gad ergi!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saboonni haa kaʼan;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "isaan dafanii gara Sulula Yehooshaafaax haa dhufan;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "ani saboota gama hundaan jiranitti muruuf",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "achi nan taaʼaatii.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Midhaan gaʼeeraatii",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "haamtuu itti kaaʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "Kottaatii ija wayinii dhidhiitaa;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "boolli itti wayinii cuunfan guuteeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
