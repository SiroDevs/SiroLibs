          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa maanguddoota, waan kana dhagaʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "warri biyyattii keessa jiraattan hundinuu dhaggeeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "Wanni akkanaa takkumaa bara keessan keessa",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "yookaan bara abbootii keessanii keessa taʼee beekaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin waan kana ijoollee keessanitti himaa;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "ijoolleen keessanis ijoollee ofii isaaniitti haa himan;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "ijoolleen isaanii immoo dhaloota itti aanutti haa dabarsan.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
