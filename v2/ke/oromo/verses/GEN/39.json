      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoosefii fi Niitii Phoxiifaaraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Yoosef Gibxitti geeffamee ture. Phoxiifaaraan namichi Gibxi qondaalli Faraʼoon kan ajajaa waardiyyaa ture sun Ishmaaʼeeloota achi isa geessan irraa isa bitate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.1",
            "verseOrgIds": [
              "GEN.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosefis waan",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.2",
                "verseOrgIds": [
                  "GEN.39.2"
                ]
              }
            }
          ]
        },
        {
          "text": "isa wajjin tureef nama milkaaʼaa taʼe; innis mana gooftaa isaa namicha biyya Gibxi sanaa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaan isaas akka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.3",
                "verseOrgIds": [
                  "GEN.39.3"
                ]
              }
            }
          ]
        },
        {
          "text": "isa wajjin jiruu fi akka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.3",
                "verseOrgIds": [
                  "GEN.39.3"
                ]
              }
            }
          ]
        },
        {
          "text": "waan inni hojjetu hunda keessatti isa milkoomse arge;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosefis fuula gooftaa isaa duratti fudhatama argatee hojjetaa isaa amanamaa taʼe. Phoxiifaaraanis mana isaa irratti isa muude; waan qabu hundumas akka inni eeguuf imaanaa itti kenne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.4",
            "verseOrgIds": [
              "GEN.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa inni mana isaatii fi waan inni qabu hunda irratti isa muudee jalqabee",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.5",
                "verseOrgIds": [
                  "GEN.39.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sababii Yoosefiif jedhee mana namicha Gibxi sanaa eebbise. Eebbi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.5",
                "verseOrgIds": [
                  "GEN.39.5"
                ]
              }
            }
          ]
        },
        {
          "text": "waan Phoxiifaaraan manaa fi alaa qabu hunda irra ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Phoxiifaaraan waan qabu hunda harka Yoosef jala galche; innis waan nyaatu qofa malee qabeenya isaa tokko illee hin beeku ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 39:6"
      },
      "items": [
        {
          "text": "Yoosef dhaaba toleessaa fi miidhagaa ture;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "niitiin gooftaa isaas waan kana booddee ija ishee Yoosef irra buufattee, \"Kottuu na bira gaʼi!\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.7",
            "verseOrgIds": [
              "GEN.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu didee akkana isheen jedhe; \"Kunoo, gooftaan koo waan mana keessa jiru tokko illee hin beeku; inni waan qabu hunda natti kenneera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.8",
            "verseOrgIds": [
              "GEN.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kana keessatti namni na caalu tokko iyyuu hin jiru. Sababii ati niitii isaa taateef siʼi malee wanni gooftaan koo natti hin kennin tokko iyyuu hin jiru. Yoos ani akkamittan waan hamaa akkasii raawwachuudhaan Waaqatti cubbuu hojjedha ree?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.9",
            "verseOrgIds": [
              "GEN.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen guyyuma guyyaan Yoosefitti dubbattu iyyuu, inni ishee bira gaʼuu yookaan ishee biratti argamuu illee ni dide.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.10",
            "verseOrgIds": [
              "GEN.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko Yoosef hojii isaa hojjechuuf mana seene; tajaajiltoota warra mana sanaa keessaas namni tokko iyyuu achi hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.11",
            "verseOrgIds": [
              "GEN.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis wayyaa isaa qabattee, \"Kottuutii na bira gaʼi!\" jetteen. Inni garuu wayyaa isaa isheetti gad lakkisee fiigee manaa baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.12",
            "verseOrgIds": [
              "GEN.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis yommuu akka inni wayyaa isaa isheetti gad lakkisee fiigee manaa baʼe argitetti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.13",
            "verseOrgIds": [
              "GEN.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "hojjettoota mana ishee waamtee akkana jetteen; \"Kunoo, inni Ibricha kana akka nutti taphatuuf fide! Inni na bira gaʼuuf natti ol seennaan ani sagalee guddaan iyye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.14",
            "verseOrgIds": [
              "GEN.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis gargaarsa barbaachaaf iyyuu koo dhageenyaan wayyaa isaa na biratti dhiisee fiigee manaa baʼe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.15",
            "verseOrgIds": [
              "GEN.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen hamma gooftaan isaa galutti wayyaa isaa of bira keesse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.16",
            "verseOrgIds": [
              "GEN.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkana jettees oduu kana isatti himte: \"Garbichi Ibrichi ati nuu fidde sun natti taphachuuf natti ol seene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.17",
            "verseOrgIds": [
              "GEN.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akkuma ani gargaarsa barbaachaaf iyyeen inni wayyaa isaa na biratti dhiisee fiigee manaa baʼe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
              "GEN.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaan isaa yommuu oduu niitiin isaa, \"Wanni garbichi kee na godhe kana\" jettee itti himte sana dhagaʼetti aaree gubate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.19",
            "verseOrgIds": [
              "GEN.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaan isaas Yoosefin fuudhee mana hidhaa iddoo hidhamtoonni mootichaa itti eegaman keessa buuse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.20",
            "verseOrgIds": [
              "GEN.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 39:20"
      },
      "items": [
        {
          "text": "Taʼus yeroo Yoosef mana hidhaa keessa turetti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.20",
            "verseOrgIds": [
              "GEN.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.21",
                "verseOrgIds": [
                  "GEN.39.21"
                ]
              }
            }
          ]
        },
        {
          "text": "isa wajjin ture; fuula ajajaa mana hidhaa sanaa durattis gaarummaa isaa itti argisiise; akka fudhatamas argatu godhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.21",
            "verseOrgIds": [
              "GEN.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajaan mana hidhaa sunis namoota mana hidhaa jiran hunda irratti Yoosefin muude; waan achitti hojjetamu hunda irrattis itti gaafatamaa isa godhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.22",
            "verseOrgIds": [
              "GEN.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.23",
            "verseOrgIds": [
              "GEN.39.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.23",
                "verseOrgIds": [
                  "GEN.39.23"
                ]
              }
            }
          ]
        },
        {
          "text": "isa wajjin turee fi waan inni hojjetu kam iyyuu isaa milkeesseef ajajaan mana hidhaa sun waan itti gaafatama Yoosef jala jiru hundaaf yaaddoo tokko illee hin qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.23",
            "verseOrgIds": [
              "GEN.39.23"
            ]
          }
        }
      ]
    }
  ],
