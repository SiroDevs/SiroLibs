              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaan akka isheen hojjettuu ishee taatuuf xomboree isaa Bilihaa, intala isaa Raaheliif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.29",
