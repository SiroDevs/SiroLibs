              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis Raahel bira gaʼe; innis Liyaa caalaatti Raahelin jaallate. Waggoota biraa torbas Laabaaf hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
