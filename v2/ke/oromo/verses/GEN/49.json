    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yaaqoob Ilmaan Isaa Eebbise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "GEN.49.1-GEN.49.28"
          },
          "items": [
            {
              "text": "49:1‑28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwi –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "DEU.33.1-DEU.33.29"
              },
              "items": [
                {
                  "text": "KeD 33:1‑29",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoob ilmaan isaa ofitti waamee akkana jedhe: \"Akka ani waan bara dhumaa keessa isinitti dhufu isinitti himuuf mee walitti qabamaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa ilmaan Yaaqoob mee walitti qabamaa dhaggeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:2"
      },
      "items": [
        {
          "text": "abbaa keessan Israaʼelin dhaggeeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Ruubeen, ati ilma koo hangafa;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:3"
      },
      "items": [
        {
          "text": "humna koo, mallattoo jalqabaa kan jabina kootii ti;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:3"
      },
      "items": [
        {
          "text": "ati ulfinaan ni caalta; humnaan illee ni caalta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka bishaanii asii fi achi raafamta; ol aantummaas hin qabaattu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:4"
      },
      "items": [
        {
          "text": "ati siree abbaa keetiitti ol baatee,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:4"
      },
      "items": [
        {
          "text": "afata kootti ol baatee xureessiteertaatii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Simiʼoonii fi Lewwiin obboloota;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:5"
      },
      "items": [
        {
          "text": "goraadeen isaanii miʼa fincilaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubbuun koo marii isaaniitti hin seenin;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "ulfinni koos yaaʼii isaaniitti hin dabalamin;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "isaan dheekkamsa isaaniitiin nama ajjeesaniiruutii;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "fedhii ofii isaaniitiinis qotiyyoo naafachiisaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aariin isaanii inni hamaan,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "dheekkamsi isaanii inni gara jabeessi abaaramaa haa taʼu!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "Ani Yaaqoob keessa isaan nan bittinneessa;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "Israaʼel keessas isaan nan facaasa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Yihuudaa obboloonni kee si leellisu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:8"
      },
      "items": [
        {
          "text": "harki kee morma diina keetii qaba;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:8"
      },
      "items": [
        {
          "text": "ilmaan abbaa keetii siif sagadu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Yihuudaa ati saafela leencaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "yaa ilma koo ati adamoodhaa deebita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "Inni akka leencaa, akka leenca dhalaas, riphee ciisa;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "eenyutu ija jabaatee isa kaasa ree?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamma bulchaan dhufutti",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "bokkuun harka Yihuudaatii,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "uleen bulchiinsaa miilla isaa gidduudhaa hin dhabamu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "saboonnis isaaf ni ajajamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni harree isaa muka wayiniitti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "ilmoo harree isaa immoo damee filatamaatti hidhata;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "wayyaa isaa daadhii wayiniitiin,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "wandaboo isaa immoo dhiiga gumaa wayiniitiin miiccata.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji isaa daadhii wayinii irra diimata;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:12"
      },
      "items": [
        {
          "text": "ilkaan isaa immoo aannan irra addaata.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zebuuloon qarqara galaanaa jiraata;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
