              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisihaaq waggaa dhibba tokkoo fi saddeettama jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
          }
