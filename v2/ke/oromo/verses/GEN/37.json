  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "GEN 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abjuu Yoosef",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoob biyya abbaan isaa ture, Kanaʼaan keessa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.1",
            "verseOrgIds": [
              "GEN.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seenaan maatii Yaaqoob kana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 37:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:2"
      },
      "items": [
        {
          "text": "Yoosef yeroo dargaggeessa waggaa kudha torba turetti obboloota isaa, ilmaan niitota abbaa isaa jechuunis ilmaan Bilihaatii fi Zilfaa wajjin bushaayee tiksa ture; innis waaʼee obboloota isaa oduu hamaa abbaa isaatiif fide.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼel waan bara dullumaa keessa isa dhalcheef ilmaan isaa hunda caalaa Yoosefin jaallata ture; innis qoloo faayeffame hojjeteef.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.3",
            "verseOrgIds": [
              "GEN.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni isaas yommuu akka abbaan isaanii isaan hunda caalaa isa jaallate hubatanitti Yoosefin jibban; afaan nagaas itti dubbachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.4",
            "verseOrgIds": [
              "GEN.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosef abjuu abjootee obboloota isaatti hime; isaanis ittuma caalchisanii isa jibban.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.5",
            "verseOrgIds": [
              "GEN.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana isaaniin jedhe; \"Mee abjuu ani arge kana dhagaʼaa:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.6",
            "verseOrgIds": [
              "GEN.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu lafa qotiisaa keessatti bissii midhaanii hidhaa ture; kunoo, bissiin koo ol jedhee dhaabate; bissiiwwan keessan immoo bissii kootti naannaʼanii gad jedhanii sagadaniif.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.7",
            "verseOrgIds": [
              "GEN.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni isaas, \"Ati nu irratti mootii taʼuu barbaaddaa? Dhugumaan situ nu bulchaa?\" jedhaniin. Isaanis sababii abjuu isaatii fi sababii waan inni dubbateetiif ittuma caalchisanii isa jibban.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.8",
            "verseOrgIds": [
              "GEN.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis abjuu biraa abjootee obboloota isaatti hime. Akkanas jedheen; \"Kunoo, ani abjuu biraa abjoodheera; aduu fi jiʼi, urjiiwwan kudha tokkos gad jedhanii naa sagadu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.9",
            "verseOrgIds": [
              "GEN.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu inni waan kana abbaa isaatii fi obboloota isaatti himetti abbaan isaa, \"Abjuun ati abjootte kun maali? Ani, haati keetii fi obboloonni kee dhugumaan dhufnee fuula kee duratti gad jennee siif sagadnaa?\" jedhee isatti dheekkame.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.10",
            "verseOrgIds": [
              "GEN.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni isaa isatti hinaafan; abbaan isaa garuu waan kana garaatti qabate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.11",
            "verseOrgIds": [
              "GEN.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoosef Obboloota Isaatiin Gurgurame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko obboloonni isaa bushaayee abbaa isaanii Sheekem bira dheechisuu dhaqan;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.12",
            "verseOrgIds": [
              "GEN.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼelis Yoosefiin, \"Akkuma ati beektu obboloonni kee Sheekem bira bushaayee dheechisaa jiru. Mee kottu ani gara isaaniitti si ergaa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:13"
      },
      "items": [
        {
          "text": "Yoosefis, \"Kunoo asan jira\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼel immoo, \"Mee dhaqiitii akka obboloonni kee, bushaayeenis nagaa taʼanii fi akka hin taʼin ilaaliitii deebiʼii natti himi\" jedheen. Innis akkasiin Sulula Kebrooniitii Sheekemitti isa erge.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:14"
      },
      "items": [
        {
          "text": "Yoosefis Sheekem gaʼe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "namichi tokko isa arge; kunoo inni dirree irra jooraa ture; namichi sunis, \"Ati maal barbaadda?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.15",
            "verseOrgIds": [
              "GEN.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosefis deebisee, \"Ani obboloota koon barbaada. Ati iddoo isaan bushaayee isaanii dheechisan mee natti himi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.16",
            "verseOrgIds": [
              "GEN.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichis deebisee, \"Isaan asii deemaniiru; ani 'Gara Dootaan haa dhaqnu' jechuu isaanii dhagaʼeera\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:17"
      },
      "items": [
        {
          "text": "Yoosefis obboloota isaa duukaa buʼee Dotaayin biratti isaan argate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu fagootti isa arganii isa ajjeesuuf utuu inni isaan bira hin gaʼin mariʼatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.18",
            "verseOrgIds": [
              "GEN.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkana waliin jedhan; \"Kunoo abbaan abjuu sun dhufaa jira!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.19",
            "verseOrgIds": [
              "GEN.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottaa ajjeefnee boollawwan as jiran keessaa tokkotti isa gannee bineensa hamaatu isa nyaate jenna. Ergasii immoo abjuun isaa maal akka taʼu ilaalla.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.20",
            "verseOrgIds": [
              "GEN.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruubeen waan kana dhageenyaan isaan harkaa isa baase. Innis akkana jedhe; \"Lakkii isa hin ajjeefnu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.21",
            "verseOrgIds": [
              "GEN.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "dhiiga hin dhangalaasinaa. Gammoojjii keessatti boolla kana keessa isa buusaa malee harka keessaniin isa hin tuqinaa.\" Ruubeen isaan harkaa isa baasee gara abbaa isaatti isa deebisuuf akkana jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.22",
            "verseOrgIds": [
              "GEN.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Yoosef obboloota isaa bira gaʼetti isaan qoloo inni uffate, qoloo miidhagaa sana isa irraa baasanii,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.23",
            "verseOrgIds": [
              "GEN.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "isa fuudhanii boollatti gad darbatan. Boolli sunis duwwaa ture; bishaanis hin qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.24",
            "verseOrgIds": [
              "GEN.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni isaa buddeena nyaachuuf tataaʼan; ol jedhaniis kunoo, daldaltoota warra Ishmaaʼeel kanneen Giliʼaadii dhufaa jiran argan. Isaanis urgooftuu, haphee dibataatii fi qumbii gaalawwan isaaniitti feʼatanii Gibxitti geessaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.25",
            "verseOrgIds": [
              "GEN.37.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudaanis obboloota isaatiin akkana jedhe; \"Obboleessa keenya ajjeefnee dhiiga isaa dhoksuun buʼaa maalii nuu qaba?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.26",
            "verseOrgIds": [
              "GEN.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottaa Ishmaaʼeelootatti isa gurgurra malee harka keenyaan isa hin tuqnuu; inni obboleessa keenyaa fi foon keenya.\" Obboloonni isaas yaada kana fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.27",
            "verseOrgIds": [
              "GEN.37.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu daldaltoonni Midiyaan achiin darbuuf dhufanittis obboloonni Yoosef boolla keessaa harkisanii ol isa baasanii meetii saqilii digdamaatti Ishmaaʼeelootatti isa gurguratan; jarris Gibxitti isa geessan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.28",
            "verseOrgIds": [
              "GEN.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruubeen gara boolla sanaatti deebiʼe; Yoosef boolla sana keessa hin turre; innis uffata ofii isaa tarsaase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.29",
            "verseOrgIds": [
              "GEN.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis gara obboloota isaa dhaqee, \"Gurbichi achi hin jiru! Egaa ani eessan dhaqa?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.30",
            "verseOrgIds": [
              "GEN.37.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis qoloo Yoosef fuudhanii reʼee tokko qalanii qoloo sana dhiiga keessa cuuphan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.31",
            "verseOrgIds": [
              "GEN.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoloo miidhagaa sanas abbaa isaaniitti geessanii, \"Nu qoloo kana arganneerra; mee qoloo ilma keetii taʼuu fi taʼuu baachuu isaa ilaali\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.32",
            "verseOrgIds": [
              "GEN.37.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis qoloo sana beekee, \"Kun qoloo ilma kootii ti! Bineensa hamaatu isa nyaate. Dhugumaan Yoosef ciccirameera\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Yaaqoob uffata ofii isaa tarsaase; wayyaa gaddaa mudhiitti hidhatee guyyaa baayʼee ilma isaatiif gadde.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.34",
            "verseOrgIds": [
              "GEN.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan isaatii fi intallan isaa hundinuu isa jajjabeessuuf kaʼan; inni garuu jajjabaachuu didee, \"Lakkii ani gaddaa gara ilma koo siiʼoolitti gad buʼa\" jedhe. Akkasiin abbaan isaa ni booʼeef.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidduu sana warri Midiyaan sun Gibxi keessatti Phoxiifaaraa namicha qondaaltota Faraʼoon keessaa tokko ture kan ajajaa waardiyyaa taʼe tokkotti Yoosefin gurguratan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        }
      ]
    }
  ],
