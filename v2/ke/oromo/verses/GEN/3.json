  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "GEN 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufaatii Namaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.1",
                "verseOrgIds": [
                  "GEN.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni uume hunda keessaa bofti haxxee ture. Dubartittiidhaanis, \"Dhuguma Waaqni, 'Muka iddoo biqiltuu keessa jiru kam irraa iyyuu hin nyaatinaa' isiniin jedheeraa?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartittiinis deebiftee bofa sanaan akkana jette; \"Ija mukkeen iddoo biqiltuu keessa jiranii nyaachuu ni dandeenya;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.2",
            "verseOrgIds": [
              "GEN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "garuu Waaqni, 'Muka walakkaa iddoo biqiltuu sanaa keessa jiru irraa ija hin nyaatinaa; ittis hin buʼinaa; yoo kanaa achii ni duutuu' jedheera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.3",
            "verseOrgIds": [
              "GEN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bofichis deebisee dubartittiidhaan akkana jedhe; \"Isin dhugumaan hin duutan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.4",
            "verseOrgIds": [
              "GEN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni akka yommuu isin ija mukichaa nyaattan iji keessan banamu, akka isin waan gaarii fi waan hamaa beekuudhaan akka Waaqaa taatan ni beekaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartittiinis yommuu akka iji mukichaa nyaataaf gaarii, kan ija namaatti tolu, ogummaa argachuufis akka nama gojomaasisu argitetti fudhattee nyaatte. Dhirsi ishees ishee wajjin ture; isaafis ni laatte; innis ni nyaate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji lachan isaaniis ni baname; qullaa hafuu isaaniis beekan; kanaafis baala harbuu hodhanii marxoo tolfatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma aduun qabbanoofteenis namichii fi niitiin isaa utuu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.8",
                "verseOrgIds": [
                  "GEN.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni iddoo biqiltuu sana keessa deemuu sagalee isaa dhagaʼan; isaanis mukkeen iddoo biqiltuu keessa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.8",
                "verseOrgIds": [
                  "GEN.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa duraa dhokatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.9",
                "verseOrgIds": [
                  "GEN.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni garuu namicha waamee, \"Ati eessa jirta?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichis deebisee, \"Ani utuu ati iddoo biqiltuu keessa deemtuu nan dhagaʼe; waan qullaa koo tureefis nan sodaadhe; nan dhokadhes\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.10",
            "verseOrgIds": [
              "GEN.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Eenyutu akka ati qullaa taate sitti hime? Muka ani ija isaa hin nyaatin jedhee si ajaje sana irraa nyaatte moo?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.11",
            "verseOrgIds": [
              "GEN.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichis, \"Dubartittii ati akka isheen na wajjin jiraattuuf naa kennite sanatu ija mukichaa irraa naa kenne; anis nan nyaadhe\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.12",
            "verseOrgIds": [
              "GEN.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.13",
                "verseOrgIds": [
                  "GEN.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqnis dubartittiidhaan, \"Wanni ati hojjette kun maali?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 3:13"
      },
      "items": [
        {
          "text": "Dubartittiin immoo, \"Bofti na gowwoomsinaanan nyaadhe\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.14",
                "verseOrgIds": [
                  "GEN.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni bofichaan akkana jedhe; \"Ati sababii waan kana gooteef,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "\"Horii hundumaa keessaa, bineensa hundumaa keessaas",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "kan abaaramte ni taata!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "Bara jireenya keetii guutuu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "garaa keetiin lafa irra loota;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "biyyoo illee ni nyaatta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siʼii fi dubartittii, sanyii keetii fi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "sanyii ishee gidduutti",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "diinummaa nan uuma;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "inni mataa kee ni tuma;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "atis koomee isaa ni iddita.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartittiidhaanis akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "\"Yommuu ati mucaa deessutti ani dhiphina kee akka malee nan baayʼisa;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "ciniinsuudhaanis ijoollee ni deessa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "Fedhiin kee garuma dhirsa keetii taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "innis sirratti ol aantummaa qabaata.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 3:17"
          },
          "items": [
