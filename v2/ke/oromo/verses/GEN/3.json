                  "GEN.3.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni lafa biqiltuu Eeden keessaa namicha baasee akka inni lafuma irraa argame sana misoomsu godhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
