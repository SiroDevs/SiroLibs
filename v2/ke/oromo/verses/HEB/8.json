        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luba Ol aanaa Kakuu Haaraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan nu dubbannu keessaa ijoon kana: Nu luba ol aanaa samii irra karaa mirga teessoo Isa Ulfina Qabeessa Samii keessaa sanaa taaʼe akkasii qabna.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis iddoo qulqullummaa fi dunkaana isa dhugaa kan utuu namaan hin taʼin Gooftaadhaan dhaabame keessa tajaajila.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni ol aanaan kam iyyuu kennaa fi aarsaa dhiʼeessuuf muudama; kanaafuu lubni kun waan dhiʼeessu tokko qabaachuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.3",
            "verseOrgIds": [
              "HEB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan luboonni akka seeraatti kennaa dhiʼeessan duraanuu jiraniif, inni utuu lafa irra jiraatee silaa luba hin taʼu ture.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.4",
            "verseOrgIds": [
              "HEB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis iddoo qulqullummaa kan fakkeenyaa fi gaaddidduu wantoota samii tajaajilu. Waaqnis yommuu Museen dunkaana qulqulluu dhaabuuf kaʼetti, \"Waan hunda akkuma fakkeenya tulluu irratti sitti argisiifame sanaatti hojjechuu kee mirkaneeffadhu!\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "text": "jedhee isa akeekkachiisuun isaa kanumaaf.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akkuma kakuun inni Yesuus gidduu galeessa taʼeef sun kakuu moofaa akka malee caalu sana tajaajilli inni fudhates tajaajila isaanii irra guddaa dha; kakuun haaraan waadaa caalu irratti hundeeffameetii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu kakuun jalqabaa sun mudaa qabaachuu baatee silaa kakuun lammaffaan hin barbaachisu ture.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni garuu saba sana irratti balleessaa argee akkana jedha;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:8"
      },
      "items": [
        {
          "text": "\"Yeroon ani itti mana Israaʼel wajjin,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:8"
      },
      "items": [
        {
          "text": "mana Yihuudaa wajjinis,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:8"
      },
      "items": [
        {
          "text": "kakuu haaraa galu ni dhufa",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:8"
      },
      "items": [
        {
          "text": "jedha Gooftaan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuun kunis kakuu ani,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "yeroo biyya Gibxiitii isaan baasuuf jedhee",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "harka isaanii qabe sana",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "abbootii isaanii wajjin gale sanaan tokko miti;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "isaan kakuu kootti jabaatanii waan hin dhaabatiniif,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "ani isaan irraa gara galeera,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "jedha Gooftaan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuun ani yeroo sana booddee",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "mana Israaʼel wajjin galu kanaa dha, jedha Gooftaan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "Ani seera koo qalbii isaanii keessa nan kaaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "garaa isaanii keessattis nan barreessa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "Ani Waaqa isaanii nan taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "isaanis saba koo ni taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii hundi isaanii,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:11"
      },
      "items": [
        {
          "text": "xinnaa hamma guddaatti na beekaniif,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:11"
      },
      "items": [
        {
          "text": "siʼachi namni kam iyyuu, 'Gooftaa beeki' jedhee,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:11"
      },
      "items": [
        {
          "text": "ollaa isaa yookaan obboleessa isaa hin barsiisu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani daba isaanii nan dhiisaaf;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:12"
      },
      "items": [
        {
          "text": "cubbuu isaaniis siʼachi hin yaadadhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis kakuu kanaan \"haaraa\" jedhee kakuu jalqabaa sana moofesseera; wanni moofaʼee fi wanni dulloome dafee bada.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
            "verseOrgIds": [
              "HEB.8.13"
            ]
          }
        }
      ]
    }
  ],
