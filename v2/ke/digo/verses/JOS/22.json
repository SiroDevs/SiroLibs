              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi mlavyadzi-sadaka na vilongozi a Aiziraeli yani vilongozi a miryango ya Aiziraeli ariphosikira gara arigogomba atu a Rubini, Gadi na Manase, aho ahererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Finehasi mwana wa mlavyadzi-sadaka Eliazari waambira atu a mbari ya Rubini na ya Gadi na ya Manase kukala, “Rero hukamanya kukala Mwenyezi Mlungu a phamwenga naswi mana tamkahenda chochosi chiricho chinyume na Mwenyezi Mlungu, vivi mkaativya Aiziraeli na uwezo wa Mwenyezi Mlungu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
