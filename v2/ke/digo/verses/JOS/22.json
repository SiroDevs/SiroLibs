              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho Finehasi mwana wa mlavyadzi-sadaka, Eliazari na vilongozi aaricha atu a mbari ya Rubini na ya Gadi hiko Giliadi achiuya tsi ya Kanani kpwa Aiziraeli achiuyiza ujumbe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Aiziraeli ahererwa kpwa kusikira nyo ujumbe nao achimtogola Mlungu, wala taayagomba kukala andapigana nao viha na kubananga tsi ya mbari ya Rubini na ya Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a mbari ya Rubini na ya Gadi phara phatu pha kulavira sadaka aphaiha “Edi,” mana aamba, “Phatu phapha pha kulavira sadaka ni ushaidi wehu kukala Mwenyezi Mlungu ni Mlungu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        }
