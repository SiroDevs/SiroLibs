          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achiulavya nyo mudzi na mfalumewe mikononi mwa Aiziraeli, naye achiuangamiza kpwa upanga phamwenga na chila mutu ariyekalamo, taphana hata mutu mmwenga yesazwa. Naye mfalumewe wahenderwa kama mfalume wa Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
