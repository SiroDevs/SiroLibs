          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Joshuwa phamwenga na Aiziraeli osi achiuya kambini Giligali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
            "verseOrgIds": [
