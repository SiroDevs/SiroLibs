              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Joshuwa phamwenga na Aiziraeli osi auka Egiloni achiphiya mudzi wa Heburoni achendaushambuliya, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
