              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula Makeda, Joshuwa phamwenga na Aiziraeli osi aphiya Libuna achendapigana nao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
