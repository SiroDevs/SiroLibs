          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao achiuteka siku iyo-iyo, achiushambuliya kpwa upanga, naye waolaga chila mutu yekala mo mudzini dza arivyohenda mudzi wa Lakishi.",
          "type": "text",
