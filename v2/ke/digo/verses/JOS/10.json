            }
          ]
        },
        {
          "text": "Kula Lakishi, Joshuwa phamwenga na Aiziraeli osi aphiya mudzi wa Egiloni achendauzangira na achiushambuliya ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
