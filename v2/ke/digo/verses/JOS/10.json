            }
          ]
        },
        {
          "text": "Chisha kula Libuna, Joshuwa phamwenga na Aiziraeli osi aphiya Lakishi achendauzangira na achiushambuliya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
