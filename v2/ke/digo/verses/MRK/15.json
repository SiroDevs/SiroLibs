                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.58"
              },
              "items": [
                {
                  "text": "Mariko 14:58",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.19"
              },
              "items": [
                {
                  "text": "Johana 2:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atu ariokala anatsupa phatu hipho amlaphiza na kusukasuka vitswa na kuamba, “Haya! We wadzikarya kukala unaweza kubomola Nyumba ya Kuvoya Mlungu na kuidzenga tsona bada ya siku tahu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.29",
            "verseOrgIds": [
              "MRK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambi amba tserera pho msalabani udzitivye!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.30",
            "verseOrgIds": [
              "MRK.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivyo hivyo akulu a alavyadzi-sadaka na alimu a Shariya amnyetera, achiambirana, “Waokola anjina, ela kaweza kudziokola mwenye! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.31",
            "verseOrgIds": [
              "MRK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangbwe iye ndiye Masihi,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:32",
              "type": "text"
            },
            {
              "text": "Masihi",
              "type": "text"
            },
            {
              "text": ": Yani",
              "type": "text"
            },
            {
              "text": "Muokoli,",
              "type": "text"
            },
            {
              "text": "mutu yetsambulwa ni Mlungu kuokola atu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ati Mfalume wa Iziraeli! Amba naatserere msalabani ili huone na kuamini.” Hata hara aivi ariokotwa phamwenga naye, piya nao amlaphiza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
