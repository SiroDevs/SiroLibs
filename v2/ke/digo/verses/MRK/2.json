        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.25"
              },
              "items": [
                {
                  "text": "Kumbukumbu 23:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mmwenga kala ni Siku ya Kuoya, Jesu na anafundzie atsapira minda ya nganu. Ariphokala anatsupa anafundzie aandza kukata na kuphulula masuche ga nganu achirya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
