          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Elihu mwana wa Barakeli, wa mryango wa Buzi achiamba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
