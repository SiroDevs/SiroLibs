              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.2"
              },
              "items": [
                {
                  "text": "Mwandzo 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi siku mwenga malaika",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:6",
              "type": "text"
            },
            {
              "text": "Tafusiri zanjina zinaamba",
              "type": "text"
            },
            {
              "text": "ana a Mlungu",
              "type": "text"
            },
            {
              "text": "au",
              "type": "text"
            },
            {
              "text": "viumbe vya Mlunguni.",
              "type": "text"
            }
          ]
        },
        {
          "text": " aphiya mbere za Mwenyezi Mlungu, mshitaki Shetani naye achiphiya phamwenga nao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Mwenyezi Mlungu achimuuza Shetani achimuamba, “Ulaphi?” Shetani achimjibu Mwenyezi Mlungu achiamba, “Che nazunguluka-zunguluka ko duniani na kunyendeka hiku na hiko.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Mwenyezi Mlungu achimuuza Shetani achimuamba, “Dze ukamuona mtumishi wangu Ayubu? Mana takuna dza iye duniani. Iye kana lawama, ni mutu wa haki, naye anamuogopha Mlungu na kudzitenga na uyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Maono 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chisha Shetani achimjibu Mwenyezi Mlungu achimuamba, “Ikale ye Ayubu anakuogopha bila sababu? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe ukamzungulusira lichigo pande zosi, iye, atue na vyosi arivyonavyo. Ukajaliya kazi za mikonoye na mifugoye ikaenjerezeka kpwenye yo tsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.10",
            "verseOrgIds": [
              "JOB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela golosa mkpwonoo na ugute vyosi arivyonavyo, naye andakukufuru chingʼangʼa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.11",
            "verseOrgIds": [
              "JOB.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achimuamba Shetani, “Lola, vyo vitu arivyonavyo unaweza kuvihenda rorosi, ela usimgute ye mwenye.” Phahi Shetani achiuka mbere za Mwenyezi Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi siku mwenga nyo anae alume na achetu kala anarya na kunwa uchi wa zabibu nyumbani mwa mvyere wao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
            "verseOrgIds": [
              "JOB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati hinyo muhumwa waphiya kpwa Ayubu achendamuamba, “Ngʼombe che zinarima na punda che anarisa phephi nazo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "gafula hukashambuliywa ni atu a Seba, akaolaga ahendadzi-kazio osi kpwa upanga na akahala nyo nyama osi akauka nao. Mimi machiyangu ndimi nchiyetiya, nami nkedzakurehera ujumbe huno.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati acheregomba, phakpwedza muhumwa wanjina achedzamuamba, “Kukahenda limeme kula mlunguni rikaocha mangʼondzi, mbuzi na arisa, mimi machiyangu ndimi nchiyetiya, nkedzakurehera ujumbe huno.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ariphokala acheregomba, phakpwedza wanjina achedzamuamba, “Akalidayo akadzipanga makundi mahahu, akahuvamia na akaolaga ahendadzi-kazi kpwa upanga na akahala nyo ngamia akauka nao. Mimi machiyangu ndimi nchiyetiya nami nkedzakurehera ujumbe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariphokala acheregomba, phakpwedza wanjina achedzamuamba, “Anao alume na achetu che anarya na kunwa uchi wa zabibu nyumbani mwa mvyere wao, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.18",
            "verseOrgIds": [
              "JOB.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "gafula, phuto kali kula jangbwani, rikapiga zo pembe ne za yo nyumba, ikaagbwerera, vivi anao akafwa. Mimi machiyangu ndimi nchiyetiya nami nkedzakurehera ujumbe huno.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
            "verseOrgIds": [
              "JOB.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
            "verseOrgIds": [
              "JOB.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Ayubu waunuka, achikpwanyula vwazire na achinyola chitswache chisha achidzibwaga photsi achimuabudu Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.20",
            "verseOrgIds": [
              "JOB.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiamba, “Nátuluka ndanini mwa mayo chitsaha, nami ndauya chitsaha. Mwenyezi Mlungu wanipha, na Mwenyezi Mlungu akahala, dzinare naritogolwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kahi ya mambo gosi higo Ayubu kahendere dambi, mana kayamlaumu Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.22",
            "verseOrgIds": [
              "JOB.1.22"
            ]
          }
        }
      ]
    }
  ],
