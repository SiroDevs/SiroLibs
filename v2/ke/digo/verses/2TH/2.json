                "loc": "1TH.4.15+1TH.4.16+1TH.4.17"
              },
              "items": [
                {
                  "text": "1 Athesalonike 4:15–17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enehu, sambi hunabisha kuhusu kuuya kpwa Bwana wehu Jesu Masihi, na vira swiswi ndivyokusanyika mbereze. Hunakuonyani ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "msikale atu a kutapatapa ovyo ovyo na maneno ga atu kama vira kuambwa siku iyo yakpwedza kare. Hata mutu akaamba waambirwa ni Roho Mtakatifu, ama wagasikira na swiswi, msimuamini. Tsona mutu achikuambirani wagasoma baruwani, ama achikuonyesani baruwa ambayo inaambwa yala kpwehu, piya msimuamini. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.2",
            "verseOrgIds": [
              "2TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msiphuphizwe ni mutu yeyesi, mana siku iyo taindafika hadi atu anji ndiphogbwirana kumpinga Mlungu, na yuya mui apingaye Mlungu amanyikane wazi. Hiye ndiye ambaye Mlungu wapanga kare kumʼbananga tsetsetse. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.3",
            "verseOrgIds": [
              "2TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "Danieli 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Ezekieli 28:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Andadzikudula na abere chochosi chiihwacho Mlungu au chiabudiwacho. Andasagala ndani ya Nyumba ya Kuvoya Mlungu na kuaambira atu kukala iye ndiye Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dze tamtambukira kukala nakuambirani higa huriphokala hosi? ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.5",
            "verseOrgIds": [
              "2TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mmanyavyo chimzuwiyacho yuya mui hipha sambi ni vira wakatiwe taudzangbwefika. Ela wakatiwe uchifika andamanyikana wazi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.6",
            "verseOrgIds": [
              "2TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tayari Shetani anahenda kazi chisiri-siri kuhenda atu apinge Mlungu. Nayo indaenderera kukala siri hadi hipho ndiphouka hiye aifwitsaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.7",
            "verseOrgIds": [
              "2TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.4"
              },
              "items": [
                {
                  "text": "Isaya 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alafu yuya mui andamanyikana wazi, naye Bwana Jesu andakpwedza amuolage chirahisi kabisa kpwa uwezowe mkpwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.8",
            "verseOrgIds": [
              "2TH.2.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:8",
              "type": "text"
            },
            {
              "text": "Chiyunani chinaamba,",
              "type": "text"
            },
            {
              "text": "kpwa kuvuvurira pumuzize.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mana andakpwedza na mwanga mkpwulu na utukufu wa ajabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.8",
            "verseOrgIds": [
              "2TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.24"
              },
              "items": [
                {
                  "text": "Mathayo 24:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuya mui andakpwedza na nguvu za Shetani na andahenda chila aina ya vilinje na maajabu ga handzo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.9",
            "verseOrgIds": [
              "2TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andakpwedza na chila aina ya handzo kuchenga hara agodzwao ni uamuli wa kutiywa adabu hata kare na kare. Hinyo anagodzwa ni uamuli kpwa sababu kpweli airema. Kalapho taayairema, phahi Mlungu angeativya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.10",
            "verseOrgIds": [
              "2TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyo mana Mlungu waaricha achengbwe sana ni yuya mui na alunge mambo ga handzo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.11",
            "verseOrgIds": [
              "2TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo osi arioamini handzo na kuhamirwa ni kuhenda mai andaphaha uamuli wa kutiywa adabu.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela swino ni lazima humshukuru Mlungu wakati wosi kpwa sababu yenu mwimwi enehu mmendzwao sana ni Bwana Jesu. Mana Mlungu wakutsambulani kula mwandzo muokolwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.13",
            "verseOrgIds": [
              "2TH.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:13",
              "type": "text"
            },
            {
              "text": "Mana yanjina ya Chiyunani ya maneno higa ni:",
              "type": "text"
            },
            {
              "text": "Mlungu wakutsambulani mkale seemu ya atu a kpwandza kuokolwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mnaokolwa ni Rohowe anayekutengani kpwa kazi ya Mlungu na kuamini ukpweli. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.13",
            "verseOrgIds": [
              "2TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu wahumira habari nono hurizotangaza kpwenu kama njira ya kukualikani mphahe nguma phamwenga na Bwana wehu Jesu Masihi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.14",
            "verseOrgIds": [
              "2TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo enehu dinani chilume na mlunge hurigokufundzani, ikale ni kugomba namwi ama kukuandikirani baruwa.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
