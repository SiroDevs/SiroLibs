          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba Mlungu wahumendza, na kpwa mbazize achiuhuriza mioyo hata kare na kare na kuuhenda hukale na uhakika wa kusagala naye hata kare na kare. Hunakuvoyerani kukala Bwana wehu Jesu Masihi mwenye ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.16",
            "verseOrgIds": [
              "2TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akutiyeni moyo na akupheni nguvu muweze kuhenda manono na kubishato.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.17",
            "verseOrgIds": [
              "2TH.2.17"
            ]
          }
        }
      ]
    }
  ],
