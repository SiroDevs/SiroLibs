              "JAS.2.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.1+GEN.22.2+GEN.22.3+GEN.22.4+GEN.22.5+GEN.22.6+GEN.22.7+GEN.22.8+GEN.22.9+GEN.22.10+GEN.22.11+GEN.22.12+GEN.22.13+GEN.22.14"
              },
              "items": [
                {
                  "text": "Mwandzo 22:1–14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umanye kala mkare wehu Burahimu wahala mwanawe Isaka ili akamulavye sadaka. Naye Mlungu achimuona ana haki kpwa sababu ya mahendoge. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.21",
            "verseOrgIds": [
              "JAS.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JAS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vino ukaona? Burahimu wakubali kuhenda vira Mlungu arivyoamba kpwa sababu wamkuluphira. Phahi kuluphirore rakamilishwa ni mahendoge. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.22",
            "verseOrgIds": [
              "JAS.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JAS 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.6"
              },
              "items": [
                {
                  "text": "Mwandzo 15:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.7"
              },
              "items": [
                {
                  "text": "2 Nyakati 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.8"
              },
              "items": [
                {
                  "text": "Isaya 41:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na gatimiya kama Maandiko gaambavyo, “Burahimu wamkuluphira Mlungu na kpwa sababu iyo, Mlungu achimkubali kukala ni mutu wa haki.” Ndipho Burahimu achiihwa msena wa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.23",
            "verseOrgIds": [
              "JAS.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JAS 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaona sambi, mutu anahendwa kukala na haki kpwa mahendoge, wala siyo kpwa kukuluphira macheye.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.24",
            "verseOrgIds": [
              "JAS.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JAS 2:24"
