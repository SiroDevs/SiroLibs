              "1SA.17.51"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.21.19"
              },
              "items": [
                {
                  "text": "2 Samueli 21:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Daudi wazola achendaima dzulu ya ye Mfilisti. Wahala upanga wa iye Mfilisti achiutuluza chowani, achimkata nao chitswa, achimuolaga. Afilisti ariphoona kukala sujaa wao akafwa, achimbira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.51",
            "verseOrgIds": [
              "1SA.17.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 17:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho atu a Iziraeli na Juda aunuka, achipiga zumo ra viha na achiazoresa hinyo Afilisti hadi mudzi wa Gathi na maryango ga mudzi wa Ekironi. Njira ya Shaaraimu yagota miri ya Afilisti hadi Gathi na Ekironi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.52",
            "verseOrgIds": [
              "1SA.17.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1SA 17:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiziraeli ariphouya kula kuazoresa Afilisti, akpwedzahala zewe kambi yao. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.53",
            "verseOrgIds": [
              "1SA.17.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1SA 17:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi wahala chira chitswa cha Goliathi na achichiphirika Jerusalemu, ela silahaze waziika ndani ya hemare.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        }
      ]
    },
