                "loc": "EXO.6.26"
              },
              "items": [
                {
                  "text": "Kutsama 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli achienderera kuaambira, “Mwenyezi Mlungu ni shaidi, iye ndiye ariyetsambula Musa na Aruni na iye ndiye ariyeatuluza akare enu kula tsi ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.6",
            "verseOrgIds": [
              "1SA.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambi imani mbere za Mwenyezi Mlungu, nikutambukizeni mahendo gosi ga haki ambago Mwenyezi Mlungu wakuhenderani mwimwi na akare enu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.7",
            "verseOrgIds": [
              "1SA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
