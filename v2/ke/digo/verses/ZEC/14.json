              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo Mwenyezi Mlungu macheye ndiye ndiyekala mfalume wa dunia yosi. Iye macheye ndiye ndiyekala Mlungu wa kpweli, ndiyeabudiwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsi yosi, kula Geba hadi Rimoni uphande wa mwakani wa Jerusalemu indahendwa ikale herera dza Araba. Ela Jerusalemu indasala pho dzulu iripho kula Ryango ra Benjamini hadi phokala Ryango ra Kare, hadi Ryango ra Pembeni na kula mnara wa Hananeli hadi phatu pha kuminyira zabibu pha mfalume. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.10",
            "verseOrgIds": [
              "ZEC.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.3"
              },
              "items": [
                {
                  "text": "Maono 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atu andasagala mumo Jerusalemu, na mudzi hinyo undakala salama wala taundaangamizwa tsona.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hiri ndiro pigo ambaro Mwenyezi Mlungu andapiga mataifa gosi gopigana na atu a Jerusalemu: Miri yao indaola kuno aimire, matso gao gandaola ndani ya vitswa vyao na malilimi gao gandaola mwao miromoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.12",
            "verseOrgIds": [
              "ZEC.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo, Mwenyezi Mlungu andaatiya wuoga munji hadi chila mutu andamtiya myawe mkpwononi nao apigane enye kpwa enye. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.13",
            "verseOrgIds": [
              "ZEC.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a Juda andapigana kukanira Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:14",
              "type": "text"
            },
            {
              "text": "Atu a Juda andapigana kukanira Jerusalemu",
              "type": "text"
            },
            {
              "text": "tafusiri zanjina zinaamba",
              "type": "text"
            },
            {
              "text": "atu a Juda andapigana na atu a Jerusalemu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na utajiri wa mataifa ganjina chigozunguluka undakusanywa kpwa unji, yani zahabu, feza na mavwazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pigo riro hiro rindapiga farasi, nyumbu, ngamia, punda, yani nyama osi ndiokala kpwenye kambi hizo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        }
      ]
    },
