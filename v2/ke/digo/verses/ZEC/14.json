              "attrs": {
                "loc": "JHN.7.38"
              },
              "items": [
                {
                  "text": "Johana 7:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Maono 22:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tsona siku iyo, madzi manono gandajera kula Jerusalemu. Nusu ya madzi higo gandajera kuphiya bahari ya mlairo wa dzuwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:8",
              "type": "text"
            },
            {
              "text": "bahari ya mlairo wa dzuwa",
              "type": "text"
            },
            {
              "text": "piya nkuihwa",
              "type": "text"
            },
            {
              "text": "Bahari ya Munyu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na nusu yanjina gajere kuphiya bahari ya mtswerero wa dzuwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:8",
              "type": "text"
            },
            {
              "text": "bahari ya mtswerero wa dzuwa",
              "type": "text"
            },
            {
              "text": "piya nkuihwa",
              "type": "text"
            },
            {
              "text": "Bahari Kulu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Madzi higo gandaenderera kujera ikale ni wakati wa kazikazi au wakati wa mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        }
      ]
