              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwezi wa sabaa wa Chiyahudi",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.1",
            "verseOrgIds": [
              "EZR.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:1",
              "type": "text"
            },
            {
              "text": "Mwezi wa sabaa wa Chiyahudi",
              "type": "text"
            },
            {
              "text": "ni sawa na kahi-kahi ya mwezi wa tisiya hadi kahi-kahi ya mwezi wa kumi wa kalenda ya kawaida.",
              "type": "text"
            }
          ]
        },
        {
          "text": " uriphofika, Aiziraeli kala akamala kusagala na kuhurira mwao midzini. Phahi atu achikusanyika phamwenga hiko Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.1",
            "verseOrgIds": [
              "EZR.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1"
              },
              "items": [
                {
                  "text": "Kutsama 27:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipho Jeshuwa mwana wa Jozadaki achiunuka phamwenga na alavyadzi-sadaka ayae, Zerubabeli mwana wa Shealitieli na nduguze achidzenga luphya phatu pha kulavira sadaka Mlungu wa Iziraeli, ili amlavire sadaka za kuochwa dza irivyoandikpwa katika shariya ya Musa, mutu wa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.1+NUM.28.2+NUM.28.3+NUM.28.4+NUM.28.5+NUM.28.6+NUM.28.7+NUM.28.8"
              },
              "items": [
                {
                  "text": "Isabu 28:1–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dzagbwe hara mateka ariouya kala anaogopha atu ariokala anasagala tsi hiyo, adzenga phatu pha kulavira sadaka pho phatuphe pha mwandzo. Nao achimlavira Mwenyezi Mlungu sadaka za kuochwa chila siku, ligundzu na dziloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.12+NUM.29.13+NUM.29.14+NUM.29.15+NUM.29.16+NUM.29.17+NUM.29.18+NUM.29.19+NUM.29.20+NUM.29.21+NUM.29.22+NUM.29.23+NUM.29.24+NUM.29.25+NUM.29.26+NUM.29.27+NUM.29.28+NUM.29.29+NUM.29.30+NUM.29.31+NUM.29.32+NUM.29.33+NUM.29.34+NUM.29.35+NUM.29.36+NUM.29.37+NUM.29.38"
              },
              "items": [
                {
                  "text": "Isabu 29:12–38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyo atu asherekeya Sikukuu ya Vibanda dza irivyolagizwa, achikala analavya sadaka za kuochwa sawa-sawa na isabu iriyolondwa chila siku ya sharee. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
              "EZR.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Isabu 28:11—29:39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya vivyo, achienderera kulavya sadaka za kuochwa za chila siku, za kulumbwa kpwa mwezi, na za sikukuu zosi ambazo Mwenyezi Mlungu kala akaziika, na piya amlavira Mwenyezi Mlungu sadaka za hiyari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula siku ya kpwandza ya mwezi wa sabaa aandza kumlavira Mwenyezi Mlungu sadaka za kuochwa. Ela misingi ya yo nyumba ya kuvoya Mlungu kala taidzangbweikpwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
