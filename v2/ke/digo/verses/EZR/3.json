        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi aaripha pesa mafundi a mawe na mafundi a mbao ili adzenge yo nyumba ya kuvoya Mlungu. Chisha achiapha atu a Sidoni na atu a Tiro chakurya, vinwadzi na mafuha ili areherwe magogo ga mierezi kula Lebanoni hadi Jopa kpwa njira ya bahari kama arivyoruhusiwa ni Koreshi, mfalume wa Pashia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        }
      ]
    },
