            }
          ]
        },
        {
          "text": "Phahi maadui ga mbari ya Juda na Benjamini gariphosikira kukala nyo atu ariouya bada ya kutsamizwa kpwa lazima anadzenga luphya nyumba ya Mwenyezi Mlungu, Mlungu wa Iziraeli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
