          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Aritashasita ariphokala anatawala, Bishilamu, Mithiredathi, Tabeeli na ashirika aho amuandikira baruwa. Yo baruwa kala ikaandikpwa kpwa luga ya Chiaramu nayo ichitafusiriwa kpwa ajili ya ye mfalume. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumu mkpwulu wa majeshi na muandishi Shimushai amuandikira mfalume Aritashasita baruwa mbii kuhusu Jerusalemu. Baruwa yenye kala inaamba hivi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
      ]
