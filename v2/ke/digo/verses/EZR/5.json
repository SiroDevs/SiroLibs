              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.6+ZEC.4.7+ZEC.4.8+ZEC.4.9"
              },
              "items": [
                {
                  "text": "Zakariya 4:6–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi Zerubabeli mwana wa Shealitieli na Jeshuwa mwana wa Jozadaki auyira kuidzenga yo nyumba ya kuvoya Mlungu iriyo Jerusalemu, nao manabii a Mlungu achikala phamwenga nao na achiaterya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
      ]
    },
