            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hino ndiyo baruwa ambayo Tatenai liwali wa jimbo ririro ngʼambo ya muho Yufurati na Shethari-Bozenai na vilongozi ayawao a ngʼambo ya Yufurati aihuma kpwa mfalume Dario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.6",
            "verseOrgIds": [
              "EZR.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo ujumbe arioandika na kumuhumira mfalume Dario ni hinyu:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.7",
            "verseOrgIds": [
              "EZR.5.7"
            ]
          }
