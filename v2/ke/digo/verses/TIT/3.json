              "items": [
                {
                  "text": "2 Timothi 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mimi ndahuma Aritema au Tikiko hiko kpwenu. Na hiye mutu ndiphofika hiko, henda chadi wedze hukutane mudzi wa Nikopoli, mana nikakata shauri kusala hiko minga yosi ya mnyevu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24"
              },
              "items": [
                {
                  "text": "Mahendo 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.12"
              },
              "items": [
                {
                  "text": "1 Akorintho 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Henda chadi sana kuaterya Apolo na mwanashariya Zena ili aweze kuandza charo chao, na uhakikishe ana chila chitu alondacho. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni lazima atu ehu adzifundze kuhumira wakati wao kuhenda manono aphahe kuterya ayawao ario na maitaji ga muhimu ili nao asisagale maisha bila ya lengo.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
      ]
    },
