          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, fundza mambo higo na uhumire uwezoo wosi kuahimiza na kuademurira anaokuphundza. Mutu yeyesi naasikubere.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
