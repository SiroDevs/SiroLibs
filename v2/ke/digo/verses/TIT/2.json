            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Petero 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wadzilavya ili ahukombole na uyi wosi na ahutakase hukale atue mwenye, ario na hamu ya kuhenda manono.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
