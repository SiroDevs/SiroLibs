                "loc": "2CH.36.9+2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Nyakati 36:9–10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Siku ya tsano ya nyo mwezi (nayo kala ni mwaka wa tsano hangu mfalume Jehoyakini ahalwe mateka), ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.2",
            "verseOrgIds": [
              "EZK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu wagomba na mlavyadzi-sadaka Ezekieli mwana wa Buzi ko tsi ya Akalidayo kanda-kanda ya Kebari, na uwezo wa Mwenyezi Mlungu kala u dzuluye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati nriphokala nalola, náona phuto ra chikulukulu rinapiga kula uphande wa vurini, ingu kulu rozungulukpwa ni mwanga. Kahi ya ro ingu kala kunatuluka limeme rokala rinameka-meka. Na kahi-kahi ya nyo mmeko kala phanangʼala dza chuma chingʼalacho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.4",
            "verseOrgIds": [
              "EZK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.6"
              },
              "items": [
                {
                  "text": "Maono 4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mo kahi-kahi mwatuluka viumbe vine virivyo moyo. Navyo kala vina umbo dza ra mutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela chila chiumbe kala china nyuso ne na mapha mane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magulu gao kala gakagoloka twaa, na nyayo zao kala ni dza makpwatsa ga mwana ndzau; nago kala ganangʼala dza shaba ichiyotsuswa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsini ya mapha gao pande zosi ne, kala vina mikono dza ya mwanadamu; navyo vyosi vine kala vina nyuso na mapha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsa za mapha ga mmwenga zagutana na tsa za viumbe viiri chimwenga uphande huno na chanjina uphande huno. Vyosi vyaphiya mbere mwenga kpwa mwenga, tavigalukire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "Ezekieli 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Maono 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Navyo kala vina sura za atu uphande wa mbere, sura za simba uphande wa kulume, sura za ndzau uphande wa kumotso na ko mongoni vyakala na sura za kozi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapha mairi ga chila chiumbe kala gakaandzulwa kuphiya dzulu, na chila apha kala rikagutana na apha ra chiumbe chanjina kahi ya vyo viumbe vine, kuno mapha ganjina mairi gakafwinika miri yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chila chiumbe chaphiya mbere mwenga kpwa mwenga; kokosi roho arikophiya, vyaphiya kuko. Navyo kala tavigaluka wakati vinaphiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "Maono 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Navyo vyo viumbe kala uchivilolato, vinaonekana dza makala ga moho, au vimwindi. Na moho kala unamwirika hiku na hiku kahi ya vyo viumbe navyo kala vinatuluza limeme. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi vyo viumbe vyazola upesi kuphiya mbere na nyuma, dza limeme rimekavyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
