          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapha gao mairi kala gakaandzulwa tsini ya nyo utu kuelekeana, na mapha mairi gachikala gakafwinika miri yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
