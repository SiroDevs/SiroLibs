              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati vikaima ti kuno vikatsereza mapha gao, násikira sauti kula dzulu ya ura uringo uriokala dzulu ya vitswa vyao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
