              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho yuya mutu yekala akavwala katani na vitu vya kuandikira phakpwe chibiruni achireha habari achiamba, “Nikahenda dza urivyonilagiza.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.11",
            "verseOrgIds": [
              "EZK.9.11"
            ]
          }
        }
      ]
