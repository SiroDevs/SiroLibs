                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.2"
              },
              "items": [
                {
                  "text": "Maono 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Niriphotsupha matso, náona utu dza chihi cha endzi cha dziwe ra samani ra rangi ya buluu hipho dzulu ya utu dza uringo uriokala dzulu ya vitswa vya makerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Maono 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Mwenyezi Mlungu achimuamba yuya yevwala nguwo za katani, “Injira kahi-kahi ya go magurudumo garigo tsini ya go makerubi chisha uodzaze mafumbago makala ga moho, ukagatsamule dzulu ya nyo mudzi.” Wakati nalola, iye wainjira ndani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu yuyu ariphoinjira, makerubi gaima uphande wa mwakani mwa yo nyumba ya kuvoya Mlungu, na ingu richiodzaza muhala wa ndani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha utukufu wa Mwenyezi Mlungu uchiuruka kula pho dzulu ya makerubi na uchiphiya hadi kpwenye chizingiti cha nyumba ya kuvoya Mlungu. Nyumba yosi ichiodzala ro ingu, na nyo muhala wa ndani uchingʼala-ngʼala kpwa utukufu wa Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na sauti ya mapha ga makerubi yaweza kusikirwa hadi muhala wa kondze, nayo kala i dza sauti ya Mlungu Mwenye Nguvu Zosi anaphogomba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Mwenyezi Mlungu ariphomuamuru yuya mutu yevwala nguwo za katani, kukala ahale moho kula kahi-kahi ya magurudumo gazungulukago kahi-kahi ya go makerubi, wainjira ndani na achiima phephi na gurudumo mwenga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho kerubi mwenga ragolosa mkpwono richihala moho pho kahi-kahi yao, richimgbwiza mikononi yuya mutu yevwala nguwo za katani, achiphiya nao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go makerubi gaonekana kukala gana mikono dza ya mwanadamu ndani ya mapha gao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
    },
    {
