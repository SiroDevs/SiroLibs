                "loc": "LEV.21.1+LEV.21.2+LEV.21.3+LEV.21.4"
              },
              "items": [
                {
                  "text": "Alawi 21:1–4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mlavyadzi-sadaka ni asidzinajisi kpwa kuguta lufu, ela napho lufu hiro ni ra ise au nine, ra mwanawe mlume au mchetu, ra nduguye mlume au mchetu ambaye kadzangbwelólwa, hipho anaweza kudzinajisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlavyadzi-sadaka ndiyeguta lufu ni lazima alunge sharee ya kudzitakasa. Chisha siku sabaa badaye, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "andainjira muhala wa ndani wa nyumba yangu kpwendahumika Phatu Phatakatifu, mumo andalavya sadakaye ya kuusa dambi, Mwenyezi Mlungu anaamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
      ]
    },
