                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Maono 22:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ye mutu achiniuyiza hadi phatu pha kumenyera nyumba ya kuvoya Mlungu, na nchiona madzi ganatuluka tsini ya chizingiti cha yo nyumba, gojera kuelekea uphande wa mlairo wa dzuwa (mana yo nyumba ya Mwenyezi Mlungu kala inalola uphande wa mlairo wa dzuwa). Go madzi kala ganajera kula tsini uphande wa kulume wa yo nyumba, uphande wa mwakani wa pho phatu pha kulavira sadaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi wanituluza kutsupira ryango ra uphande wa vurini na achinilongoza kuzunguluka hadi ryango ra kondze rilolaro mlairo wa dzuwa, nago madzi kala ganatuluka uphande wa mwakani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha ye mutu waphiya uphande wa mlairo wa dzuwa kuno akagbwiririra mkpwowa wa kupimira, achipima mita magana matsano na achinilongoza kutsupira madzi gofika nguyuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha wapima tsona mita magana matsano na achinilongoza kutsupira madzi ga mavwindini. Wapima tsona mita magana matsano achinilongoza kutsupira madzi gofika chibiruni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapima tsona mita magana matsano na uchikala muho ambao wanishinda kuvuka mana kala una china chire. Kala ni muho ambao mutu kala kaweza kuuvuka na magulu isiphokala kpwa kuojorera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiniamba, “Mwanadamu, ukagaona gano?”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha achiniuyiza na ko kanda-kanda ya nyo muho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nriphokala nauya, naona mihi minji kanda-kanda ya nyo muho uphande hinyu na nyo uphande wanjina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiniamba, “Madzi gaga ganajera kuelekea seemu za mlairo wa dzuwa na kujera hadi tsi ya kugbwa ya Araba, na gainjirapho Bahari ya Munyu, go madzi ga munyu gandakala pepho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokosi nyo muho uphiyako, chila chiumbe chiojoreracho mumo chindaweza kuishi. Namo mundakala na ngʼonda anji sana kpwa kukala madzi gaga ganaphiya kuko ili madzi ga bahari gakale pepho. Kokosi muho ndikophiya chila chitu chindakala moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuvi andaima kanda-kanda ya bahari, kula Eni-Gedi hadi Eni-Egilaimu undakala na mwatu mwa kuanika nyavu. Ngʼondae andakala a bazi nyinji dza ngʼonda a Bahari Kulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela madzi ga madimbwini tagandakala pepho, gandarichwa gakale ga munyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Maono 22:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mo michechemoni mwa nyo muho mundamera mihi ya bazi nyinji ndiyovyala vyakurya. Makodzage tagandanyala na taindakosa kuvyala, ela indavyala matunda maphya chila mwezi kpwa sababu go madzige ganatuluka phatu phatakatifu. Matundage gandakala chakurya na makodzage gandakala dawa.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu anaamba hivi: “Hino ndiyo miphaka ya yo tsi mundiyoiganyira mbari kumi na mbiri za Iziraeli. Atu a chivyazi cha Yusufu chindaphaha seemu mbiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi undaaganyira sawa-sawa tsi ambayo naapa kuapha akare enu. Tsi ihi indakala ni urisi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hino ndiyo miphaka ya yo tsi: Uphande wa vurini undaandzira Bahari Kulu kutsupira Hethiloni hadi phatu pha kumenyera Hamathi na kpwenderera hadi Sedadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula hipho watsupira Berotha, Sibiraimu (ambao u muphakani mwa seemu ya Damasikasi na seemu ya Hamathi), kpwenderera hadi Haseri-Hatikoni, urio kahi za mphaka wa Haurani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.16",
            "verseOrgIds": [
              "EZK.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi nyo mphaka undaandzira baharini hadi Hasari-Enoni kulunga-lunga mphaka wa vurini wa Damasikasi, phamwenga na mphaka wa Hamathi kuelekea uphande wa vurini. Uno undakala mphaka uphande wa vurini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na uphande wa mlairo wa dzuwa mphaka undala Hasari-Enoni kahi-kahi ya Haurani na Damasikasi, kulunga muho Joridani kahi-kahi ya Giliadi na yo tsi ya Iziraeli hadi bahari iriyo mlairo wa dzuwa hadi kufikira Tamari. Uno undakala mphaka wa uphande wa mlairo wa dzuwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na uphande wa mwakani, undaandza Tamari hadi madzi ga Meriba-Kadeshi kula hipho mphaka undaenderera kulunga-lunga chidzuho cha Misiri hadi Bahari Kulu. Hinyu undakala mphaka wa uphande wa mwakani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uphande wa mtswerero wa dzuwa, Bahari Kulu indakala mphaka hadi phatu pha kulolana na phatu pha kumenyera Hamathi. Hinyu undakala mphaka wa uphande wa mtswerero wa dzuwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.20",
            "verseOrgIds": [
              "EZK.47.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.20",
            "verseOrgIds": [
              "EZK.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Phahi mundadziganyira yo tsi kulengana na mbari za Iziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.21",
            "verseOrgIds": [
              "EZK.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
