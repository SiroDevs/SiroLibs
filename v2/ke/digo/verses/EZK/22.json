              "items": [
                {
                  "text": "23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36"
              },
              "items": [
                {
                  "text": "Alawi 25:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mo mwako, atu anahongbwa akaolage atu. Anaaphasa ili aphahe fwaida, anaphaha mapato gasigo ga haki kpwa kuonera Aiziraeli ayawao na kuniyala mimi, Mwenyezi Mlungu anaamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 22:12"
          },
          "items": [
            {
