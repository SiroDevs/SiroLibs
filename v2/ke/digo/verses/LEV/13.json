              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.28",
            "verseOrgIds": [
              "LEV.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Napho mutu yeyesi mlume au mchetu, ana ukongo phakpwe chitswani au cheruni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "mlavyadzi-sadaka andachunguza ukongo hinyo. Ichikala andaona kukala ukongo u ndani sana na nyere zi mandano na ni nyembamba, phahi, andatangaza kukala mutu hiye ni najisi, mana higo ni mahana ga chitswa au ga cheru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napho mlavyadzi-sadaka andachunguza pho phakongo na aone kukala taundani sana ya ngozi na nyere si nyiru, phahi mlavyadzi-sadaka andamtenga mutu hiye kpwa muda wa siku sabaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya sabaa mlavyadzi-sadaka andaphachunguza pho phenye ukongo hinyo. Achiona taphaenjerezekere na taphana nyere za rangi ya mandano wala nyo ukongo taundani sana ya ngozi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "phahi mutu hiye andanyola chitswache au cheruche. Ela phatu phara phenye ukongo kandaphanyola. Alafu mlavyadzi-sadaka andamtenga mutu hiye kpwa muda wanjina wa siku sabaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya sabaa, mlavyadzi-sadaka andachunguza pho phatu phakongo. Ichikala mlavyadzi-sadaka andaona kukala ukongo hinyo taukaenjerezeka wala kumenya ndani ya ngozi, phahi, andatangaza kukala mutu yuya ni swafi. Mutu hiye andafula nguwoze, naye andakala swafi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ichikala ukongo hinyo ukaenjerezeka bada ya kutangazwa kukala swafi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutu hiye andachunguzwa ni mlavyadzi-sadaka na ichikala ukaenjerezeka, mlavyadzi-sadaka kandakala na haja ya kuendza nyere zenye rangi ya mandano. Mutu hiye andakala najisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ichikala mlavyadzi-sadaka andaona kukala hira seemu iriyo kongo taikabadilika na nyere nyiru zikamera phatu hipho, phahi, ukongo undakala ukaphola, na mutu hiye ni swafi. Mlavyadzi-sadaka andatangaza kukala mutu hiye ni swafi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
    },
    {
