            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
