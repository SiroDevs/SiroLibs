                {
                  "text": "Mwandzo 17:7–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "phahi, hipho nami nindatambukira chilagane changu nrichoika na Jakobo, Isaka na Burahimu, na kutambukira nrivyoalaga kuhusu tsi hiyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        }
      ]
