                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Msidzitengezere vizuka, msidziimisire vizuka vya kutsongbwa au nguzo wala mawe ga kutsongbwa kpwenye tsi yenu na kugaabudu. Mimi, ndimi Mwenyezi Mlungu, Mlungu wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbwirani Siku zangu za Kuoya na muishimu phatu phangu phatakatifu. Mimi, ndimi Mwenyezi Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
