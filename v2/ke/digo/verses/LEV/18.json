              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Usilavye mwanao hata mmwenga akale sadaka kpwa Moleki,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:21",
              "type": "text"
            },
            {
              "text": "Moleki",
              "type": "text"
            },
            {
              "text": "ni chizuka chimwengachapho choabudiwa ni Aamoni kpwa kuchilavira ana aho dza sadaka za kuochwa au kutsupizwa mohoni.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mana kuhenda hivyo ni kubera dzina rangu mimi Mlunguo. Mimi, ndimi Mwenyezi Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        }
      ]
    },
