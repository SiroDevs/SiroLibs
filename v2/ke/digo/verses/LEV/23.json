            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achimuambira Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.33",
            "verseOrgIds": [
              "LEV.23.33"
            ]
          }
        },
        {
