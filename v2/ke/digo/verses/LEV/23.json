          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aambire Aiziraeli hivi: Hizi ndizo sikukuu zangu ambazo mimi Mwenyezi Mlungu nkazipanga mundazitangaza kpwenye mikutano yenu mitakatifu kpwa ishima yangu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        }
      ]
