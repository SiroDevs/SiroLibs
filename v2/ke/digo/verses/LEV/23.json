                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Dziloni wakati jiza rinahanda siku ya kumi na ne ya mwezi wa mwandzo, mundamuishimu Mwenyezi Mlungu kpwa kusherekeya sikukuu ya Pasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
