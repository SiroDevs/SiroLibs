        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlavyadzi-sadaka andareha hura mkpwahe wa mavuno ga mwandzo na gara maturume mairi mbere za Mwenyezi Mlungu gakale sadaka ya kuunulwa. Hizo ni sadaka takatifu kpwa Mwenyezi Mlungu nazo zindakala za mlavyadzi-sadaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.20",
            "verseOrgIds": [
              "LEV.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo-iyo mundatangaza mkpwutano mtakatifu namwi msihende kazi za kawaida. Hiri ni lagizo ra kare na kare kpwa vivyazi vyenu vyosi phatu phophosi mndiphosagala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.21",
            "verseOrgIds": [
              "LEV.23.21"
            ]
          }
        }
      ]
