            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alafu Musa wahala chiasi cha mafuha ga utakaso na milatso kula phatu pha kulavira sadaka achimtimvira-timvira Aruni na anae na nguwo zao piya. Chihivyo Musa achimtenga Aruni na anae na nguwo zao kpwa ajili ya Mwenyezi Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa achimuambira Aruni na anae, “Jitani hira nyama pho phatu pha kumenyera hema ra mkpwutano, muirye phapho hipho phamwenga na mikahe iriyo mo kaphuni mwenye sadaka za kutenga alavyadzi-sadaka kpwa ajili ya Mwenyezi Mlungu. Hendani dza vira nirivyokulagiza uwe na anao kukala seemu iyo ni iriwe ni mwimwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama yoyosi au mkpwahe wowosi ndiosala ni uochwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.32",
            "verseOrgIds": [
              "LEV.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamundatuluka kondze ya phatu pha kumenyera hema ra mkpwutano kpwa muda wosi wa siku sabaa, yani hadi muda wenu wa kutengbwa kpwa ajili ya Mwenyezi Mlungu usire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.33",
            "verseOrgIds": [
              "LEV.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu akalagiza huhende dza vira huchivyohenda rero kusudi hukuhendereni upatanisho kpwa kukuusirani dambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni msale pho phatu pha kumenyera hema ra mkpwutano usiku na mutsi kpwa muda wa siku sabaa, na muhende gara mrigolagizwa ni Mwenyezi Mlungu, ili msifwe. Hivi ndivyo nirivyolagizwa ni Mwenyezi Mlungu.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Aruni na anae achihenda gosi ambago Mwenyezi Mlungu walagiza kutsupira Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.36",
            "verseOrgIds": [
              "LEV.8.36"
            ]
          }
        }
      ]
