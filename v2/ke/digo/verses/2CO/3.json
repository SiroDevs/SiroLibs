                "loc": "EXO.24.12"
              },
              "items": [
                {
                  "text": "Kutsama 24:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.33"
              },
              "items": [
                {
                  "text": "Jeremia 31:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.19"
              },
              "items": [
                {
                  "text": "Ezekieli 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.26"
              },
              "items": [
                {
                  "text": "36:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I wazi kala mwimwi mu dza baruwa yoandikpwa ni Jesu ambayo ni matokeo ga kazi yehu huriyokureherani. Baruwa iyo taiyaandikpwa na wino, ela na Roho Mtakatifu ariye moyo. Tsona baruwa iyo taiyaandikpwa dziweni, ela ndani ya mioyo ya atu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Swiswi huna hakika ya mambo higo mbere za Mlungu kpwa sababu ya Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.4",
            "verseOrgIds": [
              "2CO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si kukala hunaweza kuhenda chochosi na uwezo wehu enye, ela hunaadamira uwezo kula kpwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.31"
              },
              "items": [
                {
                  "text": "Jeremia 31:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iye ndiye ariyehupha uwezo wa kukala atumishi a chilagane chiphya, ambacho chandzoche si shariya ya kuandikpwa, ela chandzoche ni Roho Mtakatifu. Shariya za kuandikpwa nkureha chifo, ela Roho nkureha uzima.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
