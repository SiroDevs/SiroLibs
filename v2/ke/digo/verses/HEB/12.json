              "items": [
                {
                  "text": "Mwandzo 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mkafika kpwa Jesu, mpatanishi wa chilagane chiphya apatanishaye atu na Mlungu. Mlatsowe wamwagika kuswamehe dambi badala ya kuriphiza dza mlatso wa Abeli.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        }
