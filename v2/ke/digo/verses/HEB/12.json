                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.11+DEU.4.12"
              },
              "items": [
                {
                  "text": "Kumbukumbu 4:11–12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.22+DEU.5.23+DEU.5.24+DEU.5.25+DEU.5.26+DEU.5.27"
              },
              "items": [
                {
                  "text": "5:22–27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwimwi tamwedzere Mwango Sinai uwezao kugutwa, phatu phokala na jimbijimbi ra moho, chilungulungu cha jiza na phuto kali. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piya tamwedzere phatu hipho pha sauti za kululu za gunda wala sauti ya Mlungu iriyokala kulu hata hinyo akare ehu ariphoisikira, achimvoya asigombe nao tsona. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.12"
              },
              "items": [
                {
                  "text": "Kutsama 19:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana Mlungu kala akalagiza achiamba, “Hata nyama achiguta nyo mwango, piya ni apigbwe mawe hata afwe.” Nao ariphosikira ro lagizo, taayaweza kurivumirira. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.19"
              },
              "items": [
                {
                  "text": "Kumbukumbu 9:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mambo higo kala ganatisha sana, hata Musa mwenye achiamba, “Nikatishirwa hata nakakama kpwa wuoga.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela mwimwi mkafika Mwango wa Sayuni ambako ni Jerusalemu ya mlunguni. Hinyu ni mudzi wa Mlungu ariye moyo, nako kuna maelufu na maelufu ga malaika anasherekeya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkedza kutana na kundi ra ana amendzwao sana",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:23",
              "type": "text"
            },
            {
              "text": "Ana a kpwandza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ni Mlungu, ambao madzina gao gaandikpwa mlunguni. Mkafika kpwa Mlungu ambaye ndiye muamuli wa atu osi. Mkafika mlunguni kuriko na roho za atu a haki ariohendwa akale atakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
