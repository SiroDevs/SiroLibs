              "items": [
                {
                  "text": "Zaburi 8:4–6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ela Maandiko ganalavya ushaidi hinyu:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
            ]
          }
        }
