            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.9",
            "verseOrgIds": [
              "HEB.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Mlungu waumba vitu vyosi, navyo vyakalapho kpwa ajiliye. Naye anareha ana anji kushiriki utukufuwe. Kpwa hivyo kala inabidi amukamilishe Jesu kpwa njira ya kugaya, iye ambaye ni chandzo cha wokofu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.10",
            "verseOrgIds": [
              "HEB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye Jesu atakasaye atu dambi zao akale atakatifu, na hinyo anaohendwa akale atakatifu, osi ise yao ni mmwenga. Ndiyo sababu Jesu kaona waibu kuaiha nduguze, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.11",
            "verseOrgIds": [
              "HEB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.22"
              },
              "items": [
                {
                  "text": "Zaburi 22:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "naye achiamba,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        }
      ]
