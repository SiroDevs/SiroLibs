                "loc": "JER.31.31+JER.31.32+JER.31.33+JER.31.34"
              },
              "items": [
                {
                  "text": "Jeremia 31:31–34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela Mlungu mwenye wakuta hara akare ehu ana makosa. Kpwa hivyo aambira:",
          "type": "text",
