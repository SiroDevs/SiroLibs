              },
              "items": [
                {
                  "text": "Zaburi 110:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kahi za mambo gosi higo, ra muhimu zaidi ni hiri: mlavyadzi-sadaka wehu mkpwulu asegere mkpwono wa kulume wa Mlungu, phatu pha ishima kulu sana hiko mlunguni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nkuhumikira Mlungu phatu phatakatifu, ndani ya rira hema ra kpweli rotengezwa ni Bwana Mlungu mwenye wala siyo mikono ya anadamu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chila mlavyadzi-sadaka mkpwulu nkutsambulwa alavye zawadi na sadaka, na vivyo hivyo mlavyadzi-sadaka wehu mkpwulu piya ni lazima akale na chitu cha kulavya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.3",
            "verseOrgIds": [
              "HEB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalapho Jesu angekala anasagala mumu duniani, kangekala mlavyadzi-sadaka hata chidide, kpwa sababu kuna atu anjina ambao analavya sadaka kulengana na Shariya za Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.4",
            "verseOrgIds": [
              "HEB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.40"
              },
              "items": [
                {
                  "text": "Kutsama 25:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hinyo alavyadzi-sadaka anamuhumikira Mlungu phatu phatakatifu ambapho ni mfwano na chivurivuri cha pho phatu phatakatifu hiko mlunguni. Ndiyo mana Musa ariphokala anadzitayarisha kutengeza hema ra kumuabudu Mlungu, Mlungu wamuonya achimuamba, “Hakikisha unatengeza vitu vivi vyosi kulengana na mpango urioonyeswa ko dzulu mwangoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jesu wahewa kazi ambayo ni bora zaidi kuriko hira ya alavyadzi-sadaka a kare. Kaziye ni bora zaidi kpwa sababu iye ni mpatanishi wa chilagane chiphya ambacho chadzengbwa dzulu ya ahadi nono zaidi kuriko chira cha kare.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
