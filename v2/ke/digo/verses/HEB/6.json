          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.2"
              },
              "items": [
                {
                  "text": "Alawi 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiro kuluphiro rehu ni kama nanga inayohenda mioyo yehu ikale imara. Naro rinahulongoza kutsupira ndani ya paziya kufika mbere za Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.19",
            "verseOrgIds": [
              "HEB.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Zaburi 110:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jesu wahutanguliya kare kpwa sababu yehu. Naye wamuhenda akale mlavyadzi-sadaka mkpwulu sawa na ulavyadzi-sadaka wa Melikisedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.20",
            "verseOrgIds": [
              "HEB.6.20"
            ]
          }
