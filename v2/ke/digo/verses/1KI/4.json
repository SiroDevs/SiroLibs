                "loc": "SNG.1.1"
              },
              "items": [
                {
                  "text": "Wira wa Selemani 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Watunga misemo elufu tahu na mawira elufu mwenga na tsano. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasemurira mambo ga mihi, kuandzira muerezi urio Lebanoni, hata muhisopo, muhi uambalao dzulu ya ukuta. Piya wasemurira dzulu ya nyama, nyama a mapha, viumbe vihambalavyo na ngʼonda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu kula mataifa ganjina gosi na afalume osi ariophaha kusikira dzulu ya ikima ya mfalume Selemani, akpwedza ili amusikize.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.4.34"
            ]
          }
