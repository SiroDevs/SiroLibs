        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a Juda na Iziraeli akala anji dza mtsanga wa pwani nao kala achirya, achinwa na kuhererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.20",
            "verseOrgIds": [
              "1KI.4.20"
            ]
          }
        },
