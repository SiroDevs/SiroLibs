              "items": [
                {
                  "text": "Mwandzo 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.26"
              },
              "items": [
                {
                  "text": "2 Nyakati 9:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Selemani watawala falume zosi kuandzira muho Yufurati hadi kpwenye tsi ya Afilisti na kpwenderera hadi kpwenye mphaka wa Misiri. Falume hizo zamuhumikira na kumripha kodi siku zosi za maishage.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.4.21"
            ]
          }
        }
      ]
    },
    {
