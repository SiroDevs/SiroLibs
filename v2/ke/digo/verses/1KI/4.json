                  "text": "9:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Selemani wakala na mabanda elufu mirongo mine kpwa ajili ya farasi na magarige ga kuvwehwa ni farasi na asikari akuhumira farasi elufu kumi na mbiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.26",
            "verseOrgIds": [
              "1KI.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hara maliwalie kumi na airi, chila mmwenga kpwa mwezi ariopangirwa, waphirika chakurya cha kutosha kpwa ajili ya mfalume Selemani na hara osi ariorya katika nyumbaye. Mahitaji gao gosi gatoshelezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.27",
            "verseOrgIds": [
              "1KI.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuma ya chila mmwenga iriphofika, waphirika shayiri na nyasi za kurisa farasi a kuvweha magari na farasi anjina phatu ambapho kala ni ziphirikpwe kulengana na irivyolagizwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
