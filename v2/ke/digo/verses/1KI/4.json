            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsi yosi ya uphande wa mtswerero wa dzuwa wa muho Yufurati, kutulukiza Tifusa hadi mudzi wa Gaza, kala i tsini ya utawalawe. Afalume osi a uphande wa mtswerero wa dzuwa wa muho Yufurati akala tsiniye na wakala na amani na tsi zosi jirani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.24",
            "verseOrgIds": [
              "1KI.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku zosi za utawala wa Selemani, atu a Juda na a Iziraeli asagala salama, kula Dani hadi Beeri-Sheba chila mutu wahurira tsini ya mizabibuye na Mitiniye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.25",
            "verseOrgIds": [
              "1KI.4.25"
            ]
          }
        }
      ]
    },
