          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahendo ganjina ga Rehoboamu na gosi arigohenda gaandikpwa kpwenye Chitabu cha Kumbukumbu za afalume a Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
