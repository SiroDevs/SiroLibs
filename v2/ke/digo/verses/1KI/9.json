            "style": "v",
            "sid": "1KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.23",
            "verseOrgIds": [
              "1KI.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona mwana mchetu wa mfalume wa Misiri watsama kula mudzi wa Daudi, achendaishi kpwenye nyumbaye mwenye ambayo Selemani wamdzengera. Chisha Selemani wadzenga Milo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.24",
            "verseOrgIds": [
              "1KI.9.24"
            ]
          }
        }
      ]
    },
