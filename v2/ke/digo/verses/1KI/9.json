          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalume Hiramu waahuma atumishie mabaharia amanyao bahari phamwenga na ahendadzi-kazi a Selemani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
