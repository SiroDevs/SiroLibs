              },
              "items": [
                {
                  "text": "2 Nyakati 36:5–7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwaka wa hahu wa utawala wa Jehoyakimu, mfalume wa Juda, Nebukadineza, mfalume wa Babeli, wakpwedzazangira Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
