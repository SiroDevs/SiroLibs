                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.21"
              },
              "items": [
                {
                  "text": "Mathayo 24:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.19"
              },
              "items": [
                {
                  "text": "Mariko 13:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ye malaika yevwala katani waenderera kuamba, “Wakati uho Mikaeli, malaika mkpwulu arindaye atu a Iziraeli andatsembuka. Alafu kundakala na wakati wa mashaka mai ambago tagadzangbweoneka hangu mataifa ganjina gaumbwe. Ela wakati uho chila mutuo ambaye dzinare raandikpwa kpwenye chitabu cha uzima, andativywa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.19"
              },
              "items": [
                {
                  "text": "Isaya 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.46"
              },
              "items": [
                {
                  "text": "Mathayo 25:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Johana 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atu anji ariofwa, andafufuka, anjina ainjire uzima wa kare na kare, na anjina aphahe waibu na kuberwa hata kare na kare. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.2",
            "verseOrgIds": [
              "DAN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyo ario na ikima andangʼala dza mwanga wa mlunguni na nyo ariolongoza atu anji njira ya haki andangʼala dza nyenyezi ta kare na kare. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.10"
              },
              "items": [
                {
                  "text": "Maono 22:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela uwe Danieli, go maneno usigaseme, na chitabu chichi chifunge na uchitiye muhuri hadi wakati wa mwisho. Anji andaphiya hiku na kura na marifwa gandaenjerezeka.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho mimi Danieli náunula matso nchiona atu anjina airi, mmwenga kala a uphande huno wa muho na wanjina kala a ngʼambo ya phiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.5",
            "verseOrgIds": [
              "DAN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwenga wao achiuza ye mutu ariyekala akavwala mavwazi ga katani ariyekala akaima uphande wa dzulu wa muho, achimuamba, “Gano mambo ga kuangalaza gandahendeka rini?” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.10.5"
              },
              "items": [
                {
                  "text": "Maono 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.14"
              },
              "items": [
                {
                  "text": "12:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ye mutu yevwala nguwo za katani, ariyekala a uphande wa dzulu wa nyo muho, waunula mikonoye kuelekeza mlunguni achiapa kpwa dzina ra iye ariye moyo hata kare na kare. Achiamba, “Vindakala kpwa muda wa miaka mihahu na nusu. Wakati uwezo wa atakatifu ndiphosiswa, mambo gaga gosi gandakala gakatimiya.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.7",
            "verseOrgIds": [
              "DAN.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo gago nágasikira, ela sigaelewere. Phahi nauza nchiamba, “Ee bwana wangu, nyo mwisho wa mambo gano gosi undakaladze?” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.8",
            "verseOrgIds": [
              "DAN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achinijibu achiniamba, “Danieli phiya vyako, kpwa mana chitabu cha maneno gaga chikafungbwa na kutiywa muhuri hadi wakati wa mwisho. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.9",
            "verseOrgIds": [
              "DAN.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.11"
              },
              "items": [
                {
                  "text": "Maono 22:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atu anji andatsuswa, ahendwe asikale na ila na atakaswe, ela atu ayi andaenderera kuhenda uyi. Nyo atu ayi taandaelewa, ela nyo a ikima andaelewa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.10",
            "verseOrgIds": [
              "DAN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.27"
              },
              "items": [
                {
                  "text": "Danieli 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.31"
              },
              "items": [
                {
                  "text": "11:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.15"
              },
              "items": [
                {
                  "text": "Mathayo 24:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.14"
              },
              "items": [
                {
                  "text": "Mariko 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hangu kukomeswa kpwa sadaka za kuochwa za chila siku, yani wakati ndiphoimiswa chitu cha kutsukiza chinachohendesa phatu kukala wekee hadi gaga ndiphosira, undakala ni muda wa siku elufu mwenga, magana mairi na mirongo tisiya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baha mutu avumiriraye hadi zo siku elufu mwenga, magana mahahu na mirongo mihahu na tsano zisire. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela uwe Danieli enderera kuishi hadi mwishoo. Nawe undafwa, ela mwisho wa zo siku undafufuka ili uhewe zawadi iriyoikpwa kpwa ajiliyo.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
      ]
    }
  ],
