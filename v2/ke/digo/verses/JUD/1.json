          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivyo hivyo hinya alimu a handzo ni kulongozwa ni ndoso zao kuhenda mai na miri yao. Nkubera uwezo wa Mlungu na kulaphiza viumbe vya dzulu mlunguni. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
