                {
                  "text": "Mariko 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mimi Juda, mtumishi wa Jesu Masihi na ndugungbwa wa Jakobo, nakuandikirani mwimwi murioihwa ni Baba Mlungu. Mmanye kukala munamendzwa ni Mlungu na kurindwa ni Jesu Masihi. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuvoyerani Mlungu akupheni mbazi, amani na mendzwa nyinji.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
