        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.1+GEN.19.2+GEN.19.3+GEN.19.4+GEN.19.5+GEN.19.6+GEN.19.7+GEN.19.8+GEN.19.9+GEN.19.10+GEN.19.11+GEN.19.12+GEN.19.13+GEN.19.14+GEN.19.15+GEN.19.16+GEN.19.17+GEN.19.18+GEN.19.19+GEN.19.20+GEN.19.21+GEN.19.22+GEN.19.23+GEN.19.24"
              },
              "items": [
                {
                  "text": "Mwandzo 19:1–24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tsona tambukirani atu a Sodoma na Gomora na midzi iriyokala phephi, ahenda dza hara malaika. Azinga na alume kuhendwa achetu; mambo higa ni chinyume cha mipango ya Mlungu. Achihukumiwa moho wa kare na kare, ikale fundzo kpwa atu osi.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        }
      ]
