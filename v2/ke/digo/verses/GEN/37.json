      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati hinyo-hinyo, hiko Misiri, hara ahendadzi-bishara a Chimidiani amguza Yusufu kpwa Potifa, mmwenga wa atumishi a Farao, ambaye kala ni mkpwulu wa asikari a urindzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        }
