                "loc": "ACT.7.9"
              },
              "items": [
                {
                  "text": "Mahendo 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho, rira likongo ra ahendadzi-bishara a Chimidiani ariphofika phara, hara nduguze Yusufu amtuluza mo chisimani na achimguza na atu a Isimaili kpwa vipande mirongo miiri vya feza, nao achimphirika Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.28",
            "verseOrgIds": [
              "GEN.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.28",
            "verseOrgIds": [
              "GEN.37.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa kuguzwa Yusufu, Rubini kala kapho na kamanyire kukala nduguze akamguza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.29",
            "verseOrgIds": [
              "GEN.37.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "37:29",
              "type": "text"
            },
            {
              "text": "Maneno higa, kpwandzira",
              "type": "text"
            },
            {
              "text": "wakati wa",
              "type": "text"
            },
            {
              "text": "hadi",
              "type": "text"
            },
            {
              "text": "akamguza",
              "type": "text"
            },
            {
              "text": "gaenjerezwa tafasirini ili kueleza wazi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ariphouya, chisimani na achiona Yusufu kamo, wakpwanyula nguwoze kpwa utsungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.29",
            "verseOrgIds": [
              "GEN.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiauyira nduguze achendaambira, “Yuya mvulana kamo mo chisimani! Simanya nihendedze?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.30",
            "verseOrgIds": [
              "GEN.37.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.30",
            "verseOrgIds": [
              "GEN.37.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu nyo nduguze atsindza mbuzi na achihala hira kandzu ya Yusufu achiivwika mo mlatsoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.31",
            "verseOrgIds": [
              "GEN.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha aihala hira kandzu maridadi hadi kpwa ise yao na achendamuamba, “Lola, baba, hukatsola kandzu, hebu ilole ichikala ni ya Yusufu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.32",
            "verseOrgIds": [
              "GEN.37.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ise yao waitambukira na achiamba, “Ni kandzu ya mwanangu, nyama mbaya wamurya! Hakika Yusufu wagbwirwa achiriwa!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo wakpwanyula nguwoze achivwala magunia kpwa utsungu. Wamririra mwanawe siku nyinji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.34",
            "verseOrgIds": [
              "GEN.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anae osi alume na achetu amʼbembeleza, ela achirema. Achiamba, “Aa, nindamririra mwanangu hadi ndiphophiya ko kuzimu ariko.” Phahi, waenderera kumririra mwanawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        }
      ]
    },
