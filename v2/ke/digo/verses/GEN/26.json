                  "text": "Mwandzo 21:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wala Gerari kpwedzamuona Isaka; wakpwedza na Ahuzathi, mshauriwe, na Fikoli, mkpwulu wa majeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wauza, “Mkalungani mana mwanimena na mchinizola?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achimuamba, “Swino hwaona wazi kukala Mwenyezi Mlungu a phamwenga nawe, kpwa hivyo hunaona baha hurye chirapho na uwe na huike chilagane kukala ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kundahuhenda mai dza viratu ambavyo tahuyakuhenda mai. Swiswi hwakuhendera manono na huchikuricha utsame na amani. Sambi ni wazi kukala Mwenyezi Mlungu wakujaliya.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Isaka waatengezera chakurya chinono, achirya na achinwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.30",
            "verseOrgIds": [
              "GEN.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligundzu chiti kuriphocha arya chirapho. Halafu Isaka achiasindikiza, achiphiya kpwao salama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        }
      ]
    },
