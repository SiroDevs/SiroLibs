          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau ariphokala ana miaka mirongo mine, walóla achetu airi Ahiti. Walóla Judithi mwana wa Beeri na Basemathi mwana wa Eloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
