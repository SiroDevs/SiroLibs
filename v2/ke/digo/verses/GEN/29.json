              "type": "text"
            },
            {
              "text": "Juda",
              "type": "text"
            },
            {
              "text": "Dzina hiri raigana na neno ra Chieburania",
              "type": "text"
            },
            {
              "text": "kutogola.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Chisha Lea achisika kuvyala.",
          "type": "text",
