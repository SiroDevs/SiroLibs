          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha wagbwira mimba yanjina tsona na ariphovyala mwana mlume wamuiha Lawi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:34",
              "type": "text"
            },
            {
              "text": "Lawi",
              "type": "text"
            },
            {
              "text": "Dzina hiri raigana na neno ra Chieburania",
              "type": "text"
            },
            {
              "text": "kumendza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mana waamba, “Sambi ndipho mlume wangu andanimendza mana námvyarira ana ahahu alume.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        }
