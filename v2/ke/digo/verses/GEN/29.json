          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea wagbwira mimba tsona na achidzivugula mwana mlume, achimuiha Simioni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:33",
              "type": "text"
            },
            {
              "text": "Simioni",
              "type": "text"
            },
            {
              "text": "Dzina hiri raigana na neno ra Chieburania",
              "type": "text"
            },
            {
              "text": "kusikira.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mana waamba, “Mwenyezi Mlungu akanipha mwana mlume wanjina, kpwa sababu wasikira simendzwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
