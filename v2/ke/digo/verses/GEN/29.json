              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu wagbwira mimba yanjina tsona na ariphovyala mwana mlume achiamba, “Sambi charo chino nindamtogola Mwenyezi Mlungu,” kpwa hivyo achimuiha Juda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        },
        {
