            {
              "text": "35:18",
              "type": "text"
            },
            {
              "text": "Mana ga dzina",
              "type": "text"
            },
            {
              "text": "Benjamini",
              "type": "text"
            },
            {
              "text": "ni",
              "type": "text"
            },
            {
              "text": "mwana amendzwaye sana.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
