          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Raheli wafwa na achizikpwa kanda-kanda ya njira ya kuphiya Efuratha (yani Bethilehemu). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.19",
            "verseOrgIds": [
              "GEN.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo waika dziwe ra kumbukumbu pho mbirani, na richere phapho hata rero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.20",
            "verseOrgIds": [
              "GEN.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 35:20"
          },
          "items": [
