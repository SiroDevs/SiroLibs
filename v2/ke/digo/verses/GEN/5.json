            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:1–2",
              "type": "text"
            },
            {
              "text": "Huno ni uvyazi wa Adamu kuandzira mwanawe Sethi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " vya Adamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1+GEN.5.2",
