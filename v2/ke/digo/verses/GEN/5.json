          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Methusela wafwa kala ana miaka magana tisiya mirongo sita na tisiya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.27",
            "verseOrgIds": [
              "GEN.5.27"
