          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya kuvyala Lameki, Methusela wasagala miaka magana sabaa mirongo minane na mbiri na achikala akavyala ana anjina, alume na achetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.26",
            "verseOrgIds": [
              "GEN.5.26"
            ]
          }
        },
        {
