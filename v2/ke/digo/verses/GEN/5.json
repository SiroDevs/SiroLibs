          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya kuvyala Enoshi, Sethi wasagala miaka magana manane na sabaa na achikala akavyala ana anjina, alume na achetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
