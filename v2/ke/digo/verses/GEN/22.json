          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanachetu wa Nahori aihwaye Reuma piya wavyala ana. Aho ni Teba, Gahamu, Tahashi na Maaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.24",
