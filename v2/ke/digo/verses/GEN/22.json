          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesedi, Hazo, Pilidashi, Jidilafu na Bethueli.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.22",
            "verseOrgIds": [
              "GEN.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bethueli wavyala Rebeka. Aha ndio ana anane ambao Milika wamvyarira Nahori, nduguye Burahimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.23",
            "verseOrgIds": [
              "GEN.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
