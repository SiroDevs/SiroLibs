        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
