          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Burahimu wauyira atumishie nao achiuka phamwenga kuuya Beeri-Sheba, ambako Burahimu kala achisagala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        }
      ]
