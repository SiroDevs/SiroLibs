                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anadamu ariphoenjerezeka duniani na kuvyarirwa ana achetu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "malaika aaona anono hano ana achetu a atu na achikala analóla yeyesi ndiyemtsambula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu wagomba achiamba, “Roho yangu taindakala ndani ya mwanadamu hata kare na kare, mana iye andafwa. Kpwa hivyo sikuze zindakala miaka gana mwenga na mirongo miiri.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        }
      ]
    },
    {
