              "items": [
                {
                  "text": "2 Nyakati 10:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi hiko Giligali kpwakala na mutu asiye na mana aihwaye Sheba mwana wa Bikiri, mutu wa mbari ya Benjamini. Wapiga gunda achiamba,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
