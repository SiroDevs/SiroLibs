            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifeleti mwana wa Ahasibai kula Maaka, Eliamu mwana wa Ahithofeli kula Gilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.34",
            "verseOrgIds": [
