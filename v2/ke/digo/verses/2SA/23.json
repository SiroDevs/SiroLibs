          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seleki Muamoni, Naharai kula Beerothi, yekala mtsukuziwe wa silaha wa Joabu mwana wa Seruya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.37",
            "verseOrgIds": [
              "2SA.23.37"
            ]
