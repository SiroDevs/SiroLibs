          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igali mwana wa Nathani kula Zoba, Bani kula Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.36",
            "verseOrgIds": [
              "2SA.23.36"
            ]
          }
        },
