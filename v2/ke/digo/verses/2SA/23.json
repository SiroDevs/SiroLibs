              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira kula Aithiri, Garebu kula Aithiri, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.38",
            "verseOrgIds": [
              "2SA.23.38"
