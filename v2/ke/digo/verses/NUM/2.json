          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye kundire kala rina alume arioandikpwa elufu mirongo mine na tsano na magana sita na mirongo mitsano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
            ]
          }
        },
        {
