            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na jumula ya alume osi arioandikpwa kula mbari hino ni elufu mirongo mihahu na mbiri na magana mairi. ",
          "type": "text",
          "attrs": {
