        },
        {
          "text": "Uphande wa mwakani kundakala na makundi ga kambi ya Rubini tsini ya bendera yao. Chilongozi wa mbari ya Rubini andakala Elisuri mwana wa Shedeuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumula ya alume a mbari ya Rubini arioandikpwa ni atu elufu mirongo mine na sita na magana matsano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
            "verseOrgIds": [
              "NUM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
