          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha nyo Aiziraeli achigaluza njira achiambuka na njira ya kuphiya Bashani. Naye Ogi mfalume wa Bashani achituluka na jeshire kpwendapigana ko Edirei.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.33",
            "verseOrgIds": [
              "NUM.21.33"
            ]
          }
