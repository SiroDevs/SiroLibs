          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.40"
              },
              "items": [
                {
                  "text": "Isabu 33:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalume mmwenga Mkanani wa mudzi wa Aradi yekala achisagala uphande wa mwakani wa tsi ya Kanani ariphosikira kukala Aiziraeli aredza na njira ya Atharimu, achiavamia na achihala anjina aho mateka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Aiziraeli achiika naziri mbere za Mwenyezi Mlungu achiamba, “Ichikala undaatiya atu aha mwehu mikononi, phahi hundaangamiza midzi yao tsetsetse.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achisikira mavoyo ga Aiziraeli na achiatiya Akanani mwao mikononi nao achiaangamiza tsetsetse aho phamwenga na midzi yao. Phahi phatu hipho phachiihwa Horima.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:3",
              "type": "text"
            },
            {
              "text": "Chieburania neno",
              "type": "text"
            },
            {
              "text": "Horima",
              "type": "text"
            },
            {
              "text": "ina mana ya kuangamizwa tsetsetse.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
