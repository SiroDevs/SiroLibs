          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Mwenyezi Mlungu achigomba na Musa achimuamba, “Usimuogophe, mana nikamtiya mwako mikononi, phamwenga na atue na tsiiye. Undamuhenda dza urivyomuhenda Sihoni mfalume wa Aamori, yekala anasagala Heshiboni.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.34",
            "verseOrgIds": [
              "NUM.21.34"
            ]
          }
        },
        {
          "name": "verse",
