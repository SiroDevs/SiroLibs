                "loc": "1KI.22.17"
              },
              "items": [
                {
                  "text": "1 Afalume 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.5"
              },
              "items": [
                {
                  "text": "Ezekieli 34:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.36"
              },
              "items": [
                {
                  "text": "Mathayo 9:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.34"
              },
              "items": [
                {
                  "text": "Mariko 6:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakati anatuluka na kuinjira, ndiyealongoza phatu phophosi ndiphophiya atu a Mwenyezi Mlungu, ili asikale dza mangʼondzi gasigokala na mrisa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.13"
              },
              "items": [
                {
                  "text": "Kutsama 24:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi Mwenyezi Mlungu achimjibu Musa achimuamba, “Hala Joshuwa mwana wa Nuni mutu ariye na moyo na umuikire mikono. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muike mbere za mlavyadzi-sadaka Eliazari na Aiziraeli osi na umuhende akale chilongozi mbere zao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muphe seemu ya mamlakago ili nyo Aiziraeli osi amuishimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.30"
              },
              "items": [
                {
                  "text": "Kutsama 28:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.41"
              },
              "items": [
                {
                  "text": "1 Samueli 14:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.6"
              },
              "items": [
                {
                  "text": "28:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Joshuwa andakala achiima mbere za mlavyadzi-sadaka Eliazari, ndiyekala achimuuzira ushauri kula kpwa Mwenyezi Mlungu kpwa kuhumira Urimu. Kpwa kuhumira njira ihi Eliazari andalongoza Joshuwa na Aiziraeli osi katika mambo gosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa achihenda dza Mwenyezi Mlungu arivyomlagiza. Achimuhala Joshuwa achimuika mbere za mlavyadzi-sadaka Eliazari na Aiziraeli osi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.23"
              },
              "items": [
                {
                  "text": "Kumbukumbu 31:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chisha achimuikira mikono ili edze akale chilongozi bada ya Musa dza Mwenyezi Mlungu arivyomlagiza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.23",
            "verseOrgIds": [
              "NUM.27.23"
            ]
          }
        }
      ]
    }
