          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alume osi kula chivyazi cha Simioni ariokala akafisa miaka mirongo miiri na kpwenderera ambao kala anaweza kuphiya vihani, aandikpwa madzina chila mmwenga kulengana na mryangowe na nyumbaye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumula ya atu arioolangbwa kula mbari ya Simioni kala ni elufu mirongo mitsano na tisiya na magana mahahu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
      ]
