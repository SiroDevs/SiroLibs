              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Alawi taaolangirwe phamwenga na zira mbari zanjina, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
            ]
          }
        },
        {
          "name": "verse",
