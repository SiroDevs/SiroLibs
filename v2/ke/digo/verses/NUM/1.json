              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinya ndio hara atu arioolangbwa ni Musa na Aruni phamwenga na vilongozi kumi na airi a Iziraeli. Chila chilongozi kala anawakilisha nyumba ya mkarewe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.44",
            "verseOrgIds": [
              "NUM.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
