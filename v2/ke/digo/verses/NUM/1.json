          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi jumula ya Aiziraeli osi oandikpwa kulengana na nyumba zao, a kuandzira miaka mirongo miiri na kpwenderera na ambao kala anaweza kuphiya vihani ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
            ]
          }
        },
