              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "kala ni atu elufu magana sita na tahu, magana matsano na mirongo mitsano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.46",
            "verseOrgIds": [
              "NUM.1.46"
            ]
