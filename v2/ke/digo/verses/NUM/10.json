              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi nyo Aiziraeli auka kula mwango wa Mwenyezi Mlungu na achiphiya charo cha siku tahu. Naro ro sanduku ra chilagane ra Mwenyezi Mlungu raatanguliya ili rikaalorere phatu pha kuoya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati ariphovundza kambi na kuuka wakati wa mutsi ro ingu ra Mwenyezi Mlungu rakala ri dzulu yao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        }
      ]
    },
