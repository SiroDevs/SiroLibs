          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na chilongozi wa kundi ra mbari ya Nafutali kala ni Ahira mwana wa Enani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        }
      ]
    },
    {
