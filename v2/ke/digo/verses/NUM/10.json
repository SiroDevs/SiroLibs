          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okala a mwisho kuvundza kambi kala ni makundi ga kambi ya Dani tsini ya bendera yao. Na chilongozi wa kundi ya mbari ya Dani kala ni Ahiezeri mwana wa Amishadai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chilongozi wa kundi ra mbari ya Asheri kala ni Pagieli mwana wa Okirani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
