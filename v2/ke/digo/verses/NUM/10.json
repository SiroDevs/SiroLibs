          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha atu a mryango wa Kohathi achiuka kuno akatsukula miyo mitakatifu; ro hema kala ni richitwe kabila taadzangbwefika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        }
      ]
