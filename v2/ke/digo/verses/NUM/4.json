          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe undaandikisha atu osi a kuandzira miaka mirongo mihahu hadi miaka mirongo mitsano, osi awezao kuhenda kazi za hema ra mkpwutano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
