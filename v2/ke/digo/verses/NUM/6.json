          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gomba na Aruni na anae, ‘Uaambire, mundabariki Aiziraeli hivi, mundaambira,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
