              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hala Aruni na mwanawe Eliazari, uambuke nao mwango wa Hori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.25",
            "verseOrgIds": [
              "NUM.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha, mvule Aruni nguwoze za ulavyadzi-sadaka na umvwise mwanawe Eliazari, mana Aruni andafwa kuko.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.26",
            "verseOrgIds": [
              "NUM.20.26"
            ]
          }
        }
