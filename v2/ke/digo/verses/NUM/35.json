          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msiitiye najisi tsi msagalayo, mana ko kuolaga kunaihenda yo tsi ikale najisi na takuna sadaka yoyosi iwezayo kutakasa tsi isiphokala ya ye achiyeolaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
