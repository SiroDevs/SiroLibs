              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ye achiyeolaga wakati wowosi achituluka kondze ya nyo mudzi ariouchimbirira, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
            "verseOrgIds": [
              "NUM.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ye alondaye kuriphiza chisasi amuone kondze ya nyo mudzi wa kuchimbirira na amuolage, iye kandakala na makosa ga kumuolaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.27",
            "verseOrgIds": [
              "NUM.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ye achiyeolaga ni asale ndani ya mudzi wa kuchimbirira hadi mlavyadzi-sadaka mkpwulu afwe ndipho auye kpwao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        }
      ]
