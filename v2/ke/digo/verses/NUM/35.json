          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msikubali kuhala kore kpwa kukombola roho ya achiyeolaga ariyehukumiwa kuolagbwa. Mutu hiye ni aolagbwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
