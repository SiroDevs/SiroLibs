        "sid": "NUM 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achigomba na Musa achimuamba, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Huma atu, chilongozi mmwenga kahi ya chila mbari, aphiye akapeleleze tsi ya Kanani, ambayo nindaapha Aiziraeli,” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Musa achiahuma kula jangbwa ra Parani dza Mwenyezi Mlungu arivyomlagiza. Osi kala ni akulu a Aiziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3",
            "verseOrgIds": [
              "NUM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na higa ndigo madzina ga nyo atu: Shamua mwana wa Zakuri, kula mbari ya Rubini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.4",
            "verseOrgIds": [
              "NUM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shafati mwana wa Hori, kula mbari ya Simioni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.5",
            "verseOrgIds": [
              "NUM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu mwana wa Jefune, kula mbari ya Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.6",
            "verseOrgIds": [
              "NUM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igali mwana wa Yusufu, kula mbari ya Isakari, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.7",
            "verseOrgIds": [
              "NUM.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshea mwana wa Nuni, kula mbari ya Efuraimu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.8",
            "verseOrgIds": [
              "NUM.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paliti mwana wa Rafu, kula mbari ya Benjamini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.9",
            "verseOrgIds": [
              "NUM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadieli mwana wa Sodi, kula mbari ya Zabuloni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.10",
            "verseOrgIds": [
              "NUM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadi mwana wa Susi, kula mbari ya Yusufu, yani mbari ya Manase, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.11",
            "verseOrgIds": [
              "NUM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amieli mwana wa Gemali, kula mbari ya Dani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.12",
            "verseOrgIds": [
              "NUM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sethuri mwana wa Mikaeli, kula mbari ya Asheri, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.13",
            "verseOrgIds": [
              "NUM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabi mwana wa Wofusi, kula mbari ya Nafutali, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.14",
            "verseOrgIds": [
              "NUM.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geueli mwana wa Maki, kula mbari ya Gadi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.15",
            "verseOrgIds": [
              "NUM.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ariphoahuma nyo atu kpwendaipeleleza tsi ya Kanani, waambira, “Ambukani kutsupira uphande wa mwakani wa tsi ya Kanani na mphiye uphande wa vurini kuriko na vidzango. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.17",
            "verseOrgIds": [
              "NUM.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiyani mkailole yo tsi vyo irivyo. Mlole hinyo atu asagalao himo ichikala ana mkpwotse hebu taana, ichikala ni anji au ni achache. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.18",
            "verseOrgIds": [
              "NUM.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ichikala yo tsi asagalayo ni nono au ni mbii, na ichikala yo midzi asagalayo yadzengerwa ngome au taidzengererwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.19",
            "verseOrgIds": [
              "NUM.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piya mmanye ichikala mtsanga wa yo tsi ni mnono au si mnono, napho kuna mihi au takuna. Hendani dzulu tsini mrehe seemu ya matunda ga yo tsi.” Uho wakala ni wakati wa zabibu za mwandzo-mwandzo kuivwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi nyo atu aambuka na achendaipeleleza yo tsi kula jangbwa ra Sini ririro uphande wa mwakani hadi Rehobu iriyo uphande wa vurini, phephi na phatu pha kumenyera Hamathi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.21",
            "verseOrgIds": [
              "NUM.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho aambuka kutsupira uphande wa mwakani wa tsi ya Kanani hadi achifika Heburoni, phatu phariphosagala atu a chivyazi cha Anaki yani Ahimani, Sheshai na Talimai. (Mudzi wa Heburoni kala ukadzengbwa miaka sabaa kabila mudzi wa Soani kudzengbwa ko Misiri.) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.22",
            "verseOrgIds": [
              "NUM.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariphofika Dete ra Eshikoli, achikata phungo rokala na lihungo kulu ra zabibu naro richitsukulwa dzulu ya gongo ni atu airi. Piya achitsukula makomamanga na tini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.23",
            "verseOrgIds": [
              "NUM.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pho phatu phaihwa Dete ra Eshikoli,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:24",
              "type": "text"
            },
            {
              "text": "Eshikoli",
              "type": "text"
            },
            {
              "text": "Chieburania ni lihungo ra zabibu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kpwa sababu ya ro lihungo ririrokatwa phapho ni nyo apelelezi a Iziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "O apelelezi auya bada ya kuipeleleza yo tsi kpwa muda wa siku mirongo mine.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.25",
            "verseOrgIds": [
              "NUM.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.25",
            "verseOrgIds": [
              "NUM.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo apelelezi auya kpwa Musa, Aruni na mkpwutano wa Aiziraeli osi hiko Kadeshi kahi ya jangbwa ra Parani. Phapho aasemurira phamwenga na nyo mkpwutano wosi na achiaonyesa go matunda ga yo tsi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.26",
            "verseOrgIds": [
              "NUM.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao achimuambira Musa, “Hwafika yo tsi uriyouhuma hukaipeleleze, na huchendaipeleleza. Tsi iyo ni nono na i tele maziya na asali",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.27",
            "verseOrgIds": [
              "NUM.13.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:27",
              "type": "text"
            },
            {
              "text": "Tsi ya maziya na asali manaye ni tsi yenye rutuba.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hata higa ndigo bazi ya matundage. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.27",
            "verseOrgIds": [
              "NUM.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nyo atu asagalao kuko ana mkpwotse na yo midzi yao ni mikulu na yadzengerwa ngome. Phamwenga na gago huchiona atu a chivyazi cha Anaki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.28",
            "verseOrgIds": [
              "NUM.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamaleki anasagala uphande wa mwakani mwa tsi ya Kanani, na Ahiti, Ajebusi na Aamori anasagala seemu zenye vidzango. Akanani nao anasagala phephi na bahari na kanda-kanda ya muho Joridani.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Kalebu achiahuriza nyo atu mbere za Musa achiamba, “Nahuambukeni hukaihale yo tsi, mana kpwa kpweli huna uwezo wa kuiturya.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.30",
            "verseOrgIds": [
              "NUM.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
