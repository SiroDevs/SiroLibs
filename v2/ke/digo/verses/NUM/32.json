                "loc": "JOS.1.12+JOS.1.13+JOS.1.14+JOS.1.15"
              },
              "items": [
                {
                  "text": "Joshuwa 1:12–15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Musa achilavya malagizo kpwa mlavyadzi-sadaka Eliazari, Joshuwa mwana wa Nuni na vilongozi a mbari za Aiziraeli kuhusu nyo atu a Gadi na a Rubini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.28",
            "verseOrgIds": [
              "NUM.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa achiambira, “Ichikala atu a Gadi na a Rubini andavuka Joridani phamwenga namwi kuno ana silaha zao na Mwenyezi Mlungu akuhendeni muashinde atu a tsi iyo, phahi mundaapha tsi ya Giliadi ikale yao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.29",
            "verseOrgIds": [
              "NUM.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ichikala taandagbwira silaha zao na kuvuka phamwenga namwi, ni aphahe mtalo wao phamwenga namwi kahi za tsi ya Kanani.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.30",
            "verseOrgIds": [
              "NUM.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a Gadi na a Rubini achiamba, “Swiswi atumishio hundahenda dza Mwenyezi Mlungu arivyoamba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundahala silaha huvuke Mwenyezi Mlungu achihulongoza kuinjira Kanani, ela seemu ya urisi wehu indakala kahi za ngʼambo ihi ya Joridani.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Musa achiapha atu a mbari ya Gadi na ya Rubini, na nusu ya atu a mbari ya Manase mwana wa Yusufu, ufalume wosi wa Sihoni, mfalume wa Aamori na wa Ogi, mfalume wa Bashani, tsi yao, midzi yao na seemu zirizokala zikaizunguluka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a Gadi achidzenga tsona midzi ya Diboni, Atarothi, Aroeri, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
              "NUM.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atirothi-Shofani, Jazeri, Jogibeha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bethi-Nimura na Bethi-Harani, midzi yenye ngome; chisha achidzenga vyaa vya mangʼondzi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a Rubini achidzenga tsona midzi ya Heshiboni, Eleale, Kiriathaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebo na Baali-Meoni (madzina ga midzi ihi gagaluzwa), na Sibuma. Midzi ariyoidzenga tsona achiipha madzina.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a chivyazi cha Makiri mwana wa Manase achiphiya Giliadi, achendaiteka na achiazola Aamori ariokala himo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Musa achiapha yo tsi ya Giliadi atu a chivyazi cha Makiri mwana wa Manase, nao achisagala mumo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jairi kula chivyazi cha Manase achendahala mateka vidzidzi vya Giliadi na achivigaluza dzina achiviiha Havothi-Jairi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Noba achendateka mudzi wa Kenathi na vidzidzivye na achiuiha Noba, dzinare mwenye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
      ]
    }
