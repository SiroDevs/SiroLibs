                {
                  "text": "Misemo 11:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Higa ganagbwa sawa na Maandiko gaambago kukala:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
