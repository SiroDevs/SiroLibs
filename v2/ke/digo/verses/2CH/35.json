              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo gosi ga Josiya chigosala, phamwenga na mahendoge manono ambago wahenda sawa-sawa na shariya ya Mwenyezi Mlungu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
