          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Josiya warema kukubali maneno ga Neko dzagbwe kala gala kpwa Mlungu! Hipho ye wadzibadilisha ili asimanyikane na achendapigana na Neko hiko Dete ra Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        }
      ]
