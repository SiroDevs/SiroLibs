            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.25.1"
              },
              "items": [
                {
                  "text": "1 Nyakati 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa sharee hizo, Alawi aatayarishira nyama za Pasaka avwinadzi na arindzi ambao kala ni Alawi a chivyazi cha Asafu ili aweze kukala kpwenye mazuma gao, sawa-sawa na arivyolagiza Daudi, Asafu, Hemani na Jeduthuni, muonadzi wa mfalume. Hata arindzi a maryango ga Nyumba ya kuvoya Mlungu taayahitaji kuricha mazuma gao kpwa mana a tayarishirwa nyama zao za Pasaka ni ndugu zao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
