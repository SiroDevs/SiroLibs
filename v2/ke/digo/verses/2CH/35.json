            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi siku iyo Pasaka yasherekeywa kumuishimu Mwenyezi Mlungu na achilavirwa sadaka za kuochwa dzulu ya phatu pha kulavira sadaka Mwenyezi Mlungu sawa-sawa na amuri ya mfalume Josiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13+EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kutsama 12:1–20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hinyo atu a Iziraeli ambao kala a hipho Jerusalemu kpwa Pasaka, chisha asherekeya sikukuu ya mikahe isiyotiywa hamira kpwa muda wa siku sabaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        }
      ]
    },
