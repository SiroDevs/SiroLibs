              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takuna Pasaka yosherekewa dza iyo ko Iziraeli hangu wakati wa nabii Samueli. Takuna hata mmwenga wa nyo afalume a Iziraeli, ambaye wausa Pasaka dza iyo iriyouswa ni Josiya, alavyadzi-sadaka, Alawi, atu osi a Juda na osi a Iziraeli, ariokala phapho, na nyo atu asagalao Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasaka ihi yasherekewa mwaka wa kumi na nane wa utawala wa mfalume Josiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        }
      ]
    },
