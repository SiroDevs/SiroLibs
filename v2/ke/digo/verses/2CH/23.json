      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
            "verseOrgIds": [
              "2CH.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha akulu a vikosi vya anajeshi gana-gana, akulu, vilongozi a majimbo na atu osi a yo tsi achitserera na ye mfalume kula kpwenye nyumba ya Mwenyezi Mlungu. Aho achitsupira ryango riihwaro ryango ra dzulu hadi achiinjira nyumbani kpwa mfalume. Nao achimsagika ye mfalume dzulu ya chihi cha endzi cha chifalume. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.20",
            "verseOrgIds": [
              "2CH.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo, atu osi ahamirwa na mudzi wosi uchihurira, bada ya Athalia kuolagbwa na upanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.21",
            "verseOrgIds": [
              "2CH.23.21"
            ]
          }
        }
      ]
    }
