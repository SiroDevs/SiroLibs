              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Kumbukumbu 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Farasi a Selemani nao arehwa kula Misiri na kula tsi zosi zanjina.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
