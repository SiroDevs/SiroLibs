        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jothamu wahenda garigo sawa mbere za Mwenyezi Mlungu, dza vira ise Uziya arivyohenda, isiphokala ye kaphihire kpwendafukiza uvumba ndani ya Nyumba ya kuvoya Mlungu dza ise arivyohenda. Ela atu a Juda aenderera kuhenda mai.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
