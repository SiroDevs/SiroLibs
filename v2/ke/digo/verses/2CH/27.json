        },
        {
          "text": "Jothamu kala ana miaka mirongo miiri na mitsano ariphokala mfalume wa Juda naye watawala kpwa miaka kumi na sita ko Jerusalemu. Nine kala anaihwa Jerusha, mwana mchetu wa Sadoki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.1",
            "verseOrgIds": [
              "2CH.27.1"
            ]
          }
        }
