          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiye ndiye ariyedzenga hiro ryango riihwaro Ryango ra Dzulu ra iyo nyumba ya Mwenyezi Mlungu na achihenda kazi kulu zaidi katika kudzenga ukuta hiko mwango wa Ofeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha wadzenga midzi hiko tsi ya myango ya Juda na achidzenga ngome na minara hiko matsakani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        }
      ]
    },
    {
