          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jothamu waenderera kumtii Mwenyezi Mlungu naye achikala mfalume mwenye nguvu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
