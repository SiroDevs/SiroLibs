                "loc": "EXO.13.21+EXO.13.22"
              },
              "items": [
                {
                  "text": "Kutsama 13:21–22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.22+EXO.14.23+EXO.14.24+EXO.14.25+EXO.14.26+EXO.14.27+EXO.14.28+EXO.14.29"
              },
              "items": [
                {
                  "text": "14:22–29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Enehu, nalonda nikutambukizeni kukala akare ehu osi akala tsini ya ingu na osi achitsupato kahi-kahi ya bahari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osi abatizwa tsini ya rira ingu na hira bahari, nao achikala afuasi a Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.35"
              },
              "items": [
                {
                  "text": "Kutsama 16:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Osi arya chakurya chimwenga cha chiroho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.3",
            "verseOrgIds": [
              "1CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.6"
              },
              "items": [
                {
                  "text": "Kutsama 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.11"
              },
              "items": [
                {
                  "text": "Isabu 20:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na osi anwa madzi mamwenga ga chiroho. Mana anwa madzi ga dziwe ra chiroho ambaro kala richialunga-lunga, na dziwe hiro kala ni Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
            "verseOrgIds": [
              "1CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.29+NUM.14.30"
              },
              "items": [
                {
                  "text": "Isabu 14:29–30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela Mlungu kayahamirwa bii ni anji a atu hinyo, kpwa hivyo afwa na miri yao ichienea hiko weruni.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
