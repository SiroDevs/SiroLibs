            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26+GEN.1.27"
              },
              "items": [
                {
                  "text": "Mwandzo 1:26–27",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa mana mlume kafwaha kudzifwinika chitswa,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:7",
              "type": "text"
            },
            {
              "text": "Mana yanjina ni:",
              "type": "text"
            },
            {
              "text": "mlume kafwaha kukala na nyere nyire.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mana ndiye mfwano na nguma ya Mlungu, ela mchetu ni nguma ya mlume. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.18+GEN.2.19+GEN.2.20+GEN.2.21+GEN.2.22+GEN.2.23"
              },
              "items": [
                {
                  "text": "Mwandzo 2:18–23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana mlume kayaumbwa kula kpwa mchetu, ela mchetu waumbwa kula kpwa mlume. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.8",
            "verseOrgIds": [
              "1CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mlume kayaumbwa kpwa sababu ya mchetu, ela mchetu waumbwa kpwa sababu ya mlume. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.9",
            "verseOrgIds": [
              "1CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo mchetu ni adzifwinike chitswa kuonyesa kala a tsini ya mamlaka. Chisha ni ahende vivyo kpwa sababu ya malaika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.10",
            "verseOrgIds": [
              "1CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela kpwa kuungana na Bwana Jesu, alume na achetu osi ni muhimu, nao mmwenga kaweza kuishi bila ya myawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.11",
            "verseOrgIds": [
              "1CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mchetu wa kpwandza wala kpwa mlume, na kula hipho hata vivi sambi alume anavyalwa ni achetu. Na vitu vyosi vila kpwa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi ririkanani enye, ichikala ni sawa mchetu kuvoya Mlungu bila ya kudzifwinika chitswa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.13",
            "verseOrgIds": [
              "1CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata mila yehu inahukahaza mlume kukala na nyere nyire, mana nkudzitiya waibu ye mwenye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.14",
            "verseOrgIds": [
              "1CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela mchetu nkutogolwa achikala na nyere nyire, kpwa mana wahewa nyere nyire ili zimfwinike. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.15",
            "verseOrgIds": [
              "1CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichikala mutu analonda kulumba kuhusu dzambo hiri, phahi naamanye kala swiswi na makundi gosi ga atu a Mlungu tahuna mila yanjina.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhusu gaga malagizo nilondago kukuphani, sikutogolani kpwa sababu mikutano yenu inareha matatizo badala ya fwaida. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.17",
            "verseOrgIds": [
              "1CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwandzo atu aniambira kala munapingana munaphokutana, ndiyo mana munaganyana madiba-madiba. Nami nchigapima naona kuna chiasi fulani cha ukpweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.18",
            "verseOrgIds": [
              "1CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ni lazima atu aganyane ili hara ariokubaliwa ni Mlungu amanyikane wazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.19",
            "verseOrgIds": [
              "1CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwimwi munaphokutana si kpwa lengo ra kurya chakurya cha Bwana Jesu bii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.20",
            "verseOrgIds": [
              "1CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana wakati wa kurya, chila mmwenga nkuandza kurya chivyakpwe bila ya kugodzana, hata mwisho anjina akasala na ndzala na kuno anjina nao akalewa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.21",
            "verseOrgIds": [
              "1CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waibu! Kpwani tamuna nyumba ambazo munaweza kurya na kunwa? Hebu mnalonda kubera atu a Mlungu na kuaibisha atu asio na chitu? Kpwa kpweli mambo muhendago tagaweza kunihenda nikutogoleni hata chidide.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa mana malagizo higa ni garatu nrigophokera kula kpwa Bwana Jesu na nchikuphani. Usiku hura ambao kala andasalatwa, wahala mkpwahe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bada ya kumshukuru Mlungu, wamega-mega hura mkpwahe na achiamba, “Huno ni mwiri wangu ulaviwao kpwa ajili yenu. Kalani muchihenda hivi ili mkale mchinitambukira.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
