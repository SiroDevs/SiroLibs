            "sid": "NEH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi nyo vilongozi a atu kala anasagala Jerusalemu na nyo atu anjina apiga kura kahi ya chila atu kumi ili arehe mutu mmwenga aishi kahi ya mudzi mtakatifu wa Jerusalemu na nyo anjina tisiya ariosala asagale kpwenye yo midzi yanjina. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao atu achiabariki atu osi ariokubali kpwendasagala Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
