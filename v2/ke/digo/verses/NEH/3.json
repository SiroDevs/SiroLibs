            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ryango ra Deteni rarekebishwa ni Hanuni phamwenga na atu a Zanoa. Aridzenga luphya na achiritiya miryangoye, tumbuu na magbwama. Piya achirekebisha seemu ya ukuta yenye ure wa kama mita magana matsano hadi kufikira Ryango ra Chitole.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ryango ra Chitole rarekebishwa ni Malikija, mwana wa Rekabu, chilongozi wa wilaya ya Bethi-Hakeremu. Warirekebisha, achiritiya miryangoye, tumbuu na magbwama.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ryango ra Pula ya Madzi rarekebishwa ni Shalumu mwana wa Kolihoze, chilongozi wa wilaya ya Mizipa. Iye waridzenga luphya, achiridzengera paa na achiritiya miryango, tumbuu na magbwama. Chisha achirekebisha ukuta wa birika ra madzi ra Shela, kanda ya Bustani ya mfalume na kufikira ngazi zitsererazo kula Mudzi wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:15",
              "type": "text"
            },
            {
              "text": "Mudzi wa Daudi",
              "type": "text"
            },
            {
              "text": "ni seemu ndide ya Jerusalemu iriyo uphandewe wa mwakani ambayo yadzengbwa madzumba ga chifalume, na nyumba ya kuvoya Mlungu ya Selemani.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu ya ukuta yolungira kuelekezana na vikurani pha Daudi hadi dimbwi rohenda tsimbwa, hadi nyumba ya masujaa, yarekebishwa ni Nehemia mwana wa Azibuki, chilongozi wa nusu ya wilaya ya Bethi-Suri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu yolungira yarekebishwa ni Alawi tsini ya ulongozi wa Rehumu mwana wa Bani, na Hashabia, chilongozi wa nusu wilaya ya Keila, achirekebisha seemu yolungira kpwa niaba ya wilayaye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu yolungizira yarekebishwa ni Alawi ayawao ariokala tsini ya ulongozi wa Binui mwana wa Henadadi, chilongozi wa nusu yanjina ya wilaya ya Keila. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu yolungira yokala inalolana na nyumba ya kuikira silaha za viha, yarekebishwa ni Ezeri mwana wa Jeshuwa chilongozi wa Mizipa, kpwenderera hadi pho pembe ya ukuta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu yolungira kula pho pembe ya nyo ukuta hadi mryango wa nyumba ya mlavyadzi-sadaka mkpwulu, Eliashibu, yarekebishwa kpwa chadi ni Baruku mwana wa Zabai. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
              "NEH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu yolungira kula mryango wa nyumba ya Eliashibu hadi mwisho wa nyumba iyo yarekebishwa ni Meremothi mwana wa Uriya, mdzukulu wa Hakozi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu zolungira zarekebishwa ni alavyadzi-sadaka ariokala anasagala maeneo ga kugbwirana na Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu yolungira yarekebishwa ni Benjamini na Hashubu, nayo kala i mbere ya nyumba zao. Iriyolungira yarekebishwa ni Azaria mwana wa Maaseya, mdzukulu wa Anania nayo kala i kanda-kanda ya nyumbaye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
