              "items": [
                {
                  "text": "Kumbukumbu 26:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hunahala jukumu ra kureha malimbuko ga mavuno gehu na ga matunda ga chila muhi nyumbani mwa Mwenyezi Mlungu chila mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
