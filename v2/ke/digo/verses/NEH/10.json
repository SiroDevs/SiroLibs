        },
        {
          "text": "“Tsona hundahala jukumu ra kulavya kama giramu ne za feza chila mwaka kpwa utumishi wa nyumba ya Mlungu wehu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kpwa ajili ya mabofulo matakatifu, sadaka ya chila siku ya unga, sadaka ya kuochwa ya chila siku, sadaka ya Siku ya Kuoya, sikukuu za kulumbwa kpwa mwezi, sadaka za sikukuu na vitu vitakatifu na sadaka za kuusa dambi za kupatanisha Aiziraeli na Mlungu, na utu wowosi wanjina unaolondwa kpwenye nyumba ya Mlungu wehu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        }
