                "loc": "DEU.23.3+DEU.23.4+DEU.23.5"
              },
              "items": [
                {
                  "text": "Kumbukumbu 23:3–5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo, chitabu cha Musa chasomwa nao atu achiphundza vinono sana. Katika cho chitabu muchionewa kukala vyaandikpwa kukala Muamoni na Mmoabu ni asiinjire kpwenye mkpwutano wa Mlungu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.1",
            "verseOrgIds": [
              "NEH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.1+NUM.22.2+NUM.22.3+NUM.22.4+NUM.22.5+NUM.22.6"
              },
              "items": [
                {
                  "text": "Isabu 22:1–6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kpwa sababu taayatsangira Aiziraeli na chakurya na madzi ariphokala akatuluka kula Misiri, ela amkodisha Balaamu ili alani Aiziraeli, naye Mlungu wehu achiigaluza yo lana ichikala baraka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwedzasikira shariya ihi, Aiziraeli atenga atu ambao kala si Ayahudi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabila ya gaga kuhendeka, Eliashibu, mlavyadzi-sadaka ariyetsambulwa aimirire vyumba vya akiba za nyumba ya Mlungu wehu, kpwa mana kala ana uhusiano wa phephi na Tobia, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.4",
            "verseOrgIds": [
              "NEH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wamupha Tobia chumba chikulu ambacho kala chichihumirwa kuikira mitsango kpwa ajili ya alavyadzi-sadaka phamwenga na sadaka ya mtsere, ubani, miyo ya nyumba ya kuvoya Mlungu, na mafungu ga kumi ga mtsere, uchi na mafuha ambago galagizwa gahewe Alawi, aimbadzi na arindzi a maryango.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.5",
            "verseOrgIds": [
              "NEH.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.5",
            "verseOrgIds": [
              "NEH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati gaga gosi ganahendeka, mimi nákala si Jerusalemu, mana katika mwaka wa mirongo mihahu na mbiri wa utawala wa Aritashasita mfalume wa Babeli náuya kpwa mfalume. Bada ya muda nchimvoya tsona ruhusa ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.6",
            "verseOrgIds": [
              "NEH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nchiuya Jerusalemu. Nami nchiona uyi uhu ambao Eliashibu kala akauhenda wa kumupha chumba Tobia kahi ya mihala ya nyumba ya Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.7",
            "verseOrgIds": [
              "NEH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nátsukirwa sana, nchihala yo miyo yosi ya Tobia nchiitsupha kondze ili ituluke mo chumbani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.8",
            "verseOrgIds": [
              "NEH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchilagiza atu avitsukutse vyo vyumba, chisha nchiiuyiza yo miyo ya nyumba ya Mlungu, phamwenga na sadaka za mtsere na ubani.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
