            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.18",
            "verseOrgIds": [
              "NEH.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo wakati kala kunaandza jiza kpwenye maryango ga Jerusalemu kabila ya Siku ya Kuoya kuandza, nálagiza kukala maryango gosi gafungbwe na gasivugulwe hadi Siku ya Kuoya itsupe. Naika bazi ya atumishi angu mo maryangoni ili asiruhusu mzigo wowosi urehwe Siku ya Kuoya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.19",
            "verseOrgIds": [
              "NEH.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela kano mbiri tahu, ahendadzi-bishara ariokala achiguza vitu vya chila aina achesa kondze ya Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.20",
            "verseOrgIds": [
              "NEH.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchiakanya nchiaambira, “Kpwa utu wani munalala kondze? Muchihenda hivyo tsona ndakugbwirani.” Phahi kula siku iyo taaedzere tsona Siku ya Kuoya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.21",
            "verseOrgIds": [
              "NEH.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.21",
            "verseOrgIds": [
              "NEH.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchilagiza Alawi adzitakase, edze arinde go maryango ili aihende Siku ya Kuoya isitiywe najisi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitambukira kpwa gaga nago ee Mlungu wangu, kulengana na ukulu wa mendzwayo isiyosika.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
          }
        }
      ]
    },
