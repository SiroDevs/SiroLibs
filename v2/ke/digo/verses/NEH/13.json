            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Malaki 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho atu osi a Juda achireha mafungu gao ga kumi ga mtsere, uchi na mafuha kpwenye vyumba vya kuikira vitu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.12",
            "verseOrgIds": [
              "NEH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchimuika mlavyadzi-sadaka Shelemia, muandishi Sadoki na Mlawi ariyeihwa Pedaya aimirire vyumba vya kuikira vitu na nchimuhenda Hanani mwana wa Zakuri, mdzukulu wa Matania akale msaidizi wao. Kpwa mana atu aha kala ni atu a kukuluphirika, achihewa kazi ya kuaganyira vyakurya ndugu zao.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
