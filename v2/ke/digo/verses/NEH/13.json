          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitambukira ee Mlungu wangu kpwa sababu ya gaga. Usigayale go manono nrigogahenda kpwa ajili ya nyumbayo na utumishiwe ee Mlungu wangu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        }
      ]
    },
    {
