              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10+1CO.7.11"
              },
              "items": [
                {
                  "text": "1 Akorintho 7:10–11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mutu arichaye mchewe akalóla mchetu wanjina, nkukala anazinga, na mutu alólaye mchetu yerichwa ni mlumewe, nkukala anazinga.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        }
