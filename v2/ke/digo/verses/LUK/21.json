                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.7"
              },
              "items": [
                {
                  "text": "Ezekieli 32:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.31"
              },
              "items": [
                {
                  "text": "Joeli 2:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12"
              },
              "items": [
                {
                  "text": "Maono 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Kundakala na vituko vya dzuwa, mwezi na nyenyezi. Himu duniani, atu anjina andakala na tabu sana na kuangalala kpwa sababu ya mngurumo wa maimbi makulu ga bahari. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu andafwa purungire kpwa wuoga, na kuririkana higo gedzago himu duniani, mana nguvu za dzulu mlunguni zindasumbiswa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Danieli 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Maono 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipho atu ndiphoniona mimi, Mutu Yela Mlunguni, nchitsembuka inguni kpwedza na nguvu na utukufu munji. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo higa gachiandza kuonekana, hererwani na msifwe moyo, mana mu phephi na kukombolwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Jesu walavya mfwano, achiamba, “Lolani mtini na mihi yanjina. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchiiona inatula, mkumanya wakati wa kuvuna u phephi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwimwi namwi mchiona mambo higa ganahendeka, manyani kukala ufalume wa Mlungu u phephi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.31",
            "verseOrgIds": [
              "LUK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nakuambirani kpweli, chivyazi hichi tachindasira kufwa kabila ya mambo higa gosi kuhendeka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzulu mlunguni na dunia kundasika, ela maneno gangu tagana mwisho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dzimanyirireni sedze mkavwererwa ni kurya kunji, kulewa, na shuuli za maisha, ama siku ya mwisho indakpwedzakugbwirani gafula ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "dza muhego. Kpwa mana siku iyo indakpwedza kpwa atu osi duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo Kalani matso wakati wosi, na mvoye ili mphahe nguvu za kugatsupira mambo gago ndigohendeka, tsona muweze kuima mbere za ye Mutu Yela Mlunguni.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.36",
            "verseOrgIds": [
              "LUK.21.36"
            ]
          }
        }
      ]
    },
