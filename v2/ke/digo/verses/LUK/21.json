                  "text": "Luka 19:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi chila siku, namutsi Jesu kala achifundza atu ndani ya Nyumba ya Kuvoya Mlungu na dziloni kala achiphiya Mwango wa Mizaituni achalala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligundzu chiti atu osi kala achiphiya Nyumba ya Kuvoya Mlungu achamphundza Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
