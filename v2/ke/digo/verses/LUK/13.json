            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.31"
              },
              "items": [
                {
                  "text": "Mariko 10:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakika, kuna atu ambao ni a mwisho ambao andakala a mwandzo, na ambao ni a mwandzo vi sambi andakala a mwisho.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        }
