              },
              "items": [
                {
                  "text": "Zaburi 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela naye andaamba, ‘Sikumanyani tse. Niukirani hipha mwi atu ayi!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.27",
            "verseOrgIds": [
              "LUK.13.27"
            ]
          }
        },
