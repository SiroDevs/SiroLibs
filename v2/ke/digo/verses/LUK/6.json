                  "text": "Mathayo 10:24–25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.16"
              },
              "items": [
                {
                  "text": "Johana 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.20"
              },
              "items": [
                {
                  "text": "15:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanafundzi kamshinda mwalimuwe, ela mwanafundzi achimala masomoge vinono, andakala dza mwalimuwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        }
