              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kpwa utu wani unalola chifusi dzitsoni mwa myao, ela kuona boriti ndzima iriyo mwako dzitsoni? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.41",
            "verseOrgIds": [
              "LUK.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unawezadze kumuamba myao, ‘Hebu mwenehu, nikuuse chifusi mwako dzitsoni,’ kuno we mwenye kuona boriti ndzima mwako dzitsoni? Munafiki we! Andza kutuluza boriti iriyo mwako dzitsoni, ndipho undaona vinono hata utuluze chifusi chiricho dzitsoni mwa myao.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
