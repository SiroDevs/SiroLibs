            "number": "27",
            "style": "v",
            "sid": "LUK 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.38"
              },
              "items": [
                {
                  "text": "Mathayo 10:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.24"
              },
              "items": [
                {
                  "text": "16:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.34"
              },
              "items": [
                {
                  "text": "Mariko 8:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.23"
              },
              "items": [
                {
                  "text": "Luka 9:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana asiyekala tayari kugaya na kunilunga, kaweza kukala mfuasi wangu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.27",
            "verseOrgIds": [
              "LUK.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.27",
            "verseOrgIds": [
              "LUK.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ela kabila ya kukala mfuasi wangu, ni lazima mwandzo umanye ichikala undaweza kuvumirira hadi mwisho. Kpwa mfwano, uchilonda kudzenga nyumba,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:28",
              "type": "text"
            },
            {
              "text": "Nyumba",
              "type": "text"
            },
            {
              "text": ": Neno hiri Chiyunani rina mana ya",
              "type": "text"
            },
            {
              "text": "nyumba nyire za gorofa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kpwandza ni lazima uhende isabu ya pesa urizo nazo ichikala zindatosha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana uchidzenga msingi macheye alafu uchishindwa ni kuimarigiza, atu andakutseka, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.29",
            "verseOrgIds": [
              "LUK.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "andaamba, ‘Lolani, mutu hiyu waandza kudzenga nyumba, vino inamshinda kumarigiza!’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.30",
            "verseOrgIds": [
              "LUK.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.30",
            "verseOrgIds": [
              "LUK.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ama, mfalume yeyesi achitaka kuphiya vihani, kupigana na mfalume wanjina, kpwandza ni lazima apime ichikala asikarie elufu kumi andaweza kupiga asikari elufu mirongo miiri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na achiona kaweza kupigana nao, analavya muhumwa wakati hara asikari anjina achere kure ili atake mapatano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, mutu yeyesi achitaka kukala mfuasi wangu, ni lazima akale tayari kuricha chila chitu aricho nacho.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.33",
            "verseOrgIds": [
              "LUK.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.33",
            "verseOrgIds": [
              "LUK.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona Jesu achiamba, “Munyu ni mzuri, ela uchibanangika taufwaha na tauweza kuhendwa ukafwaha tsona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taufwaha kuhendwa rorosi kabisa, kpwa hivyo ni wa kutsuphiwa. Phahi, atu ambao taandavumirira kukala afuasi angu ni dza munyu uriobanangika.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.35",
            "verseOrgIds": [
              "LUK.14.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:35",
              "type": "text"
            },
            {
              "text": "Chiyunani chinaamba",
              "type": "text"
            },
            {
              "text": "munyu ambao taufwaha kpwa mtsanga na hata kuhendwa mboleya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ariye na masikiro, naasikire.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.35",
            "verseOrgIds": [
              "LUK.14.35"
            ]
          }
        }
      ]
    }
