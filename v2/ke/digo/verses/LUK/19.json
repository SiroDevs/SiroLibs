            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chila siku Jesu kala achifundza ndani ya Nyumba ya Kuvoya Mlungu. Akulu a alavyadzi-sadaka, alimu a Shariya, na vilongozi aendza njira ya kumuolaga, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
