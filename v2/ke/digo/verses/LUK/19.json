          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela taayaweza, mana atu osi ammendza sana dza mwalimu wao na alonda kumphundza vinono na taatakire atsupwe ni neno hata mwenga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.48",
