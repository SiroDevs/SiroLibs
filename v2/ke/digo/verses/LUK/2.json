              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho, Jesu wauya kaya Nazareti na avyazie, na achikala anaaogopha. Ela nine wagaika rohoni mambo gosi higa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
