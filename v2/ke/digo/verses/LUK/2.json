              "items": [
                {
                  "text": "1 Samueli 2:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.4"
              },
              "items": [
                {
                  "text": "Misemo 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi, Jesu waenderera kukula chimo na achili, achizidi kumuhamira Mlungu na atu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
