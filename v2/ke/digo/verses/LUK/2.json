              "items": [
                {
                  "text": "Mathayo 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu na Maryamu ariphomala mambo gosi ambago kala ni agahende kulengana na Shariya za Mlungu, auya kaya, mudzi wa Nazareti, jimbo ra Galilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuya mwana wakula, achikala na nguvu na achili, na Mlungu achimjaliya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
