              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.17+MRK.6.18"
              },
              "items": [
                {
                  "text": "Mariko 6:17–18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Johana piya wamkanya mtawala Herode, mana kala akalóla Herodiya mkpwaza nduguye, na mambo ganjina mai manji ambago kala akahenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Herode wazidisha ubayawe kpwa kumtiya jela Johana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
    },
    {
