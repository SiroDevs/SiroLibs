          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabila ya higa Isaya kala akaamba, “Naahale gande ra tini aribandike pho iphuni, naye andaphola.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.21",
            "verseOrgIds": [
              "ISA.38.21"
            ]
          }
        }
      ]
    },
