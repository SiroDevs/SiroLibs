              "type": "text"
            }
          ]
        },
        {
          "text": "Higa ni maneno kuhusu nyama a tsakani ario tsi ya kugbwa, mwakani mwa Juda:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.6",
            "verseOrgIds": [
              "ISA.30.6"
