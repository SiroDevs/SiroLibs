                "loc": "ACT.28.26+ACT.28.27"
              },
              "items": [
                {
                  "text": "Mahendo 28:26–27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye achiniamba, “Phiya ukaambire atu hano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        }
      ]
    },
