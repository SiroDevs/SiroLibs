        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho nchiuza, “Ee Mwenyezi Mlungu, hadi rini?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
