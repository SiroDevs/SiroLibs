                "loc": "2CH.26.23"
              },
              "items": [
                {
                  "text": "2 Nyakati 26:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwaka ariofwerera mfalume Uziya námuona Mwenyezi Mlungu. Námuona akasagarira chihiche cha utawala chirichounulwa naye kala a dzulu sana. Pindo ra vwazire kala rikagota nyumba yosi ya kuvoya Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzuluye kala phakaima maserafi, chila mwenga kala rina mapha sita. Mairi ga kubwiningiza uso, mairi ga kubwiningiza magulu na mairi ga kuurukira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Maono 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi higo maserafi gagombekezana gachiamba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
