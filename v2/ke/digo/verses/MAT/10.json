                  "text": "Mariko 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atu osi andakuzirani kpwa sababu yangu. Ela ndiyevumirira hadi mwisho andaokolwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.22",
            "verseOrgIds": [
              "MAT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchiteswa ni atu a mudzi mmwenga, ukani mphiye mudzi wanjina. Mana nakuambirani kpweli tamundamala midzi yosi ya Iziraeli kabila ya mimi, Mutu Yela Mlunguni, kuuya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.23",
            "verseOrgIds": [
              "MAT.10.23"
            ]
          }
        }
