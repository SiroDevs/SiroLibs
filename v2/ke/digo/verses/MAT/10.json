                "loc": "LUK.10.3"
              },
              "items": [
                {
                  "text": "Luka 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Phundzani! Nakuhumani mphiye, namwi mundakala dza mangʼondzi gaphiyago kahi ya mabawa. Kpwa hivyo kalani erevu dza nyoka na a pole dza njiya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.16",
            "verseOrgIds": [
              "MAT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.9+MRK.13.10+MRK.13.11"
              },
              "items": [
                {
                  "text": "Mariko 13:9–11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.11+LUK.12.12"
              },
              "items": [
                {
                  "text": "Luka 12:11–12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.12+LUK.21.13+LUK.21.14+LUK.21.15"
              },
              "items": [
                {
                  "text": "21:12–15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dzimanyirireni na atu dza hinyo, mana andakuphirikani mkashitakiwe mbere ya vilongozi a chidini, na andakuchapani viboko ndani ya masinagogi gao. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.17",
            "verseOrgIds": [
              "MAT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwi mundagbwirwa mphirikpwe mbere za atawala na afalume kpwa sababu yangu, ili mphahe kunishuhudiya kpwa atu hinyo na atu asio kala Ayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.18",
            "verseOrgIds": [
              "MAT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na munaphogbwirwa na kuphirikpwa mbere zao, msitangetange ra kpwendagomba wala ndivyogomba. Gosi ga kugomba mundahewa wakati uchifika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.19",
            "verseOrgIds": [
              "MAT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa sababu si mwimwi mundiogomba, ela Roho wa Sowe yenu ariye mwenu mioyoni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.20",
            "verseOrgIds": [
              "MAT.10.20"
            ]
          }
        }
      ]
    },
