          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yeyesi ndiyedzimanyisa wazi mbere za atu kala ni mfuasi wangu, nami piya nindamkubali mbere za Baba ariye mlunguni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.32",
            "verseOrgIds": [
              "MAT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.12"
              },
              "items": [
                {
                  "text": "2 Timothi 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela ndiyenitsamalala mbere za atu, nami piya nindamtsamalala mbere za Baba ariye mlunguni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.33",
            "verseOrgIds": [
              "MAT.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
