                "loc": "LUK.11.15"
              },
              "items": [
                {
                  "text": "Luka 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi mwanafundzi naatosheke kukala dza mwalimuwe, na mtumishi dza tajiriwe. Ichikala mkpwulu wa nyumba anaihwa Belizebuli,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.25",
            "verseOrgIds": [
              "MAT.10.25"
            ]
          }
        },
        {
          "name": "note",
