            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.33"
              },
              "items": [
                {
                  "text": "17:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Johana 12:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutu amendzaye maishage himu duniani andaangamiza maishage ga kare na kare, ela aangamizaye maishage ga himu duniani kpwa sababu yangu, andagaokola.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.39",
            "verseOrgIds": [
