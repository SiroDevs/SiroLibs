            "caller": "#"
          },
          "items": [
            {
              "text": "10:25",
              "type": "text"
            },
            {
              "text": "Belizebuli",
              "type": "text"
            },
            {
              "text": "ni dzina ranjina ra",
              "type": "text"
            },
            {
              "text": "Shetani.",
              "type": "text"
            }
          ]
        },
        {
          "text": " dze hara atue, taandaihwa na madzina mai zaidi?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.25",
            "verseOrgIds": [
              "MAT.10.25"
            ]
          }
        }
