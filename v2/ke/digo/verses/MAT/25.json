              "items": [
                {
                  "text": "Luka 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana ariye na chitu na kuchihumira andaenjerezwa akale na vinji. Ela asiyehumira chitu chidide aricho nacho, hata chicho chindahalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.12"
              },
              "items": [
                {
                  "text": "Mathayo 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.13"
              },
              "items": [
                {
                  "text": "22:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.28"
              },
              "items": [
                {
                  "text": "Luka 13:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kuhusu mtumishi hiyu asiye na fwaida, mhaleni mukamtsuphe kondze jizani ambako andarira na kusaga meno.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        }
      ]
