            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Shaka hiro mwi alimu a Shariya na Mafarisayo, anafiki mwi! Mbona munatsukutsa vikombe na sahani kondze macheye, na ndani munakuricha kunaodzala unyangʼanyi na uchoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "We Mfarisayo chipofu! Amba tsukutsa chikombe ndani kpwandza nako kondze piya kundakala swafi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        }
      ]
    },
