                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Zaburi 118:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nakuambirani kukala, tamundaniona tsona hadi wakati ndiphokpwedzaamba, ‘Waajaliwa iye edzaye kpwa dzina ra Mwenyezi Mlungu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
