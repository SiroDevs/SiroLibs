              "items": [
                {
                  "text": "Alawi 27:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Shaka hiro mwi alimu a Shariya na Mafarisayo, anafiki mwi! Mkulavya fungu ra kumi ya chikatsu, iliki, na bizari nyembamba ambavyo ni vilungo bahi, na kuno munaricha haki, mbazi, na kuluphiro ambago ni mambo muhimu ga Shariya. Higo ndigo mlondwago kuhenda, bila ya kubera higo ganjina. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilongozi vipofu mwi! Mkutuluza indzi chikombeni, ela mkamiza ngamia mzima!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
