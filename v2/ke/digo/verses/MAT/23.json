            "number": "37",
            "style": "v",
            "sid": "MAT 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu waenderera kugomba, achiamba, “Ee maye, mwi atu a Jerusalemu! Mkuolaga manabii na kuapiga mawe ariohumwa kpwenu. Mara nyinji náaza kukuikani phamwenga dza kolo ra kuku rifwinikavyo anae mwakpwe maphani, ela mwi mwakahala! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.5"
              },
              "items": [
                {
                  "text": "Jeremia 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Haya phundzani, mkarichirwa mudzi wenu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:38",
              "type": "text"
            },
            {
              "text": "Mana yanjina ni",
              "type": "text"
            },
            {
              "text": "nyumba yenu ya kuvoya Mlungu",
              "type": "text"
            },
            {
              "text": "au",
              "type": "text"
            },
            {
              "text": "tsi yenu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " enye na vivi ni muhuphu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
