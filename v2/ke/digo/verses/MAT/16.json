              "items": [
                {
                  "text": "Arumi 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana mimi, Mutu Yela Mlunguni, ndakpwedza phamwenga na malaika angu. Ndakpwedza na utukufu ulao kpwa Baba. Na hipho ndipho ndiphomripha chila mmwenga kulengana na mahendoge. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
