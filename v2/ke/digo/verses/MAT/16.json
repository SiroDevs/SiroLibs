            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula wakati hinyo Jesu waandza kubisha na anafundzie chingʼangʼa, achiamba, “Ni lazima niphiye Jerusalemu ili nikateswe ni vilongozi a Chiyahudi, na akulu a alavyadzi-sadaka, na alimu a Shariya na niolagbwe ela siku ya hahu nindafufulwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.21",
            "verseOrgIds": [
              "MAT.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Petero wamuhala Jesu kanda achimdemurira achimuamba, “Bwana dzambo hiri tarindakuphaha.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jesu achimgalukira Petero, achimuamba, “Hebu niukira, Shetani wee! Unanizuwiya nisihende nilondwago nihende, mana maazogo ni ga chibinadamu bahi, sigo ga chimlungu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
          }
        }
      ]
