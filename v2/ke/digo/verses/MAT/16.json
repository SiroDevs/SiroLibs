          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana indafwahani mutu achiphaha utajiri wosi wa dunia ndzima, ela rohoye yiangamike? Ama mutu anaweza kulavya chitu chani chikale badili ya uzima? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
