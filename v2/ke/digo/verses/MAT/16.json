              "items": [
                {
                  "text": "Johana 12:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana yeyesi ndiyelonda kuokola maishage himu duniani andaangamiza maishage ga kare na kare, ela aangamizaye maishage ga himu duniani kpwa sababu yangu, andagaokola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
