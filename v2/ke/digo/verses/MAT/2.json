              "items": [
                {
                  "text": "Johana 1:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambako wakpwendasagala mudzi wa Nazareti. Gahendeka hivyo ili gara gogombwa ni manabii kuhusu Masihi gatimiye. Mana manabii aamba andaihwa Mnazareti.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.23",
