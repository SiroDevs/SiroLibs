          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafarisayo na akulu a alavyadzi-sadaka, ariphosikira hizo ndariraze, amanya kukala anagomba kuhusu aho, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "phahi alonda kumgbwira Jesu kpwa nguvu ili amutiye jela. Ela achiogopha atu mana aho kala anaamini kukala iye ni nabii.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
