              "items": [
                {
                  "text": "Zaburi 118:22–23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hipho Jesu waambira, “Hakika mnamanya Maandiko higa ga Mlungu gaambago:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
