          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa mana Hema ra Mwenyezi Mlungu ambaro Musa waritengeza hiko jangbwani na phara phatu pha kulavira sadaka za kuochwa, siku hizo kala zi pha phatu pha dzulu hiko Gibioni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
