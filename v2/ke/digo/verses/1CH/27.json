        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shitirai kula Sharoni watundza ngʼombe zoriswa hiko Sharoni. Shafati mwana wa Adilai watundza vyaa hiko madeteni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obili wa chivyazi cha Isimaili waimirira ngamia naye Jedeya wa kula mudzi wa Meronothi watundza punda achetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jazizi yekala Muhagari kala anaimirira makundi ga mangʼondzi. Hano osi kala ni aimirizi a mali za mfalume Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
