                {
                  "text": "2 Samueli 24:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.1+1CH.21.2+1CH.21.3+1CH.21.4+1CH.21.5+1CH.21.6+1CH.21.7+1CH.21.8+1CH.21.9+1CH.21.10+1CH.21.11+1CH.21.12+1CH.21.13+1CH.21.14"
              },
              "items": [
                {
                  "text": "1 Nyakati 21:1–14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Joabu mwana wa Seruya waandza kuaolanga ela kayaamala. Hata vivyo Mlungu watsukirwa, Aiziraeli achiphaha mashaka kpwa sababu ya dzambo hiro, kpwa hivyo jumula ya isabu taiyaandikpwa kpwenye kumbukumbu za mfalume Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
