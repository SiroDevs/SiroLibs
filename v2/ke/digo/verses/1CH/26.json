          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula mbari ya Ishari watsambulwa Kenania na anae ahende kazi za kondze kpwa kushuulikiya Iziraeli, akale maofisaa ga utawala na aamuli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
      ]
