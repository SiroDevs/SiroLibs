          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano a Heburoni, Jeria kala ndiye mkpwulu wao kulengana na arivyovyalwa ise za mbari zao. (Mwaka wa mirongo mine wa utawala wa mfalume Daudi, uchunguzi wahendwa na atu enye uwezo mkpwulu aphahikana kahi yao hiko Jazeri ya Giliadi.)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        }
