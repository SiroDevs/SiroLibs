            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula mbari ya Heburoni, Hashabia na nduguze elufu na magana sabaa, alume akudina, ahewa majukumu ga kuimirira seemu za Iziraeli zirizo uphande wa mtswerero wa dzuwa wa muho Joridani. Aimirira kazi zosi za Mwenyezi Mlungu na huduma za mfalume Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        }
