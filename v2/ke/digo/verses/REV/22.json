            }
          ]
        },
        {
          "text": "Mimi ndimi Alifa na Omega.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
            "verseOrgIds": [
              "REV.22.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
