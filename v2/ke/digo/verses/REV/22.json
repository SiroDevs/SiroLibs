            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:13",
              "type": "text"
            },
            {
              "text": "Chiyunani seemu hino inaamba,",
              "type": "text"
            },
            {
              "text": "Alifa na Omega",
              "type": "text"
            },
            {
              "text": ", yani A hadi Z.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndimi wa kpwandza na wa mwisho. Ndimi Mwandzo na ndimi Mwisho.’ ”",
          "type": "text",
          "attrs": {
