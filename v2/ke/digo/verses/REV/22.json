              "items": [
                {
                  "text": "Mwandzo 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mudzi hinyo taundakala na chitu chochosi cholaniwa ni Mlungu. Na chihi cha chifalume cha Mlungu na ye Mwana ngʼondzi chindakala mumo mudzini. Nao atumishie andamuabudu Mlungu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "andamuona, na dzinare rindaandikpwa mwao vilanguni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
