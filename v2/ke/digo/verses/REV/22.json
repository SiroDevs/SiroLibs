          ]
        },
        {
          "text": "Baha atu afulao kandzu zao na kuzitsusa, ili aphahe ruhusa ya kuinjira nyo mudzi muphya kutsupira miryangoye na arye matunda ga muhi urehao uzima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
