              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha ye malaika achiniamba, “Maneno higa ga unabii garigo mu chitabuni usigafwitse, mana gosi gogombwa mumo gandahendeka vivi sambi-sambi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
            "verseOrgIds": [
              "REV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.10"
              },
              "items": [
                {
                  "text": "Danieli 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi mutu ahendaye mai, naenderere kuhenda mai, na ahendaye waibu naenderere kuhenda waibu. Tsona mutu ahendaye haki, naye naazidi kuhenda haki, na mutu ariye bila ya lawama, naazidi kukala bila ya lawama.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.11",
            "verseOrgIds": [
              "REV.22.11"
            ]
          }
        }
      ]
