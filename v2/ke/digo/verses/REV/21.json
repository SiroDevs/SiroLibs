                {
                  "text": "Isaya 52:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.9"
              },
              "items": [
                {
                  "text": "Ezekieli 44:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela takuna chochosi chiricho najisi ndichoinjira himo mudzini, wala mutu yeyesi ahendaye mambo ga waibu ama ga handzo. Atu ndioinjira mudzi hinyo ni aratu ambao madzina gao gaandikpwa kpwenye chitabu cha uzima cha ye Mwana ngʼondzi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.27",
            "verseOrgIds": [
              "REV.21.27"
            ]
          }
