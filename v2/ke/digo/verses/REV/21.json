                "loc": "2PE.3.13"
              },
              "items": [
                {
                  "text": "2 Petero 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Higo gariphosira, náona mlunguni kuphya na dunia nyiphya, mana mlunguni kpwa kpwandza na dunia ya kpwandza kala ikaangamizwa, na kuchikala takuna bahari tsona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.1"
              },
              "items": [
                {
                  "text": "Isaya 52:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.10"
              },
              "items": [
                {
                  "text": "61:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "Maono 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chisha nchiona mudzi mtakatifu, yani Jerusalemu nyiphya, inatserera kula mlunguni kpwa Mlungu. Mudzi hinyo kala ukapambwa dza bibi arusi apambwavyo, achikala anaphirikpwa kpwa mlumewe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "Ezekieli 37:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.11+LEV.26.12"
              },
              "items": [
                {
                  "text": "Alawi 26:11–12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alafu nchisikira kululu kula pho pharipho na chihi cha chifalume, richiamba, “Vivi Mlungu andasagala phamwenga na atu. Phakpwe kaya andakala phamwenga na anadamu, nao andakala atue. Mlungu mwenye andakala phamwenga nao, naye andakala Mlungu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "Isaya 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.10"
              },
              "items": [
                {
                  "text": "Isaya 35:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.19"
              },
              "items": [
                {
                  "text": "65:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Andafuta matsozi gao gosi. Wakati hinyo atu taandafwa wala kusononeka. Takundakala na chiriro wala kulumwa, mana zo hali za kare zindakala zatsupa.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha yekala akasagarira cho chihi cha chifalume waamba, “Vivi sambi chila chitu nachihenda chiphya!” Piya achiniambira, “Gaandike higa, mana ni maneno ga kpweli na ga kukuluphirika.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.5",
            "verseOrgIds": [
              "REV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isaya 55:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi achiniamba tsona, “Mambo vivi gakahendeka. Mimi ndimi Alifa na ndimi Omega, yani ndimi Mwandzo na ndimi Mwisho. Chila mutu ariye na chiru nindamupha madzi ga bure anwe kula pula za madzi, madzi garehago uzima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
            "verseOrgIds": [
              "REV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.14"
              },
              "items": [
                {
                  "text": "2 Samueli 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.26+PSA.89.27"
              },
              "items": [
                {
                  "text": "Zaburi 89:26–27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutu ndiyeshinda, nindamupha vitu hivi vyosi, iye andakala mwanangu, nami ndakala Mlunguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
              "REV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela phahi aoga, asiomkuluphira Mlungu, akora, aolagadzi, adiya, atsai, aabuduo vizuka, na a handzo, aho osi phatu phao ni ziya ra moho mkali wa chibiriti. Na chicho ndicho chifo cha phiri.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha malaika mmwenga wa hara sabaa okala na mbiga za mashaka sabaa ga mwisho wakpwedzaniamba, “Ndzo nikuonyese ye bibi arusi, hiye ndiyekala mkpwaza ye Mwana Ngʼondzi.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.9",
            "verseOrgIds": [
              "REV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.2"
              },
              "items": [
                {
                  "text": "Ezekieli 40:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phapho achiniphirika hadi dzulu ya mwango mkpwulu tsona mure, wakati kala nalongozwa ni Roho Mtakatifu. Kuko yuya malaika achinionyesa mudzi mtakatifu wa Jerusalemu unatserera kula dzulu mlunguni kpwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.10",
            "verseOrgIds": [
              "REV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudzi hinyo kala una mwanga mkpwulu wa Mlungu, mana wakala unangʼala-ngʼala dza chilolo na dza dziwe ra samani kulu riihwaro jasipa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.30+EZK.48.31+EZK.48.32+EZK.48.33+EZK.48.34+EZK.48.35"
              },
              "items": [
                {
                  "text": "Ezekieli 48:30–35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tsona kala ukazungulusirwa ukuta mkpwulu wa dzulu. Piya kala una miryango kumi na miiri na chila mryango kala una malaika. Na chila mryango kala ukaandikpwa dzina ra mbari mwenga ya zira mbari kumi na mbiri za Iziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.12",
            "verseOrgIds": [
              "REV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chila uphande kala kuna miryango mihahu; mlairo wa dzuwa, vurini, mwakani, na mtswerero wa dzuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
              "REV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hinyo ukuta wa mudzi kala ukadzengbwa dzulu ya mawe kumi na mairi ga msingi. Na chila dziwe kala rikaandikpwa dzina ra mmwengawapho wa hara mitume kumi na airi a Mwana ngʼondzi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
