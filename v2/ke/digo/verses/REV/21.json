              "REV.21.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.3"
              },
              "items": [
                {
                  "text": "Ezekieli 40:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi ye malaika yekala anagomba nami kala akagbwira chigongo cha kupimira. Chigongo hicho kala chikatengezwa na zahabu, nacho kala ni cha kupimira nyo mudzi, miryangoye na nyo ukutawe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye malaika wapima hura mudzi na hicho chigongo, nago mare na mapana na chimo kala ga sawa kpwa sawa. Achiphaha kukala ni kilomita elufu mbiri na magana mane. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alafu ye malaika achipima upana wa nyo ukuta, nao uchikala ni mita mirongo sita. Naye wakala anahumira chipimo chihumirwacho ni anadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.17",
            "verseOrgIds": [
              "REV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.11"
              },
              "items": [
                {
                  "text": "Isaya 54:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyo ukuta kala ukadzengbwa na mawe ga samani ga jasipa. Mudzi nao kala ukadzengbwa na zahabu swafi ya kungʼala-ngʼala dza chilolo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
              "REV.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
