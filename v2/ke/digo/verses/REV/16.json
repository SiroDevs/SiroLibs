            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.44"
              },
              "items": [
                {
                  "text": "Zaburi 78:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika wa hahu naye wamwaga tsukizi zirizokala mwakpwe ligani myuhoni, pula za madzi na mwatu mosi murimokala na madzi, nago madzi gosi gachigaluka milatso. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phapho násikira malaika aimiriraye madzi anaamba,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 16:7"
          },
          "items": [
            {
