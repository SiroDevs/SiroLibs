            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Maono 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.13"
              },
              "items": [
                {
                  "text": "11:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tsona kpwakala na limeme, na mngurumo wa chiguruguru, na dunia ichisumba sana. Msumbo mkpwulu dza hinyo taudzangbweonekana hangu mwanadamu aumbwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.18",
            "verseOrgIds": [
              "REV.16.18"
            ]
          }
        },
        {
