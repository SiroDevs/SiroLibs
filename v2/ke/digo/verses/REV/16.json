            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.29"
              },
              "items": [
                {
                  "text": "2 Afalume 23:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.11"
              },
              "items": [
                {
                  "text": "Zakariya 12:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi hara pepho akusanya afalume osi na majeshi gao phatu ambapho Chieburania phanaihwa Arimagedoni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15+REV.16.16",
            "verseOrgIds": [
              "REV.16.15",
              "REV.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana Jesu anaamba, “Phundzani, mimi ndakpwedza gafula dza viratu muivi edzavyo bila ya kusema. Ela waajaliwa iye achesaye matso kuika nguwoze tayari ili asedze akanyendeka chihuphu na kuphaha waibu.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15+REV.16.16",
            "verseOrgIds": [
              "REV.16.15",
              "REV.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15+REV.16.16",
            "verseOrgIds": [
              "REV.16.15",
              "REV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha malaika wa sabaa naye achimwaga tsukizi za Mlungu zirizokala mwakpwe ligani, hewani. Nami nchisikira sauti yogomba kululu kula chihi cha chifalume cha iyo Nyumba ya Kuvoya Mlungu, inaamba, “Gosi gakasira.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 16:18"
          },
          "items": [
