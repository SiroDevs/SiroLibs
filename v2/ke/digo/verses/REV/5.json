                {
                  "text": "Mwandzo 49:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Isaya 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
