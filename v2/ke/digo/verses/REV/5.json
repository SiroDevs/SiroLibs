                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.10"
              },
              "items": [
                {
                  "text": "Isaya 42:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hivyo amuimbira wira muphya ye Mwana ngʼondzi okala unaamba:",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
