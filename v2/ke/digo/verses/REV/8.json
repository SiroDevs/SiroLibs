              },
              "items": [
                {
                  "text": "Ezekieli 38:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuya malaika wa kpwandza wapiga gundare, ndipho mvula ya mawe ga barafu, na moho kutsanganya na mlatso watsuphiwa duniani. Moho uchiocha seemu mwenga ya hahu ya dunia, uchibananga mihi na nyasi seemu hiyo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
