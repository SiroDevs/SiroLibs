                "loc": "REV.16.18"
              },
              "items": [
                {
                  "text": "16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Badaye yuya malaika wahala makala ga moho kula phara phatu pha kulavira sadaka, achigatiya himo ligani na achigatsupha duniani. Alafu kuchikala na mngurumo wa chiguruguru na limeme, na dunia ichisumba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha hara malaika sabaa ambao kala ana magunda sabaa adzitayarisha kupiga magunda gao.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
            ]
          }
        }
      ]
    },
