              "items": [
                {
                  "text": "Isaya 14:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa hahu naye wapiga gundare, na dzinyenyezi kulu sana ragbwa kula mlunguni. Kala rinaaka dza chimwindi, naro ragbwerera seemu mwenga ya hahu ya myuho, pula za madzi na mwatu mosi murimokala na madzi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.15"
              },
              "items": [
                {
                  "text": "Jeremia 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hiro dzinyenyezi kala rinaihwa Utsungu, naro ragaluza seemu ya madzi gachikala utsungu. Phahi atu anji afwa kpwa sababu madzi kala ga utsungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
      ]
