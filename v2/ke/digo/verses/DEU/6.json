              "attrs": {
                "loc": "EXO.17.1+EXO.17.2+EXO.17.3+EXO.17.4+EXO.17.5+EXO.17.6+EXO.17.7"
              },
              "items": [
                {
                  "text": "Kutsama 17:1–7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msimjeze Mwenyezi Mlungu, Mlungu wenu, dza vira murivyomjeza hiko Masa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endererani kulunga amuri, malagizo na masharuti ga Mwenyezi Mlungu, Mlungu wenu, ambago akakuamuruni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hendani garigo sawa na manono mbere za Mwenyezi Mlungu ili muongokerwe, na mmenye na mumiliki tsi iyo nono ambayo Mwenyezi Mlungu waapa kuapha akare enu. Namwi mundazola maadui genu dza vira Mwenyezi Mlungu arivyoahidi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18+DEU.6.19",
            "verseOrgIds": [
              "DEU.6.18",
              "DEU.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
