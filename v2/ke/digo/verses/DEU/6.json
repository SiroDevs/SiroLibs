          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
