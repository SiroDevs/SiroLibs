              "DEU.17.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.5"
              },
              "items": [
                {
                  "text": "1 Samueli 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bada ya kuinjira kpwenye tsi ambayo Mwenyezi Mlungu, Mlungu wenu, anakuphani, mchiirisi na kusagala himo namwi mchiamba kukala mundaika mfalume dzulu yenu, dza vira mataifa ganjina gosi ganagoazunguluka, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "munaweza kumuika mfalume dzulu yenu mutu ambaye Mwenyezi Mlungu, Mlungu wenu, andamtsambula. Mundamuika mmwenga wa ndugu zenu kukala mfalume dzulu yenu. Msimuhende mjeni asiyekala ndugu yenu kukala mfalume wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.28"
              },
              "items": [
                {
                  "text": "1 Afalume 10:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.16"
              },
              "items": [
                {
                  "text": "2 Nyakati 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.28"
              },
              "items": [
                {
                  "text": "9:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata hivyo, asikale na farasi anji kpwa ajiliye mwenye, wala asiauyize atu Misiri kpwa kudzipha farasi zaidi, kpwa sababu Mwenyezi Mlungu akaaonya ‘Tamundauya tsona kpwa njira hira.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1+1KI.11.2+1KI.11.3+1KI.11.4+1KI.11.5+1KI.11.6+1KI.11.7+1KI.11.8"
              },
              "items": [
                {
                  "text": "1 Afalume 11:1–8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.14+1KI.10.15+1KI.10.16+1KI.10.17+1KI.10.18+1KI.10.19+1KI.10.20+1KI.10.21+1KI.10.22"
              },
              "items": [
                {
                  "text": "1 Afalume 10:14–22–27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.15"
              },
              "items": [
                {
                  "text": "2 Nyakati 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.27"
              },
              "items": [
                {
                  "text": "9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfalume ni asilóle achetu anji sedze moyowe ukaphiya kure na Mwenyezi Mlungu, wala asidzirundikire feza na zahabu kpwa unji sana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu ndiphokala mfalume ni akale na nakalaye ya shariya ndiyoandikirwa mbere za Alawi ambao ni alavyadzi-sadaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakala iyo ni akale nayo siku zosi na kuisoma maishage gosi, kusudi aphahe kudzifundza kumuogopha Mwenyezi Mlungu, Mlunguwe, kpwa kulunga na kutimiza maneno gosi ga shariya hino na masharuti higa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achihenda hivyo kandadziona kukala wa mana kuriko nduguze, wala kuyiika kanda shariya hino kpwa namuna yoyosi. Chihivyo iye na chivyaziche andadumu kpwenye utawala ko Iziraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.20",
            "verseOrgIds": [
              "DEU.17.20"
            ]
          }
        }
      ]
    }
