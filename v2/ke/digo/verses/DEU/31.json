        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
