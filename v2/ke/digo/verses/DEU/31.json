          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Musa waandika wira hinyo siku iyo-iyo, achiafundza Aiziraeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
            "verseOrgIds": [
              "DEU.31.22"
            ]
          }
        }
