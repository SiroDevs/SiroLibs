              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela uchidzizuwiya kuika naziri kundakala na dambi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
