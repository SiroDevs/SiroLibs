            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36+LEV.25.37"
              },
              "items": [
                {
                  "text": "Alawi 25:36–37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Kumbukumbu 15:7–11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Unaphoaphasa Muiziraeli myao usilonde fwaida, ikale ni mkopo wa feza, chakurya, au chochosi ambacho atu nkukopesha kpwa kuphaha fwaida. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unaweza kulonda fwaida unaphomkopesha mjeni, ela Muiziraeli myao usimtoze fwaida ili Mwenyezi Mlungu, Mlunguo, akujaliye kahi ya shuulizo zosi ndizohenda kpwenye tsi ambayo uyaimiliki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 23:21"
          },
          "items": [
            {
              "text": "21",
