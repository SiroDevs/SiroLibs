            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakikisha unausa naziri uchiyoika kpwa kugomba na mromoo, mana wamuahidi Mwenyezi Mlungu, Mlunguo kpwa hiyariyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
