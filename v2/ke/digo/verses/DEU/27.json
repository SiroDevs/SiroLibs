                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Kumbukumbu 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Joshuwa 8:33–35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ndiphovuka muho Joridani, mbari hizi zindaima dzulu ya mwango Gerizimu wakati baraka zinatangazirwa nyo atu, Simioni, Lawi, Juda, Isakari, Yusufu na Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbari hizi zindaima dzulu ya mwango Ebali wakati lana zinatangazirwa nyo atu, Rubini, Gadi, Asheri, Zabuloni, Dani na Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Alawi andatangazira atu osi a Iziraeli kpwa sauti kulu aambe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
    },
