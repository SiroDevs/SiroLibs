                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.18"
              },
              "items": [
                {
                  "text": "26:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.14"
              },
              "items": [
                {
                  "text": "Tito 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Petero 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwimwi mu atakatifu a Mwenyezi Mlungu, Mlungu wenu. Mwenyezi Mlungu akakutsambulani mwimwi mkale hazinaye ya samani kahi ya atu osi, kosi duniani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msirye nyama ambao ni tsukizo kpwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.3",
            "verseOrgIds": [
              "DEU.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama ambao munaweza kurya ni hano: ngʼombe, ngʼondzi, mbuzi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.4",
            "verseOrgIds": [
              "DEU.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulungu, chiphala, kongoni, mbuzi a tsakani, chiphala chereru, chidzisa na pofu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.5",
            "verseOrgIds": [
              "DEU.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na chila nyama ambaye makpwatsage gaganyika seemu mbiri na anatserura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.6",
            "verseOrgIds": [
              "DEU.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela kahi ya nyama atserurao, au ario na makpwatsa ga kuganyika seemu mbiri, msirye ngamia, tsungula na kpwangʼa, dzagbwe anatserura ela makpwatsa gao tagaganyikire seemu mbiri; hinyo ni najisi kpwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.7",
            "verseOrgIds": [
              "DEU.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msirye nguluwe, mana dzagbwe ana makpwatsa garigoganyika seemu mbiri ela katserura; hiye ni najisi kpwenu. Msirye nyama zao wala msigute nyufu zao.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Munaweza kurya nyama osi a madzini enye mapezi na mamba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.9",
            "verseOrgIds": [
              "DEU.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela chiumbe chochosi cha madzini ambacho tachina mapezi wala mamba msirye, hicho ni najisi kpwenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Munaweza kurya nyama osi a mapha ario swafi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.11",
            "verseOrgIds": [
              "DEU.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela msirye nyama hinya a mapha: kozi, furukombe, pungu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.12",
            "verseOrgIds": [
              "DEU.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mweko, aina zosi za nderi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.13",
            "verseOrgIds": [
              "DEU.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "aina zosi za kunguru, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.14",
            "verseOrgIds": [
              "DEU.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbuni, bweka, dudumizi, aina zosi za chiphanga, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.15",
            "verseOrgIds": [
              "DEU.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "aina zosi za vimburu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.16",
            "verseOrgIds": [
              "DEU.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "aina zosi za manjera, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.17",
            "verseOrgIds": [
              "DEU.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "korongo, koikoi, hudihudi na chila aina ya nundu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.18",
            "verseOrgIds": [
              "DEU.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adudu osi enye mapha anyendekao kpwa magulu mane, hinyo ni najisi kpwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.19",
            "verseOrgIds": [
              "DEU.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munaweza kurya adudu osi enye mapha ario swafi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.20",
            "verseOrgIds": [
              "DEU.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.19"
              },
              "items": [
                {
                  "text": "Kutsama 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.26"
              },
              "items": [
                {
                  "text": "34:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kpwa sababu mwimwi mu atakatifu a Mwenyezi Mlungu, Mlungu wenu, msirye nyama yeyesi chiyefwa mwenye. Ela munaweza kumupha mjeni asagalaye kpwenye midzi yenu arye au munaweza kumguzira mutu wa taifa ranjina. Mana mwimwi mu atu atakatifu kpwa Mwenyezi Mlungu, Mlungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msijite mwana mbuzi kuhumira maziya ga nine.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
