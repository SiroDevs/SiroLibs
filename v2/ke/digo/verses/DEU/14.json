              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa waenderera kugomba achiamba, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.28"
              },
              "items": [
                {
                  "text": "Alawi 19:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.5"
              },
              "items": [
                {
                  "text": "21:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mwimwi mu ana a Mwenyezi Mlungu, Mlungu wenu; msidzitsodze wala kunyola chiphala lihosini kpwa ajili ya mutu achiyefwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.5+EXO.19.6"
              },
              "items": [
                {
                  "text": "Kutsama 19:5–6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.20"
              },
              "items": [
                {
                  "text": "Kumbukumbu 4:20",
