                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26+NUM.28.27+NUM.28.28+NUM.28.29+NUM.28.30+NUM.28.31"
              },
              "items": [
                {
                  "text": "Isabu 28:26–31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Olangani majuma sabaa; kuandzira wakati munaphoandza kuvuna mtsere. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu sherekeyani Sikukuu ya mavuno ili kuishimu Mwenyezi Mlungu, Mlungu wenu, kpwa kulavya sadaka ya hiyari chiasi kulengana na vira Mwenyezi Mlungu, Mlungu wenu, anavyokujaliyani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundahererwa mbere za Mwenyezi Mlungu, Mlungu wenu, mwimwi phamwenga na ana enu a chilume na a chichetu, atumishi enu, Alawi, ajeni, anachiya na magungu ambao anasagala phamwenga namwi. Hendani higa phatu ambapho Mwenyezi Mlungu, Mlungu wenu, ndiphotsambula. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tambukirani kukala mwakala atumwa hiko Misiri kpwa hivyo lungani masharuti higa kpwa makini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bada ya kuwaga mtsere wenu wosi na kuminya zabibu zenu, sherekeyani Sikukuu ya Vibanda kpwa muda wa siku sabaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundasherekeya kpwa kuhererwa, mwimwi na ana enu a chilume na a chichetu, atumwa enu, Alawi, ajeni, anachiya na magungu ambao anaishi kpwenye midzi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sherekeyani kpwa siku sabaa ili mumuishimu Mwenyezi Mlungu, Mlungu wenu, phatu ambapho iye andatsambula. Kpwa sababu Mwenyezi Mlungu, Mlungu wenu andajaliya mavuno genu gosi na gosi muhendago, namwi hakika mundahererwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Alume osi a taifa renu andakpwedza mbere za Mwenyezi Mlungu, Mlungu wenu, kano tahu chila mwaka, phatu ambapho Mwenyezi Mlungu, Mlungu wenu andatsambula. Wakati wa sikukuu ya mikahe isiyotiywa hamira, sikukuu ya mavuno na wakati wa Sikukuu ya Vibanda. Mutu asedze mbere za Mwenyezi Mlungu mikono mihuphu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chila mutu andalavya chiasi anachoweza kulengana na vira ambavyo Mwenyezi Mlungu, Mlungu wenu, akakujaliyani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tsambulani Aamuli na akulu kula mbari zenu zosi. Hinya mundaaika kpwenye midzi yenu ambayo Mwenyezi Mlungu, Mlungu wenu, andakuphani nao andaamula atu na haki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
              "DEU.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.6+EXO.23.7+EXO.23.8"
              },
              "items": [
                {
                  "text": "Kutsama 23:6–8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Alawi 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amulani na haki, msikale na upendeleo, wala msikubali kuphokera hongo, kpwa kukala hongo rinahenda atu enye ikima akale vipofu na kugaluza kpweli ya enye haki kukala handzo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.19",
            "verseOrgIds": [
              "DEU.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lungani haki tu, kusudi mphahe kusagala na kurisi tsi munayohewa ni Mwenyezi Mlungu, Mlungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
            ]
          }
        }
      ]
    },
