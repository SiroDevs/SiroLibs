          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu anaamba, “Mutu ariye na ikima naasidzikarye kpwa ikimaye, na mwenye mkpwotse naasidzikarye kpwa mkpwotsewe na tajiri naye naasidzikarye kpwa utajiriwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
