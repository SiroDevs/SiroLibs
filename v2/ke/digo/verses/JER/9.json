                {
                  "text": "1 Akorintho 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.17"
              },
              "items": [
                {
                  "text": "2 Akorintho 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela alondaye kudzikarya, naadzikarye kpwa kukala ananimanya na kuelewa kukala mimi, ndimi Mwenyezi Mlungu niriye na mendzwa isiyosika, niamulaye na haki na nkureha haki duniani, mana ndigo ganihamirago.” Vivyo ndivyo Mwenyezi Mlungu aambavyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        }
