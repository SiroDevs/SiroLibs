              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu anaamba, “Hata siku zizo, sindakumalani tsetsetse.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.18",
            "verseOrgIds": [
              "JER.5.18"
            ]
          }
        },
        {
          "name": "verse",
