              "items": [
                {
                  "text": "1 Samueli 7:5–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chisha Mwenyezi Mlungu achiniamba, “Hata Musa na Samueli akaima mbere zangu kuavoyera, nisingehamirwa ni atu ano. Auseni mbere zangu na muariche auke! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
