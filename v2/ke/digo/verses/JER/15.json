              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.1+2KI.21.2+2KI.21.3+2KI.21.4+2KI.21.5+2KI.21.6+2KI.21.7+2KI.21.8+2KI.21.9+2KI.21.10+2KI.21.11+2KI.21.12+2KI.21.13+2KI.21.14+2KI.21.15+2KI.21.16"
              },
              "items": [
                {
                  "text": "2 Afalume 21:1–16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.1+2CH.33.2+2CH.33.3+2CH.33.4+2CH.33.5+2CH.33.6+2CH.33.7+2CH.33.8+2CH.33.9"
              },
              "items": [
                {
                  "text": "2 Nyakati 33:1–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nindahenda akale chitu cha kutisha matsoni pha falume zosi za dunia kpwa vyo Manase mwana wa Hezekiya mfalume wa Juda arivyohenda ko Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
