          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Maono 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ndiphokuuzani kuamba, ‘Swino huphiyephi?’ mundaambira, Mwenyezi Mlungu anaamba hivi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
