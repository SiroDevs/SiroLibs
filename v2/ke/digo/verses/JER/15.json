            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mimi Mwenyezi Mlungu naamba, ‘Nindaaphirikira aina ne za abanangi. Ndaaphirikira upanga wa kuaolaga, madiya ambago gandaamwamula, nyama a mapha na nyama a tsakani ndioarya na kuaangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
