        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Chisha nyo atu a nyumbani mwa mfalume wa Juda aambire, ‘Phundzani vyo Mwenyezi Mlungu aambavyo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwi atu a nyumba ya Daudi! Mwenyezi Mlungu anaamba hivi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
