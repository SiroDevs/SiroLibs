              },
              "items": [
                {
                  "text": "2 Afalume 25:1–11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Nyakati 36:17–21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Huuzire ushauri kpwa Mwenyezi Mlungu, mana Nebukadineza, mfalume wa Babeli analonda ahuvamie. Nkuhenda Mlungu akahuhendera vilinje dza arivyohuhendera pho kare na kumuhenda ye Nebukadineza ahuriche.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
