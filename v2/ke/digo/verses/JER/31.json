                "loc": "HEB.8.8+HEB.8.9+HEB.8.10+HEB.8.11+HEB.8.12"
              },
              "items": [
                {
                  "text": "Aeburania 8:8–12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu anaamba, “Lola, wakati uredza ambapho nindaika chilagane chiphya na atu a Iziraeli na atu a Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hicho tachindakala dza chilagane nrichoika na akare ao nriphoagbwira mikono nchiatuluza kula tsi ya Misiri. Chilagane ambacho achivundza, dzagbwe nakala dza mlume wao, mimi Mwenyezi Mlungu nkaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.32",
            "verseOrgIds": [
              "JER.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.16"
              },
              "items": [
                {
                  "text": "Aeburania 10:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hichi ndicho chilagane ndichoika na atu a Iziraeli wakati hinyo. Mwenyezi Mlungu anaamba, ‘Nindatiya shariya yangu mwao achilini na kuiandika mwao mioyoni. Mimi ndakala Mlungu wao, nao andakala atu angu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.33",
            "verseOrgIds": [
              "JER.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.17"
              },
              "items": [
                {
                  "text": "Aeburania 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takundakala na haja ya mutu kumfundza jiraniwe au nduguye tsona kumuamba, “Mmanye Mwenyezi Mlungu,” mana chila mmwenga andanimanya kuandzira mdide hadi mvyere, mimi Mwenyezi Mlungu nkaamba. Mana nindaaswamehe makosa gao na sindatambukira tsona dambi zao.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.34",
            "verseOrgIds": [
              "JER.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
