          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa msindo wa kugbwa kpwa Babeli, dunia indakakama, sauti za viriro vya atue vindasikirika kahi za mataifa ganjina.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.46",
            "verseOrgIds": [
              "JER.50.46"
            ]
          }
        }
