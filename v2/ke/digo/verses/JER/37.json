              "items": [
                {
                  "text": "2 Afalume 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Nyakati 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zedekiya mwana wa Josiya watawazwa ni mfalume Nebukadineza wa Babeli kuitawala Juda badala ya Konia mwana wa Jehoyakimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela iye, atumishie na atu a tsiiye taayagagbwira gokala gakagombwa ni Mwenyezi Mlungu kutsupira nabii Jeremia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi mfalume Zedekiya wahuma Jehukali mwana wa Shelemia phamwenga na mlavyadzi-sadaka Zefania mwana wa Maaseya kpwa nabii Jeremia kumuamba, “Nakuvoya uhuvoyere kpwa Mwenyezi Mlungu, Mlungu wehu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati uho Jeremia kala achere na uhuru wa kunyendeka kahi ya nyo atu, mana kala kadzangbwefungbwa jela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeshi ra Farao kala riredza kula Misiri; Akalidayo ariokala akazangira Jerusalemu ariphosikira habari zao, auka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Mwenyezi Mlungu wagomba na nabii Jeremia achiamba, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwenyezi Mlungu, Mlungu wa Iziraeli anaamba: Muambire ye mfalume wa Juda ariyekuhuma kpwangu kpwedzaniuza mashauri kuhusu jeshi ra Farao richirokpwedza kukuterya kukala ri phephi kuuya Misiri, tsi yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Akalidayo andauya edze apigane na mudzi uhu, aho andauhala na autiye moho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu anaamba, ‘Msidzichenge mukaamba, atu a Babeli andahuricha. Mana taandauka bii. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hata mchiturya jeshi rosi ra Babeli munaropigana naro hata asale achiolumizwa bahi mwao mahemani, aho andaunuka edze aoche mudzi uhu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya jeshi ra Babeli kuchimbira Jerusalemu kpwa sababu ya jeshi ra Farao, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia watuluka Jerusalemu achiphiya tsi ya Benjamini kpwendahewa urisiwe kahi ya atue. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ariphofika Ryango ra Benjamini, mkpwulu wa arindzi aihwaye Irija mwana wa Shelemia, mdzukulu wa Hanania, achimgbwira nabii Jeremia achimuamba, “Uwe unachimbira ukadziunge na Akalidayo!” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia achiamba, “Hata, mino sichimbira kpwa nkadziunge na Akalidayo.” Ela Irija kayalonda kumphundza, badalaye wamgbwira Jeremia achimphirika kpwa vilongozi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo vilongozi kala akammena sana Jeremia, achimpiga na achimtiya ndani ya nyumba ya muandishi Jonathani ambayo kala ikahendwa jela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Jeremia watiywa dibwani mo jela kpwa muda mure.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha mfalume Zedekiya wamlagizira na achirehwa phakpwe dzumbani. Achimuuza chisiri achimuamba, “Dze una ujumbe wowosi kula kpwa Mwenyezi Mlungu?” Jeremia achimuamba, “Ehe, uwe undatiywa mikononi mwa mfalume wa Babeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Jeremia achimuuza mfalume Zedekiya, “Nakukoserani, au naakoserani atumishio au atu hinya hata unitiye jela? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.18",
            "verseOrgIds": [
              "JER.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuphi nyo manabiio ariokulavira unabii kpwa kuamba kukala mfalume wa Babeli kandakuvamia uwe wala tsi ihi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.19",
            "verseOrgIds": [
              "JER.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela vivi niphundza uwe bwana na mfalume wangu. Nakuvoya usiniuyize nyumbani mwa muandishi Jonathani, sedze nchafwerera kuko.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.20",
            "verseOrgIds": [
              "JER.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi mfalume Zedekiya walavya amuri Jeremia aikpwe kpwenye muhala wa mrindzi na ahewe mkpwahe mwenga chila siku hadi yo mikahe ichisira mo mudzini. Phahi Jeremia wasala kpwenye muhala wa mrindzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.21",
            "verseOrgIds": [
              "JER.37.21"
            ]
          }
        }
      ]
    }
  ],
