          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Higa ndigo maneno ambago Mwenyezi Mlungu wagomba kuhusu Iziraeli na Juda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        }
      ]
    },
    {
