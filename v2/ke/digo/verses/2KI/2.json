            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha achienderera na charoche hadi mwango Karimeli na kula hiko wauya Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
