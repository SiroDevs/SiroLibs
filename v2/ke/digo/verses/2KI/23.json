            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye achiamba, “Mricheni phapho, mutu yeyesi asiuse mifuphaye.” Kpwa hivyo mifuphaye airicha, phamwenga na mifupha ya nabii ariyela Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika chila mudzi wa Samariya mfalume Josiya wabananga mwatu mwa dzulu mwa kuabudu milungu ya handzo modzengbwa ni afalume a Iziraeli, achimtsukiza Mwenyezi Mlungu. Mwatu mwa kulavira sadaka hizo mosi wamubananga dza vira arivyohenda hiko Betheli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waolaga alavyadzi-sadaka osi a milungu ya handzo dzulu ya mwatu mwa kulavira sadaka ambamo ahumikira, na kuocha mifupha ya atu dzulu ya chila mwatu mwa kulavira sadaka. Alafu wauya Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona mfalume Josiya walagiza atu osi achiamba, “Muhendereni Mwenyezi Mlungu, Mlungu wenu, Pasaka, dza irivyoandikpwa kpwenye chitabu hichi cha chilagane.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takuna Pasaka yosherekewa dza iyo hangu wakati wa Aamuli arioamula Aiziraeli wala wakati wosi wa Afalume a Iziraeli au a Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela, mwaka wa kumi na nane wa utawala wa mfalume Josiya, Pasaka ihi yasherekewa kpwa sababu ya Mwenyezi Mlungu ko Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona, ili mfalume Josiya atimize shariya zosi zoandikpwa katika chitabu arichotsola ndani ya nyumba ya Mwenyezi Mlungu ni mlavyadzi-sadaka mkpwulu, Hilikiya, wausa atsai, apigi a mburuga, milungu, vizuka vya milungu phamwenga na mambo gosi ga kutsukiza goonekana Juda na Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabila ya Josiya au bada ya iye takuna mfalume yeyesi ariyekala dza iye, ambaye wamuhumikira Mwenyezi Mlungu na moyowe wosi, rohoye yosi na nguvuze zosi kulengana na Shariya zosi za Musa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, Mwenyezi Mlungu kayaricha usiru wa tsukizize nyinji, kpwa sababu kala akaitsukirirwa Juda kpwa sababu ya mambo mai gosi ga kutsukiza gohendwa ni Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Mwenyezi Mlungu achiamba, “Ndaatsamiza atu a Juda akale kure nami dza vira nrivyohenda atu a Iziraeli. Ndarema Jerusalemu ambayo naitsambula nriphoamba, ‘Mimi ndaabudiwa Jerusalemu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo ganjina ga Josiya na gosi arigohenda gaandikpwa kpwenye Chitabu cha Mambo ga Nyakati za Afalume a Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa utawalawe, Neko, mfalume wa Misiri, waambuka kpwendapigana na mfalume wa Ashuru, ko muho wa Yufurati. Naye mfalume Josiya wakpwendapigana naye, ela Neko mfalume wa Misiri ariphomuona achimuolaga ko Megido. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumishie atsukula lufure na gari ra kuvwehwa ni farasi kula Megido achirireha Jerusalemu kpwedzarizika kpwenye mbiraye mwenye. Tsona atu a Juda amuhala Jehoahazi mwana wa Josiya, achimmwagira mafuha na kumuika akale mfalume badala ya ise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
