          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye wahenda mai mbere za Mwenyezi Mlungu, sawa na gosi garigohendwa ni akaree.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
