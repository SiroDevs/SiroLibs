              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahazi kala ana miaka mirongo miiri na tahu ariphoandza kutawala naye watawala ko Jerusalemu kpwa muda wa miezi mihahu. Nine kala anaihwa Hamutali, mwana mchetu wa Jeremia, kula mudzi wa Libuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahazi wahenda mai mbere za Mwenyezi Mlungu sawa-sawa na akaree. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili asienderere kutawala Jerusalemu, Neko mfalume wa Misiri wamfunga hiko Ribula kpwenye tsi ya Hamathi. Achiilazimisha Juda ilavye kodi ya kilo elufu tahu na magana mane ga feza na kilo mirongo mihahu na ne za zahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11+JER.22.12"
              },
              "items": [
                {
                  "text": "Jeremia 22:11–12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Neko, mfalume wa Misiri wamuika Eliakimu mwana wa mfalume Josiya atawale badala ya ise Josiya, achimgaluza dzina achimuiha Jehoyakimu. Ela wamuusa Jehoahazi, achiphiya naye Misiri, ko kpwendafwerera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        }
      ]
    },
