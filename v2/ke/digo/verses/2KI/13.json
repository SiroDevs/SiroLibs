        },
        {
          "text": "Mfalume Hazaeli wa Aramu waagayisa sana atu a Iziraeli wakati wosi wa utawala wa Jehoahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
