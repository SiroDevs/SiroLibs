              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa utawala wa Jehoramu, atu a Edomu arema kutawalwa kula Juda, achitawaza mfalume wao.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.20",
