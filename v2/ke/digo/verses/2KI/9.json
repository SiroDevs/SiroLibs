          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mrindzi dzulu ya mnara waamba, “Mjumbe akaafikira, ela kauya.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.18",
            "verseOrgIds": [
              "2KI.9.18"
            ]
          }
        }
