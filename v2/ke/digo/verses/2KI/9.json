            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.19",
            "verseOrgIds": [
              "2KI.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara yanjina tsona mrindzi waamba, “Mjumbe akaafikira ela kauya.” Halafu waenjereza kuamba, “Uphirikiwe wa gari ni dza wa Jehu mwana wa Nimushi, manage iye nkuphirika mairo.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Joramu mfalume wa Iziraeli achiamuru achiamba, “Tayarisha gari.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.21",
            "verseOrgIds": [
              "2KI.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao amtayarisha garire. Chisha Joramu mfalume wa Iziraeli na Ahaziya mfalume wa Juda atuluka, chila mmwenga wapanda ndani ya garire, achendakutana na Jehu. Amkuta kpwenye uwanja wa Nabothi wa Jeziriili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.21",
            "verseOrgIds": [
              "2KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Joramu ariphomuona Jehu, wamuuza, “Jehu, uredza kpwa amani?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu wamjibu achiamba, “Amani yani, wakati udiya na utsai wa mayoo Jezebeli ni munji?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joramu wagaluza garire, naye achimuambira Ahaziya, “Ahaziya, higo ni mapinduzi!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.23",
            "verseOrgIds": [
              "2KI.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.23",
            "verseOrgIds": [
              "2KI.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu wahala uhawe, achiutonyola kpwa nguvuze zosi nao uchimlatsa kahi-kahi ya mafuzi ga Joramu na kudunga moyowe, naye achifwa phapho hipho ndani ya garire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.24",
            "verseOrgIds": [
              "2KI.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu wamuambira msaidiziwe Bidikari, “Hala hiro lufure uritsuphe himo mundani mwa Nabothi wa Jeziriili manage, tambukira uwe na mimi huriphokala hukapanda dzulu ya magari ga kuvwehwa ni farasi nyuma ya ise Ahabu, vira Mwenyezi Mlungu arivyogomba maneno higa kumuhusu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.25",
            "verseOrgIds": [
              "2KI.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.19"
              },
              "items": [
                {
                  "text": "1 Afalume 21:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu waamba, ‘Kpwa hura mlatso ya Nabothi na kpwa milatso ya anae nriyoona dzana, ndariphiza chisasi kpwenye munda huno.’ Kpwa hivyo, hala lufu ra Joramu uritsuphe kpwenye munda wa Nabothi dza vira Mwenyezi Mlungu arivyogomba.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaziya mfalume wa Juda ariphoona garigohendeka wachimbira achielekeya Bethi-Hagani,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.27",
            "verseOrgIds": [
              "2KI.9.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:27",
              "type": "text"
            },
            {
              "text": "Bethi-Hagani",
              "type": "text"
            },
            {
              "text": "manaye ni nyumba ya mundani.",
              "type": "text"
            }
          ]
        },
        {
          "text": " naye walungbwa ni Jehu. Jehu waambira anajeshie, “Mlatseni naye piya!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.27",
            "verseOrgIds": [
              "2KI.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao amlatsa muvwi ariphokala ndani ya gari ra kuvwehwa ni farasi kpwenye njira iambukayo Guri phephi na mudzi wa Ibuleamu. Halafu wazorera Megido na achifwerera kuko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.27",
            "verseOrgIds": [
              "2KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulue arihala lufure ndani ya garire ra kuvwehwa ni farasi na achiriphirika Jerusalemu. Hiko achizikpwa kpwenye mbiraye phamwenga na akaree kpwenye vikura vya afalume vya mudzi wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaziya waandza kutawala Juda mwaka wa kumi na mwenga wa Joramu mwana wa Ahabu kukala mfalume wa Iziraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu ariphofika Jeziriili, Jezebeli achiphaha habari ya mambo chigohendeka. Wadzipaka wanda matsoni, achitengeza nyereze na achitsungurira na dirishani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.30",
            "verseOrgIds": [
              "2KI.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu ariphokala anainjira ryangoni, Jezebeli wauza, “Uredza kpwa amani, we Zimuri, chiyeolaga bwanao?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.31",
            "verseOrgIds": [
              "2KI.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.31",
            "verseOrgIds": [
              "2KI.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu walola dzulu dirishani na achiuza, “Ni ani ariye uphande wangu?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.32",
            "verseOrgIds": [
              "2KI.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulu airi au ahahu ariotulwa atuluza vitswa vyao dirishani, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.32",
            "verseOrgIds": [
              "2KI.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Jehu waambira; “Mtsupheni photsi!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.33",
            "verseOrgIds": [
              "2KI.9.33"
            ]
