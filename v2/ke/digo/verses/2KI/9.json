          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu mjumbe wa phiri achihumwa kpwendamuuza Jehu, “Mfalume anauza, dze, uredza kpwa amani?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.19",
            "verseOrgIds": [
              "2KI.9.19"
            ]
          }
        }
