    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshea mwana wa Ela waandza kutawala Iziraeli mwaka wa kumi na mbiri wa utawala wa mfalume Ahazi wa Juda, na watawala kula Samariya kpwa muda wa miaka tisiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahenda mai mbere za Mwenyezi Mlungu dzagbwe siyo dza afalume a Iziraeli ariomtanguliya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalume Shalimanesa wa Ashuru wakpwendamvamia, naye Hoshea achidziika tsini ya utawala wa mfalume wa Ashuru na achimripha kodi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela wakati mmwenga mfalume wa Ashuru waona uasi wa Hoshea. Mana Hoshea wahuma ajumbe kpwa mfalume So wa Misiri kpwendavoya msada, na chisha achiricha kuripha hira kodi ya chila mwaka kpwa mfalume Shalimanesa wa Ashuru. Shalimanesa ariphoona hivi wamfunga Hoshea na achimtiya jela.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona mfalume wa Ashuru washambuliya tsi ndzima na kuufikira mudzi wa Samariya na achiuzangira kpwa muda wa miaka mihahu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa tisiya wa utawala wa Hoshea, mfalume wa Ashuru wauteka mudzi wa Samariya na achiatsamiza atu a Iziraeli hadi Ashuru. Diba mwenga wariika mudzi wa Hala, ranjina achiriika kanda-kanda ya muho Habori urio mudzi uihwao Gozani na ranjina achiriika kpwenye midzi ya Amedi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Higa gosi gahendeka kpwa sababu atu a Iziraeli kala akamuhendera dambi Mwenyezi Mlungu, Mlungu wao, ambaye waatuluza kula tsi ya Misiri, na achiativya kula mikononi mwa Farao, mfalume wa Misiri. Aho amricha achiabudu milungu yanjina, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kulunga mila za mataifa ganjina ambago Mwenyezi Mlungu wagazola wakati Aiziraeli ariphokala anainjira, na kulunga mila zoandzishwa ni Afalume. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a Iziraeli ahenda chisiri mambo gasigokala manono mbere za Mwenyezi Mlungu, Mlungu wao. Adzenga mwatu mwa dzulu mwakuabudu milungu ya handzo kpwenye chila mudzi, kuandzira mudzi mdide wenye mnara wa arindzi hadi midzi mikulu yenye ngome. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.23"
              },
              "items": [
                {
                  "text": "1 Afalume 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dzulu ya chila chidzango na tsini ya chila muhi wenye makodza maitsi, adzenga nguzo za mawe na vizuka vya Ashera, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na achifukiza uvumba kpwenye mwatu mosi mwa dzulu mwa kuabudu na kulavira sadaka milungu ya handzo kpwa kulunga mila za mataifa ganjina ambago gazoreswa ni Mwenyezi Mlungu mbere zao. Amreyeza Mwenyezi Mlungu na mahendo gao mai, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na achihumikira vizuka ambavyo Mwenyezi Mlungu kala akaakahaza achiaambira, “Msihende dzambo hiri.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzagbwe Mwenyezi Mlungu wahuma manabii na aonadzi a mambo kukanya tsi ya Iziraeli na ya Juda achiamba, “Richani njira zenu mbii mlunge malagizo gangu na masharuti gangu kulengana na shariya nirizoapha akare enu, na ambazo nakuphani mwimwi kutsupira atumishi angu manabii.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nyo taayalunga, akala a likani dza akare aho ambao taayamuamini Mwenyezi Mlungu, Mlungu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anema masharutige, na chilagane arichoika na akare aho na maonyo arigo aonya, achiabudu vizuka visivyokala na mana hata aho enye achikala taana mana tsona. Alunga mila za mataifa ganjina garigoazunguluka ambago Mwenyezi Mlungu walagiza kukala asigalunge mfwano wao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1 Afalume 12:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Arema malagizo gosi ga Mwenyezi Mlungu, Mlungu wao. Atengeza vizuka vya milungu ya ana ngʼombe airi a madini ga kuyayushwa, achitengeza vizuka vya Ashera, achiabudu vitu vyosi virivyo mlunguni na achimuhumikira Baali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10"
              },
              "items": [
                {
                  "text": "Kumbukumbu 18:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alavya ana aho a chilume na a chichetu kukala sadaka ya kuochwa kpwa milungu ya handzo, apiga mburuga na achiloga. Adzilavya tsetsetse kuhenda mai mbere za Mwenyezi Mlungu, achimreyeza sana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Mwenyezi Mlungu watsukizwa sana ni atu a Iziraeli na achiatsamiza kure na iye, kayasaza mutu yeyesi isiphokala mbari ya Juda macheye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hata atu a Juda nao taayalunga malagizo ga Mwenyezi Mlungu, Mlungu wao ela alunga mila zorehwa ni atu a Iziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Mwenyezi Mlungu achiakahala Aiziraeli osi, achiagayisa na kuaricha kpwenye mikono ya atu a kuateka hadi achiazoresa kamare kula phakpwe matsoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya Mwenyezi Mlungu kuatenganisha Iziraeli kula nyumba ya Daudi amuika Jeroboamu mwana wa Nebati kukala mfalume. Naye Jeroboamu waahenda atu a Iziraeli ariche Mwenyezi Mlungu na kuhenda dambi kulu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiziraeli ahenda dambi zosi Jeroboamu arizohenda. Taayaziricha ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hadi mwishowe Mwenyezi Mlungu achiazoresa kula phakpwe matsoni, dza vyo arivyokala akaamba kutsupira atumishie osi, manabii. Kpwa hivyo atu a Iziraeli atsamizwa kula kpwa tsi yao enye hadi tsi ya Ashuru ambako anasagala hata rero.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona mfalume wa Ashuru wareha atu kula Babeli, Kutha, Ava, Hamathi na Sefarivaimu na kuaika midzi ya Samariya phatu pha atu a Iziraeli ariotsamizwa. Aihala midzi iyo na achikala himo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi ariphoandza kukala himo, taayamuogopha Mwenyezi Mlungu, kpwa hivyo Mwenyezi Mlungu wahuma simba kahi yao, na atu anjina achiolagbwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu atu amuambira mfalume wa Ashuru, “Mataifa ganjina urigogahala na kugaika midzi ya Samariya tagamanya shariya za Mlungu wa tsi hiyo, pho ndipholola, Mlungu hiye wahuma simba ambao anaaolaga, manage taamanya shariya za Mlungu wa tsi hiyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho mfalume wa Ashuru achiamuru hivi, “Uyizani mlavyadzi-sadaka mmwenga kahi ya hara hurioareha kula hiko, naaphiye akakale hiko ili aafundze atu shariya ya Mlungu wa tsi hiyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho, mmwenga wa alavyadzi-sadaka ariokala akatsamizwa kula Samariya waphiya na achendakala Betheli, achiafundza atu vira ilondwavyo kumuogopha Mwenyezi Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela chila taifa bado adzitengezera milungu yao na kuyiika mwatu mwa dzulu mwa kuabudu ambamo atu a Samariya kala akatengeza, chila taifa rakala na mwatumwe kpwenye mudzi arimoishi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a Babeli atengeza chizuka cha Sukothi-Benothi, atu a Kutha achitengeza chizuka cha Nerigali na atu a Hamathi achitengeza chizuka cha Ashima, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "atu a Ava achitengeza vizuka vya Nibuhazi na vya Taritaki na Asefarivaimu alavya ana aho kukala sadaka za kuochwa kpwa milungu yao Adirameleki na Anameleki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo atu hinya amuogopha Mwenyezi Mlungu. Ela piya atsambula kula kahi yao atu a chila aina, achiahenda alavyadzi-sadaka, ahumike mwatu mwa dzulu mwa kuabudu kpwa ajili yao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo amuogopha Mwenyezi Mlungu, ela piya achihumikira milungu yao, sawa-sawa na kawaida za mataifa ganjina arikola.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
