              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28+1KI.12.29+1KI.12.30"
              },
              "items": [
                {
                  "text": "1 Afalume 12:28–30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela kayaricha dambi zira za Jeroboamu mwana wa Nebati ambaye waahenda Aiziraeli amenye dambini, yani hira ibada ya vizuka vya ana ngʼombe a zahabu hiko Betheli na Dani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.29",
            "verseOrgIds": [
              "2KI.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
