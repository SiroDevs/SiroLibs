          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati hinyo Mwenyezi Mlungu waandza kuphunguza eneo ra tsi ya Iziraeli. Mfalume Hazaeli wa Aramu washinda tsi yosi ya Iziraeli ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kula uphande wa mlairo wa dzuwa wa muho Joridani, tsi za Giliadi, ya Agadi, ya Arubini na ya Amanase na kula mudzi wa Aroeri urio phephi na dete ra Arinoni, yani Giliadi na Bashani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        }
      ]
    },
    {
