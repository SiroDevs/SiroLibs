          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivi ndivyo Jehu arivyoangamiza ibada za Baali kpwenye tsi ya Iziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.28",
            "verseOrgIds": [
              "2KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 10:29"
          },
          "items": [
