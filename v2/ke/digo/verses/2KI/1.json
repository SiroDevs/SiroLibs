          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:8",
              "type": "text"
            },
            {
              "text": "Au",
              "type": "text"
            },
            {
              "text": "Kala ni mutu mwenye nyere nyinji mwakpwe mwirini.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na mkanda wa chingo chibiruni.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
