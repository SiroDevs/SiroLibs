      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amjibu achiamba, “Hukakutana na mutu ambaye akahuamba, ‘Uyani kpwa mfalume chiyekuhumani mkamuambe Mwenyezi Mlungu akaamba hivi, “Kpwa utu wani unahuma atu kpwa Baali-Zebubu, mlungu wa Ekironi? Kpwani takuna Mlungu kuno tsi ya Iziraeli? Kpwa sababu iyo phahi, kundatiya pho chitandani uripho. Kpwa kpweli undafwa.” ’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
