          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa Mwenyezi Mlungu achimuambira Elija, “Teremuka phamwenga naye, wala usimuogophe.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        }
      ]
