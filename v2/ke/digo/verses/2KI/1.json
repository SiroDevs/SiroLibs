          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Elija waunuka, achiteremuka phamwenga naye hadi kpwa mfalume. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
