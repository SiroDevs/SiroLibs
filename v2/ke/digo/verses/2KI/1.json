                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao amjibu achiamba; “Kala akavwala nguwo zoshonwa na nyoya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        },
