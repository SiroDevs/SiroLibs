          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho, Gehazi wauka mbere za Elisha kuno akagbwirwa ni mahana, hata akakala mwereru dza bafuta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
