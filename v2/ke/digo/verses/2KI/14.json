              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa sababu Mwenyezi Mlungu waona vira Aiziraeli arivyogaya sana, atumwa na hata atu huru, mana takuyakala na mutu yeyesi wa kuaterya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Mwenyezi Mlungu kayaamba kukala andaangamiza tsetsetse Aiziraeli, auke tsini ya dzuwa, hipho waativya kpwa mkpwono wa mfalume Jeroboamu wa phiri mwana wa Jehoashi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
