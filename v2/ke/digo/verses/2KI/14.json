          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboamu mwana wa Jehoashi, mfalume wa Iziraeli, waandza kutawala, mwaka wa kumi na tsano wa utawala wa Amaziya mwana wa Joashi, mfalume wa Juda. Watawala kula Samariya na watawala kpwa muda wa miaka mirongo mine na mwenga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahenda mai mbere za Mwenyezi Mlungu, kayaricha zira dambi zosi za Jeroboamu mwana wa Nebati ambaye waahenda atu a Iziraeli amenye dambini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.1.1"
              },
              "items": [
                {
                  "text": "Jona 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakombola tsi yosi yokala ya Iziraeli, kula phatu pha kumenyera Hamathi hadi Bahari ya Munyu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:25",
              "type": "text"
            },
            {
              "text": "Bahari ya Munyu piya kala nkuihwa",
              "type": "text"
            },
            {
              "text": "Bahari ya Araba.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hivi ndivyo Mwenyezi Mlungu, Mlungu wa Iziraeli arivyogomba kutsupira mtumishiwe Jona mwana wa Amitai, nabii kula Gathi-Heferi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        }
      ]
