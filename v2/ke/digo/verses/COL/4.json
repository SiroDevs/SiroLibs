                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfungbwa myangu aihwaye Aristariko, na Mariko ambaye ni mʼbari wa Barinaba, akakuphozani. Ichikala Mariko andakpwedza hiko kpwenu, phahi msiyale kumkaribishato kama murivyoambwa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piya Joshuwa ambaye dzina ranjina ni Justo akakuphozani. Aristariko, Mariko na Joshuwa ndio Ayahudi bahi, ambao ananiterya kuhenda kazi ya ufalume wa Mlungu. Nao ananitiya moyo sana. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.7"
              },
              "items": [
                {
                  "text": "Akolosai 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.23"
              },
              "items": [
                {
                  "text": "Filemoni 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Piya mkaphozwa ni Epafara, mutu wa ko kpwenu, ambaye anamuhumikira Jesu Muokoli. Chila wakati anakuvoyerani sana, mzidi kumkuluphira Mlungu na mkale na uhakika wa gosi ambago anamendza. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuambirani kpweli mana námuona vira arivyokuhenderani kazi kpwa chadi, mwimwi na ayawenu a midzi ya Laodikia na Hierapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.11"
              },
              "items": [
                {
                  "text": "2 Timothi 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.24"
              },
              "items": [
                {
                  "text": "Filemoni 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.10"
              },
              "items": [
                {
                  "text": "2 Timothi 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.24"
              },
              "items": [
                {
                  "text": "Filemoni 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mkaphozwa ni Dema phamwenga na Dakitari Luka, hummendzaye sana.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        }
      ]
    },
    {
