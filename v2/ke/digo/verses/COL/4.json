              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tikiko ni mfuasi myawehu amendzwaye sana. Hunahenda naye kazi ya Bwana Jesu, tsona ananiterya na ni mutu ambaye naweza kumuadamira. Naye andakuambirani niendereravyo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namuhuma edze akuambireni vira huendereravyo na piya akutiyeni moyo ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.10+PHM.1.11+PHM.1.12"
              },
              "items": [
                {
                  "text": "Filemoni 1:10–12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Piya aredza na Onesimasi, mfuasi myawehu amendzwaye sana na ni mutu wa kuadamira. Hiyu ni wa ko kpwenu. Osi airi andakpwedza akuambireni mambo gosi garigo hiku.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        }
