                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.19"
              },
              "items": [
                {
                  "text": "Luka 12:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.32"
              },
              "items": [
                {
                  "text": "1 Akorintho 15:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takuna dzambo nono zaidi kpwa mwanadamu kuriko kurya, kunwa na kudziburudisha na mapato ga kaziye. Gaga nago námanya gala mikononi mwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.24",
            "verseOrgIds": [
              "ECC.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana bila ya iye, mutu kaweza kuphaha chakurya au kudziburudisha? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
              "ECC.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.32.8"
              },
              "items": [
                {
                  "text": "Ayubu 32:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.2.6"
              },
              "items": [
                {
                  "text": "Misemo 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mlungu nkumupha ikima, marifwa na furaha mutu amuhamiraye. Ela kpwa mwenye dambi nkumupha kazi za kuvuna na kuika phamwenga, chisha akamupha yuyatu amuhamiraye. Gaga nago ganasinya, ni sawa na kuzoresa phepho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.26",
            "verseOrgIds": [
              "ECC.2.26"
            ]
          }
        }
      ]
