                {
                  "text": "1 Afalume 4:29–31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi náaza nchiamba, “Náphaha ikima kuriko osi ariotanguliya kutawala ko Jerusalemu. Nao moyo wangu ukamanya ikima na marifwa ni chitu chani.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Náhenda chadi cha kumanya ikima ni chitu chani na koma na uzuzu ni utu wani. Nchielewa kukala higo gosi piya ni dza kuzoresa phepho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
      ]
    }
