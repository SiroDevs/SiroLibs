              "ROM.10.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.21"
              },
              "items": [
                {
                  "text": "Kumbukumbu 32:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Swali ranjina ni hiri: Dze, Aiziraeli taayaelewa? Mwandzo Musa waamba, “Nindakuhendani muaonere wivu atu ambao sio Ayahudi, nindakutsukizani kpwa kuhumira taifa risiro na ufahamu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.1"
              },
              "items": [
                {
                  "text": "Isaya 65:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tsona nabii Isaya anagomba chilume maneno ga Mlungu gaambago, “Atu ambao taayaniendza, ndio arioniona. Nádzimanyisa kpwa atu ambao kala taaniuzira.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.20",
            "verseOrgIds": [
              "ROM.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
