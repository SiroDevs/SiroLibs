                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.17"
              },
              "items": [
                {
                  "text": "Mariko 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.25"
              },
              "items": [
                {
                  "text": "Luka 20:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata hino ni sababu ya kulavya kodi. Mana ahendadzi-kazi a sirikali ni atumishi a Mlungu, na ni lazima ahende kazi ambazo Mlungu waapha azihende. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi mupheni chila mutu hakiye. Ichikala unatakpwa uriphe kodi, ni uriphe; ichikala kuna mutu fulani ni aishimiwe, phahi muishimuni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msikale na deni na mutu yeyesi, ela deni renu narikale kumendzana bahi. Mana ammendzaye myawe anatimiza Shariya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.8",
            "verseOrgIds": [
              "ROM.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.13+EXO.20.14+EXO.20.15+EXO.20.16+EXO.20.17"
              },
              "items": [
                {
                  "text": "Kutsama 20:13–17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17+DEU.5.18+DEU.5.19"
              },
              "items": [
                {
                  "text": "Kumbukumbu 5:17–19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Alawi 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuna malagizo manji, kpwa mfwano, usizinge, usiolage, usiiye, usimizire mahe chitu cha myao na malagizo ganjina. Ela gosi higa ga ndani ya hiro lagizo mwenga riambaro, “Mmendze myao dza vyo udzimendzavyo mwenye.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu amendzaye myawe, kamuhendera mai, kpwa hivyo mendzwa inatimiza Shariya zosi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaidi ya hivyo ni mmanye wakati wa kulamuka ukafika. Kpwa sababu wakati wa kutivywa u phephi zaidi kuriko hipho mwandzo huriphoanza kumkuluphira Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivi usiku unasira, na ku phephi na kucha. Sambi nahuricheni mahendo mai ga jiza na huvwaleni silaha za mwanga ili hudzirinde na Shetani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hukaleni na tabiya nono dza viratu wakati wa namutsi, wala husikaleni atu akuhenda sharee za kunwa uchi na kufwiha chimalaya, wala kuzinga, wala kuheha au wivu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela phahi katika mambo gosi longozwani ni Bwana Jesu Masihi, wala msikubali kutimiza tamaa zenu mbii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
        }
      ]
    }
  ],
