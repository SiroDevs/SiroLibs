          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niphozerani Ampuliato, msena wangu kpwa sababu ya Bwana Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.8",
            "verseOrgIds": [
              "ROM.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "phamwenga na msena wangu Sitakisi, na muhendadzi-kazi myangu Uribano, ahendaye kazi ya kumuhumikira Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.9",
            "verseOrgIds": [
              "ROM.16.9"
            ]
          }
        }
      ]
