          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona niphozerani Asunikirito, Fulegoni, Herime, Patiroba, Herima, na afuasi a Jesu osi ario phamwenga nao.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.14",
            "verseOrgIds": [
              "ROM.16.14"
            ]
          }
        }
      ]
