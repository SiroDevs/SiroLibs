          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niphozerani Tirufena na Tirufosa; achetu hinyo anahenda kazi kpwa chadi kumuhumikira Bwana Jesu. Piya niphozerani msena wangu Pashia; naye ni mchetu ambaye wahenda manji kumuhumikira Bwana Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        }
