            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niphozerani ahendadzi-kazi ayangu, Prisila phamwenga na mlumewe Akpwila. Aho nao anahenda kazi ya kumuhumikira Jesu Muokoli, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.3",
            "verseOrgIds": [
              "ROM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tsona ahatarisha maisha gao kpwa sababu yangu. Phahi mimi na afuasi osi ambao sio Ayahudi anafwaha kuashukuru sana.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.4",
            "verseOrgIds": [
              "ROM.16.4"
            ]
          }
        }
      ]
    },
    {
