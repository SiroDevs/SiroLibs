          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niphozerani mʼbari wangu Herodioni, na atu osi a nyumbani mwa Narikiso, ambao adziunga na Bwana Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        }
      ]
