          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niphozerani Apele, ambaye uaminifuwe kpwa Jesu unamanyikana. Na niphozerani atu osi a nyumbani mwa Aristobulo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        }
      ]
