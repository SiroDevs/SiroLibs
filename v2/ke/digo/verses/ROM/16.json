              "items": [
                {
                  "text": "Mahendo 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaphozwa ni Timothi ambaye ni muhendadzi-kazi myangu. Piya mkaphozwa ni abari angu Lukio, Jasoni na Sosipatiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambi mimi Teritio, muandishi wa baruwa hino, nakuphozani kpwa sababu ya Bwana Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.22",
            "verseOrgIds": [
              "ROM.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.29"
              },
              "items": [
                {
                  "text": "Mahendo 19:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.14"
              },
              "items": [
                {
                  "text": "1 Akorintho 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.20"
              },
              "items": [
                {
                  "text": "2 Timothi 4:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mkaphozwa ni mwenyezi wangu Gayo, ambaye piya ni mwenyezi wa afuasi osi a Jesu akutanao hipha. Piya mkaphozwa ni Erasito, ambaye ni muiki wa pesa wa mudzi hinyu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:23",
              "type": "text"
            },
            {
              "text": "Mudzi hinyo labuda kala ni mudzi wa Korintho.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na mwenehu wehu Kpwarito piya akakuphozani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuvoyerani Bwana Jesu Masihi akujaliyeni mosi. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.24",
            "verseOrgIds": [
              "ROM.16.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:24",
              "type": "text"
            },
            {
              "text": "Vitabu vyanjina vya kare tavina msitari huno wa 24.",
              "type": "text"
            }
          ]
        }
      ]
    },
