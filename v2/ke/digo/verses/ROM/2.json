                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.37"
              },
              "items": [
                {
                  "text": "Luka 6:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi myangu, nakuambira kpweli, kuna haki ya kuamula myao, hata ichikala ni ani. Kpwa mana uchiamula myao umanye kala, unadziamula mwenye. Mana gago gakpwe mai ahendago ndigouhendago hata uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.1",
            "verseOrgIds": [
              "ROM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambi hunamanya kukala uamuli wa Mlungu kpwa atu ahendao mambo mai, ni ya haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.2",
            "verseOrgIds": [
              "ROM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi mwenehu, uchiamula myao alafu nawe uchihenda gago mai, usione Mlungu andakuricha. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.3",
            "verseOrgIds": [
              "ROM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ni mnono mana anakuonera mbazi nyinji, kakutiya adabu mara mwenga ela anakuvumirira ili utubu dambizo. Haya sambi mbona unamphurya? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.4",
            "verseOrgIds": [
              "ROM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela kpwa sababu u chisoto na kukubali kukala una dambi, unadziikira adabu kali wakati uamuli wa haki ya Mlungu ndiphokala wazi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.5",
            "verseOrgIds": [
              "ROM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.5",
            "verseOrgIds": [
              "ROM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.6",
            "verseOrgIds": [
              "ROM.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.62.12"
              },
              "items": [
                {
                  "text": "Zaburi 62:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.12"
              },
              "items": [
                {
                  "text": "Misemo 24:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati hinyo Mlungu andamripha chila mmwenga kulengana na mahendoge. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.6",
            "verseOrgIds": [
              "ROM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu andaapha uzima hinyo anaodinisa kuhenda manono, kpwa sababu anaendza nguma na ishima kula kpwa Mlungu, na piya uzima wa kare na kare. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.7",
            "verseOrgIds": [
              "ROM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela atu achoyo na ndiorema ukpweli, na kuhenda mai, Mlungu andaatsukirirwa na aatiye adabu kali. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.8",
            "verseOrgIds": [
              "ROM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chila mutu ndiyehenda mambo mai andaphaha tabu na mateso, kuandzira Ayahudi na hata atu asio kala Ayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.9",
            "verseOrgIds": [
              "ROM.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela osi ahendao manono, Mlungu andaapha nguma, ishima na amani, kuandzira Ayahudi na hata atu asio kala Ayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.10",
            "verseOrgIds": [
              "ROM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Kumbukumbu 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana Mlungu kaonera mutu yeyesi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.11",
            "verseOrgIds": [
              "ROM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.11",
            "verseOrgIds": [
              "ROM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu osi ahendao dambi andaangamizwa, hata dzagbwe taamanya Shariya za Musa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.12",
            "verseOrgIds": [
              "ROM.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:12",
              "type": "text"
            },
            {
              "text": "Shariya za Musa",
              "type": "text"
            },
            {
              "text": ": Manage ni",
              "type": "text"
            },
            {
              "text": "Torati.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na atu amanyao hizo Shariya achihenda dambi, andaamulwa kulengana na zizo Shariya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.12",
            "verseOrgIds": [
              "ROM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andaamulwa mana Mlungu kamupha haki mutu kpwa sababu ya kusikira Shariya bahi, ela anamupha mutu haki kpwa kuhenda gara Shariya ziambago. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.13",
            "verseOrgIds": [
              "ROM.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu ambao sio Ayahudi achihenda vira afikiriavyo na vichigbwa sawa na Shariya ziambavyo, hata dzagbwe Shariya zohewa Musa taazimanya, indaonyesa kala anamanya haki mwao mioyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.14",
            "verseOrgIds": [
              "ROM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahendo gao ganaonyesa kala anamanya kare vira Shariya zilondavyo. Nago maazo gao kano zanjina ganaashitaki na kano zanjina ganaahehera. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.15",
            "verseOrgIds": [
              "ROM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kulengana na hizo habari nono nitangazazo, wakati wa uamuli, Mlungu andamuika Masihi Jesu aamule mambo ga atu garigo siri.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.16",
            "verseOrgIds": [
              "ROM.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.16",
            "verseOrgIds": [
              "ROM.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, uchidziiha u Myahudi hakika unaadamira kuphaha haki kpwa kulunga Shariya, na unahenda ngulu ati u mutu wa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.17",
            "verseOrgIds": [
              "ROM.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa sababu ya kufundzwa kuhusu Shariya, unamanya Mlungu alondavyo na kutsambula ra sawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.18",
            "verseOrgIds": [
              "ROM.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Una hakika kukala unafwaha kulongoza atu asio kala Ayahudi, kama mutu kulongoza vipofu ama kama taa kungʼazira atu jizani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.19",
            "verseOrgIds": [
              "ROM.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona u mwalimu wa anache na atu asiomanya, mana Shariyazo zinakueleza kuhusu marifwa gosi na ilimu ya kpweli. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.20",
            "verseOrgIds": [
              "ROM.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "We mwenye unafundza anjina, ela kuhenda gara ugombago! Unafundza ayao, uchiamba “Usiiye,” ela mbavi we mwenye u muivi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.21",
            "verseOrgIds": [
              "ROM.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe unaambira atu, “Msizinge,” ela mbona we mwenye unazinga? Tsona unawezadze kuzira anaoabudu vizuka ichikala we mwenye unadzitajirisha kpwa kuiya vitu kula nyumba za kuabudira vizuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.22",
            "verseOrgIds": [
              "ROM.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unadzikarya ati unamanya Shariya za Mlungu, ela mbona unahenda atu amkufuru Mlungu kpwa kuvundza Shariyaze? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.23",
            "verseOrgIds": [
              "ROM.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.5"
              },
              "items": [
                {
                  "text": "Isaya 52:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana gaga ganagbwa sawa na Maandiko gaambago, “Atu asio kala Ayahudi anakufuru dzina ra Mlungu kpwa sababu ya mambo mai muhendago mwimwi Ayahudi.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.24",
            "verseOrgIds": [
              "ROM.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.24",
            "verseOrgIds": [
              "ROM.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayahudi osi a chilume nkutiywa tsatsani,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.25",
            "verseOrgIds": [
              "ROM.2.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:25",
              "type": "text"
            },
            {
              "text": "Kutiywa tsatsani kala ni dalili ya chimwiri kuonyesa chilagane cha Mlungu na atue. (Soma chitabu cha",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17"
              },
              "items": [
                {
                  "text": "Mwandzo 17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".)",
              "type": "text"
            }
          ]
        },
        {
          "text": " nayo tsatsa ina mana tu ichikala mutu andalunga Shariya. Ela mutu achivundza Shariya, tsatsaye taina mana yoyosi, na ni sawa na mutu ambaye kayatiywa tsatsani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.25",
            "verseOrgIds": [
              "ROM.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi mutu ambaye kayatiywa tsatsani achilunga vyo Shariya zilondavyo, Mlungu andamkubali dza mutu yetiywa tsatsani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.26",
            "verseOrgIds": [
              "ROM.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona mutu ambaye kayatiywa tsatsani, achilunga vyo Shariya ziambavyo, mahendoge manono gandakutuluzani makosa mwi Ayahudi. Mana mwatiywa tsatsani, na zo Shariya munazo, ela tamzilunga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.27",
            "verseOrgIds": [
              "ROM.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi siye chila mutu ariyevyalwa Myahudi ni Myahudi mwenye-mwenye, wala mutu kakala Myahudi wa kpweli kpwa kutiywa tsatsani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.28",
            "verseOrgIds": [
              "ROM.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.6"
              },
              "items": [
                {
                  "text": "Kumbukumbu 30:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata! Myahudi wa kpweli ni iye amuogophaye Mlungu mwakpwe moyoni. Nayo tsatsa ya kpweli ni tsatsa ya moyo, yohendwa ni Roho Mtakatifu, wala si kpwa kulunga Shariya. Mutu dza hiye anaphaha nguma kula kpwa Mlungu wala si kpwa anadamu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.29",
            "verseOrgIds": [
              "ROM.2.29"
            ]
          }
        }
