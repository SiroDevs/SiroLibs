                "loc": "HOS.2.23"
              },
              "items": [
                {
                  "text": "Hosea 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndani ya Chitabu cha nabii Hosea, Mlungu anaamba hivi:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
