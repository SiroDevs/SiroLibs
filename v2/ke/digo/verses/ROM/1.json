              "ROM.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.38"
              },
              "items": [
                {
                  "text": "Mariko 8:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hizo habari nono ni uwezo wa Mlungu wa kuokola atu osi akuluphirao, mwandzo ni Ayahudi na phiri ni atu asio kala Ayahudi. Phahi mino siona haya hata chidide kuzitangaza, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.4"
              },
              "items": [
                {
                  "text": "Habakuki 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mana zinaonyesa wazi vira Mlungu ahendavyo atu akale na haki. Atu anaphaha haki kpwa kukuluphira bahi, kama Maandiko gaambavyo, “Mutu ahendwaye kukala na haki ni Mlungu andaishi kpwa kukuluphira.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu mwenye waonyesa wazi kukala indabidi aatiye adabu kali atu osi ambao taamuogopha na ambao kpwa sababu ya ndzimo zao mbii anapinga ukpweli wa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wala siyo kukala taamanya rorosi kuhusu Mlungu, mana gara ambago gangemanywa ga wazi, kpwa vira ye Mlungu mwenye wagaonyesa atu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana hangu mwandzo wa dunia, Mlungu waumba chila chitu kpwa njira ambayo hata dzagbwe atu taamuona, anaweza kuelewa vira arivyo. Hasa vitu arivyoumba vinaonyesa kukala Mlungu ana uwezo hata kare na kare, na ndiye Mlungu macheye, wala takuna wanjina. Ndiyo mana atu taaweza kudai kukala taammanya Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.17+EPH.4.18"
              },
              "items": [
                {
                  "text": "Aefeso 4:17–18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana hata dzagbwe ammanya Mlungu arivyo, ela taamtogola wala kumshukuru kama anavyostahili. Badala ya hivyo, maazo gao gakala mai na achili zao ni uzuzu muhuphu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enye adzikarya kala ni alachu, ela akala azuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.16+DEU.4.17+DEU.4.18"
              },
              "items": [
                {
                  "text": "Kumbukumbu 4:16–18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana aricha kumuabudu Mlungu na achiabudu vizuka vyoigana na binadamu, nyama, nyama a mapha na viumbe vya kuambala photsi ambavyo taviweza kuishi hata kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
