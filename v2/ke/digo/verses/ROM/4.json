            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.5"
              },
              "items": [
                {
                  "text": "Mwandzo 15:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Burahimu naye ariphoambwa, “Uvyazio undakala munji dza viratu nyenyezi,” dzambo hiro kala tariwezekana. Ela waenderera kumkuluphira Mlungu, na kpwa hivyo wakala mkarengbwa wa mataifa manji, kama arivyolagbwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.17"
              },
              "items": [
                {
                  "text": "Mwandzo 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati uho Burahimu wakala na miaka kama gana mwenga, na wamanya kala mwiriwe kala avi ukafwa na mchewe Sara kala ni tasa. Ela hata hivyo kuluphirore tariyaphunguka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
            "verseOrgIds": [
              "ROM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona Burahimu kayakala na wasiwasi wowosi kuhusu chilagane cha Mlungu. Ela wazidi kumkuluphira na kumtogola, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.20",
            "verseOrgIds": [
              "ROM.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
