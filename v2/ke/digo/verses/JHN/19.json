          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phephi na phapho phokotwa Jesu msalabani kala phana munda. Himo mundani kala muna mbira nyiphya ambayo kala taidzangbwezikpwa mutu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:41",
              "type": "text"
            },
            {
              "text": "Ayahudi mila yao, kala achitsimba mbira zao kama pango.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa vira kala siku ya Chiyahudi ya Matayarisho, na kpwa kukala yo mbira kala i phephi, aika mwiri wa Jesu mumo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
