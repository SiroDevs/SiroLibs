        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu okala aimire phephi na hura msalaba kala ni ninengbwa wa Jesu na mwanáo mchetu wa nine, phamwenga na Maryamu mkpwaza Kileopa, Maryamu kula Magidala, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.25",
            "verseOrgIds": [
              "JHN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwanafundzi yemendzwa sana ni Jesu. Jesu ariphoona nine aimire phephi na ye mwanafundziwe, wamuamba, “Sikiza Mayo, mwanao hiye.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho achimgalukira yuya mwanafundzi, achimuamba, “Mwenehu, mayoo hiye!” Kula hipho nine wakpwendasagala kaya kpwa yuya mwanafundzi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        }
      ]
    },
