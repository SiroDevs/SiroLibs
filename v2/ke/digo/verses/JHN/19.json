                "loc": "PSA.34.20"
              },
              "items": [
                {
                  "text": "Zaburi 34:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mambo higa gahendeka ili Maandiko gatimiye gaambago, “Kana hata mfupha mmwenga ndiovundzwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.10"
              },
              "items": [
                {
                  "text": "Zakariya 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Maono 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Maandiko ganjina ganaamba, “Atu andamlola iye ariyemdunga fumo.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        }
      ]
