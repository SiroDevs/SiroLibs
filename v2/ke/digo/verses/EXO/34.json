        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "34:22",
              "type": "text"
            },
            {
              "text": "Sikukuu ya mavuno",
              "type": "text"
            },
            {
              "text": "wakati wa Jesu, sikukuu iyo yamanyikana kama Pentekosti.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwandzo-mwandzo wa minga ya kuvuna nganu, na kusherekeya sikukuu ya kukusanya",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "34:22",
              "type": "text"
            },
            {
              "text": "Sikukuu ya kukusanya",
              "type": "text"
            },
            {
              "text": "sikukuu iyo kala ichisherekeywa mwisho wa mwaka bada ya kuvuna chila chitu kabila ya mvula kuandza kunya. Piya kala ichiihwa sikukuu ya vibanda.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwisho wa mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alume osi andakutana mbere za Mwenyezi Mlungu, Mlungu wa Aiziraeli, kano tahu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "34:23",
              "type": "text"
            },
            {
              "text": "Kano tahu,",
              "type": "text"
            },
            {
              "text": "sikukuu tahu ni",
              "type": "text"
            },
            {
              "text": "sikukuu ya mikahe isiyotiywa hamira, sikukuu ya majuma, na sikukuu ya kukusanya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kpwa mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takuna mutu ndiye mizira mahe tsi yenu wakati mchisherekeya sikukuu hizi tahu mbere za Mwenyezi Mlungu, Mlungu wenu. Kpwa sababu nindazola mataifa ganjina manji mbere zenu na nindapanula miphaka yenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
    },
