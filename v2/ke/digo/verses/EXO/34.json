              "attrs": {
                "loc": "NUM.28.16+NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Isabu 28:16–25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Sherekeyani Sikukuu ya mikahe isiyotiywa hamira. Kpwa siku sabaa ryani mikahe isiyokala na hamira, kama nrivyokulagizani. Hendani hivi chila wakati wa mwezi wa Abibu, sababu ndio mwezi muriotsama Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        }
