                "loc": "EXO.20.4"
              },
              "items": [
                {
                  "text": "Kutsama 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.4"
              },
              "items": [
                {
                  "text": "Alawi 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.8"
              },
              "items": [
                {
                  "text": "Kumbukumbu 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.15"
              },
              "items": [
                {
                  "text": "27:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Msidzitengezere milungu ya chuma na kuiabudu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        }
      ]
    },
