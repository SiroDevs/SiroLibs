              "items": [
                {
                  "text": "Kutsama 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Chila mvyalwa wa kpwandza mlume ni wangu. Vivyo hivyo avyalwa a kpwandza a chilume a nyamao osi, ngʼombe na mangʼondzi, ni angu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.13"
              },
              "items": [
                {
                  "text": "Kutsama 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mvyalwa wa kpwandza wa punda munaweza kumkombola na mwana ngʼondzi. Ela ichikala kundamkombola undamuolaga kpwa kumvundza singo. Ana enu a kpwandza a chilume akomboleni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
