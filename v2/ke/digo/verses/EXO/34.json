            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 34:29"
          },
          "items": [
