          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu achimjibu achimuamba, “Haya tserera ukamuhale Aruni wedze naye. Ela alavyadzi-sadaka na atu osi asikale na lazima kutsupa mphaka, kpwedza hiku dzulu niriko mimi Mwenyezi Mlungu, ama nindaatiya adabu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.24",
            "verseOrgIds": [
              "EXO.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
