            "number": "25",
            "style": "v",
            "sid": "EXO 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo Musa watserera hata ko tsini kokala na nyo atu achendaambira atu vyokala akalagizwa ni Mlungu.",
          "type": "text",
