              "EXO.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achiarehera ukongo hinyo atu chisa amuhenda Aruni aumbe mwana ndzau wa zahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.35",
            "verseOrgIds": [
              "EXO.32.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32:35",
              "type": "text"
            },
            {
              "text": "Mana ganjina ga chifungu hichi Chieburania ni,",
              "type": "text"
            },
            {
              "text": "na Mwenyezi Mlungu achiarehera ukongo chisa ni gara mahendo arigohendera yuya mwana ndzau ariyeumbwa ni Aruni.",
              "type": "text"
            }
          ]
        }
      ]
