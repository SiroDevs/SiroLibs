            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye andahenda mioyo ya ano baba ierekezane na ya ana ao na mioyo ya ana ierekezane na ya ise zao, sedze iyo tsi nkedzaitiya lana.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
