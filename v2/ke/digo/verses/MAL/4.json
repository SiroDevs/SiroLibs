                }
              ]
            }
          ]
        },
        {
          "text": "Lolani nindamhuma nabii Elija edze kpwenu kabila ya iyo siku ya Mwenyezi Mlungu kpwedza. Siku iyo indakala kulu na ya kuogofya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
