        },
        {
          "text": "Wakati hinyo-hinyo hiko Antiokia kpwakpwedza manabii kula Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.27",
            "verseOrgIds": [
