          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afuasi akata shauri chila mmwenga atsange chochosi kulengana na uwezowe kuterya afuasi ayawao okala anaishi Judea. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.29",
            "verseOrgIds": [
              "ACT.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
