          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waguza mundawe na pesaze achizilavya kpwa mitume.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.37",
            "verseOrgIds": [
              "ACT.4.37"
            ]
