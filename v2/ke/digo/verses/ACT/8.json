              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.35",
            "verseOrgIds": [
              "ACT.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati kala anaenderera na charo chao, afika phatu ambapho kala phana madzi. Ndipho yuya muandishi achimuamba Filipu, “Lola, madzi higa. Kpwa utu wani nisibatizwe?” [ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.36",
            "verseOrgIds": [
              "ACT.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipu achimuamba, “Uchiamini chikpweli rohoni, unaweza kubatizwa.” Yuyu mutu achiamba, “Naamini kala Jesu Masihi ndiye Mwana wa Mlungu.”] ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi wamuamba mtumishiwe aimise rira gari. Alafu osi airi, Filipu na yuya muandishi, atserera tsini madzini, na Filipu achimʼbatiza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.38",
            "verseOrgIds": [
              "ACT.8.38"
            ]
          }
        }
      ]
    },
