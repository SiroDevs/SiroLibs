                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuya muandishi kala anasoma neno ra Mlungu riambaro:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
