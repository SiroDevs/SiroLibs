    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bahomibwa mushisambilo shiomulilo omululumo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi Nebukadineza yakasia eshifwanani shieitsahaabu, eshia oburambi bwashio bwahela amakhono amakhumi kasasaba, nobuchiikha amakhono kasasaba; nashisiniisia khumuhololookhwe kwaDura, mulukongo lwaBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nebukadineza narumana okhukhung'aasia abaami, nabasinjilili, nabakafuna, nabakofu beshiina, nababiishi bamapeesa, nabayaasii, nabamakuru, naboburuchi bosi betsingongo, mbu beetse mumulukha kwokhwahula eshifwanani tsana eshia omuruchi Nebukadineza yali nasinjisiye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.2",
            "verseOrgIds": [
              "DAN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaami, nabasinjilili, nabakafuna, nabakofu beshiina, nababiishi bamapeesa, nabayaasii, nabamakuru, naboburuchi bosi betsingongo nibakhung'aana khumulukha kwokhwahula eshifwanani eshia omuruchi Nebukadineza yali nasinjisiye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuupi womulome nalanjisia, ari Inywe abetsimbia namahanga nabetsinimi, mulakwa muri nanwa; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "khushise shiosi eshia mulahulila amayoosi kolwika, nelilele, nelichieng'i, neindongooli, nelitungu, nelimuka, nobukhana bwetsimbia tsiosi, mwikhupe hasi nimwinamila eshifwanani shieitsahaabu eshia omuruchi Nebukadineza yasinjisiye; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne omundu yesi oureekhupa hasi okhushiinamila ta, habwenaho alasukunwa mushisambilo shiomulilo omululumu, mukari bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khushise eshio, olwa abandu bosi bahulila amayoosi kolwika, nelilele, nelichieng'i, neindongooli, nelitungu, nobukhana bwetsimbia tsiosi, abetsimbia tsiosi namahanga netsinimi nibeekhupa hasi nibeenamila eshifwanani shieitsahaabu eshia omuruchi Nebukadineza yali nasinjisiye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khushise eshio abaKalidayo bandi beetsa, nibasitaaka abaYahudi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.8",
            "verseOrgIds": [
              "DAN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibaboolela omuruchi Nebukadineza bari Omwami omuruchi, oyindile obushia nobushia! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami omuruchi, wakhupa omulome nosunga mbu buli mundu ouhulila amayoosi kolwika, nelilele, nelichieng'i, neindongooli, nelitungu, nelimuka, nobukhana bwetsimbia tsiosi, yeekhupe hasi niyeenamila eshifwanani shieitsahaabu tsana; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu omundu yesi oureekhupa hasi okhushiinamila ta, alasukunwa mushisambilo shiomulilo omululumu, mukari bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.11",
            "verseOrgIds": [
              "DAN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne baliho abaYahudi bandi aba waraho khumakhuwa kolukongo lwaBabeli, banga Shadaraka, Meshaki, naAbedinego; nabo, omwami omuruchi, baleka likhuwalio; shibakhalabanila abanyasayebo kata okhwinamila eshifwanani shieitsahaabu eshia wasinjisiye ta.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nebukadineza muburimabwe nomubululubwe yalaka mbu Shadaraka, Meshaki, naAbedinego baleerwe. Kho nibaleera abandu abo imbeli womuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.13",
            "verseOrgIds": [
              "DAN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza nabareeba mbu Inywe Shadaraka, Meshaki, naAbedinego, embulilanga mbu shimukhalabanilanga nyasaye wanje, kata okhwinamila eshifwanani shieitsahaabu eshia ndasinjisiye ta; nitoto, nohomba? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.14",
            "verseOrgIds": [
              "DAN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuba nimwirecheeshe mbu khushise shiosi eshia mulahulila amayoosi kolwika, nelilele, nelichieng'i, neindongooli, nelitungu, nelimuka, nobukhana bwetsimbia tsiosi, okhwikhupa hasi nimwinamila eshifwanani eshia ndakholile, kho nobulayi; ne nimuba nimureenama ta, habwenaho mulasukunwa mushisambilo shiomulilo omululumu, mukari bwene; ne kuli heena omunyasaye kwosi okulamuhonia mumakhono kanje?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.15",
            "verseOrgIds": [
              "DAN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.15",
            "verseOrgIds": [
              "DAN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shadaraka naMeshaki naAbedinego nibakalusia nibasunjila omuruchi bari Omwami Nebukadineza, libulaho elichila nikhukhukalusiamwo mumakhuwa kano ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.16",
            "verseOrgIds": [
              "DAN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye weefwe owa khukhalabanilanga naba nanyala okhukhuhonia mushisambilo shiomulilo omululumu nomumukhonokwo, kho alakhuhonia, omwami omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.17",
            "verseOrgIds": [
              "DAN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne butswa, omwami omuruchi, omanye mbu shikhulakhalabanila abanyasayebo kata okhwinamila eshifwanani tsana eshieitsahaabu eshia wasinjisia ta.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nebukadineza nalula muno, mumonimwe nimukalukhana pe khuShadaraka, Meshaki, naAbedinego; nalachilisia omulilo kweshisambilo kumeetwe akhandi musaafu okhushila okwetsindaalo tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.19",
            "verseOrgIds": [
              "DAN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nalaka abalulu bandi abomwihelie okhuboha Shadaraka, Meshaki, naAbedinego, nokhubasukuna mushisambilo shiomulilo omululumu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.20",
            "verseOrgIds": [
              "DAN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu abo babohwa, nibali netsingubo tsifuubila netsikanzu netsingofia tsiabwe nebiifwalo bindi biosi, nibasukunwa mushisambilo shiomulilo omululumu, mukari bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.21",
            "verseOrgIds": [
              "DAN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhuba lilako liomuruchi liatinyisibwa muno, nashio eshisambilo nishiyiile okhushila, tsimemu tsiomulilo tsieera abandu abo abachinga Shadaraka, Meshaki, naAbedinego. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.22",
            "verseOrgIds": [
              "DAN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu abo bataru, Shadaraka, Meshaki, naAbedinego, nibakwisibwa mushisambilo shiomulilo omululumu nibaboyilwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi Nebukadineza nachenya, nabuukha matetekhana; nareeba abakofu beshiinashie ari Shikhusukuune abandu bataru ababoyilwe mumulilo? Nibakalusia mbu Nitoto, omwami omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabakalusia ari Ne endolanga abandu bane, abalekhuule, abachendanga mumulilo mukari, nikurabatsuuniakhwo ta; ne oyo owakhane mumoni afwana shinga omwana wabanyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        }
      ]
    },
