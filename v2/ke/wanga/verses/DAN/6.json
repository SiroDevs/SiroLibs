    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Danieli mubwina bwetsitalanyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwali okhuchama khwaDario okhwemekha abaami eshikhumi namakhumi kabili khuburuchi, mbu babeho muburuchibwe bwosi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.1",
            "verseOrgIds": [
              "DAN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne hekulu wabwe yaraho abebisaala bataru; ne mulala khubo yali Danieli; mbu abaami abo babakhupilenje tsiripoti, omuruchi aleshe okhufwilwa eshindu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.2",
            "verseOrgIds": [
              "DAN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Danieli uno yamanyikhana okhushila abebisaala bandi nabaami, shichila roho indayi muno yali muye; kata omuruchi yali napaaranga okhumwemekha khuburuchi bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.3",
            "verseOrgIds": [
              "DAN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abebisaala tsana nabaami nibakhaaba obwiyangu okhuyinga Danieli khumakhuwa koburuchi; ne shibanyoola obwiyangu kata eshikha shiosi ta; shichila yali omwisiikwa; kata likosa shilianyoolekha muye, kata eshikha shiosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.4",
            "verseOrgIds": [
              "DAN.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu abo nibasunga mbu Shikhulanyoola obwiyangu bwosi okhuyinga Danieli uno ta, habula nikhulinyoola khuye mumakhuwa kamalako KaNyasayewe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.5",
            "verseOrgIds": [
              "DAN.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.5",
            "verseOrgIds": [
              "DAN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abebisaala abonabaami nibasanjilana okhutsia halala khumuruchi; nibamusunjila bari Omuruchi Dario, oyindile obushia nobushia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.6",
            "verseOrgIds": [
              "DAN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifwe fwesi, abebisaala abomubwamibwo, abasinjilili nabaami, abakofu bebiina nabakafuna, khufuchilisaniye mbu omuruchi akhoyile okhusinjisia obukhalachi bweshiruchi nokhuraho lilako litinyu, mbu omundu yesi ousaba likhuwa liosi khunyasaye yesi kata khumundu mundaalo etsiitsanga amakhumi kataru, habula khwiwe, omwami omuruchi, asukunwe mubwina bwetsitalanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.7",
            "verseOrgIds": [
              "DAN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, omwami omuruchi, nore iseeyi khumahandiiko, mbu lileshe okhukalukhasibwa ta, shinga amalako kabaMedi nabaPerisia olwa kali, akarakalukhananga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.8",
            "verseOrgIds": [
              "DAN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi Dario yaraho iseeyi khumahandiiko nokhwilako tsana.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Danieli yamanya mbu amahandiiko ako kali nikamalile okhureebwakhwo iseeyi, yatsia munzuye; ne amatirisha akomushisikashie eshiahekulu kali nikahenga enaYerusalemu; nasikama amasikamo akhandi khataru buli nyanga, nasaaya, nakhupa orio imbeli waNyasayewe, shinga olwa yali nakholanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.10",
            "verseOrgIds": [
              "DAN.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu balia nibasanjilila okhwitsa halala, nibanyoola Danieli nasabanga nakhola amasaayo imbeli waNyasayewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.11",
            "verseOrgIds": [
              "DAN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasita ahambi khumuruchi, nibasunga imbeliwe khukelilako liomuruchi; bari Omwami omuruchi, shiwaraho iseeyi khwilako, mbu buli mundu ousaba likhuwa khunyasaye yesi kata omundu mundaalo tsino amakhumi kataru, habula khwiwe, omwami omuruchi, alasukunwa mubwina bwetsitalanyi? Omuruchi nakalusia mbu Amakhuwa ako nakatoto, shinga amalako kabaMedi nabaPerisia olwa kali, akarakalukhananga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.12",
            "verseOrgIds": [
              "DAN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibakalusia imbeli womuruchi, bari Danieli oyo, ouli owokhubaare baYuda, waleka likhuwalio, omwami omuruchi, kata lilako elia waraho iseeyi; nebutswa asabanga khataru buli nyanga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.13",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.13",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa omuruchi yahulila amakhuwa ako, yabeelela muno narakhwo omwoyo khukaDanieli, okhumuhonia; nanyakhana okhuula khubwile okhumuhonokosia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.14",
            "verseOrgIds": [
              "DAN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu tsana nibasanjilila okhutsia khumuruchi, nibasunjila omuruchi bari Omwami omuruchi, omanye mbu liliho lilako liabaMedi nabaPerisia, mbu lilako liosi kata obukhalachi bwosi obwa omuruchi araho, shilinyala oknukalukhana ta.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.15",
            "verseOrgIds": [
              "DAN.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.15",
            "verseOrgIds": [
              "DAN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nalaka abandu, nibamuleera Danieli, nibamusukuna mubwina bwetsitaIanyi. Omuruchi nasunjila Danieli ari Nyasayewo owa okhalabanilanga tsindaalo tsiosi alakhuhonia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.16",
            "verseOrgIds": [
              "DAN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lichina nilileerwa, nilireebwa khumunwa kwobwina; omuruchi naliboha naraho eshibalikho shieingakaye, nende eshieingaka yabaamibe, mbu amakhuwa kosi kaDanieli kaleshe okhukalukhasibwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.17",
            "verseOrgIds": [
              "DAN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi natsia ebunanzuwe, namala eshilo eshio nakona inzala, kata naraleerelwa ebiemienya l biosi biosi ta; nafuba tsindoolo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.18",
            "verseOrgIds": [
              "DAN.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.18",
            "verseOrgIds": [
              "DAN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumabwibwi omuruchi yahuuna matetekhana khubwina bwetsitalanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.19",
            "verseOrgIds": [
              "DAN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yoola ahambi khubwina tsana ewa Danieli yali, yalanjisia nomwoyo kwobusaalili, nasunjila Danieli ari Iwe Danieli, omusumba waNyasaye oubeetsangaho mwoyo, Nyasayewo owa okhalabanilanga tsindaalo tsiosi anyalile okhukhuhonia mutsitalanyi noho? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.20",
            "verseOrgIds": [
              "DAN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Danieli nasunjila omuruchi ari Omwami omuruchi, oyindile obushia nobushia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.21",
            "verseOrgIds": [
              "DAN.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye wanje urumile malaikawe nasunia tsitalanyi eminwa, kata shitsikholeele libii ta, shichila imbeliwe enyooleeshe nimbula eshikha; ne kata imbeli wuwo, omwami omuruchi, embula libii liosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.22",
            "verseOrgIds": [
              "DAN.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nasangaala muno, nalaka abandu mbu bamuyinie Danieli mubwina Kho Danieli nayinibwa mubwina, nanyoolwa narakholeelwe libii liosi ta, shichila yali namwisiichile Nyasayewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nalaka abandu, nibaleera abandu tsana abali nibamusitaachile Danieli; nibabasukuna mubwina bwetsitalanyi, halala nabaana babwe nabakhasi babwe; ne kata nibashili okhuula hasi mubwina, tsitalanyi nitsibahula nitsifunaka amakumba kabwe kosi ebitonye ebitonye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.24",
            "verseOrgIds": [
              "DAN.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.24",
            "verseOrgIds": [
              "DAN.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi Dario yahandiichila abetsimbia tsiosi, namahanga, netsinimi, abamenya mushialo shiosi pe; ari Omulembe kumeeteshenje khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
