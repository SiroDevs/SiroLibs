    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunabii naba nabuukha mwinywe, kata omuloori wamalooro, nakhumanyia eshilolelo kata eshiamakana, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.1",
            "verseOrgIds": [
              "DEU.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nashio eshilolelo kata eshiamakana nishiusibwa; mana nakhuboolelakhwo mbu Chenda khulondekhwo abanyasaye bandi, aba oramanyilenje ta, khubakhalabanile; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.2",
            "verseOrgIds": [
              "DEU.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho orahulila amakhuwa komunabii oyo, kata omuloori wamalooro oyo ta; okhuba OMWAMI Nyasaye weenywe amuteemanga, okhumanya nimuba nimuheelanga OMWAMI Nyasaye weenywe nomwoyo kweenywe kwosi nende eshiimo shieenywe shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumulondenjekhwo OMWAMI Nyasaye weenywe, nimumuria, nimulinda amalakoke, nimuhulila amakhuwake, nimumukhalabanila nimumuhandakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.4",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omunabii oyo, kata omuloori wamalooro, yeerwe bwirwa; okhuba yaboolile akeinduli khuMWAMI Nyasaye weenywe, owamurusia mushialo shiaMisiri, nakhununula munzu yobunyakhani, okhukhukhwesa orule khunjila eya OMWAMI Nyasayewo yakhulaka okhuchendakhwo. Nilwo olwa olarusia obubii obuli hakari weenywe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusiani weenywe owomweenyu, kata omwanawo omusiani kata omukhaana, kata omukhasiwo owokhushilifushio, kata omwitsawo ouli shinga omwoyokwo kwene, naba nakhutsuuba mabiswi, ari Chenda khutsie khukhalabanile abanyasaye bandi, aba oramanyilenje, kata iwe kata abakuukabo ta, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.6",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "abokhubanyasaye betsimbia tsiabandu abamubotokhana, ababa nibali ahambi ninawe kata ehale ninawe, okhurula khushihesi shieshialo okhuula khushihesi shindi shieshialo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.7",
            "verseOrgIds": [
              "DEU.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "oramufuchiilila kata okhumuhulila ta; imoniyo yileshe okhumubeela eshisa, kata oramuhonokosia kata okhumubisa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.8",
            "verseOrgIds": [
              "DEU.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa okhwira omwire; omukhono kukwo kube okwambeli khuye okhumwira, nolunyumakhwo amakhono kabandu bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.9",
            "verseOrgIds": [
              "DEU.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulase namachina mbu afwe; shichila yateemile okhukhukhwesa okhurula ewa OMWAMI Nyasayewo, owakhurusia mushialo shiaMisiri, okhurula munzu yobunyakhani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Isiraeli yosi yilahulila, niyiria, niyirakholakhwo obubii obufwana shinga obwo hakari weenywe khandi ta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noba nohulila nikaboolwa khwitaala liosi eliomumataalako aka OMWAMI Nyasayewo akhuheelesia okhumenyamwo, mbu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bandi abamayaanu abeshifwabwi barulile hakari weenywe, nibakhwesa abamenyanga mwitaala liabwe, bari Chende khutsie khukhalabanile abanyasaye bandi, aba muramanyilenje ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.13",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho oreebelesie, orunilisie, noreeba obutinyu; ne lola, niliba nilili eliatoto, nilimanyiishe habwene mbu eshisinyo eshio shiikholanga hakari weenywe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.14",
            "verseOrgIds": [
              "DEU.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho okhurootsa orootse abamenyanga mwitaala elo nolukanga, nolimululila elala, nabalimwo bosi, nemiruko chialio, nolukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.15",
            "verseOrgIds": [
              "DEU.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunjishe ebiyaayo bialio biosi mulwanyi lwalio, nosambila litaala omulilo, nebiyaayo bialio biosi pe, khuMWAMI Nyasayewo; lilakwa eshituuli obushia nobushia; shililiumbakhwakhwo khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata eshindu shiosi shishilahanda khumukhonokwo ta, khu ebio ebiakwisibwa omusilo; mbu OMWAMI ashiukhane arule khubululu bwoburimabwe, nalolosia tsimbabasitsie, nakhubeela eshisa, nakhwinjiyia, shinga olwa yeetsubila abakuukabo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa olareka amarwi khumwoyo kwOMWAMI Nyasayewo, okhulindanga amalakoke kosi aka ekhulaka inyanga yino, okhukholanga akali amalunji imbeli wOMWAMI Nyasayewo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        }
      ]
    }
  ],
