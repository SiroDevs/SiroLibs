          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omusaatsa oukonile ninaye aheelesie samwana omukhaana tsifeetsa tsishekeli amakhumi karaano, naye amuteeshele; shichila amwonooniye; shianyala okhumwilusia tsindaalo tsiosi tsiobulamubwe ta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
