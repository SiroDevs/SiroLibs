          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho mubarusie mubaleere haluyia Iwelitaala elo, mubalase namachina bafwe; omukhaana, shichila shiakhupile tsimbungu ta, ne nali mwitaala; naye omusaatsa, shichila yoonoonia omukhasi wowashie; nilwo olwa olarusia obubii obuli hakari weenywe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
