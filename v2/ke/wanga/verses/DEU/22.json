              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusaatsa oyo naba namunyoola emukhaana oukhweebungwa nali mubulimo, omusaatsa tsana namubukula namaani nakona ninaye; kho omusaatsa oukonile ninaye, yenyene abe oufwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula omukhaana, oramukholela likhuwa ta; shibulamwo mumukhaana oyo eshionoono eshiakhachila afwe ta; shichila shinga olwa kali olwa omundu abuushila owashio namwira, nilwo olwa kali mwikhuwa lino; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
