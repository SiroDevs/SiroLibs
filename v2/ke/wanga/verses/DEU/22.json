          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba amunyoolile nali mubulimo; omukhaana oyo oukhweebungwa, kata nakhupile tsimbungu, abulileho oumuhabina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
