{
  "id": "DEU.29",
  "number": "29",
  "bookId": "DEU",
  "reference": "Okhukalushila 29",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
