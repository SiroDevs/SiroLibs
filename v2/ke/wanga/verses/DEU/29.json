          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "OMWAMl yalakana indakano nende Isiraeli mushialo shiaMoabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko amakhuwa akeindakano eya OMWAMI yalaka Musa okhulakana nabaana baIsiraeli mushialo shiaMoabu, okhumeetwa khundakano eya yalakana ninabo muHorebu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Musa nalanga Isiraeli yosi, nabasunjila mbu Mwalola kosi aka OMWAMI yakholela Farao nabasumbabe neshialoshie shiosi imbeli wetsimoni tsieenywe mushialo shiaMisiri; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu obuteemwi obukhongo obwa tsimonitsio tsialola, nebilolelo, nebiamangaliimwa ebikhongo bienebio; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.3",
            "verseOrgIds": [
              "DEU.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa okhuula olwa leelo OMWAMI shiyakhuheelesia omwoyo kwokhumanya, kata tsimoni okhulola, kata amarwi okhuhulila tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.4",
            "verseOrgIds": [
              "DEU.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasi ndamwimililenje emiyika amakhumi kane mushitsiimi; tsingubo tsieenywe shitsiamukofulila kata ebilaarobio shibiakofulila mubilenjebio ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.5",
            "verseOrgIds": [
              "DEU.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimwaliakhwo omukaate, kata shimwanywakhwo idivai kata amalwa ta; mbu mumanye shinga olwa endi OMWAMI Nyasaye weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olwa mwoola hano, Sihoni Gmuruchi waHeshiboni naOgu omuruchi waBashani barula okhukhuyinga nibakhuseera lihe, neefu nikhubarootsa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.7",
            "verseOrgIds": [
              "DEU.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikhubukula eshialo shiabwe, nikhushiheelesia abaReubeni nabaGadi nabeinusu yoluyia lwabaManase, shibe obulaame bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.8",
            "verseOrgIds": [
              "DEU.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khulwako, mulindenje amakhuwa keindakano yino, nimukakhola, mbu mukaase mukosi aka mukholanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musinjiile mwesi imbeli wOMWAMI Nyasaye weenywe leelo; abeemilisi beenywe, netsimbin tsieenywe, nabakofu beenywe, nabasinjilili beenywe, mbu abasaatsa bosi baIsiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaana beenywe abatiiti, nabakhasi beenywe, nabarende abali hakari wetsikambi tsieenywe, okhurula khumwasiachi wetsikhwitsio okhuula khumutsii wamatsi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.11",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu winjile mundakano yOMWAMI Nyasayewo, khandi mushiitsuboshie, ebie OMWAMI Nyasayewo akhola ninawe Ieelo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu akhutinyisie leelo luno, obe oluyia khululwe omwene, khandi mbu abeetsenje khwiwe Nyasayewo, shinga olwa yakhuboolela, khandi shinga olwa yeetsubila abakuukabo, Aburahamu naIsaka naYakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.13",
            "verseOrgIds": [
              "DEU.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shimuli inywe mwenyene aba ekhola nineenywe indakano yino neshiitsubo shino ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.14",
            "verseOrgIds": [
              "DEU.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula nende oyo ouraliho nineefwe leelo ta, halala nomwenoyo ousinjiileho nineefwe leelo, imbeli wOMWAMI Nyasaye weefwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumanyile shinga olwa khwamenya mushialo shiaMisiri, khandi shinga olwa khwabira hakari wamahanga omwa mwabirila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.16",
            "verseOrgIds": [
              "DEU.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mwaluutsi emisilo chiabwe, nemindu chiabwe echiinamilungwa, echiebisaala namachina, echieifeetsa neitsahaabu, echianyoolekhanga mubo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.17",
            "verseOrgIds": [
              "DEU.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aleshe okhubamwo mwinywe omundu omusaatsa, kata omukhasi, kata inzu yosi, kata Gluyia, owa omwoyokwe kushiukhana leelo okhurula khuMWAMI Nyasaye weefwe okhutsia okhukhalabanila abanyasaye bamahanga ako; shileshe okhubamwo mwinywe eshisina shiosi eshiama ebiamo biobufila neindululusia; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu omundu owisabila omwene ikhabi mumwoyokwe, olwa ahulila amakhuwa keshilaka munwa shino, ari Ndalabeetsanga mumulembe, kata ninjenda mubukhayi bwomwoyo kwanje; mana ebibisi nebiumu biosi biakhayuulwa buyuulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.19",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI shialamuleshela ta; habula mbu oburima bwOMWAMI neimbalikhaye bilamwashila omundu oyo, mana ebilaka munwa biosi ebiahandiikwa mushitabu shino bilaba khuye, ne OMWAMI alasiliisia eliiralie hasi welikuulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI alamwahulila amabii mumbia tsiosi tsiaIsiraeli, ebilaka munwa biosi bieindakano eyahandiikwa mushitabu shino shiamalako shinga olwa bili. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mulwibulo oluli okhwitsa, abaana beenywe abalibuukha inyuma weenywe, halala nabarende abalirula mushialo shiehale balilola amanyasio keshialo eshio, nobulwale bwosi obwa OMWAMI yashilwasia; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi eshialo shiosi shinga olwa shili butswa ilaami, nomuunyu, namsyiila, nishiraraakwa kata okhwama, kata obunyasi okhumelakhwomwo ta, shinga okhukwisibwa khwaSodomu naGomora, khwaAdama naZeboimu, aka OMWAMI yakwisia muburimabwe khandi mubululubwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
            "verseOrgIds": [
              "DEU.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana bo, kata namahanga kosi, balireeba bari OMWAMI yakholeele eshialo shino ario mbushiina? Eshisina shiobululu bwoburima buno obukhongo shili heena? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandu balikalusia mbu Shichila balekha indakano yOMWAMI, Nyasaye wabakuuka babwe, eya yalakana ninabo olwa yabarusia mushibala shiaMisiri; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibatsia nibakhalabanila abamyasaye bandi, nibabeenamila, abanyasaye aba baramanya ta, kata aba yarabaheelesia tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachiln oburima bwOMWAMI bwaashila eshialo shino, okhushileerela ebilaka munwa biosi ebiahandiikwa mushitabu shino. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iihandi OMWAMI yabasiula mushialo shiabwe noburima, nalulile nasinyiishe muno, nabafuuba mushindi shialo, shinga olwa bali leelo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 29:29"
          },
