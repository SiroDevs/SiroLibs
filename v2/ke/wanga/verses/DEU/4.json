{
  "id": "DEU.4",
  "number": "4",
  "bookId": "DEU",
  "reference": "Okhukalushila 4",
  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "DEU 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa yachesiyia abalsiraeli mbu babe abahulili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, iwe Isiraeli, reka amarwi khumakhuwa akalachilisibwa khandi khukobukhalachi bwosi, aka emwechesinjia, mbu mukakholenje; mbu mubeetsenje mwoyo, nimwinjila nimubukula eshialo eshia OMWAMI, Nyasaye wabakuuka beenywe, yamuheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.1",
            "verseOrgIds": [
              "DEU.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murameetakhwo elindi khwikhuwa liene elia emulachilisia, kata muralileemiakhwo ta; ne mbu mulindenje amalako kOMWAMI Nyasaye weenywe aka emulaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.2",
            "verseOrgIds": [
              "DEU.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsimoni tsieenywe tsialuutsi aka OMWAMI yakhola eBaali-peori; okhuba abasaatsa abalondakhwo Baali-peori, OMWAMI Nyasayewo yabatibia hakari weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.3",
            "verseOrgIds": [
              "DEU.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa inywe abahanda khuMWAMI Nyasaye weenywe mushiliho mwoyo mwesi leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.4",
            "verseOrgIds": [
              "DEU.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, ndamwechesia akalachilisibwa nende akobukhalachi, shinga OMWAMI Nyasaye wanje olwa yandaka, mbu mukakholenje mushialo eshia mwitsa okhwinjilamwo okhushibukula. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.5",
            "verseOrgIds": [
              "DEU.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, mukalinde nimukakhola; okhuba buno nibwo obuchesi bweenywe khandi obumanyilisii bweenywe imbeli wetsimbia tsiabandu abalahulilanga akalachilisibwa kano kosi nibaboola mbu Toto mwene, lihanga lino neliabandu abachesi abobumanyilisii. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.6",
            "verseOrgIds": [
              "DEU.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lili heena lihanga likhongo elili nomunyasaye ouli ahambi ninabo shinga OMWAMI Nyasaye weefwe olwa abeetsanga khwifwe, buli olwa khumuhaabilanga lwosi? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.7",
            "verseOrgIds": [
              "DEU.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata lili heena lihanga likhongo elili nende akalachilisibwa nakobukhalachi akali amalunjishi shinga amalako kano kosi aka ereetsanga imbeli weenywe leelo?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.8",
            "verseOrgIds": [
              "DEU.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abalsiraeli beetsusibwa khukeekholela eHorebu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.8",
            "verseOrgIds": [
              "DEU.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula wiyile kahala, olinde omwoyokwo bulayi, oleshe okhwibilila aka tsimonitsio tsialola, khandi mbu kaleshe okhurula mumwoyokwo tsindaalo tsiosi tsiobulamubwo; nebutswa okabamanyie abaanabo nabaana babaanabo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.9",
            "verseOrgIds": [
              "DEU.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu akeinyanga eya wasinjila imbeli wOMWAMI Nyasayewo muHorebu, olwa OMWAMI yamboolela mbu Ukhung'aasilie abandu, nasi nembahulilisie amakhuwa kanje, beeche okhuriitsanga tsindaalo tsiosi olwa bashimenya mushialo, khandi mbu babeechesie abaana babwe bario. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.10",
            "verseOrgIds": [
              "DEU.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu mwasita ahambi nimusinjila hasi weshikulu; eshikulu nashio nishiakha omulilo okhuula mwikulu mukari mwene, neshiilima namaleesi nolucheka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.11",
            "verseOrgIds": [
              "DEU.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI yasungana nineenywe okhurula ewa yali, mumulilo hakari; mwahulila omwoyo kwamakhuwake, nimuralolakhwo likondo liosi ta; habula omwoyo kwonyene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.12",
            "verseOrgIds": [
              "DEU.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yamurumbulila indakanoye eya yamulaka okhukholanga, mbu amalako ekhumi tsana; nakahandiika khurubaho rubili rwamachina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.13",
            "verseOrgIds": [
              "DEU.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mundaalo tsienetsio OMWAMI yandaka okhumwechesia akalachilisibwa nakobukhalachi, mbu mukakholenje mushialo eshia mwitsa okhwambukha okhushilia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.14",
            "verseOrgIds": [
              "DEU.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuchesiyii khukobwinamili bwebifwanani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.14",
            "verseOrgIds": [
              "DEU.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mwiyile kahala muno; okhuba shimwalola likondo lieimbia yosi yosi ta, khunyanga eyo olwa OMWAMI yasunganila nineenywe muHorebu okhurula ewa yali mumulilo hakari; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.15",
            "verseOrgIds": [
              "DEU.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho muleshe okhwiyonoonia nimwikholela eshifwanani eshibaatse, eshifwanana nelikondo liosi, omufwano kwomundu weshisaatsa kata oweshikhasi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.16",
            "verseOrgIds": [
              "DEU.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "omufwano kweisolo yosi eyili khushialo, omufwano kwelinyonyi liosi elili netsimbaha elipulukha khwikulu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.17",
            "verseOrgIds": [
              "DEU.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "omufwano kweshindu shiosi eshimoolanga khwiloba, kata omufwano kweinyeeni yosi eyibeetsanga mumatsi akali hasi weshialo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.18",
            "verseOrgIds": [
              "DEU.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu oleshe okhuchinguula tsimonitsio khwikulu, mana olwa oba nolola eliuba nomwesi netsinyininyini, amahe kosi akomwikulu, oba nokhweswa nobiinamila nobikhalabanila, ebio ebia OMWAMI Nyasayewo yakabila tsimbia tsiosi tsiabandu etsili hasi welikulu liosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.19",
            "verseOrgIds": [
              "DEU.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa OMWAMI yamubukula inywe, namurusia mumulilo omululumu shinga okurulanga eshibia, mbu muMisiri, mana mumubeele abandu bebe omwene, shinga olwa muli leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.20",
            "verseOrgIds": [
              "DEU.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI yandiililwa oburima khulweenywe, niyeetsuba mbu shindakhaambukha Yorodani kata shindakheenjila mushialo eshio eshilayi eshia OMWAMI Nyasayewo yakhuheele shibe obulaame, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.21",
            "verseOrgIds": [
              "DEU.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula ekhoyile okhufwila mushialo shino, shikhoyile okhwambukha Yorodani ta; ne inywe mulaambukha, nimubukula eshialo eshio eshilayi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.22",
            "verseOrgIds": [
              "DEU.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiyile kahala, muleshe okhwibilila indakano yOMWAMI Nyasaye weenywe eya yalakana nineenywe, nimwikholela eshifwanani eshibaatse eshifwanana neshindu shiosi eshia OMWAMI Nyasayewo yakhukaania ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.23",
            "verseOrgIds": [
              "DEU.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI Nyasayewo nomulilo okusambanga; niye Nyasaye weimbalikha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.24",
            "verseOrgIds": [
              "DEU.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.24",
            "verseOrgIds": [
              "DEU.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa oliibula abaana, nabeetsukhulu, nimuba nimwamenya mushialo eshise eshirambi, nimuba nimwiyoonoonia nimukhola eshifwanani eshibaatse eshifwanana neshindu shiosi, nimukhola akali amabii mumoni tsiOMWAMI Nyasayewo, nimumusinyisia, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.25",
            "verseOrgIds": [
              "DEU.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "enanBa likulu nende eshialo okhumuyinga nobuloli inyanga yino, mbu mundaalo etsili ahambi mwitsa okhusishila elala okhurula mushialo eshio eshia mulaambukha Yorodani nimutsia okhushibukula; tsindaalo etsia mulamenyamwo shitsilaba tsinyinji ta, ne mulatibilibwa elala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.26",
            "verseOrgIds": [
              "DEU.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI alamusalaasia mumbia tsiabandu, ne mulatong'a abatuutu butswa mumahanga ewa OMWAMI alamuyila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.27",
            "verseOrgIds": [
              "DEU.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ebweneyo mulakhalabanila abanyasaye bebisaala namachina, emilimo chiamakhono kabandu, abaralolanga, kata okhuhulila kata okhulia, kata okhuhunyilisia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.28",
            "verseOrgIds": [
              "DEU.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata ebweneyo, noba nomukhaaba OMWAMI Nyasayewo olamunyoola, noba nomurunilisia nomwo-yokwo kwosi nende eshiimoshie shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.29",
            "verseOrgIds": [
              "DEU.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa oliba noli mumasila, amakhuwa ako kosi nikakhukwiliile, mundaalo tsiobumaliilishi olakalushila OMWAMI Nyasayewo, nohulila omwoyokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.30",
            "verseOrgIds": [
              "DEU.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI Nyasayewo niNyasaye wetsimbabasi; shialakhusukuna kata okhukhumalilana, kata okhwibilila indakano yabakuukabo eya yabeetsubila tawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.31",
            "verseOrgIds": [
              "DEU.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.31",
            "verseOrgIds": [
              "DEU.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba oreebe bulaano tsindaalo tsiene etsiabira, etsialiho iwe norashiabaho ta, okhurula khunyanga eya Nyasaye yalonjelamwo omundu khushialo, nokhurula khushihesi shielikulu elubeka eyi okhuula khushihesi shialio elubeka eyi, likhuwa niliba nilieekhola likhongo shinga lino, kata niliahuliilikhakhwo elifwana lirio, nohomba? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.32",
            "verseOrgIds": [
              "DEU.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali heena abandu abahulilakhwo omwoyo kwomunyasaye nikuboolanga mumulilo hakari, shinga iwe olwa wahulila, nibabaho mwoyo? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.33",
            "verseOrgIds": [
              "DEU.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ali heena omunyasaye owateema okhutsia okhwibukulila lihanga okhurula hakari welihanga lindi, khulwa obuteemwi, khulwa ebilolelo, khulwa akamangaliimwa, khulwa lihe, khulwa omukhono kwamaani, khulwa omukhono okunyiililwe okhubahabina, khandi khulwa akamariisia amakhongo, shinga OMWAMI Nyasaye weenywe olwa yamukholela muMisiri, nimulola netsimoni tsieenywe? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.34",
            "verseOrgIds": [
              "DEU.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe wamanyibwa, mbu omanye shinga OMWAMI olwa ali ye Nyasaye; abulaho oundi, habula ye yenyene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.35",
            "verseOrgIds": [
              "DEU.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhurula mwikulu yakhuhulilisia omwoyokwe mbu akhwibaalile; khandi khushialo yakhulolosilia omulilokwe omukhongo; khandi wahulila amakhuwake nikarula hakari womulilo tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.36",
            "verseOrgIds": [
              "DEU.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shichila yaheelanga abakuukabo, niko akachila yalobola olwibulo lwabwe inyuma wabwe, nakhurusiamwo halala nokhubahokhwe, nende obunyalibwe obukhongo, okhurula eMisiri, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.37",
            "verseOrgIds": [
              "DEU.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyeelusia imbeliwo amahanga akakhushila obukhongo netsingufu, okhukhwinjisia nakhuheelesia eshialo shiabwe shibe obulaame, shinga olwa shili leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.38",
            "verseOrgIds": [
              "DEU.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omanye leelo luno, niwitsulila mumwoyo, mbu OMWAMI niye Nyasaye mwikulu ikulu khandi mushialo hasi; abulaho oundi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.39",
            "verseOrgIds": [
              "DEU.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe olindenje aka yalachilisia namalakoke aka ekhulaka leelo, mbu okaasenje, nende abaanabo inyumawo, khandi mbu tsindaalotsio tsimeeteshe mushialo eshia OMWAMI Nyasayewo akhuheelesia, ebisoni nebisoni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.40",
            "verseOrgIds": [
              "DEU.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amataala kobwilushilo akali ebukwe weYorodani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.40",
            "verseOrgIds": [
              "DEU.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa yaahula amataala kataru akali injelekha weYorodani okuhenjile ewa eliuba lifwindilanga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.41",
            "verseOrgIds": [
              "DEU.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu omwiri womundu yeelushilenjeyo, oyo ouba niyeetsukhana niyeera owashie, ne narabeelenje namukiya ta; mbu niyeelushiile elala khumataala ako, abeetsenje mwoyo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.42",
            "verseOrgIds": [
              "DEU.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "akeene ngakano, mbu Bezeri mushitsiimi, khumuhololookhwe, khulwa abaReubeni; naRamotsi muGileadi, khulwa abaGadi; naGolani muBashani, khulwa abaManase.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akoburanjilili bwokhukalushila mumalako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko amalako aka Musa yara imbeli wabaana baIsiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.44",
            "verseOrgIds": [
              "DEU.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "kano niko akoburumbusi, nakalachilisibwa, nakobukhalachi, aka Musa yaboolela abaana baIsiraeli olwa barula eMisiri, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.45",
            "verseOrgIds": [
              "DEU.4.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 4:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "injelekha weYorodani, mwibanda elihengana nende Betsi-peori, mushialo shiaSihoni omuruchi wabaAmori, abamenyanga eHeshiboni; nibo aba Musa nabaana baIsiraeli bahula olwa barula eMisiri; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.46",
            "verseOrgIds": [
              "DEU.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibabukula eshialoshie mbu shibe eshiabwe, nende eshialo shiaOgu omuruchi waBashani, abaruchi babili abo babaAmori, abalinji injelekha weYorodani okuhenjile ewa eliuba lifwindilanga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.47",
            "verseOrgIds": [
              "DEU.4.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DEU 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhurula eAroeri, elili khundulo welibanda liaArinoni, okhuula khushikulu shiaSirioni, ne nishio Heremoni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.48",
            "verseOrgIds": [
              "DEU.4.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "halala nende Araba yosi injelekha weYorodani ebukwe, okhuula khunyanza yaAraba, mundalila tsiaPisiga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.49",
            "verseOrgIds": [
              "DEU.4.49"
            ]
          }
        }
      ]
    }
