    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Habundu ahokhwinamilanga Nyasaye habe halala honyene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko akalachilisibwa nakobukhalachi aka muleetsulilanga okhukakhola, mushialo eshia OMWAMI, Nyasaye wabakuukabo, yakhuheelesiye shibe eshishio tsindaalo tsiosi etsia mulamenya mushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhumulula mulamulula habundu hosi omwa amahanga aka mulabukula kali nikakhalabanilangamwo abanyasaye babwe, khungulu tsirambi, khubikulu, nende mubuli musaala omutendeemu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.2",
            "verseOrgIds": [
              "DEU.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulikulule ebimalilo biabwe biemisango, nimusasaka tsisiilo tsiabwe tsiamachina amasongokhu, nimusamba emiAshera chiabwe nomulilo; mureme ebirwanani ebibaatse biabanyasaye babwe, nimusishia eliira liabwe, lihweho habundu yaho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne murakholela OMWAMI Nyasaye weenywe murio ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mukhaabe habundu aha OMWAMI Nyasaye weenywe alalobola mumbia tsieenywe tsiosi okhuraho eliiralie, niho eshimenyoshie, nimutsiayo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi muyileyo emisango chieenywe echiokhusambwa, nemisanao chindi, nebitonye bieenywe bielikhumi, netsisadaka etsia muhaana, nebiebiitsubo bieenywe, nebihaanwa ebia muhaana khulwa okhuchama, nebiibulwa biambeli bietsing'ombe tsieenywe nebiebiayo bieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.6",
            "verseOrgIds": [
              "DEU.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebweneyo mulaliitsanga imbeli w Nyasaye weenywe, ne muleekhoyela kosi aka murakhwo amakhono okhukhola, inywe nabomunzu tsieenywe, aka OMWAMI Nyasayewo yakhuheelesiyemwo ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimulakholanga amakhuwa kosi shinga olwa khukholanga hano leelo ta, mbu buli mundu okhukhola aka omwene aluutsi mbu nobulayi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.8",
            "verseOrgIds": [
              "DEU.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba mushili okhuula mubuhuluushi tsana, kata khubulaame, ebia OMWAMI Nyasayewo akhuha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa mulaambukha Yorodani, nimumenya mushialo eshia OMWAMI Nyasaye weenywe amuheelesia shibe obulaame, naye namuhuluusia khukabasuku beenywe abamubotokhana, mbu mumenye shisale; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana habundu aha OMWAMI Nyasaye weenywe alalobola, okhumenyiayo eliiralie, muleerenjeho biosi ebia emulaka; mbu emisango chieenywe echiokhusambwa, nemisango chindi, nebitonye bieenywe bielikhumi, netsisadaka etsia muhaana, nebiolukoosi biebiitsubo bieenywe ebia mumwitsubila OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana muleekhoya imbeli w Nyasaye weenywe, inywe, nabaana beenywe abasiani nabakhaana, nabakholi beenywe beshisaatsa nabeshikhasi, nende abaLawi abali mumataala keenywe, shichila bo shibalikhwo nomukabo kata obulaame mwinywe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiyile kahala, oleshenje okhumalila emisa-ngochio emisambe buli hosi aha oluutsi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.13",
            "verseOrgIds": [
              "DEU.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula habimdu yaho aha OMWAMI alalobola muluyia Iweenywe lulala, niho aha olamalilanga emisangochio emisambe; khandi niho aha olakholelanga kosi aka ekhulaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa osinzenje inyama yosi nochilia mumataala keenywe kosi, shinga olwa wenya, ikhabi eya OMWAMI Nyasayewo yakhuheelesia shinga olwa yili; ouli nobukaali nende omusiiyikhu bombi baliekhwo, shinga olwa baliitsanga khushitsusu kata khumbongo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula muraliitsanga amalasile ta; okatsushe khwiloba shinga amatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oraliitsangakhwo mwitaalalio eshitonye eshio shielikhumi shieimeleyo, kata eshieidivaiyo, kata eshiamafurako, kata ebiibulwa biambeli biomung'ombetsio kata ebiayobio, kata ebiebiitsubobio ebia witsubanga, kata ebihaanwa ebia ohaana khulwa okhuchama, kata isadaka eya ohaana, ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa ebienebio obiliitsenje imbeli w Nyasayewo habundu tsana aha OMWAMI Nyasayewo alalobola, iwe, nomwanawo omusiani, nomwanawo omukhaana, nomukholiwo weshisaatsa nomukholiwo weshikhasi, nende omuLawi ouli mwitaalalio; ne wikhoyenje imbeli wOMWAMI Nyasayewo mukosi aka orakhwo omukhono okhukhola. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiyile kahala, oleshe okhwibala omuLawi tsindaalo tsiosi noshimenyanga mushialoshio.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa OMWAMI Nyasayewo alakaliyia tsinzakhotsio, shinga olwa yakhusuubisia, nawe noboola mbu Endie inyama; shichila omwoyokwo kwikomba okhulia inyama; kho olie inyama, shinga olwa wenya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne habundu tsana aha OMWAMI Nyasayewo alalobola okhuraho eliiralie nihaba ehale ninawe, kho osinze ebiokhung'ombetsio kata ebiokhubiayobio ebia OMWAMI yakhuheelesia, shinga olwa ndakhulaka, nolia mwitaalalio, shinga omwoyokwo olwa kwikomba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga eshitsusu nende imbongo olwa biliibungwa, nilwo olwa olaliitsanga khubio; ouli nobukaali nomusiiyikhu bombi baliekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula ohenje bulayi oleshe okhulia amalasile ta, okhuba amalasile niko obulamu; oralia obulamu bwene halala neinyama ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.23",
            "verseOrgIds": [
              "DEU.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orakaliakhwo ta; okatsushe khwiloba shinga amatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.24",
            "verseOrgIds": [
              "DEU.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orakaliakhwo ta; mbu okaasenje, nende abaanabo inyumawo, olwa olakholanga akali amalunji imbeli w ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula mbu ebindu ebitakatifu ebia oli ninabio, nebiebiitsubobio, obibukule otsie ninabio habundu tsana aha OMWAMI alalobola; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomala emisangochio emisambe, inyama nende amalasile, khushimalilo shiOMWAMI Nyasayewo; nako amalasile kemisangochio katsushilwe khushimalilo shiOMWAMI Nyasayewo, ne inyama ochilie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitsulila nende okhuhulila amakhuwa kano kosi aka ekhulaka, mbu okaasenje, nende abaanabo inyumawo, ebisoni nebisoni, olwa olakholanga akali amalayi khandi amalunji imbeli w Nyasayewo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuchesiyii khukobwinarmili bwebifwanani",
          "type": "text"
        }
      ]
    },
