          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orakholela OMWAMI Nyasayewo orio ta; okhuba buli shisinyo shiOMWAMI, eshia akiyanga, babikholeele abanyasaye babwe; okhuba basambilanga abanyasaye babwe kata abaana babwe abasiani nabakhaana mumulilo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
