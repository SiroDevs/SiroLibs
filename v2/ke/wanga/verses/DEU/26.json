{
  "id": "DEU.26",
  "number": "26",
  "bookId": "DEU",
  "reference": "Okhukalushila 26",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "DEU 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emilukha chiebirongole, neshitonye shielikhumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa olaba niwinjiile mushialo eshia OMWAMI Nyasayewo akhuheelesia shibe obulaame, nishili eshishio, nomenyangamwo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "olabukula ebiokhubirongole biebiamo biosi bielilobalio ebia olarusia mumukundakwo okwa OMWAMI Nyasayewo akhuheelesia, nobira mushimwelo, notsia habundu tsana aha OMWAMI Nyasayewo alalobola okhumenyiayo eliiralie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oloola ewomukuhani oulabaho mundaalo etsio, nomusunjila mbu Erumbula inyanga yino imbeli wOMWAMI Nyasayewo mbu emalile okhwinjila mushialo eshia OMWAMI yeetsubila abakuuka beefwe okhukhuheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukuhani alabukula eshimwelo tsana mumukhonokwo, nashirenjekha hasi imbeli weshimalilo shiemisango shiOMWAMI Nyasayewo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe olakalusia nosunga imbeli wOMWAMI Nyasayewo, ori Papa yali omuAramu, natiimatiimanga mushialo; ne yakholomokha natsia eMisiri, namenyakhwoyo, nibarali abanji ta; ne ebweneyo yeekhola lihanga likhongo, liamaani, eliabandu abanji. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaMisiri bakhukhupia khushibii, nibakhumiina, nibakhutuukha amanyakhano amatinyu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.6",
            "verseOrgIds": [
              "DEU.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "neefu nikhuhaabila OMWAMI, Nyasaye wabakuuka beefwe; OMWAMI nahulila omwoyo kweefwe, nalola okhumiinwa khweefwe, nokhunyakhana khweefwe, nokhusandibwa khweefwe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nakhurusia muMisiri nomukhono kwamaani, nomukhono okunyiililwe, noburisii obukhongo, nebilolelo, nende akamangaliimwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne yakhwinjisiye habundu hano, nakhuheelesia eshialo shino, eshialo eshiitsuulemwo amabeele nende obuushi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, lola, ekhuleereele ebirongole biebiamo bieliloba elia iwe, OMWAMI, wambeelesiye. Mana olabirenjekha hasi imbeli wOMWAMI Nyasayewo, nomwinamila OMWAMI Nyasayewo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwikhoyela amalayi kosi aka OMWAMI Nyasayewo yakhuheele iwe nabeinzuyo; iwe omwene, nomuLawi oyo, nomurende oulaba nali mwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa olaba nomalile okhwahula eshitonye shielikhumi shiosi shiamameetoko mumuyika kwakhataru, nikwo omuyika kweshitonye shielikhumi, kho oshikabile abaLawi, nabarende, na'eabisandu, nende abakhasi abalekhwa, mbu balie mwitaalalio nibeekura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.12",
            "verseOrgIds": [
              "DEU.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana osunjile OMWAMI Nyasayewo mbu Erusiye ebindu ebitakatifu munzu yanje, khandi embibakabiile abaLawi, nabarende, nababisandu, nabakhasi abalekhwa, lilakolio liosi elia wandaka shinga olwa lili; shisiilile kata elala khumalakoko kata okhukeebilila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimbiliilekhwo nindi mumasika, kata shimbirusiyeho nindi mwibilu, kata okhubihaanila abafwa ta; embuliile amakhuwa kOMWAMI Nyasaye wanje, nikhola kosi aka wandaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhurula ewa oli mushimenyoshio eshitakatifu, mwikulu, ohenje hasi, noheelesia oluyialwo Isiraeli ikhabi, nende liloba elia wakhuheelesiye, shinga olwa weetsubila abakuuka beefwe, mbu eshialo eshiitsuulemwo amabeele nende ebuushi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluyia olutakatifu lwOMWAMI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leelo luno OMWAMI Nyasayewo akhulaka okhukhola akalachilisibwa kano nakobukhalachi kano; kho okalinde nokakhola nomwoyokwo kwosi, khandi neshiimoshio shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orumbuule leelo luno shinga OMWAMI olwa ali ye Nyasayewo, khandi iwe omwene shinga olwa okhoyile okhuchendanga khunjilatsie, nokhulinda aka alachilisia, namalakoke, nobukhalachibwe, nende okhuhulila aka aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye OMWAMI arumbuule leelo luno khukoko, mbu oli oluyialwe olutakatifu, shinga olwa yakhusuubisia, khandi mbu okhoyile okhulindanga amalakoke kosi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu alakhura ikulu wamahanga kosi aka yakhola, mubwitsoomibwi, khandi mufuma, khandi muluyali; khandi mbu obe oluyia olutakatifu lwOMWAMI Nyasayewo, shinga olwa yaboola.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
      ]
    }
  ],
