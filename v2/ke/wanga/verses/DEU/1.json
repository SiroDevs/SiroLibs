{
  "id": "DEU.1",
  "number": "1",
  "bookId": "DEU",
  "reference": "Okhukalushila 1",
  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "DEU 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukuumi bwaNyasaye khuIsiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko amakhuwa aka Musa yasunjila oluyia lwosi lwaIsiraeli injelekha weYorodani mushitsiimi, muAraba ahahengana naSufi hakari weParani naTofeli naLabani naHazerotsi naDizahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.1",
            "verseOrgIds": [
              "DEU.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne noluchendo lwetsindaalo ekhumi nandala okhurula eHorebu nobirila enashikulu shiaSeiri okhuula eKadeshi-barinea. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.2",
            "verseOrgIds": [
              "DEU.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mumuyika kwamakhumi kane, mumwesi kwekhumi nalulala, khunyanga yambeli yomwesi, Musa yaboolela abaana baIsiraeli amakhuwa kosi aka OMWAMI yali nalachilisiye khukabwe shinga olwa kali, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.3",
            "verseOrgIds": [
              "DEU.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa yali namalile okhuhula Sihoni omuruchi wabaAmori, owamenya eHeshiboni, nende Ogu omuruchi waBashani, owamenya eAshitarotsi, eEderai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.4",
            "verseOrgIds": [
              "DEU.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Injelekha weYorodani mushialo shiaMoabu niho aha Musa yachaaka okhwinoosilia amalako kano, nasunga mbu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.5",
            "verseOrgIds": [
              "DEU.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye weefwe yakhuboolela muHorebu ari Okhumenya khweenywe mushikulu muno khuhelile. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.6",
            "verseOrgIds": [
              "DEU.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiukhane, mubuusie oluchendo, mutsie mushialo shiebikulu shiabaAmori, khubosi abamenya muAraba, nomushialo shiebikulu, nomwibanda, nomuNegebu, nokhulukuku Iweinyanza, eshialo shiabaKanaani, nende Lebanoni, okhuula khumwalo okwo omukhongo, mbu omwalo kwaEuferati. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.7",
            "verseOrgIds": [
              "DEU.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole ereeleho eshialo eshio imbeli weenywe; mwinjile, mubukule eshialo eshia OMWAMI yeetsubila abakuuka beenywe, Aburahamu naIsaka naYakobo, okhubaheelesia bo nolwibulo lwabwe inyuma wabwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.8",
            "verseOrgIds": [
              "DEU.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.8",
            "verseOrgIds": [
              "DEU.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndasungana nineenywe mundaalo etsio, nimboola mbu Shinyala okhumuchinga sienyene ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.9",
            "verseOrgIds": [
              "DEU.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye weenywe yamwinjiyiye, ne lole, leelo muli shingana tsinyininyini etsiomwikulu obunji bweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.10",
            "verseOrgIds": [
              "DEU.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI, Nyasaye wabakuuka beenywe, amwinjiyie khandi eshikhumila okhushila olwa muli bulaano, namu-heelesia ikhabi, shinga olwa yamusuubisia! ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.11",
            "verseOrgIds": [
              "DEU.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndakhanyala endie okhuchinga sienyene obusitohu bweenywe, nomusiiko kweenywe, nobusoolo bweenywe? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.12",
            "verseOrgIds": [
              "DEU.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulobole abandu abachesi, abamanyifu khandi abamanyiishe, tsimbia tsieenywe shinga olwa tsili, nasi ndalabakhola abeemilisi khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.13",
            "verseOrgIds": [
              "DEU.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu nimungalusiamwo nimusunga muri Elia okhubooleele nelilayi okhukhola. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.14",
            "verseOrgIds": [
              "DEU.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nimbukula abeemilisi betsimbia tsieenywe, abandu abachesi khandi abamanyiishe, nimbakhola babe abeemilisi khwinywe, abaseesia bebikhumila, nabaseesia bebikhumi, nabaseesia bamakhumi karaano, nabaseesia belikhumi, nende abanyapara, tsimbia tsleenywe shinga olwa tsiali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.15",
            "verseOrgIds": [
              "DEU.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbalachilisia abayaasii beenywe mundaalo etsio, mbu Muhulilenje ebifunaane ebili hakari wabaana beenywe, nimukabukhasia amakhuwa habwene hakari womundu nomwana wabwe, kata nende omurende owa aba nali ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.16",
            "verseOrgIds": [
              "DEU.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murakholanga ebiela mubandu mubuyaasii ta; muhulilenje omutuutu nomuknongo bombi; murariitsanga tsimoni tsiomundu namundu ta, okhuba obukhalachi nobwa Nyasaye; ne eshifunaane shiosi eshili eshitinyu nishimukhaya, mushindeerele, nasi ndalashihulila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.17",
            "verseOrgIds": [
              "DEU.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndamulachilisia mundaalo etsio kosi aka mwali nimukhoyile okhukhola.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.18",
            "verseOrgIds": [
              "DEU.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.18",
            "verseOrgIds": [
              "DEU.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nikhurula eHorebu, nikhubira mushitsiimi eshio shiosi, eshikali eshiamariisia, eshia mwalola, nikhubirila khunjila eyitsia khubikulu biabaAmori, shinga OMWAMI Nyasaye weefwe olwa yakhulaka; nikhuula eKadeshi-barinea. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.19",
            "verseOrgIds": [
              "DEU.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi nimusunjila mbu Bulaano muulile mushialo shiebikulu shiabaAmori, eshia OMWAMI Nyasaye weenywe akhuheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.20",
            "verseOrgIds": [
              "DEU.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, OMWAMI Nyasayewo areele eshialo shino imbeliwo. Tikulukha, oshibukule, shinga OMWAMI, Nyasaye wabakuukabo, olwa akhubooleele; oraria kata okhufwa omwoyo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.21",
            "verseOrgIds": [
              "DEU.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu mwanzitsila, buli mundu khwinywe, nimusunga mbu Khurume abandu imbeli weefwe, bakhurunilisilie akeshialo, nibakhukalusilia amakhuwa akeinjila eya khukhoyile okhulondakhwo, nakamataala aka khuloolakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.22",
            "verseOrgIds": [
              "DEU.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elo nilinjamisia muno; nimbukula abandu ekhumi nababili khwinywe, mbu mulala khulwa buli luyia; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.23",
            "verseOrgIds": [
              "DEU.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo nibarulaho, nibaniina mushialo shiebikulu, niboola khwibanda liaEshikoli, nibaliluura pe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.24",
            "verseOrgIds": [
              "DEU.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabukula khubiamo bieshialo eshio mumakhono kabwe, nibakholomokha nibabikhuleerela, nibakhukalusilia amakhuwa, bari Neshialo eshilayi, shino eshia OMWAMI Nyasaye weefwe Yakhuheele.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mwaloba okhutikulukhayo, ne mwakhaya lilako liOMWAMI Nyasaye weenywe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimubuutsuluulila mumaheema keenywe, nimusunga mbu Okhuba OMWAMI akhukiyanga, nikhwo okhuchila nakhurusia mushibala shiaMisiri mbu akhuhaane mumukhono kwabaAmori, okhukhutibia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khutikulukha nikhutsia heena? Abaana beefwe bachilile emioyo chieefwe nichisalulukha, bari Abandu balia nabakhongo nabarambi okhushila ifwe; amataala namakhongo, kata tsingoba tsiako tsiulanga khwikulu bwene; khandi khuluutsi abaana babaAnaki nibaliyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimuboolela mbu Muratechela kata okhubaria ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.29",
            "verseOrgIds": [
              "DEU.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye weenywe, oumuranjililanga, alamulwanila, shinga olwa yamukholela muMisiri, nimulolanga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata nende mushitsiimi, ewa walola shinga OMWAMI Nyasayewo olwa yakhuchinga, shinga samwana olwa achinga omwanawe, khunjila yosi eya mwachendakhwo, okhuula olwa mwoola habundu hano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata khulwa likhuwa elo shimwamusuubila OMWAMI Nyasaye weenywe ta, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyo owamuranjilila khunjila okhumukhaabila habundu ahokhuupa amaheema keenywe, mumulilo mushilo okhumumanyia injila eya mukhoyile okhulonda, khandi mwileesi mushiteere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne OMWAMI yahulila amakhuwa aka mwaboola, natiilwa oburima, niyeetsuba ari ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, khubandu abolwibulo luno olubii, abulaho kata mulala oulalola eshialo eshio eshilayi eshia ndeetsuba mbu ndakhaheelesia abakuuka beenywe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.35",
            "verseOrgIds": [
              "DEU.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula Kalebu waYefune, ye alashilola; khandi ye nabaanabe, ndalabaheelesia eshialo eshia yaseenakhwo eshilenje; okhuba yalonda OMWAMI nomwoyo kwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI yandiililwa oburima khulweenywe, naboola mbu Kata wesi shioliinjilamwo tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.37",
            "verseOrgIds": [
              "DEU.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Yoswa waNuni, ousinjilanga imbeliwo, ye aliinjilamwo; omuuminjie ikholo; okhuba niye oulichila Isiraeli nibashilia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.38",
            "verseOrgIds": [
              "DEU.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abaana beenywe abatiiti, aba mwasunga mbu bakhakwa eshioluyiitsi, khandi abaana beenywe aba leelo luno baramanyakhwo akamalayi namabii ta, nibo abaliinjilamwo, khandi ndilishibaheelesia, nabo balishilia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.39",
            "verseOrgIds": [
              "DEU.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula inywe, mushiukhane, mubuusie oluchendo Iweenywe okhutsia mushitsiimi, khuniila eyitsia khuNyanza Inzakhanyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abalsiraeli okhuhulwa nibali eHoroma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana inywe nimukalusia nimumboolela muri Khumwonooneele OMWAMI; khulatikulukha khutsie okhulasana, kosi aka OMWAMI Nyasaye weefwe yakhulaka shinga olwa kali. Mana nimwiboha buli mundu ebimanulwabie bielihe, nimutsaalikha okhuniina mubikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyasunjila mbu Obaboolele ori Muraniinayo, kata okhulasana, tawe; okhuba isie shindi hakari mwinywe ta; muleshe okhurootswa imbeli wabasuku beenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nimuboo-lela, ne shimwareka amarwi ta; nebutswa mwakhaya lilako liOMWAMI, nimutsaalikha, nimuniina mubikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaAmori abamenyanga mubikulu ebio nibarula okhumuyinga, nibamulonda shinga inzushi, nibamurootsa nibamukwisia muSeiri, kata okhuula khuHoroma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimukalukha, nimulila imbeli w; ne OMWAMI shiyahulila omwoyo kweenywe, kata okhumurechela eshirwi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mwamenya eKadeshi tsindaalo tsinyinji, mbu tsindaalo etsia mwatong'ayo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.46",
            "verseOrgIds": [
              "DEU.1.46"
            ]
          }
        }
      ]
    }
