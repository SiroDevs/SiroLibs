  "bookId": "DEU",
  "reference": "Okhukalushila 3",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "DEU 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaIsiraeli bahula Ogu waBashani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nikhushiukhana nikhutsia khunjila yaBashani; naye Ogu omuruchi waBashani narula okhukhuyinga, ye nabandube bosi, nibakhuseerela lihe eEderei. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.1",
            "verseOrgIds": [
              "DEU.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyasunjila mbu Oramuria ta; okhuba emalile okhumuhaana mumukhonokwo, halala nabandube bosi neshialoshie; nawe olamukholela shinga olwa wakho-lela Sihoni omuruchi wabaAmori, owamenya eHeshiboni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.2",
            "verseOrgIds": [
              "DEU.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI Nyasaye weefwe nahaana Ogu omuruchi waBashani yesi mumukhono kweefwe, nabandube bosi; nikhumurootsa okhuula olwa aratong'a omundu yesi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.3",
            "verseOrgIds": [
              "DEU.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhubukula amataalake kosi mundaalo etsio; kata shjlialiho litaala liosi elia khwachweya okhubukula ta; mbu amataala amakhumi kasasaba, mumbali tsiosi tsiaArigobu, oburuchi bwaOgu muBashani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.4",
            "verseOrgIds": [
              "DEU.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amataala ako kosi kali netsingoba tsirambi, nebilibwa nemiyinjiilo; khandi nende amataala akabula tsingoba amanji. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.5",
            "verseOrgIds": [
              "DEU.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwakamululila elala, shinga olwa khwakholela Sihoni omuruchi waHeshiboni, nikhumululila elala buli litaala nabalimwo bosi, mbu abasaatsa, nabakhasi, nabaana abatiiti bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.6",
            "verseOrgIds": [
              "DEU.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula emiruko, nende ebiyaayilwe mumataala ako, khwabukula bibe ebiolutiitsi bieefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.7",
            "verseOrgIds": [
              "DEU.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhubukula eshialo mundaalo etsio, mumakhono kabaruchi abo babili babaAmori abali injelekha weYorodani, okhurula khwibanda liaArinoni okhuula khushikulu shiaHeremoni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.8",
            "verseOrgIds": [
              "DEU.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Heremoni tsana, abaSidoni bashilanga mbu Sirioni, nabo abaAmori bashilanga mbu Seniri; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.9",
            "verseOrgIds": [
              "DEU.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu amataala kosi komuhololookhwe, naGileadi shiosi, naBashani shiosi, okhuula khuSaleka naEderei, amataala koburuchi bwaOgu muBashani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.10",
            "verseOrgIds": [
              "DEU.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Ogu omuruchi waBashani niye owasikala yenyene khumusikalo kwabaRefai; lole, eshitalishie shiali eshitali shieshibia; shishiliho eRaba ewabaana baAmoni noho? Oburambi bwashio bwachelwa amakhono shienda, nobuchiikha amakhono kane, nochela khumukhono shinga bosi olwa bachelanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.11",
            "verseOrgIds": [
              "DEU.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaReubeni nabaGadi neinusu yabaManase bamenya injelekha weYorodani ebukwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.11",
            "verseOrgIds": [
              "DEU.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshialo eshio khwashibukula mundaalo etsio shibe eshieefwe; nimbaheelesia abaReubeni nabaGadi eshialo okhurula eAroeri, elili khundulo welibanda liaArinoni, nende eshitonye shieshialo shiebikulu shiaGileadi, namataala kashio. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.12",
            "verseOrgIds": [
              "DEU.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshitonye shiaGileadi eshiatong'a, nende Bashani shiosi, oburuchi bwaOgu, mumbali tsiosi tsiaArigobu, ndabaheelesia abeinusu yoluyia lwaManase. Ne Bashani eshio shiosi shilangungwa mbu eshialo shiabaRefai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.13",
            "verseOrgIds": [
              "DEU.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yairi waManase yabukula mumbali tsiosi tsiaArigobu, okhuula khulwakho lwabaGeshuri nabaMaaka; nalanga mumbali etsio khuliira lilie, mbu Hawo-tsi-yairi, shinga olwa tsilangwa okhuula olwa leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.14",
            "verseOrgIds": [
              "DEU.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndaheelesia Makhiri Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.15",
            "verseOrgIds": [
              "DEU.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaReubeni nende abaGadi, ndabaheelesia eshialo okhurula eGileadi okhuula khwibanda liaArinoni; libanda liene hakari walio niliba olwakho; okhuula khumwalo kwaYaboki, okuli olwakho lwabaana baAmoni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.16",
            "verseOrgIds": [
              "DEU.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende Araba shiosi, Yorodani nikuba olwakho, okhurula khuKhineretsi okhuula khunyanza yaAraba, niyo Inyanza Yomuunyu, mundalila tsiaPisiga, elubeka Iwebukwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.17",
            "verseOrgIds": [
              "DEU.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.17",
            "verseOrgIds": [
              "DEU.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mundaalo etsio ndamulachilisia mbu OMWAMI Nyasaye weenywe yamuheelesia eshialo shino shibe eshieenywe. Mwambushe nimwimanuule ebimanulwa bieenywe, inywe abasaatsa beitswoni mwesi, imbeli wabaana beenywe, abaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abakhasi beenywe nabaana beenywe abatiiti baleekhala mumataala aka ndamuheelesia, halala nemiruko chieenywe; emanyile shinga olwa muli nemiruko eminji; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuula olwa OMWAMI alahuluusia abaana beenywe, nineenywe mwesi, nabo bosi nibalia eshialo eshia OMWAMI Nyasaye weenywe yabaheelesia injelekha waYorodani; kho habwenaho mulakalukha buli mundu khwilobalie elia ndamuheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mundaalo etsio ndamulachilisia Yoswa ndi Tsimonitsio tsialuutsi kosi aka OMWAMI Nyasaye weenywe yakholeele abaruchi abo babili; ne nilwo olwa OMWAMI alakholela oburuchi bwosi ario, buli hosi ewa witsa okhubirila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murabaria ta; okhuba OMWAMI Nyasaye weenywe niye oumulwanilanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa shiyamokwa okhwinjile eKanaani ta.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mundaalo etsio ndamusaaya OMWAMI muno, mbu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "E OMWAMI Nyasaye, bulaano wachaachile okhumanyia omusumbawo obukhongobwo, nomukhonokwo kwetsingufu; okhuba ali heena omunyasaye yesi mwikulu kata mushialo ounyala okhukhola emilimo shinga echichio, kata ebikhole biamaani shinga ebibio? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhusaaya mbu ofuchiilile enyambushe, endole eshialo eshilayi eshio eshili injelekha waYorodani, mbu ebikulu ebilayi bilia, nende Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa OMWAMI yandiililwa oburima khulweenywe, narambulilakhwo ta; OMWAMI niyasunjila mbu Leshela yaho! Orasunjilakhwo khukano khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niina otsie khubutenje bwaPisiga, ochinguule tsimoni ohenje mumbo, nenotsi, nesautsi, nende ebukwe, olole netsimonitsio; okhuba shiolaambukha Yorodani kuno ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olachilisie Yoswa, nomuumia ikholo, nomumeetela amaani; okhuba ye alaambukha niyeemilila lihanga lino, nachila nibalia eshialo eshia olalola. ",
          "type": "text",
          "attrs": {
