          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oraraaka omusaala kweimbia yosi kube omuAshera hashimalilo shiOMWAMI Nyasayewo eshia witsa okhukhola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.21",
            "verseOrgIds": [
              "DEU.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata orasinjisia isiilo yelichina lisongokhu yosi ta, eya OMWAMI Nyasayewo akiyanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.22",
            "verseOrgIds": [
              "DEU.16.22"
            ]
          }
        }
      ]
    }
