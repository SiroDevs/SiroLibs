    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amasabo kataru akalachilisibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitsulilanga omwesi kwaAbibu nokholela OMWAMI Nyasayewo ipasaka; okhuba mumwesi kwaAbibu OMWAMI Nyasayewo yakhurusia muMisiri mushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malilanga OMWAMI Nyasayewo omusango kweipasaka, ebiokhubiayobio nebiokhung'ombetsio, habundu tsana aha OMWAMI alalobola okhumenyiayo eliiralie ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orachiliilanga omukaate okulimwo amamela ta; tsindaalo musaafu ochiliilenje omukaate okubulamwo amamela, nikwo omukaate kwobusandibwi; okhuba warula mushibala shiaMisiri matete-khana; mbu witsulilenje inyanga ewa warulilamwo mushibala shiaMisiri, tsindaalo tsiosi tsiobulamubwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamela kosi kaleshenje okhunyoolekha noli ninako mushialoshio shiosi tsindaalo musaafu tawe; kata inyama yosi yosi eyokhumusango okwa wamalile khunyanga yambeli khubwile yileshe okhusikala yikone okhuula mukamba ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oramalilanga omusango kweipasaka mwitaalalio liosi elia OMWAMI Nyasayewo akhuha ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula habundu tsana aha OMWAMI Nyasayewo alalobola okhumenyiamwo eliiralie ebweneyo olamalilangayo omusango kweipasaka khubwile, eliuba niliyeela, khunduukho shinga eya warulilamwo muMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochiteeshe nochiliila habundu tsana aha OMWAMI Nyasayewo alalobola; mana mutsuli oshiukhane okalushile amaheemako. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo tsisasaba oliitsenje omukaate okubulamwo amamela; mana khunyanga yomusaafu omukhung'aano kwoluyali kubeho khuMWAMI Nyasayewo; orakholakhwo omulimo kwosi ta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obale amahonga musaafu; olwa ochaaka okhwinjisia injeso mumimela echiomumukunda, okhurula yaho ochaache okhubala amahonga musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana okhole lisabo liamahonga khuMWAMI Nyasayewo, neshihaanwa eshirula mumukhonokwo, eshia ochama okhuhaana, eshikhongo shinga olwa onyala, ikhabi eya OMWAMI Nyasayewo akhuheelesia shinga olwa yili. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oleekhoyela imbeli w Nyasayewo, iwe, nomwanawo omusiani nomwanawo omukhaana, omukholiwo weshisaatsa nomukholiwo weshikhasi, nomuLawi ouli mwitaalalio, nomurende, nomubisandu, nomukhasi omulekhwa, abali mwinywe, habundu yaho aha OMWAMI Nyasayewo alalobola okhumenyiayo eliiralie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witsulilenje shinga olwa walinji omusumba muMisiri; mwitsulilenje okhukhola akalachilisibwa kano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
