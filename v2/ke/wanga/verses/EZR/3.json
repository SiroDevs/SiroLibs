    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukhalabani bwobwinamili bwakalusibwa habwene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omwesi kwomusaafu kwali nikuulile, abaana baIsiraeli nibali mumataala, abandu bakhung'aanila eYerusalemu shinga omundu mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.1",
            "verseOrgIds": [
              "EZR.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yeswa waYozadaki nasinjila, nabakuhani abashie, naZerubabeli waShealitieli nabaana babwe, niboombakha eshimalilo shiaNyasaye waIsiraeli, okhumalilakhwo emisango emisambe, shinga olwa kahandiikwa mumalako kaMusa, omundu waNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barenjekha eshimalilo habundu washio; okhuba indenga yali niyibahambile khulwa abandu bebialo ebio; nibamalila OMWAMI emisango emisambe khushio, mbu emisango emisambe mutsuli nomungoloobe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalia lisabo liamatili, shinga olwa kahandiikwa, nibamala emisango emisambe chiabuli nyanga, obunji shinga olwa buli, okhulonda khushiima eshialachilisibwa, akakhoyela buli nayanga shinga olwa kali; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
              "EZR.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolunyumakhwo emisango emisambe chiakhatsotso, nemisango chiokhukhuchaaka khwemiesi, nokhutsinduukho tsiamasabo kOMWAMI tsinzahule, nechiabuli mundu owahaana eshihaanwa shiokhuchama eshiOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhurula khunyanga yambeli eyomumwesi kwomusaafu, bachaaka okhumalilanga OMWAMI emisango emisambe; habula omuse kweihekalu yOMWAMI kwali nikushili okhuupwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho babaheelesia amapeesa abo aboombashilanga amachina nababaatsi; nibaheelesia abaSidoni nabaTiro ebiokhulia nebiokhunywa namafura, okhuleera emisiita khunyanza okhurula eLebanoni, okhuula eYafa, shinga Koreshi omuruchi waPerisia olwa yabaheelesia omunwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bachaaka okhuumbakha Ihekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwakhabili okhurula olwa boola enanzu yaNyasaye eYerusalemu, mumwesi kwakhabili, Zerubabeli waShealitieli naYeswa waYozadaki bachaaka emilimo, halala nabaana babwe abakuhani nabaLawi, nabosi abali nibarulile mubwarwi tsana, niboolile eYerusalemu; nibaraho abaLawi, abemiyika amakhumi kabili nabashilaho, okhusinjilila emilimo chieinzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.8",
            "verseOrgIds": [
              "EZR.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yeswa nasinjila, nabaanabe nabaana babwe, naKadimieli naBinui naHodawia, bosi halala, okhusinjilila abakholi bemilimo munzu yaNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa aboombashi bakhupa omuse kweihekalu yOMWAMI, abakuhani babuukha, nibeefwalile ebiifwalo biobukuhani, nibali netsitarumbeta, halala nabaLawi abaana baAsafu nibali nebisili, okhwitsoomia OMWAMI, obwibaali bwaDaudi omuruchi waIsiraeli shinga olwa bwali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeemba niboongulilana okhwitsoomia OMWAMI, nokhumuupila mbu orio, bari",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi nibachinga olukhu olukhongo olwa bamwitsoomia OMWAMI, shichila omuse kweinzu yOMWAMI kwali nikwakhoopwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abanji abokhubakuhani nabaLawi nabeemilisi bebilibwa, abasaakhulu abalola inzu yambeli, balila amasika amanji keene olwa balola omuse kweinzu yino nikukhupwa; abanji nibachinga olukhu khulwa obusangaali; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuula olwa abandu bakhaywa okhwahukhasia obuyoka bwamakhu nobuyoka bwamalilo kabandu; okhuba abandu bachinga olukhu olukhongo, obuyoka nibuhulilishila ehale.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.13",
            "verseOrgIds": [
              "EZR.3.13"
            ]
          }
        }
      ]
    }
