              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo abandu abolukongo abatikulukha nibarula mubwarwi bwa abo abali nibaarwa, aba Nebukhadineza omuruchi waBabeli yaara nayila eBabeli, nibamala nibakalukha eYerusalemu naYuda, buli mundu eneetaalalie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beetsa halala naZerubabeli, Yeswa, Nehemia, Seraya, Ree-laya, Moridekai, Bilishani, Misipari, Bigiwai, Rehumu, nende Baana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        }
      ]
    },
