        {
          "text": "Tsifarasi tsiabwe tsiali ebikhumi musaafu amakhumi kataru natsisasaba; tsinyumbu tsiabwe, ebikhumi bibili amakhumi kane natsiraano; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.66",
            "verseOrgIds": [
