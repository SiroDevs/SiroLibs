          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "EZR 2:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bakhaaba amahandiiko kabwe mubeenabo abahandiikwa mubulondokhani bwetsinzibulo, ne nikaranyoolekha ta; khulwako barusibwa mubukuhani, shinga abobukaali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.62",
            "verseOrgIds": [
              "EZR.2.62"
            ]
          }
        },
