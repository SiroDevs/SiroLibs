          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu abaana baDelaya, abaana baTombia, abaana baNekoda, ebikhumi bisasaba amakhumi karaano nababili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.60",
            "verseOrgIds": [
