          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaana baAra, ebikhumi musaafu amakhumi musaafu nabaraano; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.5",
            "verseOrgIds": [
