          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu abaana baParoshi, ebikhumila bibili eshikhumi amakhumi musaafu nababili; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.3",
            "verseOrgIds": [
