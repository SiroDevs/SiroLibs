          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhubaana babakuhani, abaana baHabaya, abaana baHakozi, abaana baBarizilai, owateeshia omukhasi owokhubakhaana baBarizilai omuGileadi, nakulikhwa khuliira liabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.61",
            "verseOrgIds": [
              "EZR.2.61"
            ]
          }
        },
