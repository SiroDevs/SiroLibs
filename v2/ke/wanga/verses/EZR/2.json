          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaana baPahatsi-moabu, nibo abaana baYeswa naYoabu, ebikhumila bibili ebikhumi munaane ekhumi nababili; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.6",
            "verseOrgIds": [
