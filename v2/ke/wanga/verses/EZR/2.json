          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "EZR 2:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukafuna nabakaania mbu baleshenje okhulia khubindu ebishila obutakatifu, okhuula olwa omukuhani yakhabuukha owakhanyala okhureeba muUrima naTsumimu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.63",
            "verseOrgIds": [
              "EZR.2.63"
            ]
          }
        }
