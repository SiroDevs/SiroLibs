  "bookId": "EPH",
  "reference": "Abaefeso 5",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "EPH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chendenje shinga abaana bobulafu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mulondenje imela yaNyasaye, shinga olwa muli abaanabe abaheelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.1",
            "verseOrgIds": [
              "EPH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchendenje mubuheeli, shinga Kristo yesi olwa yamuheela inywe, niyeehaana omwene khulweefwe, eshihaanwa khandi omusango kweshiuya shieisiakakha indayi khuNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.2",
            "verseOrgIds": [
              "EPH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obuheyi, nakeshifwabwi kosi, kata likhalikhali, kaleshenje kata okhurumbukhakhwo mwinywe, shinga olwa kabakhoyeele abatakatifu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.3",
            "verseOrgIds": [
              "EPH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata aketsisoni, kata okhwilakalakania, kata okhung'asia okhubii, ebirakhoya ta; habula okhuupanga orio. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.4",
            "verseOrgIds": [
              "EPH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba mumanyile toto mbu omuheyi yesi shialikhwo bobulaame mubwami bwaKristo nende Nyasaye ta, kata omundu weshifwabwi, kata owelikhalikhali, ouli omwinamili webiabutswa, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.5",
            "verseOrgIds": [
              "EPH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi aramukaatia namakhuwa amakhaya ta; okhuba amakhuwa kano niko akachilanga oburima bwaNyasaye nibwitsa khubobukhayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.6",
            "verseOrgIds": [
              "EPH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho murasanjilananga ninabo ta; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.7",
            "verseOrgIds": [
              "EPH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila mwalinji eshiilima, ne bulaano muli obulafu muMwami; muchendenje shinga abaana bobulafu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.8",
            "verseOrgIds": [
              "EPH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba ebiamo biobulafu binyooleshelanga mubulayi bwosi, nobulunjishi, nobwatoto. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.9",
            "verseOrgIds": [
              "EPH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teeme, mulole akamuchamisia Omwami shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.10",
            "verseOrgIds": [
              "EPH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murasanjilana nebikhole bieshiilima, ebibula inganga, ta; habula mbu mubisiikhule. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.11",
            "verseOrgIds": [
              "EPH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba aka bakholanga mumabiswi, kata okhukasungakhwo netsisoni; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.12",
            "verseOrgIds": [
              "EPH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa amakhuwa kosi olwa kasiikhulungwa kamanyikhanga khulwa obulafu; okhuba kosi akamanyikhanga niko obulafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.13",
            "verseOrgIds": [
              "EPH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila nikaboolwa mbu",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.14",
            "verseOrgIds": [
              "EPH.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.14",
            "verseOrgIds": [
              "EPH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, mwirecheshe shinga olwa muchendanga, shinga abasilu ta, habula shinga abachesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.15",
            "verseOrgIds": [
              "EPH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwikhoonyele bulayi obwiyangu obuliho, shichila tsindaalo tsino netsimbii. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.16",
            "verseOrgIds": [
              "EPH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho muraba abayingwa ta, ne mbu mumanye bulayi aka Omwami yeenya shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.17",
            "verseOrgIds": [
              "EPH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murameelanga amalwa, okhulimwo obwitaakuli, tawe; ne mwitsulenjemwo Roho. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.18",
            "verseOrgIds": [
              "EPH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musunganile abeene nabeene mutsitsabuli netsinyimbo nokhutselela khweshiroho, nimwimba nimukhupila Omwami obukhana mumioyo mukari. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.19",
            "verseOrgIds": [
              "EPH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhupilenje Nyasaye Seefwe orio tsindaalo tsiosi khulwa amakhuwa kosi muliira liOmwami weefwe Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.20",
            "verseOrgIds": [
              "EPH.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abasaatsa nabakhasi babwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.20",
            "verseOrgIds": [
              "EPH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhulilisaninjie nimuriitsanga Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.21",
            "verseOrgIds": [
              "EPH.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.21",
            "verseOrgIds": [
              "EPH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe abakhasi, hulilenje abasaatsa beenywe shinga olwa muhulilanga Omwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.22",
            "verseOrgIds": [
              "EPH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omusaatsa niye omurwe kwomukhasi, shinga Kristo yesi olwa ali omurwe kweikanisa, omwene nali omuhonia womubili. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.23",
            "verseOrgIds": [
              "EPH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shinga olwa ikanisa yihulilanga Kristo, nilwo olwa abakhasi bakhoyile okhuhulilanga abasaatsa babwe mumakhuwa kosi.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
            "verseOrgIds": [
              "EPH.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
            "verseOrgIds": [
              "EPH.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EPH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe abasaatsa, heelenje abakhasi beenywe, shinga Kristo olwa yaheela ikanisa, niyeehaana khulwayo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.25",
            "verseOrgIds": [
              "EPH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu achiahule, nachisiiyile nachiosiye namatsi halala nelikhuwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.26",
            "verseOrgIds": [
              "EPH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu yeehelesie omwene ikanisa niyili eyoluyali, niyibulakhwo imbala kata likhanya kata eshindu shiosi eshifwana shirio; ne mbu yibe indakatifu, eyibula eshikha shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.27",
            "verseOrgIds": [
              "EPH.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio abasaatsa bosi bakwanile okhuheela abakhasi babwe shinga olwa 'oaheela emibili chiabwe abeene. Ouheela omukhasiwe, yeeheela omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.28",
            "verseOrgIds": [
              "EPH.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila okhurula khale nakhale abulaho omundu owakiya omubili kukwe omwene; nebutswa akuliisia nakutembelesia shinga Kristo yesi olwa akholelanga ikanisa; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.29",
            "verseOrgIds": [
              "EPH.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba khuli ebiungo ebiokhumubilikwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.30",
            "verseOrgIds": [
              "EPH.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila omusaatsa alalekhanga samwana nende nyina, ahambane nende omukhasiwe; nabo bombi balaba omubili mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.31",
            "verseOrgIds": [
              "EPH.5.31"
