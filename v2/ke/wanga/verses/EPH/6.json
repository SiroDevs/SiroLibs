    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuhulili nende obuheeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe abaana, muhulilenje abeebuli beenywe muMwami; okhuba nilio elimukhoyeele. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.1",
            "verseOrgIds": [
              "EPH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heelesinjie so nende mawo oluyali; elo nilio lilako liambeli elili nende obusuubisie, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.2",
            "verseOrgIds": [
              "EPH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Okaasenje bulayi, noyindila khushialo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu abasamwana, murabahambia abaana beenywe oburima ta; ne mbu muboole nimubaruka nokhubachesiyia mumakhuwa kOmwami.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu abasumba, mubahulilenje abo abali abaami beenywe mukomubili, noburii nende okhutechela, mushiilongoole eshiomumioyo, shinga abakholelanga Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.5",
            "verseOrgIds": [
              "EPH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buraba obukhalabani obwokhulolwa bulolwa butswa, shingana abeenya okhuchamisia abandu, tawe; habula shinga abasumba baKristo murekhwo emioyo okhukhola aka Nyasaye yeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.6",
            "verseOrgIds": [
              "EPH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khalabanenje nobulumilifu, shinga abakholela Omwami, abandu butswa tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.7",
            "verseOrgIds": [
              "EPH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimumanyile mbu lilayi liosi liosi elia omundu yesi akhola, alanyoola ario khandi omurungo kwOmwami, kata nali omusumba omuhohe kata omwibule.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.8",
            "verseOrgIds": [
              "EPH.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.8",
            "verseOrgIds": [
              "EPH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu, abaami, mubakholele murio, nimulekha tsisiomi; olwa mumanyile mbu oyo ouli Omwami wabwe khandi oweenywe ali mwikulu, khandi mbu khuye bubulaho obwahuli bwosi mubandu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebimanulwa biosi biaNyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihelelesia ndielino, mbu mukufuhalile muMwami, nende mumaani kobunyalibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.10",
            "verseOrgIds": [
              "EPH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwifwale ebimanulwa biosi biaNyasaye, mbu munyale okhuyinga obubatsa bwaSetani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.11",
            "verseOrgIds": [
              "EPH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba amabwi keefwe shikali akokhulwana nemibili namabanga ta, habula khulwananga noburuchi, nende obunyali, nende abaruchi beshialo shino eshilimwo eshiilima, nende amahe keshiroho kobubii mukeshineekulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.12",
            "verseOrgIds": [
              "EPH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, bukule ebimanulwa biosi biaNyasaye, mbu munyale okhusimbiila khunyanga imbii, ne nimumalile kosi, mube nimushisinjiile murio. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.13",
            "verseOrgIds": [
              "EPH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho musinjile nimwiboyile mubishienje bieenywe obwatieeli, nimwifwalile khubilifu eshitsengwa shiobulunjishi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.14",
            "verseOrgIds": [
              "EPH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimwifwalile mubilenje bieenywe obwirecheshi khulwa injiili yomulembe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.15",
            "verseOrgIds": [
              "EPH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne halala nende ako kosi mubukule ingabo yobusuubili, eya munyala okhusimilia orubano rwosi rwomubii, orwakha omulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.16",
            "verseOrgIds": [
              "EPH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukule nende ikuutwa yobuhonia, nende olukanga lwaRoho, nilwo likhuwa liaNyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.17",
            "verseOrgIds": [
              "EPH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "halala nende okhusaba khwosi nokhusaaya; sabenje buli lwosi muRoho, nimuba meeso mukhwo mubulumilifu bwosi nokhusaaya khulwa abatakatifu bosi; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.18",
            "verseOrgIds": [
              "EPH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi nende khulwanje, mbu enyalilwe okhurumbukha olwa enjinga omunwa, mbu enzwaninjie akamabiso keinjiili katong'ane, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.19",
            "verseOrgIds": [
              "EPH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyeneyo eya endi omurume wayo, kata nindabohwa neminyololo. Saayenje mbu emboole katong'ane neitswoni, shinga olwa ekhoyile okhuboola.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amashiesio akahelelesia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhoyile okhumanya amakhuwa kanje, shinga olwa endi; Tikiko, omwana weefwe omuheelwa, ouli omukhalabani omwisiikwa muMwami, yakhamumanyie amakhuwa kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.21",
            "verseOrgIds": [
              "EPH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamurumile khwinywe khulwa likhuwa lienelo, mbu mumanye akeefwe shinga olwa kali, khandi mbu amutinyisie emioyo chieenywe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulembe kube khubaana beefwe, nobuheeli halala nobusuubili, ebirula khuNyasaye ouli Samwana nende Omwami Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
            "verseOrgIds": [
              "EPH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukoosia bube halala ninabo bosi abamuheelanga Omwami weefwe Yesu Kristo mumela yoburabola ta.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.24",
            "verseOrgIds": [
              "EPH.6.24"
            ]
          }
        }
      ]
    }
  ],
