      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhurula mukhufwa, nokhuula mubulamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenywe mwesi mwalinji abafu khulwa obukhayi bweenywe nende ebionoono bieenywe, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.1",
            "verseOrgIds": [
              "EPH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebia mwachendangamwo khale nimulonda khubiima bieshialo shino, nimulonda omukhulundu ulia wobunyali obwomulwanga, omuroho oyo owa bulaano akholelanga mubobukhayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.2",
            "verseOrgIds": [
              "EPH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefwe fwesi khwali nikhumenyanga hakari wabwe nikhulonda obwikombi bwemibili chieerwe, nikhukhola akokhwenya khwomubili nende okhwamapaaro; khulwa oburulanda bweefwe khwali abaana boburima, shinga abandi bosi olwa bali. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nyasaye, oubeetsanga omuyinda wetsimbabasi, yakhuha obulamu halala nends Kristo, khulwa obunji bwobuheelibwe obwa yakhuheela ninabwo, kata olwa khwali abafu khulwa obuyiiri bweefwe; mwahonibwa khulwa obukoosia. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.5",
            "verseOrgIds": [
              "EPH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhulamusia halala ninaye, nakhwikhasia halala ninaye hashineekulu, muKristo Yesu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.6",
            "verseOrgIds": [
              "EPH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mubisoni ebiitsa alolosie obuyinda bwobukoosiabwe nakhubeelanga eshisa, muKristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.7",
            "verseOrgIds": [
              "EPH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba mwahonibwa khulwa obukoosia, munjila yobusuubili; shimuli inywe abakhola ta; neshihaanwa shiaNyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.8",
            "verseOrgIds": [
              "EPH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "shikhuli okhwebikhole ta, mbu omundu yesi aleshe okhwiyitsiala. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.9",
            "verseOrgIds": [
              "EPH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khuli emilimochie, abalonjelwa muKristo Yesu khulwa ebikhole ebilayi ebia Nyasaye yakhwikholeelela ninabio mbu khuchendenjemwo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
            "verseOrgIds": [
              "EPH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhukholwa mulala muKristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
            "verseOrgIds": [
              "EPH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, mwitsulile mbu khale inywe, Abamahanga mukomubili, abalangwa mbu Abasinde nabeenabo abalangwa mbu Abashebe, nibo abashebwa emibili butswa, namakhono kabandu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.11",
            "verseOrgIds": [
              "EPH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu khale Iwenolwo mwalinji nimubula Kristo, nimuli ababoone khuluyia lwaIsiraeli nabasuku khutsindakano tsiobusuubisie, nimubula obunaayi, kata nimuralikhwo nende Nyasaye mushialo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.12",
            "verseOrgIds": [
              "EPH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, muKristo Yesu inywe abalinji ehale mwasitibwa ahambi khulwa amabanga kaKristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.13",
            "verseOrgIds": [
              "EPH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila niye omulembe kweefwe, owakhukhola ifwe abalinji shikhabili khube balala, nalikululila elala omushinji okwali nikukhukabukhasinjia, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.14",
            "verseOrgIds": [
              "EPH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa yali narusiliye mumubilikwe obusuku obwo obwarula mumalako, namakhuwa nameebaalokako; mbu khubabili abo alonje muye omwene omundu mulala omuyia, naleera ario omulembe; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.15",
            "verseOrgIds": [
              "EPH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu abasaasanie bombi khuNyasaye mumubili mulala, khunjila yomusalaba, olwa yakhaba niyeerile obusuku khulwakwo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.16",
            "verseOrgIds": [
              "EPH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.16",
            "verseOrgIds": [
              "EPH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niyeetsa niyeelwatsa akomulembe khwinywe abali nimuli ehale, khandi omulembe khubali nibali ahambi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.17",
            "verseOrgIds": [
              "EPH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khululwe nikhwo okhwa fwesi khunyala okhwinjisibwa ewaSeefwe muRoho mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.18",
            "verseOrgIds": [
              "EPH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niko akachila nimurali abacheni kata abamenyibwa khandi ta; nebutswa muli abeebule halala nabatakatifu, muli abomunzu yaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.19",
            "verseOrgIds": [
              "EPH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoombashilwa khumuse kwabarume nabanabii, naye Yesu Kristo omwene niye lichina eliliimaasia lisisi mukoona. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.20",
            "verseOrgIds": [
              "EPH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne muye nimwo omwa omuumbakho kwosi, nikuliimaasiibwe halala habwene, kukhulilanga nikuba ihekalu indakatifu muMwami; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.21",
            "verseOrgIds": [
              "EPH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi muye nimwo omwa mwesi mwoombashilwa halala, mube eshimenyo shiaNyasaye muRoho.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.22",
            "verseOrgIds": [
              "EPH.2.22"
            ]
          }
        }
      ]
    }
  ],
