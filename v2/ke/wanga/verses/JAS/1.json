    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lishiesio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JAS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyirula khuYakobo, omusumba waNyasaye nende owOmwami Yesu Kristo; yule khutsimbia ekhumi natsibili etsiOmusalaano; amashiesio khwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusuubili nobwituutuyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JAS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana beefwe, mulolenje mbu nobusangaali olwa munyoola obuteemwi lukano lukano, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.2",
            "verseOrgIds": [
              "JAS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimumanyile mbu obuteemwi bwobusuubili bweenywe bwibulanga obutinyilifu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.3",
            "verseOrgIds": [
              "JAS.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutinyilifu nabwo bukholele elala emilimo chiabwo, mbu mube abalamba habwene nimuraleema mwikhuwa liosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.4",
            "verseOrgIds": [
              "JAS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oundi yesi khwinywe naba natakha obuchesi, amusabe Nyasaye, ouhaanilanga bosi nomukhono omusiro, narabakondeshela ta; mana alaheebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne akhoyile okhusaba nobusuubili, oburakanakaniakhwo ta; shichila oukanakaninjia yeengana amarunda akokhunyanza akarundwa nomuyeka nikaboyongoyibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo arakaala mbu alaheebwa eshindu nOmwami tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.7",
            "verseOrgIds": [
              "JAS.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "noweshikhabili, oubeeyabeeya munjilatsie tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.8",
            "verseOrgIds": [
              "JAS.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.8",
            "verseOrgIds": [
              "JAS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana weefwe ouli omumanani yeeyitsialile obukhulundubwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.9",
            "verseOrgIds": [
              "JAS.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omuyinda, yeeyitsialile obutuutuyibwibwe; shichila alihwaho shinga eshimuli eshiomubulimo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba eliuba lifwinda, nilileera omuyeka okuyiile pia, nilifululusia obunyasi; eshimuli nashio shibungulukha, obukaasu bwokhulolekha khwashio nibuhwaho; nindio omuyinda yesi aniala ario mukhukholakhwe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuteemwi noburechekhwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noweikhabi omundu yesi owifwila mubuteemwi; shichila olwa alaba nafuchiililwa alanyoola olusimbi Iwobulamu olwa Omwami yabasuubisia abo abamuheelanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omundu yesi ateemwa, aleshe okhusunga mbu Nyasaye niye oundeemanga; shichila Nyasaye shiateemungwa namabii ta, kata ye omwene shiateemanga omundu yesi tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.13",
            "verseOrgIds": [
              "JAS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne buli mundu ateemwa olwa akhweswa nobwikombi bubwe omwene, nahombelesibwa ninabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.14",
            "verseOrgIds": [
              "JAS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obwikombi olwa buba nibubeleeshe bumalanga bwibule eshionoono; eshionoono nashio, olwa shiba nishikhulile, shiibula okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murashiamibungwa ta, baana beefwe abaheelwa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.16",
            "verseOrgIds": [
              "JAS.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.16",
            "verseOrgIds": [
              "JAS.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli shihaanwa eshilayi, kata buli mukabo omulamba, kurulanga ikulu, nikwikha okhurula khuMwibusi webiashilo; khuye bubulakhwo obukalukhani bwosi, kata esbiilima eshia okhushiukhana khuleera ta.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.17",
            "verseOrgIds": [
              "JAS.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhuhulila likhuwa nokhulikhola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.17",
            "verseOrgIds": [
              "JAS.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa okhuchama khukhwe yakhwibula nelikhuwa liobwatoto, khube shinga omurongole kwebilonjebie. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.18",
            "verseOrgIds": [
              "JAS.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumanyile likhuwa elo, baana beefwe. Ne shiomundu abe omwangu okhuhulila, habula ashindenje okhusunga kata okhutiilwa oburima; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.19",
            "verseOrgIds": [
              "JAS.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila oburima bwomundu shibuleera obulunjishi bwaNyasaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.20",
            "verseOrgIds": [
              "JAS.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JAS 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, mwinaabule akeshifwabwi kosi, nobushilaani bwobumayaanu; nimwinjisia nobwongoli likhuwa elo eliraakwa mwinywe, elinyala okhuhonia emioyo chieenywe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.21",
            "verseOrgIds": [
              "JAS.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JAS 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.21",
            "verseOrgIds": [
              "JAS.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JAS 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubeetsenje abakholi belikhuwa, ne muraba abahulili butswa ta, abeekaatia abeene. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.22",
            "verseOrgIds": [
              "JAS.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JAS 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila omundu yesi ouli omuhulili welikhuwa narali omukholi ta, yeengana omundu owihenga mumonimwe mwoburulanda mushiilolelo; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
            "verseOrgIds": [
              "JAS.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JAS 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba yeelola omwene, natsia butsia, habwenaho niyeebilila okhufwanakhwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.24",
            "verseOrgIds": [
              "JAS.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JAS 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ouhenjelesia mwilako elo lilamba, nilio lilako liobulekhuule, nalumilila ario, narabeetsanga omuhulili oweshiibililwa ta, habula omukholi oukholanga, omundu oyo alaheebwa ikhabi mukhukholakhwe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.25",
            "verseOrgIds": [
              "JAS.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JAS 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.25",
            "verseOrgIds": [
              "JAS.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JAS 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi naba niyeepaarakhwo mbu noweidini, ne narahania olulimilwe ta, habula niyeekaatinjia, idini yomundu oyo nibutswa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.26",
            "verseOrgIds": [
              "JAS.1.26"
            ]
          }
