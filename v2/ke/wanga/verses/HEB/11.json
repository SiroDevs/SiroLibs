        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.16",
            "verseOrgIds": [
              "HEB.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
