              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusuubili nibwo obumanyi bwatoto bwakeenako aka khunaayanga; nibwo obulolosii bwakeenako akaralolekha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.1",
            "verseOrgIds": [
              "HEB.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibwo obuchila abandu bakhale bafumanga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.2",
            "verseOrgIds": [
              "HEB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.2",
            "verseOrgIds": [
              "HEB.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili khuhulilanga bulayi shinga eshialo olwa shialongwa nelikhuwa liaNyasaye, mbu ebilolekhanga biarula mubindi ebiralolekhanga ta.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.3",
            "verseOrgIds": [
              "HEB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.3",
            "verseOrgIds": [
              "HEB.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili Abeli yamalila Nyasaye omusango omulayi okhushila okwaKaini; ne khulwakwo yamanyikha mbu nomulunjishi, Nyasaye naye namurumbulila akobuloli khulwa ebihaanwabie; khandi khulwako ashiboolanga, kata niyafwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.4",
            "verseOrgIds": [
              "HEB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.4",
            "verseOrgIds": [
              "HEB.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili Enoka yahuyibwa mbu aralola okhufwa ta; shiyanyoolekha ta, shichila Nyasaye yali namuhuyiye. Okhuba olwa yali narashiahuyibwa ta yali niyamanyikha mbu amuchamisinjia Nyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.5",
            "verseOrgIds": [
              "HEB.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne harali obusuubili shilinyalikha okhumuchamisia ta; shichila owitsila Nyasaye akhoyile okhusuubila mbu aliho, khandi mbu niye Khakaba oubakabilanga abamukhaaba.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.6",
            "verseOrgIds": [
              "HEB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.6",
            "verseOrgIds": [
              "HEB.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili, olwa Noa yachesiyibwa naNyasaye khumakhuwa akali nikashili okhulolekha, yamuria, niyoombakha isafina, mbu abomunzuye bahonibwe bario. Khulwabwo yakhalachila abeshibala eshiina, niyeekhola omulaame wobulunjishi oburula mubusuubili.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.7",
            "verseOrgIds": [
              "HEB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.7",
            "verseOrgIds": [
              "HEB.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili, olwa Aburahamu yalangwa yahulila, narula natsia habundu aha yali nali okhuheebwa habe obulaamebwe; narula ario, naramanyakhwo ewa atsia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.8",
            "verseOrgIds": [
              "HEB.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili yeekhola omumenyi mushibala eshia yasuubisibwa, shinga ouli mushibala eshirali eshishie ta, namenyanga mumaheema, halala nende Isaka naYakobo, aba yali niyalaamilwa ninabo halala akobusuubisie tsana; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.9",
            "verseOrgIds": [
              "HEB.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila yali nalindiililanga litookho elo elili nomuse kwalio, elia omukasii walio nomuumbashi walio ni Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.10",
            "verseOrgIds": [
              "HEB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
