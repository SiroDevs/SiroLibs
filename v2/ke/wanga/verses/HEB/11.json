        },
        {
          "text": "Khulwa obusuubili, olwa Musa yeebulwa abeebulibe bamubisa emiesi chitaru, shichila balola shinga olwa yali omwana welikondo lilayi; kata shibaria lilako liomuruchi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.23",
            "verseOrgIds": [
              "HEB.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili, olwa Musa yali nakhulile yakaana okhulangwa mbu omwana womukhaana waFarao; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.24",
            "verseOrgIds": [
              "HEB.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa yalobola okhukholelwa amabii halala nende abandu baNyasaye, okhushila okhusangaalila emienya chiobwonooni echihweetsangaho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.25",
            "verseOrgIds": [
              "HEB.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalola obunyekwi bwaKristo mbu nobuyinda obushila amabiikho kaMisiri; shichila yalindiiliIanga omurungo okwo okuhela habwene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili yarula eMisiri, nararia oburima bwomuruchi ta; natinya shinga oumulola oyo ouralolekha tawe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.27",
            "verseOrgIds": [
              "HEB.11.27"
            ]
          }
        }
      ]
    },
    {
