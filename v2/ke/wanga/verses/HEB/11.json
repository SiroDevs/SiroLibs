            "sid": "HEB 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili, olwa Aburahamu yateemwa yahaana omwanawe Isaka. Ye owali niyanyoola akobusuubisie nokhwikhoya yali nali okhuhaana omwanawe omuteelwa; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.17",
            "verseOrgIds": [
              "HEB.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne niye owaboolelwa ari Olwibulolwo lulikulishilwa muIsaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.18",
            "verseOrgIds": [
              "HEB.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasuubila mbu Nyasaye anyala okhulamusia kata okhurula mubafu; ne yafwana shinga owamukalusilibwa okhurula mubeenabo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.19",
            "verseOrgIds": [
              "HEB.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
