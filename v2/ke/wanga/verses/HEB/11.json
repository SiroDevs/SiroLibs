        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.27",
            "verseOrgIds": [
              "HEB.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili niye owakhola akaPasaka, nokhumiitsal amalasile, mbu owonooninjia abeekulanda aleshe okhubatiilakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.28",
            "verseOrgIds": [
              "HEB.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili babirila muNyanza Inzakhanyu shinga abachenda khwiloba eliumu; abaMisiri nabo olwa bateema okhukhola bario bamilishilamwo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili olukoba lwaYeriko lwalikulukha olwa lwali nilubotokhaanwe tsindaalo musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.30",
            "verseOrgIds": [
              "HEB.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili omutamba Rahabu shiyafwila halala nabakhayi ta, shichila yali niyeenjisiye abaluuri balia nomulembe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.31",
            "verseOrgIds": [
              "HEB.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.31",
            "verseOrgIds": [
              "HEB.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nemboole shiina khandi? Shichila embula eshise eshihela okhutoonya akaGideoni, naBaraki, naSamusoni, naYefitsa; akaDaudi naSamweli nende abanabii bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bo khulwa obusuubili bahula oburuchi bundi nobundi; baraho ebiina biatoto; banyoola akali nikasuubisibwa; basunia tsitalanyi eminwa; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.33",
            "verseOrgIds": [
              "HEB.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "basimia obunyali bwomulilo; beehonokokha mutsinganga; mubuteshele bakufuhasibwa; beekhola abalulu mwihe; beelusia amahe kabasuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.34",
            "verseOrgIds": [
              "HEB.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhasi bakalusilibwa abafu babwe nibalamusiibwe; abandi basaalisibwa, nibarafuchiilila okhulekhuulwa ta, mbu banyoole obulamushi obushila obulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.35",
            "verseOrgIds": [
              "HEB.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi beefwila okhunyokhoosibwa nokhunyekwa, kata nende ebibohelo nende icheela. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.36",
            "verseOrgIds": [
              "HEB.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaswa namachina, baarasibwa nemisumeno, bateemwa, beerwa nende tsinganga; bachendanga nibeefwalile amaseelo kamakondi, namaseelo ketsimbusi; nibaba abahari, nibasandibwa, nibakhupibwa khushibii; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.37",
            "verseOrgIds": [
              "HEB.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "batiimatiimanga mubitsiimi nomubikulu nomutsimbinga nomumeena akomwiloba. Bali abandu aba abeshialo barakwanila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.38",
            "verseOrgIds": [
              "HEB.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bosi bafumanga khulwa obusuubili bwabwe; ne shibamala banyoole akobusuubisie tsana ta. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.39",
            "verseOrgIds": [
              "HEB.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "HEB 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila Nyasaye yali nakasiye likhuwa elishila obulayi khulweefwe, mbu bo baleshe okhukholwa abalamba harali nineefwe ta.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.40",
            "verseOrgIds": [
              "HEB.11.40"
            ]
          }
        }
      ]
