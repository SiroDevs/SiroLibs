      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.10",
            "verseOrgIds": [
              "HEB.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili kata Sara yesi yaheebwa obunyali okhuhela inda, kata olwa yali nabirile emiyikachie, okhuba yalola mbu oyo owasuubisia nomwisiikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.11",
            "verseOrgIds": [
              "HEB.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwako, okhurula khumundu mulala, owali nali shinga omufu, barulamwo abanji muno, obunji shinga obwetsinyininyini etsiokhwikulu, kata shinga omuyeshe okuli khulukuku Iweinyanza, okurabalikha ta.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.12",
            "verseOrgIds": [
              "HEB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.12",
            "verseOrgIds": [
              "HEB.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bosi bafwa nibasuubilanga, nibarashianyoola akobusuubisie ta; habula nibakaluutsi nibakashiesia nibashili ehale ninako, nibeeyama shinga olwa bali abacheni khandi abarende mushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.13",
            "verseOrgIds": [
              "HEB.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ababoolanga akafwana kario balolosia bario ebulafu shinga olwa bakhaabanga eshialo eshili eshiabwe abeene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.14",
            "verseOrgIds": [
              "HEB.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaba nibali nibakheetsuliile mumioyo chiabwe eshialo tsana eshia barulamwo, khane bakhanyoolile obwiyangu okhukalukhayo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.15",
            "verseOrgIds": [
              "HEB.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa bulaano beekomba eshialo shindi eshishila obulayi, nishio eshiomwikulu; ne niko akachila Nyasaye narabafwimbilwa omurwe ta, okhulangwa mbu niye Nyasaye wabwe; shichila wabakasiliye litookho.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.16",
            "verseOrgIds": [
              "HEB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
