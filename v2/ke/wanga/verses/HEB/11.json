            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.19",
            "verseOrgIds": [
              "HEB.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili Isaka yasabila Yakobo naEsau ikhabi, mumakhuwa akali nikali okhwitsa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.20",
            "verseOrgIds": [
              "HEB.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili Yakobo, olwa yali nafwitsanga, yabasabila ikhabi abaana baYusufu, mulala mulala; niyeenamila Nyasaye, niyeeletile ' khumurwe kwomutungakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.21",
            "verseOrgIds": [
              "HEB.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa obusuubili Yusufu, olwa yali nali ahambi khushiakamoshie, yarumbula akokhwinyokha khwabaana baIsiraeli, nalachilisia akamakumbake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.22",
            "verseOrgIds": [
              "HEB.11.22"
            ]
          }
        }
      ]
    },
