            "style": "v",
            "sid": "HEB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsiakhale Nyasaye yasunjila abakuuka muminwa chiabanabii, mubitonye bindi nebindi, khandi munjila tsindi netsindi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mubumaliilishi bweshise shino wakhusunjila muMwanawe, owa yakhola omwene bindu biosi; khandi mumwenoyo nimwo omwa yalonjelamwo eshibala shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niye okhwakha khwene khwoluyali lwaNyasaye, kata nende likondo liene liobwenebwe, nachinganga biosi khulwa likhuwalie liobunyali Ne olwa yali niyeekholile eshitiso khulwa ebionoono bieefwe, yeekhala khumukhono omusaatsa kwObukhulundu obuli ikulu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakholeeshe omukhongo okhuyomba abamalaika, shinga eliira elia yanyoola olwa liyomba eliabwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omwana yashila abamalaika",
          "type": "text"
        }
      ]
    },
    {
