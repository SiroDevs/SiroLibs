            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa asunga mbu indakano imbia, aba nakholile eyambeli mbu neikhulu. Ne eyo eyikofuIanga niyikwa ikhulu yili ahambi okhuhwaho.",
          "type": "text",
