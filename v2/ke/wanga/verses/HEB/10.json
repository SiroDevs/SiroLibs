        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ifwe shikhuli khubo abaria nibeebeeya ta, habula khubo abali nobusuubili abahonia emioyo chiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.39",
