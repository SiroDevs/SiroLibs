        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Boazi yamuteeshia Rutsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Boazi natsia haluyia, niyeekhalaho; mana lola, omuluyia oyo owahambi, owa Boazi yali naralilekhwo, nabiraho. Naye namulanga mbu Iwe wane! Kotola wikhale hano. Naye nakotola, niyeekhala. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.1",
            "verseOrgIds": [
              "RUT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nalanga abandu ekhumi abokhubakofu belitaala, naboola mbu Mwikhale hano. Nibeekhala. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
              "RUT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nasunjila oyo omuluyia owahambi ari Naomi, oucheleele okhurula mushibala shiaMoabu, yeenya okhukusia liloba lilia eliali liomwana weefwe Elimeleki; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
            "verseOrgIds": [
              "RUT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasi enzenyile okhukhumanyia, nikhuboolela mbu olikule imbeli wa abo abeekhaale hano, khandi imbeli wabakofu babandu beefwe. Noba niwenya okhulinunula, olinunule; ne noba noreenya okhulinunula ta, umboolele, mbu emanye; okhuba abulaho oulinunula, habula iwe; nasi nisie oukhulonda. Naye nakalusia mbu Ndalalinunula. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.4",
            "verseOrgIds": [
              "RUT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Boazi naboola mbu Khunyanga olwa olakula omukunda tsana khumukhono kwaNaomi, okhoyile okhukula nende Rutsi omukhaana omuMoabu, ousika omufu, okhubuusia eliira liomufu khubulaamebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.5",
            "verseOrgIds": [
              "RUT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuluyia tsana owahambi naboola ari Shinyala okhukwinunulila omwene ta; ndakhoonoonia obulaame bwanje. Iwe obukule obunyali bwanje bwobununuli, shichila isie shinyala okhukununula ta.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.6",
            "verseOrgIds": [
              "RUT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.6",
            "verseOrgIds": [
              "RUT.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shino nishio eshialinji eshiima muIsiraeli khale, mumakhuwa kokhununula kata akokhukulana, okhutinyisia amakhuwa; mbu omundu okhwifwalula eshilaaro, namuheelesia owashie; eyo yali injila yoburumbusi muIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.7",
            "verseOrgIds": [
              "RUT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuluyia wahambi tsana namusunjila Boazi mbu Omwene okukule; niyeefwalula eshilaaro. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.8",
            "verseOrgIds": [
              "RUT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Boazi nasunjila abakofu, nabandu bosi, ari Muli abaloli leelo, mbu engulile biosi ebiali biaElimeleki, nabiosi ebiali biaKhilioni naMaloni, mumukhono kwaNaomi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.9",
            "verseOrgIds": [
              "RUT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nende Rutsi omukhaana omuMoabu, ousika Maloni, emukulile abe omukhasi wanje, okhubuusia eliira liomufu khubulaamebwe, eliira liomufu lileshe okhusikha mubaana babwe, khandi muluyia Iwewabwe; muli abaloli leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.10",
            "verseOrgIds": [
              "RUT.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu bosi abali haluyia, halala nabakofu, nibasunga mbu Khuli abaloli. OMWAMI amukhole omukhasi uno ouli okhwinjila munzuyo abe shinga Raheli khandi shinga Leya, abo babili aboombakha inzu yaIsiraeli. Nawe okaase muEferata, nende okhufuma muBetelehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzuyo yibe shinga inzu yaPerezi, owa Tamari nende Yuda beebula, khulwa abaana aba OMWAMI alakhuheelesia mumukhasi uno omubuukha.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Boazi naleera Rutsi, namuteeshia; naba ninaye, OMWAMI namunyalila okhuhela inda, niyeebula omwana omusiani. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhasi nibasunjila Naomi bari OMWAMI yeetsoomibwe, ourakhuleshile leelo obule omwikho wahambi ta; eliiralie lifumenje muIsiraeli! ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
              "RUT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakhubee-langa omulamusii khandi omulisii mubushielebwo; okhuba nyakhufialawo oukhuheelanga, nashila abaana abasiani musaafu khwiwe, niye oumwibuule. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Naomi nabukula omwana, namufumbeelela mushilifushie, naba omuleliwe. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abakhasi abamenyanibe nibamukulikha eliira, nibaboola mbu Naomi yeebuliile omwana; nibamukulikha eliira mbu Obedi; ne niye samwana Yese, ouli samwana Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsinzibulo tsiaPerezi nzietsino; mbu Perezi yeebula Hezeroni; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18",
            "verseOrgIds": [
              "RUT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Hezeroni niyeebula Ramu, ne Ramu niyeebula Aminadabu; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminadabu niyeebula Nashoni, ne Nashoni niyeebula Salumoni; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.20",
            "verseOrgIds": [
              "RUT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salumoni niyeebula Boazi, ne Boazi niyeebula Obedi; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.21",
            "verseOrgIds": [
              "RUT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedi niyeebula Yese, ne Yese niyeebula Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.22",
            "verseOrgIds": [
              "RUT.4.22"
            ]
          }
        }
      ]
    }
  ],
