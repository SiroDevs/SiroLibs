{
  "id": "RUT.4",
  "number": "4",
  "bookId": "RUT",
  "reference": "Rutsi 4",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
