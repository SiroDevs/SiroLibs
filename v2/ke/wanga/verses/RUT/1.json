        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rutsi naNaomi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mundaalo etsia abayaasii bayaasilinjiamwo, inzala yaliho mushibala shieneshio. Kho omundu undi waBetelehemu-yuda yatsia okhumenyakhwo mushialo shiaMoabu, halala nomukhasiwe nabaanabe babili. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.1",
            "verseOrgIds": [
              "RUT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliira liomundu oyo liali Elimeleki, neliira liomukhasiwe mbu Naomi, nameera kabaanabe babili, mbu Maloni nende Khilioni; bali abeEfurata muBetelehemu-yuda. Niboola mushialo shiaMoabu, nibabayo. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.2",
            "verseOrgIds": [
              "RUT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Elimeleki omusaatsa waNaomi nafwa; naye nalekhwa nabaana babili. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.3",
            "verseOrgIds": [
              "RUT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaleera abakhasi khubakhaana baMoabu; eliira liamulala liali Oripa, neliira lioundi mbu Rutsi; nibamenyayo emiyika shinga ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.4",
            "verseOrgIds": [
              "RUT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Maloni naKhilioni nibafwa bombi; omukhasi nafwilwa abaanabe babili, khandi nende omusaatsawe.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.5",
            "verseOrgIds": [
              "RUT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.5",
            "verseOrgIds": [
              "RUT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yarula halala nabanyakhufialanyene mbu akalushe, arule mushialo shiaMoabu; okhuba ewa yali muMoabu, yali nahuliile shinga OMWAMI olwa yali nakoonyile abandube, nabaheelesia ebiliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.6",
            "verseOrgIds": [
              "RUT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yarula habundu yaho ewa yali, halala nabanyakhufialanyene babili abo; nibabuusia oluchendo, okhukalukha khushialo shiaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.7",
            "verseOrgIds": [
              "RUT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Naomi nasunjila abanyakhufialanyene ari Mutsie mukalushe mwesi eweenywe; OMWAMI amukholele akeshisa, shinga inywe olwa mwakholela abafwile, khandi nende isie. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI amunyalile okhunyoola obuhuluushi, buli mulala munzu ewa alatsia. Nabatsunzuuna; nabo nibakhupa tsimbungu, nibalila. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusunjila mbu Tawe; ne khulakalukha ninawe halala, khutsie ewabandubo. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.10",
            "verseOrgIds": [
              "RUT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi naboola mbu Shiukhane, abakhaana banje; mwenya okhutsia ninasi mbushiina? Isie eshilikhwo nende abaana abasiani munda, abakhaba abasaatsa beenywe, noho? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.11",
            "verseOrgIds": [
              "RUT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiukhane, abakhaana banjei mutsie butsia; isie endi omushiele, ouranyala okhuteeshibwa ta. Nimba nindakhasunga mbu eshinayanga, kata nimba nindakhaba nomusaatsa eshilo shiolwa leelo, ninzibula abaana abasiani; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.12",
            "verseOrgIds": [
              "RUT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho mwakhalinda okhuula olwa bakhaba nibakhulile noho? Mwakhalekha okhutsia khubasaatsa? Tawe, baana banje; emubeelelela muno; okhuba omukhono kwOMWAMI kuli khwisie okhufukula. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.13",
            "verseOrgIds": [
              "RUT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakhupa tsimbungu, nibalila khandi; naye Oripa namutsunzuuna nyakhufialanyene; habula Rutsi yamuhandakhwo.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.14",
            "verseOrgIds": [
              "RUT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.14",
            "verseOrgIds": [
              "RUT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusunjila mbu Lola, muhalikhwawo ukaluushe ewabwe, khandi khunyasayewe. Nawe kalukha, olondekhwo muhalikhwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.15",
            "verseOrgIds": [
              "RUT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Rutsi nasunga mbu Orambiila mbu ekhurulekhwo, engalushe oburakhulondakhwo ta. Okhuba ewa olatsia, siesi ndalatsia; ewa olakona, siesi ndalakona; abandubo balabeetsanga abandu banje, naye Nyasayewo abe Nyasaye wanje; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.16",
            "verseOrgIds": [
              "RUT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ewa olafwila, siesi ndalafwilayo, niyabilwayo; OMWAMI yakholele ario, nende okhushilaho, nimba ningabukhana ninawe khulwa likhuwa liosi liosi, kata khulwa okhufwa! ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
              "RUT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye olwa yalola mbu ureelekhwo omwoyo okhutsia ninaye, yalekha okhumukaania.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibatsiililila bombi okhuula eBetelehemu. Ne olwa bali niboolile eBetelehemu, abelitaala bosi nibachenya khukabwe, abakhasi nibareeba mbu Uno niNaomi noho? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.19",
            "verseOrgIds": [
              "RUT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia mbu Murananga mbu Naomi ta; munanje mbu Mara; okhuba Oyo Ounyala Biosi yakholeele akobululu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndarula nindi omwitsulu, ne bulaano OMWAMI yanjelesiye nindi omukhaya. Munanganga murie mbu Naomi, olwa OMWAMI yafukuule, Oyo Ounyala Biosi niyakhupia khushibii?",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Naomi nachelela ario, halala nanyakhufialanyene Rutsi, omukooko wabaMoabu, abachelela okhurula mushibala shiaMoabu; niboola eBetelehemu khukhuchaaka khwelichesa lieishayiri.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.22",
            "verseOrgIds": [
              "RUT.1.22"
            ]
          }
        }
      ]
    }
  ],
