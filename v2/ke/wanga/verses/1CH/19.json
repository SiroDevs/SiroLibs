      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaAmoni nabaSiria bahulwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwamakhuwa ako Nahashi omuruchi wabaAmoni yafwa, omwanawe naruka mushilenjeshie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.1",
            "verseOrgIds": [
              "1CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi yaboola mbu Ndalamukholela Hanuni omwana waNahashi akeshisa, shichila samwana yakholela akeshisa. Kho Daudi yaruma abarume okhumulemia omwoyo khumakhuwa kasamwana. Abasumba baDaudi niboola mushialo shiabaAmoni ewaHanuni, okhumulemia omwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abakhulundu babaana baAmoni bamusunjila Hanuni bari Okaala mbu Daudi amuheelesia so oluyali, olwa akhurumiile akobulemia? Abasumbabe shibakhwitsiile okhurunilisia, nokhukwisia, nokhuluura akeshialo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.3",
            "verseOrgIds": [
              "1CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Hanuni nabukula abasumba baDaudi, nababeka, nakhalachila ebiifwalo biabwe hakari, hamatakho, nabeelusia batsie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.4",
            "verseOrgIds": [
              "1CH.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandi nibatsia nibaboolela Daudi aka abandu abo bakholeelwe. Naye naruma abandu okhubaakanila; okhuba abandu abo bali nibafwimbilwe omurwe muno. Omuruchi naboola mbu Mwikhale eYeriko okhuula olwa ebilefu bieenywe biakhabe nibimelile, mana mwakhachelele.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaAmoni balola shinga olwa bamuhunyila Daudi obubii, Hanuni nabaAmoni bayila ifeetsa tsitalanda eshikhumila okhukula amakaari nende abandu abachendela khufarasi okhurula eMesopotamia, nende eAramu-maaka, nende eZoba ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakula amakaari ebikhumila amakhumi kataru nabibili, halala nende omuruchi waMaaka nabandube, abeetsa nibakhupa ikambi imbeli waMedeba. AbaAmoni nibakhung'aana halala okhurula mumataala kabwe, nibeetsa okhuseera lihe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.7",
            "verseOrgIds": [
              "1CH.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Daudi yahulilakhwo, yaruma Yoabu nende lihe liosi liabalulube. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.8",
            "verseOrgIds": [
              "1CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaAmoni nibarula, nibaanza lihe hashilibwa shielitaala; nabo abaruchi abali nibeetsile bali nibali bonyene ebulafu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.9",
            "verseOrgIds": [
              "1CH.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.9",
            "verseOrgIds": [
              "1CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Yoabu yalola shinga lihe olwa liali nilianzilwe okhumuyinga imbeli khandi emukongo, yalobola abandi abokhubalobole baIsiraeli, nabaanza okhuhengana nende abaSiria; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.10",
            "verseOrgIds": [
              "1CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabandi abali nibatong'ile, yabara mumukhono kwaAbishai omwana wabwe, nabo nibeeyanza okhuhengana nende abaAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.11",
            "verseOrgIds": [
              "1CH.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu AbaSiria nibaba nibayembeelela, iwe olakhoonyeelela; ne abaAmoni nibaba nibakhuyembeelela iwe, nasi ndalakhukhoonyeelela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.12",
            "verseOrgIds": [
              "1CH.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witinyie, khukhole eshisaatsa khulwa abandu beefwe, khandi khulwa amataala kaNyasaye weefwe; OMWAMI naye akhole aka aluutsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yoabu nende abandu aba yali ninabo nibasita ahambi imbeli wabaSiria okhulasana; nabo nibamwilukha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abaAmoni balola shinga abaSiria olwa bali nibeeluushe, nabo khandi nibeelukha Abishai omwana wabwe Yoabu bario, nibeenjila mwitaala. Mana Yoabu natsia niyoola eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abaSiria balola shinga olwa bahulilwe naIsiraeli, baruma abarume nibarusia abaSiria abali nibali injelekha wOmwalo tsana, halala nende Shofakhi omuseesia welihe liaHadadezeri, owabeemililanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.16",
            "verseOrgIds": [
              "1CH.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Daudi yaboolelwa, yakhung'aasia Isiraeli yosi halala, niyaambukha Yorodani, nabatsiila niyaanza lihe okhubaseera. Ne olwa Daudi yali niyaanzile lihe okhuseera abaSiria, balasana ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.17",
            "verseOrgIds": [
              "1CH.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaSiria nibeelukha Isiraeli; ne Daudi yeera khubaSiria abandu abomumakaari ebikhumila musaafu, nende abachenda nebilenje ebikhumila amakhumi kane, namwira Shofakhi omuseesia welihe liabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.18",
            "verseOrgIds": [
              "1CH.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abasumba baHadadezeri balola shinga olwa bahulilwe naIsiraeli, beesaasania nende Daudi, nibamukholela. Kata abaSiria nibakhaya okhukhoonya abaAmoni khandi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    }
  ],
