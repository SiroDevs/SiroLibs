          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi yahula Raba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khukhuchaaka khwomuyika omuyia, khushise eshia abaruchi batsiilangakhwo mwihe, Yoabu yarusia lihe, nabeemilila, niyoonoonia eshialo shiabaAmoni, natsia niyeekalila Raba. Habula Daudi yeekhala eYerusalemu. Yoabu narootsa Raba, nalikwisia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nabukula olusimbi Iwomuruchi wabwe khumurwe nanyoola obusiro bwalwo nibuchelwa italanda yeitsahaabu; ne lwalikhwo tsinyuma tsiobukusi obutinyu; nalwo lwarungwa khumurwe kwaDaudi. Naye narusia ebiyaayo mwitookhoj ebinji okhushila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi narusia abandu abalimwo, nabara khumilimo chiemisumeno, nechiebibia ebimemu, nechietsihaywa. Nilwo olwa Daudi yakholela amataala kosi kabaAmoni. Mana Daudi nende abandu bosi nibakalukha eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "EmiRefai chieerwa nabandu baDaudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olunyuma lwamakhuwa ako, lihe liabuukha eGezeri, elia abaFilisiti; nilwo olwa Sibekai omuHushatsi yeera Sipai, owali owokhu; baRefai; abaFilisiti nibahulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolundi khandi lialiho lihe liabaFilisiti; naye Elihanani waYairi yeera Lami, omwana wabwe Goliatsi omuGiti, owa olubango Iweindoboye Iweengana shinga omusaala kwomulushi wetsingubo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olundi lialiho lihe eGatsi, ewa omundu yali, omurambi muno, owa tsinzalatsie tsiosi tsiali amakhumi kabili natsine, mbu tsisasaba khubuli mukhono, natsisasaba khubuli shilenje naye yesi yeebulwa nende omuRefai oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yaseya Isiraeli, Yonatsani waShimea omwana wabwe Daudi yamwira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo beebulwa nende abaRefai abo eGatsi; ne bakwisibwa khulwa omukhono kwaDaudi, nende khulwa amakhono kabasumbabe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
  ],
