          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitsofeli yali omuchesiyii womuruchi; naye Hushai omuArakhi yali omwitsa womuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
