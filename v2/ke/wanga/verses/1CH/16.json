      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibeenjisia lisanduku liaNyasaye, nibalirenjekha mwiheema elia Daudi yali nalikhomeele; nibamala emisango emisambe nemisango chiokhwishia imbeli waNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Daudi yali namalile okhumala omusango omusambe nemisango chiokhwishia, yasabila abandu ikhabi muliira liOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nakabila buli mundu muIsiraeli, ari omusaatsa ari omukhasi, omukaate mulala nomukabo kweinyama nelibumbi lietsinzabibu tsinyumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yaraho abandi abokhubaLawi okhukhalabananga imbeli welisanduku IiOMWAMI, nokhufumia OMWAMI, Nyasaye waIsiraeli, nokhumukhupila orio nokhumwitsoomia; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbabano, mbu Asafu omukhulundu, noumulonda mbu Zakaria, naYeieli, Shemiramotsi, Yehieli, Matitsia, Eliabu, Benaya, Obededomu, naYeieli, nibali nende amatungu nobukhana; naAsafu nakhupanga ebisili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo Benaya naYahazieli abakuhani, nibakhupanga tsitarumbeta imbeli welisanduku lieindakano yaNyasaye, oburaholeela ta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Itsabuli yaDaudi, eyokhukhupa orio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga eyo Daudi yaranjilila okhulaka mbu Nyasaye akhupilwe orio muminwa chiaAsafu nabaana babwe; bari",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.9",
            "verseOrgIds": [
              "1CH.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
