{
  "id": "1CH.17",
  "number": "17",
  "bookId": "1CH",
  "reference": "1 Aketsindaalo 17",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1CH 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Indakano eya Nyasaye yalakana nende Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Daudi yali namenyanga munzuye, Daudi yamusunjila Natsani omunabii ari Lola, isie emenyanga munzu yemisiita, ne lisanduku lieindakano yOMWAMI limenyanga mungubo tsinzelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Natsani namusunjila Daudi ari Okhole kosi akali mumwoyokwo; okhuba Nyasaye ali ninawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mushilo shieneshio likhuwa liaNyasaye liamwitsila Natsani, liri ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.3",
            "verseOrgIds": [
              "1CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsia oboolele Daudi omusumba wanje ori Kano niko aka OMWAMI aboola; mbu Shiolanyumbashila inzu mbu emenyemwo tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.4",
            "verseOrgIds": [
              "1CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba shindamenyakhwo munzu yosi ta, okhurula khunyanga eya ndatikulusia Isiraeli okhuula olwa leelo; ne ndachendilenje okhurula khwiheema lindi okhuula khulindi nokhurula khushimenyo shindi okhuula khushindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.5",
            "verseOrgIds": [
              "1CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habundu hosi ewa ndachendanga nende Isiraeli yosi, ndamusunjila likhuwa omuyaasii yesi waIsiraeli, owa ndalaka okhwayanga abandu banje, nimureeba mbu Nishiina eshiachila nimuranyumbashila inzu yemisiita ta, nohomba? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.6",
            "verseOrgIds": [
              "1CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano omusunjile omusumba wanje Daudi ori Kano niko aka OMWAMI omwene mahe aboola; mbu Ndakhuyinia mubwayilo, mukhulonda khumakondi, mbu obe omwimilisi wabandu banje, Isiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.7",
            "verseOrgIds": [
              "1CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi ndabeelenje ninawe halala, hosi ewa watsiilenje, ninzakamia abasukubo bosi barule imbeliwo, nikhuheelesia eliira eliingana ameera kabakhongo abaliho mushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.8",
            "verseOrgIds": [
              "1CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi embaahulila abandu banje Isiraeli habundu, nimbaraaka, mbu bamenyenje habundu wabwe abeene, nibaratechesibwa ta, kata abamayaanu shibalabahwelesia khandi tawe, shinga olwa kali khale, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.9",
            "verseOrgIds": [
              "1CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shinga okhurula khunyanga eya ndalachilisia abayaasii babe khubandu banje Isiraeli; khandi ndalahula abasukubo tosi. Khandi ekhuboolela mbu OMWAMI yeetsa okhukhuumbashila iwe inzu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.10",
            "verseOrgIds": [
              "1CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa tsindaalotsio tsilaba nitsihelile etsia okhoyile okhutsia okhuba nabakuukabo, ndiliemekha owolwibulolwo munyumawo, oulaba owokhubaanabo; ne ndiliralisia eshifumbishie obushia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.11",
            "verseOrgIds": [
              "1CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye alanyumbashila inzu, nasi ndalaralisia eshifumbishie inziayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.12",
            "verseOrgIds": [
              "1CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiliba samwana, naye aliba omwana wanje; kata shindilimurusiaKhwo obuheeli bwanje oburalilu, shinga olwa ndabumurusiakhwo oyo owakhuranjilila, ta; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.13",
            "verseOrgIds": [
              "1CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa ndalamutinyisia munzu yanje khandi mubwami bwanje, obushia nobushia; eshifumbishie shilaralisibwa obushia nobushia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga amakhuwa kano kosi olwa kali, khandi shinga libisulo lino liosi olwa lili, nolwa Natsani yamusunjila Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi omuruchi niyeenjila, niyeekhala imbeli wOMWAMI nasunga mbu E OMWAMI Nyasaye, nasi nisie wina, kata inzu yanje nishiina, mbu unzusiye okhuula hano? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata elo liali likhuwa lituutu, e Nyasaye; nebutswa orumbuule inzu yomusumbawo mundaalo tsinyinji etsili okhwitsa, niumanyia aketsinzibulo etsili okhwitsa, e OMWAMI Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.17",
            "verseOrgIds": [
              "1CH.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi nakhusunjile shiina khandi, khulwa oluyali olwo olukholelwa isie omusumbawo? Okhuba wamanya omusumbawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.18",
            "verseOrgIds": [
              "1CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E OMWAMI, khulwa omusumbawo, khandi shinga omwoyokwo omwene olwa kuli, nindio wakholile obukhongo buno bwosi, okhulolosia amakhuwa amakhongo kano kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
            "verseOrgIds": [
              "1CH.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E OMWAMI, abulaho owingana iwe, kata abulaho Nyasaye undi norali iwe ta, mukosi aka khwahuliile nende amarwi keefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
              "1CH.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nihanga shiina mushialo eliingana abandubo Isiraeli, aba Nyasaye yatsia okhwinunulila omwene babe abandube; okhwinyoolela omwene eliira khulwa amakhuwa amakhongo kamariisia, norusiaho amahanga imbeli wabandubo aba wanunula muMisiri? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.21",
            "verseOrgIds": [
              "1CH.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba wakhola abandubo Isiraeli babe abandu bobo omwene inziayo; nawe OMWAMI niwikhola Nyasaye wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.22",
            "verseOrgIds": [
              "1CH.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, OMWAMI, aka wakhasunga khumakhuwa komusumbawo, khandi khumakhuwa keinzuye, katinyisibwe obushia nobushia; nawe okhole shinga olwa osunjile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.23",
            "verseOrgIds": [
              "1CH.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliiralio nalio liralisibwe nililahungwa obushia nobushiaIiri OMWAMI omwene mahe, Nyasaye waIsiraeli, toto, khuIsiraeli niye Nyasayenayo inzu yaDaudi omusumbawo yiralisiibwe imbeliwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba iwe, Nyasaye wanje, ofwimbuliile omusumbawo mbu olanyumbashila inzu; niko akachilile isie omusumbawo enzaliishe okhusaba imbeliwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.25",
            "verseOrgIds": [
              "1CH.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, OMWAMI, niwe Nyasaye; khandi usuubisiye omusumbawo lilayi lino; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
            "verseOrgIds": [
              "1CH.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi bulaano ochamile okhuheelesia inzu yomusumbawo ikhabi, mbu yitsiililile imbeliwo obushia nobushia; okhuba niwe, OMWAMI ouhaanile ikhabi; kho ikhabi yilabeetsanga khuyo obushia nobushia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.27",
            "verseOrgIds": [
              "1CH.17.27"
            ]
          }
        }
      ]
    }
  ],
