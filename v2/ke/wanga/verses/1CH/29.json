              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa Daudi waYese yaruka Isiraeli yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.26",
            "verseOrgIds": [
              "1CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo etsia yaruka Isiraeli tsiahela emiyika amakhumi kane; yaruchila eHeberoni emiyika musaafu, nemiyika amakhumi kataru nachitaru yaruchila eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.27",
            "verseOrgIds": [
              "1CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yafwa nali omuyindifu muno, nahelile tsindaalo, nobuyinda, neifuma; naye Sulemani omwanawe naruka mushilenjeshie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ebikhole biaDaudi omuruchi, okhurula khubiambeli okhuula khubiahelelesia, lola, biahandiikwa mumakhuwa kaSamweli omunabi, nomumakhuwa kaNatsani omunabii, nomumakhuwa kaGadi omulakusi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
