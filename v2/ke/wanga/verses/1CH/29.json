{
  "id": "1CH.29",
  "number": "29",
  "bookId": "1CH",
  "reference": "1 Aketsindaalo 29",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "1CH 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi omuruchi nasunjila abomukhung'aano kwosi ari Sulemani omwana wanje, owa Nyasaye yalobola yenyene, nomuraaka; ashili okhuchesihala; ne emilimo nemikhongo; okhuba inzu eyo ikhulundu shineyomundu ta, habula eyOMWAMI Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulaano ndakholile shinga olwa ndanyalile okhurecheshela inzu yaNyasaye wanje itsahaabu khulwa ebindu bieitsahaabu, ifeetsa khulwa ebindu bieifeetsa, omukasa khulwa ebindu biomukasa, eshibia khulwa ebindu bieshibia, nemisaala khulwa ebindu biemisaala; khandi nende oruchina rweishohamu, noruchina orwokhuhandibwamwo, oruchina orung'inang'inu, oruchina rwobukonde, kondo, kata nende oruchina rwetsimbia tsiosi, namachina kamarimari, ebinji okhushila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.2",
            "verseOrgIds": [
              "1CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi shinga olwa ndarakhwo omwoyo khunzu yaNyasaye wanje, nindi nende amabiikho kanje omwene akeitsahaabu neifeetsa, kho engahaanila inzu yaNyasaye wanje, halala nende biosi ebia ndarechesheele inzu indakatifu tsana; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.3",
            "verseOrgIds": [
              "1CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu itsahaabu tsitalanda ebikhumila bitaru, niyo itsahaabu yaOfiri, neifeetsa eyasalulwa tsitalanda ebikhumila musaafu, eyokhuhoma amasiisi ketsinzu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.4",
            "verseOrgIds": [
              "1CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi khulwa emilimo chiosi echiitsa okhukholwa nabafundi mbu itsahaabu khulwa ebindu bieitsahaabu, neifeetsa khulwa ebindu ebieifeetsa. Ali heena ouhaana nochuchama, niyeeyahulila OMWAMI inyanga yino?",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakhulundu bebilibwa, nabakhulundu betsimbia tsiaIsiraeli, nabaseesia bebikhumila nabebikhumi, halala nabasinjilili bemilimo chiomuruchi, nibahaana bario nokhuchama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.6",
            "verseOrgIds": [
              "1CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahaana khulwa obukhalabani bweinzu yaNyasaye itsahaabu tsitalanda ebikhumila biraano netsidarikoni ebikhumila likhumi; if eetsa tsitalanda ebikhumila likhumi; omukasa tsitalanda ebikhumila ekhumi namunaane; neshibia tsitalanda ebikhumila eshikhum. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abali nende oruchina rwolukoosi baruhaana khwibiishilo lieinzu yOMWAMI elili mubulindi bwaYehieli omuGerishoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.8",
            "verseOrgIds": [
              "1CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu nibeekhoya khulwabo abahaana nokhuchama; okhuba bahaanila OMWAMI nokhuchama, nende omwoyo kwosi; naye Daudi omuruchi yesi yeekhoya omwikhoyo omukhongo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi yamwitsoomia OMWAMI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, Daudi yamwitsoomia OMWAMI imbeli womukhung'aano kwosi; Daudi nasunga mbu E OMWAMI, Nyasaye waIsiraeli kuuka weefwe, witsoomibungwe ebisoni nebisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.10",
            "verseOrgIds": [
              "1CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E OMWAMI, obukhongo nobubwo, nobunyali, noluyali nobuhuli, nende obukhulundu; okhuba biosi ebili mwikulu nomushialo nebibio; obwami nobubwo, OMWAMI; nawe ochinguushile ikulu noba omurwe khubiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.11",
            "verseOrgIds": [
              "1CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuyinda neifuma biosi birulanga khwiwe, ne niwe ourukanga bosi; obunyali nende amaani bili mumukhonokwo; okhukaliyia khuli mumukhonokwo, kata nende okhukufuhasia bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.12",
            "verseOrgIds": [
              "1CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, Nyasaye weefwe, khukhuupila orio, nikhwitsoomia eliiralio lioluyali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi, nisie wina, kata abandu banje nibo beena mbu khunyalilwe okhuhaana khurio nende okhuchama? Okhuba ebindu biosi birulanga khwiwe, neefu khukhuheelesiye khubili ebibio omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.14",
            "verseOrgIds": [
              "1CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khuli abarende imbeliwo, nabamenyibwa, shinga abakuuka bosi olwa bali; tsindaalo tsieefwe etsiomushialo tsiingana eshiinini; kata okhutong'aho khubulaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.15",
            "verseOrgIds": [
              "1CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E OMWAMI Nyasaye weefwe, ebiamabiikho bino biosi ebia khurecheeshe okhukhuumbashila inzu khulwa eliiralio litakatifu birula mumukhonokwo; nebibio biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.16",
            "verseOrgIds": [
              "1CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, Nyasaye wanje, emanyile mbu oteemanga emioyo, nosangaalila obukololofu. Nasi, mubukololofu bwomwoyo kwanje ehaanile ebindu bino biosi nende okhuchama; ne bulaano nzikhoyile muno okhulola abandubo abali hano nibakhuhaanilanga nokhuchama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.17",
            "verseOrgIds": [
              "1CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "E OMWAMI, Nyasaye waAburahamu, nowaIsiraeli, abakuuka beefwe, witsusinjie obuyililisii bwamapaaro kemioyo chiabandubo amakhuwa kano obushia nobushia, nochoomia emioyo chiabwe khwiwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.18",
            "verseOrgIds": [
              "1CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomunyalila Sulemani omwana wanje okhurakhwo omwoyo okhulindanga amalakoko, noburumbusibo, naka walachilisia, nokhukhola ako kosi, nende okhuumbakha inzu ikhulundu tsana eya erechesheele ebindu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sulemaniyakalukha muburuchi bwaDaudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi naboolela omukhung'aano kwosi mbu Bulaano mumwitsoomie OMWAMI Nyasaye weenywe. Abomukhung'aano kwosi nibamwitsoomia OMWAMI, Nyasaye wabakuuka babwe, nibabunamia emirwe, nibamwinamila OMWAMI, khandi nende omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamalila OMWAMI emisango, nibamusambila OMWAMI emisango emisambe, khunyanga eyalonda inyanga eyo; mbu tsisurusi eshikhumila, namamiiku eshikhumila, namakondi kebimwamwane eshikhumila, halala nemisango chiachio chiokhutsushila, nemisango eminji muno khulwa Isiraeli yosi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibalia amasabo imbeli w inyanga eyo, nokhutsatsahala muno.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamwemekha Sulemani omwana waDaudi olwakhabili, nibamutsushiilila amafura abe omwimilisi khulwa OMWAMI, nende Zadoki yesi okhuba omukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Sulemani yeekhala khushifumbi shiOMWAMI naba omuruchi mushilenje shiaDaudi samwana; ne yakhwana; Isiraeli yosi yali niyimuhulilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abakhulundu, nabalulu, halala nabaana bosi bomuruchi Daudi, nibeeyama okhukhalabanila Sulemani omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namukhongoyia Sulemani muno mumoni tsiaIsiraeli yosi, namuheelesia obukhulundu bweshiami oburali khumuruchi yesi waIsiraeli owamuraniilila ta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
