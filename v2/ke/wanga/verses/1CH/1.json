          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaana baKetura, omusuria waAburahamu; mbu yeebula Zimirani, Yokoshani, Medani, Midiani, Ishibaki, nende Shuaha. Nabaana baYokoshani, mbu Sheba nende Dedani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.32",
            "verseOrgIds": [
              "1CH.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaana baMidiani; mbu Efa, Ereri, Hanokhu, Abida, nende Eledaa. Bano bosi nabaana baKetura.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.33",
            "verseOrgIds": [
              "1CH.1.33"
            ]
          }
        }
      ]
    },
    {
