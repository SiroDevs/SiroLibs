          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaana baSeiri; mbu Lotani, Shobali, Zibeoni, Ana, Dishoni, Ezeri, naDishani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.38",
            "verseOrgIds": [
