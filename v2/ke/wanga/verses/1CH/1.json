          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaana baLotani; mbu Hori naHoramu; ne mbootsonyene Lotani yali Timina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.39",
            "verseOrgIds": [
              "1CH.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baShobali; mbu Aliani, Mahanatsi, Ebali, Shefi, naOnamu. Nabaana baZibeoni; mbu Aya naAna. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.40",
            "verseOrgIds": [
              "1CH.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baAna; mbu Dishoni. Nabaana baDishoni; mbu Hamirani, Eshibani, Itsirani, naKherani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.41",
            "verseOrgIds": [
              "1CH.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baEzeri; mbu Bilihani, naZaawani, naYaakani. Nabaana baDishani; mbu Uzi nende Arani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.42",
            "verseOrgIds": [
              "1CH.1.42"
            ]
          }
        }
