{
  "id": "1TH.4",
  "number": "4",
  "bookId": "1TH",
  "reference": "1 Abatsesalonika 4",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1TH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhuchenda okhumuchamisia Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho elihelelesia, baana beefwe, ndielino; khumusaaya nikhumwitsusia muMwami Yesu, mbu olwa mweechesibwa nineefwe shinga olwa mukhoyile okhuchenda nokhumuchamisia Nyasaye, ne nindio muchendanga, mbu mumeeteshenje murio. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba mumanyile amalako aka khwamulaka khulwa Omwami Yesu shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila lino nilio elia Nyasaye yeenya, mbu amukhole abatakatifu, mbu musile obuheyi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu buli mundu khwinywe amanye okhuleera omukhasiwe mubutakatifu nende oluyali, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
              "1TH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "oburakhola mubwilaasi bwobwikombi, shinga Abamahanga abaramumanya Nyasaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi aleshe okhuyiira niyoonoonela omwana wabwe mwikhuwa lino; shichila Omwami niye omumali weshikwoli mu ako kosi, shinga olwa khwamuboolela khale nikhumurumbulila. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila Nyasaye shiyakhulanjila eshifwabwi ta, habula obutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
              "1TH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho oukhaya kano shiakhayila omundu ta, habula Nyasaye, oumuheelesia Rohowe Omutakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumakhuwa akokhuheelanga abaana beefwe, libulaho elichila nimuhandiichila ta; shichila inywe abeene mwechesibwa nende Nyasaye okhuheelananga; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
            "verseOrgIds": [
              "1TH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba toto mwene, nolwa mubakholelanga abaana beefwe bosi abomuMakedonia yosi. Ne khumuchesiyia, baana beefwe, mbu mushilaane muno; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.10",
            "verseOrgIds": [
              "1TH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu muchoome okhwichendelesia mubuholeelefu, nokhulinda akali akeenywe, nokhukhola emilimo namakhono, shinga olwa khwamulaka; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
            "verseOrgIds": [
              "1TH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu muchendenje bulayi imbeli wabali elwanyi, khandi mbu muleshe okhutamba eshindu ta.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akabafu nakabali mwoyo, khushise shiokhwitsa khwOmwami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shikhwenya mbu mukorwe, baana beefwe, khuka abo abakona tsindoolo ta; mbu muleshenje okhubeelela, shinga abandi abo ababula obunaayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.13",
            "verseOrgIds": [
              "1TH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila shinga olwa khusuubila mbu Yesu yafwa nalamukha, khandi bario abeenabo abakona tsindoolo muYesu, Nyasaye aleetsa ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.14",
            "verseOrgIds": [
              "1TH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano khumuboolela khulwa likhuwa liOmwami; mbu ifwe ababa nikhushiliho mwoyo, abatong'a okhuula khukhwitsa khwOmwami, shikhulabaranjilila balia abamala okhukona nahatuutu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Omwami omwene aleekha okhurula mwikulu halala nomulanjisio nomwoyo kwamalaika omukhulundu, nende olwika lwaNyasaye; nabo abafwila muKristo balaranjilila okhulamukha; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana ifwe ababa nikhushiliho mwoyo khulakaamwa ninabo halala mumaleesi, okhwakaana nOmwami mulwanga: mana khurio khulabeetsanga nOmwami tsindaalo tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.17",
            "verseOrgIds": [
              "1TH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mulemanie emioyo nende amakhuwa kano.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.18",
            "verseOrgIds": [
              "1TH.4.18"
            ]
          }
        }
      ]
    }
  ],
