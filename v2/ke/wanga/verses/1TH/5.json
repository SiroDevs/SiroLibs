        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khube nikhwirechesheele okhwitsa khwOmwami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumakhuwa kebise netsinduukho, baana beefwe, shimuli nende akachila nimuhandiichilwa likhuwa liosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.1",
            "verseOrgIds": [
              "1TH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila inywe abeene mumanyile bulayi mbu induukho yOmwami yiitsanga shinga omwibi olwa yeetsa mushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.2",
            "verseOrgIds": [
              "1TH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa baba nibashiboola mbu Omulembe nende obulayi, nonoho obwonooneshi bubasundusia, shinga inzibula olwa yimusundusia omukhasi ouli inda; kata shibaleehonokokha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.3",
            "verseOrgIds": [
              "1TH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa inywe, baana beefwe, shimuli mushiilima, mbu induukho eyo yimunyoolelesie shinga omwibi, ta; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.4",
            "verseOrgIds": [
              "1TH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba inywe mwesi muli abaana bobulafu, khandi abaana beshiteere; shikhuli abeshilo, kata abeshiilima, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khuleshenje okhukona tsindoolo, shinga abandu bandi ta; habula mbu khubeetsenje meeso nikhwiruka. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila abakonanga tsindoolo bakonanga eshilo; nabo abameela bameelanga eshilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ifwe, olwa khuli abeshiteere, khwiruche abeene, nikhwifwala khubilifu ebitsengwa biobusuubili nobuheeli; obunaayi bwobuhonia nabwo bube ikuutwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila Nyasaye shiyakhuraho khulwa oburima ta, habula khulwa okhunyoola obuhonia khulwa Omwami weefwe Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
            "verseOrgIds": [
              "1TH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "owakhufwila, mbu kata nikhuli meeso kata nikhukona, khubeetsenje mwoyo halala ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
            "verseOrgIds": [
              "1TH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mutinyisaninjie, nimuumbakhana, shinga olwa mukholanga.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akobuchesiyii namashiesio akahelelesia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumusaaya, baana beefwe, mbu mubeetsulile abo abanyakhananga hakari mwinywe, nibamuruka muMwami, nibamwitsusia, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.12",
            "verseOrgIds": [
              "1TH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimubaheelesia oluyali mubuheeli khulwa emilimo chiabwe. Mumenyenje mumulembe abeene nabeene. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
              "1TH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumwitsusia, baana beefwe, mbu chesiyie abakara, tinyisie abafwile omwoyo, khoonye ababula amaani, nimwisimilisilia bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.14",
            "verseOrgIds": [
              "1TH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi aleshe okhurunga owashie obubii khububii ta; nebutswa tsindaalo tsiosi mulondachililenje akali amalayi, abeene mwenyene khandi nende khubosi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.15",
            "verseOrgIds": [
              "1TH.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.15",
            "verseOrgIds": [
              "1TH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sangaalenje tsindaalo tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.16",
            "verseOrgIds": [
              "1TH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murakonelanga okhusaaya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.17",
            "verseOrgIds": [
              "1TH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumakhuwa kosi, mukhupenje orio, shichila nilio elia Nyasaye amwenyela muKristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.18",
            "verseOrgIds": [
              "1TH.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.18",
            "verseOrgIds": [
              "1TH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murasimia Roho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.19",
            "verseOrgIds": [
              "1TH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murafwola obulakusi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.20",
            "verseOrgIds": [
              "1TH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teeme amakhuwa kosi, nimuhanda khukali amalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.21",
            "verseOrgIds": [
              "1TH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwihaanye khububii bwersimhia tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.22",
            "verseOrgIds": [
              "1TH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
