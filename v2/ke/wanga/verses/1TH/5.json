        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.22",
            "verseOrgIds": [
              "1TH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye womulembe omwene amwahulile elala; mulindungwe bulayi, roho nomwoyo nomubili, mube abalamba ababula eshikha shiosi khukhwitsa khwOmwami weefwe Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.23",
            "verseOrgIds": [
              "1TH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oumulanga nomwisiikwa; alakakhola.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana beefwe, mukhusaayilenje.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.25",
            "verseOrgIds": [
              "1TH.5.25"
            ]
          }
        }
