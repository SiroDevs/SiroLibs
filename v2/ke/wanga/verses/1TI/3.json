    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akeenyekha khubaaskofu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa lino neliisiikwa, mbu omundu naba nakhaaba omulimo kwa askofu, yeenyanga omulimo omulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila askofu abe oubula eshikha; abe omusaatsa womukhasi mulala, omwileshesii, omwitembelesii, owiyilanga habwene, ouchamanga okhwinjisia abacheni, owamanya okhwechesia; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "araba omumeesi kata owobusoolo ta, habula omuholo, ourali owamayinje kata ouheelanga amapeesa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.3",
            "verseOrgIds": [
              "1TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abe ouruka bulayi litaalalie, nabahulilisia abaanabe mubwitembelesii obulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu naba nakorwa okhuruka litaalalie, alanyala arie okhulinda ikanisa yaNyasaye? ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araba omusuubili omuyiakha butswa ta, aleshe okhuba owolukungu mana akwe mushiina shiaSetani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.6",
            "verseOrgIds": [
              "1TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahalala nende ako, akhoyile okhuba oweifuma indayi mubali elwanyi, mbu aleshe okhukwa mubuchiikhwi khulwa omubero kwaSetani.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akeenyekha khubadikoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadikoni nabo bario babe aboluyali, abarali abetsinimi tsibili ta, kata abanleesi, kata abalangushilanga inganga tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "babe abahanda khumabiso kamakhuwa ako aka khusuubilanga nomwoyo omweleleshe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bosi bateemwe bario mbeli; mana nibaba nibabula eshikha, bakhalabane mubudikoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.10",
            "verseOrgIds": [
              "1TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeshikhasi nabo babe bario aboluyali, abarali abachiishi ta, abeeleshesii, abeesiikwa mumakhuwa kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadikoni babe buli mundu omusaatsa womukhasi mulala, nibaruka abaana namataala kabwe bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.12",
            "verseOrgIds": [
              "1TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ababa nibakhalabaane bulayi mubudikoni beenyoolela abeene itaracha indayi, nende itswoni mukobusuubili obuli muKristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libiso lieidini yeefwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhuhandiichila amakhuwa kano nisuubila okhwitsa ewa oli mundaalo etsili ahambikhwo; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.14",
            "verseOrgIds": [
              "1TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula mbu nimba nishinda muno omwanye akabandu shinga olwa bakhoyile okhwiyilanga mubeinzu yaNyasaye, ne nibo ikanisa yaNyasaye oubeetsangaho mwoyo, neisiilo yobwatoto nomuse kwabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba bosi bafuchilisania mbu libiso lieidini yeefwe nelikhongo; mbu",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    }
  ],
