          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Daudi yali nakalukhanga okhurula mukhwira omuFilisiti oyo, Abineri yamubukula, namuleera imbeli waSaulo nali nende omurwe kwomuFilisiti oyo mumukhono. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        },
        {
