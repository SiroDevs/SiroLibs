        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisanduku nilili mushibala shiabaFilisiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaFilisiti bali nibabukuule lisanduku liaNyasaye, nibalirusia eEbenezeri, nibaliyila eAshidodi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaFilisiti nibabukula lisanduku liaNyasaye, nibaliyila munzu yaDagoni, nibalirenjekha ahambi nende Dagoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abandu baAshidodi babuukha mumabwibwi, lola, Dagoni yaali naukwile hasi marumama imbeli welisanduku liOMWAMI. Nibabukula Dagoni, nibamukalusia mubwikhalobwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olwa babuukha mumabwibwi, lola, Dagoni yali nakwile hasi mafumama imbeli welisanduku liOMWAMI; nomurwe kwaDagoni nende ebikalo biamake kakwo biali nibikhaliishe, nibikonile hamushingachi kwomuliango; Dagoni atong'a eshirundu shionyene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila abeesaaliisi baDagoni, kata abo bosi abeenjilanga munzu yaDagoni, shibasenanga khumushingachi kwaDagoni eAshidodi tawe, okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhono kwOMWAMI nikuba omusiro khubaAshidodi, naye nabariisia, nabarootsa nende amabumba, habwenaho eAshidodi nomunzakho tsialio. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abaAshidodi balola shinga olwa kali, basunga mbu Lisanduku liaNyasaye waIsiraeli shililamenyanga mwifwe ta; okhuba omukhonokwe nomusiro khwifwe, khandi khuDagoni nyasaye weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.7",
            "verseOrgIds": [
              "1SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana nibarumana nibakhung'aasia abaami bosi babaFilisiti ewa bali, nibaboola bari Nakhulikhole khurie lisanduku liaNyasaye waIsiraeli? Nabo nibakalusia mbu Lisanduku liaNyasaye waIsiraeli libotokhasibwe liyilwe eGatsi. Nibabotokhasia lisanduku liaNyasaye nibaliyilayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu olwa bali nibaliyilile, omukhono kwOMWAMI kwayinga litookho elo, nikulikoyaasia muno muno: naye yakhupa abelitookho, abatuutu nende abakhongo, amabumba nikabatiila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibayila lisanduku liaNyasaye eEkeroni. Ne olwa lisanduku liaNyasaye lioola eEkeroni, abaEkeroni bachinga olukhu, bari Bakhuleereele lisanduku liaNyasaye waIsiraeli mbu likhwire halala nende abandu beefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana nibarumana nibakhung'aasia abaami bosi babaFilisiti, nibasunga bari Lirusie mwifwe lisanduku liaNyasaye waIsiraeli, likalushe habundu walio, lileshe okhukhwira halala nende abandu beefwe; okhuba bwaliho obukoyaani bwokhufwa mwitaala liosi; omukhono kwaNyasaye nikuba omusiro muno habwenaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.11",
            "verseOrgIds": [
              "1SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abandu abarafwa ta, libumba liabatiila; tsimbungu tsielitaala nitsituumuukha mwikulu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.12",
            "verseOrgIds": [
              "1SA.5.12"
            ]
          }
        }
      ]
    }
  ],
