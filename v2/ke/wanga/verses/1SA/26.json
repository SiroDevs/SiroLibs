{
  "id": "1SA.26",
  "number": "26",
  "bookId": "1SA",
  "reference": "1 Samweli 26",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
