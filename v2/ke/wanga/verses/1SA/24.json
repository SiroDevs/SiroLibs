{
  "id": "1SA.24",
  "number": "24",
  "bookId": "1SA",
  "reference": "1 Samweli 24",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "1SA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi yalekha okhuira Saulo, eEnigedi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Ne olwa Saulo yali nacheleele okhurula mukhulonda abaFilisiti, yaboolelwa ari Lola, Daudi ali mushitsiimi shieEnigedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.1",
            "verseOrgIds": [
              "1SA.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo nabukula abandu ebikhumila bitaru abali nibaloboolwe muIsiraeli yosi, natsia okhukhaaba Daudi nende abandube munyanda tsietsimbusi tsinabulimo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.2",
            "verseOrgIds": [
              "1SA.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyoola hakhonje tsiamakondi etsiali khunjila eyo, ewa yali imbinga; Saulo niyeenjilamwo mbu yeefuunishe ebilenje. Ne khane Daudi nende abandube bali nibeekhaale mumbinga eyo mukari bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.3",
            "verseOrgIds": [
              "1SA.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu baDaudi nabo nibamusunjila bari Lola, inyanga yino niyo eya OMWAMI yakhuboolelakhwo, ari Lola, enzitsa okhuhaana omusukuwo mumukhonokwo, nawe olamukholela shinga olwa oluutsi. Mana Daudi nabuukha, nateta eshitonye eshiokhundulo weikanzu yaSaulo masilisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.4",
            "verseOrgIds": [
              "1SA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olunyumakhwo ikholo yamurimukha Daudi, shichila yali natetile eshitonye shieingubo yaSaulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.5",
            "verseOrgIds": [
              "1SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nasunjila abandube ari Shilinyalikha tawe mbu emukholele endio omwami wanje, masihu wOMWAMI, okhukololosia omukhono kwanje khuye, olwa ali ye masihi wOMWAMI, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio Daudi yayinjila abandube nende amakhuwa ako, narabafuchiilila okhumurulilakhwo Saulo tawe. Naye Saulo nabuukha narula mumbinga, natsia butsia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.7",
            "verseOrgIds": [
              "1SA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.7",
            "verseOrgIds": [
              "1SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne munyumawe Daudi yesi nabuukha, narula mumbinga, nalanga munyuma waSaulo, nasunga ari Omwami wanje omuruchi! Nolwa Saulo yakhupa amashemo, Daudi yabunamia obwenibwe hasi namwinamila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.8",
            "verseOrgIds": [
              "1SA.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi namusunjila Saulo ari Mbushiina norechelesinjia amakhuwa kabandu, mbu Lola, Daudi akhaabanga okhukhukholela obubii? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.9",
            "verseOrgIds": [
              "1SA.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, inyanga yino tsimoni tsitsio omwene tsiluutsi shinga OMWAMI olwa abeele nakhuhaanile mumukhono kwanje mumbinga yino; abandi nibambiila mbu ekhwire; nasi nikhulekha, nisunga mbu Shindalakololosia omukhono kwanje khumwami wanje ta; okhuba ni masihi wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.10",
            "verseOrgIds": [
              "1SA.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi papa, lola, eshitonye shiokhundulo weikanzuyo shieshino mumukhono kwanje; okhuba olwa endetile eshitonye shiokhundulo weikanzuyo, nindakhwira ta, omanye nende okhulola mbu shibulimwo kata obubii kata obukhayi mumukhono kwanje tawe, khandi mbu shindakhwonooneele tawe, kata olwa oyimanga obulamu bwanje okhubuyiniaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.11",
            "verseOrgIds": [
              "1SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI akabukhasie hakari wanje ninawe, khandi OMWAMI amale eshikwoli shianje khwiwe; ne omukhono kwanje shikulaba khwiwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.12",
            "verseOrgIds": [
              "1SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga oluchelo lwabandu bakhale olwa luboola, mbu Mubamayaanu murulangamwo obumayaanu; nebutswa omukhono kwanje shikulaba khwiwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.13",
            "verseOrgIds": [
              "1SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi waIsiraeli aruliile wina? Niwina owa olondachilila? Olonda imbwa ifu; olonda eshichinji. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
            "verseOrgIds": [
              "1SA.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako OMWAMI abe omukabukhasii, akhalache amakhuwa hakari wanje ninawe, alole, niyafunaanila eshiina shianje, niyambonia mumukhonokwo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
              "1SA.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
              "1SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Daudi yali niyakhamalilisia okhusunjila Saulo amakhuwa kano, Saulo yaboola mbu Okwo nomwoyo kukwo, Daudi mwana wanje? Saulo nachingula omwoyokwe nalila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.16",
            "verseOrgIds": [
              "1SA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusunjila Daudi ari Iwe oli omulunjishi okhushila isie; wayakholeele amalayi, olwa isie ndakhukholeele iwe amabii. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.17",
            "verseOrgIds": [
              "1SA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano wakhaboola habulafu inyanga yino shinga olwa ukholeele amalayi; okhuba olwa OMWAMI abeele nambaanile mumukhonokwo, shiunzirile tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
            "verseOrgIds": [
              "1SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omundu naba namunyoola omusukuwe, yakhamulekha atsie nali omulamu noho? Niko akachila, OMWAMI akhuheelesie amalayi khulwako aka ukholeele inyanga yino. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.19",
            "verseOrgIds": [
              "1SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, lola, emanyile mbu olaba omuruchi toto, khandi mbu obwami bwaIsiraeli bularalisibwa mumukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.20",
            "verseOrgIds": [
              "1SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, unditsubile khuMWAMI, mbu shiolasisia olwibulo lwanje munyuma wanje, kata mbu shiolasiliisia eliira lianje lirule mushilibwa shiapapa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
              "1SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi namwitsubila Saulo. Mana Saulo niyeenyokha; habula Daudi nende abandube batikulukha nibatsia mulukoba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.22",
            "verseOrgIds": [
              "1SA.24.22"
            ]
          }
        }
      ]
    }
  ],
