        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lihe liabaFilisiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yali owemiyika nabulebe olwa yachaaka okhuruka; naruka emiyika nabulebe nende chibili khuIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Saulo yalobola abandu ebikhumila bitaru mubaIsiraeli; ne khubo ebikhumila bibili bali halala nende Saulo eMikhamashi khandi mubikulu biaBeteli, nabandi eshikhumila bali halala nende Yonatsani eGibea yaBenyamini; nabandi bosi abasikala yabaseebula bakalushe buli mundu ebunangowe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.2",
            "verseOrgIds": [
              "1SA.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yonatsani yarootsa abasikaari abaFilisiti abalindi abali eGeba, abaFilisiti beene nibahulilakhwo. Saulo nakhupa olwika mushialo shiosi, nasunga mbu AbaHeburania bahulile. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.3",
            "verseOrgIds": [
              "1SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaIsiraeli bosi nibahulila nikasungwa mbu Saulo warootsile abasikaari abaFilisiti abalindi, khandi shinga Isiraeli olwa yasinya abaFilisiti. Abandu bosi nibakhung'aana ewaSaulo eGiligali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaFilisiti nibakhung'aana halala okhuseerana nende Isiraeli, amakaari ebikhumila amakhumi kataru, nabachendela khufarasi ebikhumila bisasaba, nende abandu shingana omuyeshe okuli khulukuku Iweinyanza obunji bwabwe; nibatikulukha, nibakhoma ikambi yabwe eMikhamashi, khulubeka lwebukwe lwaBetsiaweni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa abandu baIsiraeli balola shinga olwa batsunasiibwe, okhuba abandu bali nibahachilisiibwe kho abandu nibeebisa mumbinga, khandi mumbangatsi, khandi munyanda, khandi mumeena, nende mumayabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandi abokhubaHeburania bali nibaambuushe Yorodani nibatsia mushialo shiaGadi nende Gileadi; ne Saulo yali nashili eGiligali, abandu bosi nabo nibamulondakhwo nibatechela.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nalinda tsindaalo musaafu, okhuula khunduukho eya Samweli yali niyalachile; ne Samweli shiyayoola eGiligali ta; abandu nabo bali nibasalaanile nibamurulilelchwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
            "verseOrgIds": [
              "1SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nasunga mbu Mundeerele omusango okwokhusambwa hano, nende omusango kwokhwishia. Mana namala omusango omusambe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali niyakhamala okhumala omusango omusambe, Samweli naye nafutukha; naye Saulo narula okhumubukaanila, mbu amushiesie. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.10",
            "verseOrgIds": [
              "1SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli nareeba ari Okholile orie? Saulo nakalusia mbu Olwa enduutsi abandu nibasalaanile nibarulilekhwo, nawe shinga olwa oreetsile mundaalo etsia khwalakana ta, nende abaFilisiti shinga olwa bakhung'aanile eMikhamashi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila nisunga mbu Bulaano abaFilisiti beetsa okhukholomokha nibarulila eGiligali, nasi nishili okhwikongoya OMWAMI, akhukoosie obukoosia; kho ndinichilisiye, nimala omusango omusambe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli nasunjila Saulo ari Okholile akobuyingwa; shiolindile lilako liOMWAMI Nyasayewo, elia yakhulaka, ta, okhuba khane bulaano OMWAMI yakhatinyisiye oburuchibwo khuIsiraeli inziayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano oburuchibwo shibulasimbiila ta; OMWAMI yeekhaabila omundu owa omwoyokwe kuwinjana nende okukwe omwene, khandi OMWAMI yalaka mbu ye abe omwimilisi khubandube, shichila iwe shiwalindile akeenako aka OMWAMI yakhulaka tawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli narula natikulukha okhurula eGiligali okhuula eGibea yaBenyamini. Naye Saulo nabasia abandu aba yali ninabo halala, mbu abandu shinga ebikhumi bisasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Saulo, nende Yonatsani omwanawe, nende abandu aba bali ninabo halala, nibeekhala eGeba yaBenyamini; habula abaFilisiti bakhoma ikambi yabwe eMikhamashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamululi nabo nibarula mukambi yabaFilisiti emikanda chitaru; omukanda mulala kwashiukhana khunjila eyitsia eOfura, khushialo shiaShuali; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
              "1SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukanda kundi nikushiukhana khunjila yeBetsehoroni; omukanda kundi nikushiukhana khunjila yolwakho oluhenjile khulubanda lwaZeboimu elubeka Iwenashitsiimi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwiraanyi yesi shiyali nanyoolekhangakhwo mushialo shiosi shiaIsiraeli ta; shichila abaFilisiti baboola bari AbaHeburania bakheeyi-ranyila abeene tsinganga kata amafumo; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.19",
            "verseOrgIds": [
              "1SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne abaIsiraeli bosi bali nibakholomokhanga nibatsia mubaFilisiti, mbu buli mundu ayiakale imbakoye, nende omuremelokwe, nende ihaywaye, nende olubelwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula bali nende itufa yokhuyiakalila tsimbe, nende emiremelo, nende obuuma, nende tsihaywa; khandi nende okhukasia tsinjela. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nikaba mbu khunyanga yelihe shishianyoolekhakhwo kata olukanga kata lifumo mumukhono kwomundu yesi khubeenabo aba Saulo nende Yonatsani bali ninabo tawe; habula Saulo nende Yonatsani omwanawe nibo abali ninabio. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.22",
            "verseOrgIds": [
              "1SA.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'anda yabasikaari abaFilisiti nayo niyirula niyitsia mumbaka yaMikhamashi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.23",
            "verseOrgIds": [
              "1SA.13.23"
            ]
          }
        }
      ]
    }
  ],
