    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esita yakholwa Omukhaye zvomuruchi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwamakhuwa ako, olwa oburima bwomuruchi Ahasuwero bwali nibuhotseleeshe, yeetsulila Washiti naka yakhola, nende akalakwa khuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abasumba bomuruchi abamukhalabanila nibamusunjila bari Abakhaana abashisila abakaasu abashili ababuukha bakhaabwe khulwa omuruchi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omuruchi areho abakali mungongo tsiosi etsiomuburuchibwe, mbu bakhung'aasie halala abakhaana bosi abashisila abakaasu abashili ababuukha eSusa mwitookho, munzu yabakhasi, mubulindi bwaHegai omusumba omulate womuruchi, ouli omulindi wabakhasi; baheebwe amafura kabwe akokhwibakha; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omukhaana ouchamisia omuruchi, abe omukhayewe mushilenje shiaWashiti. Likhuwa elo nilichamisia omuruchi; naye nakhola ario.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho yaliho omuYahudi undi eSusa mwitookho, owa eliiralie liali Moridekai, waYairi waShimei waKishi, omuBenyamini; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yali niyarusiibwe eYerusalemu halala nabahambe abo abayilwa halala nende Yekonia omuruchi waYuda, owa Nebukadineza omuruchi waBabeli yali niyayila. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.6",
            "verseOrgIds": [
              "EST.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yamwoola Hadasa, mbu Esita, omukhaana wousamwana; okhuba shiyalikhwo nende samwana kata nyina ta; ne omukhaana tsana yali omulayi oweshiiso; ne olwa samwana nende nyina bali nibafwile, Moridekai yamubukula abe omukhaanawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.7",
            "verseOrgIds": [
              "EST.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa lilako noburumbusi bwomuruchi bwamanyikha, abakhaana abanji nibakhung'aaniile halala eSusa mwitookho, mubulindi bwaHegai, naye Esita yaleerwa enanzu womuruchi, mubulindi bwaHegai, omulindi wabakhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.8",
            "verseOrgIds": [
              "EST.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhaana oyo namuchamisia, nikachila namukoosia; kata yamuheelesia bwangu amafurake akokhwibakha, nomukabokwe kwebiokhulia, nende abakhaana abalobole musaafu, okhurula munzu yomuruchi; namuhuyia halala nabakhaanabe nabara mubwikhalo obulayi munzu yabakhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.9",
            "verseOrgIds": [
              "EST.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Esita shiyali nabuulile akoluyialwe kata abeekhobe ta; okhuba Moridekai yali namulachile mbu aleshe okhukabuula. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.10",
            "verseOrgIds": [
              "EST.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Moridekai yachendanga buli nyanga imbeli wolwanyi Iweinzu yabakhasi, okhumanya akaEsita shinga olwa kali, nende akakhaba nikamukwila.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyanga yabuli mukhaana okhwinjila ewomuruchi Ahasuwero olwa yoola, olwa yalinamalile okhukholelwa kosi akalachilisilibwa abakhasi emiesi ekhumi nachibili, okhuba nolwa tsindaalo tsiokhung'oonibwa khwabwe tsiahelanga, mbu emiesi chisasaba namafura kamanemaane, nemiesi chisasaba nemisaala chieshing'aari namafura aka abakhasi beebakhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.12",
            "verseOrgIds": [
              "EST.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho olwa omukhaana yeenjilanga ario ewomuruchi, yaheebungwa shiosi shiosi eshia yeenya munzu yabakhasi, mbu atsie ninashio enanzu yomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.13",
            "verseOrgIds": [
              "EST.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungoloobe yatsiitsanga, mana nibushia mukamba yachelelanga, natsia munzu yakhabili yabakhasi, mubulindi bwaShaashigazi, omusumba omulate womuruchi, owalindanga abasuria; kata shiyayeenjilanga ewomuruchi khandi ta, habula omuruchi niyakhaba namusangaalila, nalanga eliiralie.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.14",
            "verseOrgIds": [
              "EST.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.14",
            "verseOrgIds": [
              "EST.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa inyanga yoola yaEsita, omukhaana waAbihaili, ousamwana Moridekai, owali niyamubukula abe omukhaanawe, eyokhwinjila ewomuruchi, shiyasaba eshindu shiosi ta, habula ebia Hegai omusumba omulate womuruchi, omulindi wabakhasi, yamulaka. Naye Esita nakoosibwa imbeli wabosi abamulola. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.15",
            "verseOrgIds": [
              "EST.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Esita yaleerwa ewomuruchi Ahasuwero munzuye yoburuchi mumwesi kwekhumi, nikwo omwesi Tebetsi, mumuyika kwomusaafu okwoburuchibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.16",
            "verseOrgIds": [
              "EST.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi yaheela Esita okhushila abakhasi abo bosi; naye yanyoola okhukoosibwa nokhuchamwa imbeliwe okhushila abashisila abashie bosi; okhuula olwa yara olusimbi Iwoburuchi khumurwekwe, namukhola abe omukhaye mushilenje shiaWashiti. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.17",
            "verseOrgIds": [
              "EST.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nakholela abakhulundube bosi nabasumbabe lisabo likhongo, nilio lisabo liaEsita; khandi yahaana obuhuluushi mungongotsie, nahaana ebihaanwa, omukhonokwe omusiro shinga olwa kwali.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.18",
            "verseOrgIds": [
              "EST.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moridekai yabisula obukhobani okhwira omuruchi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.18",
            "verseOrgIds": [
              "EST.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa abakhaana abashisila bali nibakhung'aanile halala olwakhabili, Moridekai yali niyeekhaale muluyia Iwewomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.19",
            "verseOrgIds": [
              "EST.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita naye yali narashiabuulakhwo akabeekhobe kata oluyialwe ta, shinga Moridekai olwa yali namulachilisiye; okhuba Esita yakholanga aka Moridekai yalaka, shinga olwa yakholanga niyoolwa ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.20",
            "verseOrgIds": [
              "EST.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mundaalo etsio, olwa Moridekai yali niyeekhaale muluyia, babili abokhubasumba abalate bomuruchi, banga Bigitsani naTereshi, abali khubalindi bomuliango, bali noburima, nibakhaaba okhutiila omuruchi Ahasuwero okhumwira. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.21",
            "verseOrgIds": [
              "EST.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elo nilimanyishila Moridekai, naye namumanyia Esita omukhaye womuruchi; naye Esita naboolela omuruchi, muliira liaMoridekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.22",
            "verseOrgIds": [
              "EST.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa banoonelesia amakhuwa ako, kanyoolekha mbu kali habwene; kho nibafungwa khumusaala bombi; nako nikahandiikwa muShitabu shiAmakhuwa keTsindaalo, imbeli womuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.23",
            "verseOrgIds": [
              "EST.2.23"
            ]
          }
        }
      ]
    }
  ],
