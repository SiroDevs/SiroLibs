    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhufwa khwabeekulanda karumbulwa khale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI namusunjila Musa mbu Lishiliho linyasio elala elia enzitsa okhuleerela Farao nende Misiri; olunyumakhwo alamulekhuula muruleyo; nolwa alamulekhuula mutsie, toto mwene alamwilusilia elala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musunje bulaano mumarwi kabandu, mbu buli musaatsa asabe omumenyaniwe, khandi buli mukhasi asabe omumenyaniwe, ebimili bieifeetsa nende ebimili bieitsahaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nachila abaMisiri nibakoosia abandu abo. Khandi Musa oyo yali omukhongo muno mushialo shiaMisiri, mumoni tsiabasumba baFarao, khandi mumoni tsiabandu bosi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa nasunga mbu Kano niko aka OMWAMI aboola; mbu Mushilo hakari ndalarula nimbira muMisiri; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana abeekulanda abomushialo shiaMisiri balafwa, okhurula khumwikulanda waFarao mwene owikhaale khushifumbi shiobwami, kata okhuula khumwikulanda womukhasi omukholi ouli khuluchina; nende ebiibulwa ebiambeli biemiruko chiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsilabaho tsimbungu tsinyinji mushialo shiosi shiaMisiri, kata tsirashiabaho etsifwana tsirio ta, kata shitsilibaho etsifwana tsirio tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khubaana baIsiraeli, kata imbwa shiyilasemakhwo ta, khumundu kata khumuruko; mbu mumanye shinga OMWAMI olwa yaahukhasinjia abaMisiri nende Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abasumbabo bano bosi balakholomokha nibanzitsila, nibanzinamila, nibasunga bari Orule, halala nende abandu bosi abali abalondibo; nolunyuma lwa ako, ndalarula. Narula ewaFarao noburima obululu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI nasunjila Musa mbu Farao shialakhuhulila ta; mbu akamakana kanje keenjihe mushialo shiaMisiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nende Haruni nibakhola akamakana kano kosi imbeli waFarao; nebutswa OMWAMI yatinyia omwoyo kwaFarao, Farao naye naralekhuula abaana baIsiraeli barule mushialoshie ta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
    }
