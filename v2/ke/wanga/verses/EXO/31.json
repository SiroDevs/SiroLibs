    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omulango kwaBezaleli naOholiabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.1",
            "verseOrgIds": [
              "EXO.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, enanjile eliira liaBezaleli omwana waUri, omwana waHuri, owoluyia lwaYuda; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.2",
            "verseOrgIds": [
              "EXO.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimwitsusiamwo Roho waNyasaye mubusitsa nobumanyilisi nobumanyi, nobukholi bwemilimo chiosi eel iahukhaane, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhukoora ebikhole biobusitsa, nokhukholela itszhaabu neifeetsa, nomukasa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.4",
            "verseOrgIds": [
              "EXO.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhukhalaka amachina khulwa okhureebwa khushindu, nokhubaatsa emisaala, nokhukhola emilimo chiosi echiahukhaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.5",
            "verseOrgIds": [
              "EXO.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi lola, ndaloboole nende Oholiabu yesi omwana waAhisamaki, owoluyia lwaDani; khandi mumioyo chiabosi abali abemioyo chiobusitsa, ndareelemwo obusitsa, mbu bakhole bios ebia ekhulachilisiye; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.6",
            "verseOrgIds": [
              "EXO.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu liheema liokhwakaana, nelisanduku lioburumbusi, nelitisilo elilikhwo, nebichio biosi bieliheema; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende imeesa nebindu biayo, neshichibi shietsitaha eshieleleshe nebichio biashio biosi, neshimalilo shiamalesi kelibuuliesi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende eshimalilo shiemisango emisambe nebichio biashio biosi, nolutaabo neshichibi shialwo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende ebiifwalo ebilukhwa bulayi, ebiifwalo ebitakatifu biaHaruni omukuhani, nebiifwalo biabaanabe, okhukhalabana mubukuhani; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende amafura kokhutsushiilila, namalesi kelibuuliesi akeshing'aari khulwa habundu ahatakatifu; balakhola kosi aka ekhulachilisiye shinga olwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sabato shinga olwa yili eshilolelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi osunjile abaana baIsiraeli ori Okhuula mulindenje tsisabato tsianje; shichila neshilolelo hakari wanje nineenywe munzibulo tsieenywe tsiosi; mumanye mbu nisie OMWAMI oumwahula. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako mulindenje isabato; shichila neindakatifu khwinywe; buli mundu yesi ouchionoonia, okhuula yeerwe; okhuba omundu yesi oukholelakhwo omulimo kwosi, omlmdu oyo yaakamibwe mubandu babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.14",
            "verseOrgIds": [
              "EXO.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emilimo chikholungwe tsindaalo tsisasaba; ne khunyanga yomlusaafu neisabato yomuhongo, indakatifu yOMWAMi; omundu yesi oukhola omulimo kwosi khunyanga yeisabato, okhuula yeerwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu-lwako abaana balsiraeli balindenje isabato, okhukholanga akeisabato munzibulo tsiabwe tsiosi, khulwa indakano eyirahwaho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neshilolelo hakari wanje nende abaana baIsiraeli obushia nobushia; shichila mundaalo tsisasaba OMWAMI yalonjelamwo likulu nende eshibala, mana khunyanga yomusaafu yahuluukha nachoonyolokha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshimoosi shieitsahaabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa yali namalilisiye okhusungana nende Musa mushikulu shiaSinai, yamuheelesia orubaho orwo rubili rwoburumbusi, orubaho rwamachina, oruhandiichilwe nende olwala lwaNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        }
      ]
    }
