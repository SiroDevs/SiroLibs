    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila Musa ari Lola, ekhukholile okhuba omunyasaye khuFarao; naye Haruni omusiani weenywe alabeetsanga omunabiiwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe olaboolanga kosi aka ndalakhulakanga; naye Haruni omusiani weenywe alamusunjila Farao, mbu alekhuule abaana baIsiraeli barule mushialoshie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalatinyia omwoyo kwaFarao, ninyinjiyia ebilolelo bianje nende akamakana kanje mushialo shiaMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.3",
            "verseOrgIds": [
              "EXO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Farao shialamuhulila ta, nasi ndalara omukhono kwanje khuMisiri, nirusiamwo amahe kanje, abandu banje, nibo abaana baIsiraeli, okhurula mushialo shiaMisiri, khulwa obukhalachi obukhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.4",
            "verseOrgIds": [
              "EXO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaMisiri balamanya mbu isie nisie OMWAMI, olwa ndalanyiila omukhono kwanje khuMisiri, nirusia abaana baIsiraeli okhurula mubo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa nende Haruni nibakhola bario; shinga OMWAMI olwa yabalaka, nolwa bakhola bario. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
            "verseOrgIds": [
              "EXO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Musa yali owemiyika amakhumi munaane, Haruni naye nali owemiyika amakhumi munaane nende chitaru, olwa basungana nende Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.7",
            "verseOrgIds": [
              "EXO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Indabushi yaHaruni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.7",
            "verseOrgIds": [
              "EXO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI yasunjila Musa nende Haruni mbu ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.8",
            "verseOrgIds": [
              "EXO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa Farao alamusunjila ari Mwilolosiekhwo khulwa eliamakana; mana olamubiila Haruni mbu Bukula indabushiyo, ochifuube hasi imbeli waFarao, yikwe inzokha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.9",
            "verseOrgIds": [
              "EXO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa nende Haruni beenjila ewaFarao, nibakhola bario, shinga OMWAMI olwa yali nabalachile; Haruni nafuuba indabushiye imbeli waFarao nende abasumbabe, nayo niyikwa inzokha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.10",
            "verseOrgIds": [
              "EXO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Farao yesi yalanga abandu bobuchesi nende abafumu; nabo bosi, abachesi baMisiri, nibakhola bari nanwa nende akamabiswi kabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.11",
            "verseOrgIds": [
              "EXO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba bafuuba hasi buli mundu indabushiye, natsio nitsikwa tsinzokha; habula indabushi yaHaruni yamila tsindabushi tsiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
              "EXO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omwoyo kwaFarao kwatinya, kata shiyabahulila ta; shinga OMWAMI olwa yali naboolile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
            "verseOrgIds": [
              "EXO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Linyasio liemabanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
            "verseOrgIds": [
              "EXO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI nasunjila Musa ari Omwoyo kwaFarao nomuumu; alobile okhulekhuula abandu batsie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.14",
            "verseOrgIds": [
              "EXO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutsiile Farao nikushili mutsuli, olwa arula natsia enamatsi; nawe nosinjile khulukuku Iwomwalo, wakaane ninaye; nayo indabushi eyakwa inzokha, obe ninayo mumukhono. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.15",
            "verseOrgIds": [
              "EXO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omusunjile mbu OMWAMI, Nyasaye wabaHeburania, ya'ruma khwiwe, naboola mbu Lekhuula abandu banje batsie, mbu ba'khalabanile mushitsiimi; lola, okhuulane bulaano orashiahulila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.16",
            "verseOrgIds": [
              "EXO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI aboola; mbu Khwikhuwa lino olamanya shinga olwa endi OMWAMI; lola, ndalakhupa khumatsi akali mumwalo kwaNaili nende indabushi yino eyili mumukhono kwanje, nako kalakwa amabanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.17",
            "verseOrgIds": [
              "EXO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsinyeeni etsili mumwalo kwaNaili tsilafwa, omwalo nakwo kulahunya obubolo; abaMisiri nabo balakhumbulwa okhunywa amatsi akomumwalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.18",
            "verseOrgIds": [
              "EXO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI nasunjila Musa mbu Biila Haruni ori Bukula indabushiyo, onyiile omukhonokwo hekulu khumatsi kosi kaMisiri, hekulu khumialo kabwe, hekulu khutsikhwaru tsiabwe, hekulu khumatiba kabwe, nende hekulu khubuli hosi aha amatsi kali, mbu kakwe amabanga; ne kalabaho amabanga mushialo shiosi shiaMisiri, kata mumatanji ketsimbaho kata mukamachina.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nende Haruni nibskhola bario, shinga OMWAMI olwa yabalaka; nachinguula indabushi, nakhupa khumatsi akali mumwalo kwaNaili, imbeli waFarao khandi imbeli wabasumbabe; amatsi kosi akali mumwalo nikakwa amabanga ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.20",
            "verseOrgIds": [
              "EXO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsinyeeni etsiali mumwalo nitsifwa; omwalo nikuhunya obubolo, abaMisiri nabo nibaramyala okhunywa amatsi akarula mumwalo ta; amabanga ako nikabaho mushialo shiosi shiaMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.21",
            "verseOrgIds": [
              "EXO.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafumu beMisiri nabo nibakhola bari nanwa nende akamabiswi kabwe nebutswa omwoyo kwaFarao kwatinya, kata shiyabahulila ta; shinga OMWAMI olwa yali naboolile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.22",
            "verseOrgIds": [
              "EXO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao nashiukhana niyeenjila munzuye, kata khwikhuwa elo khandi nayiniakhwo omwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaMisiri nabo bosi nibayaba khumwalo mbu banyoole zmatsi akokhunywa; okhuba bakhaywa okhunywa khumatsi akomumwalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo nitsihwa musaafu, OMWAMI olwa yali namalile okhuupa omwalo kwaNaili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
      ]
    }
  ],
