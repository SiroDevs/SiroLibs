        "sid": "EXO 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Bezaleli nende Oholiabu bakhole emilimo, nende buli mundu omusitsa, owa OMWAMI yareele muye obusitsa nende obumanyilisi mbu amanye okhukhola emilimo chiosi chiobukhalabani bwahabundu aho ahatakatifu, shinga olwa OMWAMI yalachilisiye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abandu baleera ebindu ebinji okhushilaasia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa yalanga Bezaleli nende Oholiabu, nende buli mundu omusitsa, owa OMWAMI yali nareele mumwoyokwe obusitsa, buli mundu owa omwoyokwe kwamubuusia okhwitsa khumilimo mbu achikhole; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.2",
            "verseOrgIds": [
              "EXO.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nabaheelesia omusololo okwo kwosi okwa abaana baIsiraeli bali nibaleerile khulwa emilimo chiobukhalabani bwahabundu aho ahatakatifu, okhuhakhola. Nabo nibatasa okhumuleerela buli mutsuli ebihaanwa biokhuchama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.3",
            "verseOrgIds": [
              "EXO.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abandu bosi bobusitsa abali nibakholanga emilimo chiosi chiahabundu ahatakatifu, beetsa nibarula buli mundu khumilimo echia yali nakholanga; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.4",
            "verseOrgIds": [
              "EXO.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibamusunjila Musa bari Abandu baleeranga ebindu ebinji muno ebishilaasia obukhalabani bwemilimo echia OMWAMI yakhulachile okhukhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Musa nalachilisia, nabo nibatswania amakhuwa ebulafu mukambi, mbu Omundu yesi, kata omusaatsa kata omukhasi, aleshe okhukhola emilimo chindi khulwa omusololo kwahabundu ahatakatifu ta. Nindio abandu bakaywa oburaleera khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.6",
            "verseOrgIds": [
              "EXO.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ebindu ebia bali ninabio biali nibihelile emilimo chiosi okhuchikhola, nende okhushilaho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.7",
            "verseOrgIds": [
              "EXO.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukholi bweshimenyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.7",
            "verseOrgIds": [
              "EXO.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bosi abali abasitsa mubakholanga emilimo echio, nibakhola eshimenyo netsingubo tsinzeleesia ekhumi; etsieikitani indorotoro isiire, netsingubo tsieibuluu, netsieisambarau, netsiranzayi, nende abakerubi, emilimo chiomulushi wamang'oole, bashikhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.8",
            "verseOrgIds": [
              "EXO.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburambi bwabuli ngubo inzeleesia bwali emikhono amakhumi kabili namunaane, nobubambalifu bwabuli ngubo inzeleesia emikhono chine; tsingubo tsinzeleesia tsiosi tsiali etsieshichelo shilala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.9",
            "verseOrgIds": [
              "EXO.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.9",
            "verseOrgIds": [
              "EXO.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yoonga tsingubo tsinzeleesia tsiraano halala, buli ngubo khuyindi; khandi etsindi tsingubo tsinzeleesia tsiraano yatsiunga, buli ngubo khuyindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.10",
            "verseOrgIds": [
              "EXO.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola ebifuulwa bieibuluu khundulo weingubo inzeleesia eyahelelesia khutsioongwa tsiambeli; khandi nakhola ario khundulo weingubo inzeleesia eyahelelesia khutsioongwa tsiakhabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.11",
            "verseOrgIds": [
              "EXO.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhola ebifuulwa amakhumi karaano khungubo inzeleesia ndala, khandi yakhola ebifuulwa amakhumi karaano khundulo weingubo inzeleesia eyali mutsioongwa tsiakhabili; ebifuulwa ebio nibihengana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.12",
            "verseOrgIds": [
              "EXO.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola ebitiili amakhumi karaano bieitsahaabu, niyoongasia ingubo inzeleesia ndala khuyindi nebitiili bienebio; eshimenyo nishiba shirio shilala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.13",
            "verseOrgIds": [
              "EXO.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.13",
            "verseOrgIds": [
              "EXO.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhola nende tsingubo tsinzeleesia tsiobwoya bwetsimbusi, tsibe liheema hekulu weshimenyo; yakhola tsingubo tsinzeleesia ekhumi nandala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.14",
            "verseOrgIds": [
              "EXO.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburambi bwabuli ngubo inzeleesia bwali emikhono amakhumi kataru, nobubambalifu bwabuli ngubo inzeleesia emikhono chine; tsingubo tsinzeleesia etsio ekhumi nandala tsiali etsieshichelo shilala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.15",
            "verseOrgIds": [
              "EXO.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyoonga tsingubo tsinzeleesia tsiraano khubwatsio, khandi tsingubo tsinzeleesia tsisasaba khubwatsio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.16",
            "verseOrgIds": [
              "EXO.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola ebifuulwa amakhumi karaano khundulo weingubo inzeleesia eyahelelesia khutsioongwa etsio, khandi ebifuulwa amakhumi karaano khundulo weingubo inzeleesia khutsioongwa tsiakhabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.17",
            "verseOrgIds": [
              "EXO.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola nende ebitiili amakhumi karaano ebiomukasa okhuungasia liheema halala, libe elala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.18",
            "verseOrgIds": [
              "EXO.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola eshifuunikho shieliheema shiamaseelo kamamiiku akanyushilwa iranji iranzayi, khandi nende eshifuunikho shiamaseelo kandi amanyushe ikulu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.19",
            "verseOrgIds": [
              "EXO.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.19",
            "verseOrgIds": [
              "EXO.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yakasia ebitiisi bieshimenyo emisaala chiomupeeli, ebisinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.20",
            "verseOrgIds": [
              "EXO.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburambi bweshitiisi bwali emikhono ekhumi, khandi obuchiikha bwabuli shitiisi omukhono neinusu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.21",
            "verseOrgIds": [
              "EXO.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli shitiisi shiali norwanzo rubili, nirwoongasibwa nindio yakhola ebitiisi biosi bieshimenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.22",
            "verseOrgIds": [
              "EXO.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhola ebitiisi bieshimenyo, ebitiisi amakhumi kabili khulubeka Iwomukhono musaatsa okuhenjile eNegebu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.23",
            "verseOrgIds": [
              "EXO.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakhola nende ebichibi amakhumi kane ebieifeetsa hasi webitiisi ebio amakhumi kabili; ebichibi bibili hasi weshitiisi shilala khulwa orwanzo rwashio rubili, khandi ebichibi bibili hasi weshitiisi shindi khulwa orwanzo rwashio rubili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.24",
            "verseOrgIds": [
              "EXO.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khulubeka lwakhabili Iweshimenyo, khulubeka Iwenotsi, yakhola ebitiisi amakhumi kabili, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.25",
            "verseOrgIds": [
              "EXO.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebichibi biabio bieifeetsa amakhumi kane; ebichibi bibili hasi weshitiisi shilala, khandi ebichibi bibili hasi weshitiisi shindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.26",
            "verseOrgIds": [
              "EXO.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwa olubeka Iweindangu Iweshimenyo, elubeka lwamumbo, yakasia ebitiisi bisasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.27",
            "verseOrgIds": [
