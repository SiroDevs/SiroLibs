          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachikholela tsisiilo tsine tsiomupeeli etsiafuumwa itsahaabu, nitsili nebikuru' bieitsahaabu; natsisalulusilia ebichibi bine bieifeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
