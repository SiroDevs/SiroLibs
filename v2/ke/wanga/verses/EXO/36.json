          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhola nende ebitiisi bibili ebietsikoona tsieshimenyo indangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.28",
            "verseOrgIds": [
              "EXO.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasi bialiimaasibwa shikhabili, khandi bialiimaasibwa shikhabili birio okhuula khumurwe washio okhuula khungaka yambeli; nindio yabikhola biombi mutsikoona tsiombi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.29",
            "verseOrgIds": [
              "EXO.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialiho ebitiisi munaane, nebichibi biabio bieifeetsa, ebichibi ekhumi nabisasaba; ebichibi bibili hasi wabuli shitiisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.30",
            "verseOrgIds": [
              "EXO.36.30"
            ]
          }
        }
      ]
