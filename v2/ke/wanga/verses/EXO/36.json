          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola nende olwichi Iweingubo mumuliango kweLiheema, yeingubo yeibuluu, neyeisambarau, neiranzayi, neikitani indorotoro isiire, emilimo chiomunabi wamang'oole; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
