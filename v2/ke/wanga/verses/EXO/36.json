              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola ingubo ishinga yeibuluu, neyeisambarau, neiranzayi, neikitani indorotoro isiire, nende abakerubi, emilimo chiomulushi wamang'oole, yachikhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
