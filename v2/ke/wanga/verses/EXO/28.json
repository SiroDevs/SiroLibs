          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi okhole eshimuli eshipaapale eshieitsahaabu inzeleleshe, nosaarakhwo, shinga okhusaarwa khwelichina lieshibalikho, mbu OMUTAKATIFU wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "verse",
