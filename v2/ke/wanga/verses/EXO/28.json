              "type": "text"
            }
          ]
        },
        {
          "text": "Yibe nomuluhu kwokhwinjisiliamwo omurwe hakari wayo, omuluhu okwo kubotokhasibwe olulika lwemilimo chiomulushi khundulo wakwo, shinga olwa luli khumuluhu kweshitsengwa shietsinzubu, mbu yileshe okhurandukha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
