          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo yilaba khuHaruni nakhalabananga; nokhusaala khwatsio khu ahuliilikhanga olwa yeenjila habundu ahatakatifu imbeli w, khandi olwa arulamwo, aleshe okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        },
        {
          "name": "verse",
