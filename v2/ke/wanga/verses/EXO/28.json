          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khundulo wayo hasi okhole amakomamanga l keibuluu nakeisambarau, namaranzayi, okhubotokhasia khundulo wayo; nende tsinyimba tsieitsahaabu hakari wako okhubotokhasia; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
