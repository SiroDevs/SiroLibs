          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oshihandie khushilemba nolutsaha Iweibuluu; khulubeka Iweimbeli weshilemba niho aha shilabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho shibe khubweni bwaHaruni, naye Haruni aleetuushenje eshikha eshiakhanyoolekha mubindu ebitakatifu ebia abaana baIsiraeli balaahulanga mubihaanwa biabwe biosi ebitakatifu; shibeetsenje khubwenibwe tsindaalo tsiosi, mbu mana bafuchiililwe imbeli w ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olalushe likoti liamakha, ikitani indorotoro, nokhola nende eshilemba shieikitani indorotoro, nokhola nende omushiipi, emilimo chiomunabi wamang'oole. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khubaana baHaruni obanabile amakoti, khandi obalushile emishiipi, nobakholela tsikofia, bibe ebioluyali nebiobung'oonefu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe olamufwale Haruni omusiani weenywe nende abaanabe halala ninaye ebiifwalo ebio; nobatsushiilila amafura, nobeemekha khumilimo echio, nobaahula, mbu ba'khalabanile mubukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi obakholele tsiserwali tsieikitani, okhufwimba eshihechenye shiemibili chiabwe, okhurula mushishienje okhuula khumarango; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
