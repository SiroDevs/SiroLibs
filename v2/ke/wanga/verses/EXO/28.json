          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "inyimba yeitsahaabu nelikomamanga, inyimba yeitsahaabu nelikomamanga, khundulo weikanzu okhuchibotokhasia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        },
        {
          "name": "verse",
