          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu olwa Musa yeekha okhurula mushikulu shiaSinai, nende orubaho orwo rubili rwoburumbusi mumakhonoke, olwa yeekha okhurula mushikulu Musa shiyali namanyile shinga likhoba liomumonimwe olwa liali niling'inang'inanga shichila yasungana nende Nyasaye, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Haruni nende abaana baIsiraeli bosi balola Musa, lola, likhoba liomumonimwe liali niling'inang'inanga; nibaria okhusita ahambi ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.30",
            "verseOrgIds": [
              "EXO.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nabalanga; naye Haruni nende abeemilisi bosi bomukhung'aano nibakalukha ewa yali; Musa nasungana ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.31",
            "verseOrgIds": [
              "EXO.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolunyumakhwo abaana baIsiraeli bosi nibasita ahambinaye nalachilisia nababoolela kosi aka OMWAMI yali namubooleele mushikulu shiaSinai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Musa yali namalile okhusungana ninabo, yeefwimba olububi mumoni ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.33",
            "verseOrgIds": [
              "EXO.34.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa Musa yeenjilanga okhutsia imbeli wokhusungana ninaye, yeefwimbulanga olububi olwo, okhuula olwa yarulanga; ne yarulanga, naboolela abaana baIsiraeli aka yalachilwe shinga olwa kali; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
