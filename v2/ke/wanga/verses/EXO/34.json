          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiambeli khubirongole ebielilobalio, obileerenje munzu yOMWAMI Nyasayewo. Orateekha eshimeeme mumabeele kanyina ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila Musa mbu Handiika amakhuwa kano; shichila ekholile indakano ninawe, khandi nende Isiraeli, amakhuwa kano shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabayo nende OMWAMI tsindaalo amakhumi kane, eshiteere nende eshilo; shiyaliakhwo ebiliibwa kata okhunywa amatsi tawe. Nahandiika khurubaho orwo amakhuwa yako akeindakano, niko amalako ekhumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
