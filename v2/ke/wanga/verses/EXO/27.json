    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshimalilo shiemisango emisambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshimalilo shiemisango shiene okhole eshiomusaala kwomupeeli; oburambi bwashio emikhono chiraano, khandi obuchiikha bwashio emikhono chiraano, tsimbeka tsiosi tsine tsieshimalilo tsihelane; obuchinguukhu bwashio nabwo bube emikhono chitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhole tsinzika tsiashio khukoona tsiashio tsine; tsinzika tsiashio tsibe eshindu shilala ninashio; noshifuuma omukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.2",
            "verseOrgIds": [
              "EXO.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhole nende tsinyungu tsiashio okhuyoyela likoshe, nemiikho chiashio, netsingaye tsiashio, namakhango kashio, nende tsindaabo tsiomulilo; ebindu biashio biosi, obikhole biomukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.3",
            "verseOrgIds": [
              "EXO.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi oshikholele omukasa shinga olukhanda; ne khulukhanda Iwenolwo okhole tsingaka tsine tsiomukasa mukoona tsialwo tsine. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.4",
            "verseOrgIds": [
              "EXO.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolura hasi wolusiche, khulwalo, mbu olukhanda luule shinga khunusu yobuchinguukhu bweshimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.5",
            "verseOrgIds": [
              "EXO.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhole nende tsinyanzo tsieshimalilo, tsinyanzo tsiomupeeli, notsifuuma omukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.6",
            "verseOrgIds": [
              "EXO.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana tsinyanzo tsiashio tsiinjisibwe mungaka tsana, tsinyanzo tsiene nitsiba khumbeka tsibili tsieshimalilo nibashichinga eshimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.7",
            "verseOrgIds": [
              "EXO.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oshikhole tsimbaho, mukari mwene mube mukhaya; shinga olwa wamanyiibwe mushikulu, nilwo olwa balashikhole.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi okhole olwanyi Iweshimenyo; khulubeka Iwomukhono musaatsa, okuhenga eNegebu, tsibeho tsingubo tsinzeleesia tsiolwanyi, etsieikitani indorotoro isiire, oburambi bwemikhono eshikhumi khulubeka lulala; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tsisiilo tsiatsio natsio tsibe amakhumi kabili, nebichibi biatsio amakhumi kabili biomukasa; ebikuru bietsisiiro nende tsinzaha tsiatsio tsibe tsieifeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi tsirio khulubeka Iwenotsi khuburambi tsibeho tsingubo tsinzeleesia, oburambi bwemikhono eshikhumi, netsisiilo tsiatsio amakhumi kabili, nebichibi biatsio amakhumi kabili biomukasa; ebikuru bietsisiilo nende tsinzaha tsiatsio etsieifeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khubuchiikha bwolwanyi khulubeka lwamumbo, tsingubo tsinzeleesia tsibeho etsiemikhono amakhumi karaano; tsisiilo tsiatsio ekhumi, nebichibi biatsio ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuchiikha bwolwanyi khulubeka Iwebukwe okuhenjile ewa eliuba lifwindilanga, bube emikhono amakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
              "EXO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsingubo tsinzeleesia etsiokhulubeka lulala Iweshilibwa tsibe emikhono ekhumi nachiraano; tsisiilo tsiatsio tsitaru, nebichibi biatsio bitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khulubeka lundi tsibeho tsingubo tsinzeleesia tsiemikhono ekhumi nachiraano; tsisiilo tsiatsio tsitaru, nebichibi biatsio bitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khushilibwa shiolwanyi lubeho olwichi Iwemikhono amakhumi kabili, olweingubo yeibuluu, neyeisambarau, neiranzayi, neikitani indorotoro isiire, emilimo chiomunabi wamang'oole; tsisiilotsiayo tsine, nebichibi biatsio bine. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsisiilo tsiosi etsibotokhana olwanyi tsibe netsinzaha tsieifeetsa; ebikuru biatsio bieifeetsa, nebichibi biatsio biomukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
            "verseOrgIds": [
              "EXO.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburambi bwolwanyi bube emikhono eshikhumi, nobuchiikha amakhumi karaano, nobuchinguukhu emikhono chiraano; netsingubo tsinzelesia tsieikitani indorotoro isiire nebichibi biatsio biomukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebichio biosi bieshimenyo ebiobukhalabani bwashio, nebibambo biashio biosi, nebibambo biosi biolwanyi, bibe biomukasa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
