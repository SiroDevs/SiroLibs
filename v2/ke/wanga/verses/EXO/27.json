            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, obalache abaana baIsiraeli mbu bakhuleerelenje amafura kemitseituni amaswache ameeleleshe, khulwa itaha, mbu itaha yaashenje khatsotselo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiheema liokhwakaana, elwanyi weingubo ishinga eyili imbeli woburumbusi obwo, Haruni nende abaanabe bachikasinjie okhurula mungoloobe okhuula mutsuli imbeli w; libe lilako obushia nobushia munzibulo tsiabwe khubaana baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
