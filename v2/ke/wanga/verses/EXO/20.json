          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isie nisie OMWAMI Nyasayewo, owakhurusia mushialo shiaMisiri, okhurula munzu yobunyakhani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
