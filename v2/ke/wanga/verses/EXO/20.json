          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heelesinjia so nende mawo oluyali; tsindaalotsio maua tsibe tsinyinji mushialo eshia OMWAMI Nyasayewo yakhuheele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
