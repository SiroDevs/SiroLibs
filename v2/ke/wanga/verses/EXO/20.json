        {
          "text": "Abandu nabo nibasinjila ehalekhwo, naye Musa nasita ahambi khulucheka ' ewa Nyasaye yali ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila Musa ari Oboolele abaana baIsiraeli ori nanwa, mbu Inywe abeene mumalile okhulola shinga olwa esungaane nineenywe okhurula mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murakholakhwo abanyasaye bandi okhuba halala ninasi ta; abanyasaye beifeetsa, kata abanyasaye beitsahaabu, mureebakholela abeene tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.23",
            "verseOrgIds": [
              "EXO.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshimalilo shieliloba nishio eshia olakholela, ne khushieneshio olamalilangakhwo emisangochio emisambe, nende emisangochio chiokhwishia, amakondiko nende tsing'ombetsio; buli hosi aha ndalakholelanga akachila nibeetsulila eliira lianje, niho aha ndalakhwitsilanga nikhuheelesia ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.24",
            "verseOrgIds": [
              "EXO.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne noba niukholela eshimalilo shiamachina, orashiumbashilanga amachina amabaatse ta; shichila noba noshichinguulila eshibaatsiloshio, kho oba noshionooniye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shiolaniinila eshimalilo shianje nebiniinilo ta, eshihechenyeshio shileshe okhulolekhakhwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.26",
            "verseOrgIds": [
              "EXO.20.26"
            ]
          }
        }
