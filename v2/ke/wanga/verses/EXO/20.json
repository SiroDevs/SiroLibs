          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oreekholela eshifwanani eshibaatse, kata obukondo bweshindu shiosi eshili mwikulu hekulu kata eshili mushialo hasi, kata eshili mumatsi hasi weshialo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "orabiinamilanga kata okhubikhalabanila ta; okhuba isie OMWAMI Nyasayewo endi Nyasaye weimbalikha, ningalusinjia akobumayaanu bwabakuuka babwe khubaana, okhuula khulwibulo lwakhataru nende olwakhane lwabangiya, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimbakholela akobuheeli oburalilu abandu ebikhumila khuba'heeIanga, nibambulila amalako kanje.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
