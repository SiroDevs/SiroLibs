          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitsulilanga inyanga yeisabato, okhuchiahulanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.8",
            "verseOrgIds": [
              "EXO.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo tsisasaba okhalabanenje nokhola emilimochio chiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.9",
            "verseOrgIds": [
              "EXO.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne inyanga yomusaafu niyo isabato yOMWAMI Nyasayewo; khunyanga eyo orakholelangakhwo omulimo kwosi, iwe omwene, kata omwanawo omusiani, kata omwanawo omukhaana, kata omukholiwo oweshisaatsa, kata omukholiwo oweshikhasi, kata omurukokwo, kata omucheni ouli mwitaalalio, ta; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila mundaalo tsisasaba OMWAMI yalonjeIamwo likulu nende eshialo, nende inyanza, nende biosi ebilimwo, nahuluushila khunyanga yomusaafu; niko akachila OMWAMI nachiheelesia inyanga yeisabato ikhabi, nachiahula.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
      ]
    },
    {
