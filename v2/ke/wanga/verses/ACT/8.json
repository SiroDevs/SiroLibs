{
  "id": "ACT.8",
  "number": "8",
  "bookId": "ACT",
  "reference": "Ebikhole 8",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ACT 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nasunjile ario, nakona. Naye Saulo yali nafuchiiliile okhwirwakhwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulo yasakania abeikanisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga eyo obusandibwi obukhongo nibubuukha khukanisa eyali eYerusalemu; nabo nibasalaasibwa hosi hosi mumbali tsiebuYahudi nende Samaria, habula abarume bonyene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bandi abaria Nyasaye nibamuyabila Sitefano, nibamwikhuula muno. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.2",
            "verseOrgIds": [
              "ACT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Saulo yoonoonia ikanisa, niyeenjilanga mubuli inzu, nakhwesa abandu abasaatsa nabakhasi, nabahaana okhubohwa mumbohe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Injiili yeelwatsilwa muSamaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abo abasalaasibwa hosi hosi bachenda bario nibeelwatsa likhuwa elo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.4",
            "verseOrgIds": [
              "ACT.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Filipo yakholomokha natsia khwitookho liaSamaria, nabarumbulila Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.5",
            "verseOrgIds": [
              "ACT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abemikanda nabo nibarechelesia nende omwoyo mulala amakhuwa aka Filipo yaboola, olwa bakahulila nibalola ebilolelo ebia yakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.6",
            "verseOrgIds": [
              "ACT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abaroho beshifwabwi barula mubandu abanji abalinji ninabo, nibayiiba nende omwoyo omukhongo; abanji abalinji abamakara, kata abetsindieku, nibahonibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.7",
            "verseOrgIds": [
              "ACT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhwikhoya nikhubaho okhunji mwitookho omwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaliho omundu undi oweliiralie Simoni, owalinji nakholanga obufumu mwitookho elo, nahuchisia abelihanga liabaSamaria, niyeefumia shinga olwa ali omundu omukhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.9",
            "verseOrgIds": [
              "ACT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bosi bali nibamurechelesinjia, okhurula khubatuutu okhuula khubakhongo, nibasunga bari Omundu uno niye obunyali bwaNyasaye, oulangwa mbu Omukhulundu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.10",
            "verseOrgIds": [
              "ACT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamurechelesinjia, okhuba okhurula khale yabahuchisinjia nende obufumubwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.11",
            "verseOrgIds": [
              "ACT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa bamusuubila Filipo, niyeelwatsanga amakhuwa amalayi akobwami bwaNyasaye, nende eliira liaYesu Kristo, babatisibwa, abasaatsa nende abakhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.12",
            "verseOrgIds": [
              "ACT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata Simoni omwene yesi yasuubila, ne nabatisiibwe, yahanda khuFilipo; ne olwa yalola ebilolelo nende akamakana nibikholwa, yaliibwa ling'ang'a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa abarume abali eYerusalemu bahulila shinga Samaria olwa yali niyifuchiiliile likhuwa liaNyasaye, babarumila Petero nende Yohana; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.14",
            "verseOrgIds": [
              "ACT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo olwa bali nibakholomoosheyo, babasaayila mbu banyoole Roho Omutakatifu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.15",
            "verseOrgIds": [
              "ACT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba yali nashili okhwishila omundu yesi khubo ta; habula mbu bali nibabatisibwa muliira liOmwami Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.16",
            "verseOrgIds": [
              "ACT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibabarakhwo emikhono chiabwe, nabo nibanyoola Roho Omutakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.17",
            "verseOrgIds": [
              "ACT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.17",
            "verseOrgIds": [
              "ACT.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Simoni yalola shinga olwa Roho Omutakatifu yahaanwa khulwa okhureebwakhwo emikhono chiabarume, yeenya okhubaheelesia amapeesa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.18",
            "verseOrgIds": [
              "ACT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari Mumbeelesie siesi obunyali buno, mbu omundu yesi owa erakhwo emikhono, anyoole Roho Omutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.19",
            "verseOrgIds": [
              "ACT.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Petero namusunjila ari Ifeetsayo yitibile halala ninawe, okhuba okaalile mbu wakheenyoolela omwene eshihaanwa shiaNyasaye khulwa amapeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.20",
            "verseOrgIds": [
              "ACT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiolikhwo nobusanji kata omukabo kwosi mwikhuwa lino, okhuba omwoyokwo shikuli habwene imbeli waNyasaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.21",
            "verseOrgIds": [
              "ACT.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho wikalukhasie orule mubumayaanubwo buno, nosaaya Omwami mbu haundi oleshelwe obuyililisii obwomumwoyokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.22",
            "verseOrgIds": [
              "ACT.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba enduutsi shinga olwa oli omululu pia, khandi oli omubohe wobubii. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.23",
            "verseOrgIds": [
              "ACT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni nakalusia, nasunga ari Musaayile ewOmwami, mbu amakhuwa aka muboolile kaleshe okhungwakhwo, kata elala khuko ta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
            "verseOrgIds": [
              "ACT.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
            "verseOrgIds": [
              "ACT.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana olwa bali nibarumbuule akobuloli nende okhuboola likhuwa liaNyasaye, bakalukha eYerusalemu, nibayaala Injiili mumataala amanji kabaSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.25",
            "verseOrgIds": [
              "ACT.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Filipo nende omusumba omulate oweEtsiopia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.25",
            "verseOrgIds": [
              "ACT.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne malaika wOmwami yamuboolela Filipo ari Rula otsie elubeka lwesautsi, khunjila yeshikholomokho okhurula eYerusalemu okhuula eGaza; nayo neyomushitsiimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.26",
            "verseOrgIds": [
              "ACT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho narula natsia; ne lola, omundu weEtiopia, omulate, omundu wobunyali hasi waKandake omukhasi omuruchi waEtiopia, owalindanga amabiishiloke kosi; ne yali niyeetsile eYerusalemu khulwa okhwinamila Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.27",
            "verseOrgIds": [
              "ACT.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali nachelelanga, niyeekhaale mwikaarilie nasooma eshitabu shiomunabii Isaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.28",
            "verseOrgIds": [
              "ACT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho namuboolela Filipo ari Sitakhwo ahambi, wiyunje khwikaari lino.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.29",
            "verseOrgIds": [
              "ACT.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.29",
            "verseOrgIds": [
              "ACT.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo natsia ewa yali tsimbilo, namuhulila nasooma eshitabu shiaIsaya omunabii, nareeba ari Omanyile aka osooma neshisina shiene? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.30",
            "verseOrgIds": [
              "ACT.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasunga ari Ndakhanyala okhumanya endie, naraliho ounzibaalila? Namusaaya Filipo mbu aniine yeekhale ninaye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.31",
            "verseOrgIds": [
              "ACT.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.31",
            "verseOrgIds": [
              "ACT.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshitonye eshiomumahandiiko eshia yali nasoomanga shieshino, mbu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulate oyo namukalusia Filipo, nasunga ari Chama umboolele, niwina owa omunabii yaboolakhwo ako? Khumwene, nohomba khuwundi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.34",
            "verseOrgIds": [
              "ACT.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Filipo narumbukha, nachaachila khwihandiiko lienelo, namwilwatsila amakhuwa amalayi kaYesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.35",
            "verseOrgIds": [
              "ACT.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nibashitsiililila bario khunjila, boola khumatsi; omulate nasunga mbu Lola, amatsi ngakano; nishiina eshingaya oburabatisibwa ta? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.36",
            "verseOrgIds": [
              "ACT.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Filipo nasunga mbu Noba nosuubila nende omwoyokwo kwosi, onyala. Naye nakalusia, nasunga mbu Esuubila shinga Yesu Kristo olwa ali Omwana waNyasaye.] ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nalaka mbu likaari lieme; nibeekha mumatsi bombi, Filipo nende omulate; namubatisia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.38",
            "verseOrgIds": [
              "ACT.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibatikuluushe okhurula mumatsi, Roho wOmwami yayiniaho Filipo; omulate oyo naramulola khandi ta, okhuba yatsiililila khunjila niyeekhoya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.39",
            "verseOrgIds": [
              "ACT.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Filipo yaloleshela eAzoto; ne nabirangamwo yeelwatsila amataala kosi Injiili, okhuula olwa yoola eKaisaria.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.40",
            "verseOrgIds": [
              "ACT.8.40"
            ]
          }
        }
      ]
    }
