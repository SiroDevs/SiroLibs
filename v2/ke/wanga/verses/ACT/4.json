            }
          ]
        },
        {
          "text": "Nomukanda kwa abo abasuubila bali abomwoyo mulala nende roho ndala; kata yabulaho khubo owaboola mbu shiosi shiosi eshiokhubindubie neshishie khululwe ta; habula basanjilana khubiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.32",
            "verseOrgIds": [
              "ACT.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abarume barumbula obuloli bwabwe khubulamushi bwOmwami Yesu namaani; obukoosia nibuba khubo bosi muno. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila yabulaho khubo owaleema eshindu shiosi; okhuba bosi abali abeene mikunda kata tsinzu babikusia, nibaleera obukusi bwebindu ebikusiibwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
            "verseOrgIds": [
              "ACT.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibabura hamakulu kabarume; mana omukabo kwakabilwa buli mundu, obutambi bwomundu yesi shinga olwa bwali.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.35",
            "verseOrgIds": [
              "ACT.4.35"
            ]
          }
        }
