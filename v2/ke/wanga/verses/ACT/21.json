    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yatsia eYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwali nikhukabukhaane ninabo, nikhuli muliaro nikhutsiitsanga, khwatsia eKosi khunjila inunji; mana mukamba nikhuula eRodo, nokhurula yaho okhuula ePatara; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.1",
            "verseOrgIds": [
              "ACT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikhunyoola eliaro eliitsa okhwambukha okhutsia eFoinike, nikhuniina, nikhuchaaka okhutsia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.2",
            "verseOrgIds": [
              "ACT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwalola Kipiro, khwashilekha khumukhono mukhasi, nikhutsia eSiria, nikhwikha eTiro; okhuba ebweneyo eliaro liali nilili okhuruula emisiiko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.3",
            "verseOrgIds": [
              "ACT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhumalile okhunyoola abeechi, khwamenyayo tsindaalo musaafu; nabo nibaboolela Paulo khulwa obunyali bwaRoho mbu araseena eshilenje eYerusalemu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.4",
            "verseOrgIds": [
              "ACT.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa tsindaalo etsio tsiali nitsihweele, khwarulayo nikhutsiililila khuluchendo Iweefwe; nabo bosi, halala nabakhasi babwe nende abaana, nibakhukooba okhuula olwa khwali nikhurulile mwitaala; nikhusikama khulukuku, nikhusaaya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.5",
            "verseOrgIds": [
              "ACT.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikhuseebulana; ifwe nikhuniina muliaro, nabo nibakalukha ingo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.6",
            "verseOrgIds": [
              "ACT.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.6",
            "verseOrgIds": [
              "ACT.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwali nikhumalile oluchendo okhurula eTiro, khwoola eTolomai; nikhushiesia abaana beefwe, nikhwikhalayo inyanga ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.7",
            "verseOrgIds": [
              "ACT.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba nikhurulayo, nikhuula eKaisaria; nikhwinjila munzu yaFilipo, omwilwatsi weinjiili, mulala khubeenabo musaafu, nikhumenyakhwo ewuwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.8",
            "verseOrgIds": [
              "ACT.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.8",
            "verseOrgIds": [
              "ACT.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu oyo yali nabaanabe abakhaana bane abali abashisila, abalakulanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.9",
            "verseOrgIds": [
              "ACT.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwashindayo tsindaalo tsinyinji, omunabii undi oulangwa mbu Agabo yakholomokha narula ebuYahudi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.10",
            "verseOrgIds": [
              "ACT.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyeetsa ewa khwali, nabukula omushiipi kwaPaulo, niyeeboha ebilenje nende amakhono, nasunga mbu Kano niko aka Roho Omutakatifu aboola; mbu Nindio abaYahudi abali eYerusalemu baiimuboha omwene omushiipi kuno, nibamuhaana mumakhono kAbamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.11",
            "verseOrgIds": [
              "ACT.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwahulila amakhuwa ako, if we nende abebweneyo, fwesi, nikhumusaaya mbu aleshe okhutikulukha okhutsia eYerusaiemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.12",
            "verseOrgIds": [
              "ACT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Paulo nakalusia, mbu Mubeele murie nimulila nimwira omwoyo kwanje? Okhuba shindirecheeshe khulwa okhubohwa khwonyene ta, habula nende okhufwila eYerusalemu khulwa eliira liOmwami Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.13",
            "verseOrgIds": [
              "ACT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yakhaya okhunichi-isibwa khwalekha, nikhusunga mbu Aka Omwami yeenya kakholeshe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.14",
            "verseOrgIds": [
              "ACT.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.14",
            "verseOrgIds": [
              "ACT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolunyuma lwetsindaalo etsio khweekhwania nikhutikulukha okhutsia eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.15",
            "verseOrgIds": [
              "ACT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandi abokhubeechi beKaisaria nibalondana nineefwe, nibakhuyila enanzu waMunasoni oweKipiro, omwechi wakhale, ewa khwali nikhuli okhumenyakhwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.16",
            "verseOrgIds": [
              "ACT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yeenjila ewaYakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.16",
            "verseOrgIds": [
              "ACT.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwali nikhuulile eYerusalemu, abaana beefwe bakhwinjisia nobusangaali. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.17",
            "verseOrgIds": [
              "ACT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba Paulo yeenjila nineefwe ewaYakobo; abakofu bosi nibabayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.18",
            "verseOrgIds": [
              "ACT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nabashiesiye, yabatoonyela, elala elala, khumakhuwa aka Nyasaye yali nakholile muBamahanga khulwa obukhalabanibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.19",
            "verseOrgIds": [
              "ACT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo olwa bakahulilakhwo, nibamwitsoomia Nyasaye; nibamusunjila bari Mwana weelwe, oluutsi shinga abaYahudi abasuubila olwa bali ebikhumila nebikhumila; ne bosi nabalumilifu mumalako; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.20",
            "verseOrgIds": [
              "ACT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne babooleelwe khwiwe, mbu wechesinjia abaYahudi bosi abamenyanga muBamahanga okhumulekha Musa, nobakaania oburasheba abaana babwe kata okhulonda khubiima tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.21",
            "verseOrgIds": [
              "ACT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nakhukhole khurie? Shibalachweya okhuhulila mbu witsile ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.22",
            "verseOrgIds": [
              "ACT.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho okhole likhuwa lino elia khukhuboolela; mbu khuli nende abasaatsa bane abeetsubile eshiitsubo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.23",
            "verseOrgIds": [
              "ACT.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "obabukule, wisiiye ninabo halala, nobarunjila emirungo chiabwe, mbu mana beebeche emirwe; mana bosi nabamanye mbu obwatoto buhumaho mumakhuwa ako aka baboolelwa khwiwe; habula mbu iwe omwene wichendelesinjia habwene, nolonda akamalako. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.24",
            "verseOrgIds": [
              "ACT.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumakhuwa kAbamahanga a'oasuubila, khwahandiika obukhalachi bweefwe, mbu basile ebindu biemisango ebimaliilwe ebifwanani, nende amalasile, nende ebimichilwe, nende obuheyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.25",
            "verseOrgIds": [
              "ACT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Paulo yabukula abasaatsa abo, mana mukamba niyeesiiya ninabo, niyeenjila muhekalu, namanyia aketsindaalo tsiokhusiiyikha olwa tsiakhaba nitsihweele, okhuula olwa eshihaanwa shiakhaba nishihaaniilwe buli mulala khubo. Paulo yahambzva nali muHekalu ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa tsindaalo etsio musaafu tsiali nitsili ahambi okhuhwa, abaYahudi abarula ebuAsia, olwa bamulola nali muhekalu, bakoyaasia omukanda kwosi, nibamukwakhwo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.27",
            "verseOrgIds": [
              "ACT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibalanjilisia, bari Inywe abasaatsa baIsiraeli, mukhukhoonye; uno niye omundu tsana owechesinjia abandu bosi, buli hosi, nafukula abandu, nende amalako, nende habundu hano; khandi waleerile kata abaYunani muhekalu, niyoonoonia habundu hano ahatakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.28",
            "verseOrgIds": [
              "ACT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila bali nibamuluutsi mwitookho nali nende Turofimo, omuEfeso, owa bakaala mbu Paulo yali namuleerile muhekalu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abelitookho liosi nibatetekhana, abandu nibeelushila halala; nibamukwakhwo Paulo, nibamukhwesa nibamurusia muhekalu; mana emiliango nichiikalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.30",
            "verseOrgIds": [
              "ACT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibakhaabanga shinga olwa bakhamwira, omuseesia omukhulundu welihe liabasikari elo yakhupilwa omunwa, mbu Yerusalemu yosi yikoyaanile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.31",
            "verseOrgIds": [
              "ACT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho habwene nahabwene yabukula abasikari nende abaseesia, nabakholomoshela tsimbilo; nabo olwa balola omuseesia omukhulundu nabasikari, nibalekha okhumukhupaka Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.32",
            "verseOrgIds": [
              "ACT.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuseesia omukhulundu nasita ahambi, namuhamba, nalaka mbu abohwe neminyololo chibili, nareebelesia mbu niye wina, khandi mbu akholile shiina? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.33",
            "verseOrgIds": [
              "ACT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi abomumukanda nibayochela nibaboola amakhuwa yaka, nabandi yaka; ne olwa yakhaywa okhumanya obwatoto bwamakhuwa khulwa indiri eyo, yalachilisia mbu ayilwe munzu yobulindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.34",
            "verseOrgIds": [
              "ACT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Paulo yoola khumaniinilo, nikaba mbu yachingwa nende abasikari khulwa amahababa komukanda; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.35",
            "verseOrgIds": [
              "ACT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba obunji bwabandu balonda inyuma, nibalanjilisia bari Murusieho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yeelwatsa niyeeteetsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Paulo yali nali okhwinjisibwa munzu yobulindi, yasunjila omuseesia omukhulundu ari Nochama, ekhuboolelekhwo likhuwa. Naye nasunga ari Khane wamanya oluYunani? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shioli iwe omuMisiri oyo owa ekulo wabuusia induli niyeemlila abasaatsa abo ebikhumila bine abalangwa mbu Abeeri, mbu batsie mushitsiimi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Paulo nasunga mbu Isie endi omuYahudi, weTaruso ebuKilikia, omundu womwitookho elirali lituutu ta; chama umbeesie omunwa esunganekhwo nende abandu bano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali namuheele omunwa, Paulo yasinjila khumaniinilo, nasimila abandu omukhono; ne olwa bali nibaholeeleele elala, yasunganila ninabo muluYahudi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.40",
            "verseOrgIds": [
              "ACT.21.40"
            ]
          }
        }
      ]
    }
