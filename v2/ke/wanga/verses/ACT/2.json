          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalumilila, inyanga buli nyanga, nomwoyo mulala muhekalu, nibasonyola emikaate mungo, nibasanjilana khubiliibwa nende obusangaali nende omwoyo mulala, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.46",
            "verseOrgIds": [
              "ACT.2.46"
            ]
          }
        },
        {
          "name": "verse",
