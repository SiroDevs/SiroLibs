          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oburii nibuhamba buli mundu; ne amangalimwa amanji nende ebilolelo biakholwa nabarume. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.43",
            "verseOrgIds": [
              "ACT.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bosi abasuubila bali halala, nibasanjilana khubindu biabwe biosi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
              "ACT.2.44"
            ]
          }
        },
        {
