          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibakusia emiandu chiabwe nende ebindu ebia bali ninabio amapeesa, nibakabila bosi obutambi bwomundu yesi shinga olwa bwali. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.45",
            "verseOrgIds": [
              "ACT.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
