        "sid": "ACT 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwitsa khwaRoho Omutakatifu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa inyanga yaPendekote yali niyulile, bali nibali halala bosi, habundu halala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.1",
            "verseOrgIds": [
              "ACT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho beetsukhana obuyoka niburula mwikulu shinga okhuhuuma khwomuyeka omukhongo, nibwitsula munzu mwosi omwa bali nibeekhaale. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.2",
            "verseOrgIds": [
              "ACT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nitsibaloleshela tsinimi shinga etsiomulilo, nitsikabukhana nitsiyeela khubuli mulala khubo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.3",
            "verseOrgIds": [
              "ACT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibeetsulamwo Roho Omutakatifu, nibachaaka okhuboola nende tsinimi tsindi lukano lukano, shinga Roho olwa yabanyalila okhuboola.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne baliho abaYahudi abali nibali eYerusalemu, abandu abariitsanga Nyasaye, abarula mubuli lihanga hasi welikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.5",
            "verseOrgIds": [
              "ACT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa obuyoka obwo bwahuliilikha, emikanda chiakhung'aanila halala, nichikoyaasibwa, shichila buli mundu yabahulila nibaboolela mululimi lulwe omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.6",
            "verseOrgIds": [
              "ACT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibang'ang'aala, nibahuka, bari Abeefu, bano ababoolanga shibali abaGalilaya bosi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.7",
            "verseOrgIds": [
              "ACT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kabeele karie nikhuhulila buli mundu mululimi Iwewabwe ewa yeebulwa? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.8",
            "verseOrgIds": [
              "ACT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbu abaParitsi nabaMedi nabaElamu, nabo abeMesopotamia, nende abebuYahudi nende abeKapadokia, abePondo nende abeAsia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.9",
            "verseOrgIds": [
              "ACT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeFirigia nabePamufilia, abeMisiri nende abebitonye biaLibia ebirondokhana nende Iiirene, nabacheni abarula eRoma, abaYahudi abeebule kata nende abeeshiukhasia okhuba abaYahudi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.10",
            "verseOrgIds": [
              "ACT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaKirete nende abaArabu, khuhulila nibaboola munimi tsieefwe akebikhole ebikhongo biaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.11",
            "verseOrgIds": [
              "ACT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibang'ang'aala, nibarambwa, nibareebana bari Kakhali karie? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.12",
            "verseOrgIds": [
              "ACT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abandi nibakokonya, nibasunga bari Bameelile amalwa amatoro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Petero yeelwatsa khunyanga yaPendekote",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Petero, nasinjiile halala nende abo ekhumi namulala, yachinga omunwa, nabarumbulila ari Inywe abaYahudi abashianje, nende bosi abamenya eYerusalemu, mumanye kano, rechelesie amakhuwa kanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.14",
            "verseOrgIds": [
              "ACT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba bano shibameelile, shinga olwa mukaala, tawe, olwa yishili isaa yakhataru butswa eyomusenya; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.15",
            "verseOrgIds": [
              "ACT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kano niko akaboolwa nende omunabii Yoeli,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.16",
            "verseOrgIds": [
              "ACT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.21",
            "verseOrgIds": [
              "ACT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaIsiraeli abashianje, hulile amakhuwa kano: mbu Yesu weNazareti, omundu owa Nyasaye omwene yalolosia khulwa ebikhole bietsingufu nende amakana nende ebilolelo, ebia Nyasaye yakhola nende amakhonoke hakari weeny ve, shinga inywe abeene olwa mumanyile; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.22",
            "verseOrgIds": [
              "ACT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwenoyo, olwa yakhobwa khulwa tsiyemi tsiaNyasaye, owamanya akeimbeli khale, inywe mwamubamba khumusalaba nimumwira nende amakhono kabandu ababii. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.23",
            "verseOrgIds": [
              "ACT.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nyasaye yamulamusia, olwa yali natendeyiye obululu bwokhufwa; shichila shikanyalikha mbu atiilwe ninakhwo ta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.28",
            "verseOrgIds": [
              "ACT.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana beefwe, mundeshele esunje katong'anel akakuuka weefwe omukhulundu Daudi, shinga olwa yafwa khand inayabilwa; ne eshilindwashie khuli ninashio okhuula olwa leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.29",
            "verseOrgIds": [
              "ACT.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye olwa yali omunabii, yamanya shinga olwa Nyasaye yali namwitsubiile neshiitsubo mbu yakhara khushifumbishie omundu ourula mundaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.30",
            "verseOrgIds": [
              "ACT.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yaranjilila okhulola kano khale, naboola khukhulamukha khwaKristo, mbu kata shiyalekhwa eMakombe ta, kata omubilikwe shikwayeenjila mukhubola tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.31",
            "verseOrgIds": [
              "ACT.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu oyo, Nyasaye yamulamusia, nineefwe fwesi khuli abaloli khubwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.32",
            "verseOrgIds": [
              "ACT.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ye, olwa yamalile okhwemekhwa hamukhono musaatsa kwaNyasaye, namalile okhunyoola khuSeefwe eshisuubisie shiaRoho Omutakatifu, asunduule kano aka mulola nende okhuhulila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.33",
            "verseOrgIds": [
              "ACT.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Daudi shiyakulukha niyeenjila mwikulu tawe; nebutswa omwene yaboola, mbu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.34",
            "verseOrgIds": [
              "ACT.2.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.36",
            "verseOrgIds": [
              "ACT.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo olwa bahulilakhwo, kabafumira emioyo, kho nibasunjila Petero nende abarume bashie bari Baana beefwe, khukhole khurie? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.37",
            "verseOrgIds": [
              "ACT.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero nabasunjila ari Mwikalukhasie nimubatisibwa, buli mulala, muliira liaYesu Kristo, mbu munyoole obuleshelwi bwebionoono bieenywe; mana mulanyoola eshihaanwa shiaRoho Omutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.38",
            "verseOrgIds": [
              "ACT.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba obusuubisii buli khwinywe, nende khubaana beenywe, nende khubosi abali ehale, abo bosi aba Omwami Nyasaye weefwe alalanga mbu bamwitsile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.39",
            "verseOrgIds": [
              "ACT.2.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
