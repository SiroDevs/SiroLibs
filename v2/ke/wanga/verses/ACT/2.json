          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabarumbulila amakhuwa kandi amanji akobuloli, nabachesiyia, ari Mwihonie abeene mulwibulo luno olushiamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.40",
            "verseOrgIds": [
              "ACT.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abo abafuchiilila amakhuwake nibabatisibwa; nibameetekha khunyanga eyo abandu shinga ebikhumila bitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.41",
            "verseOrgIds": [
              "ACT.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibalumilila mumeechesio kabarume, nende mubusanjilani, nende mukhusonyola omukaate, nende mumilaamo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
            "verseOrgIds": [
              "ACT.2.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
