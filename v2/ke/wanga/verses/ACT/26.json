        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yeeteetse imbeli waAguripa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Aguripa namusunjila Paulo ari Ofuchiililwa okhusunga aka oli ninako. Mana Paulo yakololosia omukhono naboola akokhwiteetsakhwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.1",
            "verseOrgIds": [
              "ACT.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari Enduutsi mbu endi oweikhabi, Omwami Aguripa, shinga olwa endi okhwiteetsa imbeliwo inyanga yino khumakhuwa ako kosi aka ndeenjililwa ninako nabaYahudi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.2",
            "verseOrgIds": [
              "ACT.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhushila muno shinga olwa wakamanyila elala akebiima nende amakhuwa kosi akali mubaYahudi; khulwako ekhusaaya mbu umbulile nobwisimilisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaYahudi bosi bamanya okhwichendelesia khwanje shinga olwa khwalinji, okhurula khubusooliili bwanje, nimbeetsanga mubelihanga lieefwe, khandi eYerusalemu, okhurula khukhuchaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.4",
            "verseOrgIds": [
              "ACT.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayamanya okhurula khukhuchaaka; ne nibaba nibakhachama, bakhanyala okhurumbula akobuloli, shinga olwa ndeechendelesia nindi omuFarisayo, ninondanga omwahukho omutinyilifu muno mudini yeefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.5",
            "verseOrgIds": [
              "ACT.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano esinjiile okhuyaasibwa khulwa obunaayi bwobusuubisie obwa Nyasaye yasuubisia abakuuka beefwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.6",
            "verseOrgIds": [
              "ACT.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabwo nibwo obwa tsimbia tsieefwe ekhumi natsibili tsinaayanga okhuula, nitsilumililanga okhumukhalabanila Nyasaye eshiteere neshilo. Ne khubunaayi buno nibwo obuchila ninzinjililwa nabaYahudi, Omwami! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.7",
            "verseOrgIds": [
              "ACT.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nishiina eshichila nibupaarwakhwo mwinywe mbu shibusuubilikha ta mbu Nyasaye yakhalamusia abafu?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto, isie ndapaaranga mumwoyo kwanje mbu ekhoyile okhukhola amakhuwa amanji akafukula eliira liaYesu weNazareti. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ndakholanga endio eYerusalemu; nimboha abanji abomubatakatifu mumbohe, olwa ndaheebwa obunyali nende abakhulundu babakuhani; ne olwa bali okhwirwa, siesi ndasangangakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.10",
            "verseOrgIds": [
              "ACT.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndateema okhubaluunyia okhunyeka Nyasaye, nimbakuumanga khandi akhanji mutsisinagogi tsiosi; ne olwa ndabatiililwa oburima shia oulaluushe, ndabasandia kata okhuula khumatookho kabamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yatoonya akokhwikalukhasiekhwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho ndali khunjila ninzia eDamasiko, nimalile okhuheebwa obunyali nende amalako nabakhulundu babakuhani; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.12",
            "verseOrgIds": [
              "ACT.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana, Omwami, khusaa yeshiteere ndalola khunjila obulafu oburula mwikulu, obuyomba okhwakha khweliuba, nibulangaalila isle nende abo aba ndachendanga ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.13",
            "verseOrgIds": [
              "ACT.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwali nikhukwile hasi fwesi, ndahulila omwoyo nikusunjila muluYahudi, mbu Saulo, Saulo, usandinjia mbushiina? Nobutinyu khwiwe okhuratsa khubilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.14",
            "verseOrgIds": [
              "ACT.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi nisunga mbu Niwe wina, Omwami? Omwami nasunga mbu Nisie Yesu owa osandinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buukha, osinjile nebilenjebio; okhuba kano niko akachilile nikhuloleshela, mbu ekhwahule obe omukhalabani khandi omurumbusi wobuloli khukeenako aka oluutsi khwisie, nende khukeenako aka ndilikhuloleshelamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalakhuhoninjia mubandu, nende muBamahanga, aba ndalakhurumangamwo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhutimbusia tsimoni tsiabwe, mbu bashiukhane barule khushiilima nibachooma khubulafu, nokhurula khubunyali bwaSetani nibachooma khuNyasaye; mbu baheebwe obuleshelwi bwebionoono nende obulaame mubeenabo abaahulwa khulwa okhusuubilila isie.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yarumbula akobuloli khubaYahudi nabamahanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila, Omwami Aguripa, shindakhaya akelibisulo eliarula mwikulu ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.19",
            "verseOrgIds": [
              "ACT.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne ndaranjilila okhubarumbulila abeDamasiko olwambeli, mana eYerusalemu, nende mushialo shiosi shiebuYahudi, khandi nende muBamahanga, shinga olwa bakhoyile okhwikalukhasia nibashiukhanila Nyasaye, nibakhola ebikhole ebiwinjana nende obwikalukhasii. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila abaYahudi nibandiilila muhekalu, nibateema okhunzira. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho, nimalile okhunyoola obuhabini oburula ewaNyasaye, esinjilanga kata okhuula olwa leelo nirumbulila bosi, abakhongo nende abatuutu, akobuloli, nindaboola likhuwa liosi ta, habula aka abanabii nende Musa baboola mbu kakheetsa; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga Kristo oyo olwa akhoyile okhusaalila, khandi shinga olwa yakhaba owambeli okhulamukha mukhufwa narumbula ario akobulafu khubandu beene khandi nende khuBamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yasaaya Aguripa mbu asuubilile Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yaboola akokhwiteetsakhwe ario, Fesito yasunga nende omwoyo omukhongo, ari Paulo, olaluushe; okhusoomakhwo okhunji khukhukwisiye omulalu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.24",
            "verseOrgIds": [
              "ACT.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Paulo nasunga mbu Shindaluushe tawe, owoluyali Fesito; ne emboola amakhuwa kobwatoto noburechelefu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.25",
            "verseOrgIds": [
              "ACT.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omuruchi yamanyila elala akamakhuwa kano kosi, nasi enyala okhukasunga katong'ane imbeliwe. Okhuba emanyile bulayi mbu libulaho likhuwa liosi mukano elimubiswakhwo ta; shichila kano shikakholekha mabiswi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.26",
            "verseOrgIds": [
              "ACT.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami Aguripa, osuubilanga abanabii? Emanyile shinga olwa osuubilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.27",
            "verseOrgIds": [
              "ACT.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Aguripa namusunjila Paulo ari Mubwimbichiti wenyanga okhukhola omuKristayo! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.28",
            "verseOrgIds": [
              "ACT.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
