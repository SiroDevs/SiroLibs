          ]
        },
        {
          "text": "ne olwa bali nibarulile, baboolelana bari Omundu uno shiakholanga likhuwa liosi elikwanile okhufwa kata okhubohwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
