            "sid": "ACT 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Paulo ari Ndakheekomba, imbeli waNyasaye, mbu kata nikali mubwimbichiti kata muburambi, iwe halala nende bosi abambulila inyanga yino mwikhole shingana isie, habula ebibohelo bino ta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        }
