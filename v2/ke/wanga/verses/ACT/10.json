        "sid": "ACT 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petero nende Korinelio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho eKaisalia yaliyo omundu undi oweliira mbu Korinelio, omuseesia, oweing'anda eyilangwa mbu ing'anda yeshiItalia; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.1",
            "verseOrgIds": [
              "ACT.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomundu omwikayakayi owariitsanga Nyasaye, halala nende bosi abomunzuye; yaheelesinjia abandu ebihaanwa bietsimbabasi, nasaayanga Nyasaye tsindaalo tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.2",
            "verseOrgIds": [
              "ACT.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalola habulafu mwibisulo, shinga khusaa yashienda eyomushitsiambo, malaika waNyasaye namwitsila, namusunjila ari Korinelio. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.3",
            "verseOrgIds": [
              "ACT.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikholo niyimurimukha, mana niyoomisia tsimoni okhumuhenga, nasunga mbu Karie, Omwami? Naye namusunjila ari Okhusaayakhwo nende ebihaanwabio bietsimbabasi bikuluushe mbu bibe eshiitsusio imbeli waNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.4",
            "verseOrgIds": [
              "ACT.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano orume abandu eYafa, okhwenda oundi mbu Simoni, owelilaha mbu Petero; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.5",
            "verseOrgIds": [
              "ACT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "acheniihe ewoundi mbu Simoni, omunyushi wamaseelo, owa inzuye yili halukuku Iweinyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.6",
            "verseOrgIds": [
              "ACT.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa malaika owasungana ninaye yali narulileho, yalanga babili abokhubakholi bomunzuye, nende omusikari omwikayakayi owokhubeenabo abamukhalabanilanga tsindaalo tsiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.7",
            "verseOrgIds": [
              "ACT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne namalile okhubatoonyela amakhuwa kosi, yabaruma eYafa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.8",
            "verseOrgIds": [
              "ACT.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.8",
            "verseOrgIds": [
              "ACT.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mukamba kwakhabili, olwa bali nibashili khuluchendo lwabwe, nibali ahambi okhuula khwitaala, Petero yaniina khushilama shieinzu okhusaaya, khusaa shinga eyakhasasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.9",
            "verseOrgIds": [
              "ACT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzala niyimuluma, niyeekomba okhulia; ne olwa bali nibashikasinjia, yayenzeela, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.10",
            "verseOrgIds": [
              "ACT.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalola likulu niliikuushe, eshichinjilo shindi nishiikha, shingana ishuka ingali, niyiisibwa khushialo niyitiililwe emikhanda chine chiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.11",
            "verseOrgIds": [
              "ACT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mubwenomwo mwalimwo tsimbia tsiosi tsiebilonje biamakulu kane, nende etsiebimoolanga khwiloba, nende etsiamanyonyi akomwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.12",
            "verseOrgIds": [
              "ACT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omwoyo nikumwitsila, kuri Buukha, Petero; wire olie. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.13",
            "verseOrgIds": [
              "ACT.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Petero nasunga mbu 'A, tawe, Omwami; okhuba eshili okhuliakhwo eshindu shiosi shiomusilo kata eshieshifwabwi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.14",
            "verseOrgIds": [
              "ACT.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoyo okwo nikumwitsila khandi olwakhabili, kuri Eshia Nyasaye asiiyile, orashilanga mbu neshieshifwabwi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.15",
            "verseOrgIds": [
              "ACT.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kakholekha khataru; habwenaho eshichinjilo eshio nishikalusibwa mwikulu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.16",
            "verseOrgIds": [
              "ACT.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.16",
            "verseOrgIds": [
              "ACT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa Petero yali nakanakania muno mumoyokwe, mbu eshisina shielibisulo elia aluutsi shiakhaba shirie? Ida, abasaatsa abo aba Korinelio yaruma, nibamalile okhukhaaba inzu yaSimoni, basinjila hashilibwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.17",
            "verseOrgIds": [
              "ACT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibalanjilisia, nibareeba mbu Simoni owelilaha mbu Petero niyakhaba nacheniiheho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.18",
            "verseOrgIds": [
              "ACT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Petero yali nashiyililisia khwibisulo elo, Roho yamuboolela ari Lola, abasaatsa bataru bakhukhaabanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.19",
            "verseOrgIds": [
              "ACT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buukha, wishe, otsie ninabo, oburakanakaniakhwo ta, okhuba nisie oubarumile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.20",
            "verseOrgIds": [
              "ACT.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Petero niyeekha natsia ewa abasaatsa abo bali, nasunga mbu Lole, nisie uno owa mukhaaba; nishiina eshichilile nimwitsa? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.21",
            "verseOrgIds": [
              "ACT.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibasunga bari Korinelio, omuseesia undi, omundu omulunjishi khandi ouriitsanga Nyasaye, oweifuma indayi mubelihanga liabaYahudi, yeebaaliilwe nende malaika omutakatifu okhuruma abandu bakhwende, mbu otsie munzuye, ahulile amakhuwa aka oli ninako. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.22",
            "verseOrgIds": [
              "ACT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yabeenjisia babe abachenibe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.23",
            "verseOrgIds": [
              "ACT.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba yarula natsia ninabo, abandi abokhubaana beefwe baYafa nibatsia ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.23",
            "verseOrgIds": [
              "ACT.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba kwokhubili nibeenjila muKaisalia. Naye Korinelio yali nabalindanga, nakhung'aasiye abaluyiabe nende abeetsabe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.24",
            "verseOrgIds": [
              "ACT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Petero yeenjila, Korinelio yamwakaanila, nakwa hasi mumakuluke, namwinamila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.25",
            "verseOrgIds": [
              "ACT.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Petero yamubuusia, nasunga ari Sinjila; nasi siesi endi omundu namundu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.26",
            "verseOrgIds": [
              "ACT.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nashisungana ninaye, yeenjilamwo, nanyoola abanji nibakhung'aaniile halala; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.27",
            "verseOrgIds": [
              "ACT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabasunjila ari Inywe mumanyile abeene shinga olwa kuli omusilo omundu omuYahudi okhwiyungakhwo khumundu welihanga lindi, kata okhumutsiila; nebutswa nisie owa Nyasaye yamanyiye mbu shikhoyile okhulanga omundu yesi mbu nowomusilo kata oweshifwabwi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.28",
            "verseOrgIds": [
              "ACT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachilile ninzitsa oburakhaya ta, olwa enanjilwe. Kho ereeba, mbu neshifune shiina eshichilile nimunanga?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.29",
            "verseOrgIds": [
              "ACT.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.29",
            "verseOrgIds": [
              "ACT.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Korinelio nasunga mbu Eshiteere shino shikhola khane, shinga khusaa yino, okhurula olwa ndabeele nindi mukhusaaya khwokhusaa yashienda munzu yanje; ne ngwoyo, omundu nasinjiile imbeli wanje, niyeefwalile tsingubo tsing'inang'inu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.30",
            "verseOrgIds": [
              "ACT.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasunga mbu Korinelio, okhusaayakhwo khuhuliilwe, khandi ebihaanwabio bietsimbabasi biitsulilwa imbeli waNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.31",
            "verseOrgIds": [
              "ACT.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho orume abandu eYafa, olanje Simoni owelilaha mbu Petero; acheniihe munzu yaSimoni, omunyushi wamaseelo, khulukuku Iweinyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.32",
            "verseOrgIds": [
              "ACT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nonoho niruma abandu khwiwe; nawe okholile bulayi niwitsa. Kho bulaano khuli hano fwesi imbeli waNyasaye, okhuhulila amakhuwa ako kosi aka walachilisbwa nende Omwami.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.33",
            "verseOrgIds": [
              "ACT.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petero yeekuatsila munzu yaKorinelio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.33",
            "verseOrgIds": [
              "ACT.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Petero narumbukha, nasunga mbu Toto mwene endola mbu Nyasaye shiyaahulanga mubandu ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.34",
            "verseOrgIds": [
              "ACT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa mubuli lihanga oyo oumuriitsanga nakhola akobulunjishi afuchiililwa ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.35",
            "verseOrgIds": [
              "ACT.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elo elia yarumila abaana baIsiraeli, nayaala amakhuwa amalayi akomulembe muYesu Kristo, neniye Omwami wabosi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.36",
            "verseOrgIds": [
              "ACT.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "lisungo lienelo inywe mulimanyile abeene, eliatswanibwa mubuYahudi mwosi, okhuchaachila eGalilaya, inyuma wobubatisii obwa Yohana yeelwatsa; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.37",
            "verseOrgIds": [
              "ACT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaYesu weNazareti, shinga Nyasaye olwa yamutsushiilila Roho Omutakatifu khandi nende obunyali; naye nachendachenda nakholanga amalayi, nahoninjia bosi abamiinwa nende Setani; okhuba Nyasaye yali ninaye halala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.38",
            "verseOrgIds": [
              "ACT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ifwe khuli abaloli bamakhuwa kosi aka yakhola, kata mushialo shiabaYahudi kata muYerusalemu; ne bamala nibamwira, nibamufunga' khumusaala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.39",
            "verseOrgIds": [
              "ACT.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomwenoyo, Nyasaye yamulamusia mukhufwa khunyanga yakhataru, namunyalila okhulolosibwa ebulafu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.40",
            "verseOrgIds": [
              "ACT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khubandu bosi ta, habula khubaloli aba Nyasaye yalobola khale nifwe abalia ninaye olwa yali namalile okhuiamukha okhurula mukhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.41",
            "verseOrgIds": [
              "ACT.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhulachilisia okhwilwatsila abandu nende okhurumbula akobuloli shinga uno olwa ali ye owareebwaho nende Nyasaye abe omukhalachi weshiina khubalamu khandi nende abafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.42",
            "verseOrgIds": [
              "ACT.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanabii bosi barumbula akobuloli khuye, mbu muliiralie buli mundu oumusuubilila alanyoola obuleshelwi bwebionoono.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.43",
            "verseOrgIds": [
              "ACT.10.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abamahanga baheebwa Roho Omutakatifu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.43",
            "verseOrgIds": [
              "ACT.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa Petero yali nashisunga amakhuwa ako, Roho Omutakatifu yabeeshela bosi abahulila likhuwa elo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.44",
            "verseOrgIds": [
              "ACT.10.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abeshishebo abasuubila nibang'ang'aala, abo bosi abali nibeetsile halala nende Petero, shichila Abamahanga nabo basundulilwa eshihaanwa shiaRoho Omutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.45",
            "verseOrgIds": [
              "ACT.10.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 10:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba babahulila nibasunganga nende tsinimi, nibamuheelesia Nyasaye oluyali. Mana Petero nakalusia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.46",
            "verseOrgIds": [
              "ACT.10.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 10:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Niwina owakhanyala okhubeema amatsi, baleshe okhubatisibwa, bano abanyoolile Roho Omutakatifu bario shinga ifwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.47",
            "verseOrgIds": [
              "ACT.10.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 10:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nalaka mbu babatisibwe muliira liaYesu Kristo. Mana nibamusaaya mbu amenyekhwo ninabo tsindaalo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.48",
            "verseOrgIds": [
              "ACT.10.48"
            ]
          }
        }
      ]
    }
  ],
