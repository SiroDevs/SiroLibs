  "reference": "Ebikhole 13",
  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "ACT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho baliho eAndiokia, mukanisa eyebweneyo, abanabii nende abeechesia, mbabano, mbu Baranaba, nende Simeoni owalangwa mbu Nigeri, naLukio weKirene, naManaeni owoolelwa halala nende omuruchi Herode, nende Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.1",
            "verseOrgIds": [
              "ACT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibamukhalabanila Omwami, nende okhuhonga inzala, Roho Omutakatifu yaboola mbu Munzahulile Baranaba nende Saulo khulwa emilimo echia embalanjiile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.2",
            "verseOrgIds": [
              "ACT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa bali nibahonjile inzala nibasaaya nibabarakhwo emikhono, babaseebula mbu batsie.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.3",
            "verseOrgIds": [
              "ACT.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abarume beelwatsila eKipiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.3",
            "verseOrgIds": [
              "ACT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bo, nibarumwa bario nende Roho Omutakatifu, bakholomokha nibatsia eSeleukia; nokhurula yaho nibatsia muliaro okhuula eKipiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.4",
            "verseOrgIds": [
              "ACT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibali eSalami, barumbula ebulafu likhuwa liaNyasaye mutsisinagogi tsiabaYahudi; khandi bali nende Yohana nali omubeeli wabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.5",
            "verseOrgIds": [
              "ACT.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.5",
            "verseOrgIds": [
              "ACT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibalambuulile eshikhalachinga eshio shiosi okhuula ePafo, banyoola omundu undi omufumu, omunabii wobubeeyi, omuYahudi, owa eliira mbu BariYesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.6",
            "verseOrgIds": [
              "ACT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali halala nende kafuna, Serugio Paulo, omundu omurechelefu. Omwenoyo yalanga Baranaba nende Saulo niyeenya okhuhulila likhuwa liaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.7",
            "verseOrgIds": [
              "ACT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Elima, omufumu tsana, shichila eliiralie likalulwa lirio, yabakaya, niyeenya okhushiukhasia omwoyo kwakafuna oyo okhurula khubusuubili. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.8",
            "verseOrgIds": [
              "ACT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Saulo, khandi niye Paulo, niyeetsuule nende Roho Omutakatifu, yoomisia tsimoni okhumuhenga, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.9",
            "verseOrgIds": [
              "ACT.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasunga mbu E iwe owitsuulemwo obukatii nende obumayaanu bwosi, omwana waSetani, omusuku wobulunjishi bwosi, shionyala okhulekha okhushiamia tsinjila tsinunji tsiOmwami? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.10",
            "verseOrgIds": [
              "ACT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulaano, lola, omukhono kwOmwami kuli khwiwe; witsa okhukwa omubofu, noralolakhwo omubasu ta tsindaalokhwo. Nonoho yachaaka okhulola maweliweli, eshiilima nishimukwila; ne yachendanga nakhaaba oumutiila omukhono namwimilila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.11",
            "verseOrgIds": [
              "ACT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kafuna oyo, olwa yalola akakholekha, yasuubila, nachenyela ameechesio kOmwami.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.12",
            "verseOrgIds": [
              "ACT.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo naBaranaba nibali eAndiokia muPisidia.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.12",
            "verseOrgIds": [
              "ACT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho banga Paulo barula ePafo muliaro niboola ePeruga muPamufilia; mana Yohana yabalekha, nakalukha eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.13",
            "verseOrgIds": [
              "ACT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bo babira muPeruga niboola eAndiokia muPisidia; nibeenjila musinagogi khuSabato, nibeekhala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.14",
            "verseOrgIds": [
              "ACT.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyuma womusoomo kwamalako nende okwabanabii, abeemilisi beisinagogi baruma omundu okhubasunjila mbu Abaana beefwe, nimuba nimulikhwo nende likhuwa liosi liobuchesiyii, elia muleerela abandu bano, khaboole.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.15",
            "verseOrgIds": [
              "ACT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.15",
            "verseOrgIds": [
              "ACT.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Paulo nasinjila, nabasirmila omukhono, naboola mbu AbaIsiraeli bashianje, nende inywe abamuria Nyasaye, mumbulile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.16",
            "verseOrgIds": [
              "ACT.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye wabandu bano Isiraeli yalobola abakuuka beefwe, niyeemekha abandu abo olwa bali nibamenyakhwo mushibala shiaMisiri, nabeemilila nomukhono kwobunyalibwe nabarusiamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.17",
            "verseOrgIds": [
              "ACT.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mushise shiemiyika amakhumi kane yabeesimilisilia mushitsiimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.18",
            "verseOrgIds": [
              "ACT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali namuluule amahanga musaafu mushibala shiaKanaani, yabaheelesia eshialo shiabwe shibe obulaame bwabwe emiyika shinga ebikhumi bine namakhumi karaano; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.19",
            "verseOrgIds": [
              "ACT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolunyuma lwamakhuwa ako yabaheelesia abayaasii okhuula khuSamweli omunabii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.20",
            "verseOrgIds": [
              "ACT.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.20",
            "verseOrgIds": [
              "ACT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olunyumakhwo basaba omuruchi; Nyasaye nabaheelesia Saulo waKishi, omundu woluyia lwaBenyamini, mushise shiemiyika amakhumi kane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.21",
            "verseOrgIds": [
              "ACT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali namurusiyeho, yabuusia Daudi abe omuruchi wabwe; ne khumwenoyo yarumbula akobuloli, nasunga mbu Ndamunyoolile Daudi waYese, omundu owa omwoyokwe kuwinjana nende okwanje; naye alakhola aketsiyemi tsianje tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.22",
            "verseOrgIds": [
              "ACT.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulwibulo Iwomundu uno Nyasaye yaleereele Isiraeli Omuhonia, niye Yesu, shinga olwa yasuubisia; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.23",
            "verseOrgIds": [
              "ACT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa Yohana yali naranjiliile okhwilwatsila abandu bosi baIsiraeli obubatisii bwobwikalukhasii, ye nashili okhwitsa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.24",
            "verseOrgIds": [
              "ACT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yohana, olwa yali nali okhumalilisia oluchendolwe, yasunga ari Mukaala murie khwisie? Shindi nisie ye ta. Ne lole, aliho owitsa munyuma wanje, owa ndarakwanile okhuboholola ebilaaro ebiomubilenjebie tawe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.25",
            "verseOrgIds": [
              "ACT.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.25",
            "verseOrgIds": [
              "ACT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana beefwe, abaana boluyia lwaAburahamu, nende abo khwinywe abariitsanga Nyasaye, nifwe abarumilwa likhuwa liobuhonia buno. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.26",
            "verseOrgIds": [
              "ACT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abamenya eYerusalemu, nende abeemilisi babwe, olwa bamukorwa, nibaramanya okhuboola khwabanabii okhusoomungwa buli Sabato ta, bakhuusia olwa bamukhalachila eshiina. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.27",
            "verseOrgIds": [
              "ACT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata olwa baranyoola eshifune shiosi shiokhumwira ta, kho basaba Pilato mbu yeerwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.28",
            "verseOrgIds": [
              "ACT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali niboosiye ako kosi akamuhandiichilwa, bamwakula khumusaala nibamwalisia mung'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.29",
            "verseOrgIds": [
              "ACT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Nyasaye yamulamusia mukhufwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.30",
            "verseOrgIds": [
              "ACT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana yalolwa tsindaalo tsinyinji nende abo abatikulukha ninaye okhurula eGalilaya okhuula eYerusalemu; ne nibo aba bulaano bali abarumbusibe imbeli wabandu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
