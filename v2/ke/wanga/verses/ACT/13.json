          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mumanye, baana beefwe, mbu mumundu uno mumanyisibwa ebulafu akobulesheIwi bwebionoono; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.38",
            "verseOrgIds": [
              "ACT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi khululwe buli mundu ousuubila abasilibwakhwo obulunjishi mu ako kosi aka aranyala okhubasilibwakhwo obulunjishi khulwa amalako kaMusa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.39",
            "verseOrgIds": [
              "ACT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako mwirecheshe, kaleshe okhumukwila akeenako aka abanabii baboola, mbu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.40",
            "verseOrgIds": [
              "ACT.13.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibarula, babasaaya mbu bababoolelekhwo amakhuwa ako khuSabato yakhabili. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.42",
            "verseOrgIds": [
              "ACT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abomusinagogi basalaana, abanji abokhubaYahudi nende abokhubashiukhani abeekayakayi babalondakhwo Paulo nende Baranaba; nabo nibasungana ninabo, nibabatinyilisia mbu balumilile mubukoosia bwaNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khuSabato yakhabili ahambi khubosi abomwitookho bakhung'aana okhuhulila likhuwa liaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.44",
            "verseOrgIds": [
              "ACT.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaYahudi balola emikanda, imbalikha niyiitsula mubo, nibafukula amakhuwa akasungwa nende Paulo, nibanyeka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.45",
            "verseOrgIds": [
              "ACT.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Paulo nende Baranaba nibaboola katong'ane neitswoni, bari Kabeele nikakhoyeele mbu likhuwa liaNyasaye limubooleelwe inywe mbeli. Olwa mulisindikhanga eyo, nimwichela abeene mbu shimukwaniile obulamu bwobumeli ta, lole khushiukhana nikhutsia khuBamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.46",
            "verseOrgIds": [
              "ACT.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
              "ACT.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Abamahanga bahulila ako, basangaala, nibaheelesia likhuwa liaNyasaye oluyali; nabo bosi abaahulwa khulwa obulamu bwobumeli nibasuubila.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.48",
            "verseOrgIds": [
              "ACT.13.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.48",
            "verseOrgIds": [
              "ACT.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "ACT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liaNyasaye nalio nilitswana mumbali etsio tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.49",
            "verseOrgIds": [
              "ACT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "ACT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaYahudi batswanzwania abakhasi abeekayakayi aboluyali nende abasaatsa abakhulundu abomwitookho, omwo, nibayakula obusandii khuPaulo nende Baranaba, nibabarusia munzakho tsiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.50",
            "verseOrgIds": [
              "ACT.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "ACT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibateng'ulula olufu olwokhubilenje biabwe okhubafukula; niboola eIkonio. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.51",
            "verseOrgIds": [
              "ACT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "ACT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechi nabo nibeetsulamwo okhwikhoya khandi nende Roho Omutakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.52",
            "verseOrgIds": [
              "ACT.13.52"
            ]
          }
        }
      ]
