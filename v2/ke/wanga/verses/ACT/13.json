            "sid": "ACT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefu khumuleerela amakhuwa amalayi akobusuubisie obwa abakuuka abo basuubisibwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga olwa Nyasaye yabuusilia obusuubisie bwenobwo khubaana aba khweebula, olwa yamulamusia Yesu; khandi kali shinga olwa kahandiikwa mutsabuli yakhabili, mbu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumakhuwa katsana, shinga olwa yamulamusia mukhufwa, oburakalukha mukhubola ta, yasunga ari nanwa, mbu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.34",
            "verseOrgIds": [
              "ACT.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.35",
            "verseOrgIds": [
              "ACT.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila Daudi, olwa yali namalile okhukhalabanila tsiyemi tsiaNyasaye mulubakalwe, yakona tsindoolo, niyaalisibwa halala nabakukanyene, niyeenjila mukhubola. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.36",
            "verseOrgIds": [
              "ACT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa oyo owa Nyasaye yalamusia mukhufwa shiyayeenjila mukhubola ta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.37",
            "verseOrgIds": [
              "ACT.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
