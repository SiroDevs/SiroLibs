            "number": "31",
            "style": "v",
            "sid": "ACT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
