    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petero yakhupila abeikanisa yeYerusalemu iripoti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho abarume nende abaana beefwe abali ebuYahudi bahulila shinga Abamahanga nabo olwa bali nibanyoolile likhuwa liaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.1",
            "verseOrgIds": [
              "ACT.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Petero yali natikuluushe niyoolile eYerusalemu, abo abali abeshishebo bayingana ninaye, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.2",
            "verseOrgIds": [
              "ACT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bari Iwe weenjila mubandu abasinde, nolia ninabo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.3",
            "verseOrgIds": [
              "ACT.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.3",
            "verseOrgIds": [
              "ACT.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Petero yachaaka, nabamanyia amakhuwa bulayi shinga olwa kalondana, nasunga ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.4",
            "verseOrgIds": [
              "ACT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Ndali nindi mwitaala liaYafa, nisaayanga; ne olwa ndali niyenzeelile ndalola libisulo, mbu eshichinjilo shindi nishiikha, shingana ishuka ingali, niyiisibwa okhurula mwikulu niyitiililwe emikhanda chine chiosi; nishiula aha ndali. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.5",
            "verseOrgIds": [
              "ACT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ninyumisiye tsimoni okhuhenga, ndashiyililisiakhwo, nindola ebilonje biamakulu kane ebieshialo, kata tsisolo, nebimoolanga, nende amanyonyi akokhwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.6",
            "verseOrgIds": [
              "ACT.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndahulila omwoyo nikumboolela mbu Buukha, Petero; wire olie. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.7",
            "verseOrgIds": [
              "ACT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndakalusia ndi 'A, tawe, Omwami; okhuba eshindu shiosi eshiomusilo kata eshieshifwabwi shishili okhwinjila mumunwa kwanje ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.8",
            "verseOrgIds": [
              "ACT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwoyo okwo nikukalusia olwakhabili okhurula mwikulu, kuri Fshia Nyasaye asiiyile, orashilanga mbu neshieshifwabwi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.9",
            "verseOrgIds": [
              "ACT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kakholekha khataru; mana biosi nibikhweswa nibikalusibwa mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.10",
            "verseOrgIds": [
              "ACT.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana lole, nonoho abasaatsa bataru nibasinjila imbeli weinzu eya khwalimwo, nibarumilwe khwisie okhurula eKaisaria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.11",
            "verseOrgIds": [
              "ACT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Roho yambiila mbu enzie ninabo, oburakhola obwahuli bwosi ta. Nabo abaana beefwe bano basasaba nikhutsia ninabo; nikhwinjila munzu yomusaatsa oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.12",
            "verseOrgIds": [
              "ACT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakhuboolela shinga olwa yali naluutsi malaika nasinjiile munzuye, nasunga mbu Rumana eYafa okhwenda Simoni owa lilahalie niPetero; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.13",
            "verseOrgIds": [
              "ACT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwenoyo alakhuboolela amakhuwa akalachila nohonibwa, iwe nende abeinzuyo bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.14",
            "verseOrgIds": [
              "ACT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa ndali nishichaaka okhusunga, Roho Omutakatifu yabeeshela, shinga olwa yakhwishila ifwe khukhuchaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.15",
            "verseOrgIds": [
              "ACT.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ninzitsulila amakhuwa kOmwami, shinga olwa yasunga mbu Toto mwene, Yohana yabatisinjia nende amatsi; ne inywe mwakhabatisibwe nende Roho Omutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.16",
            "verseOrgIds": [
              "ACT.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Nyasaye olwa yabaha eshihaanwa shilala shieneshio eshia yakhuheelesia ifwe olwa khwasuubilila Omwami Yesu Kristo, nisie wina owakhanyalile okhukaya Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.17",
            "verseOrgIds": [
              "ACT.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.17",
            "verseOrgIds": [
              "ACT.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo olwa bahulila amakhuwa ako, bahoeela, nibamuheelesia Nyasaye oluyali, bari Khane Nyasaye yaheele Abamahanga nabo obwikalukhasii mbu banyoole obulamu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.18",
            "verseOrgIds": [
              "ACT.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikanisa yeAndiokia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.18",
            "verseOrgIds": [
              "ACT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abo abasalaana hosi hosi khulwa obusandibwi obwabuushila khumakhuwa kaSitefano bachenda okhuula eFoinike naKipiro naAndiokia, nibaraboolela abandu bosi akelikhuwa liene ta, habula abaYahudi bonyene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.19",
            "verseOrgIds": [
              "ACT.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne baliho abandi khubo, abaKipiro nabaKirene; nibo ababoolelakhwo kata abaYunani, olwa bali niboolile eAndiokia, nibeelwatsa akOmwami Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.20",
            "verseOrgIds": [
              "ACT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhono kwOmwami nikuba ninabo, abanji abasuubila nibashiukhanila Omwami.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.21",
            "verseOrgIds": [
              "ACT.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.21",
            "verseOrgIds": [
              "ACT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa kabwe nikoola mumarwi keikanisa eyali eYerusalemu; nabo nibaruma Baranaba okhuula eAndiokia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.22",
            "verseOrgIds": [
              "ACT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye olwa yali niyoolileyo, nende okhulola obukoosia bwaNyasaye, yasangaala; nabachesiyia bosi mbu barekhwo omwoyo okhuhanda khuMwami; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.23",
            "verseOrgIds": [
              "ACT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba yali omundu omulayi, niyeetsulamwo Roho Omutakatifu nende obusuubili; abandu abanji nibameetekha khuMwami.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.24",
            "verseOrgIds": [
              "ACT.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.24",
            "verseOrgIds": [
              "ACT.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana narula natsia eTaruso okhukhaaba Saulo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.25",
            "verseOrgIds": [
              "ACT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa yali na nunyoolile, yamuleera eAndiokia. Mana omuyika omulamba bakhung'aananga nende ikanisa, nibeechesia abandu abanji. Ne ebweneyo eAndiokia niyo ewa abeechi baranjilila okhulangwa mbu abaKristayo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.26",
            "verseOrgIds": [
              "ACT.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.26",
            "verseOrgIds": [
              "ACT.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mundaalo etsio abanabii bandi bakholomokha okhurula eYetusalemu niboola eAndiokia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.27",
            "verseOrgIds": [
              "ACT.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulala khubo oweliiralie mbu Agabo yasinjila namanyia mubunyali bwaRoho shinga inzala ikhongo olwa yitsa okhubaho mubialo biosi; nayo yamala yibeho mundaalo tsiaKilaudio. ",
          "type": "text",
          "attrs": {
