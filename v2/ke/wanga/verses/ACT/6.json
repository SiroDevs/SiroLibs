          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abandu musaafu baahulilwa obukhalabani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mundaalo tsienetsio, olwa obunji bwabeechi bwali nibumeetekhanga, abaYahudi beshiYunani bachaaka okhubuutsuluulila abeshiHeburania, shichila abakhasi abalekhwa babwe bamaayibungwa mubukabi bwabuli nyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.1",
            "verseOrgIds": [
              "ACT.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo Ekhuminababili nibalanga omukanda kwosi kwabeechi, nibabasunjila bari Shikakhoyeele ifwe okhulekha likhuwa liaNyasaye nikhukhalabana khumeesa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.2",
            "verseOrgIds": [
              "ACT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaana beefwe, mwele mwinywe abeene abandu musaafu beifuma indayi, abeetsuulemwo Roho khandi nende obuchesi, aba khuraho khwikhuwa lino. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.3",
            "verseOrgIds": [
              "ACT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ifwe khulalumilila muno mukhusaaya khandi mubukhalabani bwelikhuwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.4",
            "verseOrgIds": [
              "ACT.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.4",
            "verseOrgIds": [
              "ACT.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa ako nikachamisia omukanda kwosi; nibalobola Sitefano, omundu oweetsulamwo obusuubili khandi nende Roho Omutakatifu, naFilipo, naPurokoro, naNikanori, naTimoni, naParamena, naNikolao omushiukhani oweAndiokia; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.5",
            "verseOrgIds": [
              "ACT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibabara imbeli wabarume; nabo olwa bali nibamalile okhusaaya, babarakhwo emikhono.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.6",
            "verseOrgIds": [
              "ACT.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.6",
            "verseOrgIds": [
              "ACT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liaNyasaye nilimeetekha; obunji bwabeechi nibumeetekha muno muYerusalemu; abanji khubakuhani bahulilanga nibakhola akObusuubili obwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sitefano yahambwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Sitefano, niyeetsuulemwo obukoosia nende obunyali, yakhola amangalimwa amakhongo nende ebilolelo mubandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.8",
            "verseOrgIds": [
              "ACT.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abandi babuukha khubeisinagogi eyalangungwa mbu eyAbalekhuule, neyabeKirene, neyabeAlekisanderia, nende eya abo beKilikia nende Asia, nibayingana nende Sitefano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.9",
            "verseOrgIds": [
              "ACT.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakhaywa okhufukula obuchesibwe nende Roho oyo owa yasunjilangamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.10",
            "verseOrgIds": [
              "ACT.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibatsuuba abandu okhusunga mbu Khumuhuliile naboola amakhuwa akokhunyeka Musa, nende Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.11",
            "verseOrgIds": [
              "ACT.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibayakula abandu, nabakofu, nabahandiichi, nibamunyoola nibamuhamba nibamuyila mushiina, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.12",
            "verseOrgIds": [
              "ACT.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibaraho abarumbusi bobubeeyi, abasunga bari Omundu uno shiakonelanga tawe okhuboola amakhuwa akokhufukula habundu hano ahatakatifu, nende amalako; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.13",
            "verseOrgIds": [
              "ACT.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba khwahuliile nasunga mbu Yesu uno weNazareti alamulula habundu hano, nakalukhasia ebiima ebia Musa yakhuheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.14",
            "verseOrgIds": [
              "ACT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bosi abali nibeekhaale mushiina nibamuumisiakhwo tsimoni, nibalola obwenibwe nibuli shinga obweni bwamalaika.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.15",
            "verseOrgIds": [
              "ACT.6.15"
            ]
          }
        }
      ]
    }
  ],
