{
  "id": "MRK.10",
  "number": "10",
  "bookId": "MRK",
  "reference": "Mariko 10",
  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "MRK 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yesu yeechesia khukokhulekhana khwomusaatsa nomukhasiwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narulayo, niyoola mungongo tsiebuYahudi nende injelekha weYorodani; abemikanda nibakhung'aana khandi ewa yali; naye nabeechesia khandi, shinga olwa eshiimashie shiali. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.1",
            "verseOrgIds": [
              "MRK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaFarisayo bandi nibeetsa ewa yali nibamureeba, bari Nomusilo omundu okhwilusia omukhasiwe noho? Nibamuteema bario. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.2",
            "verseOrgIds": [
              "MRK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia, nabareeba ari Musa yamulaka arie? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.3",
            "verseOrgIds": [
              "MRK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasunga mbu Musa yakhufuchiilila okhuhandiika ibarwa yobukabukhani nokhumwilusia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.4",
            "verseOrgIds": [
              "MRK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu nababoolela, ari Khulwa obutinyu bwemioyo chieenywe yamuhandiichila lilako elo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.5",
            "verseOrgIds": [
              "MRK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa okhurula khukhuchaaka khwobulongwi, Nyasaye yabalonga omusaatsa nende omukhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.6",
            "verseOrgIds": [
              "MRK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niko akachila omusaatsa alalekhanga samwana nende nyina, nahambana nomukhasiwe; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.7",
            "verseOrgIds": [
              "MRK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo bombi balaba omubili mulala; shibalaba babili khandi ta, habula omubili mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.8",
            "verseOrgIds": [
              "MRK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana aba Nyasaye yahambasia halala, omundu namundu aleshe okhukabukhasia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.9",
            "verseOrgIds": [
              "MRK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nibali munzu abeechi abo bamureeba khandi khwikhuwa elo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.10",
            "verseOrgIds": [
              "MRK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabasunjila mbu Omundu yesi owilusia omukhasiwe nateeshia oundi, aheya namwonoonela; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.11",
            "verseOrgIds": [
              "MRK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata omukhasi naba narula khumusaatsawe nateeshela oundi, yesi aheya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.12",
            "verseOrgIds": [
              "MRK.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yasabila abaana abatiiti ikhabi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.12",
            "verseOrgIds": [
              "MRK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali nibamuleerela abaana abatiiti mbu abatiilekhwo; abeechibe nibabakondeshela. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.13",
            "verseOrgIds": [
              "MRK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Yesu yalola ario, nasinyikha, nabasunjila ari Leshe abaana abatiiti beetse khumubili wanje; murabakaania ta; okhuba obwami bwaNyasaye nobwabafwana shinga abo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.14",
            "verseOrgIds": [
              "MRK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emusunjila toto, mbu Omundu yesi ourafuchiilila obwami bwaNyasaye shinga omwana omutuutu ta, shialeenjilakhwomwo nahatuutu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.15",
            "verseOrgIds": [
              "MRK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabachinga mumakhonoke, nabasabila ikhabi, nabareetsangakhwo amakhono.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.16",
            "verseOrgIds": [
              "MRK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusooliili omuyinda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.16",
            "verseOrgIds": [
              "MRK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yali nali khunjila natsiitsanga, omundu undi yamutsiila tsimbilo namusikamila, namureeba ari Omwechesia omulayi, nekhole endie mbu mana enaamilwe obulamu bwobumeli? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.17",
            "verseOrgIds": [
              "MRK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu namukalusia ari Kho unanga mbu omulayi mbushiina? Abulaho ouli omulayi habula mulala, niye Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.18",
            "verseOrgIds": [
              "MRK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omanyile amalako, mbu Oreera ta, Oraheya ta, Oreeba ta, Orachiikha ta, Orakaatia ta, Heelesia so nende mawo oluyali. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.19",
            "verseOrgIds": [
              "MRK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namusunjila mbu Omwechesia, ako kosi engakholanga okhurula nindi omwana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.20",
            "verseOrgIds": [
              "MRK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Yesu yamuhenga namuheela, namusunjila ari Oleemile likhuwa elala; mbu tsia okusie ebia oli ninabio biosi, oheelesie abamanani, mana olaba nelibiikho mwikulu; mana witse, unondekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.21",
            "verseOrgIds": [
              "MRK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwikhuwa elo yakhuunia mumoni, niyeenyokha nabeeleele; shichila yali omwene mikunda emikali.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.22",
            "verseOrgIds": [
              "MRK.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.22",
            "verseOrgIds": [
              "MRK.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yesu nahenga eyi nende eyi, nasunjila abeechibe, ari Nobutinyu muno abali nobuyinda okhwinjila mubwami bwaNyasaye! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.23",
            "verseOrgIds": [
              "MRK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechi nabo nibachenya khulwa amakhuwake. Ne Yesu yakalusia khandi, nabasunjila ari Abaana banje, nobutinyu muno abeesiikanga obuyinda okhwinjila mubwami bwaNyasaye! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.24",
            "verseOrgIds": [
              "MRK.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neshiangu ingamia okhubira munduhu yoluchela, okhushila owobuyinda okhwinjila mubwami bwaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.25",
            "verseOrgIds": [
              "MRK.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibahuka okhushila, nibamureeba bari Kho niwina owakhanyala okhuhonibwa? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.26",
            "verseOrgIds": [
              "MRK.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nabahenga, nasunga mbu Khubandu shilinyalikha tawe; ne shikali kario khuNyasaye ta; shichila amakhuwa kosi kanyalikhanga khuNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.27",
            "verseOrgIds": [
              "MRK.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Petero nachaaka okhumusunjila, ari Lola, ifwe khwalekha biosi, nikhukhulondakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.28",
            "verseOrgIds": [
              "MRK.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nasunga mbu Emuboolela toto, mbu abulaho owalekha inzu, kata abasiani babwe, kata bambootsonyene kata nyina, kata samwana, kata abaana, kata emikunda, khulwanje khandi khulwa Injiili, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.29",
            "verseOrgIds": [
              "MRK.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "oburanyoola ebindi okhuula eshikhumi, bulaano mundaalo tsino, tsinzu, nende abasiani babwe, nabambootsonyene, nabanyina, nabaana, nemikunda, halala nokhusakanibwa; nomundaalo etsiitsa, obulamu bwobumeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.30",
            "verseOrgIds": [
              "MRK.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abanji abalinji abambeli baliba abeinyuma; abeinyuma nibaba abambeli.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.31",
            "verseOrgIds": [
              "MRK.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yaboola akokhufwakhwe olwakhataru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.31",
            "verseOrgIds": [
              "MRK.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali nibali khunjila nibatikulukhanga okhutsia eYerusalemu; ne Yesu yali niyeemiile imbeli wabwe; nabo nibachenya; oburii nibubahamba abali nibamulondangakhwo. Ne yabukula abo Ekhumi-nababili khandi, nachaaka okhubaboolela amakhuwa akali nikeetsa okhumwikholakhwo, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.32",
            "verseOrgIds": [
              "MRK.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari Lole, khutikulukha nikhutsia eYerusalemu; ne Omwana wOinundu alahaanwa mumakhono kabakhulundu babakuhani nende abahandiichi; nabo balamukhalachila eshiina eshiokhwirwa, nibamuhaana mumakhono kAbamahanga; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.33",
            "verseOrgIds": [
              "MRK.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne balamunyokhoosia, nibamunyilikhakhwo amare, nibamunywekha tsikhoba, nende okhumwira; nolunyuma lwetsindaalo tsitaru alalamukha khandi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.34",
            "verseOrgIds": [
              "MRK.10.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo naYohana basaba likhuwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.34",
            "verseOrgIds": [
              "MRK.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo nende Yohana, abaana baZebedayo, nibasita ahambi aha yali nibamusunjila bari Omwechesia, khwenya mbu okhukholele shiosi eshia khwitsa okhukhusaba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.35",
            "verseOrgIds": [
              "MRK.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabareeba mbu Eshia mwenya emukholele nishiina? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.36",
            "verseOrgIds": [
              "MRK.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusunjila bari Ofuchiilile mbu khwikhale, mulala khumukhonokwo musaatsa, oundi khumukhono mukhasi, muluyalilwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.37",
            "verseOrgIds": [
              "MRK.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu yabasunjila ari Mukorilwe eshia musaba shinga olwa shili. Munyala okhunywakhwo khushikombe eshia enyweelakhwo isie? Kata okhubatisibwa nende obubatisii obwa embatisibwa ninabwo isie? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.38",
            "verseOrgIds": [
              "MRK.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamukalusia, bari Khunyala. Yesu nabasunjila ari Eshikombe eshia enyweeIangakhwo, nineenywe mulanyweelakhwo; khandi obubatisii obwa embatisibwa, nineenywe mulabatisibwa; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.39",
            "verseOrgIds": [
              "MRK.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa akokhwikhala khumukhono kwanje musaatsa kata khumukhono mukhasi shikali akanje okhuhaana ta; ne nakabeenabo aba kakasilibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.40",
            "verseOrgIds": [
              "MRK.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ekhumi, olwa bahulilakhwo, bachaaka okhusinyishila akaYakobo nende Yohana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.41",
            "verseOrgIds": [
              "MRK.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu nabalanga ewa yali, nabasunjila ari Mumanyile shinga abo abakulikhwa mbu abaruchi bAbamahanga olwa babaamihanga, khandi abakhongo babwe shinga olwa babarukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.42",
            "verseOrgIds": [
              "MRK.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shikali kario mwinywe ta; nebutswa owenya okhuba omukhongo mwinywe, abe ye omukhalabani weenywe; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.43",
            "verseOrgIds": [
              "MRK.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye owenya okhuba owambeli mwinywe, abe ye omusumba wabosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.44",
            "verseOrgIds": [
              "MRK.10.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba toto mwene Omwana wOmundu shiyayeetsa okhukhalabanilwa tawe, habula okhukhalabana, nokhuhaana obulamubwe bube eshinunulo khulwa abanji.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.45",
            "verseOrgIds": [
              "MRK.10.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omubofu Baritimayo yanyalilwa okhulola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.45",
            "verseOrgIds": [
              "MRK.10.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 10:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niboola eYeriko; nolwa yali narulanga eYeriko halala nende abeechibe nende omukanda omukali, omwana waTimayo, mbu Baritimayo, omubofu omusabi, yali niyeekhaale khundulo weinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.46",
            "verseOrgIds": [
              "MRK.10.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 10:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yahulila mbu ni Yesu omuNazareti, yachaaka okhulanjisia, ari Yesu, omwana waDaudi, umbeele tsimbabasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.47",
            "verseOrgIds": [
              "MRK.10.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MRK 10:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu abanji nibamuloshela, mbu aholeele; naye nameeta bumeeta okhulanjisia, ari Iwe omwana waDaudi, umbeele tsimbabasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.48",
            "verseOrgIds": [
              "MRK.10.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MRK 10:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu niyeemaho, nasunga mbu Mumulanje. Nibamulanga omubofu, nibamusunjila bari Lema omwoyo; sinjila, akhulanganga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.49",
            "verseOrgIds": [
              "MRK.10.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MRK 10:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niyaabala inguboye, niyaaluulukha, nabuukha natsia ewa Yesu yali. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.50",
            "verseOrgIds": [
              "MRK.10.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MRK 10:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu namureeba mbu Nishiina eshia wenya ekhukholele? Omubofu namusunjila ari Omwami wanje, mbu enyalilwe okhulola. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.51",
            "verseOrgIds": [
              "MRK.10.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MRK 10:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu namusunjila mbu Otsie butsia; obusuubilibwo bukhuhoniye. Ne habwene nahabwene nachaaka okhulola, nalonda munyumawe khunjila.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.52",
            "verseOrgIds": [
              "MRK.10.52"
            ]
          }
        }
      ]
    }
  ],
