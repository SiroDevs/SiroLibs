{
  "id": "MRK.5",
  "number": "5",
  "bookId": "MRK",
  "reference": "Mariko 5",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "MRK 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "OmuGerasi owali naroho weshifwabwi yahonibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niboola injelekha weinyanza, mushibala shiabaGerasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.1",
            "verseOrgIds": [
              "MRK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yali niyakharula muliaro, habwenaho yabukaana nende omundu owa roho weshifwabwi yali muye, narulanga mubilindwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.2",
            "verseOrgIds": [
              "MRK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali namenyanga mubilindwa. Ne yali nabulaho owanyala okhumuboha khandi, kata nende eminyololo ta, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.3",
            "verseOrgIds": [
              "MRK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila yalinji nabohungwa khandi akhanji nebitiili nende eminyololo, ne yali niyakhalakanga eminyololo nokhutsaanuula ebitiili, ne yabulaho owamaani owanyala okhumuhula. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.4",
            "verseOrgIds": [
              "MRK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo tsiosi, eshiteere neshilo, yali nahonganga mubilindwa khandi mubikulu, niyaayula niyeekhalaka omubilikwe namachina. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.5",
            "verseOrgIds": [
              "MRK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yalola Yesu nashili ehale, yeelukha namusikamila, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.6",
            "verseOrgIds": [
              "MRK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nayiiba nende omwoyo omukhongo, nasunga ari Obeele orie ninasi Yesu, iwe Omwana waNyasaye Ouli Ikulu Muno? Muliira liaNyasaye ekhusaaya mbu ora'saaliisia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.7",
            "verseOrgIds": [
              "MRK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba yali namusunjiile mbu Iwe roho weshifwabwi, rula mumundu oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.8",
            "verseOrgIds": [
              "MRK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana namureeba ari Eliiralio niwe wina? Naye namukalusia mbu Eliira lianje nisie Legioni, shichila khuli abanji. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.9",
            "verseOrgIds": [
              "MRK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusaaya muno oburabeelusia batsie mushindi shialo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.10",
            "verseOrgIds": [
              "MRK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulukongo olwo lialiho lituuli likali lietsimbiitsi nitsiayanga; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.11",
            "verseOrgIds": [
              "MRK.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho abaroho abo nibamusaaya bari Okhurume mumbiitsi, khwinjile mutsio. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.12",
            "verseOrgIds": [
              "MRK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho Yesu yabafuchiilila ario. Abaroho beshifwabwi nabo nibarula nibeenjila mumbiitsi, lituuli liosi lietsimbiitsi shinga ebikhumila bibili niliminina nilikholomokha niliikhupa munyanza, nitsifwilamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.13",
            "verseOrgIds": [
              "MRK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaayi batsio nibeelukha nibatswania amakhuwa ako mwitaala liosi khandi mulukongo olwo lwosi. Abandu nibeetsa okhulola akali nikeekholile shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.14",
            "verseOrgIds": [
              "MRK.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho boola ewa Yesu yali, nibalola oyo owa amadimoni kabeelenjemwo, owa Legioni yalimwo, niyeekhaale, niyeefwalile tsingubo nali habwene; nibaria. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.15",
            "verseOrgIds": [
              "MRK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaloli nibababoolela akali nikeekholile khuwamadimoni shinga olwa kali, nende aketsimbiitsi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.16",
            "verseOrgIds": [
              "MRK.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusaaya mbu arule mushialo shiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.17",
            "verseOrgIds": [
              "MRK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yali niyeenjila muliaro omundu oyo owa amadimoni kalimwo yamusaaya mbu abeetsenje ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.18",
            "verseOrgIds": [
              "MRK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye shiyamufuchiilila ta, ne namusunjila ari Winyoshe otsie ebunanzuwo, khubandu beweenywe, obaboolele amakhuwa aka Omwami yakhukholeele shinga olwa kali amakhongo, khandi shinga olwa akhubeeleele tsimbabasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.19",
            "verseOrgIds": [
              "MRK.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye niyeenyokha natsia nachaaka okhwilwatsa muDekapoli amakhuwa aka Yesu yali namukholeele shinga olwa kali amakhongo, abandu bosi nibachenya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akomwana waYairo, nakomukhasi owatiilakhwo khungubo ya Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa Yesu yali niyaambushiile khandi muliaro injelekha weinyanza, omukanda omukhongo nikukhung'aana ewa yali; ne yali nali hanyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.21",
            "verseOrgIds": [
              "MRK.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mulala khubakhulundu beisinagogi yamwitsila, owa eliiralie mbu Yairo. Olwa yamulola, niyeekhupa hasi mumakuluke, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.22",
            "verseOrgIds": [
              "MRK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "namusaaya muno ari Omwana wanje omukhaana omutiiti ali okhufwa; ekhusaaya mbu witse omurekhwo amakhono ahone abe mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.23",
            "verseOrgIds": [
              "MRK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nalondokhana ninaye, omukanda omukhongo nikulondana ninabo, nikumutiya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaliho omukhasi undi owali niyeerulutsanga emiyika ekhumi nachibili; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.25",
            "verseOrgIds": [
              "MRK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "yali niyanyasibwa muno nabasilishi abanji, namala amapeesa kosi aka yali ninako, oburahonakhwo ta; nebutswa obulwale bwali nibwimeetanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.26",
            "verseOrgIds": [
              "MRK.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yahulila aka Yesu, yeetsela mumukanda emukongo, natiilakhwo khunguboye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.27",
            "verseOrgIds": [
              "MRK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila yali nasunganga mbu Kata nindiilakhwo butswa khungubotsie, nehonibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.28",
            "verseOrgIds": [
              "MRK.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwene nahabwene eshinoko shiokhwirulutsakhwe khwakhalikha, nahulila mumubilikhwe mbu umalile okhuhona mukhunyasibwakhwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.29",
            "verseOrgIds": [
              "MRK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho Yesu yeemanya mbu obunyali burulile muye, nashiukhana mumukanda, nareeba mbu Outiilile khungubo tsianje niwina? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.30",
            "verseOrgIds": [
              "MRK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechibe nibamukalusia bari Oluutsi omukanda kukhutiyanga, ne oreeba mbu Oundiililekhwo niwina? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.31",
            "verseOrgIds": [
              "MRK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nahenga eyi nende eyi okhulola mbu niwina oukholile likhuwa elo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.32",
            "verseOrgIds": [
              "MRK.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhasi oyo yaria natechela, okhuba yamanya akali nikamwikholeele, niyeetsa nakwa mumakuluke, namuboolela obwatoto bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.33",
            "verseOrgIds": [
              "MRK.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namusunjila mbu Omukhaana wanje, obusuubilibwo bukhuhoniye. Otsie nomulembe, ohone mubunyasibwibwo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yali nashisunganga abandu bewomukhulundu oyo weisinagogi nibeetsa, nibasunga mbu Omwanawo utnalile okhufwa. Oshinyasinjia Omwechesia mbushiina? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.35",
            "verseOrgIds": [
              "MRK.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu yakhaya okhuhulila aka baboola, namusunjila omukhulundu weisinagogi oyo ari Oraria ta. Suubila busuubila. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.36",
            "verseOrgIds": [
              "MRK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shiyamoka omundu yesi okhulondana ninaye ta, habula Petero naYakobo naYohana omusiani wabwe Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.37",
            "verseOrgIds": [
              "MRK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boola enanzu womukhulundu weisinagogi oyo, Yesu nalola obukoyaani, nende abo abeekhuula nibakhupa tsimbungu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.38",
            "verseOrgIds": [
              "MRK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeenjilamwo nabasunjila ari Mbushiina nimukoyaananga nimwikhuula? Omwana uno shiafwile ta; akonanga butswa tsindoolo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.39",
            "verseOrgIds": [
              "MRK.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibamutseshelela butswa. Naye nabarusia bosi, nabukula samwana nende nyina, nende aba yali ninabo, niyeenjila omwa omwana yali nakonile. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.40",
            "verseOrgIds": [
              "MRK.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatiila omwana omukhono, namusunjila ari Talitsa kumu, eshisina mbu, Akhaana khanje, ekhubiila mbu buukha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.41",
            "verseOrgIds": [
              "MRK.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonoho omukhaana oyo nabuukha, nachenda, okhuba yali owemiyika ekhumi nachibili. Habwenaho bang'ang'aala nibahuka muno. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.42",
            "verseOrgIds": [
              "MRK.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabalaka butinyu mbu omundu yesi aleshe okhumanya likhuwa elo; nababiila mbu bamuheelesia eshiokhulia.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.43",
            "verseOrgIds": [
              "MRK.5.43"
            ]
          }
        }
      ]
    }
  ],
