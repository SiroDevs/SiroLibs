    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehu yasishia inzu yaAhaabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu yali nali nabaana amakhumi musaafu muSamaria. Kho Yehu yahandiika tsiba-rwa natsiruma eSamaria, khubakhulundu belitookho, nibo abakofu, khandi khubeenabo abali niboola abaana baAhabu, ari ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.1",
            "verseOrgIds": [
              "2KI.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulaano, olwa muli nende abaana bomwami weenywe, khandi muli namakaari netsifarasi, namataala ketsingoba, nebimanulwa, kho ibarwa yino niyakhoola ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.2",
            "verseOrgIds": [
              "2KI.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mulobole mubaana bomwami weenywe oyo oushila abandi, oukhoyeele, mumwemeshe khushifumbi shiasamwana, nimulwanila inzu yomwami weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.3",
            "verseOrgIds": [
              "2KI.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo, ikholo niyibarimukha, nibasunga mbu Lole, abaruchi abo babili bakhaywa okhusinjila imbeliwe; neefu nakhunyale khurie okhusinjila? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.4",
            "verseOrgIds": [
              "2KI.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omusinjilili weinzu, nomusinjilili welitookho liene, halala nabakofu, nende abo aboolanga abaana tsana, bakhupila Yehu omunwa bari Nifwe abasumbabo, ne khulakhola kosi aka olakhulaka; shikhulamwemekha omundu yesi abe omuruchi ta; okhole aka oluutsi mbu namalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.5",
            "verseOrgIds": [
              "2KI.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nabahandiichila ibarwa olwakhabiii, ari Nimuba nimuli khulubeka lwanje, khandi nimuba nimulahulilanga omwoyo kwanje, bukule emirwe chiabandu abo, abaana bomwami weenywe, munzitsile eYezereeli mukamba shinga khusaa yino. Ne abaana bomuruchi abo, abandu amakhumi musaafu, bali mumakhono kabakhulundu belitookho, ababoola. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.6",
            "verseOrgIds": [
              "2KI.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa ibarwa tsana yoolayo, babukula abaana bomuruchi nibabeera, abandu amakhumi musaafu, nibara emirwe chiabwe mubimwelo, nibamuyilila eYezereeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.7",
            "verseOrgIds": [
              "2KI.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omurume niyeetsa namuboolela mbu Baleerile emirwe chiabaana bomuruchi. Nababoolelambu Muchibunjishe ebituuli bibili habwinjililo bwoluyia okhuula mutsuli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.8",
            "verseOrgIds": [
              "2KI.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mutsuli narula, niyeema, nasunjila abandu bosi ari Inywe mubula eshikha. Toto, nisie owasanjilana nabashianje okhwira omwami wanje; ne oweera bano bosi niwina? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.9",
            "verseOrgIds": [
              "2KI.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manye mbu shililakwa hasi likhuwa liosi eliokhumakhuwa kOMWAMI, aka OMWAMI yaboola khubeinzu yaAhabu ta; okhuba OMWAMI akholile akeenako aka yasunga mumunwa kwomusumbawe Eliya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.10",
            "verseOrgIds": [
              "2KI.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa Yehu yeera bosi abali nibasikaale khubomunzu yaAhabu muYezereeli, nabakhulundube bosi, nabeetsabe, nabakuhanibe, okhuula olwa aramuleshela omundu kata mulala ta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.11",
            "verseOrgIds": [
              "2KI.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.11",
            "verseOrgIds": [
              "2KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana narula niyeenyokha, natsia eSamaria. Ne olwa yali nali eBetsi-ekedi yabaayi, khunjila, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.12",
            "verseOrgIds": [
              "2KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu yabukaana nabaana babwe Ahazia omuruchi waYuda, nabareeba mbu Ninywe beena? Nibakalusia mbu Nifwe abaana babwe Ahazia; khwitsile okhushiesia abaana bomuruchi nende abaana bomukhaye nyinamwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.13",
            "verseOrgIds": [
              "2KI.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ari Mubayile nibali mwoyo. Nibabayila nibali mwoyo, nibabeerela heetikho lieBetsi-ekedi, abandu amakhumi kane nababili; kata shiyalekha omundu yesi khubo ta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.14",
            "verseOrgIds": [
              "2KI.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.14",
            "verseOrgIds": [
              "2KI.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa yali narulileyo, yabukaana nende Yehonadabu waRekhabu, niyeetsanga okhumwakaanila; namushiesia, namureeba mbu Omwoyokwo kuli habwene khwisie, shinga omwoyo kwanje olwa kuli khwiwe, noho? Yehonadabu nakalusia mbu Kuli kurio. Naye Yehu ari Nikuli kurio, kho leera omukhonokwo. Nayila omukhonokwe, naye namuniinia mwikaarilie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.15",
            "verseOrgIds": [
              "2KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Khutsie ninawe, olole imbalikha eya endi ninayo khulwa OMWAMI. Kho nibamuniinia mwikaarilie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.16",
            "verseOrgIds": [
              "2KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali niyoolile eSamaria, yeera bosi abali nibashimusikalila Ahabu muSamaria, okhuula olwa yali nabasishiliye elala, likhuwa liOMWAMI shinga olwa liali elia yaboolela Eliya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.17",
            "verseOrgIds": [
              "2KI.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehu yaakamia obwinamilwi bwaBaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.17",
            "verseOrgIds": [
              "2KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehu nakhung'aasia abandu bosi halala, nabasunjila mbu Ahabu yakhalabanila Baali hatuutu; ne Yehu alamukhalabanila muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.18",
            "verseOrgIds": [
              "2KI.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano munanjile abanabii bosi baBaali, nabeenamilibe bosi, nabakuhanibe bosi; omundu yesi arachweya okhubaho ta; okhuba endi nomusango omukhongo okhumalila Baali; omundu yesi ouchweya shialaba mwoyo ta. Nebutswa Yehu yali nakhola mubuchesichesi mbu atibie abeenamili baBaali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.19",
            "verseOrgIds": [
              "2KI.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehu nalaka mbu Mwahulile Baali omukhung'aano kwoluyali. Nibakhupa omulome bario. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.20",
            "verseOrgIds": [
              "2KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu narumanila muIsiraeli yosi; nabo abeenamilanga Baali bosi nibeetsa, okhuula olwa aratong'a omundu yesi oureetsile ta. Nibeenjila munzu yaBaali; inzu yaBaali niyiitsula okhurula eyi okhuula eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.21",
            "verseOrgIds": [
              "2KI.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana naboolela oyo owali nasinjililanga ebiifwalo, ari Rusia ebiifwalo biabeenamili baBaali bosi. Naye nabarusilia ebiifwalo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.22",
            "verseOrgIds": [
              "2KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yehu natsia, halala nende Yehonadabu waRekhabu, nibeenjila munzu yaBaali; nabiila abeenamili baBaali abo ari Khaabe, mulole, aleshe okhubaho mwinywe hano omundu yesi owokhubasumba bOMWAMI, habula abeenamili baBaali bonyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.23",
            "verseOrgIds": [
              "2KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyeenjila okhumala emisango, nemisango emisambe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.24",
            "verseOrgIds": [
              "2KI.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yehu yali narecheeshe abandu amakhumi munaane elwanyi, nalaka mbu Omundu yesi oufuchiilila mulala owokhu abo aba ndalaleera mumakhono keenywe mbu yeehonokoshe, obulamubwe bulaba mushilenje shiobubwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.24",
            "verseOrgIds": [
              "2KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali niyakhamala omusango omusambe, Yehu yasunjila abalindi nabaseesia ari Mwinjile, mubeere; omundu yesi aleshe okhurulamwo. Nibabarema netsinganga; mana abalindi nabaseesia nibabasukuna elwanyi, nibeenjila mushisika shiomukari munzu yaBaali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.25",
            "verseOrgIds": [
              "2KI.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibarusiamwo isiilo isongokhu eyali niyili munzu yaBaali, nibachisamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.26",
            "verseOrgIds": [
              "2KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalikulula isiilo yaBaali, nibalikulula inzu yaBaali, nibachikwisia ichoo, okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.27",
            "verseOrgIds": [
              "2KI.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.27",
            "verseOrgIds": [
              "2KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa Yehu yaakamia Baali muIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.28",
            "verseOrgIds": [
              "2KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Yehu shiyashiukhana okhurula mubionoono biaYeroboamu waNebati, ebiachila Isiraeli niyonoona, nibio ebimoosi bieitsahaabu tsana ebiali muBeteli khandi muDani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.29",
            "verseOrgIds": [
              "2KI.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Yehu ari Okhuba wakholile bulayi, nokhola akali habwene mumoni tsianje, nokholela inzu yaAhabu kosi zkali mumwoyo kwanje shinga olwa kali, niko akachila abaanabo abolwibulo lwakhane baliikhala khushifumbi shioburuchi eshiaIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.30",
            "verseOrgIds": [
              "2KI.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Yehu shiyayeeyila kahala okhuchenda mu malako kOMWAMI, Nyasaye waIsiraeli, nomwoyokwe kwosi ta; shiyashiukhana okhurula mubionoono biaYeroboamu, ebiachila Isiraeli niyonoona, tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
