        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio OMWAMI yachaaka okhukhalakakhwo ebitonye bieshialo shiaIsiraeli; naye Hazaeli yabahula mumbali tsiosi tsiaIsiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhurula eYorodani khulubeka Iwebukwe, eshialo shiosi shiaGileadi, nabaGadi, nabaReubeni, nabaManase, okhurula eAroeri, elili ahambi nelibanda liaArinoni, mbu Gileadi naBashani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaYehu, nende kosi aka yakhola, nakobululubwe bwosi, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.34",
            "verseOrgIds": [
              "2KI.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehu nakona nalonda khubakuukanyene; nibamuyabila eSamaria. Naye Yehoahazi omwanawe naruka mushilenjeshie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.35",
            "verseOrgIds": [
              "2KI.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshise eshia Yehu yaruchila Isiraeli muSamaria shiali shiemiyika amakhumi kabili namunaane.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.36",
            "verseOrgIds": [
              "2KI.10.36"
            ]
          }
        }
