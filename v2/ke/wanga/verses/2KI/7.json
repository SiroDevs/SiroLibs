    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha nasunga mbu Hulile likhuwa liOMWAMI; mbu Mukamba, khusaa shinga yino, eshichelo shilala shiobusie obunyushe shilakusibwa ishekeli, nebichelo bibili bieishayiri ishekeli, haluyia lwaSamaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuseesia owa omuruchi yali niyeesiililanga khumukhonokwe nakalusia omundu waNyasaye tsana, nasunga mbu Lola, kata OMWAMI niyakhakhola amatirisha mwikulu, likhuwa elo liakhanyalikha noho? Naye nakalusia mbu Lola, olalola netsimonitsio, ne shiolaliakhwo ta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bali nibaliho abandu bane abobuchele habwinjililo bwoluyia; nibaboolelana abeene bari Nishiina eshichilanga nikhwikhala hano okhuula olwa khulaba nikhufwa? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.3",
            "verseOrgIds": [
              "2KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhuba nikhusunga mbu Khwinjile mwitookho; inzala yili mwitookho, ne khwakhafwilamwo; ne nikhuba nikhwikhala butswa hano, khandi khwakhafwa khurio. Chende khutsie, khukwile ebuneehe liabaSiria; nibaba nibakhuhonokosia khube mwoyo, khulaba mwoyo; ne nibaba nibakhwira, khulafwa butswa khurio ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.4",
            "verseOrgIds": [
              "2KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mushiisiisie nibabuukha okhutsia enakambi yabaSiria; ne olwa bali niboolile khundulo weikambi yabaSiria, wole, shiyalimwo omundu yesi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.5",
            "verseOrgIds": [
              "2KI.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI yali nahulilisiye abaSiria obuyoka bwamakaari, nobuyoka bwetsifarasi, mbu obuyoka bwelihe likhongo. Nibaboolelana bari Lole, omuruchi waIsiraeli ukulile abaruchi babaHiti bakhuseere, nabaruchi babaMisiri, bakhukwile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.6",
            "verseOrgIds": [
              "2KI.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako nibabuukha nibeelukha mushiisiisie, nibalekha amaheema kabwe, netsifarasi, netsisishili, mbu ikambi yosi shinga olwa yali; nibeelukha okhuhonia obulamu bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.7",
            "verseOrgIds": [
              "2KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abobuchele abo bali niboolile khundulo weikambi, beenjila mwiheema lindi, nibalia, nibanywa, nibachinga tsifeetsa netsitsahaabu netsingubo, nibatsirusiamwo, nibatsia nibatsibisa; mana nibakalukha, nibeenjila mwiheema lindi, nibachinga ebindu khandi nibabirusiamwo, nibatsia nibabibisa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.8",
            "verseOrgIds": [
              "2KI.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.8",
            "verseOrgIds": [
              "2KI.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibaboolelana bari Shikhukhola bulayi ta; inyanga yino neinyanga yamakhuwa amalayi, neefu nikhuholeelile butswa. Nikhuba nikhushinda okhuula olwa bushia mutsuli, obukuumwi bulakhunyoolelesia. Kho bulaano chende khutsie, khuboolele abeitookho yomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.9",
            "verseOrgIds": [
              "2KI.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibatsia, nibalanjilisia abalindi beshilibwa shielitookho; nibababoolela bari Khutsiile enakambi yabaSiria, nikhunyoola omundu yesi naralimwo ta, kata oluyoka Iwomundu, habula tsifarasi nitsiboyilwe, netsisishili nitsiboyilwe, namaheema shinga olwa kabeetsanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.10",
            "verseOrgIds": [
              "2KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abalindi tsana beshilibwa nibalanjisia; amakhuwa ako nikaboolelwa abeitookho yomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.11",
            "verseOrgIds": [
              "2KI.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi naye nabuukha mushilo, nasunjila abasumbabe mbu Emuboolele aka abaSiria bakhukholeele. Bamanyile shinga olwa khuli munzala; kho barulile mukambi nibatsia okhwibisa ebulafu, nibasunga bari Olwa balaba nibarula mwitookho khulabahamba nibali mwoyo, khwinjile mwitookho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.12",
            "verseOrgIds": [
              "2KI.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mulala khubasumbabe nakalusia nasunga mbu Chama abandi babukule tsiraano etsiokhufarasi etsishisikaale; okhuba abo abatong'ile muno balaba shinga omukanda kwosi kwabaIsiraeli abasishile pe; khurumeyo khulole. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.13",
            "verseOrgIds": [
              "2KI.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibabukula abandu babili abachendela khufarasi; omuruchi nabaruma okhulondakhwo inyuma welihe liabaSiria, ari Tsie mulole. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.14",
            "verseOrgIds": [
              "2KI.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibabalondakhwo okhuula khuYorodani; ne ngako, injila yosi yali niyiitsuulekhwo tsingubo nebimanulwa, ebia abaSiria bali nibasukuune khulwa okhutetekhana khwabwe. Abarume abo nibakalukha, nibamuboolela omuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.15",
            "verseOrgIds": [
              "2KI.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.15",
            "verseOrgIds": [
              "2KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu nibarula, nibayaaya ikambi yabaSiria. Ne nilwo olwa eshichelo shiobusie obunyushe shiakusibwa ishekeli, nebichelo bibili bieishayiri ishekeli, likhuwa liOMWAMI shinga olwa liali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.16",
            "verseOrgIds": [
              "2KI.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi yali nareeleho omuseesia oyo owa yali niyeesiililanga khumukhonokwe, okhusinjilila akeshilibwa; ne abandu bamuseenela mushilibwa, nafwa, shinga omundu waNyasaye olwa yali nasunjile olwa omuruchi yakholomokha namwitsila. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.17",
            "verseOrgIds": [
              "2KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikeekhola kario, shinga omundu waNyasaye olwa yali nasunjiile omuruchi, ari Ishayiri ebichelo bibili ishekeli, nobusie obunyushe eshichelo shilala ishekeli, nolwa kalaba mukamba khusaa shinga yino muluyia lwaSamaria; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.18",
            "verseOrgIds": [
              "2KI.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuseesia tsana olwa yakalusia omundu waNyasaye nasunga mbu Bulaano lola, kata OMWAMI niyakhakhola amatirisha mwikulu, likhuwa elo liakhanyalikha noho? Naya nakalu mbu Lola, olalola netsimonitsio, ne shiolaliakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.19",
            "verseOrgIds": [
              "2KI.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikamwikholela kario; okhuba aban bamuseenela mushilibwa; naye nafwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.20",
            "verseOrgIds": [
              "2KI.7.20"
            ]
          }
        }
      ]
    }
