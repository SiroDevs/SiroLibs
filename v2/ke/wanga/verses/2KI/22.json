    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AkaYosia, nesilitabu shiamalako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia yali owemiyika munaane olwa yachaaka okhuruka; ne yaruchila muYerusalemu emiyika amakhumi kataru namulala; ne eliira lianyina liali Yedida waAdaya oweBozekatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.1",
            "verseOrgIds": [
              "2KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amalayi mumoni tsiOMWAMI, nachenda khunjila yosi yaDaudi kuukanyene, nareebela khumukhono musaatsa kata omukhasi ta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumuyika kwekhumi namunaane kwomuruchi Yosia, omuruchi yaruma Shafani waAzalia waMeshulamu, omuhandiichi, enanzu yOMWAMI, ari ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.3",
            "verseOrgIds": [
              "2KI.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikulukha otsie ewaHilikia omukuhani omukhulundu, mbu abasie amapeesa akaleerungwa munzu yOMWAMI, aka abalindi bomuliango baba nibasololanga mubandu; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.4",
            "verseOrgIds": [
              "2KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana bakakaame mumakhono kabakholi bemilimo abasinjililanga akeinzu yOMWAMI; nabo babaheelesie abakholi bemilimo abali munzu yOMWAMI, okhukasia ahaba nihabiiyile khunzu; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.5",
            "verseOrgIds": [
              "2KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu ababaatsi, naboombashi, nende aboombashilanga amachina; khandi khulwa okhukula emisaala namachina amabaatse okhukasia inzu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.6",
            "verseOrgIds": [
              "2KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa baleshe okhubasia ninabo amapeesa akahaanwa mumakhono kabwe ta; okhuba bo bakholanga nobwisiikwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Hilikia omukuhani omukhulundu nasunjila Shafani omuhandiichi ari Ndakhanyoola eshitabu shiamalako munzu yOMWAMI Hilikia naheelesia Shafani eshitabu tsana, naye nashisooma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Shafani omuhandiichi natsia ewomuruchi, nakalusilia omuruchi likhuwa, ari Abasumbabo batsushile amapeesa kosi akanyoolwa munzu, nibakahaana mumakhono kabakholi bemilimo abasinjililanga inzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.9",
            "verseOrgIds": [
              "2KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Shafani omuhandiichi naboolela omuruchi ari Hilikia omukuhani yambeelesiye eshitabu. Mana Shafani nashisooma imbeli womuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omuruchi yahulila amakhuwa akali mushitabu shiamalako, yarandula tsingubotsie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nalaka Hilikia omukuhani, naAhikamu waShafani, naAkhibori waMikaya, naShafani omuhandiichi, naAsaya omusumba womuruchi, ari ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsie, mureebe ewOMWAMI, khulwanje khandi khulwa abandu, khandi khulwa Yuda yosi, akamakhuwa keshitabu shino eshinyooleeshe; okhuba oburima bwOMWAMI obwashile khwifwe nobunji, shichila abakuuka beefwe shibahulilanga amakhuwa keshitabu shino, okhukhola kosi akahandiikwa khwifwe shinga olwa kali, ta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Hilikia omukuhani, naAhikamu, naAkhibori, naShafani, naAsaya, nibatsia ewaHulida omunabii, mukha Shalumu waTikiwa, waHarihasi, omulindi wetsingubo; ne omukhasi oyo yali niyamenya eYerusalemu, mulukongo lwakhabili; nibasungana ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.14",
            "verseOrgIds": [
              "2KI.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabasunjila mbu Kano niko aka OMWAMI, Nyasaye waIsiraeli, aboola; mbu Boolele omundu oyo oumurumile mbu ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.15",
            "verseOrgIds": [
              "2KI.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI aboola; mbu Lola, endi okhuleerela habundu hano amabii, nokhubamenyangaho, mbu amakhuwa kosi akomushitabu eshia omuruchi waYuda asoomile; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.16",
            "verseOrgIds": [
              "2KI.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila bandekha, nibasambila abanyasaye bandi amalesi kelibuuliesi, mbu basinyisie ne-bikhole biosi biamakhono kabwe; niko akachila oburima bwanje nibwashila habundu hano, kata shibulasimibwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.17",
            "verseOrgIds": [
              "2KI.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumuruchi waYuda oumurumile okhureeba ewOMWAMI, mumusunjile mbu Kano niko aka OMWAMI, Nyasaye walsiraeli, aboola; mbu Khumakhuwa ako aka ohuliile, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.18",
            "verseOrgIds": [
              "2KI.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba omwoyokwo kubeele nikutorile, nawe niwituutuyia imbeli wOMWAMI olwa ohuliile aka ndasunga khukahabundu hano, nokhukabamenyangaho, mbu hakhakwa likunda khandi linyeko; norandula tsingubotsio nolila imbeli wanje; nasi ekhuhuliile, nolwa OMWAMI aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.19",
            "verseOrgIds": [
              "2KI.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, lola, ndalakhuyila ewabakuukabo, ne olayilwa khung'aniyo mumulembe; kata tsimonitsio shitsilalola amabii kosi aka ndilileerela habundu hano ta. Kho nibakalusilia omuruchi likhuwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.20",
            "verseOrgIds": [
              "2KI.22.20"
            ]
          }
        }
      ]
    }
