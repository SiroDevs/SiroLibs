    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaAmazia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwakhabili kwaYoashi waYoahazi omuruchi waIsiraeli, Amazia waYoashi omuruchi waYuda yachaaka okhuruka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
            "verseOrgIds": [
              "2KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali owemiyika amakhumi kabili nachiraano olwa yachaaka okhuruka; naruchila emiyika amakhumi kabili nashienda muYerusalemu; ne eliira lianyina liali Yehoadini oweYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.2",
            "verseOrgIds": [
              "2KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhola akali amalayi mumoni tsiOMWAMI, habula shiyakhola okhuhela nende Daudi kuukanyene ta; ne yakhola kosi akaYoashi samwana yali nakholanga shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula habundu aheechingu hosi shiharusibwaho ta; abandu bali nibashimalilanga emisango nibasambila amalesi kelibuuliesi habundu aheechingu tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa oburuchi bwali nibwakhatinyisilibwa mumukhonokwe, yeera abasumba abo abali nibeera omuruchi samwana; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.5",
            "verseOrgIds": [
              "2KI.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa abaana babeeri abo shiyabeera ta; shinga olwa kahandiikwa mushitabu shiemalako kaMusa, shinga OMWAMI olwa yalaka, mbu Basamwana baleshe okhwirwa khulwa akabaana babwe, kata abaana okhwirwa khulwa akabasamwana; nebutswa buli mundu afwe khulwa eshionoono shishie omwene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeerela abaEdomu ebikhumila ekhumi mwibanda liomuunyu, naseera Sela nalibukula, nalikulikha eliira mbu Yoketseeli; ne lishilangwa lirio okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Amazia naruma abarume ewaYehoashi waYehoahazi waYehu, omuruchi walsiraeli, ari Yitsa, khulolane mumoni nomumoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.8",
            "verseOrgIds": [
              "2KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yehoashi omuruchi waIsiraeli nakhupila Amazia omuruchi waYuda omunwa, ari Eshisisia eshiomuLebanoni shiaselela ewomusiita okwomuLebanoni, shiri Obashile omusiani wanje omukhaanawonebutswa isolo inabulimo eyomuLebanoni yabira, niyiseenela eshisisia hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.9",
            "verseOrgIds": [
              "2KI.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto, iwe okhupile Edomu, omwoyokwo nikukhuchinjimisia. Kho wisunje orio khulwa oluyalilwo, niwikhala hangookhuba nishiina eshiakhachila niwileerela amasila, mana nokwa, iwe halala nende Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Amazia yaloba okhuhulila. Kho Yehoashi omuruchi waIsiraeli natikulukha natsia-yo; mana ye nende Amazia omuruchi waYuda nibahengana mumoni nomumoni mwihe eBetsi-shemeshi, elili liaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.11",
            "verseOrgIds": [
              "2KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yuda yahulwa nende Isiraeli; nibeelukha nibatsia buli mundu ebunango. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.12",
            "verseOrgIds": [
              "2KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yehoashi omuruchi waIsiraeli nahamba Amazia omuruchi waYuda, omwana waYehoashi waAhazia, eBetsishemeshi, niyoola eYerusalemu, nalikulula olukoba lwaYerusalemu, okhurula khushilibwa shiaEferaimu okhuula khushilibwa eshiali khukoona, oburambi bwamakhono ebikhumi bine. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.13",
            "verseOrgIds": [
              "2KI.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukula nende itsahaabu neifeetsa yosi, nebimanulwa biosi ebianyoolekha munzu yOMWAMI, nomumabiishilo akomunzu yomuruchi, khandi nende abandu aba yahamba babe omusingo, nakalukha eSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaYehoashi aka yakhola, nakobululubwe, khandi shinga olwa yalasana nende Amazia omuruchi waYuda, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehoashi nakona nalonda khubakuukanyene, nayabilwa eSamaria halala nabaruchi baIsiraeli; naye Yeroboamu omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.16",
            "verseOrgIds": [
              "2KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.16",
            "verseOrgIds": [
              "2KI.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Amazia waYoashi, omuruchi waYuda, yamala emiyika ekhumi nachiraano inyuma wokhufwa khwaYehoashi waYehoahazi, omuruchi waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.17",
            "verseOrgIds": [
              "2KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaAmazia shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baYuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.18",
            "verseOrgIds": [
              "2KI.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu nibamukhobanila eYerusalemu; naye niyeelukha natsia eLakhishi; nebutswa baruma abandu okhumulonda okhuula eLakhishi, nibamwirilayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.19",
            "verseOrgIds": [
              "2KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuchinjila khufarasi; naye nayabilwa eYerusalemu halala nabakuukanyene mwitookho liaDaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.20",
            "verseOrgIds": [
              "2KI.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaYuda bosi nibabukula Azarial, owali nali owemiyika ekhumi nachisasaba, nibamwemekha abe omuruchi mushilenje shiasamwana, Amazia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.21",
            "verseOrgIds": [
              "2KI.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yoombakha Elatsi, nalikalusilia Yuda, olwa omuruchi yali nakonile nalonda khubakuukanyene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaYeroboamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwekhumi nakharaano kwaAmazia waYoashi, omuruchi waYuda, Yeroboamu waYoashi, omuruchi waIsiraeli, yachaaka okhuruchila muSamaria, naruka emiyika amakhumi kane namulala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI; shiyarula mubionoono biosi biaYeroboamu waNebati, ebiachila Isiraeli niyonoona, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakalusia olwakho lwaIsiraeli aha lwalinji, okhurula khubwinjililo bwaHamatsi okhuula khunyanza yaAraba likhuwa liOMWAMl Nyasaye waIsiraeli, shinga oiwa liali, elia yasunga mumunwa kwomusumbawe, Yona waAmitai omunabii, owali weGatsi-heferi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI yalola obusandibwi bwaIsiraeli, shinga olwa bwali obululu muno; okhuba shiyaliho omundu yesi, kata omubohe kata omulekhuule, kata shiyaliho omuhabini yesi khulwa Isiraeli ta. ",
          "type": "text",
