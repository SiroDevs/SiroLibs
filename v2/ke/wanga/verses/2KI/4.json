  "bookId": "2KI",
  "reference": "2 Abaruchi 4",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "2KI 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amafura homukhasi omulekhwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho omukhasi undi owokhubakhasi babaana babanabii yahaabila Elisha, ari Omusumbawo omusaatsa wanje wafwa; nawe omanyile akomusumbawo shinga olwa yali nariitsanga OMWAMI; ne bulaano omwikobiwe witsile okhubukula abaana banje babili babe abasumba ababohe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.1",
            "verseOrgIds": [
              "2KI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha namusunjila mbu Nekhukholele shiina? Mboolela, ebia oli ninabio munzu nishiina? Naye ari Isie omukholiwo shindikhwo neshindu shiosi ta, habula ichupa eyilimwo amafura. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.2",
            "verseOrgIds": [
              "2KI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho namubiila mbu Tsia hosi hosi, osabe khubamenyanibo ebiokhutayilamwo, mbu ebiokhutayilamwo ebikhaya; bibe ebinji. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.3",
            "verseOrgIds": [
              "2KI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana winjile, wiyikalilemwo nende abaanabo, okatsushe mubitayilo ebio biosi; shilala nishiitsuule, oshireetsenje elubeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.4",
            "verseOrgIds": [
              "2KI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yamurulakhwo, niyeeyikalilamwo nende abaanabe; nibamuleerelanga ebitayilo, naye nakatsukha butsukha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.5",
            "verseOrgIds": [
              "2KI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa ebitayilo biali nibiitsuule pe, yasunjila omwanawe mbu Ndeerela eshitayilo shindi. Naye nakalusia mbu Eshitayilo shindi shibulaho. Mana amafura nikakhalikha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.6",
            "verseOrgIds": [
              "2KI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yatsia naboolela omundu waNyasaye tsana. Naye namusunjila mbu Tsia okusie amafura, orunje likobilio, mana iwe nabaanabo muliitsenje khukatong'a.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.7",
            "verseOrgIds": [
              "2KI.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elisha nende omukhasi omuShunamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.7",
            "verseOrgIds": [
              "2KI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyanga yindi Elisha yabira natsia eShunemu, ewa omukhaye undi owoluyali yamenya; naye namunichilisia okhuliakhwo ebiliibwa. Mana buli olwa yabirangayo lwosi, yakotolelangayo okhulia ebiliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.8",
            "verseOrgIds": [
              "2KI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhasi oyo nasunjila omusaatsawe ari Enduutsi mbu omundu uno oubiranga khatsotselo nomutakatifu waNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.9",
            "verseOrgIds": [
              "2KI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chama khukhole akhasika khushilama akhali nelisiisi, khumureelemwo eshitali, neimeesa, neshisaala, neitaha; mana olwa aleetsanga eweefwe, akotole yeenjile mubwenomwo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.10",
            "verseOrgIds": [
              "2KI.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.10",
            "verseOrgIds": [
              "2KI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana inyanga yindi yoolayo, nakotola niyeenjila mushisika tsana, nakonamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.11",
            "verseOrgIds": [
              "2KI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaboolela Gehazi omusumbawe mbu Langa omuShunamu oyo. Nolwa yali namulanjile, yasinjila imbeliwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.12",
            "verseOrgIds": [
              "2KI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namusunjila Gehazi mbu Bulaano omuboolele ori Lola, okhulindile nokhunyakhanila muno; bulaano okholelwe shiina? Wenya okhureebelwa likhuwa ewomuruchi, kata ewomuseesia welihe? Omukhasi oyo nakalusia mbu Isie emenyanga mubandu beefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.13",
            "verseOrgIds": [
              "2KI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nareeba mbu Kho akholelwe shiina? Gehazi nakalusia mbu Mbula, shialikhwo nomwana yesi ta, ne omusaatsawe nomusaakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.14",
            "verseOrgIds": [
              "2KI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Mulanje. Ne olwa yali namulanjile, omukhasi tsana yasinjila mumuliango. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.15",
            "verseOrgIds": [
              "2KI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namusunjila mbu Khunduukho shinga yino, olwa yiloola khandi, witsa okhufumbeelela omwanawo omusiani. Naye ari 'A, tawe, omwami, omundu waNyasaye; orabeehela omukholiwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.16",
            "verseOrgIds": [
              "2KI.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhasi oyo nahela inda, niyeebula omwana omusiani khunduukho eyo olwa yali niyulile, shinga Elisha olwa yali niyamusunjila.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.17",
            "verseOrgIds": [
              "2KI.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.17",
            "verseOrgIds": [
              "2KI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omwana yali nakhulile, inyanga yindi yatsia nende samwana ewa abachesi bali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.18",
            "verseOrgIds": [
              "2KI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunjila samwana ari Mawe, omurwe kwanje, omurwe kwanje! Naye nasunjila omusumbawe mbu Muchinje, omuyile ewa nyina ali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.19",
            "verseOrgIds": [
              "2KI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali namubukuule namuyilile ewa nyina, omwana yeekhala khumakuluke okhuula khusaa yeshiteere, mana nafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.20",
            "verseOrgIds": [
              "2KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naniina, namukonia khushitali shiomundu waNyasaye, namwikalilamwo, narulayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.21",
            "verseOrgIds": [
              "2KI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalanga omusaatsawe, ari Chama urumile mulala khubasumba nende ndala khutsisishili, enzie tsimbilo ewomundu waNyasaye nende okhukalukha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.22",
            "verseOrgIds": [
              "2KI.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namureeba ari Ne omutsiila leelo mbushiina? Shikhuli okhuchaaka khwomwesi, kata isabato ta. Naye ari Lekha kabe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.23",
            "verseOrgIds": [
              "2KI.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyaala ebiokhwikhalakhwo khusishili, nasunjila omusumbawe ari Ochiilusie; orachifuchiilile yitsie kahala khulwanje ta, habula nikhulachile endio. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.24",
            "verseOrgIds": [
              "2KI.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho natsia ario, niyoola ewomundu waNyasaye hashikulu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.25",
            "verseOrgIds": [
              "2KI.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omundu waNyasaye tsana yamulola nashili ehale, yasunjila Gehazi omusumbawe mbu Lola, omuShunamu ngwowulia; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.25",
            "verseOrgIds": [
              "2KI.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "chama wilushe omwakaanile, omureebe mbu Oli bulayi? Omusaatsawo ali bulayi? Omwanawo ali bulayi? Naye ari Namalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.26",
            "verseOrgIds": [
              "2KI.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yoola ewa omundu waNyasaye yali, hashikulu, yatiila ebilenjebie. Naye Gehazi nasita ahambi okhumusindikha aruleho; habula omundu waNyasaye nasunga mbu Lekha abe; omwoyokwe kuyiile mushilifu; ne OMWAMI yambisiile, kata shiyambooleele ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.27",
            "verseOrgIds": [
              "2KI.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhasi nasunga mbu Omwami, isie ndakhusaba omwana noho? Shindasunga mbu Orangaatia ta? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.28",
            "verseOrgIds": [
              "2KI.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu waNyasaye nalaka Gehazi mbu Wibohele tsingubotsio mushishienje, obukule omutiichilo kwanje mumukhono, otsie butsia, noba nobukaana nomundu yesi, oramushiesia ta; kata oundi nakhushiesia, oramukalusiamwo ta; ne okonie omutiichilo kwanje khumwana mubweni ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.29",
            "verseOrgIds": [
              "2KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nyinamwana omwana namusunjila mbu Shinga OMWAMI olwa ali mwoyo, khandi shinga iwe olwa oli mwoyo, shikhulekha ta. Kho yarula namulondakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.30",
            "verseOrgIds": [
              "2KI.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Gehazi nabira nabaranjiliile, nakonia omutiichilo khumwana mubweni; ne shikwaliho omwoyo, kata likalusio liosi ta. Iiho yakalukha okhumwakaanila, namuboolela mbu Omwana shiasisimuushekhwo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.31",
            "verseOrgIds": [
              "2KI.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.31",
            "verseOrgIds": [
              "2KI.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Elisha yali niyeenjiile munzu, lola, omwana nomufu, nakoniibwe khushitaalishie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.32",
            "verseOrgIds": [
              "2KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yeenjila niyeeyikalilamwo nende omwana, nasaaya OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.33",
            "verseOrgIds": [
              "2KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naniina khushitali, nakona khumwana, nara omunwakwe khumunwa kukwe, netsimonitsie khumoni tsitsie, namakhonoke khumakhono keke; niyeelambisia khuye; mana omubili kwomwana nikuchaaka okhutunduma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.34",
            "verseOrgIds": [
              "2KI.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yakalukha nachenda lulala munzu, eyi nende eyi; mana natsia, niyeelambisia khuye; omwana niyaasamula okhuula musaafu, mana omwana natimbula tsimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.35",
            "verseOrgIds": [
              "2KI.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nalanga Gehazi, nasunga mbu Langa omuShunamu oyo. Naye namulanga. Ne olwa yali niyeenjiile ewa yali, yamubiila mbu Bukula omwanawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.36",
            "verseOrgIds": [
              "2KI.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niyeenjila, niyeekhupa hasi hamakuluke, niyeenama hasi; mana nabukula omwanawe, narula.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.37",
            "verseOrgIds": [
              "2KI.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elisha yakholela abanabii akamakana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.37",
            "verseOrgIds": [
              "2KI.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Elisha nakalukha eGiligali; ne inzala yaliho mushialo; nabo abaana babanabii bali nibeekhaale imbeliwe; naye naboolela omusumbawe mbu Rakhwo inyungu ikhongo, oteeshele abaana babanabii ebiliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.38",
            "verseOrgIds": [
              "2KI.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho oundi yarula natsia mubulimo okhwaha eliani, nanyoola lisebebe lindi, nanokakhwo amahondo kanabulimo, nikeetsula munguboye, niyeetsa nakakhalaka nakara munyungu; ne shibali nibakamanyile ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.39",
            "verseOrgIds": [
              "2KI.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibeenulila abandu abo. Ne olwa bali nibaliitsanga ebiliibwa tsana, balakaya, bari Mawe, iwe omundu waNyasaye! Oluumbe luli munyu ngu! Nibakhaywa okhulia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.40",
            "verseOrgIds": [
              "2KI.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasung mbu Khaleele obusie. Nabufuuba munyungu nasunga mbu Bulaano mwinulile abandu, balie Kata obubii bwabulamwo munyungu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2KI 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu undi yarula eBaali-shalisha, naleerela omundu waNyasaye oyo ebiokhulia biebirongoole, mbu emikaate chieishayiri amakhum kabili, neimele yebitere ebibisi, mwilkunialie. Elisha nasunga mbu Obaheelesie abandu balie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.42",
            "verseOrgIds": [
              "2KI.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2KI 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhalabaniwe nasunga mbu Mako, erenjeshe bino imbeli wabandu eshikhumi? Naye naboola mbu Obaheelesie abandu, balie; okhuba kano niko aka OMWAMI aboola, mbu Balalia, ne ebindi bilatong'a. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "2KI 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yabarenjeshela, nabo nibalia, ebindi nibitong'a, aka OMWAMI yaboola shinga olwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.44",
            "verseOrgIds": [
              "2KI.4.44"
            ]
          }
        }
      ]
    }
