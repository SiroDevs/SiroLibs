      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhukwisibwa khwaYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Zedekia yakholela omuruchi waBabeli induli. Mana mumuyika kwashienda kwoburuchibwe, mumwesi kwekhumi, khunyunga yekhumi eyomumuwesi okwo, Nebukadineza omuruchi waBabeli niyeetsa halala nelihelie liosi okhuseera Yerusalemu, nibakhupa ikambi yabwe imbeli walio; nibaswala ebituuli okhulibotokhana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho litookho lieekalilwa lirio okhuula khumuyika kwekhumi nalulala kwomuruchi Zedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yashienda eyomumwesi kwakhane inzala yali ikhongo muno mwitookho; kata shishialiho eshiokhulia shiosi khulwa abeshialo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana eshibanga shieekulwa mwitookho, naye omuruchi nabandube belihe nibeelukha mushilo, nibalonda khushilibwa eshiali hakari wetsingoba tsibili, ahambi nolwanyi lwomuruchi; ne abaKalidayo bali nibabotokhaane litookho; nibalonda khunjila yaAraba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa lihe liabaKalidayo lialondachila omuruchi, nibamunyoola khumihololookhwe chieYeriko lihelie liosi nilisalaasibwa nilimulekha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibamuhamba omuruchi, nibamuyila ewa omuruchi waBabeli yali, eRibila; naye namukhalachila eshiina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeera abaana baZedekia, omwene nalola; nibamufutula Zedekia tsimoni, nibamuboha nebitiili, nibamuyila eBabeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaYuda baatisibwa nibayilwa mubuhambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumwesi kwakharaano, khunyanga yomusaafu mumwesi, mumuyika kwekhumi nashienda kwomuruchi Nebukadineza, omuruchi waBabeli, Nebuzaradani omwimilisi wabasikari abalindi, omusumba womuruchi waBabeli, niyoola eYerusalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasamba inzu yOMWAMI, nende inzu yomuruchi; kata tsinzu tsiosi tsieYerusalemu, tsiosi etsiali tsikhongo, yatsisamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bosi abelihe liabaKalidayo aba omwimilisi wabasikari abalindi yali ninabo, balikulula olukoba lwaYerusalemu tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omusikalo kwabandu, abali nibatong'ile mwitookho, nende abeelushi, mbu abo abahunzukha nibeelushila omuruchi waBabeli, halala nende abomukanda abatong'a, Nebuzaradani omwimilisi wabasikari abalindi yabaatisia mushialo shiabwe nabayila. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula omwimilisi wabalindi tsana yalekha abandi abokhubashila obumanani mushialo, okhulinda emitsabibu nokhulima emikunda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsisiilo tsana tsiomukasa etsiali nitsili munzu yOMWAMI, nende obwala, neinyanza yomukasa, ebiali nibili munzu yOMWAMI, abaKalidayo babisasaka ebitonye ebitonye, nibayila omukasa kwabio eBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nende tsinyungu, nemiikho, namahana akokhusimilia omulilo, nebichiiko, nebimanulwa biosi biomukasa ebia beekhoonyelanga mubukhalabani, babiyila biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netsindaabo tsiomulilo, nebikaye; buli shindu eshiali shieitsahaabu, yabukula khulwa itsahaabu yashio, ne buli shindu eshiali shieifeetsa, yabukula khulwa ifeetsa yashio; omwimilisi wabasikari abalindi yabiyila biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio tsisiilo etsio tsibili, neinyanza ndala, nende obwala, ebia Sulemani yakholela inzu yOMWAMI, obusiro bwomukasa kwebimanulwa ebio biosi shibwachelekha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburambi bwabuli siilo bwali amakhono ekhumi namunaane, ne yalikhwo ingofia yomukasa; noburambi bweingofia bwali amakhono kataru; ingofia niyilikhwo eming'oono chietsikhanda namakomamanga tsimbeka tsiosi, biosi nibili biomukasa; nayo isiilo yakhabili niyili yirio, nende tsikhanda tsiayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwimilisi wabasikari abalindi yabukula Seraya omukuhani omukhulundu, naZefania omukuhani wakhabili, nabalindi bataru bomuliango; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhurula mwitookho yabukula omukal undi owali nasinjililanga abandu belihe, nende abandu baraano beshiina shiomuruchi abanyoolwa nibali mwitookho; nende omuhandiichi womuseesia welihe owakhung'aasinjia abeshialo; nende abandi amakhumi kasasaba abokhubandu beshialo abanyoolwa nibali mwitookho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani omwimilisi wabasikari abalindi nabahamba, nabayila ewomuruchi waBabeli eRibila. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi waBabeli nabakhupa, nabeerela eRibila mushialo shiaHamatsi. Nilwo olwa Yuda yaatisibwa mushialoshie nayilwa mubuhambe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abomusikalo beelushila eMisiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abandu abatong'a mushialo shiaYuda, aba Nebukadineza omuruchi waBabeli yalekha, yakhola Gedalia waAhikamu waShafani omukafuna oubaruka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaseesia bosi bamahe, halala nabandu babwe, bahulila mbu omuruchi waBabeli yali nakholile Gedalia abe omukafuna, batsia ewaGedalia eMisipa; abeene mbabano, mbu Ishimaeli waNetsania, naYohanani waKarea, naSeraya waTanihumetsi omuNetofa, naYaazania omwana womuMaaka, halala nende abandu babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Gedalia nabeetsubila, bo nende abandu babwe, ari Murariitsanga khulwa abaseesia babaKalidayo ta; menyenje mushialo, nimukhalabanila omuruchi waBabeli, mana mulaba bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mumwesi kwomusaafu Ishimaeli waNetsania waElishama, owali oweinzu yomuruchi, yeetsa nende abandu ekhumi nakhupa Gedalia, namwira, halala nabaYahudi nabaKalidayo aba yali ninabo eMisipa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu bosi, ari abatiiti ari abakhongo, nabaseesia bamahe, babuukha nibatsia eMisiri; okhuba baria abaKalidayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoyakhini yabohololwa naheebwa oluyali muBabeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
