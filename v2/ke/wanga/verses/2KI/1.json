        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaAhazia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma wokhufwa khwaAhabu, Moabu yakholela Isiraeli induli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.1",
            "verseOrgIds": [
              "2KI.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.1",
            "verseOrgIds": [
              "2KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Ahazia yakwila mwitirisha lieshisikashie shiahekulu eSamaria, mana nalwala; naruma abarume, nababiila mbu Tsie mureebele ewaBaalizebubu, nyasaye waEkeroni, nimba nindakhahone mubulwale buno. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne malaika wOMWAMI nasunjila Eliya omuTishibe mbu Rula, tikulukha otsie wakaane nabarume bomuruchi waSamaria, obareebe mbu Kali mbu Nyasaye abulhao muIsiraeli, akachila nimutsia okhureeba Baali-zebubu, yasaye waEkeroni? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano kano niko aka OMWAMI aboola; mbu Shioleekhakhwo okhurula khushitali eshia oniinilekhwo ta; okhufwa olafwa olafwa. Mana Eliya niyeenyokha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abarume tsana bamukalushila, naye nabareeba mbu Mukaluushe mbushiina? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamukalusia mbu Khwakaanile nomundu undi, nakhusunjila mbu Tsie, mukalushile omuruchi oumurumile, nimumuboolela muri Kano niko aka OMWAMI aboola; mbu Kali mbu Nyasaye abulaho muIsiraeli, akachila noruma okhureeba Baali-zebubu nyasaye waEkeroni? Khulwako, shioleekhakhwo okhurula khushitali eshia oniinilekhwo ta; okhufwa olafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabareeba mbu Afwanile arie, omundu oyo owa mwakaanile ninaye, namuboolela amakhuwa ako? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamukalusia mbu Abeele niyeefwalile ingubo yobwoya, nolukhoba mushishienje. Naye naboola mbu Kho ni Eliya, omuTishibe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi naruma omuseesia wabasikari amakhumi karaano ewa yali, halala namakhumi karaanobe tsana. Naye natikulukha namutsiila Eliya, namunyoola niyeekhaale khubutenje bweshikulu. Namusunjila mbu Iwe omundu waNyasaye, omuruchi asunjile mbu Yikha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya nakalusia, nasunjila omuseesia oyo wamakhumi karaano ari Nimba nindi omundu waNyasaye, omulilo kwishe okhurula mwikulu, kukhumale halala namakhumi karaanobo. Mana omulilo nikwikha okhurula mwikulu, nikumumala halala namakhumi karaanobe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omuruchi namurumila omuseesia undi wamakhumi karaano, halala namakhumi karaanobe. Namusunjila mbu Iwe omundu waNyasaye, kano niko aka omuruchi aboolile; mbu Yikha bwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya nakalusia nabasunjila mbu Nimba nindi omundu waNaysaye, omulilo kwishe okhurula mwikulu, kukhumale halala namakhumi karaanobo. Mana omulilo kwaNyasaye nikwikha okhurula mwikulu, nikumumala halala namakhumi karaanobe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omuruchi naruma omuseesia wamakhumi karaano owakhataru, halala namakhumi karaanobe. Naye omuseesia wamakhumi karaano owakhataru natikulukha, natsia nasikama amasikamo imbeli waEliya, namusaaya, namusunjila mbu E iwe omundu waNyasaye, ekhusaaya mbu obulamu bwanje nobulamu bwabasumbabo bano amakhumi karaano bube obwolukoosi mumonitsio. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.13",
            "verseOrgIds": [
              "2KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, omulilo kwishile nikurula mwikulu nikumala abaseesia bamakhumi karaano babili abambeli, halala nabandu babwe bamakhumi karaano; ne bulaano obulamu bwanje bube obwolukoosi mumonitsio. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.14",
            "verseOrgIds": [
              "2KI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika w nasunjila Eliya ari Kholomokha otsie ninaye; oramuria ta. Naye narula, nakholomokha natsia ninaye ewomuruchi, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "namusunjila mbu Kano niko aka OMWAMI aboola; mbu Waruma abarume okhureeba Baali-zebubu, nyasaye waEkeroni; khulwako shioleekhakhwo okhurula khushitali eshia oniinilekhwo ta; ne okhufwa olafwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        }
      ]
    },
