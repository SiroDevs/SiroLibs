          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yafwa ario, likhuwa liOMWAMI elia Eliya yaboola shinga olwa liali. Naye Yehoramu omwana wabwe nachaaka okhuruka mushilenjeshie, mumuyika kwakhabili kwaYehoramu waYehoshafati omuruchi waYuda, shichila Ahazia yabula omwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kosi kaAhazia aka yakhola, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.18",
            "verseOrgIds": [
              "2KI.1.18"
            ]
          }
        }
      ]
