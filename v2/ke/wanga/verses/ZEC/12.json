        "style": "s1"
      },
      "items": [
        {
          "text": "Yerusalemu lilihonibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusiiko omusitohu; mbu amakhuwa kOMWAMI khukaIsiraeli; mbu Kano niko aka OMWAMI aboola, oyo owabambula likulu, nakhupa eshialo omuse, nalonga iroho yomundu muye mukari; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Lole, ndalakwisia Yerusalemu eshikombe eshimeesinjia khumbia tsiosi tsiabandu ababotokhanaho; khandi shilaba khuYuda, mubwikalilwi bwaYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.2",
            "verseOrgIds": [
              "ZEC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunduukho eyo ndalakwisia Yerusalemu lichina lisitohu khumbia tsiabandu; bosi abalichinga balasaalila muno; nako amahanga kosi keshialo kalakhung'aana halala okhuliyinga. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.3",
            "verseOrgIds": [
              "ZEC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Khunduukho eyo ndalakoyaasia tsifarasi tsiosi, nindalusia bosi abachendela khutsio. Nebutswa ndalatimbula tsimoni khubeinzu yaYuda, olwa embofusia tsifarasi tsietsimbia tsiabandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abebilibwa biaYuda balasunga mumioyo chiabwe bari Abamenyanga muYerusalemu bali abamaani muMWAMI, omwene mahe, Nyasaye wabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunduukho eyo ndalakhola ebilibwa biaYuda bibe shinga oluchio Iwomulilo hakari wetsikhwi, kata shinga eshitseso shiomulilo hakari webinywa; bilamala abandu ababotokhanaho pe, khumukhono musaatsa nokhumukhasi; naye Yerusalemu alamenya khandi hawuwe, mbu eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI alaranjilila okhuhonia amaheema kaYuda, mbu oluyali Iweinzu yaDaudi noluyali lwabamenyanga muYerusalemu luleshe okhukaliyibwa okhuyomba olwaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunduukho eyo OMWAMI alashinga ingabo khubamenyanga muYerusalemu; kata ouba omuteshele mubo alaba shinga Daudi; nayo inzu yaDaudi yilaba shinga Nyasaye, shinga malaika wOMWAMI nabeemililanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khunyanga eyo ndalarakhwo omwoyo okhutibia amahanga kosi akeetsa okhuseera Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunzu yaDaudi, nokhubamenyanga muYerusalemu, ndalatsushiilila iroho yeshisa neyokhusaaya; balamuhenga oyo owa bafumira, nibamwikhuula, shinga owikhuula omwanawe omuteelwa; balamulilila obululu, shinga oulilila omwanawe omwikulanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunduukho eyo okhwikhuula khulabaho eYerusalemu, shinga okhwikhuula khwaHadadirimoni mumuhololookhwe kwaMegido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo shileekhuula, buli shilibwa khubwashio; abeshilibwa shieinzu yaDaudi khubwabwe, kata nende abakhasi babwe khubwabwe; abeshilibwa shieinzu yaNatsani khubwabwe, kata nende abakhasi babwe khubwabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeshilibwa shieinzu yaLawi khubwabwe, kata nende abakhasi babwe khubwabwe; abeshilibwa shiabaShimei khubwabwe, kata nende abakhasi babwe khubwabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabebilibwa biosi ebishitong'a, buli shilibwa khubwashio, kata nende abakhasi babwe khubwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
    }
