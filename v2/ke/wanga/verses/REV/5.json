              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.10",
            "verseOrgIds": [
              "REV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nihenga, nimbulila emioyo chiabamalaika abanji ababotokhana eshifumbi tsana, nende ebilimwoyo ebio nende abakofu; obunji bwabwe bali ebikhumila nebikhumila, ebirabalikha ta; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibalanjisia bosi, nomwoyo omukhongo, bari",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
