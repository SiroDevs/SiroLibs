    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwinamili obwomwikulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwamakhuwa ako ndahenga, nindola omuliango ngwokwo, nikwikukha mwikulu; nomwoyo okwo okwa ndali niranjiliile okhuhulila, okufwana shinga okwolwika, nikusunjila kuri Tikulukha witse hano, ne ndalakhumanyia akeenako akakhoyile okhwikhola olunyumakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho nimba muRoho; ne nindola eshifumbi shioburuchi shieshio, nishiliho mwikulu, oundi niyeekhaalekhwo; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne oyo owali niyeekhaalekhwo, okhulolekhakhwe khwali shinga lichina liayasepi, nende akiki; khandi olulindi lwabotokhana eshifumbi; ne noluhenga, lufwana shinga itsumaridi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ebifumbi bioburuchi amakhumi kabili nabine biabotokhana eshifumbi shioburuchi eshio; ne abakofu amakhumi kabili nabane bali nibeekhaalekhwo, nibeefwalile ebiifwalo ebilafu; khandi tsisimbi tsieitsahaabu tsiali khumirwe chiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhurula mushifumbi shioburuchi nimurulamwo tsimbenu, nende amayoosi, nende emikukumo. Khandi ebitseso biomulilo musaafu biali nibiakhanga imbeli weshifumbi shioburuchi; ne nibo Abaroho musaafu baNyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi hambeli weshifumbi hafwana shinga inyanza yeshihoo, eyeengana ibarafu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne hakari bwene, ebilimwoyo bine biabotokhana eshifumbi, ebieetsula tsimoni, imbeli khandi emukongo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshilimwoyo shiambeli shieengana italanyieshili; mwoyo shiakhabili shieengana eshimoosi; eshilimwoyo shiakhataru mumoni mwashio shinga omundu; eshilimwoyo shiakhane shieengana inditsu eyipulukha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio ebilimwoyo ebio bine, buli shilala shiali netsimbaha tsisasaba, khandi bieetsula tsimoni, ikulu nende mukari. Eshilo neshiteere bihonganga nibiimba, oburahuluukha ta, mbu",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli olwa ebilimwoyo ebio biamuheelesia oluyali neifuma nokhwishieela oyo owikhaale khushifumbi tsana, oyo oubeetsangamwoyo ebisoni nebisoni, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakofu abo amakhumi kabili nabane bakwitsanga mumakulu ka oyo owikhaale khushifumbi, nibamwinamila oubeetsanga; mwoyo ebisoni nebisoni, nibasukuna tsisimbi tsiabwe imbeli weshifumbi, nibeemba bari",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.10",
            "verseOrgIds": [
              "REV.4.10"
            ]
          }
        }
      ]
    }
  ],
