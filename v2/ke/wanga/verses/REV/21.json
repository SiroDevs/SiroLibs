{
  "id": "REV.21",
  "number": "21",
  "bookId": "REV",
  "reference": "Obufwimbuli 21",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
