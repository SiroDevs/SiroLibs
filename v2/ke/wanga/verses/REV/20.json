        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emiyika echio eshikhumila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ndalola malaika undi niyeekha okhurula mwikulu, nali neshibohololo shiobuko tsana, nende omunyololo omukhongo mumukhonokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.1",
            "verseOrgIds": [
              "REV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahamba okuyokha, inzokha eyo yakhale, niyo Ibilisi, khandi Setani; namuboha emiyika eshikhumila, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "namusukuna mubuko tsana, nabwikala, nabuboha ikulu, mbu arakaatia amahanga khandi ta, okhuula olwa emiyika echio eshikhumila chiakhaba nichihweele; mana olunyuma lwa ako aliba nakhoyile okhubohololwa eshisekhwo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nindola ebifumbi bioburuchi, nende abo abali nibeekhaalekhwo; nabo nibaheebwa bunyali okhuyaasia. Khandi nindola emioyo chia abo abali nibaremwa emirwe khulwa oburumbusi bwaYesu, khandi khulwa likhuwa liaNyasaye, nende echia abo abareenamiile isolo eyo kata eshifwanani shiayo ta, kata okhureebwakhwo eshimanyilo eshio khubweni bwabwe kata khushikalo shiomukhono ta; nabo nibalamukha, nibaruka halala nende Kristo emiyika eshikhumila. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.4",
            "verseOrgIds": [
              "REV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi abokhubafwa shibalamukha ta, okhuula olwa emiyika echio eshikhumila chiba nichihweele. Khuno nikhwo okhulamukha okhwambeli. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.5",
            "verseOrgIds": [
              "REV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi ousanjila khukhulamukha khwambeli noweikhabi, khandi nomutakatifu; okhufwa khwakhabili shikhuli nobunyali bwosi khubeenabo ta; nebutswa balaba abakuhani baNyasaye nende baKristo, nibaruka ninaye halala emiyika eshikhumila.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa emiyika echio eshikhumila chilaba nichihweele, Setani alabohololwa arule mumbohe; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.7",
            "verseOrgIds": [
              "REV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne alarula natsia okhukaatia amahanga akali mutsikoona tsine tiosi tsieshialo, banga Gogu nende Magogu, mbu bakhung'aane halala okhuseera lihe; nabo obunji bwabwe bwingana obunji bwomuyeshe kwokhulukuku Iweinyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.8",
            "verseOrgIds": [
              "REV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibatikulukha nibaama khububambalifu bwosi bweshialo, nibabotokhana ikambi yabatakatifu tsimbeka tsiosi, nende litookho elo liheelwaomulilo nakwo nikwikha okhurula mwikulu, nikubalia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.9",
            "verseOrgIds": [
              "REV.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Setani, owali nabakaatiye, nasukunwa munyanza eyo yomulilo namalesi keshiberiti, omwa isolo yosi nomunabii wobubeeyi bali; ne balasaalisibungwa eshilo neshiteere, ebisoni nebisoni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuyaasii oburula khushifumbi shioburuchi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ndalola eshifumbi shioburuchi eshilafu eshikhongo, nende oyo owali niyeekhaalekhwo, owa eshialo nende likulu biilukhanga imbeliwe nibikhama; kata habundu wabio shihatong'akhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindola abafwa, abakhongo nabatuutu bosi, nibasinjiile imbeli weshifumbi shiobuyaasii, ebitabu nabio nibibambulwa. Khandi eshitabu shindi nishibambulwa; nashio nishio eshiobulamu. Abafwa nabo nibayaasilibwa amakhuwa akali nikandiikwa mubitabu ebio, shinga ebikhole biabwe olwa bialinji. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.12",
            "verseOrgIds": [
              "REV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyanza nayo yalekhuula abafwa abali muyo; nabio oluumbe nende Makombe nibilekhuula abafwa abali mubio; nibayaasibwa, buli mundu ebikholebie shinga olwa bialinji. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.13",
            "verseOrgIds": [
              "REV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio oluumbe nende Makombe biasukunwa munyanza eyo yomulilo. Khuno nikhwo okhufwa khwakhabili, mbu inyanza eyo yomulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.14",
            "verseOrgIds": [
              "REV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu yesi ouranyoolekha niyahandiikwa mushitabu shiobulamu ta, yesi yasukunwa munyanza yomulilo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.15",
            "verseOrgIds": [
              "REV.20.15"
            ]
          }
        }
      ]
    }
  ],
