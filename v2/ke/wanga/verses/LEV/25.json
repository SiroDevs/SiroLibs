    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emiyika chieisabato, nende echieiyubile",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa mushikuhl shiaSinai, ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.1",
            "verseOrgIds": [
              "LEV.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli mbu Olwa mwinjila mushialo eshia emuheelesia, kho liloba libe neisabato yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emiyika chisasaba oraachenje omukundakwo, nemiyika chisasaba okhalilenje omukundakwo kwemitsabibu, nokhung'aasia ebiamo biachio; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.3",
            "verseOrgIds": [
              "LEV.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne omuyika kwomusaafu kulaba isabato yomuhongo khulwa liloba, isabato yOMWAMI; oraraakakhwo omukundakwo kata okhukhalila omukundakwo kwemitsabibu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikholo bielichesalio, ebiakhaba nibimela ebiene, orabifuna ta; kata tsinzabibu etsiomutsabibukwo okurakhaliilwe tawe, orabikhung'aasia ta; kube omuyika kwomuhongo khulwa liloba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.5",
            "verseOrgIds": [
              "LEV.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isabato yeliloba yilaba khulwa ebiliibwa khulweenywe; mbu khululwo omwene, khulwa omukholiwo omusaatsa nomukholiwo weshikhasi; khulwa omukholiwo ouhandiichilwe omushaara, khandi khulwa omucheniwo owa omenyakhwo ninaye; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.6",
            "verseOrgIds": [
              "LEV.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulwa emirukochio, khandi khulwa tsisolo etsili mushialoshio; ebiamo biashio biosi bilaba ebieenywe khulwa ebiliibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obale tsisabato tsiemiyika musaafu, mbu emiyika musaafu akhandi musaafu; natsio tsindaalo tsietsisabato musaafu tsiemiyika tsimubeele emiyika amakhumi kane nashienda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.8",
            "verseOrgIds": [
              "LEV.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana okhupe olwika olukhongo ebulafu khunyanga yel humi eyomumwesi kwomusaafu; khunyanga yeshitiso okhupe olwika ebulafu mushialoshio shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.9",
            "verseOrgIds": [
              "LEV.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mwahule omuyikn okwo kwamakhumi karaano, nimutswania akobulekhuule mushialo, khubamenyamwo bosi; kumubeele yubile; kho mulakalusilie buli mundu omwandukwe, khandi mukalusie buli mundu khubeinzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.10",
            "verseOrgIds": [
              "LEV.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuyika okwo kwamakhumi karaano ku lamubeela yubile; muraraakakhwo, kata okhufuna ebikholo ebiakhaba nibhnelile ebiene, kata okhukhung'aasia tsinzabibu etsiokhumitsabibu echio echirakhaliilwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.11",
            "verseOrgIds": [
              "LEV.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba niyubile; yimubeele indakatifu; mulaliitsanga ebiamo biayo ebirula mumukunda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kuno kwayubile mukalusilie buli mundu omwandukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.13",
            "verseOrgIds": [
              "LEV.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne noba nokusia owashio eshindu, kata okhukula mumukhono kwowashio, murabatsananga tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.14",
            "verseOrgIds": [
              "LEV.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "emiyika echilonda khuyubile shinga olwa chili, nolwa olakula khuwashio; ne emivika chielichesa shinga olwa chili, nolwa alakhukusia ario. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.15",
            "verseOrgIds": [
              "LEV.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emiyika nichili eminji, omeete obukusi; emiyika nichili emituutu, otuutuyie obukusi orio; shichila eshia akhukusia nishio obunji bwemiyika chielichesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.16",
            "verseOrgIds": [
              "LEV.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murabatsananga ta; ne oriitsenje Nyasayewo; okhuba isie nisie OMWAMI Nyasayewo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako mukholenje aka ndamulachilisia nimulinda akobukhalachi bwanje nimukakhola; kho mulamenya mushialo eshio shisale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.18",
            "verseOrgIds": [
              "LEV.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashio eshialo shilaama ebiamo bulayi, neenyu mulalia nimwikura, nimumenyayo shisale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.19",
            "verseOrgIds": [
              "LEV.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nimuba nimureeba mbu Khulakhalia shiina mumuvika kwomusaafu? Lola, shikhunyala okhuraaka, kata okhukhung'aasia lichesa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.20",
            "verseOrgIds": [
              "LEV.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndalalaka ikhabi yanje khwinywe mumuyika kwakhasasaba, nakwo kuleerikha okhushila, ebiamo ebihela emiyika chitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.21",
            "verseOrgIds": [
              "LEV.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwakhataru muraache, nimushiliitsanga imele eyabirila; okhuula khumuyika kwashienda, olwa imele yakwo yilacheswa, muliitsenje eyabirila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liloba shililakusilibwa elala, khulwa tsindaalo tsieinziayo, ta; okhuba liloba nelianje; okhuba muli abarende nabamenyibwa ninasi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.23",
            "verseOrgIds": [
              "LEV.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushialo shiosi eshili eskieenywe, mulafuchiililanga liloba okhununulwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana weenywe naba namanaane, nakusiakhwo emiandu, kho omuluyia ouli ahambi khuluyla lwabwe yeetse anunme oKweno okwa omwana wabwe aba nakusiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.25",
            "verseOrgIds": [
              "LEV.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu naba nabula nende oukununula, mar omwene namala nayindihala nanyoola ebihe okhukununula; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.26",
            "verseOrgIds": [
              "LEV.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho abale emiyika chiobl kusi bwakwo, nakalusia ebishilaasia ewomund tsana owa yakukusia; naye amukalusilie omwandukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.27",
            "verseOrgIds": [
              "LEV.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba naranyala okhunyoola eb hela okhukukalusilibwa ta, kho okwa yakus kutong'e nlumukhono kwa oyo owakukula okhuu khumuyika kwayubile; mana muyubile kul khuulwe, naye akalushe khumwandukwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu naba nakusia inzu eyokhumenyamwo eyili mwitaala liolukoba, kho mushise shiomuyika omulamba olunyuma Iwokhulkusia anyala okhuchinunula; omuyika omulamba abe nobunyali bwokhununula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.29",
            "verseOrgIds": [
              "LEV.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niyiba niyiranunulwa omuyika omulamba nikushili okhuhwa ta, kho inzu eyo eyili mwitaala liolukoba yimutinyisilibwe oyo owachikula inziayo, munzibulotsie tsiosi; shiyilalekhuulwa muyubile ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.30",
            "verseOrgIds": [
              "LEV.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula tsinzu etsiomubimenyo bindi ebirabotokhanwa nolukoba ta, tsibasibwe halala nemikunda chieshialo; tsinunulwe khandi tsilekhuulwe muyubile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.31",
            "verseOrgIds": [
              "LEV.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa amataala kabaLawi, tsinzu etsiomumataala akali akabwe, abaLawi batsinunule inyanga yosi yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.32",
            "verseOrgIds": [
              "LEV.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu omuLawi naba naranunula ta, kho inzu tsana eyakusibwa mwiaala elili elilie, yilekhuulwe muyubile; okhuba tsinzu tsiamataala kabaLawi netsiabwe abeene, mubaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.33",
            "verseOrgIds": [
              "LEV.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula emikunda chiobwayilo bwamataala kabwe shichikusibwa ta; okhuba nechiabwe inziayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.34",
            "verseOrgIds": [
              "LEV.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.34",
            "verseOrgIds": [
              "LEV.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana weenywe naba namanaane, amakhonoke nikali amatendeyu oburanyala okhumuliisia ewa oli ta, kho iwe omuleetelele; omenyenje ninaye shinga omurende nomumenyibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orabukula mumukhonokwe inganga kata injelesio ta; ne oriitsenje Nyasayewo; mbu omwana weenywe omenyenje ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oramuhosia amapeesako mbu onyoole inganga khuye, kata ebiokhulia khulwa injelesio ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isie nisie OMWAMI Nyasaye weenywe, owamurusia mushialo shiaMisiri, okhumuheelesia eshialo shiaKanaani, nokhuba Nyasaye weenywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omwana weenywe naba namanaane nali ninawe, niyeekusia omwene khwiwe, oramukhosia emilimo shinga omusumba ta; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.39",
            "verseOrgIds": [
              "LEV.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne abe khwiwe shinga omukholi womushaara, kata shinga omumenyibwa; akhukholelenje okhuula khumuyika kwayubile; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.40",
            "verseOrgIds": [
              "LEV.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana akhurulekhwo, ye nabaanabe bosi, nakalushila abeinzu yabwe, nakalukha khumukunda okwali kwabakuukanyene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.41",
            "verseOrgIds": [
              "LEV.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba nibo abasumba banje, aba ndarusia mushibala shiaMisiri; barakusibwa mubusumba ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.42",
            "verseOrgIds": [
              "LEV.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oramuruka obutinyu ta; ne oriitsenje Nyasayewo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.43",
            "verseOrgIds": [
              "LEV.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne akabasumbabo abeshisaatsa nabakholibo abakula abeshikhasi aba olaba ninabo, mukulenjs knumahanga akamubotokhana abasumba nabakholi beshikhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.44",
            "verseOrgIds": [
              "LEV.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mukulenjekhwo khubaana babarende ababa nibamenya mwinywe, nabetsinzu tsiabwe aba muli ninabo aba bakhaba nibeebuule mushialo shieenywe; nabo balaba emiandu chieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.45",
            "verseOrgIds": [
              "LEV.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubakhole babe obulaame bwabaana beenywe munyuma weenywe, okhulaamwa babe emiandu chiabwe; khubeenabo mubukulenje abasumba beenyive inziayo; ne khubaana beenywe abaana haIsiraeli; murarukananga nobutinyu ta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 25:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu omuiende kata omumenyibwa owa oli ninayl naba na yindihala, naye omwana weenywe ourondokhana ninaye naba namanaane, niyeekusia khumurende oyo, kata khumumenyibwa owa oli ninaye, katakhuwundi oweinzu yomurende tsara; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.47",
            "verseOrgIds": [
              "LEV.25.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 25:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa aba namalile okhukusibwa, anyala okhunmulwa; oundi owokhubaana babwe amunumule; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.48",
            "verseOrgIds": [
              "LEV.25.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 25:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata ousamwanawe, kata omwana wousamwanawe, amununule, kata oundi yesi omuluyia ouli ahambi khuluyia lwabwe amununule; kata omwene naba namala ayindihale, yeenunule omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.49",
            "verseOrgIds": [
              "LEV.25.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 25:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abalane nende oyo owamukula akhurula khumuyika olwa yeekusia okhuula khumuyika kwayubile; mana obukusi bwokhukusibwakhwe buchelwe obunji bwemiyika shinga olwa buli; emiyika echia yali ninaye chibe shinga emiyika chiomukholi womushaara. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.50",
            "verseOrgIds": [
              "LEV.25.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 25:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichiba nichishili emiyika eminji, echio shinga olwa chili, nolwa akalusia ario obukusi bwobununulwibwe mumapeesa aka yakulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.51",
            "verseOrgIds": [
              "LEV.25.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 25:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nichiba nichitong'a emiyika emituutu butswa okhuula khumuyika kwayubile, kho abalane ninaye; emiyikachie shinga olwa chili, nolwa alakalusia ario obukusi bwobununulwibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.52",
            "verseOrgIds": [
              "LEV.25.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 25:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abe khuye shinga omukholi ourungwa omushaara omuyika buli muyika; aramuruka nobutinyu nawe nolola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.53",
            "verseOrgIds": [
              "LEV.25.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 25:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba naranunulwa munjila tsino ta, kho alekhuulwe mumuyika kwayubile, ye nabaanabe bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.54",
            "verseOrgIds": [
              "LEV.25.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 25:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khwisie abaana baIsiraeli bali abasumba; nabasumba banje aba ndarusia mushibala shiaMisiri; isie nisie OMWAMI Nyasaye weenywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.55",
            "verseOrgIds": [
              "LEV.25.55"
            ]
          }
        }
      ]
    }
