    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obutakatifu bwebihaanwa biOMWAMI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela Haruni nabaanabe mbu beekabukhasie khubindu ebitakatifu biabaana baIsiraeli ebia banzahulilanga, mbu baleshe okhwonoonia eliira lianje litakatifu; isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obaboolele mbu Omundu yesi yesi owomulwibulo Iweenywe, munzibulo tsieenywe tsiosi, ousitila ebindu ebitakatifu ahambi, ebia abaana baIsiraeli baba nibamwahulila OMWAMI, ne nali nobukaali, omundu oyo asishibwe imbeli wanje; isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi owomulwibulo lwaHaruni ouba nali owobuchele, kata nali neshisununu, aleshe okhuliakhwo khubindu ebitakatifu, okhuula olwa aba nali omusiiye. Kata ouba natiilakhwo khushindu shiosi eshili eshiomusilo khulwa omufu, kata owiloorelela; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.4",
            "verseOrgIds": [
              "LEV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata omundu yesi outiilakhwo khushindu eshimoolanga khubiselasela, eshimura mwibilu, kata khumundu oumukwisia owobukaali, owobukaali bwosi obwa aba nali ninabwo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "outiila khushiosi shiosi eshifwana shirio abe mwibilu okhuula olwa bwila, naraliakhwo khubindu ebitakatifu ta, habula naba niyeesinjile omubili mumatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa eliuba liba liyeerile, kho aba omusiiye; nolunyumakhwo alie khubindu ebitakatifu, shichila nibio ebiliibwabie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshindu eshifwile eshiene, kata eshitonyatonyilwe netsisolo, araliakhwo, okhwiyoonoonia ninashio ta; isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, balindenje aka embalachilisia, baleshe okhutuukhwa obwonooni khulwako, nibafwilamwo, nibaba nibakoonoonia; nisie OMWAMI oubaahula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu omurende yesi aleshe okhuliakhwo khushindu eshitakatifu; omucheru womukuhani, kata omukholi owahandiikwa omushaara, aleshe okhuliakhwo khushindu eshitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukuhani naba nakula omundu amapeesa, abe omwandukwe, ye aliekhwo; kata abeebulwa munzuye nabo baliitsenje khubiliibwabie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omukhaana womukuhani naba nateeshelanga omurende, aleshe okhulia khutsisadaka tsiebindu ebitakatifu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omukhaana womukuhani naba nali omulekhwa, kata owakabukhasibwa nomusaatsawe, narali nomwana ta, ne nakaluushe munzu wabwe, shinga olwa yali nashili omubuukha, kho aliitsenje khubiliibwa biasamwana; ne omurende yesi araliakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu naba niyeetsukhana nalia khushindu eshitakatifu, kho ashimeetekhwo eshitonye shiakharaano, naheelesia omukuhani eshindu eshitakatifu tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani baleshe okhwonoonia ebindu ebitakatifu biabaana baIsiraeli, ebia bahaanila OMWAMI, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibachila nibeetuukha obumayaanu bwabwe neshiuku shiabwe, olwa balia ebindu biabwe ebitakatifu; okhuba nisie OMWAMI oubaahula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela Haruni nabaanabe nende abaana bosi baIsiraeli mbu Omundu yesi yesi oweinzu yaIsiraeli kata owokhubarende abali muIsiraeli, ouba naleera eshihaanwashie, kata nishiakhaba shiebiitsubo biabwe, kata khubia bahaana khulwa okhuchama, ebia baleerela OMWAMI khulwa omusango omusambe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimwenya okhufuchiililwa, muleere eshisaatsa eshibula obulema, eshiokhung'ombe, kata eshiokhumakondi, kata eshiokhumbusi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shiosi shiosi eshili nobulema, murashileera ta; shichila shishifuchiilikha khulweenywe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomundu yesi ouleerela OMWAMI omusango kwokhwishia, okhuusia eshiitsubo, kata khulwa eshihaanwa eshia ahaana khulwa okhuchama, eshiokhung'ombe kata eshiokhubiayo, shibe eshiIamba habwene mbu shifuchiililwe; shirabakhwo nobulema bwosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshibofu, kata eshlfiniishe, kata eshiremilwekhwo, kata eshiraatsakhwo amaiila, kata eshiamahunde, kata obukuya, ebienebio murabileerela OMWAMI ta, kata okhubikholela OMWAMI eshihaanwa eshikholelwa omulilo khushimalilo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ing'ombe kata likondi eshia eshiungo shindi shiakhaba nishiarambiha, kata nishiembiha, eshieneshio onyala okhushikhola eshihaanwa eshia ohaana khulwa okhuchama; ne khulwa eshiitsubo, shishifuchiilikha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshia eshimala shiashio shiakhupwa, kata okhutubulwa, kata okhufinikha, kata okhukhalakwa, murashileerela OMWAMI, kata okhushimala shibe omusango mushialo shieenywe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata murahaana ebifwana birio ebia oba nonyoolile mumukhono kwomusuku, bibe ebiliibwa biaNyasaye weenywe, ta, khulwa okhwonoonekha khwabio, bilimwo obulema; shibilafuchiililwa khulweenywe ta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa ing'ombe, kata likondi, kata imbusi, shiba nishiibuulwe, shibeho tsindaalo musaafu nende nyina; mana okhurula khunyanga yomunaane shinyala okhufuchiililwa shibe eshihaanwa eshikholelwa omulilo khuMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata nishiba itwasi kata linyafusi, murashiira eshiene nende omwana washio biombi khunyanga ndala ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olwa mumalila OMWAMI omusango kwokhuupa orio, mukumale habwene mbu mufuchiililwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuliibwe khunyanga yeneyo; muralekhakhwo kukone okhuula mukamba ta; isie nisie OMWAMI.",
