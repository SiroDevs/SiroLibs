    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haruniyamala emisango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomunaane Musa yalanga Haruni nabaanabe, nabakofu baIsiraeli, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.1",
            "verseOrgIds": [
              "LEV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naboolela Haruni ari Bukula eshimoosi eshisaatsa khulwa omusango kwobwonooni, nelimiiku khulwa omusango omusambe, ebibula obulema, nobileera imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.2",
            "verseOrgIds": [
              "LEV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi oboolele abaana baIsiraeli mbu Bukule ikhole yomusango kwobwonooni, neshimoosi nelikondi lieshimwamwane, biosi nibili ebiomuyika mulala, ebibula obulema, khulwa omusango omusambe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.3",
            "verseOrgIds": [
              "LEV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "neing'ombe nelimiiku khulwa emisango chiokhwishia, okhubimala imbeli w; nomusango kweimele okutsokasiibwe amafura; okhuba leelo luno OMWAMI yeetsa okhumuloleshela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibeetsa nende ebienebio ebia Musa yalaka, imbeli weliheema liokhwakaana; omukhung'aano kwosi nikusita ahambi nikusinjila imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.5",
            "verseOrgIds": [
              "LEV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nasunga mbu Lino nilio elia OMWAMI yalaka mbu mukhole; ne oluyali lwOMWAMI lulamuloleshela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.6",
            "verseOrgIds": [
              "LEV.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Musa naboolela Haruni ari Sita ahambi khushimalilo, okhole omusangokwo kwobwonooni, nomusangokwo omusambe, niwitisa omwene halala nabandu; mana ohaane eshihaanwa shiabandu, nobatisa; shinga OMWAMI olwa yalaka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Haruni yasita ahambi khushimalilo, niyeera eshimoosi shiomusango kwobwonooni, okwali khululwe omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.8",
            "verseOrgIds": [
              "LEV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baHaruni nibamuleerela amalasile kashio; naye niyeena olwala mumalasile, nakara khunzika tsieshimalilo, natsukha amalasile hasi weshimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.9",
            "verseOrgIds": [
              "LEV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa amasinya, netsifiko, nolufuurilo olwokhushini biomusango kwobwonooni, yaoisambila khushimalilo; shinga OMWAMI olwa yalaka Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyama neliseelo yabisamba nomulilo elwanyi weikambi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyeera omusango okwolchusambwa; abaana baHaruni nibamukaamia amalasile kakwo, naye nakooha khushimalilo tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
              "LEV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamukaamila omusango kwokhusambwa, eshitonye eshitonye, nende omurwe; naye nabisambila khushimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.13",
            "verseOrgIds": [
              "LEV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyoosia amala nebilenje, nabisambila khumusango omusambe khushimalilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana naleera eshihaanwa shiabandu, nabukula imbusi yomusango kwobwonooni okwali nikuli khulwa abandu, nachiira, nachimala khukva obwonooni, shinga omusango okwambeli kulia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.15",
            "verseOrgIds": [
              "LEV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naleera omusango kwokhusambwa, nakukhola eshiima eshialakwa shinga olwa shiali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.16",
            "verseOrgIds": [
              "LEV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naleera nende omusango kweimele, nabufumbarakhwo, nabusambila khushimalilo; khandi nende omusango omusambe okwomusenya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yeera nende ing'ombe nelimiiku, nibio omusango kwokhwishia okwali khulwa abandu; abaana baHaruni nibamukaamila amalasile kakwo, naye nakooha khushimalilo tsimbeka tsiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende amasinya keing'ombe tsana; ne khwimiiku, isembe yalio, neshifuunikho shiamala, netsifiko, nolufuurilo olwokhushini; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibara amasinya tsana khutsitakata, naye nasambila amasinya khushimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsio tsitakata neshiatakho eshisaatsa, Haruni yabichela imbeli w bibe omusango kwokhuchelwa, shinga Musa olwa yalaka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Haruni yachinguulila abandu amakhono, nabasabila ikhabi; niyeekha okhurula khukhumala omusango kwobwonooni, nomusango omusambe, nemisango chiokhwishia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nende Haruni nibeenjila mwiheema liokhwakaana, mana nibarulamwo, nibabasabila abandu ikhabi; oluyali lw niluloleshela abandu bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omulilo kwarula ewOMWAMI, nikulia omusango omusambe namasinya khushimalilo; nabandu bosi olwa balola bario, bakhupa tsingalakala, nibasikama nibamwinamila Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.24",
            "verseOrgIds": [
              "LEV.9.24"
            ]
          }
        }
      ]
    }
