          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani amuhenjelesie; ne amayaayasi nikaba nikalandile khwikhoba, omukuhani aleshe okhukhaaba amaswa amaranzayi ta; ali nobukaali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula naba nalola amayaayasi nikali butswa kario, amaswa amamali nikamelilekhwo, kho amayaayasi kahonile; nomusiiyikhu; omukuhani arumbule mbu nomusiiyikhu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
