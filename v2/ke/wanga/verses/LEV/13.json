              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ingubo yosi niyilimwo oluumbe lwobuchele, kata niyili ingubo yobwoya bwamakondi, kata ingubo yeikitani; ",
          "type": "text",
          "attrs": {
