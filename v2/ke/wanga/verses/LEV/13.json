              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani abalache okhwosia eshindu shieneshio eshia oluumbe lulimwo, nashiikalila tsindaalo tsindi musaafu. ",
          "type": "text",
          "attrs": {
