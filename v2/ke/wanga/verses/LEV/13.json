          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho nomundu wobuchele; ali nobukaali; omukuhani arachweya okhurumbula mbu nowobukaali ta; oluumbe luli khumurwekwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
