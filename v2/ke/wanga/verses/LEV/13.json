          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomusaafu omukuhani ahenjelesie amayaayasi, ne amayaayasi nikaba nikaralandile khwikhoba ta, nikaralolekha shinga akahobooshe mwikhoba ta, kho omukuhani arumbule mbu nomusiiyikhunaye aloosia tsingubotsie, abe omusiiyikhu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
