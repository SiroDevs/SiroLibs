              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukuhani ahenjelesie haluumbe tsana; ne nihaba nihalolekha shinga ahahobooshe mwikhoba, nihalikhwo amaswa amaranzayikhwo, akafwililila, kho omukuhani arumbule mbu nowobukaali; namayaayasi; nobuchele bwomurwe kata obweshileefu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
