            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa amayaayasi nikaba nikalanda khwikhoba olunyuma Iwokhusiiywakhwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
