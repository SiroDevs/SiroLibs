            "sid": "LEV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omundu aba nali noluumbe Iwobuchele, kho aleerwe ewomukuhani; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.9",
            "verseOrgIds": [
              "LEV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omukuhani ahenje, ne niliba nililiho lifwimbe lilafu khwikhoba, elilabiye amaswa, inyama yelifwimbe niyikhobooshe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.10",
            "verseOrgIds": [
              "LEV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho nobuchele obukhulu mwikhoba liomubilikwe; omukuhani arumbule mbu nowobukaali; aramwikalila ta, okhuba nowobukaali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obuchele nibuba niburubukha mwikhoba, obuchele nibuchelehasia likhoba liosi lia oyo ouli noluumbe tsana, okhurula khumurwe okhuula khubilenje, aha omukuhani anyala okhulola, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.12",
            "verseOrgIds": [
              "LEV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani ahenje; ne obuchele nibuba nibuchelehasiye omubilikwe kwosi pe, arumbule mbu nomusiiyikhu, oyo ouli noluumbe; kulabile kwosi pe; nomusiiyikhu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.13",
            "verseOrgIds": [
              "LEV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa naba nalolekha shinga oukhobooshe, abe owobukaali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.14",
            "verseOrgIds": [
              "LEV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani ahenjelesie ahakhobooshe tsana, narumbula mbu nowobukaali; ahakhobooshe tsana nahobukaali; nibwo obuchele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.15",
            "verseOrgIds": [
              "LEV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata ahakhobooshe nihakalukhana, nihalaba, kho yeetsele omukuhani, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.16",
            "verseOrgIds": [
              "LEV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omukuhani amuhenjelesie; ne haluumbe nihaha nihalabile, kho omukuhani arumbule mbu nomusiiyikhu, oyo ouli noluumbe; nomusiiyikhu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        }
