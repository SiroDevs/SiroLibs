          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omukuhani amuhenjelesie, ne lifwimbe lioluumbe niliba nilili liranzayi lilafukhwo khushiole kata khushiahuusa, nililolekha shinga obuchele khwikhoba liomubilikwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
