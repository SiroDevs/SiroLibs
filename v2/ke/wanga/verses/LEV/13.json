          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani ahenjelesie; ne amaswa akokhushitayi nikaba nikalabile, nihalolekha shinga ahahobooshe mwikhoba, nobuchele, obumbuushe ahasambilwe; kho omukuhani arumbule mbu nowobukaali; noluumbe Iwobuchele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.25",
            "verseOrgIds": [
              "LEV.13.25"
            ]
          }
        },
        {
