          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhhani ahenjelesie haluumbe, niyeekalila shieneshio eshilikhwo oluumbe tsana tsindaalo musaafu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana khunyanga yomusaafu ahenjelesie haluumbe; ne haluumbe nihaba nihalandile mungubo, mubuusi bwobulmlji kata mubwobuchiikha, kata mwiseelo eliikhoonyelwa khumulimo kwosi kwosi; kho oluumbe olwo nobuchele obunyanya; nomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana asambe ingubo eyo, kata oluumbe niluli mubuusi bwobulunji kata obwobuchiikha, bwobwoya bwamakondi kata obweikitani, kata eshindu shiosi shieliseelo, eshia oluumbe tsana lulimwo; oknuba nobuchele obunyanya; shisambilwe mumulilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
