          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa nihaba nihaliho haluumbe aharanzayi ahalafukhwo mushioleshie kata mushiahuusashie, nibwo obuchele oburubukha khushiole kata khushiahuusashie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
