          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omubili kuli nelibure khwikhoba, nalio nilihonile, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.18",
            "verseOrgIds": [
              "LEV.13.18"
            ]
          }
        },
        {
