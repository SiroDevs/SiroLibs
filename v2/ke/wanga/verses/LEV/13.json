          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "haluumbe tsana nihaba hobukondo bweisuutsa kata aharanzayikhwo mungubo eyo, kata mwiseelo, kata mubuusi bwobulunji kata mubwobuchiikha kata mushindu shiosi shieliseelo, nilwo oluumbe lwobuchele; lumanyibwe omukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
