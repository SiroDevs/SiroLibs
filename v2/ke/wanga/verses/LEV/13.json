          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata niluli mubuusi bwobulunji kata mubuusi bwobuchiikha bwobwoya bwamakondi kata obweikitani; kata niluli mwiseelo, kata mushindu shiosi eshiakholelwa liseelo; ",
          "type": "text",
          "attrs": {
