          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukuhani naba nahenjelesia haluumbe olwo lwamayaayasi, ne niharalolekha shinga ahahobooshe mwikhoba ta, ne nikarabakhwo amaswa amamali ta, kho omukuhani amwikalile tsindaalo musaafu oyo ouli noluumbe lwamayaayasi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomusaafu omukuhani ahenjelesie haluumbe tsana; ne amayaayasi nikaba nikaralandile kata nikarabakhwo amaswa amaranzayikhwo, kata amayaayasi nikaralolekha shinga akahobooshe mwikhoba ta, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
