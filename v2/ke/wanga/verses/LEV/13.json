          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata liswi liomundu niliba nilikhweyukhanga khumurwekwe, neshiole; ne nomusiiyikhu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
