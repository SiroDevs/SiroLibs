          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata liswilie niliba nilikhweyukhanga khubweni noweshiahuusa; ne nomusiiyikhu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
