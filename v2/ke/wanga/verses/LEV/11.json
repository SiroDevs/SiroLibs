        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko amalako khuketsisolo, nokhukamanyonyi, nokhukebili mwoyo biosi ebichendanga mumatsi, nende khukebiosi ebiselasela khushialo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhwahukhasia ebiemisilo nebisiivikhu, nende okhwahukhasia ebili mwoyo ebiliibungwa nende ebili mwoyo ebiraliibwa ta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
            "verseOrgIds": [
              "LEV.11.47"
            ]
          }
