    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebili-mwoyo ebiemisilo nende ebisiiyikhu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa naHaruni ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli mbu Bino nibio ebilimwoyo ebia mulaliitsanga musolo tsiosi etsili mushialo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.2",
            "verseOrgIds": [
              "LEV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu yosi eyikabukhana oluhakayu eya eshilenje shieeyara hakari, eyinyanyanga ikaamuula, mutsisolo tsiosi eyo niyo eya mulaliitsanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.3",
            "verseOrgIds": [
              "LEV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula khutsinyanyanga ikaamuula kata khutsikabukhana oluhakayu, muleshenje okhulia khutsino; mbu ingamia, shichila yinyanyanga ikaamuula, ne shiyikabukhana oluhakayu ta, khwinywe neyomusilo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.4",
            "verseOrgIds": [
              "LEV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelicheneli, shichila linyanyanga ikaamuula, ne shilikabukhana oluhakayu ta; khwinywe neliomusilo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.5",
            "verseOrgIds": [
              "LEV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "neshituyu, shichila shinyanyanga ikaamuula, ne shishikabukhana oluhakayu ta; khwinywe neshiomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.6",
            "verseOrgIds": [
              "LEV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neimbiitsi, shichila yikabukhana oluhakayu, niyili neshilenje eshieeyara hakari, ne shiyinyanyanga ikaamuula ta; khwinywe neyomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.7",
            "verseOrgIds": [
              "LEV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muraliakwo hkhunyama yatsio, kata okhutiilakhwo khubirundu biatsio ta; khwinywe netsiomusilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubiomumatsi biosi, ebia mulaliitsangakhwo mbiebino; mbu shiosi shiosi eshili nebibehe nende amasale, mumatsi kosi, munyanza tsiosi nomumialo, mubiliitsenje. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.9",
            "verseOrgIds": [
              "LEV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa biosi ebibula ebibehe namasale munyanza nomumialo, khubiosi ebiselasela mumatsi, nokhubili mwoyo biosi ebili mumatsi, ebio nebisinyo khwinywe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.10",
            "verseOrgIds": [
              "LEV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi bilabeetsanga khwinywe ebisinyo; muraliakhwo khunyama yabio ta; kata ebirundu biabio, bibe eshisinyo khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.11",
            "verseOrgIds": [
              "LEV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshindu shiosi shiosi eshibula ebibehe namasale khubiomumatsi, eshio neshisinyo khwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi bino nibio ebilabeetsanga ebisinyo khwinywe khumanyonyi; bileshe okhuliibungwa; nebisinyo; mbu inditsu, neshikhokorelo, nelihuutselo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.13",
            "verseOrgIds": [
              "LEV.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "neshikhupi, nolukakha, khumbia tsiabio shinga olwa tsili; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.14",
            "verseOrgIds": [
              "LEV.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "buli likhokho, khumbia yalio shinga olwa lili; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.15",
            "verseOrgIds": [
              "LEV.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelihuto, neimbukambuka, neinyanje, nelihungu, khumbia tsiabio shinga olwa tsili; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.16",
            "verseOrgIds": [
              "LEV.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelikhuule, nanamulobi, neliyichichi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.17",
            "verseOrgIds": [
              "LEV.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "neifiitibili, neimware, neingosia; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.18",
            "verseOrgIds": [
              "LEV.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelikuyi, nelinakha, khumbia tsiabio shinga olwa tsili, nelihutihuti, nelinyinya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.19",
            "verseOrgIds": [
              "LEV.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.19",
            "verseOrgIds": [
              "LEV.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebindu biosi ebimoolanga hasi, ebili netsimbaha nibichendela ebilenje bine, nebisinyo khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.20",
            "verseOrgIds": [
              "LEV.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa muliitsenje bino, ebiokhubindu ebiselasela ebili netsimbaha nibichendela ebilenje bine, ebili nebilenje ikulu wamalaaro kabio okhusiilila khushialo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.21",
            "verseOrgIds": [
              "LEV.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "khubio, ebia mulaliitsanga mbiebino; mbu isiche khumbia yayo, nobwonya khumbia yabwo, namahalang'ang'a khumbia yako, nebikuunyili khumbia yabio. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.22",
            "verseOrgIds": [
              "LEV.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ebiokhubiselasela ebili netsimbaha, ebili nebilenje bine nebisinyo khwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsino nitsio etsilamukwisinjia okhuba nobukaali; omundu yesi outiilakhwo khushirundu shiatsio shiosi abe mwibilu okhuula olwa bwila; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24",
            "verseOrgIds": [
              "LEV.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata omundu yesi ouchingakhwo eshiokhushirundu shiatsio, yoosie tsingubotsie, naba mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.25",
            "verseOrgIds": [
              "LEV.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli solo eyikabukhana oluhakayu, neya eshilenje eshirayeeyara hakari kata eyiranyanyanga ikaamula ta, neyomusilo khwinywe; buli mundu oubitiilakhwo abe mwibilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.26",
            "verseOrgIds": [
              "LEV.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata yosi yosi eyichendelanga amakhumbu, musolo tsiosi etsichendelanga ebilenje bine, neyomusilo khwinywe; omundu yesi outiilakhwo khushirundu shiatsio abe mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.27",
            "verseOrgIds": [
              "LEV.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ouchingakhwo eshirundu shiatsio yoosie tsingubotsie naba mwibilu okhuula olwa bwila; nebiomusilo khwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.28",
            "verseOrgIds": [
              "LEV.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.28",
            "verseOrgIds": [
              "LEV.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino nibio ebili ebiomusilo khwinywe mubindu ebiselasela khushialo; mbu ifikho, nakhabuuto, nelihumbachila khumbia yalio; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29",
            "verseOrgIds": [
              "LEV.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelibaakala, neimbulu, nelibaakala elianalwanda, nelisiakale, nelikhaniafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.30",
            "verseOrgIds": [
              "LEV.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebio nibio ebili ebiomusilo khwinywe mubindu biosi ebimoolanga; omundu yesi oubitiilakhwo nibimalile okhufwa abe mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.31",
            "verseOrgIds": [
              "LEV.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshindi shiosi eshiokhubio eshiba nishifwile nishiba nishikwa khushindu shiosi, eshindu tsana shikwe eshiomusilo; nishiba eshimanulwa shieshibaho, kata eshiifwalo, kata liseelo, kata likunia, kata eshimanulwa shiosi shiosi eshikholelungwa omulimo kwosi, shireebwe mumatsi nishiba eshiomusilo okhuula olwa bwila; mana shibe eshisiiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata buli nyungu yelitoyi eya shilakwakhwo, eshindu shiosi eshiba nishilimwo shibe eshiomusilo, ne eyene yarwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.33",
            "verseOrgIds": [
              "LEV.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiliibwa biosi ebiokhuliibwa ebibamwo amatsi, bibe ebiomusilo; kata ebiokhunywa biosi ebiokhunyweebwa ebiomusiongo eyili yirio, nabio bibe ebiomusilo khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.34",
            "verseOrgIds": [
              "LEV.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata eshitonye shiosi shieshirundu shiabio nishiba nishikwa khushindu shiosi eshindu tsana shibe eshiomusilo; nishiba lichiiko kata amayika, shisasakwe ebitonye ebitonye; nebiomusilo, khandi bibe khwinywe ebiomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.35",
            "verseOrgIds": [
              "LEV.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa isebele kata liyabo elilimwo amatsi amanji libe lisiiyikhu, habula akeenako akatiila khushirundu kabe akomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.36",
            "verseOrgIds": [
              "LEV.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata eshitonye shiosi shieshirundu shiabio nishiba nishikwa khumwo yokhumiitswa yosi eyili okhumiitswa yibe butswa isiiyikhu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.37",
            "verseOrgIds": [
              "LEV.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa imwo niyiba niyiiniikhwe mumatsi, mana eshitonye shiosi shieshirundu shiabio nishikwakhwo, yibe eyomusilo khwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
