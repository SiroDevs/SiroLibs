          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "naba namanyibwa eshionoonoshie eshia yoonoona, yeetse neshihaanwashie, mbu imbusi isibiini eyibula obulema, khulwa eshionoonoshie eshia yoonoonile, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
