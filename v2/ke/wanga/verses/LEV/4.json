              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nara omukhono khumurwe kwomusango kwobwonooni nakwira kube omusango kwobwonooni, habundu aha beerelanga omusango omusambe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
            "verseOrgIds": [
              "LEV.4.33"
            ]
          }
        },
        {
