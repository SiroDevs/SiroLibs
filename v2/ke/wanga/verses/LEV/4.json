          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani abukule khumalasile komusango kwobwonooni nende olwala, nakara khunzika tsieshimalilo shiemisango emisambe, mana amalasile kakwo kosi akatsushe hasi weshimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.34",
            "verseOrgIds": [
              "LEV.4.34"
            ]
          }
        },
        {
