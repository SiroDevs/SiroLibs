        },
        {
          "text": "Ne naba niyeetsa nelikondi libe eshihaanwashie shiomusango kwobwonooni, yeetse nende likhasi elibula obulema, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.32",
            "verseOrgIds": [
              "LEV.4.32"
            ]
          }
        },
        {
