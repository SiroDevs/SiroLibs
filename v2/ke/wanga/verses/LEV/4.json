          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nara omukhono khumurwe kwomusango kwobwonooni, niyeerela omusango kwobwonooni habundu womusango omusambe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani abukule khumalasile kakwo nende olwala, nakara khunzika tsieshimalilo shiemisango emisambe, mana amalasile kakwo kosi akatsushe hasi weshimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amasinya kakwo kosi akayinie, shinga amasinya olwa kayinibungwa khumusango kwokhwishia; mana omukuhani akasambile khushimalilo khulwa eshiuya eshilayi khuMWAMI; ne omukuhani amutise, naye alaleshelwa.",
          "type": "text",
