          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.28",
            "verseOrgIds": [
              "LEV.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli mbu Ouleerela OMWAMI omusango kwokhwishiakhwe, yeetse ewOMWAMI neshihaanwashie eshirula mumusango kwokhwishiakhwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhono keke omwene kachinje ebihaanwa biOMWAMI ebikholelwa omulilo; yeetse namasinya halala neitakata, mbu itakata yichelwe imbeli w, yibe omusango kwokhuchelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukuhani asambile amasinya khushimalilo; ne itakata yilaba yaHaruni nabaanabe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashio eshiatakho eshisaatsa, mushimuheelesie omukuhani kube isadaka okhurula mumisango chiokhwishia khweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo owomubaana baHaruni ouleera amalasile kemisango chiokhwishia nende amasinya, niye oubukula eshiatakho eshisaatsa shibe omukabokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba embukuule khubaana baIsiraeli itakata eyichelwa neshiatakho shieisadaka okhurula mumisango chiokhwishia khwabwe, nibimuheelesia Haruni omukuhani nabaanabe, bibe ebibakhoyeele tsindaalo tsiosi okhurula khubaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno nikwo omukabo kwaHaruni nomukabo kwabaanabe, okhurula mubihaanwa biOMWAMI ebikholelwa omulilo, khunyanga olwa yabaleera okhukhalabanila OMWAMI mubukuhani; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikwo okwa OMWAMI yalaka mbu baheebwe nabaana baIsiraeli, khunyanga olwa batsushiililwa amafura. Nakwo kubakhoyeele tsindaalo tsiosi munzibulo tsiabwe tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
