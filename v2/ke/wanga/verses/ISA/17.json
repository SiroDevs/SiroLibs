              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga eyo abandu balamuhenga Omulonji wabwe, tsimoni tsiabwe nibatsichoomia khu Oyo Omutakatifu waIsiraeii. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
