            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shibalahenga ebimahlo biemisango, ealilimo chiamakhono kabwe, kata shibalarangaala eshio eshia tsinzala tsiabwe tsiakhoiile, kata emiAshera kata ebifwanani bieliuba ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
