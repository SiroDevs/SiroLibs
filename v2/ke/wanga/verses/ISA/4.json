          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oyo ousikaale muSayuni, nende oyo outong'ile muYerusalemu, balalangwa mbu abatakatifu, kata buli mundu oweYerusalemu owahandiichilwa okhuba mwoyo; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa Omwami alaba niyoosiye likhwe liabeshikhasi beSayuni, khandi olwa alaba nasiiyile eshitsayi eshili eYerusalemu okhuula mukari mwosi, khulwa iroho yobukhalachi nende khulwa iroho yokhusamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana hekulu wobwikhalo bwosi bweshikulu shiaSayuni, khandi hekulu wemikhung'aanochie, OMWAMI alalonjelaho lileesi nende omwosi mushiteere, khandi okhwakha khwetsimemu tsiomulilo mushilo; okhuba hekulu weing'oono yosi eshifuunikho shilaalwakhwo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende eshisaakati, khulwa eshiinikha mumubasu kweshiteere, khandi khulwa obwilushilo khandi obwibisilo mumbumbuyeka nende mufula.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
