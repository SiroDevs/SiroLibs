{
  "id": "LUK.6",
  "number": "6",
  "bookId": "LUK",
  "reference": "Luka 6",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "LUK 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abeechi bakhuunuula ingano khuSabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yindi yaSabato yali nabira mundalo tsieingano; abeechibe nibakhuunuula ingano, nibafunga mumakhono kabwe nibalia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.1",
            "verseOrgIds": [
              "LUK.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandi abokhubaFarisayo nibasunga bari Mbushiina nimukhola akali omusilo okhukhola khunyanga yaSabato? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.2",
            "verseOrgIds": [
              "LUK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nakalusia, nabasunjila ari Shimwasooma kata kano ta, aka Daudi yakhola olwa yali nali inzala halala naba yali ninabo? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.3",
            "verseOrgIds": [
              "LUK.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbu yeenjila munzu yaNyasaye nabukula Emikaate chiOkhubaho, nalia, nabaheelesiakhwo aba yali ninabo, echili omusilo omundu yesi okhuchiliakhwo, habula abakuhani bonyene? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.4",
            "verseOrgIds": [
              "LUK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababoolela ari Omwana wOmundu niye Omwami waSabato.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.5",
            "verseOrgIds": [
              "LUK.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omundu owomukhono okwanyela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.5",
            "verseOrgIds": [
              "LUK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhuSabato yindi khandi yeenjila musinagogi niyeechesia; ne yalimwo omundu owa omukhonokwe omusaatsa kwali nikwanyela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.6",
            "verseOrgIds": [
              "LUK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahandiichi nende abaFarisayo nibamuyichila okhulola naba niyakhahonia khuSabato, mbu banyoole shinga olwa bakhamwinjilila itookho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.7",
            "verseOrgIds": [
              "LUK.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yamanya amapaaro kabwe, nasunjila omundu oyo owa omukhonokwe kwanyela ari Buukha, osinjile hakari. Naye nabuukha nasinjilaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.8",
            "verseOrgIds": [
              "LUK.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nabasunjila ari Emureeba, mbu kafuchiililwa okhukhola amalayi nohomba okhukola amabii khuSabato? Okhuhonia obulamu bwomundu nohomba okhubutibia? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.9",
            "verseOrgIds": [
              "LUK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabahenga bosi, eyi nende eyi, namusunjila mbu Kololosia omukhonokwo; naye nakhola ario, omukhonokwe nikukalukha habwene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.10",
            "verseOrgIds": [
              "LUK.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibasinyikha shia abeenya okhwilia, nibasungana abeene khubeene, eshia bakhamukholela Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.11",
            "verseOrgIds": [
              "LUK.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abeechi ekhumi nababili balobolwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.11",
            "verseOrgIds": [
              "LUK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mundaalo etsio yarula natsia mushikulu okhusaaya, nahonga eshilo tulu nasaayanga Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.12",
            "verseOrgIds": [
              "LUK.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bwashia, yalanga abeechibe, nalobola ekhumi nababili khubo, aba yakulikha mbu abarume; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.13",
            "verseOrgIds": [
              "LUK.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbabano, mbu Simoni, owa yakulikha mbu Petero, nende Anderea omwana wabwe, naYakobo naYohana, naFilipo naBaritsolomayo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.14",
            "verseOrgIds": [
              "LUK.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "naMatsayo naTomasi, naYakobo waAlufayo, naSimoni oulangwa mbu Zelote, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.15",
            "verseOrgIds": [
              "LUK.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "naYuda waYakobo, nende Yuda Isikariote, owali omukhobi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.16",
            "verseOrgIds": [
              "LUK.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yakhalabanila abemikanda emikali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.16",
            "verseOrgIds": [
              "LUK.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakholomokha ninabo nasinjila hashikuuri, halala nende omukanda omukhongo kwabeechibe, nende abandu abanji abarula mubuYahudi mwosi nende eYerusalemu, nende khulukuku IweTiro nende Sidoni, abali nibeetsile okhumuhulila, nende okhuhonibwa obuteshele bwabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.17",
            "verseOrgIds": [
              "LUK.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo abanyasibungwa nabaroho beshifwabwi nibahonibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.18",
            "verseOrgIds": [
              "LUK.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomukanda bosi nibakhaaba obwiyangu okhumutiilakhwo; okhuba obunyali bwali niburulanga khuye, nibubahonia bosi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.19",
            "verseOrgIds": [
              "LUK.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aketsikhabi, nakaWoowe!",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.19",
            "verseOrgIds": [
              "LUK.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachinguula tsimoni khubeechibe, naboola ari",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.20",
            "verseOrgIds": [
              "LUK.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.21",
            "verseOrgIds": [
              "LUK.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli abeikhabi inywe olwa bamukiya nibamuboona, nibamunyeka, nibasukuna eliira lieenywe shinga likhuwa libii khulwa Omwana wOmundu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
              "LUK.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwikhoye khunyanga eyo, nimusiilasiila khulwa obusangaali; shichila lole, omukabo kweenywe nomunji mwikulu; okhuba nilwo olwa abakuuka babwe bakholela abanabii.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.23",
            "verseOrgIds": [
              "LUK.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhuheela abasuku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.26",
            "verseOrgIds": [
              "LUK.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi emuboolela inywe abahulilanga, mbu Heelenje abasuku beenywe, nimubakholela amalayi abamukiya; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.27",
            "verseOrgIds": [
              "LUK.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "mubasaayile abamulaka eshilaka munwa, baheebwe ikhabi, nimubasabila abamukhupia khumabii. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.28",
            "verseOrgIds": [
              "LUK.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oukhupaama oluseya lulala, omumanyie olundi naIwo; noyo oubukula likotilio, ne inguboyo eyomukari oramwima tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.29",
            "verseOrgIds": [
              "LUK.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheelesie buli mundu oukhusaba eshindu; noyo oubukula emianduchio, orachisaba khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.30",
            "verseOrgIds": [
              "LUK.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shinga olwa mwenya abandu bamukholelenje inywe, nineenywe mubakholelenje murio.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.31",
            "verseOrgIds": [
              "LUK.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.31",
            "verseOrgIds": [
              "LUK.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nimuba nimubaheela abamuheelanga inywe, obwo nobukoosia shi? Shichila kata aboonooni baheela abo ababaheelanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.32",
            "verseOrgIds": [
              "LUK.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nimuba nimubakholelanga amalayi abamukholela inywe amalayi, obwo nobukoosia shi? Shichila kata aboonooni bakholanga bario. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.33",
            "verseOrgIds": [
              "LUK.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nimuba nimubahosinjia abo aba musuubilanga okhunyoola khubo ebindi, obwo nobukoosia shiina? Kata aboonooni bahosinjia aboonooni ebindu, mbu bakalusilibwe bario. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.34",
            "verseOrgIds": [
              "LUK.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne butswa heelenje abasuku beenywe, nimubakholela amalayi, nimubahosiakhwo ebindu nimurafwa emioyo ta; mana omukabo kweenywe kulaba omunji, neenywe mulabeetsanga abaana baOyo Ouli Ikulu Muno; shichila ye noweshisa khubamakalu nende ababii. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.35",
            "verseOrgIds": [
              "LUK.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubeelenje tsimbabasi, shinga Seenywe olwa abeelanga tsimbabasi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.36",
            "verseOrgIds": [
              "LUK.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhukhalachila abandi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.36",
            "verseOrgIds": [
              "LUK.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne murayaasinjia omundu eshiina, mana inywe shimulayaasibwa tawe; kata murabakhalachila eshiina, mana inywe shimulakhalachilwa eshiina tawe; bohololenje, mana mulabohololwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.37",
            "verseOrgIds": [
              "LUK.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haanenje, nineenywe mulaheebwa; eshichelo eshilayi, eshiikaarwe, eshisungusilwe, eshibumbilwe okhusundukha hasi, nolwa balachela mungubo tsieenywe; okhuba eshichelo shiene eshia muchelelangamwo, nishio eshia mulachelelwamwo khandi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.38",
            "verseOrgIds": [
              "LUK.6.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.38",
            "verseOrgIds": [
              "LUK.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nababoolela muluchelo, ari Omubofu anyala okhwimilila omubofu washie? Shibalakwa bombi mubuko? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.39",
            "verseOrgIds": [
              "LUK.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwechibwa yesi shiashila omwechesiawe ta, ne buli mundu olwa aba nakholilwe omulamba, alaba shinga omwechesiawe olwa ali.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata mbushiina nohenganga akhakokha akhali mumoni yowashio, noreetsulilakhwo eshirundu eshili mumoni yiyo ta? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.41",
            "verseOrgIds": [
              "LUK.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata wakhanyala orie okhumuboolela owashio mbu Mwana, lekha ekhuyinie akhakokha akhali mumoniyo, ne noralolanga eshirundu eshio eshili mumoni yiyo? Omwikaatii iwe, ranjilila oyinie eshirundu eshili mumoni yiyo, mana olalola bulayi okhuyinia akhakokha akhali mumoni yowashio.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusaala kumanyikha khulwa ebiamo biakwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 6:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila kubulaho omusaala kwosi omulayi okwamanga ebiamo ebibii, kata omusaala omumayaanu kurio okwamanga ebiamo ebilayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.43",
            "verseOrgIds": [
              "LUK.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila buli musaala kumanyishilanga khubiamo biakwo okwene. Shichila khubisisia abandu shibanokangakhwo amakhuyu ta, kata khumatsoyi shibanokangakbwo tsinzabibu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.44",
            "verseOrgIds": [
              "LUK.6.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu omulayi okhurula mwibiildlo lilayi eliomumwoyokwe arusinjiamwo ebili ebilayi; noyo omubii okhurula mwibiikho libii arusinjiamwo ebili ebibii; okhuba khulwa obunji obwomumwoyo omunwakwe kuboolanga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omute kwolwanda, nomuse kwomuyeshe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 6:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nishiina eshichila nimunanganga mbu Omwami, Omwami, nimurahulila aka emboolanga ta? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.46",
            "verseOrgIds": [
              "LUK.6.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 6:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mundu ounzitsilanga nahulila amakhuwa kanje nakakhola, ndalamumanyia shinga olwa afwana; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.47",
            "verseOrgIds": [
              "LUK.6.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 6:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "afwanana nende omundu owoombakha inzu, nayaba hasi muno, nakhupa omuse khulwanda; ne olwa emikhula chieetsa, omuchela nikukhupa inzu eyo namaani, nikuranyala okhuchireesia ta; okhuba yoombakhwa bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.48",
            "verseOrgIds": [
              "LUK.6.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 6:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ouhulilanga narakhola ta, afwanana nende omundu owoombakha inzu khwiloba aharali omuse ta; omuchela nikukhupa inzu eyo namaani, ne habwene nahabwene niyikwa; okhusasikha khweinzu eyo nikhuba okhukali muno.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.49",
            "verseOrgIds": [
              "LUK.6.49"
            ]
          }
        }
      ]
    }
  ],
