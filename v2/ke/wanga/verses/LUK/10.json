        "sid": "LUK 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amakhumi-musaafu barumwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho inyuma wamakhuwa ako Omwami yaraho abandi amakhumi musaafu, nabaruma babili babili imbeliwe mubuli litaala nende buli handu hosi ewa omwene yali nali okhutsia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.1",
            "verseOrgIds": [
              "LUK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasunjila ari Lichesa nelikhongo, habula abakholi nabatuutu; kho musaaye Omwami omwenechesa mbu arume abakholi mwichesalie. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.2",
            "verseOrgIds": [
              "LUK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutsie khunjila tsieenywe; lole, emuruma shinga ebimeeme biamakondi hakari mubisuutse. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.3",
            "verseOrgIds": [
              "LUK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murachinga iloloti, kata omufuuko, kata ebilaaro ta; kata murashiesia omundu yesi khunjila tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.4",
            "verseOrgIds": [
              "LUK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne munzu yosi eya mwinjilamwo, ranjilile muboole mbu Omulembe kube munzu yino. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.5",
            "verseOrgIds": [
              "LUK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba nalimwo omundu womulembe, omulembe kweenywe kuleekhala khuye; ne nabulamwo, kho kulakalukha khwinywe khandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.6",
            "verseOrgIds": [
              "LUK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mutong'e munzu mwenomwo, nimuliitsamga nende okhunywa ebia bamuha; shichila omukholi wemilimo akwanile omushaarakwe. Murahuyahuyanga okhurula omwo okhwinjila omwo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.7",
            "verseOrgIds": [
              "LUK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne litaala liosi elia mwinjilamwo, nibamwinjisia, liitsenje khubienebio ebia bamurenjeshela; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.8",
            "verseOrgIds": [
              "LUK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichandi muhoninjie abalwale ababa nibalimwo, nimubasunjila muri Obwami bwaNyasaye busitile ahambi nineenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.9",
            "verseOrgIds": [
              "LUK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne litaala liosi elia mwinjilamwo, nibaramwinjisia ta, mutsie ebulafu munjila tsialio, nimuboola muri ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.10",
            "verseOrgIds": [
              "LUK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata olufu Iwelitaala lieenywe oluhandile khubilenje bieefwe, khulweyanga nikhumufukula; nebutswa mumanye lino, mbu obwami bwaNyasaye busitile ahambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.11",
            "verseOrgIds": [
              "LUK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela mbu kalibakhwo amaangu khunduukho eyo khulwa Sodomu, okhushila shinga olwa kalibeela litaala lieenelo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.12",
            "verseOrgIds": [
              "LUK.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Woowe khumatookho akareekalukhasia ta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.12",
            "verseOrgIds": [
              "LUK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woowe khwiwe, Korazini! Woowe khwiwe, Betsesaida! Shichila emilimo chiamakana echiakholelwa mwinywe chilaba nichiakholelwa muTiro nende Sidoni, khane bakheekalukhasiye khale, nibeekhaale nibeefwalile amakunia nibeepuuka likoshe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa kalibakhwo amaangu khulwa Tiro nende Sidoni mushiina okhushila shinga olwa kalimubeela inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, Kaperinaumu, witsa okhuchinguulwa mwikulu? Mbula, witsa okhwisibwa okhuula eMakombe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oumuhulila inywe, yambulila isie; noumufukula inywe, yafukula isie; noufukula isie amafukula oyo owaruma.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amakhumi-musaafu abo bakalukha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abo amakhumi musaafu bakalukha nibasunga bari Omwami kata amadimoni kakhuhulilanga khulwa eliiralio. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.17",
            "verseOrgIds": [
              "LUK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabasunjila ari Ndamuluutsi Setani nakwile shinga oluhenu, okhurula mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, ndamuheele obunyali okhuseena khunzokha nende khumakatia, nende khubunyali bwosi bwomusuku oyo, kata shibulaho eshilamusaalisiakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.19",
            "verseOrgIds": [
              "LUK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula mureekhoyelanga ako, mbu abaroho bamuhulilanga, ta; ne mwikhoyenje shichila ameera keenywe kahandiikwa mwikulu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.20",
            "verseOrgIds": [
              "LUK.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwikhoya khwaYesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.20",
            "verseOrgIds": [
              "LUK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khushise shieneshio yeekhoya muRoho Omutakatifu, naboola mbu E Papa, Omwami welikulu nende eshibala, ekhuupila orio shinga olwa wabisa abachesi nabarechelefu amakhuwa kano, nokabisulila abaana abahele; orio, Papa, okhuba nolwa kakaasa imbeliwo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.21",
            "verseOrgIds": [
              "LUK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papa yambeelesia ebindu biosi; ne abulaho oumanyile Omwana, mbu niye wina, habula Samwana; kata Papa, mbu niye wina, habula Omwana, nende omundu yesi owa Omwana achama okhumubisulila.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.22",
            "verseOrgIds": [
              "LUK.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.22",
            "verseOrgIds": [
              "LUK.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nashiukhanila abeechibe, nabasunjila mabiswi, ari Netsieikhabi tsimoni etsilolanga ebia mulolanga inywe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila emuboolela mbu abanabii abanji nende abaruchi abanji bali nibeekombanga okhulola ebia mulolenga inywe, nibarabilola ta; nokhuhulila aka muhulilanga inywe, nibarakahulila ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.24",
            "verseOrgIds": [
              "LUK.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "OmuSamaria omulayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.24",
            "verseOrgIds": [
              "LUK.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lola, omukhulundu wamalako undi nasinjila namuteema, ari Omwechesia, nekhole endie mbu mana enaamilwe obulamu bwobumeli? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.25",
            "verseOrgIds": [
              "LUK.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namureeba mbu Kahandiikwa karie mumalako? Osoomanga orie? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.26",
            "verseOrgIds": [
              "LUK.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakalusia, nasunga mbu Omuheelenje Omwami Nyasayewo nende omwoyokwo kwosi neshiimoshio shiosi namaaniko kosi, nende obuyililisibwo bwosi; nende owashio shinga olwa wiheela omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.27",
            "verseOrgIds": [
              "LUK.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namuboolela mbu Okalusiye habwene; kholanga orio, mana olabeetsanga nobulamu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.28",
            "verseOrgIds": [
              "LUK.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.28",
            "verseOrgIds": [
              "LUK.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye niyeenya okhwiha obulunjishi; kho yamureeba Yesu ari Ne owashianje niye wina? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.29",
            "verseOrgIds": [
              "LUK.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nakalusia naboola mbu Omundu undi yali nakholomokha narula eYerusalemu okhutsia eYeriko; nakwa mubanuuli, nabo nibamufwalula tsingubo nibamwara tsinguma, nibatsia, nibamulekha nali shinga oufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.30",
            "verseOrgIds": [
              "LUK.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho keekhola mbu omukuhani undi yali nakholomoshela khunjila eyo; ne olwa yamulola, nabira elubeka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.31",
            "verseOrgIds": [
              "LUK.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omuLawi yesi ario, olwa yoolaho namulola, yabira elubeka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.32",
            "verseOrgIds": [
              "LUK.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omuSamaria undi olwa yali nali khuluchendo, yoolaho ewa yali; ne olwa yamulola, eshisa shiamutiila, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.33",
            "verseOrgIds": [
              "LUK.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "natsia ewa yali, naboha tsingumatsie, natsukhakhwo amafura nende idivai; namuniinia khumuruko okwa yali nachendelangakhwo, namuyila enanzu yobucheni, namukasilia bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.34",
            "verseOrgIds": [
              "LUK.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba yayinia tsitinari tsibili, natsiheelesia omwenenzu, naboola mbu Omulinde bulayi; ne etsia wakheekhoonyele nitsiakhashila tsino, isie ninjeleele ndalakhurunga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.35",
            "verseOrgIds": [
              "LUK.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluutsi orie, khubeenabo bataru niwina oweekhola owashie khumwenoyo owakwa mubanuuli? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.36",
            "verseOrgIds": [
              "LUK.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia mbu Oyo owamubeela tsimbabasi. Yesu namubiila ari Nawe tsia, okholenje orio.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yacheniha ewaMaritsa naMariamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa bali khunjila nibashitsia, yeenjila mwitaala lindi; mana omukhaana undi oweliiralie mbu Maritsa yamwinjisia munzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.38",
            "verseOrgIds": [
              "LUK.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali nomukhaana wabwe oulangwa mbu Mariamu; naye niyeekhala hamakulu kaYesu, nahulilanga amakhuwake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.39",
            "verseOrgIds": [
              "LUK.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Maritsa yali natiyiishe khulwa obunji bwokhutitiikhana; namwitsila, naboola mbu Omwami, shioteebakhwo likhuwa khumukhaana weefwe, shinga olwa yandeshile okhutitiikhana sienyene? Kho omubiile yakhoonye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.40",
            "verseOrgIds": [
              "LUK.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Omwami nakalusia, namusunjila ari Maritsa, Maritsa ohendelanga nofulukhanila ebindu ebinji; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.41",
            "verseOrgIds": [
              "LUK.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne eshienywa neshindu shilala shionyene; okhuba Mariamu yeeloboleele omukabo omulayi, okuramubukulwakhwo ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.42",
            "verseOrgIds": [
              "LUK.10.42"
            ]
          }
        }
      ]
    }
  ],
