          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela mbu mushilo shieneshio abandu babili baliba nibali khushitali shilala; mulala alibukulwa, oundi alilekhwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
