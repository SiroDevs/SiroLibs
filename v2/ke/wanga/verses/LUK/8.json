          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibamutseshelela butswa, okhuba bamanya mbu amalile okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.53",
            "verseOrgIds": [
              "LUK.8.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namutiila omukhono, naIanga ari Omukhaana, buukha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.54",
            "verseOrgIds": [
              "LUK.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoyokwe nikukalukha, nabuukha nonoho; nababiila mbu bamuheelesie eshiokhulia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.55",
            "verseOrgIds": [
              "LUK.8.55"
            ]
          }
        },
        {
          "name": "verse",
