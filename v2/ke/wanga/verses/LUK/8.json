              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosi bali nibamwikhuulanga, nibakhupa tsimbungu; naye nasunga mbu Mureekhuula ta; shichila shiafwile tawe; akonanga butswa tsindoolo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.52",
            "verseOrgIds": [
              "LUK.8.52"
            ]
          }
        },
        {
          "name": "verse",
