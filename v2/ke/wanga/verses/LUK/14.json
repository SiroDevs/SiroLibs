          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bari Omundu uno yachaaka okhuumbakha, naranyala okhumalilisia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.30",
            "verseOrgIds": [
              "LUK.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iiata nimuruchi shiina outsiitsanga okhwakaana nende omuruchi undi khwihe, nararanjilila weekhala nayililisia naba niyakhanyala okhwakaana nende oyo owitsa okhumuseera nende abandu ebikhumila amakhumi kabili, omwene olwa ali nende ebikhumila likhumi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa oundi oyo olwa ashili ehale, aruma oburume nareeba akakhoyeele omulembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho kario omundu yesi mwinywe ouralekha biosi ebia ali ninabio, shianyala okhuba omwechi wanje ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.33",
            "verseOrgIds": [
              "LUK.14.33"
            ]
          }
        }
