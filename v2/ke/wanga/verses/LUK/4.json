            "number": "42",
            "style": "v",
            "sid": "LUK 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa eshialo bwashia, yarula natsia aha abandu babula; abemikanda nabo nibamukhaaba, nibeetsa ewa yali, nibeenya okhumwikalila, mbu aleshe okhubarulakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.42",
            "verseOrgIds": [
              "LUK.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yabasunjila mbu Ekhoyile okhubeelwatsila abomumataala kandi nabo Amakhuwa Amalayi akObwami bwaNyasaye; niko akachila ndarumwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.43",
            "verseOrgIds": [
              "LUK.4.43"
            ]
          }
        }
      ]
    },
