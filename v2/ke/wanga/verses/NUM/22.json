          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mutsuli Balaki nabukula Balaamu namutikulusia namuyila eBamotsi-Baali; nokhurula yaho yalola abandu abokhundulo abali ahambikhwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
        }
