          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lileesi liOMWAMI niliba ikulu wabwe mushiteere, olwa babuusinjia oluchendo okhurula mukambi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
