              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli olwa lisanduku liarulanga, Musa yasunganga mbu E OMWAMI, obuushe, abasukubo basalaasibwe, abakhukiyanga nabo bakhwilushe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
