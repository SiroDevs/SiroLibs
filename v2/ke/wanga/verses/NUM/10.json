              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibarula khushikulu shiOMWAMI oluchendo lwetsindaalo tsitam; ne Hsanduku iieindakano yOMWAMI liabaranjilila imbeli khuluchendo lwetsindaalo tsitaru, okhubakhaabila obuhuluushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
