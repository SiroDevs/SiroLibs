        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa mbu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.17",
            "verseOrgIds": [
              "NUM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli ori Olwa muba nimwinjiile mushibala eshia emuyilayo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.18",
            "verseOrgIds": [
              "NUM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho olwa muba nimuliakhwo khubiliibwa bieshibala eshio, muhaanile OMWAMI isadaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.19",
            "verseOrgIds": [
              "NUM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubusie bweenywe obuhandaale obwambeli, muhaane eliandasi libe isadaka; shinga olwa mukholanga isadaka yolutse, mushihaane murio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.20",
            "verseOrgIds": [
              "NUM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iihubusie bweenywe obuhandaale obwambeli, muhaanilenje OMWAMI isadaka munzibulo tsieenywe tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa muba nimukosile, nimurakhola akamalako kano kosi aka OMWAMI yaboolela Musa ta, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.22",
            "verseOrgIds": [
              "NUM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko kosi aka OMWAMI yamulaka mumunwa kwaMusa, okhurula khunyanga olwa OMWAMI yalachilisia, nokhutsiililila khurio munzibulo tsieenywe tsiosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho kabe kari nanwa; mbu niliba niliakholwa khulwa okhukorwa, abomukhung'aano nibaramanyilenje ta, kho abomukhung'aano kwosi baleere ihuunwa ndala yomusango kwokhusambwa, khulwa eshiuya eshilayi khuMWAMI, halala nomusango kweimele kwayo, nomusango kwokhutsushila kwayo, obukhalachi shinga olwa buli; khandi ikhole ndala yomusango kwobwonooni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.24",
            "verseOrgIds": [
              "NUM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani atise omukhung'aano kwosi kwabaana baIsiraeli, nabo balaleshelwaokhuba liali likosa, ne bulaano baleerile eshihaanwa shiabwe, mbu eshihaanwa eshikholelwa omulilo khuMWAMI khandi nende omusango kwabwe kwobwonooni imbeli wOMWAMI, khulwa likosa liabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.25",
            "verseOrgIds": [
              "NUM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omukhung'aano kwosi kwabaana baIsiraeli baleshelwe, halala nomurende ouba namenya mubo; okhuba khulubeka lwabandu bosi, liakholwa khulwa okhukorwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu mulala naba niyoonoona khulwa okhukorwa, kho aleere imbusi isibiini yomuyika mulala eyomusango kwobwonooni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.27",
            "verseOrgIds": [
              "NUM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani atise omundu oyo owakosa, olwa yoonoona khulwa okhukorwa, imbeli w, okhumutisa; mana alaleshelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
            "verseOrgIds": [
              "NUM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mube namalalio malala khulwoyo oukhola likhuwa liosi khulwa okhukorwa, khulwoyo ouli omwibule mubaana baIsiraeli, khandi khulwa omurende ouba namenya mubo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.29",
            "verseOrgIds": [
              "NUM.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omundu oukhola likhuwa liosi chiminiyai, kata nali omwibule kata omurende, omwenoyo anyekanga OMWAMI; omundu oyo yaakamibwe mubandu babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba yaleka likhuwa liaNyasaye, niyoonoonia lilakolie, omundu oyo yaakamilibwe elala; obumayaanubwe bube khuye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Owoonooninjia isabato yalaswa namachina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa abaana baIsiraeli bali nibali mushitsiimi banyoola omundu nareenya tsikhwi khunyanga yaSabato. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.32",
            "verseOrgIds": [
              "NUM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abamunyoola nareenya bamuleera khuMusa naHaruni, nokhumukhung'aano kwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.33",
            "verseOrgIds": [
              "NUM.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamura mundindi, shichila shikali nikarumbuulwe aka akhoyile okhukholelwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.34",
            "verseOrgIds": [
              "NUM.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Musa mbu Omundu oyo yeerwe bwirwa; abomukhung'aano kwosi bamulase namachina elwanyi weikambi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.35",
            "verseOrgIds": [
              "NUM.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomukhung'aano kwosi nibamuyila elwanyi weil ambi, nibamulasa namachina, nafwa; shinga OMWAMI olwa yamulaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akamayebeyo khubiifwalo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
