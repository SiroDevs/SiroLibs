          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.37",
            "verseOrgIds": [
              "NUM.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli nobabiila mbu bakhole amayebeyo khumikhanda chietsingubo tsiabwe munzibulo tsiabwe tsiosi, khandi mbu khumayebeyo kabuli mukhanda barekhwo olutsaha Iweibuluu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.38",
            "verseOrgIds": [
              "NUM.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nako kalaba khwinywe amayebeyo akokhuhenga nimwitsulila amalako kosi kOMWAMI, nimukakhola; mbu muleshenje okhulonda akemioyo chieenywe netsimoni tsieenywe, ebia muyinyanga okhulonda shinga abaheyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
            "verseOrgIds": [
              "NUM.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mwitsulilenje amalako kanje kosi, nimukakhola, nimuba abatakatifu khuNyasaye weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.40",
            "verseOrgIds": [
              "NUM.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nisie OMWAMI Nyasaye weenywe, owamurusia mushibala shiaMisiri, mbu embe Nyasaye weenywe; nisie OMWAMI Nyasaye weenywe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        }
