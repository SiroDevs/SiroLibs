            "number": "1",
            "style": "v",
            "sid": "NUM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa mbu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.1",
            "verseOrgIds": [
              "NUM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli ori Olwa muba nimwinjiile mushialo eshia muli okhumenyamwo, eshia emuheelesia, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.2",
            "verseOrgIds": [
              "NUM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimuhaanila OMWAMI okhurula mubiayo kata mung'ombe eshihaanwa eshikholelwa omulilo, mbu omusango omusambe, kata omusango kundi, okhuusia eshiitsubo, kata eshihaanwa eshia ohaana khulwa okhuchama, kata munduukho tsiamasabo, okhukholela OMWAMI eshiuya eshilayi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho ouleera eshihaanwashie aleerele OMWAMI omusango kweimele, mbu eshitonye shielikhumi shia efa yobusie obunyushe obutsokasiibwemwo amafura eshitonye shiakhane shia hini ndala; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende idivai yomusango kwokhutsushila, eshitonye shiakhane shia hini, ochikasie halala nomusango omusambe kata omusango kundi, khulwa likondi lieshimwamwane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.5",
            "verseOrgIds": [
              "NUM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata khulwa limiiku, okasie omusango kweimele, mbu ebitonye bibili bielikhumi bia efa yobusia obunyushe obutsokasiibwemwo amafura eshitonye shiakhataru shia hini; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khulwa omusango kwokhutsushila oleere idivai eshitonye shiakhataru shia hini, eyeshiuya eshilayi khuMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.7",
            "verseOrgIds": [
              "NUM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa oba nokasia ing'ombe khulwa omusango omusambe, kata omusango kundi, okhuusia eshiitsubo, kata khulwa omusango kundi khwishia khuMWAMI, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.8",
            "verseOrgIds": [
              "NUM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho halala neing'ombe tsana, ouhaana aleere omlusango kweimele, mbu ebitonye bitaru bielikhumi bia efa yobusie obunyushe obutsokasiibwemwo amafura inusu ya hini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.9",
            "verseOrgIds": [
              "NUM.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oleere khulwa omusango kwokhutsushila idivai inusu ya hini khulwa eshihaanwa eshikholelwa omulilo, shieshiuya eshilayi khuMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa okholele buli surusi, kata buli limiiku, kata buli likondi lieshimwamwane, kata buli shimeeme shieimbusi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.11",
            "verseOrgIds": [
              "NUM.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunji bwabio ebia okasinjia shinga olwa buli, nolwa okholele buli shilala, obunji bwabio shinga olwa buli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.12",
            "verseOrgIds": [
              "NUM.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosi abali abeebule bakhole amakhuwa kano khunjila yino, nibaleera eshihaanwa eshikholelwa omulilo, shieshiuya eshilayi khuMWAMI ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omurende naba namenya mwinywe, kata omundu yesi oubeetsanga mwinywe munzibulo tsieenywe, niyeenya okhuleera eshihaanwa eshikholelwa omulilo, shieshiuya eshilayi khuMWAMI, kho akhole shinga inywe olwa mukholanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubelibukana, Iilako lilabeetsangaho elala, khulweenywe khandi khulwa omurende ouba namenya mwinywe, lilako elilabeetsangaho tsindaalo tsiosi munzibulo tsieenywe tsiosi; shinga inywe olwa muli, nolwa omurende oyo alabeetsanga ario imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalako kabe malala, khandi obukhalachi bulala, khulweenywe khandi khulwa omurende oumenya mwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
