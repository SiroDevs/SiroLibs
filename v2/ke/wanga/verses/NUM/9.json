    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omulukha kwaPasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa mushitsiimi shieSinai, mumwesi kwambeli okwomumuyika kwakhabili okwalonda khukhurula khwabwe mushialo shiaMisiri; ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli bakhole ipasaka munduukho yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2",
            "verseOrgIds": [
              "NUM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwesi kuno nikuli ekhumi nakhane, khubwile, muchikhole munduukho yayo; muchikhole shinga akalachilisibwa khuyo nende akakhalakwa khuyo kosi olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.3",
            "verseOrgIds": [
              "NUM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Musa naboolela abaana balsiraeli mbu bakhole ipasaka; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.4",
            "verseOrgIds": [
              "NUM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibachikhola ipasaka tsana mumwesi kwambeli, khunyanga yekhumi nakhane mumwesi, khubwile, mushitsiimi shieSinai; kosi aka OMWAMI yamulaka Musa shinga olwa kali, nolwa abaana baIsiraeli bakhola bario. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne baliho abasaatsa bandi abali mwibilu khulwa omulambo kwomundu, nibaranyala okhukhola ipasaka khunyanga yeneyo ta; nabo niboola imbeli waMusa naHaruni khunyanga yeneyo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.6",
            "verseOrgIds": [
              "NUM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "abasaatsa tsana nibamureeba bari Ifwe khuli mwibilu khulwa omulambo kwomundu; ne khwikalilwa mbushiina, oburaleera eshihaanwa shiOMWAMI munduukho yashio halala nabaana baIsiraeli ta? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Musa nabasunjila ari Linde mbeli, embulile aka OMWAMI yeetsa okhulaka khukeenywe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli mbu Omundu yesi khwinywe, kata owokhunzibulo tsieenywe, naba nali mwibilu khulwa obukaali bwomulambo, kata naba khuluchendo Iwehale, kata kario akholele OMWAMI ipasaka ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.10",
            "verseOrgIds": [
              "NUM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "bachikhole mumwesi kwakhabili, khunyanga yekhumi nakhane, khubwile; bachilie halala nemikaate echibulamwo amamela nende eliani lilulu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.11",
            "verseOrgIds": [
              "NUM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "baralekhakhwo eshitonye shiosi shitong'e okhuula mukamba, kata okhufunaka likumba liayo ta; akalachilisibwa khupasaka kosi shinga olwa kali, nolwa balachikhola bario. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omundu yesi ouba nali omusiiye narali khuluchendo ta, ne nachweya okhukhoia ipasaka, omwenoyo yaakamibwe okhurula mubandu babwe; okhuba shiyaleerile eshihaanwa shiOMWAMI munduukho yashio, kho omundu oyo aleetuukha obwonoonibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omurende naba namenya mwinywe, niyeenya okhumukholela OMWAMI ipasaka, akalachilisibwa khupasaka nakakhalakwa khupasaka kosi shinga olwa kali, akholenje ario; mubeetsenje nelilako elala kata khulwa omurende kata khulwa omwibule.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lileesi liafuunikha eshimenyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga olwa eshimenyo shiasinjisibwa, lileesi tsana liafuunikha eshimenyo, nilio liheema lioburumbusi; ne nibwilile, liali nililikhwo khushimenyo nililolekha shinga omulilo, okhuula olwa bwashia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.15",
            "verseOrgIds": [
              "NUM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nolwa kali kario tsindaalo tsiosi; mbu lileesi liashifuunikhanga, nililolekha shinga omulilo mushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.16",
            "verseOrgIds": [
              "NUM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli olwa lileesi liarusibungwakhwo kekulu weliheema, kho olunyumakhwo abaana baIsiraeli babuusia oluchendo; ne habundu ewa lileesi lieekhala, habwenaho abaana baIsiraeli bakhomanga ikambi yabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.17",
            "verseOrgIds": [
              "NUM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwilako liOMWAMI abaana baIsiraeli bachendanga, khandi khwilako liOMWAMI bakhomanga ikambi; ne olwa lileesi lieekhala khushimenyo, bamenyayo mukambi yabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.18",
            "verseOrgIds": [
              "NUM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata olwa lileesi liashinda khushimenyo tsindaalo tsinyinji, abaana baIsiraeli balinda aka balachilisibwa nOMWAMI, nibarabuusia oluchendo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata olundi lileesi liabeetsanga khwiheema tsindaalo tsinduutu; mana lilako liOMWAMI shinga olwa liali, bamenyanga mukambi yabwe; ne lilako liOMWAMI shinga olwa liali, bachendanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.20",
            "verseOrgIds": [
              "NUM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olundi lileesi lialiho okhurula khubwile okhuula olwa bwashia; ne olwa lileesi liarusibwaho mumabwibwi, babuusinjia oluchendo; Ikata nilibayo eshiteere nende eshilo, olwa lileesi liarusibwaho babuusinjia oluchendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.21",
            "verseOrgIds": [
              "NUM.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nitsialinji tsindaalo tsibili, kata nikuba omwesi, kata omuyika, olwa lileesi liali nilishishindile khushimenyo, niliikhaale khushio, abaana baIsiraeli bamenyanga mukambi yabwe, nibarabuusiakhwo oluchendo ta; ne olwa liarusibwakhwo, babuusinjiakhwo oluchendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.22",
            "verseOrgIds": [
              "NUM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwilako liOMWAMI bakhupanga ikambi, khandi khwilako liOMWAMI babuusinjia tsinjendo; balindanga aka balachilisibwa nOMWAMI, khwilako liOMWAMI mumunwa kwaMusa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.23",
            "verseOrgIds": [
              "NUM.9.23"
            ]
          }
        }
      ]
    }
  ],
