          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuKanaani ulia, omuruchi waAradi, owamenya muNegebu mushialo shiaKanaani, yahulila akokhwitsa kwabaana baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
