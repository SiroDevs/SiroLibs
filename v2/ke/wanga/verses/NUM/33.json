              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibarula eKadeshi, nibakhupa ikambi mushikulu shiaHori, khundulo weshialo shiaEdomu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.37",
            "verseOrgIds": [
              "NUM.33.37"
            ]
          }
        }
      ]
