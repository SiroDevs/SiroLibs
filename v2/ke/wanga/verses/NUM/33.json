          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Haruni omukuhani yaniina natsia khushikulu shiaHori olwa OMWAMI yamulaka, nafwilayo, mumuyika kwamakhumi kane olunyuma olwa abaana baIsiraeli bali nibarulile mushialo shiaMisiri, mumwesi kwakharaano, khunyanga yambeli yomwesi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38",
            "verseOrgIds": [
              "NUM.33.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 33:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Haruni yali owemiyika eshikhumi amakhumi kabili nachitaru olwa yafwila khushikulu shiaHori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
            "verseOrgIds": [
              "NUM.33.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
