            "number": "1",
            "style": "v",
            "sid": "NUM 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.1",
            "verseOrgIds": [
              "NUM.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sungana nabaana baIsiraeli, nobukula okhurula mumakhono kabwe tsindabushi, ndala khulwa buli shilibwa, khubakhulundu bebilibwa biabwe shinga olwa bali, mbu tsindabushi ekhumi natsibili; nohandiika eliira liabuli mundu khundabushiye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.2",
            "verseOrgIds": [
              "NUM.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohandiiche eliira liaHaruni khundabushi yaLawi; okhuba indabushi yilabaho ndala khulwa buli mwimilisi weshilibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.3",
            "verseOrgIds": [
              "NUM.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana otsibiishe mwiheema liokhwakaana imbeli wOburumbusi tsana, ewa enzakaanilanga nineenyu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.4",
            "verseOrgIds": [
              "NUM.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kalaba mbu omundu owa ndalalobola, indabushiye yilakanikha; nolwa ndaleeyakamilia obubuutsuluuli bwabaana baIsiraeli, obwa bamubuutsuluulilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa nasungana nabaana baIsiraeli, ne abakhulundu babwe bosi nibamuheelesia tsindabushi, ndala yabuli mukhulundu, ebilibwa biabwe shinga olwa biali, mbu tsindabushi ekhumi natsibili; nayo indabushi yaHaruni yali niyili mundabushi tsiabwe ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.6",
            "verseOrgIds": [
              "NUM.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nabiikha tsindabushi etsio imbeli wOMWAMI mwiheema liOburumbusi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba Musa niyeenjila mwiheema liOburumbusi; ne lole, indabushi yaHaruni eyali yeinzu yaLawi yali niyikaniishe, niyirusia amakanikha, niyimulikha ebimuli, niyama amalusi ameengu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.8",
            "verseOrgIds": [
              "NUM.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa narusia tsindabushi etsio tsiosi okhurula ewa tsiali imbeli wOMWAMI, natsileera ewa abaana baIsiraeli bali nabo nibahenga, nibabukula buli mundu indabushiye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Musa mbu Kalusia indabushi yaHaruni imbeli wOburumbusi, yibiikhwe yibe eshilolelo okhufukula abeinduli; mbu wakamilie elala okhubuutsuluula khwabwe okhwa bambuutsuluulilanga, baleshe okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nakhola ario; shinga OMWAMI olwa yamulaka, nindio yakhola.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli nibasunjila Musa bari Lola, khuli okhusikha; khuhweele; fwesi khuhweele pe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mundu yesi ousita ahambi, ousitila eshimenyo shiOMWAMI ahambi, afwitsanga. Khulasikha fwesi noho?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.13",
            "verseOrgIds": [
              "NUM.17.13"
            ]
          }
        }
      ]
    }
  ],
