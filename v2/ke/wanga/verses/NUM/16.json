          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.36",
            "verseOrgIds": [
              "NUM.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela Eleazari womukuhani Haruni mbu atoole ebikaye ebio mubuyii; nawe osalaasie omulilo kulia ehale. Okhuba nebitakatifu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.37",
            "verseOrgIds": [
              "NUM.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebikaye bino biabandu aboonoona nibarunjibwa obulamu bwabwe bwene. Biiraanywe amabaati amapaapale khulwa eshifuunikho shieshimalilo shiemisango; okhuba babihaana imbeli w, niko akachila nibili ebitakatifu. Bibe birio eshilolelo khubaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.38",
            "verseOrgIds": [
              "NUM.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Eleazari omukuhani yabukula ebikaye ebio biomukasa, ebia abasambwa balia bali nibahaanile; nibabiiraanya bibe eshifuunikho shieshimalilo shiemisango; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.39",
            "verseOrgIds": [
              "NUM.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu shibe eshiitsulilo khubaana baIsiraeli, mbu oundi yesi ourali owokhubeetsukhulu baHaruni ta aleshe okhusita ahambi okhusamba amalesi kelibuuliesi imbeli wOMWAMI; aleshe okhuba shinga Kora nabomukandakwe. Nikeekhola shinga olwa yasunjila Eleazari mumunwa kwaMusa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.16.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
