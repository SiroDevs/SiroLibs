          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu olwa yali niyakhamala okhuboola amakhuwa ako kosi, liloba elia baliho liatikha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.31",
            "verseOrgIds": [
              "NUM.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "liloba liene niliasama omunwa nilibamila bukala, nabomunzu tsiabwe, nabandu bosi abali baKora, nende emiandu chiabwe chiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.32",
            "verseOrgIds": [
              "NUM.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abeene nibeekha nibatsia eMakombe nibali mwoyo, nende biosi ebia bali ninabio, liloba niliyikala ikulu wabwe, nibasikha okhurula mwibukaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.33",
            "verseOrgIds": [
              "NUM.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaIsiraeli bosi abali nibabotokhaane nibeelukha olwa bahulila tsimbungu tsiabwe; okhuba baboola mbu Liloba liakhakhumila! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.34",
            "verseOrgIds": [
              "NUM.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omulilo nikurula ewOMWAMI, nikumala abandu abo ebikhumi bibili namakhumi karaano abali nibasambile amalesi kelibuuliesi tsana, kutu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        }
      ]
