          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa OMWAMI naba nakhola likhuwa liyiakha, liloba liene niliasama omunwa nilibamila bukala, nende ebiabwe biosi pe, nibeekha nibatsia eMakombe nibali mwoyo, kho mumanye mbu abandu bano bamufwolile OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        }
      ]
    },
    {
