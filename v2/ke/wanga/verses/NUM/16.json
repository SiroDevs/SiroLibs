          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa bwashia mukamba abomukhung'aano kwosi kwabaana baIsiraeli babuutsuluulila Musa naHaruni, bari Kho mwirile abandu bOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.41",
            "verseOrgIds": [
              "NUM.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu olwa omukhung'aano kwosi kwali nikukhung'aanile okhufukula Musa nokhufukula Haruni, bashiukhana nibahenga ebuneeheema liokhwakaana ne lole, lileesi elo liali nililifuuniishe, oluyaii lwOMWAMI nalwo nilulolekhaho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.42",
            "verseOrgIds": [
              "NUM.16.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 16:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa naHaruni nibeetsa hambeli heliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.43",
            "verseOrgIds": [
              "NUM.16.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 16:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Musa ari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.44",
            "verseOrgIds": [
              "NUM.16.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 16:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buushe murule mumukhung'aano kuno, mbu embamale shialwangu. Nabo nibasikama nibabunamia obweni bwabwe hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.45",
            "verseOrgIds": [
              "NUM.16.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 16:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nasunjila Haruni ari Bukula eshikayeshio, orekhwo omulilo okhurula khushimalilo shiemisango, nende amalesi kelibuuliesikhwo, oyile bwangu mumukhung'aano obatise; okhuba oburima buliho oburulile khuMWAMI; linyasio lioluumbe liakhachaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.46",
            "verseOrgIds": [
              "NUM.16.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 16:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Haruni nabukula ario shinga Musa olwa yamuboolela, niyeelukha natsia hakari welibukaana; ne lole, oluumbe lwali niluchaachile mubanuu; Kho yarakhwo amalesi Kelibuuliesi natisa abandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.47",
            "verseOrgIds": [
              "NUM.16.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 16:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasinjila hakari wabafu naba mwoyo; oluumbe nilwikalilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.48",
            "verseOrgIds": [
              "NUM.16.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 16:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abafwa khulwa oluumbe olwo bali ebikhumila ekhumi nabine nebikhumi musaafu, norabaliilekhwo ab abafwa khulwa likhuwa liaKora ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.49",
            "verseOrgIds": [
              "NUM.16.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 16:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Haruni nakalushila Musa, hamuliango weliheem liokhwakaana; oluumbe nalwo nilwikalilwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.50",
            "verseOrgIds": [
              "NUM.16.50"
            ]
          }
        }
      ]
