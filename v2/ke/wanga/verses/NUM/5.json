            "number": "1",
            "style": "v",
            "sid": "NUM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa, ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.1",
            "verseOrgIds": [
              "NUM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laka abaana baIsiraeli mbu barusie mukambi buli mundu wobuchele, nabuli mundu oulwala eshisununu, nende omundu yesi owakhaba nali mwibilu khulwa okhutiila khumufu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.2",
            "verseOrgIds": [
              "NUM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abasaatsa kata abakhasi, mubarusinjie bosi, nimubayila elwanyi weikambi, baleshe okhwonoonia ikambi yabwe eya emenyile hakari wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.3",
            "verseOrgIds": [
              "NUM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibakhola bario, nibabarusia elwanyi weikambi; shinga OMWAMI olwa yaboolela Musa, nindio abaana baIsiraeli bakhola.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalako khukokhukalusia ebindu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.5",
            "verseOrgIds": [
              "NUM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli mbu Olwa omundu, kata omusaatsa kata omukhasi, yoonoona eshionoono shiosi eshia abandu boonoonanga, okhukholela OMWAMI akobukhobani, omundu tsana naba neshiuku toto, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho yeeyame eshionoonoshie eshia akholile; mana akalusie biosi bieshiukushie natasakhwo eshitonye shiakharaano, namuheelesia omundu tsana owa yoonoonela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.7",
            "verseOrgIds": [
              "NUM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba nabulaho omundu yesi owoluyia lwabwe omundu tsana, owakhanyala okhukalusilibwa ebieshiuku ta, ebieshiuku tsana bikalusilibwe OMWAMI, bibe biomukuhani; khandi nende limiiku lieshitiso, elia atiswe ninalio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi buli sadaka yosi ebindu ebitakatifu biosi biabaana baIsiraeli, ebia baleerela omukuhani, bibe ebibie. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebindu ebitaleatifu biabuli mundu bibe ebibie, buli shindu shiosi eshia omundu yesi aheelesia omukuhani, shibe eshishie.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalako khukeimbalikha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
