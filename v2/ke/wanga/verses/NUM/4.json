            "sid": "NUM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa naHaruni ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khaaba obunji bwabaana baKohatsi okhurula mubaana baLawi, munau tsiabwe khandi mubilibwa biabwe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.2",
            "verseOrgIds": [
              "NUM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhurula khubemiyika amakhumi kataru nende abashilaho, okhuula khubemiyika amakhumi karaano, bosi abeenjila mubukhalabani obwo, okhukhola emilimo chiomwiheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.3",
            "verseOrgIds": [
              "NUM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukhalabani bwabaana baKohatsi mwiheema liokhwakaana, khubindu ebiaahulilwa elala, mbwobuno; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu buli olwa ikambi yili okhurula, Haruni yeenjilemwo nende abaanabe, nibaakula ingubo ishinga yolwichi, nibafuunikha lisanduku lioburumbusi ninayo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana barekhwo eshifuunikho shiamaseelo amanyushe, nibaalakhwo ingubo yeibuluu ikhaya, nibeenjisiamwo tsinyanzo tsialio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana baale ingubo yeibuluu khumeesa yomukaate kwokhubaho khwanje, nibarakhwo tsingaye, nemiikho, nebisanda, nemiendo chiayo echiokhutsushiilila; nakwo omukaate kwakhatsotso kube khuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.7",
            "verseOrgIds": [
              "NUM.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubindu ebio baalekhwo ingubo inzakhanyu, nibafuunikhakhwo eshifuunikho shiamaseelo amanyushe, nibeenjisiamwo tsiyanzo tsiayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babukule ingubo yeibuluu, nibafuunikha eshichibi shietsitaha tsiobulafu, netsitaha tsiashio, namahana kashio, netsindaabo, nebichinjilo biamafura biosi ebia beekhoonyelanga nibashikhalabanila ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.9",
            "verseOrgIds": [
              "NUM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibashiinjisia, halala nebimanulwa biashio biosi, mushifuunikho shiamaseelo amanyushe, nibashira khumusekaseka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana baale ingubo yeibuluu khushimalilo shieitsahaabu, nibafuunikhakhwo eshifuunikho shiamaseelo amanyushe, nibeenjisiamwo tsinyanzo tsiayo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.11",
            "verseOrgIds": [
              "NUM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibabukula ebimanulwa biosi biobukhalabani, ebia beekhoonyelanga nibakhalabanila habundu ahatakatifu, nibabifuuma mungubo yeibuluu, nibafuunikhakhwo eshifuunikho shiamaseelo amanyushe, nibabira khumusekaseka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.12",
            "verseOrgIds": [
              "NUM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayinieho likoshe eliokhushimalilo, nibaalakhwo ingubo yeisambarau; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.13",
            "verseOrgIds": [
              "NUM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibara khuyo ebimanulwa biashio biosi, ebia beekhoonyelanga nibakhalabanila enashimalilo, mbu tsindaabo tsiomulilo, namakhango, nemiikho, netsingaye, ebimanulwa biosi bieshimalilo; nibaala khushio eshifuunikho shiamaseelo amanyushe, nibeenjisiamwo tsinyanzo tsiashio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.14",
            "verseOrgIds": [
              "NUM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Haruni nabaanabe baba nibamalile okhufuunikha habundu ahatakatifu nebimanulwa biosi biahabundu ahatakatifu, ikambi niyili okhurula, olunyumakhwo abaana baKohatsi beetse okhubichinga; nebutswa baleshe okhutiilakhwo khubindu ebitakatifu; bakhafwa. Ebindu ebio nibio ebia abaana baKohatsi bachinga khubieliheema liokhwakaana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        }
      ]
    },
