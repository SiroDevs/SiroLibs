          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "netsisiilo tsiolwanyi olubotokhanaho, nebichibi biatsio, nebibambo biatsio, nemikoye chiatsio, nebimanulwa biatsio biosi, nebiobukhalabani bwatsio bwosi; ne olachilisie ebindu biene ebia baleshelwa okhuchinga, ameera kabio kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
              "NUM.4.32"
            ]
          }
        },
