          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ebileshelwa Eleazari waHaruni omukuhani nibio amafura ketsitaha, namalesi kelibuuliesi keisuuswa, nomusango kweimele kwakhatsotso, namafura akokhutsushiililwa; nende obusinjilili bweshimenyo shiosi, nobwabiosi ebilimwo, nahabundu ahatakatifu, nende ebimanulwa biaho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        }
      ]
