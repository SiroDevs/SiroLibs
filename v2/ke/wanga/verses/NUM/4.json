              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino nibio ebia baleshelwa okhuchinga, obukhalabani bwabwe bwosi mukeliheema liokhwakaana shinga olwa buli; mbu ebitiisi bieshimenyo netsisheti tsiabio, netsisiilo tsiabio, nebichibi biabio; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
