          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana akabaana baMerari; obabale munzu tsiabwe khandi mubilibwa biabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
