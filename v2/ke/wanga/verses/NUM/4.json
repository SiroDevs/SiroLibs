            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khaaba obunji bwabaana baGereshoni bosi, mubilibwa biabwe khandi munzu tsiabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhurula khubemiyika amakhumi kataru nende abashilaho okhuula khubemiyika amakhumi karaano, obabale; bosi abeenjila okhukhalabana mubukhalabani obwo, okhukhola emilimo echiomwiheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukhalabani bwabetsinzu tsiabaGereshoni mbwobuno, mukhukhalabana nokhuchinga emisiiko; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu bachinjenje tsingubo tsinzeleesia tsieshimenyo, neliheema liokhwakaana, neshifuunikho shialio, neshifuunikho shiamaseelo amanyushe eshibeetsanga hekulu khulio, nolwichi Iwomuliango kweliheema liokhwakaana; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "netsingubo tsinzeleesia tsiolwanyi, nolwichi Iwobwinjililo bweshilibwa shilwanyi oubotokhana eshimenyo neshimalilo shiemisango, nemikoye chiatsio, nebimanulwa biosi biobukhalabani bwatsio; balakhalabana nibakhola kosi akeenya okhutsikholelwa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.26",
            "verseOrgIds": [
              "NUM.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukhalabani bwosi bwabaana baGeresho bube shinga Haruni nabaanabe olwa balaka; mubiosi ebia bachinga nomukosi aka bakhola; mubalache ebia baleshelwa okhuchinga Shinf olwa bili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.27",
            "verseOrgIds": [
              "NUM.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno nibwo obukhalabani bwabetsinzu tsiabaana baGereshoni mukeliheema liokhwakaana; ne aka baleshelwa kabe mumukhor kwaItsamari waHaruni omukuhani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        }
      ]
    },
