            "sid": "NUM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nende Haruni babukula abandu abo aba ameera kabwe kakhatalwakhwo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibakhung'aasia omukhung'aano kwosi halala, khunyanga yambeli eyomumwesi kwakhabili; nabo nibarumbula aketsinzibulo tsiabwe, munzu tsiabwe khandi mubilibwa biabwe, obunji bwameera shinga olwa bwali, okhurula khubemiyika amakhumi kabili nende abashilaho, nibabalwa mulala mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga OMWAMI olwa yalaka Musa, nilwo olwa yababalila mushitsiimi shieSinai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        }
      ]
    },
    {
