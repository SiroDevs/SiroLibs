          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abo bosi ababalwa, abokhubaana baIsiraeli, mubilibwa biabwe, okhurula khubemiyika amakhumi kabili nende abashilaho, bosi muIsiraeli abatuushile okhutsia mwihe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
