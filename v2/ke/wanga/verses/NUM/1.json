          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abaLawi, khuluyia lwabakuuka babwe, shibabalilwa mubo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
            ]
          }
        },
