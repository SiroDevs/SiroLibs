        },
        {
          "text": "Abokhubaana baSimeoni, tsinzibulo tsiabwe mutsinzu tsiabwe kbandi mubilibwa biabwe, ababalwa khubo, obunji bwameera shinga olwa bwali, mulala mulala, buli musaatsa okhurula khubemiyika amakhumi kabili nende abashilaho, bosi abatuushile okhutsia mwihe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
