            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baReubeni, omwikulanda waIsiraeli tsinzibulo tsiabwe, mutsinzu tsiabwe khandi mubilibwa biabwe, obunji bwameera shinga olwa bwali, mulala mulala, buli musaatsa okhurula khubemiyika amakhumi kabili nende abashilaho, bosi abatuushile okhutsia mwihe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababalwa khubo, aboluyia lwaReubeni, bali ebikhumiia amakhumi kane nabisasaba nebikhumi biraano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
