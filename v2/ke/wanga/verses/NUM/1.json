            }
          ]
        },
        {
          "text": "abo bosi ababalwa bali ebikhumila ebikhumi bisasaba nabitaru ebikhumi biraano namakhumi karaano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.46",
