          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI yabeolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.48",
            "verseOrgIds": [
              "NUM.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluyia lwaLawi lwonyene oleshe okhulubala, kata okhukhaaba obunji bwabwe, mubaana baIsiraeli ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.49",
            "verseOrgIds": [
              "NUM.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa oreho abaLawi basinjilile amakhuwa keshimenyo shioburumbusi, nende ebimanulwa biashio, nende ebindu biashio biosi. Bachinjenje eshimenyo tsana, nebimanulwa biashio biosi; bashikhalabanilenje, nibakhola ikambi yabwe okhufumbila eshimenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.50",
            "verseOrgIds": [
              "NUM.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana buli olwa eshimenyo shili okhurula, abaLawi bashisambule ne buli olwa shili okhukhomwa, abaLawi bashisinjisie; ne oundi yesi ousita ahambi, yeerwe bwirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.51",
            "verseOrgIds": [
              "NUM.1.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli bakhomenje amaheema kabwe mumikanda chiabwe, buli mundu hakambi yabwe, khandi buli mundu hashilolelo shiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.52",
            "verseOrgIds": [
              "NUM.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abaLawi bakhomenje akabwe okhufumbila eshimenyo shioburumbusi, mbu oburima buleshe okhuba khumukhung'aano kwabaana baIsiraeli; khandi abaLawi balindenje eshimenyo shioburumbusi eshia baleshelwa okhulinda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.53",
            "verseOrgIds": [
              "NUM.1.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 1:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibakhola bario; shinga kosi aka OMWAMI yalaka Musa olwa kali, nilwo olwa bakhola.",
