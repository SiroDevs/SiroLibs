          "attrs": {
            "verseId": "EZK.23.45",
            "verseOrgIds": [
              "EZK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka Omwami NYASAYE aboola; mbu Buusia omukhung'aano khubo, nobakwisia eshiriisio nende eshiyaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.46",
            "verseOrgIds": [
              "EZK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomukhung'aano tsana balabalasa namachina, nibabarema netsinganga tsiabwe; baleera abaana babwe abasiani nabakhaana, nibasamba tsinzu tsiabwe nomulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.47",
            "verseOrgIds": [
              "EZK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa ndalaakamia obwilaasii mushialo, mbu abakhasi bosi bachesihe, nibaralonda khubwilaasii bweenywe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.48",
            "verseOrgIds": [
              "EZK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mularungwa khulwa obwilaasii bweenywe, ne muleetuukha obukuumwi bwebionoono biemindu tsana echia mwinamilanga; mana mulamanya mbu isie nisie Omwami NYASAYE.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.49",
            "verseOrgIds": [
              "EZK.23.49"
            ]
          }
        }
