        "style": "s1"
      },
      "items": [
        {
          "text": "Abakhaana babili abomunzu ndala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila khandi, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.1",
            "verseOrgIds": [
              "EZK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, baliho abakhasi babili, abakhaana abomunzu ndala; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.2",
            "verseOrgIds": [
              "EZK.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibakhola akobuheyi muMisiri mulubuukha lwabwe; ebweneyo tsimbeele tsiabwe tsiafwinywa, abandu nibatiilakhwo khumbeele tsiobushisila bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.3",
            "verseOrgIds": [
              "EZK.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameera kabwe ngakano, mbu Ohola omukhulundu, nende Oholiba omwana wabwe; nibaba abanje, nibeebula abaana abasiani nabakhaana. Khukameera kabwe, Samaria niye Ohola, naye Yerusalemu, Oholiba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.4",
            "verseOrgIds": [
              "EZK.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.4",
            "verseOrgIds": [
              "EZK.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ohola yakhola akobutamba olwa yali nali owanje; ne yeelaasia khubatiabe, nibo abaAshuru, abamenyanibe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.5",
            "verseOrgIds": [
              "EZK.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeefwalanga tsingubo tsieibuluu, nibali abakafuna naboburuchi, abasooliili abeenyekha bosi, abachendelanga khutsifarasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.6",
            "verseOrgIds": [
              "EZK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yahaana obutambabwe khubo, abalobole beAshuru bosi; ne omundu yesi owa yeelaasia ninaye, yeeyonoonia neminduchie echia yeenamilanga chiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.7",
            "verseOrgIds": [
              "EZK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shiyalekha obutambabwe obwa yakholanga okhurula khundaalo tsilia etsieMisiri ta; okhuba mulubuukhalwe bakona ninaye nibatiilakhwo khumbeele tsiolushisilalwe nibasundula akobuheyi bwabwe khuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.8",
            "verseOrgIds": [
              "EZK.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niko akachila nimuhaana mumakhono kabatiabe, mbu mumakhono kabaAshuru, aba yeelaasinjia ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.9",
            "verseOrgIds": [
              "EZK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibafuunula eshihechenyeshie; babukula abaanabe abasiani nabakhaana, nibamwira ye nolukanga; kho nakwa oluchelo mubakhasi; shichila bakhola obuyaasii khuye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.10",
            "verseOrgIds": [
              "EZK.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.10",
            "verseOrgIds": [
              "EZK.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Oholiba omukhaana wabwe nalola ako; nebutswa yamushila obubii mubwilaasiibwe nomubutambabwe, obwali obunji okhushila obutamba bwomukhaana wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.11",
            "verseOrgIds": [
              "EZK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeelaasia khubaAshuru, abakafuna naboburuchi, abamenyanibe, abeefwala nibeesiaha muno, abachendelanga khutsifarasi, abasooliili abeenyekha bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.12",
            "verseOrgIds": [
              "EZK.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi nindola mbu yoonoonekha; mbu bombi balonda khunjila ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.13",
            "verseOrgIds": [
              "EZK.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nameeta butswa obutambabwe; okhuba yalola ebifwanani biabasaatsa khwisiisi, amakondo kabaKalidayo nikang'oolwa neipala, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.14",
            "verseOrgIds": [
              "EZK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeboyile emishiipi mubishienje, nibakanyilwa ebilemba khumirwe, bosi nibalolekha shinga abakhulundu, mbu eshifwanani shiabaBabeli, abeebule beshialo shiebuKalidayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.15",
            "verseOrgIds": [
              "EZK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakhabalola, yeelaasia khubo, nabarumila abarume ebuKalidayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.16",
            "verseOrgIds": [
              "EZK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaBabeli abo nibamwitsila khushitali shiobuheeli, nibamwonoonia nobuheyi bwabwe; kho nakwa owobukaali khulwabwe; omwoyokwe nikubarulakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.17",
            "verseOrgIds": [
              "EZK.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yafuunula obutambabwe, nafuunula nende eshihechenyeshie; omwoyo kwanje nikumurulakhwo, shinga omwoyo kwanje olwa kwali nikurulile khumukhaana wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.18",
            "verseOrgIds": [
              "EZK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa yeenjiyia obutambabwe, niyeetsulila tsindaalo tsiolubuukhalwe, olwa yakholanga obutamba mushialo shiaMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.19",
            "verseOrgIds": [
              "EZK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeelaasia khubatiabe aba obusaatsa bwabwe bweengana obwetsisishili, nabatsukhanga shinga tsifarasi olwa tsitsukha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.20",
            "verseOrgIds": [
              "EZK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa witsulilanga obwilaasii bwolubuukhalwo, olwa abaMisiri bakhutiilakhwo khumbeele, khulwa tsimbeele tsiolubuukhalwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.21",
            "verseOrgIds": [
              "EZK.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.21",
            "verseOrgIds": [
              "EZK.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila, iwe Oholiba, kano niko aka Omwami NYASAHE aboola; mbu Lola, ndalabuusia abatiabo okhukhuseera, abo aba omwoyokwo kurulilekhwo; ndalabaleera okhukhuseera tsimbeka tsiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.22",
            "verseOrgIds": [
              "EZK.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu abaBabeli nabaKalidayo bosi Pekodi naShoa naKoa, nabaAshuru bosi halaia ninabo; abasooliili abeenyekha, abakafuna naboburuchi bosi, abeifuma, abachendela khutisfarasi bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.23",
            "verseOrgIds": [
              "EZK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleetsa okhukhuseera okhurula enotsi namakaari netsingarangarani, nomukanda omukhongo kwetsimbia tsiabandu; baleerenjekha okhukhuseera tsimbeka tsiosi, netsingabo nebikhumba netsikuutwa; ne ndalahaana obukhalachi mumakhono kabwe; nabo balakhalaka akoko, obuyaasii bwabwe shinga olwa buli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.24",
            "verseOrgIds": [
              "EZK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalaraho imbalikha yanje okhukhufukula; nabo balakhukholela nobululu; balakhurema amoolu nebirwi; abandubo abatong'a balakwa khulwa olukanga; balabukula abaanabo abasiani nabakhaana; mana abandubo abatong'a, omulilo kulabalia kutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.25",
            "verseOrgIds": [
              "EZK.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi balakhunaabula tsingubotsio, nibabukula ebimilibio ebilayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.26",
            "verseOrgIds": [
              "EZK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio ndalaakamia obwilaasiibwo mwiwe, nobutambabwo oburula mushialo shiaMisiri, mbu oleshe okhubachinguulila tsimoni kata okhwitsulila Misiri khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.27",
            "verseOrgIds": [
              "EZK.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka Omwami NYASAYE aboola; mbu Lola, ndalakhuhaana mumakhono ka abo aba okiyanga, abakhusinya; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.28",
            "verseOrgIds": [
              "EZK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo balakhukholela nobukiyi, nibabukula ebiobunyakhanibwo bwosi, nibakhulekha noli eshihechenye, omukhaya; kata eshihechenye shiobutambabwo shilafuunulwa, obwilaasii nobutambabwo bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.29",
            "verseOrgIds": [
              "EZK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ako kosi kakhwikholilekhwo okhuba watsia mubutamba okhulonda khubamahanga, khandi shichila wakwa owobukaali khulwa emindu chiabwe echiinamilungwa ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.30",
            "verseOrgIds": [
              "EZK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walonda khunjila yomukhaana weenywe; niko akachila ndalahaana eshikombeshie mumukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.31",
            "verseOrgIds": [
              "EZK.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.35",
            "verseOrgIds": [
              "EZK.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nameeta niyasunjila mbu Mwana womundu, olayaasia Ohola nende Oholiba? Kho obarumbulile akebisinyo biabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.36",
            "verseOrgIds": [
              "EZK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba baheyanga, khandi amabanga kali khumakhono kabwe; bakholile akobuheyi nemindu echia beenamilanga; khandi abaana babwe aba banzibulila, babahaanila emindu tsana mbu chibalie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.37",
            "verseOrgIds": [
              "EZK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi bameetile nibakholela lino; mbu bayoonoonia habundu wanje ahatakatifu khunyanga tsana niboonoonia tsisabato tsianje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.38",
            "verseOrgIds": [
              "EZK.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba olwa bali nibamalile okhwirila emindu chiabwe tsana abaana babwe, mana khunyanga yeneyo nibeenjila habundu wanje ahatakatifu okhuhoonoonia; ne lola, nolwa bakholile hakari weinzu yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.39",
            "verseOrgIds": [
              "EZK.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi barumaane abandu abarula ehale; barumiilwe omurume ne mbabo beetsile; nawe niwiyosia khulwabwe, niwibakha iranji khumoni, niwisiaha ebimili, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.40",
            "verseOrgIds": [
              "EZK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwikhala khushitali eshieing'oono, neimeesa eyakasibwa imbeli washio; ne khubwenokhwo norenjekhakhwo amalesi kanje kelibuuliesi namafura kanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.41",
            "verseOrgIds": [
              "EZK.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluyoka lwomukanda kwabandu abeelambisii lwali ninawe; nahalala nabasaatsa abarakaasakhwo ta abandi baleerwa, abameesi abarula mushitsiimi; nabo nibara emikasa khumakhono kabakhasi tsana, netsisimbi tsing'oonefu khumirwe chiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.42",
            "verseOrgIds": [
              "EZK.23.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.42",
            "verseOrgIds": [
              "EZK.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nisunga mbu Abasaatsa abo shibaheyanga olwa bakhola ninaye akobutamba? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.43",
            "verseOrgIds": [
              "EZK.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba beenjiile ewa ali shinga abamutsiila omutamba; nolwa bali nibeenjilanga ewaOhola naOholiba, abakhasi abo abeelaasii. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.44",
            "verseOrgIds": [
              "EZK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandu abalunjishi balabayaasia shinga abakhasi abaheyi olwa bayaasibungwa, nabakhasi abaraatsia amabanga; shichila nabaheyi, ne amabanga kali khumakhono kabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.45",
            "verseOrgIds": [
              "EZK.23.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
