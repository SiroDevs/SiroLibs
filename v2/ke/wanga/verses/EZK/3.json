    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyasunjila mbu Mwana womundu, eshia onyoolile, oshilie; lia eshikanye shino, mana tsia oboolele abeinzu yaIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ninzasama omunwa, naye niyandisia eshikanye tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.2",
            "verseOrgIds": [
              "EZK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyasunjila mbu Mwana womundu, lia eshikanye shino eshia ekhuha niwikusia indayo. Mans nishilia; nishiba mumunwa kwanje eshimilamili shinga obuushi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyamboolela mbu Mwana womundu, tsia, wule khubeinzu yalsiraeli, osungane ninabo namakhuwa akarula khwisie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.4",
            "verseOrgIds": [
              "EZK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila shiorumwa khubandu abayobo, abolulimi olutinyu, ta, habula khubeinzu yaIsiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.5",
            "verseOrgIds": [
              "EZK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "khubandu abanji abayoboya, abolulimi olutinyu, aba orahulilanga amakhuwa kabwe, ta. Nebutswa nimba nindakhakhuruma khubeenabo, bakhakhuhulila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.6",
            "verseOrgIds": [
              "EZK.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inzu yaIsiraeli shiyilakhuhulila ta; shichila bakhaya okhumbulila isie; okhuba bosi abeinzu yaIsiraeli nabomurwe omuumu nende omwoyo omutinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.7",
            "verseOrgIds": [
              "EZK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, ekhuumiye mumoni okhuyinga mumoni mwabwe, nende omurwekwo okhuyinga omurwe kwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.8",
            "verseOrgIds": [
              "EZK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga likhwabuye elishila isiele obutinyu, nindio ekholile obwenibwo; orabaria kata okhufwa omwoyo khukhulolekha khwabwe ta, kata nibali abeinzu yeinduli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.9",
            "verseOrgIds": [
              "EZK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yasunjila mbu Mwana womundu, amakhuwa kanje kosi aka ndalakhubooleIanga, okafuchiilile mumwoyokwo, nokahulila namarwiko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.10",
            "verseOrgIds": [
              "EZK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsia, wule khubaare tsana, khubaana babandu beenywe, osungane ninabo nobaboolela mbu Kano niko aka Omwami NYASAYE aboola; kata nibaba nibafuchiilila okhuhulila, kata nibakhaya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Roho niyanjinga, nimbulila munyuma wanje oluyoka Iwokhuhoola okhukhongo, luri Oluyali lwOMWAMI olurula habunduwe hatakatifu Iwitsoomibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbulila nende obuyoka bwetsimbaha tsiebili-mwoyo tsana nitsitiilanangakhwo, nobuyoka bwemikurutumu echiali elubeka lwabio, nibwo obuyoka bwokhuhoola okhukhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Roho niyanjinga niyarusiaho; ninzia mubululu, omwoyo kwanje nikwakha; omukhono kwOMWAMI nikuba khwisie namaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninzula khubeenabo abobwarwi eTelabibu, abamenya ahambi nende omwalo kwaKhebari; nindikhala ninabo halala tsindaalo musaafu, ning'ang'aalile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omulindi khunzu yaIsiareli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana tsindaalo etsio musaafu nitsihweele, likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.16",
            "verseOrgIds": [
              "EZK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, ndakhukhola iwe obe omulindi khunzu yaIsiraelii khulwako, olwa oba nohuliile likhuwa liomunwa kwanje, obachesiyie khulwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.17",
            "verseOrgIds": [
              "EZK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "OlwaembanimuboolelaomubiiyesimbuOkhufwa olafwa; ne iwe noramuchesiyia kata okhuboolela omubii oyo akobuchesiyii mbu arule munjilaye imbii, okhuhonia obulamubwe, ta; kho omubii tsana alafwila mubumayaanubwe; ne amabangake, ndalakabanzanga mumukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.18",
            "verseOrgIds": [
              "EZK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa noba nomuchesiyia omubii tsana, naye narashiukhana okhurula khububiibwe, kata okhurula khunjilatsie tsimbii ta, kho alafwila mubumayaanubwe; habula iwe wakhaba nohoniye omwoyokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.19",
            "verseOrgIds": [
              "EZK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata khandi, omundu omulunjishi olwa aba nashiukhana okhurula khubulunjishibwe, nakhola akobumayaanu, nasi nira eshiisichirasio imbeliwe, alafwa; ne eshichila shioba nomuchesiyiye, alafwila mubwonoonibwe, kata ebikhole ebilunjishi ebia yali nakholanga shibileetsulilwa ta; ne amabangake, ndalakabanza mumukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.20",
            "verseOrgIds": [
              "EZK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula noba nomuchesiyia omulunjishi tsana, mbu aleshe okhwonoona, naye naroonoona ta, alaba mwoyo; shichila yachesihala; nawe wakhaba nohoniye obulamubwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omtmabiiyasiluhasibwa, oburanyala okhuboola ta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne habwenaho omukhono kwOMWAMI kwali nikuli khwisie; niyamboolela mbu Buukha, rula otsie mumuhololookhwe, nasi nesunganile ninawe ebweneyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.22",
            "verseOrgIds": [
              "EZK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nimbuukha, nirula ninzia mumuhololookhwe; ne lola, ing'oono yoluyali lwOMWAMI njieyo, niyisinjiileyo, shinga oluyali lulia olwa ndalola hamwalo kwaKhebari; nindikhupa hasi mafumama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.23",
            "verseOrgIds": [
              "EZK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Roho niyeenjila mwisie, niyasinjisia, nasungana ninasi, niyamboolela mbu Tsia, wiyikalile munzuyo mukari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.24",
            "verseOrgIds": [
              "EZK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa iwe, mwana womundu, lola, nabakhurekhwo ebibohelo nibakhuboha ninabio, noranyala okhurula okhutsia mubo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi nehandie olulimilwo mushinakhuna, mbu okwe omusilu, noranyala okhubakondeshela ta; okhuba nabeinzu yeinduli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.26",
            "verseOrgIds": [
              "EZK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa emba nisungana ninawe, nenzikule omunwakwo; nawe olabasunjila mbu Kano niko aka Omwami NYASAYE aboola; mbu Ouhulila, ahulile; ne oukhaya, akhaye; okhuba nabeinzu yeinduli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.27",
            "verseOrgIds": [
              "EZK.3.27"
            ]
          }
        }
      ]
    }
  ],
