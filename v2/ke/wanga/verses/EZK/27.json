            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila khandi, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.1",
            "verseOrgIds": [
              "EZK.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mwana womundu, yikhuulila Tiro olwikhuulu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nosunjila Tiro oumenyanga habwinjililo bweinyanza, nali oweinganga khutsimbia tsiabandu khunguku tsinyinji, ori Kano niko aka Omwami NYASAYE aboola; mbu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbePeresia nabeLudi nabePuti bali mwihelio, nibali abandu belihe; baachikha eshikhumba neikuutwa mwiwe; bakhumeetela obukaasu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbeArawadi nabamaheko bali khulukobalwo, nabo abeGamadi bali muminaarachio; baachikha ebikhumba biabwe khulukobalwo tsimbeka tsiosi; bachila obung'oonefubwo nibuba habwene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarashishi yali omunduwo wobukhala khulwa obunji bwebiobuyinda bietsimbia tsiosi; bakulaasia emianduchio ifeetsa, neshibia, neibaati, netsisasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawani naTubali naMeshekhu bali abahoonibo; bakulaasia emianduchio abandu nende ebindu biomukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeinzu yaTogama bakulaasia emianduchio tsifarasi, netsifarasi, tsielihe, netsinyumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.14",
            "verseOrgIds": [
              "EZK.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaDedani bali abahoohibo; tsinguku tsinyinji tsiali ebiiro ebiomumukhonokwo; bakhuleerela ameeno ketsinzofu netsimbaho tsiemipingo bibe ebihaanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siria yali omunduwo wobukhala, khulwa obunji bwemianduchio; babikulaasia tsinopeki, neingubo yeisambarau, neyamakha, neikitani indorotoro, netsifetsaluka, netsikatikoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda nende eshialo shiaIsiraeli bali abahoonibo, bakulaasia emianduchio ingaano yeMinitsi, neipanagi, nobuushi, namafura, neindesi yeshiuya eshilayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damasiko yali omunduwo wobukhala, khulwa obunji bwemianduchio, nokhulwa obunji bwebiobuyindabio bietsimbia tsiosi; neidivai yaHeliboni, nobwoya obulafu bwamakondi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wedani naYawani, okhurula eUzali, bakulaana ninawe emiandu; bakulaasia emianduchio eshibia eshiiraanye, neikita, nolusi Iweshing'aari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dedani yali omuhooniwo wetsingubo tsiokhwala khutsifarasi etsio khuchendela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbebuArabu nabakhulundu bosi baKedari bali abandubo bobukhala; nibo abakholibo bobukhala bwamakhondi, namamiiku, netsimbusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahooni beSheba naRaama bali abahoonibo; bakulaasinjia emianduchio tsindesi tsieshiuya tsikhulundu, noruchina rwolukoosi, neitsahaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.22",
            "verseOrgIds": [
              "EZK.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harani naKane naEdeni, abahooni baSheba naAshuru naKhilimadi, bali abahoonibo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
            "verseOrgIds": [
              "EZK.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibo abali abahoonibo bemiandu emilobole, mbu tsingubo tsieibuluu netsiamakha, netsingubo tsing'oonefu, etsiboyilwe butinyu, mubindubio biobukhala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaaro kaTarashishi kakhuchendelanga nikakhuchinjila ebiobukhala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        }
      ]
    }
  ],
