        "style": "s1"
      },
      "items": [
        {
          "text": "Obuyaasii khubeenamili bebifwanani abareebanga ewomunabii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
