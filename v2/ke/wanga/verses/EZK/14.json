              "EZK.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.12",
            "verseOrgIds": [
              "EZK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, olwa eshialo nalebe shiba nishinzonoonela nishibula obwisiikwa, nasi ninyiila omukhono kwanje khushio, nifunaka omutiichilo okwa shiisiililanga, mbu obusuma, niruma inzala khushio, nikhalaka mushio abandu nemiruko; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.13",
            "verseOrgIds": [
              "EZK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "khane abandu bano bataru, mbu Noa naDanieli naAyubu, nibakhabeelemwo, khane bakheehonia butswa obulamu bwabwe bwonyene, khulwa obulunjishi bwabwe, Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.14",
            "verseOrgIds": [
              "EZK.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimba nimbisia tsisolo tsimbalaba mushialo, natsio nishishionoonia, nishikwa likunda, mbu omundu yesi aleshe okhubiramwo khulwa tsisolo tsana; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.15",
            "verseOrgIds": [
              "EZK.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "khane abandu abo bataru nibakhabeelemwo, isie uno! Omwami NYASAYE aboola, Khane shibakhahonia kata abaana abasiani kata abakhaana ta; bakhahona abeene bonyene, ne eshialo shiakhakwa likunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nimba nileera olukanga khushialo tsana, nimboola mbu Olukanga, bira mushialo shiosi; nikhalaka endio abandu nemiruko mushio; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.17",
            "verseOrgIds": [
              "EZK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "khane abandu abo bataru nibakhabeelemwo, isie uno! Omwami NYASAYE aboola, khane shibakhahonia abaana abasiani kata abakhaana ta, habula abeene bonyene bakhahona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nimba niruma oluumbe mushialo tsana, nishisundulilakhwo obuIulu bwanje mumabanga, okhukhalaka mushio abandu nemiruko, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.19",
            "verseOrgIds": [
              "EZK.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "khane Noa naDanieli naAyubu nibakhabeelemwo, isie uno! Omwami NYASAYE aboola; Khane shibakhahonia abaatla abasiani kata abakhaana ta; bakheehonia butswa obulamu bwabwe bwonyene khulwa obulunjishi bwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.20",
            "verseOrgIds": [
              "EZK.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.20",
            "verseOrgIds": [
              "EZK.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka Omwami NYASAYE aboola; mbu Shikalashila muno olwa eruma akobukhalachi bwanje obululu kane khuYetusalemu, mbu olukanga, neinzala, netsisolo tsimbalaba, noluumbe, okhukhalaka mulio abandu nemiruko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.21",
            "verseOrgIds": [
              "EZK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa lole, nibaba nibatong'amwo abeehonokooshe okhwimilila abaana babwe abasiani nahakhaana nibabarusiamwo, lole, balarula nibamwitsila, neenyu mulalola tsinjila tsiabwe nebikhole biabwe; mana mulalemibwa omwoyo khukamabii aha endeerile khuYerusalemu, niko kosi aka ndalaba nindeerile khulio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.22",
            "verseOrgIds": [
              "EZK.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamulemia omwoyo, olwa mulalola injila yabwe nebikhole biabwe; mana mulamanya mbu kosi aka ndalaba nikholile mulio, shikholile aharali eshichila ta, Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.23",
            "verseOrgIds": [
              "EZK.14.23"
            ]
          }
        }
      ]
