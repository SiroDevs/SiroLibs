            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lola, omundu oyo owali niyeefwalile tsingubo tsieikitani, owali neshimuka shiobwino shiomuhandiichi khukhukunyu, yakalusia likhuwa, ari Ekholile aka undachile.",
          "type": "text",
          "attrs": {
