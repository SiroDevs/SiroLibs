            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.8",
            "verseOrgIds": [
              "EZK.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyasunjila mbu Obumayaanu bweinzu yaIsiraeli naYuda nobunji muno; eshialo shiitsuulemwo amatsayi, litookho nalio liitsuulemwo obukhalachi obushiamu; okhuba basunga mbu OMWAMI wayeebala eshialo; OMWAMI shialolanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.9",
            "verseOrgIds": [
              "EZK.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi siesi, imoni yanje shiyilabeelelela, kata shindalabakhwo nende tsimbabasi ta; ne ndalabayaasia khulwa tsinjila tsiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        }
      ]
    },
