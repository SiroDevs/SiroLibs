      },
      "items": [
        {
          "text": "Obukhalabani bwomuhekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyangalusia khushilibwa shielwanyi shiahabundu ahatakatifu, eshihenga ebukwe; nashio shiali nishiikaale, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.1",
            "verseOrgIds": [
              "EZK.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyasunjila mbu Eshilibwa shino shibeetsenje nishiikaale; shireekulwakhwo kata omundu yesi areenjililamwo ta; okhuba OMWAMI, Nyasaye waIsiraeli, yeenjililamwo; ne khulwako shiikalwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.2",
            "verseOrgIds": [
              "EZK.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula omwami weshialo, ye anyala okhwikhalamwo okhulia ebiliibwa imbeli w; ne aleenjilenje nabirila mushirookoola shieshilibwa, narulila khunjila yeneyo khandi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.3",
            "verseOrgIds": [
              "EZK.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.3",
            "verseOrgIds": [
              "EZK.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyambisilia mushilibwa shienotsi niyanzusia imbeli weihekalu; nihenga, ne lola, ing'oono yoluyali Iw njieyo, niyiitsuule munzu yOMWAMI; nindikhupa hasi mafumama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.4",
            "verseOrgIds": [
              "EZK.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyasunjila mbu Mwana womundu, witsulile kano bulayi; henga netsimonitsio nohuiila namarwiko kosi aka ekhusunjila khukalachilisibwa khukeihekalu yOMWAMI nende amalako kayo; witsulile bulayi abanyala okhwinjilanga muhekalu nende abo abeekalilwa obureenjila habundu ahatakatifu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.5",
            "verseOrgIds": [
              "EZK.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olabasunjile abeinduli abo, mbu abeinzu yaIsiraeli, ori Kano niko aka Omwami NYASAYE aboola; mbu Inywe abeinzu yaIsiraeli, ebisinyo bieenywe bihele yaho; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.6",
            "verseOrgIds": [
              "EZK.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba mwinjisinjia abarende, abali abasinde mumwoyo nabasinde mumubili, habundu wanje ahatakatifu okhwonoonia ihekalu yanje, olwa muleeranga ebiliibwa bianje, amasinya namalasile; nimwonoonia indakano yanje khulwa ebisinyo bieenywe biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.7",
            "verseOrgIds": [
              "EZK.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimwasinjilila obulindi bwebindu bianje ebitakatifu ta; ne inywe abeene mwaraho aba-sinjilili bandi khubulindi, habundu wanje ahatakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.8",
            "verseOrgIds": [
              "EZK.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.8",
            "verseOrgIds": [
              "EZK.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Omurende yesi, ouli omusinde mumwoyo nomusinde mumubili, shialeenjila habundu wanje ahatakatifu ta, khubarende bosi abali hakari wabaana balsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.9",
            "verseOrgIds": [
              "EZK.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaLawi tsana abarulakhwo nibatsia ehale, olwa Isiraeli yashiama nibashiama nibarulakhwo nibalonda khumindu echia beenamilanga, baleetuukha obumayaanu bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.10",
            "verseOrgIds": [
              "EZK.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa balabeetsenje abakhalabani habundu wanje ahatakatifu, nibaloleelela habilibwa bieihekalu, nokhukhalabana muhekalu; baleerenje emisango chiokhusambwa nomusango kwabandu, nibasinjila imbeli wabwe okhubakhaiabanila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.11",
            "verseOrgIds": [
              "EZK.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila babakhalabanila imbeli wemindu echia bali nibeenamilanga, nibakwila inzu yaIsiraeli eshiisichirasio shiobumayaanu; niko akachila ninjinguula omukhono okhubafukula; ne baleetuukha obumayaanu bwabwe; nilwo olwa Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.12",
            "verseOrgIds": [
              "EZK.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shibalasitile ahambi okhukholela akobukuhani ta, kata okhusita ahambi khubindu bianje ebitakatifu biosi biosi, kata ebindu ebili muno, tawe; ne baleetuukha tsisoni tsiabwe, khulwa ebisinyo biabwe ebia bakholanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.13",
            "verseOrgIds": [
              "EZK.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ndalabakhola babe abasinjilili bobulindi bweihekalu, khulwa obukhalabani bwayo bwosi, nokhulwa kosi akalakholelungwamwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.14",
            "verseOrgIds": [
              "EZK.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.14",
            "verseOrgIds": [
              "EZK.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abakuhani abaLawi, abaana baZadoki, abali nibasinjililanga obulindi bwahabundu wanje ahatakatifu olwa abaana baIsiraeli bashiama nibarulakhwo, bo balasitilanga ahambi okhukhalabanila; balasinjilenje imbeli wanje okhundeerela amasinya namalasile; nolwa Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.15",
            "verseOrgIds": [
              "EZK.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleenjilenje habundu wanje ahatakatifu, nibasita ahambi khumeesa yanje okhukhalabanila, nibasinjilila obulindi bwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.16",
            "verseOrgIds": [
              "EZK.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa baleenjilanga mubilibwa biolwanyi Iwomukari, balabe nibeefwalile ebiifwalo bieikitani; barakhabakhwo neshiifwalo shiobwoya bwamakondi khumibili chiabwe ta, olwa bashikhalabana habilibwa biolwanyi Iwomukari, nende mukari bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.17",
            "verseOrgIds": [
              "EZK.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balabe bende ebilemba bieikitani khumirwe chiabwe, netsiselwali tsieikitani mushishienje; barakheebohakhwo eshindu shiosi eshileera oluchesi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.18",
            "verseOrgIds": [
              "EZK.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa balarulanga nibatsia mulwanyi Iwelwanyi, ewa abandu bali, baleefwalulenje ebiifwalo biabwe biobukhaiabani, nibabibiikha mubisika ebitakatifu, nibeefwala ebiifwalo bindi, mbu baleshe okhwahula abandu khulwa ebiifwalo ebia bali ninabio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.19",
            "verseOrgIds": [
              "EZK.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata barakheebekanga liswi kata okhulekha liswi lirambihe, ta; ne balateetenje butswa liswi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rata omukuhani yesi yesi arakhanywa idivai olwa yeenjila mulwanyi olwomukari ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata barakhateeshia omukhasi omulekhwa kata owakabukhana nomusaatsawe ta; habula balateeshinjie abakhaana abashisila bolwibulo Iweinzu yaIsiraeli, kata omukhasi omulekhwa ousika omukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
            "verseOrgIds": [
              "EZK.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleechesmjie abandu banje akebindu ebiahule nende ebirali ebiahule ta, shinga olwa biahukhana, nibabamanyia okhwahukhasia ebiobukaali nende ebisiiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukayinganwa, balabeho okhuyaasia; obukhalachi bwanje shinga olwa buli, nindio bala khalachenje; balalindenje amalako kanje nakalachilisibwa kosi khunduukho tsiamasabo kosi; khandi balaahulenje tsisabato tsianje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barakheera mwibilu khulwa okhusita ahambi khumufu yesi ta; habula khulwa samwana kata nyina, kata omwana omukhaana kata omusiani, kata omusiani wabwe, kata omukhaana wabwe ouratsiakhwo khumusaatsa ta, khulwabo bakhanyala okhwira mwibilu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa aba nasiiyikha, bamubasilie tsindaalo musaafu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana khunyanga olwa aleenjila habundu ahatakatifu, mulwanyi Iwomukari, okhukhalabanila habundu ahatakatifu, alaleere omusangokwe kwobwonooni; nilwo olwa Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barakhabakhwo nobulaame ta; isie nisie obulaame bwabwe. Murakhabaheelesia emiandu chiosi muIsiraeli ta; isie nisie emiandu chiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaliitsenje omusango kweimele, nomusango kwobwonooni, nomusango kweshiuku; kata buli shindu eshiaahuliilwe elala muIsiraeli shilaba eshiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiambeli khubirongole ebiokhubindu biosi, netsisadaka tsietsimbia tsiosi etsiokhutsisadaka tsieenywe tsiosi, bilabe ebiabakuhani; khandi mulaheelesinjie omukuhani khubusie bweenywe obuhandale obwambeli, mbu ikhabi yibe khunzuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani barakhaliakhwo khushindu shiosi eshifwile eshiene, kata eshiarandulwa, kata nishiba linyonyi kata isolo ta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
              "EZK.44.31"
            ]
          }
        }
