          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womumdu, yikhuula olwikhuulu khulwa Farao omuruchi waMisiri, nomusunjila mbu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
