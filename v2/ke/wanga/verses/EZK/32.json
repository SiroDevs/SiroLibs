              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo nilwo olwikhuulu olwa baleekhuula; abakhaana bamahanga balawikhuula; baleekhuula bario khulwa Misiri nomukanda kwosi kwabandube, Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mumuyika kwekhumi nakhabili, mumwesi kwambeli nikuli ekhumi nakharaano, likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.17",
            "verseOrgIds": [
              "EZK.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, khupila abandu bosi baMisiri tsimbungu, nobeesia hasi, ye omwene nende abakhaana bamahanga akeifuma, okhuula khushialo shiahasi, halala nabeenabo abeekha muBuko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.18",
            "verseOrgIds": [
              "EZK.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
