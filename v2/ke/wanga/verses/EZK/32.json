          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhulundu benotsi baliho bosi, nabeSidoni bosi, abakholomooshe halala nabeerwa nibafwimbwa omurwe, kata olwa bali abamariisia bario mubululu bwabwe; bayabilwa bario mubusinde, halala nende abo abeerwa nolukanga, nibeetuukha tsisoni tsiabwe halala nende abo abeekha muBuko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
      ]
    },
