          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao alabalola, nalema omwoyo khulwa omukanda kwabandube; mbu Farao nabameheke bosi, abeerwa nolukanga, Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba yeenjisia amariisiake mushialo shiabali mwoyo; ne alayabilwa hakari wabasinde, halala nende abo abeerwa nolukanga, nibo Farao nomukanda kwabandube, Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
            "verseOrgIds": [
              "EZK.32.32"
            ]
          }
        }
      ]
    }
