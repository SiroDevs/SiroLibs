      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.19",
            "verseOrgIds": [
              "EZK.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balakwa hakari wa abo abeerwa nolukanga; kata omukanda kwabandube balayabilwa ninaye halala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.20",
            "verseOrgIds": [
              "EZK.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashila amaani mubalulu balamusunjila ewa bali eMakombe hakari, halala nababeelibe, mbu Beeshile nibakona bukona, abasinde bano, abeerwa nolukanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuru aliyo, nomukandakwe kwosi; ebilindwa biabwe bimufumbila; bosi beerwa, nibakwisibwa nolukanga; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.22",
            "verseOrgIds": [
              "EZK.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebilindwa biabwe biakasibwa muBuko musi bwene, omukandakwe kwosi nikufumbila eshilindwashie; bosi beerwa, nibakwisibwa nolukanga, abali nibaleeranga amariisia mushialo shiabali mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elamu aliyo, omukanda kwabandube nikufumbila eshilindwashie; bosi beerwa, nibakwisibwa nolukanga, abeekha mushialo shiahasi nibashili abasinde, abali nibaleeranga amariisia mushialo shiabali mwoyo; nibeetuukha tsisoni tsiabwe halala nabeenabo abeekha muBuko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.24",
            "verseOrgIds": [
              "EZK.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamukasiliye obulili hakari wabeerwa, halala nomukanda kwabandube; ebilindwabie bimufumbila; nabasinde bosi, nibeerwa nolukanga; amariisia kabwe kalinjiho mushialo shiabali mwoyo, nibeetuukha tsisoni tsiabwe halala nabeenabo abeekha muBuko; bareebwa hakari wa abo abeerwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshekhu naTubali baliyo, nomukanda kwabandu babwe; ebilindwa biabwe bibafumbila; nabasinde bosi, nibeerwa nolukanga; okhuba bali nibaleeranga amariisia mushialo shiabali mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shibayabilwa halala nabalulu bakhale abakwa, abeekha eMakombe nibali nebimanulwa biabwe biobulasani, emirwe chiabwe nichialisibwa khunganga tsiabwe, ebikhumba biabwe nibili khumakumba kabwe, ta; okhuba amariisia kabalulu kaliho mushialo shiabali mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe olafunakwa nokona hakari wabasinde, noyabilwa halala nende abo abeerwa nolukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu aliyo, nabaruchibe nabakhulundube bosi, abayabilwa halala nende abo abeerwa nolukanga, kata olwa bali abalulu bario; balayabilwa nabasinde, halala nende abo abeekha muBuko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        }
      ]
    },
