          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shialiho eshisika shindi nomuliango kwashio mushirookoola shieshilibwa, aha boosilinjia omusango kwokhusambwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.38",
            "verseOrgIds": [
              "EZK.40.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 40:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mushirookoola shieshilibwa tsialimwo tsimeesa tsibili elubeka eyi, netsimeesa tsibili elubeka eyi, okhwirilakhwo eshiomusango kwokhusambwa, neshiokwobwonooni, nende eshiokweshiuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.39",
            "verseOrgIds": [
              "EZK.40.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 40:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elubeka lulala, elwanyi, habwinjililo bweshilibwa enanotsi, tsialiho tsimeesa tsibili; nokhulubeka lundi Iweshirookoola shieshilibwa, tsialiho tsimeesa tsindi tsibili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.40",
            "verseOrgIds": [
              "EZK.40.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 40:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsimeesa tsialiho tsine mukari, netsimeesa tsindi tsine elwanyi, elubeka Iweshilibwa; mbu tsimeesa tsiosi munaane etsia beerelangakhwo emisango. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.41",
            "verseOrgIds": [
              "EZK.40.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 40:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsialiho tsimeesa tsine etsiomusango kwokhusambwa, etsiamachina amabaatse; oburambi bwatsio bwali omukhono mulala neshitonye, nobuchiikha omukhono mulala neshitonye, nobuchinguukhu omukhono mulala; ne khutsio nikhwo okhwa bareetsanga ebikholelo biene ebia beerelanga ebiemisango chiokhusambwa nemisango chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.42",
            "verseOrgIds": [
              "EZK.40.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 40:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikuru nabio biareebwamwo tsimbeka tsiosi, buli shilala oburambi bwashio nibuhela obubambalifu bweshikalo; ne tsimeesa tsana tsiali etsiokhurakhwo inyama yemisango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.43",
            "verseOrgIds": [
              "EZK.40.43"
            ]
          }
        }
