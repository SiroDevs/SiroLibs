          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata orukoro rwabalindi rwashio, nemisiilo chiashio, neshirookoola shiashio, nibihelana nende ebindi; bialiho ebianzwi mushio nomushirookoola shiashio tsimbeka tsiosi; oburambi bwashio nibuba amakhono amakhumi karaano, nobuchiikha amakhono amakhumi kabili nakaraano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.29",
            "verseOrgIds": [
              "EZK.40.29"
            ]
          }
        },
        {
