          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyanzinjisia mulwanyi olwomukari, ne lola, ebisika bibili mbiebio, mulwanyi Iwomukari, shilala elubeka Iweshilibwa shienotsi, nishihenga esautsi, eshindi elubeka Iweshilibwa shiesautsi, nishihenga enotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.44",
            "verseOrgIds": [
              "EZK.40.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 40:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyasunjila mbu Eshisika shino eshihenga esautsi neshiabakuhani abasinjilila obulindi bweihekalu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
            "verseOrgIds": [
              "EZK.40.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 40:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashio eshisika eshihenga enotsi neshiabakuhani abasinjilila obulindi bweshimalilo; nibo abaana baZadoki, ne nibo bonyene mubaana baLawi abasitanga ahambi khuMWAMI okhumukhalabanila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.46",
            "verseOrgIds": [
              "EZK.40.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 40:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nachela olwanyi, mbu oburambi amakhono eshikhumi nobuchiikha amakhono eshikhumi, tsimbeka tsiosi tsine nitsihelana; eshimalilo nashio shiali imbeli weihekalu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.47",
            "verseOrgIds": [
              "EZK.40.47"
            ]
          }
        }
