          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialiho ebirookoola tsimbeka tsiosi, ebiahela oburambi amakhono amakhumi kabili nakaraano nobuchiikha amakhono karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
            "verseOrgIds": [
              "EZK.40.30"
            ]
          }
        },
