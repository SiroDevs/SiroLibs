            "sid": "EZK 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.1",
            "verseOrgIds": [
              "EZK.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, shiukhana nohenga abaana baAmoni, nolakula khubo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nosunjila abaana baAmoni ori Hulile likhuwa liOMWAMI NYASAYE; kano niko aka Omwami NYASAYE nboola; mbu Okhuba mwaboola mbu Ngako! Khuhabundu wanje ahatakatifu olwa hoonoonibwa, nende khushialo shiaIsiraeli olwa shiakwisibwa likunda; nende khubeinzu yaYuda olwa baarwa mushialo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.3",
            "verseOrgIds": [
              "EZK.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila, lole, ndalamuhaana mumakhono kabandu bebukwe mbu mube ababwe; balakhupa tsikambi tsiabwe mwinywe, nibakasia ebimenyo biabwe mwinywe; balalia ebiamo bieenywe nibanywa amabeele keenywe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.4",
            "verseOrgIds": [
              "EZK.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalakwisia Raba obwayilo bwetsingamia, namataala kaAmoni, ikhonje yebiayo; mana mulamanya mbu isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.5",
            "verseOrgIds": [
              "EZK.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka Omwami NYASAYE aboola; mbu Okhuba mwakhupa tsikhofi nimwikhong'onda, nimwikhoya okhufukula eshialo shiaIsiraeli nelikhobo liosi eliomumioyo chieenywe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.6",
            "verseOrgIds": [
              "EZK.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila, lole, enyiilile omukhono kwanje khwinywe, nimuhaana khubamahanga, mube eshiyaayo shiabwe; ndalamukhalaka okhurula khutsimbia tsiabandu, nimusisia mubialo; ndalamumalilana; mana balamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.7",
            "verseOrgIds": [
              "EZK.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulakusi obuyinga Moabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.7",
            "verseOrgIds": [
              "EZK.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Okhuba Moabu aboola mbu Lole, inzu yaYuda yinga shinga amahanga kosi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.8",
            "verseOrgIds": [
              "EZK.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila, lola, ndaeekhula mumbafu mwaMoabu, okhurula khumataa ake akali khulwakho, oluyali Iweshialo, niko Betsi-yeshimotsi, naBaalimeoni naKiriatsaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.9",
            "verseOrgIds": [
              "EZK.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalashihaana, halala nabaana baAmoni, khubandu bebukwe babe ababwe, mbu abaana baAmoni bareetsulilwe mubamahanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalakhola akobuyaasii khuMoabu; mana balamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulakusi obuyinga Edomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Okhuba Edomu yafukula inzu yaYuda namala eshikwoli khuyo, naba neshikha mukhumala eshikwoli khubo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.12",
            "verseOrgIds": [
              "EZK.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila kano niko aka Omwami NYASAYE aboola; mbu Ndalanyiila omukhono kwanje khuEdomu, nishikhalakakhwo abandu nemiruko; nda ashikwisia likunda okhurula eTemani; kata okhuula eDedani balakwisibwa nolukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.13",
            "verseOrgIds": [
              "EZK.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalara akeshikwoli shianje khuEdomu mumakhono kabandu banje Isiraeli; nabo balakhola muEdomu akoburima bwanje nakobululu bwanje shinga olwa buli, mana balamanya eshikwoli shianje, Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.14",
            "verseOrgIds": [
              "EZK.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulakusi obuyinga abaFilisiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.14",
            "verseOrgIds": [
              "EZK.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Okhuba abaFilisiti bakholile akeshikwoli nibamala eshikwoli nelikhobo eliomumwoyo, okhulimulula mubusuku oburaakama ta, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.15",
            "verseOrgIds": [
              "EZK.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila kano niko aka Omwami NYASAYE aboola; mbu Lola, ndalanyiila omukhono kwanje khubaFilisiti, nikhalaka khubo abaKheretsi, nimulula eshitonye shiolukuku eshitong'ile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.16",
            "verseOrgIds": [
              "EZK.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalamala eshikwoli khubo nobukuumi obululu; mana balamanya mbu isie nisie OMWAMI, olwa ndalara akeshikwoli shianje mumakhono kabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.17",
            "verseOrgIds": [
              "EZK.25.17"
            ]
          }
        }
      ]
    }
