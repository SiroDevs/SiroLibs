            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwekhumi, mumwesi kwekhumi nikuli ekhumi nakhabili, likhuwa liOMWAMI, nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, shiukhana ohenje Farao omuruchi waMisiri; olakule nomufukula, nofukula nende Misiri yosi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "noboola ori Kano niko aka Omwami NYASAYE aboola; mbu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abamenyanga ebuMisiri bosi balamanya mbu isie nisie OMWAMI. Shichila obeetsanga omutiichilo kwolusi khunzu yaIsiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa bakhutiila nomukhono, wafinikha nobarandula bosi amabeka; khandi olwa beesiila khwiwe wafinikha, nochila nibarenga bosi ebishienje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.7",
            "verseOrgIds": [
              "EZK.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako kano niko aka Omwami NYASAYE aboola; mbu Lola, ndalaleera olukanga khwiwe, nikhukhalakakhwo abandu nemiruko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo shiaMisiri shilaba eshikhaya, eshialo shiamakunda; mana balamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshichila wasunga mbu Omwalo kwaNaili nokwanje; nisie owakukhola; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho, lola ekhufukula, nifukula emialochio; ndalakwisia eshialo shiaMisiri amakunda, shibe eshikhaya kuru, okhurula eMigidoli okhuula eSeyene, kata okhuula khulwakho lwaEtiopia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.10",
            "verseOrgIds": [
              "EZK.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshilenje shiomundu yesi shishilabiramwo, kata eshilenje shiomuruko okhubiramwo, kata shishilamenywamwo emiyika amakhumi kane ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.11",
            "verseOrgIds": [
              "EZK.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalakhola eshialo shiaMisiri eshikhaya hakari webialo ebili ebikhaya, namataalake hakari wamataala akakwisibwa amakunda kalaba amakhaya emiyika amakhumi kane; khandi ndalasalaasia abaMisiri mumahanga, nimbakabula mubialo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.12",
            "verseOrgIds": [
              "EZK.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka Omwami NYASAYE aboola; mbu Emiyika amakhumi kane nichihweele, ndilikhung'aasia abaMisiri okhurula mumbia tsiabandu omwa basalaasibwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ningalusia tsikhabi tsiaMisiri, nimbakalusia mushibala shiaPatsarosi, mushibala shieingulikhwa yabwe; ne ebweneyo baliba obwami obuli hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.14",
            "verseOrgIds": [
              "EZK.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buliba hasi okhushila obwami bwosi; kata shibuleechinga okhushila amahanga kandi ta; ndilibatiitiyia baleshe okhuruka amahanga khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.15",
            "verseOrgIds": [
              "EZK.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata inzu yaIsiraeli shiyilabeesiikanga khandi ta, okhubeetsusia akobumayaanu olwa babahenga okhuhabinwa; mana balamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwamakhumi kabili namusaafu, mumwesi kwambeli nikuli lulala, likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
              "EZK.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, Nebukhadineza omuruchi waBabeli yakhosia amaheke emilimo emikhongo okhuyinga Tiro; buli murwe kwakhweyukha nikukwa eshiole, buli libeka nilifubukha; nebutswa shiyanyoolakhwo omushaara okhurula eTiro, ye omwene kata abamaheke ta, khulwa emilimo echia yakhola okhuliyinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.18",
            "verseOrgIds": [
              "EZK.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako kano niko aka Omwami NYASAYE aboola; mbu Lola, ndalaheelesia Nebukhadineza omuruchi waBabeli eshibala shiaMisiri; naye alayila obunji bwobuyinda bwashio, nashiyaaya, nabukula ebioluyiitsi biashio; nabio bilaba omushaara kwamaheke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamuheelesiye eshibala shiaMisiri shibe omurungokwe okwa yakholela, shichila bakholela isie Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        }
      ]
    },
    {
