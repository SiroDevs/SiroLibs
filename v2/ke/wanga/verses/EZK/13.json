    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abanabii bobukaafii bakhalakwa eshiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.1",
            "verseOrgIds": [
              "EZK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, rumbula nofukula abanabii baIsiraeli abarumbulilanga muliira lianje nobaboolela abo abarumbulilanga muliira lianje akarula mumioyo chiabwe abeene, ori Hulile likhuwa liOMWAMI; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.2",
            "verseOrgIds": [
              "EZK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kano niko aka Omwami NYASAYE aboolambu Woowe khubanabii abasilu abalonda khuroho yabwe abeene, nibaraluutsikhwo eshindu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.3",
            "verseOrgIds": [
              "EZK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Isiraeli, abanabiibo babeelenje shinga amabwe mumakunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.4",
            "verseOrgIds": [
              "EZK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimutikuluushe okhwinjila mubibanga kata okhuswalila Isiraeli olukoba, mbu beetinyie mubusolo khunduukho yOMWAMI, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.5",
            "verseOrgIds": [
              "EZK.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baluutsi akobukhaya nobufumu bwobubeeyi, abo abasunga OMWAMI aboola; ne OMWAMI shiyabarumile ta nibakaala mbu likhuwa lileekhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.6",
            "verseOrgIds": [
              "EZK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimubeetsanga nimuluutsi libisulo likhaya, nokhuboola akobufumu bwobubeeyi buli olwa musunga mbu OMWAMI aboola; ne shimbeetsanga nimboolilekhwo ta?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, niko aka Omwami NYASAYE aboola; mbu Okhuba mwaboolanga amakhuwa amakhaya, nimulola akobubeeyi, kho, lole, emufukula, Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.8",
            "verseOrgIds": [
              "EZK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhono kwanje kulanyinga abanabii abalola akobukhaya nibarumbula akobubeeyi muliira lianje; shibalaba mumuse kwabandu banje, kata shibalahandiikwa mulwanzilo Iweinzu yaIsiraeli kata okhwinjila mushialo shiaIsiraeli ta; ne mulamanya mbu isie nisie Omwami NYASAYE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.9",
            "verseOrgIds": [
              "EZK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila, toto mwene, shichila bashiamiye abandu banje nibasunga mbu Omulembe, ne omulembe bikubulaho; khandi shichila olwa omundu yoombakha lisiisi, balihoomakhwo olufuyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.10",
            "verseOrgIds": [
              "EZK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho oboolele abandu abo abalihooma olufuyo, mbu liitsa okhukwa; ifula yilabaho inyinji, namachina amakhongo kelikulu, omuyeka kweimbumbuyeka nikuliabula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.11",
            "verseOrgIds": [
              "EZK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, olwa lisiisi lilaba nilikwile, shimulareebwa mbu Okhuhooma okhwa mulihoomilenje khukhali heena? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.12",
            "verseOrgIds": [
              "EZK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako kano niko aka Omwami NYASAYE aboola; mbu Ndalaliabula nomuyeka kweimbumbuyeka mubululu bwanje; ifula yilabaho inyinji muburima bwanje, namachina amakhongo kelikulu mubululu okhulimalilana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.13",
            "verseOrgIds": [
              "EZK.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio ndalalikulula lisiisi elia mwahoomilekhwo olufuyo, nindikwisia khwiloba, mbu omuse kwalio kufuunulwe; lilakwa, neenyu mulamaliIanwa hakari mulio; ne mulamanya mbu isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.14",
            "verseOrgIds": [
              "EZK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio ndaloosia obululu bwanje khwisiisi tsana, nende khubeenabo abalihoomakhwo olufuyo; ne ndalamusunjila mbu Lisiisi lihweeleho, halala nende abo abalihooma, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.15",
            "verseOrgIds": [
              "EZK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu abanabii baIsiraeli abarumbulanga khukeYerusalemu, abamulolela amabisulo komulembe, ne omulembe nikubulaho, Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.16",
            "verseOrgIds": [
              "EZK.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.16",
            "verseOrgIds": [
              "EZK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mwana womundu, rakhwo omwoyo okhufukula abakhaana babandubo, abarumbuliIanga muliira lianje amakhuwa akarula mumioyo chiabwe abeene; rumbula nobafukula, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.17",
            "verseOrgIds": [
              "EZK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ori Kano niko aka Omwami NYASAYE aboola; mbu Woowe khubakhasi abanabanga tsiriisi mubiaba biosi, nibakasia ebitambaya biokhumirwe chiabandu babuli bukhongo, okhuyiima emioyo chiabandu! Mwenya okhuyiima emioyo chiabandu banje, nimuhonia emioyo chindi khulweenywe abeene noho? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.18",
            "verseOrgIds": [
              "EZK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwayanzonooniye mubandu banje khulwa ishayiri eyifumbarwa mumakhono nende ebisonye biomukaate, okhwira abandu abarakwanile okhufwa ta, nokhuhonia abandi babe mwoyo abarakwanile okhuba mwoyo ta, khulwa obubeeyi bweenywe, olwa mubeehelanga abandu banje abareka amarwi khukobubeeyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.19",
            "verseOrgIds": [
              "EZK.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.19",
            "verseOrgIds": [
              "EZK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, kano niko aka Omwami NYASAYE aboola; mbu Lola, efukula tsiriisi tsieenywe etsia muyiimilanga emioyo shinga amanyonyi, ne ndalatsirandula tsirule khumakhono keenywe ndalalekhuula emioyo tsana, nichio emioyo echia muyiima shinga amanyonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.20",
            "verseOrgIds": [
              "EZK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebitambaya bieenywe nabio ndalarandula, nireesia abandu banje mumakhono keenywe; shibalaba mumakhono keenywe okhuyiimwa khandi ta; ne mulamanya mbu isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.21",
            "verseOrgIds": [
              "EZK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba mwabeelesiye emioyo chiabalunjishi nobubeeyi, abo aba ndarabeelesia isie ta; nende okhutinyisia amakhono komubii, mbu aleshe okhukalukha okhurula khunjilaye imbii, yeehonokoshe abe mwoyo, ta; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.22",
            "verseOrgIds": [
              "EZK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho niko akachila shimulalola amakhuwa amakhaya khandi ta, kata okhukhola obufumu; ndalareesia abandu banje mumakhono keenywe; ne mulamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.23",
            "verseOrgIds": [
              "EZK.13.23"
            ]
          }
        }
      ]
    }
