          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyanzinjisia mubwinjililo obwali elubeka Iweshilibwa niyanzusia mubisika ebitakatifu biabakuhani ebihenga enotsi; ne mubwenomwo nindola habundu ahasibila mumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.19",
            "verseOrgIds": [
              "EZK.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyasunjila mbu Hano niho aha abakuhani balateeshelanga emisango chieshiuku nemisango chiobwonooni, naha balasambila emisango chieimele; mbu baleshe okhuchiyila mulwanyi Iwelwanyi, okhwahula abandu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyambila mulwanyi Iwelwanyi, niyambisia hatsikoona tsine tsiosi tsiolwanyi tsana; ne lola, lwaliho olwanyi lundi mubuli koona yolwanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
            "verseOrgIds": [
              "EZK.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutsikoona tsiosi tsine tsiolwanyi tsana mwalimwo tsinyanyi tsinduutu, etsiachelwa oburambi amakhono amakhumi kane nobuchiikha amakhumi kataru; etsio tsine etsiali mutsikoona tsiahelana obukhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kwalimwo omushingachi okwatsifumbila, okhufumbila etsio tsine; ne kwalongwa namayika hasi wemishingachi tsana, tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
            "verseOrgIds": [
              "EZK.46.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyasunjila mbu Kano niko amateeshelo aha abakhalabani beihekalu balateeshelanga emisango chiabandu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.24",
            "verseOrgIds": [
              "EZK.46.24"
            ]
          }
        }
      ]
    }
