      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Eshilibwa shiolwanyi Iwomukari eshihenga enabukwe shilabeetsenje nishiikaale mundaalo tsisasaba tsiemilimo; ne khunyanga yasabato shileekulungwe; kata khunyanga yokhuchaaka khwomwesi shileekulwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami weshialo aleenjile nabirila mushirookoola shieshilibwa elwanyi, nasinjila hashiyindi shieshilibwa; nabo abakuhani balakasie omusangokwe omusambe nemisangochie chiokhwishia; naye alamwinamile OMWAMI hamushingachi kweshilibwa; mana alaruleho; nebutswa eshilibwa shirakheekalwa ta okhuula khubwile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abandu beshialo baleenamenje imbeli w habwinjililo bweshilibwa tsana khusabato nende khukhuchaaka khwemiesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusango omusambe okwa omwami weshialo alaleerelanga OMWAMI khunyanga yasabato kulabeetsenje amakondi keshimwamwane kasasaba akabula obulema, nelimiiku elibula obulema; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakwo omusango kweimele kulabe efa ndala khulwa limiiku, nomusango kweimele khulwa amakondi kulabe shinga olwa alar yala okhuhaana, neihini yamafura khubuli efa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunyanga yokhuchaaka khwomwesi, kube ihuunwa eyibula obulema, namakondi kasasaba, nelimiiku; biosi bibe ebibula obulema ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.6",
            "verseOrgIds": [
              "EZK.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi ayinie ebiomusango kweimele, efa ndala khulwa ihuunwa, nende efa ndala khulwa limiiku, ne khulwa amakondi shinga olwa alanyala, neihini yamafura khubuli efa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.7",
            "verseOrgIds": [
              "EZK.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omwami weshialo aleenjilamwo, aleenjile nabirila mushirookoola shieshilibwa, narulila mushio.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abandu beshialo baleetsanga imbeli w munduukho tsiemilukha, ouba niyeenjila nabirila mushilibwa shienotsi okhwinamila OMWAMI alarulile mushilibwa shiesautsi, ne ouba niyeenjila nabirila mushilibwa shiesautsi alarulile mushilibwa shienotsi; aleshe okhukalukha nabirila mushilibwa eshia yeenjiliilemwo ta; ne arule natsia imbeli shilunji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa baleenjilamwo, omwami weshialo aleenjila ninabo halala; khandi olwa balarulamwo, yesi alarula.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
