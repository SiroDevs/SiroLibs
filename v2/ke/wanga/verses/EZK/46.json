            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumasabo nomunduukho tsiemilukha, omusango kweimele kulabeetsenje efa ndala khulwa ihuunwa, nende efa ndala khulwa limiiku, ne khulwa amakondi shinga olwa alanyala okhuhaana, neihini yamafura khubuli efa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.11",
            "verseOrgIds": [
              "EZK.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omwami weshialo alayinia eshihaanwa eshia ahaana khulwa okhuchama, mbu omusango omusambe kata emisango chiokhwishia echia omwene achama okhuhaanila OMWAMI, aleekulilwe eshilibwa eshihenga enabukwe; mana alahaane omusangokwe omusambe nemisangochie chiokhwishia shinga olwa akholanga khunyanga yasabato; mana alarulemwo; ne namalile okhurula, eshilibwa shileekalwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olayininjie likondi lieshimwamwane elibula obulema khulwa omusango omusambe kwOMWAMI buli nyanga; mutsuli buli mutsuli olaliyininjie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.13",
            "verseOrgIds": [
              "EZK.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahalala ninalio olayininjie mutsuli buli mutsuli ebiomusango kweimele, eshitonye shiakhasasaba shia efa, neshitonye shiakhataru shieihini yamafura akokhutsokasilia obusie tsana obunyushe; okwo nomusango kweimele kwOMw tsindaalo tsiosi khulwa lilako elirahwaho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balabikasinjie bario, likondi liene, nomusango kweimele, namafura, mutsuli buli mutsuli, bibe omusango omusambe kwakhatsotso.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola mbu Omwami weshialo naba naheelesia oundi yesi owokhubaanabe eshihaanwa, eshiobulaamebwe; shibe shirio eshiabaanabenomwandu kwabwe khulwa obulaame. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.16",
            "verseOrgIds": [
              "EZK.46.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa naba naheelesia oundi owokhubasumbabe eshihaanwa eshiokhubulaamebwe, shilabe eshishie okhuula khumuyika kwobulekhuule; mana shilakalusilibwe omwami weshialo; abaanabe bonyene nibo abanyala okhutong'a neshihaanwa eshiokhubulaamebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.17",
            "verseOrgIds": [
              "EZK.46.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omwami weshialo arakhabukula eshiokhubulaame bwabandube, okhubarusia mumiandu chiabwe namaani, ta; alalaamile abaanabe obulaame okhurula mumiandu chichie; mbu abandu banje baleshenje okhwahukhasibwa buli mundu nemianduchie ta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
