  "reference": "Abakolosai 2",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "COL 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kholelanga mwisie nobunyali. Okhuba enzenya mbu mumanye obulwani bwanje shinga olwa buli obukhongo khulweenywe, khandi khulwabo abali eLaodikia, kata khulwabo bosi abarashiandolakhwo mumoni tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.1",
            "verseOrgIds": [
              "COL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu batinyisibwe mumwoyo, olwa baliimaasiibwe mubuheeli; khandi mbu boole khubuyinda bwosi bwobumanyilisii oburula muburechelefu, mbu bamanye libiso liaNyasaye, nilio Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.2",
            "verseOrgIds": [
              "COL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwa amabiikho kosi kobuchesi nobumanyi kabisilwa muye. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.3",
            "verseOrgIds": [
              "COL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emboola endio, mbu omundu yesi aleshe okhumukaasia mumakhuwa amakhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.4",
            "verseOrgIds": [
              "COL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kata olwa emba nimbulaho mumubili, nebutswa embeetsangaho nineenywe muroho, nindikhoya nindola obwiyanzi bweenywe, nende obutinyilifu bwobusuubili bweenywe muKristo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho shinga olwa mwamwinjisia Kristo Yesu Omwami, nilwo olwa mukhoyile okhuchendanga muye; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.6",
            "verseOrgIds": [
              "COL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "muyile emisi chieenywe muye; muumbakhwe muye; muralisibwe khulwa obusuubili bweenywe, shinga olwa mweechesibwa; mushilaasinjie okhuupanga orio.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.7",
            "verseOrgIds": [
              "COL.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulamu obulamba muKristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.7",
            "verseOrgIds": [
              "COL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwirecheshe, omundu yesi aleshe okhumuyila mumbambe khulwa amachesike, kata obukaatii obukhaya, khumakhuwa keene aka mwechesibwa nabandu nende khumakhuwa koburanjilili komushialo, nibirarula khuKristo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.8",
            "verseOrgIds": [
              "COL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba muye nimwo omwa obulamba bwosi bwObunyasaye bumenyanga eshinamubili, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.9",
            "verseOrgIds": [
              "COL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi muye nimwo omwa mwakholelelwamwo abalamba. Niye omurwe kwoburuchi bwosi nobunyali bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
              "COL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi muye nimwo omwa mwashebelwa, eshishebo eshirakholwa namakhono ta, mbu okhwinaabula imela yomubili, eshishebo shiaKristo shinga olwa shili. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.11",
            "verseOrgIds": [
              "COL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwayabilwa ninaye halala mububatisibwi, omwa mwalamusilibwa ninaye halala olwa mwasuubilila obukholi bwaNyasaye, owamulamusia okhurula mukhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.12",
            "verseOrgIds": [
              "COL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu, olwa mwali abafu khulwa obukhayi bweenywe nende oburashebwa bwemibili chieenywe ta, yamulamusia inywe halala ninaye, nakhulesheele obukhayi bweefwe bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.13",
            "verseOrgIds": [
              "COL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasiliisia ibarwa eyahandiikwa yamakhuwa aka khwasitaachilwa, eyakhufukula; nachiyiniaho, nachikhoma khumusalaba; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.14",
            "verseOrgIds": [
              "COL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanaabula aboburuchi nabobunyali abo, nabalolosia ebulafu shinga olwa bali, niyeekhoyela okhuhulakhwe olwa yabahula ninakhwo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Choomenje khukali ikulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho murafuchiilila omundu yesi amukhalachile eshiina khubiokhulia, kata ebiokhunywa, kata mwikhuwa lielisabo, kata eliomwesi omutoro, kata eliomuhongo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.16",
            "verseOrgIds": [
              "COL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienebio neshiinini butswa shiebindu ebili okhwitsa; ne omubili kwene nokwaKristo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.17",
            "verseOrgIds": [
              "COL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murafuchiilila omundu yesi amukwisie mukhulekwa khulwa okhwiyitsoomilia obwongoli nokhwinamila abamalaika ta olwa yeenjilanga muka yalola, niyeechinjimisiye khulwa amayililisioke komubili; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.18",
            "verseOrgIds": [
              "COL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shiahandanga khumurwe kwene ta; ne nokhurula khukwo okhwa omubili kwosi, nikukhoonywa nikuliimaasibwa khulwa ebiunjilo nende emisi, kukhulanga nende obukhusii bwaNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa mwafwa khumakhuwa koburanjilili komushialo halala nende Kristo, mbushiina nimurukungwa nende ameebaalo, shinga abali mwoyo mukeshialo, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.20",
            "verseOrgIds": [
              "COL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Murakanza ta; murakoonyelela ta; muratiilakhwo ta; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.21",
            "verseOrgIds": [
              "COL.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa biosi nebindu ebiikhoonyelungwa nibihwaho? Okhwo nokhulonda amalako nameechesio kabandu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.22",
            "verseOrgIds": [
              "COL.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhulolekha ako kosi kalolekhanga shinga akobuchesi, mudini eya abeene bakasia, nomubwongoli, nomukhuruka omubili nobululu; nebutswa kabula inganga okhuyinjila obwikombi bwomubili.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.23",
            "verseOrgIds": [
              "COL.2.23"
            ]
          }
        }
      ]
    }
  ],
