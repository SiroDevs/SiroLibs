        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoswa niyoombashila OMWAMI Nyasaye waIsiraeli eshimalilo shiemissngo, mushikulu shiaEbali, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga Musa omusumba wOMWAMI olwa yalaka abaana baIsiraeli, khandi shinga olwa kahandiikwa mushitabu shiamalako kaMusa, mbu eshimalilo shiamachina akarabaatsilwekhwo, aka omundu yesi arachinguuliile eshindu sl-iosi shieshibia ta; nokhubwenokhwo nibamalila OMWAMI emisango emisambe, nibamala nende emisango chiokhwishia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yahandiika yaho, khumachina ako, ikopi yamalako kaMusa, eya yahandiika abaana baIsiraeli nibaliho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaIsiraeli bosi, abarende nabeebule bosi, nabakofu babwe nabasinjilili babwe, nabayaasii babwe, nibasinjila elubeka luno welisanduku nende elubeka lulia, imbeli wabakuhani abaLawi abachinganga lisanduku lieindakano yOMWAMI; inusu khubo bali imbeli weshikulu shiaGerizimu, khandi inusu khubo imbeli weshikulu shiaEbali; shinga Musa omusumba w olwa yali niyalaka khale, mbu basabile abaIsiraeli ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyumakhwo yabasoomela amakhuwa kosi kamalako, akeikhabi nakeshilaka munwa, kosi akahandiikwa mushitabu shiamalako shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shilialiho likhuwa liosi khuka Musa yalachilisia, elia Yoswa arasooma imbeli welibukaana liosi liaIsiraeli ta, khandi imbeli wabakhasi, nabaana abatiiti, nabarende abamenyanga mubo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.35",
            "verseOrgIds": [
              "JOS.8.35"
            ]
          }
        }
      ]
