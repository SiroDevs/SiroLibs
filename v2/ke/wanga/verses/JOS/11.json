    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yabini nende abashie bahulzua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Yabini, omuruchi waHazori, yahulilakhwo, yaruma abandu ewaYobabu omuruchi waMadoni, nende omuruchi waShimironi nomuruchi waAkhishafu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.1",
            "verseOrgIds": [
              "JOS.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende ewabaruchi abali enotsi, mushialo shiebikulu, nomuAraba elubeka Iwesautsi weKhinerotsi, nomushialo shilwasi, nomuNafotsi-dori mumbo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.2",
            "verseOrgIds": [
              "JOS.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ewabaKanaani abali ebukwe nende mumbo, nabaAmori, nabaHiti, nabaPerizi, nabaYebusi abomushialo shiebikulu, nabaHiwi abali mundaalila yaHeremoni mushialo shiaMizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.3",
            "verseOrgIds": [
              "JOS.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibarula, namahe kabwe kosi, abandu abanji muno, obunji shinga omuyeshe okwokhulukuku Iweinyanza, netsifarasi tsinyinji muno, namakaari. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.4",
            "verseOrgIds": [
              "JOS.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaruchi abo bosi nibakhung'aana halala; nibeetsa nibakhupa tsikambi halala hamatsi kaMeromu, okhuseera Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Yoswa mbu Orariitsanga khulwabwe ta; okhuba mukamba khusaa yino nembahaane bosi, nibamalile okhwirwa, mumakhono kaIsiraeli; olarema tsifarasi tsiosi emisi chiebilenje, nokhupa mumakaari kabwe omulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.6",
            "verseOrgIds": [
              "JOS.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yoswa niyeetsa, nabandu belihe bosi, nibabaseera hamatsi kaMeromu, nibabasundusia nibabarootsa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.7",
            "verseOrgIds": [
              "JOS.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nabahaana mumukhono kwaIsiraeli, nibabakhupa, nibabeelusia okhuula eSidoni likali, khandi okhuula eMisirefotsi-maimu, khandi okhuula khwibanda lieMizipe ebukwe; nibabarootsa okhuula olwa baralekha omundu yesi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.8",
            "verseOrgIds": [
              "JOS.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa yabakholela shinga OMWAMI olwa yamulaka; yarema tsifarasi tsiabwe emisi chiebilenje, nakhupa mumakaari kabwe omulilo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana habwenaho Yoswa yashiukhana nabukula Hazori, nakhupa omuruchi walio nolukanga; okhuba khale Hazori nilio eliali omurwe kwoburuchi obwo bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.10",
            "verseOrgIds": [
              "JOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakhupa bosi abali nibalimwo netsinganga, nibabamalilanila elala; shishiasikalaho eshindu shiosi eshiheela omuuya ta; nasamba Hazori nomulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.11",
            "verseOrgIds": [
              "JOS.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa nabukula amatookho kosi kabaruchi abo, nabaruchi bako bosi, nabakhupa netsinganga, nabamalilanila elala; shinga Musa omusumba w olwa yali niyalaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa amataala akasinjila khubituuli, abaIsiraeil shibakasambakhwo tn, habula Hazori lionyene; lienelo Yoswa yalisamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.13",
            "verseOrgIds": [
              "JOS.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ebiyaayo biamataala ako, nemiruko, abaana baIsiraeli babibukula bibe ebioluyiitsi biabwe; habula bakhupa buli mundu nolukanga, okhuula olwa bali nibabamalilaane; kata shibalekha eshindu shiosi eshiheela omuuya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.14",
            "verseOrgIds": [
              "JOS.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga OMWAMI olwa yalaka Musa omusumbawe, nolwa Musa yalaka Yoswa; khandi nolwa Yoswa yakhola ario; shiyachweya okhukhola likhuwa liosi mukosi aka OMWAMI yalaka Musa ta.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoswa yabukula eshialo shiosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yoswa yabukula ario eshialo eshio shiosi; mbu eshialo shiebikulu, naNegebu shiosi, neshialo shiosi shiaGosheni, neshialo shiolwasi naAraba, neshialo shiebikulu shiaIsiraeli, neshialo shiolwasi shiayo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.16",
            "verseOrgIds": [
              "JOS.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhurula khushikulu shiaHalaki, elichinguukha elubeka IweSeiri, okhuula eBaali-gadi mwibanda liaLebanoni, mundaalila weshikulu shiaHeremoni; yabukula abaruchi babwe bosi, nabakhupa, nabeera ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.17",
            "verseOrgIds": [
              "JOS.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa naseerana nabaruchi abo bosi lihe oluhoono. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.18",
            "verseOrgIds": [
              "JOS.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shilialiho litaala liosi elialia omuuma kwomulembe nabaana baIsiraeli ta, habula abaHiwi abamenya muGibeoni bonyene; bakabukulila kosi mwihe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.19",
            "verseOrgIds": [
              "JOS.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila yali OMWAMI owatinyia emioyo chiabwe, okhwitsa okhuseera Isiraeli lihe, mbu abatibilie elala, barabeelwakhwo tsimbabasi ta, ne mbu abasishie, shinga OMWAMI olwa yali niyamulaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana habwenaho Yoswa niyeetsa, nasishia abaAnaki okhurula mushialo shiebikulu, nokhurula muHeberoni, nokhurula muDebiri, nokhurula muAnabu, nokhurula mushialo shiebikulu shiosi shiaYuda, nokhurula mushialo shiebikulu shiosi shiaIsiraeli; Yoswa nabamalilanila elala, namataala kabwe kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.21",
            "verseOrgIds": [
              "JOS.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shibasikalakhwo abokhubaAnaki mushialo shiabaana balsiraeli ta habula muGaza, nomuGatsi, nomuAshidodi, nimwo omwa abandi basikala. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yoswa yashibukula ario eshialo shiosi, kosi aka OMWAMI yaboolela Musa shinga olwa kali; Yoswa nashihaana shibe obulaame bwalsiraeli, emikabo chietsimbia tsiabwe shinga olwa chiali, eshialo nishihuluukha khwihe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
              "JOS.11.23"
            ]
          }
        }
      ]
    }
  ],
