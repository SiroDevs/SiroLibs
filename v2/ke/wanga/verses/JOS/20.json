            "sid": "JOS 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Yoswa ari ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana balsiraeli mbu Muhaane amataala kobwilushilo aka ndamuboolelakhwo mumunwa kwaMusa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu omwiri yesi ouba niyeetsukhana niyeera omundu, aharali tsiyemi ta, yeelushileyo; kalamubeela obwilushilo ewa mulatsiitsanga nimwilukha omumali weshikwoli shiamabanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeelushe atsie khu elala khumataala ako, asinjile hamasanganjila keshilibwa shielitaala, abuule amakhuwake mumarwi kabakotu belitaala tsana; nabo bamwinjisie mwitaala, nibamuheelesia habundu, amenyenje mubo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omumali weshikwoli shiamabanga naba namulondachilila, baramuhaana omwiri oyo mumukhonokwe ta; shichila yeetsukhana niyeera owashie, narabeele niyamuhamibile obusuku khale ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amenye mwitaala tsana okhuula olwa alasinjila imbeli womukhung'aano okhuyaasibwa, okhuula khukhufwa khwomukuhani omukhulundu oulaba naliho mundaalo etsio; mana habwenaho omwiri akalushe atsie khwitaalalie, khandi munzuye, khwitaala liene elia yeelukha narulayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibaahula Kedeshi muGalilaya, mushialo shiebikulu shiaNafutali, naShekhemu mushialo shiebikulu shiaEferaimu, naKiriatsi-araba, nilio Heberoni, mushialo shiebikulu shiaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne injelekha weYorodani eYeriko ebukwe bahaana Bezeri mushitsiimi mumuhololookhwe, muluyia lwaReubeni; naRamotsi muGileadi, muluyia lwaGadi; naGolani muBashani, muluyia lwaManase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko amataala akareebwaho khulwa abaana baIsiraeli bosi, khandi khulwa omurende owakhaba namenyakhwo mubo, mbu omundu yesi owitsukhana niyeera omundu, yeelushileyo, aleshe okhufwa khumukhono kwomumali weshikwoli shiamabanga, okhuula olwa alaba nasinjiile imbeli womukhung'aano.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
