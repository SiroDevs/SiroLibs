    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaluuri nibarumwa eYeriko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yoswa waNuni yaruma abandu babili abaluuri mabiswi okhurula eShitimu, ari Tsie muhenjelesie eshialo, nende Yeriko. Nabo nibatsia, niboola enanzu womukhasi omutamba owa eliiralie niRahabu, nibakonayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi waYeriko yaboolelwa mbu Lola, abandu abokhubaana baIsiraeli beenjiile hano eshilo shino okhurunilisia eshialo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi waYeriko naruma abandu ewaRahabu, ari Rusia abandu abeetsile ewuwo, abeenjiile munzuwo; okhuba beetsile okhurunilisia eshialo shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukhasi tsana yabukula abandu abo babili nababisa; nasunga ari Toto, abandu abo beetsile ewanje, ne shimbamanyile ewa babeele nibarula ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa eshise shiulile eshiokhwikala eshilibwa, nibwilile, abandu tsana barulile; shimanyile ewa abandu abo batsiile tamubalondachilile bwangu; mulabanyoola. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali nabayilile khushilama hekulu, nababisile mumakata kemimela chieikitani aka yali nabaakaale khushilama. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu nibabalondachila khunjila yaYorodani okhuula khunyambukho; ne ababalondachila abo nibakharula, eshilibwa shieekalwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibashili okhukona, yaniina ewa bali khushilama, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.8",
            "verseOrgIds": [
              "JOS.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasunjila abandu abo mbu Emanyile shinga OMWAMI olwa yamuheelesia eshialo, khandi shinga oburii olwa bukhukwiliile khulweenywe; khandi shinga abamenyanga mushialo shino olwa basabulukhana butswa imbeli weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.9",
            "verseOrgIds": [
              "JOS.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khwahulila shinga OMWAMI olwa yakhamia amatsi keInyanza Inzakhanyu imbeli weenywe olwa mwarula eMisiri; nende aka mwakholela abaruchi abo babili babaAmori abali injelekha weYorodani, mbu Sihoni naOgu, aba mwamalilana pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.10",
            "verseOrgIds": [
              "JOS.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefu nikhuhuliilekhwo, habwenaho emioyo chieefwe chiayengukha, kata itswoni shiyali mumundu yesi ta, khulweenywe; okhuba OMWAMI Nyasaye weenywe niye ouli Nyasaye ikulu mwikulu khandi mushialo hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.11",
            "verseOrgIds": [
              "JOS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho emusaaya mundiitsubile imbeli w, mbu shinga olwa emubeeleele tsimbabasi, neenyu mukhubeele tsimbabasi abeinzu yeefwe, nimumbeelesia eshilolelo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu muhonokosie papa namama nabasiani beefwe nabakhaana beefwe, nende biosi ebia bali ninabio, babe mwoyo; mbu muhonie obulamu bweefwe mukhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.13",
            "verseOrgIds": [
              "JOS.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu abo nibamusunjila mbu Obulamu bweefwe khulwa obweenywe! Nimuba nimurabuula amakhuwa keefwe kano ta, olwa OMWAMI alamala akhuheelesie eshialo, khulakhukholela aketsimbabasi nakobwatoto.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yabeesilia mwitirisha nomukoye; okhuba inzuye yali khulukoba Iwelitookho; naye yamenya mulukoba bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.15",
            "verseOrgIds": [
              "JOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yababoolela mbu Mutsie mubikulu, abamulondachilanga baleshe okhumunyoolelesia; mwibisileyo tsindaalo tsitaru, okhuula abamulondachililanga olwa balaba nibacheleele; mana olunyumakhwo mutsie butsia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.16",
            "verseOrgIds": [
              "JOS.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu abo nibamusunjila mbu Shikhulabakhwo neshikha khushiitsuboshio shino eshia okhutsubiye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.17",
            "verseOrgIds": [
              "JOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, olwa khulaba nikhwinjiile mushialo shino, obohe olutsaha luno oluranzayi mwitirisha lino elia okhwisiliyemwo; nokhung'aasia munzuyo so, nende mawo, nabaana beenywe, nabosi abeinzu yeenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.18",
            "verseOrgIds": [
              "JOS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omundu yesi weinzu yeenywe naba narula elwanyi, khunjila, amabangake kabe khumurwekwe omwene, neefu khubule eshikha; ne ouba nali ninawe munzu, amabangake kabe khumirwe chieefwe, omundu naba namuyilakhwo omukhono. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.19",
            "verseOrgIds": [
              "JOS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa noba nobuula amakhuwa keefwe kano, kho shikhulabakhwo neshikha khushiitsuboshio eshia okhutsubiye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
              "JOS.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia mbu Shinga olwa muboolile, nolwa kalaba kario. Nabaseebula, nabo nibeenyokha; mana naboha olutsaha oluranzayi mwitirisha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibatsia niboola mubikulu, nibamenyayo tsindaalo tsitaru, okhuula ababalondachilanga olwa bali nibacheleele; ababalondachila tsana nibabakhaaba khunjila yosi pe, nibarabanyoola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.22",
            "verseOrgIds": [
              "JOS.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu abo babili nibakalukha, nibeekha okhurula mubikulu, nibaambukha, nibatsia ewaYoswa waNuni; nibamuboolela kosi akali nikabakwiliile. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.23",
            "verseOrgIds": [
              "JOS.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasunjila Yoswa bari Toto, OMWAMI ahaanile eshialo shiosi mumakhono keefwe; abamenyangamwo nabo batechela butswa imbeli weefwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.24",
            "verseOrgIds": [
              "JOS.2.24"
            ]
          }
        }
      ]
    }
