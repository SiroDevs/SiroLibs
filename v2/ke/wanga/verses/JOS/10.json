              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoswa narula eMakeda, nende abaIsiraeli bosi, nibabira niboola eLibina, nibaseera Libina; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalio khandi OMWAMI nalihaana mumakhono kaIsiraeli, nende omuruchi walio, nalikhupa netsinganga, nabosi abali nibalimwo; shiyalekhamwo omundu yesi ta; nakholela omuruchi walio shinga olwa yali niyakholela omuruchi waYeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
