              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoswa narula eLakhishi, nende abaIsiraeli bosi, nibabira niboola eEgeloni; nibaliikalila, nibaliseera; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibalibukula khunyanga yeneyo, nibalikhupa netsinganga; ne bosi abali nibalimwo yabamalilanila elala khunyanga yeneyo, kosi aka yali nakholeele Lakhishi shinga olwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
