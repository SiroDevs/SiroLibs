          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yoswa yahula ario eshialo shiosi, mbu eshialo shiebikulu, naNegebu, neshialo shiolwasi, nebisia, nende abaruchi babio bosi; kata shiyalekha omundu yesi ta; ne yamalilanila elala biosi ebiheelanga omuuya, shinga OMWAMI Nyasaye waIsiraeli olwa yali niyalaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa nabakhupa okhurula eKadeshi-barinea okhuula eGaza, neshialo shiosi shiaGosheni okhuula eGibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaruchi abo bosi neshialo shiabwe, Yoswa yabukulila khushise shilala, okhuba OMWAMI Nyasaye waIsiraeli yalwanila Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoswa nakalukha, nende Isiraeli yosi, khukambi yeGiligali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
            "verseOrgIds": [
              "JOS.10.43"
            ]
          }
        }
