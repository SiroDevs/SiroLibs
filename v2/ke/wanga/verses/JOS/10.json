              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoswa narula eLibina, nende abaIsiraeli bosi, nibabira niboola eLakhishi; nibaliikalila, nibaliseera; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nahaana Lakhishi mumukhono kwaIsiraeli, naye nalibukula khunyanga yakhabili, nalikhupa netsinganga, nabosi abali nibalimwo, kosi aka yali nakholeele Libina shinga olwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        }
      ]
    },
    {
