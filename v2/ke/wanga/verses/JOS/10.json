          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Horamu, omuruchi waGezeri, natikulukha niyeetsa okhuhabina Lakhishi; Yoswa namukhupa, nende abandube, naralekha omundu yesi ta.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
      ]
    },
