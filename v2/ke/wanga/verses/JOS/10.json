            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoswa natikulukha okhurula eEgeloni, nende abaIsiraeli bosi, niboola eHeberoni; nibaliseera; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibalibukula, nibalikhupa netsinganga, nomuruchi walio, namataala kalio, nabosi abali nibalimwo; shiyalekha omundu yesi ta, kosi aka yali nakholeele Egeloni shinga olwa kali; ne yalimalilanila elala, nabosi abali nibalimwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
