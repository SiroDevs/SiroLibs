              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoswa nakalukha, nende abaIsiraeli bosi, niboola eDebiri; nibaliseera; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalibukula, nomuruchi walio, namataala kalio; nibabakhupa netsinganga, nibamalilanila elala bosi abali nibalimwo; shiyalekha omundu yesi ta; shinga olwa yali nakholeele Heberoni, nolwa yakholela Debiri nomuruchi walio; khandi shinga olwa yali niyakholela Libina nomuruchi walio.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
