            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Finehasi omukuhani nabakhulundu bomukhung'aano, nibo abeemilisi bebilibwa biaIsiraeli aba yali ninabo, olwa bahulila amakhuwa aka abaana baReubeni nabaana baGadi nabaana baManase baboola, kabakaasila muno. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Finehasi waEleazari omukuhani yasunjila abaana baReubeni nabaana baGadi nabaana baManase, ari Leelo luno khumanyile shinga OMWAMI olwa ali hakari weefwe, shichila shimukholile obukhayi bulia nimufukula OMWAMI ta; bulaano muhoniye abaana baIsiraeli okhurula mumukhono kwOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Finehasi waEleazari omukhuhani, nende abakhulundu tsana, nibakalushila abaana baIsiraeli mushialo shiaKanaani, okhurula khubaana baReubeni nabaana baGadi, okhurula mushialo shiaGileadi, nibabakalusilia amakhuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa ako nikakaasila abaana baIsiraeli; nabo abaana baIsiraeli nibamwitsoomia Nyasaye; kata shibaralakhwo khandi akokhutikulukha okhubaseera, okhumulula eshialo eshia abaana baReubeni nabaana baGadi bamenyangamwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baReubeni nabaana baGadi nibakulikha eshimalilo tsana mbu Obuloli; bari Neshiobuloli hakari weefwe mbu OMWAMI niye Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        }
      ]
