    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyasaye yalobola Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emboola obwatoto muKristo, shimbeeha ta akomumwoyo kwanje nako nikarumbulana ninasi akobuloli muRoho Omutakatifu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.1",
            "verseOrgIds": [
              "ROM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu enzuunungwa omwoyo muno, nimba neshibeela obushia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.2",
            "verseOrgIds": [
              "ROM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ndakhanyala okhwikomba mbu isie omwene embe mushilaamo shiobubii eshingabukhasia nende Kristo khulwa abaana beefwe, aboluyia lwanje khulwa imela yomubilij ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.3",
            "verseOrgIds": [
              "ROM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibo abaIsiraeli; okhukholwa abaana nokhwabwe, noluyali, netsindakano, neshihaanwa shiamalako, nobukhalabani bwaNyasaye, nende obusuubisii, biosi nebiabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.4",
            "verseOrgIds": [
              "ROM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakuuka nabo nababwe, khandi khumela yomubili Kristo nowabwe, oyo ouli hekulu wabiosi, Nyasaye owitsoomibwa obushia nobushia. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shikali mbu likhuwa liaNyasaye liafuba ta. Okhuba abarula khuIsiraeli shibali bosi abalsiraeli ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.6",
            "verseOrgIds": [
              "ROM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shibali bosi abaana baAburahamu shichila nabolwibulolwe, tawe; habula mbu Olwibulolwo lulikulishilwa muIsaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.7",
            "verseOrgIds": [
              "ROM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshisina mbu shibali abaana beimela yomubili abali abaana baNyasaye ta; nebutswa abaana bobusuubisii nibo ababasibwa mbu nolwibulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.8",
            "verseOrgIds": [
              "ROM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila lino nelikhuwa liobusuubisii mbu Induukho niyulile shinga yino, ndiliitsa; naye Sara aliba nende omwana omusiani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.9",
            "verseOrgIds": [
              "ROM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shikali ako konyene ta; habula abaana baRebeka, saabwe yali mulala, niye kuuka weefwe Isaka; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.10",
            "verseOrgIds": [
              "ROM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne abaana nibarashieebulwa ta, kata nibarashiakhola likhuwa liosi kata lilayi kata libii tawe; habula mbu tsiyemi tsiaNyasaye etsiobulobolwi tsibeho, niburali bwebikhole ta, habula bwa oyo oulanga ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.11",
            "verseOrgIds": [
              "ROM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rebeka yaboolelwa ari Omukhulundu alimukhalabanila omushe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.12",
            "verseOrgIds": [
              "ROM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga olwa kahandiikwa, mbu Ndamuheelile Yakobo, ne Esau ndamuchwang'ile.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khusunje khurie? Nyasaye alimwo obushiamu noho? 'A, nahatuutu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.14",
            "verseOrgIds": [
              "ROM.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba yasunjila Musa ari Ndalabeela tsimbabasi owa embeela tsimbabasi; khandi ndalamutiililwa eshisa owa endiililwa eshisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho shikali aka oyo owenya, kata aka oyo ounyakhana ta, habula akaNyasaye oubeelanga tsimbabasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.16",
            "verseOrgIds": [
              "ROM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba amahandiiko kaboola khuFarao, kari Likhuwa lino nilio elichila nikhwemekha, mbu endolosilie obunyali bwanje mwiwe, khandi mbu eliira lianje lifumenje mushialo shiosi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.17",
            "verseOrgIds": [
              "ROM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho amubeelanga tsimbabasi owa achama okhubeela tsimbabasi, ne owa achama okhuhandalasia, amuhandalasinjia.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.18",
            "verseOrgIds": [
              "ROM.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.18",
            "verseOrgIds": [
              "ROM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho fwana witsa okhundeeba, mbu Ne mbushiina nashikhutulanga? Okhuba niwina ounyala okhukhaya aka yeenya? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.19",
            "verseOrgIds": [
              "ROM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "'A, tawe. Musaatsa iwe, niwe wina ouyingania Nyasaye? Eshilonjilwe shinyala okhureeba oyo owashilonga mbu Unonjile orio mbushiina? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.20",
            "verseOrgIds": [
              "ROM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omulonji yesi, shiali nende obunyali khwitoyi, mbu mumuhayila mulala alonga eshitonye eshindu eshiheebwa oluyali, neshitonye shindi eshindu eshibula oluyali, ta? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
            "verseOrgIds": [
              "ROM.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shikakhanyala okhuba kari nanwa, mbu Nyasaye, kata olwa yeenya okhulolosia oburimabwe nokhumanyisia obunyalibwe, yeefwila nende obwisimilisi obunji ebimanulwa ebikwanila oburima, ebiakasilibwa obutibi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.22",
            "verseOrgIds": [
              "ROM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu amanyisie obuyinda bwoluyalilwe khubimanulwa bietsimbabasi, ebia yakasilia oluyali khale? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
              "ROM.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio nifwe aba yalanga, ne khubaYahudi bonyene ta, habula khuBamahanga bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.24",
            "verseOrgIds": [
              "ROM.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga olwa yasunga muHosea, mbu",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya yesi alanjisia khumakhuwa kalsiraeli, nasunga mbu Obunji bwabaana baIsiraeli kata nibuli shinga omuyeshe munyanza, ne nomusikalo butswa okulihonibwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba Omwami aliusia obukhalachibwe mushialo, nalimalilisia nalikhalaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.28",
            "verseOrgIds": [
              "ROM.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, shinga Isaya olwa yaboola khale, mbu",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isiraeli nende Injiili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khusunje khurie? Mbu Abamahanga, abaralondachilila obulunjishi ta, boola khubulunjishi, nibwo obulunjishi oburula mubusuubili; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.30",
            "verseOrgIds": [
              "ROM.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 9:31"
          },
          "items": [
            {
              "text": "31",
