        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusuubili bwaAburahamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nakhusunje khurie khuAburahamu, omwibuli weefwe mubwibuli bwomubili? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.1",
            "verseOrgIds": [
              "ROM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Aburahamu naba niyabasilibwa obulunjishi khulwa ebikhole, aba nali nende eshia yeetsialila; ne imbeli waNyasaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.2",
            "verseOrgIds": [
              "ROM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba amahandiiko kaboola karie? Mbu Ne Aburahamu yasuubila Nyasaye, nakhwo nikhumubasilibwa okhuba obulunjishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumundu oukholanga emilimo, omurungokwe shikumubasilibwa mbu nokwobukoosia ta, habula nokwelikobi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.4",
            "verseOrgIds": [
              "ROM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumundu ourakhola emilimo ta, habula amusuubilila oyo oubabasilia obulunjishi abo abaramuria ta, obusuubilibwe bumubasilibwa okhuba obulunjishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.5",
            "verseOrgIds": [
              "ROM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga Daudi yesi olwa yarumbula, mbu noweikhabi omundu oyo owa Nyasaye abasilinjia obulunjishi aharali ebikhole ta, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.6",
            "verseOrgIds": [
              "ROM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.8",
            "verseOrgIds": [
              "ROM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ikhabi eyo yili khubeshishebo, nohomba khubasinde bosi? Okhuba khuboolanga mbu Aburahamu yabasilibwa obusuubilibwe okhuba obulunjishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.9",
            "verseOrgIds": [
              "ROM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yabasilibwa arie? Olwa yali niyashebwa, nohomba olwa yali nashili omusinde? Shibwali mukhushebwa ta, habula mubusinde; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.10",
            "verseOrgIds": [
              "ROM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye yaheebwa eshilelo shieshishebo, mbu shitinyie obulunjishi bwobusuubili obwa yali ninabwo olwa yali nali omusinde; mbu abe kuukanyene bosi abasuubilanga, kata olwa bali abasinde, mbu mana obulunjishi bubabasilibwekhwo; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.11",
            "verseOrgIds": [
              "ROM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu abe kuukanyene abeshishebo, abarashebwa bushebwa butswa ta, habula abeechendelesia nibalonda munjila yobusuubili bwenobwo obwa kuuka weefwe Aburahamu yali ninabwo nali omusinde.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akasuubibwa kanyooleshela mubusuubili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba likhuwa elia Aburahamu nende abeetsukhulube basuubisibwa, mbu yakhalaamilwa eshibala shiosi, shiyalisuubisibwa munjila yamalako ta, habula munjila yobulunjishi oburula mubusuubili. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila abali abamalako nibaba nibali abobulaame, obusuubili buba obwabutswa, khandi obusuubisii buba obukhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila amalako keebula oburima; ne aha ameebaalo kabula, obukhayi nabwo bubulaho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila nilili eliobusuubili, mbu liitse munjila yobukoosia; mbu obusuubisii buralisibwe khubeetsukhulube bosi; shibali abo bonyene abali abamalako ta, habula nende abo abali bobusuubili bwaAburahamu, ouli kuuka weefwe fwesi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
              "ROM.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "(shinga olwa liahandiikwa, mbu Ndakhukhola iwe obe kuukanyene amahanga amanji), imbeli wa oyo owa yasuubililanga, niye Nyasaye oulamusinjia abafu nalanga ebindu ebiralikhwoho ta mbu bibeho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.17",
            "verseOrgIds": [
              "ROM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye mubunaayi yasuubilila kata akaranaayikha ta, mbu mana yeekhole kuukanyene amahanga amanji, shinga olwa kaboolwa, mbu Abeetsukhulubo baliba bario. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusuubilibwe shibwateshelana ta kata olwa yayililisia khumubili kukwe okwali butswa shinga omufu, shichila yali owemiyika shinga eshikhumi, kata nende obufu bwolubeleshelo lwaSara ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
            "verseOrgIds": [
              "ROM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, olwa yahenga obusuubisii bwaNyasaye shiyakanakania kata okhuhayahayia khulwa oburasuubila ta, ne yakufuhala khulwa obusuubili, namuheelesia Nyasaye oluyali, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.20",
            "verseOrgIds": [
              "ROM.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "namanya bulayi mbu aka yasuubisia khandi anyala okhukakhola.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.21",
            "verseOrgIds": [
              "ROM.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.21",
            "verseOrgIds": [
              "ROM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila nibumubasilibwa okhuba obulunjishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.22",
            "verseOrgIds": [
              "ROM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shikahandiikwa khululwe yenyene ta, mbu bumubasilibwa burio; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.23",
            "verseOrgIds": [
              "ROM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula khulweefwe fwesi, aba bulabasilibwakhwo, ifwe abasuubilila oyo owalamusia Yesu Omwami weefwe okhurula mukhufwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.24",
            "verseOrgIds": [
              "ROM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwenoyo owakhobwa khulwa obukhayi bweefwe, nalamusibwa mbu khubasilibwekhwo obuluniishi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.25",
            "verseOrgIds": [
              "ROM.4.25"
            ]
          }
        }
      ]
    }
  ],
