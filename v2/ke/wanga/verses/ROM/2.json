{
  "id": "ROM.2",
  "number": "2",
  "bookId": "ROM",
  "reference": "Abaroma 2",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ROM 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukhalachi bwaNyasaye buli habwene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila iwe, omundu wesi oukhalakanga eshiina, obula eshibeehele shiosi; shichila habwenaho olwa okhalachilanga owashio, wikhalachilanga omwene; shichila iwe oukhalakanga, wesi okholanga amakhuwa malala akeenako. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.1",
            "verseOrgIds": [
              "ROM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumanyile mbu obukhalachi bwaNyasaye buli habwene khubeenabo abakholanga amakhuwa ako. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.2",
            "verseOrgIds": [
              "ROM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, omundu iwe oubakhalachilanga eshiina abakholanga bario, omwene nokholanga amalala akeenako, okaalanga mbu oleehonokokha obureenjila mushiina shiaNyasaye noho? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.3",
            "verseOrgIds": [
              "ROM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nohomba olechile obuyinda bweshisashie nende tsimbabasitsie nende obwisimilisiibwe, nokorwa shinga olwa eshisa shiaNyasaye shikhukhweselanga obwikalukhasii? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.4",
            "verseOrgIds": [
              "ROM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwa obutinyu bwomwoyokwo okureekalukhasia ta, wibiishilanga omwene oburima okhuula khunduukho eyo yoburima nobufwimbulwi bweshiina eshilunji shiaNyasaye? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.5",
            "verseOrgIds": [
              "ROM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye alakabila buli mundu habwene, ebikholebie shinga olwa bili; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.6",
            "verseOrgIds": [
              "ROM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu abeenabo abeesimilisia mukhukhola amalayi, nibakhaaba bario oluyali neifuma noburafwa ta, alabakabila obulamu bwobumeli; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.7",
            "verseOrgIds": [
              "ROM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne abeenabo abamayinje abakhaya okhuhulila amalako kobwatoto, habula nibahulilanga amalako kobumayaanu, alabakabila oburima nobusinyishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.8",
            "verseOrgIds": [
              "ROM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatinyu nende amasila kalaba khumwoyo kwabuli mundu oukholanga obumayaanu, olwambeli khumuYahudi, khandi nende khumuYunani; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.9",
            "verseOrgIds": [
              "ROM.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne oluyali neifuma nomulembe bilaba khubuli mundu oukholanga obulayi, olwambeli khumuYahudi, khandi nende khumuYunani; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.10",
            "verseOrgIds": [
              "ROM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba Nyasaye abula ebiela.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.11",
            "verseOrgIds": [
              "ROM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.11",
            "verseOrgIds": [
              "ROM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abo bosi aboonoona sila amalako, balatiba bario sila amalako; ne abo bosi aboonoona nibali nende amalako, balayaasilibwa khumalako. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.12",
            "verseOrgIds": [
              "ROM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shibali abahulili bamalako ababa abalunjishi imbeli waNyasaye ta; habula abakholi bamalako balabasilibwakhwo obulunjishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.13",
            "verseOrgIds": [
              "ROM.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Abamahanga ababula amalako olwa baba nibakhola akamalako nibeebaalilwa noburuIanda bwabwe, bo, ababula amalako, bali amalako khubwabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.14",
            "verseOrgIds": [
              "ROM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila balolosia emilimo chiamalako akahandiikwa mumioyo chiabwe, emioyo chiabwe nachio nichifuchilisania ninako khukobuloli, amayililisio kabwe akeene khukeene nikabasitaaka kata khandi okhubaterela. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.15",
            "verseOrgIds": [
              "ROM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaliba kario khunyanga eyo olwa Nyasaye aliyaasia tsiyemi tsiabandu tsiamabiswi, injiili yanje shinga olwa yiboola, muYesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.16",
            "verseOrgIds": [
              "ROM.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AhabaYahudi nende Amalako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.16",
            "verseOrgIds": [
              "ROM.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne iwe, owilanganga mbu omuYahudi, wisetaminjia khumalako, niwiyitsialila, muNyasaye, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.17",
            "verseOrgIds": [
              "ROM.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga olwa wamanya aka yeenya, nofuchiilila ako akashila obulayi, shichila weechesilibwa khukamalako. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.18",
            "verseOrgIds": [
              "ROM.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omanyilanga elala omwene, mbu toto mwene oli omwimilisi wababofu, nobulafu bwabeenabo abali mushiilima, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.19",
            "verseOrgIds": [
              "ROM.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomwibaali wabayingwa, nomwechesia wabatoro; mumalako tsana oli nende likondo liene liobumanyi nende obwatoto. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.20",
            "verseOrgIds": [
              "ROM.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho iwe, owechesinjia oundi, shiwiyeechesinjia omwene ta? Iwe owilwatsanga mbu omundu areeba ta, omwene wakhaba wibanga? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.21",
            "verseOrgIds": [
              "ROM.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ouboolanga mbu omundu araheya ta, omwene oheyanga noho? Iwe ousilanga ebifwanani ebiinamilungwa, omwene wibanga ebiomutsihekalu? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.22",
            "verseOrgIds": [
              "ROM.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe owichinjimisilia akamalako, khulwa okhwonooninjia amalako wakhaba nomufwolanga Nyasaye? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.23",
            "verseOrgIds": [
              "ROM.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga olwa kahandiikwa, eliira liaNyasaye linyekungwa muBamahanga khulweenywe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.24",
            "verseOrgIds": [
              "ROM.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.24",
            "verseOrgIds": [
              "ROM.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila eshishebo shikaasanga noba noli omukholi wamalako; ne noba noli omukhayi wamalako, okhushebwakhwo khukwile oburashebwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.25",
            "verseOrgIds": [
              "ROM.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omusinde naba nahulilanga akeenywa mumalako, obusindebwe shibulabasibwa mbu neshishebo? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.26",
            "verseOrgIds": [
              "ROM.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ouli omusinde owoburulanda, naba niyoosinjia habwene akamalako, shialakhukhalachila eshiina, iwe oukhayanga amalako, kata olwa oli ninabio amahandiiko nende eshishebo? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.27",
            "verseOrgIds": [
              "ROM.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ye shiali omuYahudi ouli ario mumakhuwa kelwanyi ta; kata eshio shishili eshishebo eshili elwanyi, khumubili, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.28",
            "verseOrgIds": [
              "ROM.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ye nomuYahudi ouli ario mukari; khandi eshishebo neshieneshio eshiomwoyo, shiaroho, ne eshielihandiiko tawe; owa obupaakwibwe burarula khubandu ta, habula khuNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.29",
            "verseOrgIds": [
              "ROM.2.29"
            ]
          }
        }
      ]
    }
  ],
