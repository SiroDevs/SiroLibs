              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila Nyasaye yabalekha mubwilaasi bwabwe obwetsisoni; okhuba abakhasi babwe bakalula eshiima shioburulanda shibe eshindi eshirali shioburulanda ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabasaatsa bosi bario, balekha eshiima shioburulanda shiabakhasi, nibaashila mubwilaasi bwabwe, abasaatsa nibakholana nende abasaatsa abashiabwe akarakhoyeele ta, nibeenyoolela abeene omurungo okuhela obukori bwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
