              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shinga olwa barafuchiilila okhumumanya Nyasaye ta, kho Nyasaye yabalekhuula mubuyililisi bweshifwabwi, mbu bakholenje akeenako akarakhoyela ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali abeetsulamwo obushiamu bwosi, nobumayaanu, nelikhalikhali, nobukhobi; nibeetsulamwo imbalikha, obwiri, obusoolo, obubatsa, obuchesichesi; nabamoonyi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "abachiishi, abakiyanga Nyasaye, abamahababa, abeechinjimisii, abeisunga, abakulukunzi bamabii, abarahulilanga abeebuli babwe ta, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababula obuchesi, abasasii betsindakano, ababula obuheeli bwoburulanda kata tsimbabasi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata olwa bamanya obukhalachi bwaNyasaye mbu abakholanga amakhuwa akafwana kario bakwanile okhufwa, bakakholanga bukhola; ne shikali ako konyene ta, habula bafuchilisaninjia nende abakakholanga.",
          "type": "text",
