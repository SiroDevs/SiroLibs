          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obusoolo bwalinjiho hakari waAsa naBaasha omuruchi waIsiraeli tsindaalo tsiabwe tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
