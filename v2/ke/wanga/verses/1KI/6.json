          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuliango kweshisika shiomukari y akhola tsinzichi tsiemitsieituni; eliatiilwa nebiyindi biaanzwa tsimbeka tsiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhola tsinzichi etsio tsibili tsietsimbaho tsiemitseituni natsibaatsakhwo ebifwanani ebibaatse biabakerubi, nemisaala chiamashindu, nebimuli ebibambuukhu, natsifuumakhwo itsahaabu, niyaala itsahaabu khubakerubi nokhumishindu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        }
      ]
    },
    {
