          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaatsakhwo abakerubi, nemishindu, nebimuli ebibambuukhu; nabifuumakhwo itsahaabu eyachelekhasibwa bulayi khubifwanani ebibaatse. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yoombakha olwanyi Iwomukari tsinyali tsitaru tsiamachina amabaatse nolunyali lulala Iwetsimbaho tsiemisiita.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
