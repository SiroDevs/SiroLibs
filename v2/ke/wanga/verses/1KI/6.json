          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yabaatsa lisiisi lieinzu liosi tsimbeka tsiosi ebifwanani ebibaatse biabakerubi, nemisaala chiamashindu, nebimuli ebibambuukhu, mubisika biomukari nende mubielwanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
