              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwakhane omuse kweinzu yOMWAMI kwakhupwa, mumwesi kwaZibu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
