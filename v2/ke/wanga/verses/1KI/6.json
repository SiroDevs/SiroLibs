              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nafuuma abakerubi tsana itsahaabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
