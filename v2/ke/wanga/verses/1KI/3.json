              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi nakalusia naboola mbu Mumuheelesie ulia omwana ouli mwoyo; muramwira ta; niye nyinamwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.27",
