          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Hiramu yaruma abasumbabe bandi mumukanda tsana kwamaaro, abasitsa bamaaro, abamanya akeinyanza, halala nabasumba baSulemani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
