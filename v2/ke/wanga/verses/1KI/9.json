            }
          ]
        },
        {
          "text": "Khandi omuruchi Sulemani yakhola omukanda kwamaaroke eEzionigeberi, elirondokhana naElotsi, khulukuku IweInyanza Inzakhanyu, mushialo shiaEdomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
