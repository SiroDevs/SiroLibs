  "bookId": "1KI",
  "reference": "1 Abaruchi 18",
  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eliya yakalukha ewaAhabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyuma lwetsindaalo tsinyinji, likhuwa liOMWAMI liamwitsila Eliya, mumuyika kwakhataru, liri Tsia, wilolosie imbeli waAhabu; mana ndalakwisia ifula khushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.1",
            "verseOrgIds": [
              "1KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya natsia okhwilolosia imbeli waAhabu. Ne inzala yali ikhongo muSamaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.2",
            "verseOrgIds": [
              "1KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Ahabu nalanga Obadia, owasinjilila akelitookho. Naye Obadia yariitsanga OMWAMI muno; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.3",
            "verseOrgIds": [
              "1KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa Yezebeli yamalilana abanabii bOMWAMI, Obadia yabukula abanabii eshikhumi, nababisa amakhumi karaano karaano mumbinga, nabaliisia ebiokhulia nende amatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.4",
            "verseOrgIds": [
              "1KI.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu naboolela Obadia mbu Tsia olambuule eshialo shiosi, tsisebele tsiosi tsiamatsi nende emichela chiosihaundi khwakhanyoola obunyasi, khuhonokosie tsifarasi netsinyumbu tsibe mwoyo, khuleshe okhufwilwa emiruko chiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.5",
            "verseOrgIds": [
              "1KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibakabana eshialo, okhushilambuula; Ahabu natsia elubeka lundi yenyene, naye Obadia natsia elubeka lundi yenyene.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.6",
            "verseOrgIds": [
              "1KI.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.6",
            "verseOrgIds": [
              "1KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Obadia yali nali khunjila, Eliya yamwakaanila; naye namumanya, nasikama nabunamia obweni, nasunga mbu Khane niwe omwami wanje Eliya? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.7",
            "verseOrgIds": [
              "1KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namukalusia mbu Nisie; tsia oboolele omwamiwo mbu Lola, Eliya aliho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.8",
            "verseOrgIds": [
              "1KI.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ari Ne enzonoonile shi, mbu wenya okhumbaana isie omusumbawo mumukhono kwaAhabu, yanzire? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.9",
            "verseOrgIds": [
              "1KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga OMWAMI Nyasayewo olwa ali mwoyo, libulaho lihanga kata oburuchi bwosi ewa omwami wanje ararumileyo okhukhukhaaba; mana olwa basunganga mbu Shiali hano ta, yeetsubinjia lihanga elo kata oburuchi obwo eshiitsubo mbu shibakhuluutsikhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.10",
            "verseOrgIds": [
              "1KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano oboola mbu Tsia oboolele omwamiwo mbu Lola, Eliya aliho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.11",
            "verseOrgIds": [
              "1KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa nembe nindakhakhurulakhwo, Roho wOMWAMI alakhuyila aha endamanyile ta; mana olwa nenzie nimuboolela Ahabu, naye narakhunyoola ta, alanzira; nebutswa isie omusumbawo eriitsanga OMWAMI okhurula khuluraaka lwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.12",
            "verseOrgIds": [
              "1KI.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami wanje, shiwaboolelwa aka ndakhola olwa Yezebeli yeera abanabii bOMWAMI? Shinga olwa ndabisa abandu eshikhumi khubo, amakhumi karaano karaano mumbinga, nimbaliisia ebiokhulia nende amatsi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.13",
            "verseOrgIds": [
              "1KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano oboola mbu Tsia oboolele omwamiwo mbu Lola, Eliya aliho; mbula, alanzira. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.14",
            "verseOrgIds": [
              "1KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya nasunga mbu Shinga OMWAMI omwene mahe olwa ali mwoyo, owa ekhalabanilanga, shindalachweya okhwilolosia imbeliwe leelo luno ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.15",
            "verseOrgIds": [
              "1KI.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Obadia natsia okhumubukaanila Ahabu, namuboolela; naye Ahabu natsia okhumubukaanila Eliya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.16",
            "verseOrgIds": [
              "1KI.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.16",
            "verseOrgIds": [
              "1KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Ahabu yalola Eliya, Ahabu yamusunjila ari Kho niwe, iwe omunyasii waIsiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.17",
            "verseOrgIds": [
              "1KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia mbu Shindi isie ounyasiye Isiraeli ta; habula niwe, nende abeshilibwa shieenywe, olwa mwasukuna amalako kOMWAMI, nimulondakhwo emiBaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.18",
            "verseOrgIds": [
              "1KI.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano rumana okhung'aasie Isiraeli yosi hashikulu shiaKarameli, nabanabii baBaali ebikhumi bine namakhumi karaano bosi, nabanabii baAshera ebikhumi bine bosi, abaliitsanga khumeesa yaYezebeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.19",
            "verseOrgIds": [
              "1KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuyingani khushikulu shiaKarameli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.19",
            "verseOrgIds": [
              "1KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Ahabu yarumana ewabaana baIsiraeli bosi, nakhung'aasia abanabii halala hashikulu shiaKarameli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.20",
            "verseOrgIds": [
              "1KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya nasita ahambi khubandu abo, nasunga mbu Mulatiechelanga mumakhuwa kabili okhuula liina? OMWAMI naba naliye Nyasaye, mumulondekhwo; ne naba nali Baali, kho mumulondekhwo. Abandu nibaramukalusia likhuwa liosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.21",
            "verseOrgIds": [
              "1KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Eliya nasunjila abandu mbu Isie nisie sienyene outong'ile khubanabii bOMWAMI; nabo abanabii baBaali nabandu ebikhumi bine namakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.22",
            "verseOrgIds": [
              "1KI.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khuheebwe tsisurusi tsibili; bo balobole isurusi ndala yibe eyabwe, nibachifwona, nibara khukhwi, oburaramwo omulilo ta; nasi nengasie isurusi yindi eyo, ninjira khukhwi, oburaramwo omulilo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.23",
            "verseOrgIds": [
              "1KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana inywe mulanjilisie eliira lianyasaye weenywe, nasi ndalalanjilisia eliira liOMWAMI; ne Nyasaye oyo oukalusia naleera omulilo, niye ouli Nyasaye. Abandu bosi nibakalusia mbu Oteechile habwene. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Eliya nasunjila abanabii baBaali ari Mulobole isurusi ndala yibe eyeenywe, muranjilile okhuchikasia, okhuba muli abanji; mana mulanjilisie eliira lianyasaye weenywe, nebutswa muraramwo omulilo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.25",
            "verseOrgIds": [
              "1KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibabukula isurusi eya oaheebwa, nibachikasia, nibalanjilisia eliira liaBaali okhurula mutsuli okhuula mushiteere; bari E Baali, okhukalusiemwo! Nebutswa omwoyo kwosi shikwalikhwoho, kata oukalusia yesi ta. Nibashinashina nibatiechelela hashimalilo eshia bali nibakholile. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mushiteere Eliya yabatseshelela, ari Lanie butinyu, okhuba nomunyasaye; haundi ayiliiisinjia, kata weeberile elubeka, kata ali khuluchendo, kata haundi ali mundoolo, nakhoyile okhufulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.27",
            "verseOrgIds": [
              "1KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibalanjilisia butinyu, nibeekhalaka shinga eshiima shiabwe olwa shiali netsinganga namafumo, okhuula olwa amatsayi kabaraatsa amanji. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.28",
            "verseOrgIds": [
              "1KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa eshiteere shiali nishibirile, beelakalakania okhuula khusaa yokhuhaana eshihaanwa shiomungoloobe; nebutswa shikwalikhwoho omwoyo kwosi, kata oukalusia kata okhureka amarwi ta.",
          "type": "text",
          "attrs": {
