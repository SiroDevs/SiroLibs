        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.29",
            "verseOrgIds": [
              "1KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Eliya nasunjila abandu bosi ari Site ahambi; abandu bosi nibasita ahambi ninaye. Naye niyoombakha khandi eshimalilo shiOMWAMI eshiali nishialikululwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.30",
            "verseOrgIds": [
              "1KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya nabukula amachina ekhumi nakabili, obunji bwetsimbia tsiabaana baYakobo shinga olwa buli, omwenoyo owa likhuwa liOMWAMI lieetsela, lili Eliiralio lilaba Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.31",
            "verseOrgIds": [
              "1KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yoombakha amachina ako eshimalilo muliira liOMWAMI; nayaba olukhwaru okhubotokhana eshimalilo, olwakhahelamwo ebichelo bibili bieimwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.32",
            "verseOrgIds": [
              "1KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyaanza tsikhwi, nafwona isurusi, nachira khukhwi tsana. Nasunga mbu Mwitsusie tsisiongo tsine amatsi, mukatsushe khumusango kwokhusambwa nokhukhwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.33",
            "verseOrgIds": [
              "1KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nasunga mbu Khole khandi olwakhabili; nibakhola olwakhabili. Nasunga mbu Khole khandi olwakhataru; nibakhola olwakhataru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.34",
            "verseOrgIds": [
              "1KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatsi nikabira khushimalilo tsimbeka tsiosi, khandi nikeetsula mulukhwaru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khusaa yokhuhaana eshihaanwa shiomungoloobe, Eliya omunabii yasita ahambi, nasunga mbu E OMWAMI, Nyasaye waAburahamu, nowaIsaka, nowaIsiraeli, kamanyishe inyanga yino mbu iwe oli Nyasaye muIsiraeli, khandi mbu isie endi omusumbawo, khandi mbu ekholile kano kosi khulwa likhuwalio. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.36",
            "verseOrgIds": [
              "1KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungalusiemwo, OMWAMI, ungalusie, mbu aboluyia luno bamanye mbu iwe, OMWAMI, oli Nyasaye, khandi mbu oshiukhasiye emioyo chiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.37",
            "verseOrgIds": [
              "1KI.18.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omulilo kwOMWAMI nikwikha, nikusamba omusango omusambe, netsikhwi, namachina, nolufu, nikukhomba bukhomba amatsi akali mulukhwaru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.38",
            "verseOrgIds": [
              "1KI.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi olwa balola basikama nibabunamia obweni; nibasunga mbu OMWAMI, niye Nyasaye; OMWAMI, niye Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.39",
            "verseOrgIds": [
              "1KI.18.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya nabasunjila mbu Tiile abanabii baBaali; muralekha kata mulala yeehonokoshe ta. Nibababukula; naye Eliya nabakholomosia hamuchela kwaKishoni, nabeerelayo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eliya yasaba ifula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Eliya nasunjila Ahabu mbu Tikulukha, olie nonywa; okhuba buliho obuyoka bweifula inyinji. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.41",
            "verseOrgIds": [
              "1KI.18.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Ahabu natikulukha natsia okhulia nokhunywa. Naye Eliya naniina khubutenje bwaKarameli; niyeenama hasi khwiloba, nabunamia obwenibwe hakari wamasikamoke. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.42",
            "verseOrgIds": [
              "1KI.18.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nasunjila omusumbawe ari Tikulukha bulaano, ohenje hanyanza. Naye natikulukha, nahenga, naboola mbu Eshindu shibulaho. Namusunjila mbu Otsie khandi, okhuula musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 18:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khulwomusaafu yasunga mbu Lola, akhacheka kharula munyanza, akhatiiti shinga omukhono kwomundu. Naye ari Tikulukha, otsie oboolele Ahabu mbu Rechekha likaarilio, okholomoshe, ifula yileshe okhukhwikalila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 18:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyumakhwo hatuutu, olucheka lwamaliha mwikulu, nomuyeka, ifula niyiba inyinji. Naye Ahabu nachendela mwikaarilie natsia eYezereeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.45",
            "verseOrgIds": [
              "1KI.18.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 18:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhono kwOMwami kwali khuEliya; niyeebohela tsingubotsie mushishienje, niyeelukha namuranjilila Ahabu okhuula khubwinjililo bwaYezereeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.46",
            "verseOrgIds": [
              "1KI.18.46"
            ]
          }
        }
      ]
    }
