              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola tsinzu, habundu aheechingu, naramwo abakuhani okhurula mubandu bosi, abarali khubaana baLawi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu nalaka mbu lisabo libeho mumwesi kwomunaane, nikuli ekhumi nakharaano, shinga lisabo tsana elibeetsanga muYuda, namala emisango khushimalilo, khandi nakhola ario muBeteli, nabimalila emisango ebimosi tsana ebia yali niyakhola. Khandi muBeteli yaramwo abeesaaliisii bahabundu aheechingu hosi aha yali niyakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaniina hashimalilo eshia yali nakholile muBeteli, khunyanga yekhumi nakharaano mumwesi kwomunaane, nikwo omwesi okwa yapaarakhwo omwene mumwoyokwe; nalaka mbu lisabo libeho khulwa abaana baIsiraeli, naniinila hashimalilo okhusamba amalesi kelibuuliesi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
      ]
