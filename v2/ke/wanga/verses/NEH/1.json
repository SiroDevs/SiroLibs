          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa kaNehemia waHakilia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.3",
            "verseOrgIds": [
              "NEH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa ndahulila amakhuwa ako, ndeekhala nindila, nimba mumasika tsindaalokhwo; nimbonga inzala, nihaabila Nyasaye welikulu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.4",
            "verseOrgIds": [
              "NEH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nisunga mbu E OMWAMI, Nyasaye welikulu, Nyasaye omukhongo owamariisia, owusinjia indakanoyo nobuheeli oburalilu khubeenabo abakhuheelanga nibahulila amalakoko; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "oreche amarwi notimbula tsimoni, ohulile isaala yanje, isie omusumbawo, eya ekhusaaya khushise shino eshiteere neshilo, khulwa abasumbabo abaana baIsiraeli, olwa ndiyama ebionoono biabaana baIsiraeli ebia khwakhwonoonela; toto mwene, isie nabeshilibwa shieefwe khwonoona. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.6",
            "verseOrgIds": [
              "NEH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwakhukholela obubii muno, nikharuahulilanga amalako, nakalachilisibwa, nakobukhalachi ta, ako kosi aka walaka omusumbawo Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.7",
            "verseOrgIds": [
              "NEH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhusaaya mbu witsulile likhuwa elia walaka omusumbawo Musa, mbu Nimuba nimukhaya, ndalamusalaasia mumbia tsiabandu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.8",
            "verseOrgIds": [
              "NEH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nimuba nimunralushila, nimukahulila amalako kanje nimukakhola, kata abaarwabo nibakhaba nibali khushihesi shielikulu, kata okhurula yaho ndalabakhung'aasia, nimboosia habundu aha ndalobola okhumenyiamwo eliira lianje. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.9",
            "verseOrgIds": [
              "NEH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo abasumbabo khandi abandubo, aba wanunula nobunyalibwo obukhongo, khandi nomukhonokwo kwamaani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.10",
            "verseOrgIds": [
              "NEH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E OMWAMI, ekhusaaya mbu oreche amarwi khusaala yomusumbawo, neisaala yabasumbabo abasangaalila okhuria eliiralio; niukhwania omusumbawo leelo, ekhusaaya, mbu embeelwe tsimbabasi nomundu ulia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nehemia yarumwa eYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndali nindi omusumba womuruchi, owamukaamilanga eshikombe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        }
      ]
    }
  ],
