    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaLawi, mundaalo tsiaEliashibu, Yoyada, Yohanani, naYadua, abeemilisi bebilibwa bahandiikwa; nende abakuhani bosi, okhuula khuburuchi bwaDario omuPerisia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baLawi, abeemilisi bebilibwa, bahandiikwa muShitabu shiAmakhuwa keTsindaalo, okhuula khundaalo tsiaYohanani waEliashibu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abeemilisi babaLawi; mbu Hashabia, Sherebia, naYeswa waKadimieli, halala nabaana babwe aboongulilana ninabo, okhwitsoomia nokhukhupa orio, lilako liaDaudi omundu waNyasaye shinga olwa liali, ing'anda khung'anda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matania naBakibukia, Obadia, Meshulamu, Talimoni naAkubu, bali abalindi abalindanga hamabiishilo akomubilibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo baliho mundaalo tsiaYoyakimu waYeswa waYozadaki, nomundaalo tsiaNehemia omukafuna, netsiaEzira omukuhani, omuhandiichi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwahulwi bwolukoba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
