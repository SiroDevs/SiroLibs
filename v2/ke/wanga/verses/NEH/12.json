            "sid": "NEH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "khuSalai, Kalai; khuAmoki, Eberi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.20",
            "verseOrgIds": [
              "NEH.12.20"
            ]
          }
        },
        {
          "name": "verse",
