          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsiaYoyakimu, baliho abakuhani, abeemilisi bebilibwa; khuSaraya, Meraya; khuYeremia, Hanania; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12",
            "verseOrgIds": [
              "NEH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "khuEzira, Meshulamu; khuAmaria, Yehohanani; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.13",
            "verseOrgIds": [
              "NEH.12.13"
            ]
          }
        },
