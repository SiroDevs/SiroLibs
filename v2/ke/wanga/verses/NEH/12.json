          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "khuBiliga, Shamua; khuShemaya, Yehonatsani; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.18",
            "verseOrgIds": [
              "NEH.12.18"
            ]
          }
        },
