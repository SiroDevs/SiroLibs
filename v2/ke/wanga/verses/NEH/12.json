          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwo omukanda kundi kwabo abakhupa orio nibatsia khumukhono mukhasi, nasi nimbalondakhwo, nende inusu yabandu, khulukoba emukulu womunaara kwetsinjio tsiomulilo, okhuula khulukoba olubambalifu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi emukulu weshilibwa shiaEfuraimu, nokhubira enashilibwa eshikhulu, neshilibwa shietsinyeeni, nomunaara kwaHananeli, nomunaara kweshikhumi, okhuula khushilibwa shiamakondi; mana nibeema hashilibwa shiabalindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho emikanda echio chibili chia abo abakhupa orio nichiema munzu yaNyasaye, halala ninasi, neinusu ya abo aboburuchi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabakuhani, mbu Eliakimu, Maaseya, Miniamini, Mikaya, Elioenai, Zakaria, naHanania, nibali nende tsitarumbeta; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "naMaaseya, Shemaya, Eleazari, Uzi, Yehohanani, Malikhiya, Elamu, naEzeri. Abeembi nibeemba obutinyu, halala nende Yezerahia omusinjilili wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamala emisango emikhongo khunyanga eyo, nibeekhoya; okhuba Nyasaye yali nabeekhoyesiye omwikhoyo omukali; kata abakhasi nabaana bosi nibeekhoya; okhuula olwa omwikhoyo kwaYerusalemu kwahuliilikha ehale.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akakasilibwa obuha bwabakuhani nabaLawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
