          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "khuHilikia, Hashabia; khuYedaya, Netsaneli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
