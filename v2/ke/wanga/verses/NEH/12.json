            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "khuIdo, Zakaria; khuGinetsoni, Meshulamu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.16",
            "verseOrgIds": [
              "NEH.12.16"
            ]
          }
        },
