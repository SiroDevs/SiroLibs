              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NEH 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga eyo abandu bareebwaho okhusinjilila ebisika biemiandu ebietsisadaka nebiebirongole, nebiebitonye bielikhumi, okhukhung'aasiliamwo emikabo echialakwa mutorati khulwa abakuhani nabaLawi, emikunda chiamataala shinga olwa chiali; okhuba Yuda yeekhoyela abakuhani nabaLawi abakhalabananga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.44",
            "verseOrgIds": [
              "NEH.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakhola obukhalabani bwaNyasaye wabwe, nobukhalabani bwobusiiyi; nabeembi nabalindi babilibwa bosi bario, lilako liaDaudi nelia Sulemani omwanawe shinga olwa liali. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba mundaalo tsiaDaudi naAsafu, etsiakhale, yaliho omusinjilili wabeembi, khandi tsinyimbo tsialiho etsiokhwitsoomia Nyasaye nokhumuupila orio. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mundaalo tsiaZerubabeli, netsiaNehemia, Isiraeli yosi yakabanga emikabo chiabeembi nechiabalindi bebilibwa, khulwa obuha bwabuli nyanga; nibaahula ebio ebiali biabaLawi; nabo abaLawi nibaahula ebiali biabaana baHaruni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
