          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaana babwe, mbu Shemaya, Azareli, Milalai, Gilalai, Maai, Netsaneli Yuda, naHanani, nibali nebimanulwa biobukilana ebiaDaudi, omundu waNyasaye; naye Ezira omuhandiichi yabeemilila. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashilibwa shieisebele batsiililila hambeli, nibaniinila khumaniimilo kelitookho liaDaudi hashitikulukho shiolukoba, emukulu weinzu yaDaudi, okhuula khushilibwa shiamatsi eshili ebukwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
