          ]
        },
        {
          "text": "Mana niniinia abakhulundu baYuda khulukoba, niraho emikanda emikhongo chibili okhuupa orio nibachenda mulupele; mulala nikutsia enamukhono musaatsa khulukoba enashilibwa shiamasingo; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana Hoshaya narakhwo, neinusu yabakhulundu baYuda, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "naAzaria, Ezira, Meshulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda, Benyamini, Shemaya, naYeremia, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabandi abokhubaana babakuhani nibali nende tsitarumbeta; mbu Zakaria waYonatsani waShemaya waMatania waMikaya waZakuri waAsafu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
