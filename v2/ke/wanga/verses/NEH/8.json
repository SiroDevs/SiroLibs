    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi nibakhung'aana shiomundu mulala, mushikuuri eshiali imbeli weshilibwa shiamatsi; nibaboolela Ezira omuhandiichi okhuleera eshitabu shiamalako kaMusa eshia OMWAMI yali niyaheelesia Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezita omukuhani naleera amalako imbeli womukhung'aano, ari abasaatsa ari abakhasi, nabosi abakhanyala okhuhulila nende eshisina shiene, khunyanga yambeli eyomumwesi kwomusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.2",
            "verseOrgIds": [
              "NEH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yasoomamwo, nahenjile hashikuuri tsana eshiali imbeli weshilibwa shiamatsi, okhurula mumabwibwi okhuula mushiteere hakari, abandu abo abasaatsa nabakhasi nibaliho, nabosi abakhanyala okhuhulila neshisina; abandu bosi nibarechelesia akeshitabu shiamalako. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.3",
            "verseOrgIds": [
              "NEH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezira omuhandiichi yasinjila khushirandaalo shietsimbaho eshia bakasilia omulimo kwenokwo; nabo Matitsia, Shema, Anaya, Uria, Hilikia, naMaaseya, nibasinjila halala ninaye khumukhono musaatsa; nabo Pedaya, Mishaeli, Malikhiya, Hashumi, Hashibadana, Zakaria, naMeshulamu, khumukhono mukhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.4",
            "verseOrgIds": [
              "NEH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ezira nabambula eshitabu, abandu bosi nibalola, okhuba yali hekulu wabandu bosi; ne olwa yashibambula, abandu bosi nibasinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
              "NEH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ezira niyeetsoomia OMWAMI, Nyasaye omukhongo. Abandu bosi nibakalusia mbu Amina, amina nibachinguulile amakhono; nibeenamia emirwe, nibamwinamila OMWAMI, nibabunamiye obweni hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Yeswa, naBani, naSherebia, Yamini, Akubu, Shabetsai, Hodia, Maaseya, Kelita, Azaria, Yozabadi, Hanani, Pelaya, abaLawi, nibeenoosilia abandu akamalako; nabo abandu nibasinjila ewa bali. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasooma akomushitabu, mumalako kaNyasaye, nomwoyo okuhuliilikha; nibamanyilisia eshisina shiakasoomwa, mbu abandu bahulile amasoomo bulayi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.8",
            "verseOrgIds": [
              "NEH.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.8",
            "verseOrgIds": [
              "NEH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nehemia, owali omukafuna, naEzira omukuhani omuhandiichi, nabaLawi abali nibeechesinjia abandu, nibasunjila abandu bosi bari Inyanga yino neindakatifu khuMWAwl Nyasaye weenywe; mureekhuula kata okhulila ta. Okhuba abandu bosi balila olwa bahulila amakhuwa kamalako. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.9",
            "verseOrgIds": [
              "NEH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nabasunjila mbu Mutsie butsia, mulie ebinulu, nimunywa ebimilamili, nimumu yilila emikabo oyo ourakasiliibwe eshindu ta; okhuba inyanga yino neindakatifu khuMWAMI weefwe; kata muraba neshibeela ta; okhuba obu-sangaali bwOMWAMI nibwo amaani keenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaLawi nibahonjeesia abandu bosi, bari Muholeele, okhuba inyanga yino neindakatifu; kata muraba neshibeela ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.11",
            "verseOrgIds": [
              "NEH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi nibatsia ewa batsia, okhulia amasabo nokhuyila emikabo, nokhutsatsahala muno, shichila bali nibahuliile amakhuwa aka barumbuliilwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yakhabili abeemilisi bebilibwa biabandu bosi nibakhung'aana, halala nabakuhani nabaLawi, ewaEzira omuhandiichi, okhurechelesia amakhuwa kamalako. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibanyoola nikahandiikwa mumalako shinga olwa OMWAMI yalaka Musa mbu abandu bamenye mumatili khwisabo liomwesi kwomusaafu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu batswanie amakhuwa nibakhupa omulome mumataala kabwe kosi nomuYerusalemu, mbu Rule mutsie enashikulu okhwenda amasaka kemitseituni, namasaka kemitsieituni chianabulimo, namasaka kemihatasi, namasaka kemishindu, namasaka kemisaala chindi emitendeemu, okhukhola amatili, shinga olwa kahandiikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu nibaruln nibakeenda, nibeekholela amatili, buli mundu khushilama shieinzuye, nomunyanyi tsiabwe, nomunyanyi tsieinzu yaNyasaye, nomushikuuri shiena shilibwa shiamatsi, nomushikuuri shienashilibwa shiaEfuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abomukhung'aano bosi abakalukha okhurula mubwarwi nibakhola amatili, nibamenya mumatili tsana; okhuba okhurula mundaalo tsiaYeswa waNuni okhuula khunyanga eyo, abaana baIsiraeli shibali nibakholakhwo bario ta. Mana nibubaho obusangaali obukhongo muno. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi buli nyanga yosi, okhurula khunyanga yambeli okhuula khunyanga eyahelelesia, yasoomanga akomushitabu shiaamalako kaNyasaye. Nibalia lisabo tsindaalo musaafu; mana khunyanga yomunaane nikubaho omukhung'aano kwoluyali, eshiima shinga olwa shiali.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
        }
      ]
    }
  ],
