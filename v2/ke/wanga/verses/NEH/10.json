            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abandi bosi, abakuhani, abaLawi, abalindi bebilibwa, abeembi, abasumba bomuhekalu, halala nende bosi abali nibeekabukhasia nabandu abomubialo, nibeeyahulila amalako kaNyasaye, nabakhasi babwe, nabasiani babwe, nabakhaana babwe, buli mundu yesi owali nobumanyi nobuhulili, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "boongana nende abaana babwe abamakuru, nibeenjila mushilaka munwa, nomushiitsubo, okhuchenda mumalako kaNyasaye eyahaanwa mumunwa kwaMusa omusumba waNyasaye, nokhwitsulila nokhukhola akamalako kosi kOMWAMI, Omwami weefwe, nobukhalachibwe naka alachilisia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
