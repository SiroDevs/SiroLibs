              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shikhulabashila abeshialo tsana abaana beefwe abakhaana, kata okhukhweesia abasiani beefwe abakhaana babwe ta, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu abandu beshialo nibaba nibaleera emiandu kata imele okhukusia khunyanga yasabato, shikhulakulana ninabo khusabato kata khunyanga yosi indakatifu ta; khandi mbu khulalekha ebiomumikunda mumuyika kwomusaafu, kata nende obubanzi bwabuli likobi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khweekasilia amalako, okhwiroosia abeene eshitonye shiakhataru shieishekeli omuyika buli muyika, khulwa obukhalabani bweinzu yaNyasaye weefwe; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulwa emikaate chiokhubaho, khulwa emisango chieimele chiakhatsotso, nemisango emisambe chiakhatsotso, netsisabato, nokhuchaaka khwemiesi, netsinduukho tsiamasabo, nebindu ebitakatifu, nemisango chiobwonooni okhutisa Isiraeli, nokhulwa emilimo chiosi chieinzu yaNyasaye weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwakhupa ikha, abakuhani nabaLawi nabandu abarali abaLawi ta, khumakhuwa ketsikhwi, okhutsileera munzu yaNyasaye weefwe, ebilibwa bieefwe shinga olwa bili, khubise ebilakwa omuyika buli muyika, okhusambila khushimalilo shiOMWAMI Nyasaye weefwe, shinga olwa kahandiikwa mumalako. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhuleera nende ebirongole bieliloba lieefwe nebirongole biebiamo biosi biemisaala chietsimbia tsiosi, munzu yOMWAMI, omuyika buli muyika, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata nende abeekulanda abomubaana beefwe abasiani, nebiikulanda ebiomumiruko chieefwe, shinga olwa kahandiikwa mumalako, nende ebiibulwa biambeli bietsing'ombe tsieefwe nebiebiayo bieefwe, mbu khubileere munzu yaNyasaye weefwe, khubakuhani abakhalabanilanga munzu yaNyasaye weefwe; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu khuleere ebirongole biobusie bweefwe obuhandale, netsisadaka tsieefwe, nebiamo biemisaala chietsimbia tsiosi, neidivai namafura, khubakuhani, mubisika bieinzu yaNyasaye weefwe; nabio ebitonye bielikhumi ebirula mwiloba lieefwe khubaLawi; okhuba abaLawi nibo abasololanga ebitonye bielikhumi mumataala kosi akomumikunda chieefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani, omwana waHaruni, abeho halala nabaLawi olwa abaLawi baba nibasolola ebitonye bielikhumi; mana abaLawi baleere eshitonye shielikhumi eshiebitonye bielikhumi tsana enanzu yaNyasaye weefwe, mubisika, mwibiishilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abaana baIsiraeli nende abaana baLawi balaleera tsisadaka tsieimele, netsieidivai, netsiamafura, mubisika omwa ebimanulwa biahabundu ahatakatifu bili, nabakuhani abakhalabananga, nabalindi bebilibwa, nabeembi; ne shikhuleebala inzu vaNyasave weefwe tawe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
