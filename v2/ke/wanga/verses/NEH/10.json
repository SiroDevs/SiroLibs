          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harifu, Anatsotsi, Nobai; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.19",
            "verseOrgIds": [
              "NEH.10.19"
            ]
          }
        },
        {
          "name": "verse",
