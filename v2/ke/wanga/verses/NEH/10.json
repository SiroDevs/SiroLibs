          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshea, Hanania, Hashubu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.23",
            "verseOrgIds": [
              "NEH.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haloheshi, Piliha, Shobe ki; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.24",
            "verseOrgIds": [
              "NEH.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
