          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumu, Hashabina, Maaseya; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.25",
            "verseOrgIds": [
              "NEH.10.25"
            ]
          }
        },
