          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malikhiya, mulala khubeeraanyi beitsahaabu, yarondokhana ninaye, nakasinjia okhuula khunzu yabasumba abomuhekalu neyabeinganga, ahahengana nEshilibwa shiObukhung'aasii, neshisika shiahekulu hakoona. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
