          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadoki waImeri yarondokhana ninabo, nakasinjia ahahengana neinzuye. Shemaya waShekania, omulindi wEshilibwa shieBukwe, yarondokhana ninaye nakasinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
