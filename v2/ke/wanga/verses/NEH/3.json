        "style": "s1"
      },
      "items": [
        {
          "text": "Ebitonye shinga olwa biakabulilwa abandu okhukasia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Eliashibu omukuhani omukhulundu nabuukha, halala nabakuhani abashie, niboombakha Eshilibwa shiAmakondi; bashiahula, nibasinjisia tsinzichi tsiashio; nibaahula okhuula khuMunaara kwEshikhumi, nokhuula khuMunaara kwaHananeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaYeriko nibarondokhana ninaye, niboombakha. Mana Zakuri waImiri narondokhana ninabo, niyoombakha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baHasenaa niboombakha Eshilibwa shieTsinyeeni; beemekha emitiisi chiashio, nibasinjisia tsinzichi tsiashio, netsipata tsiashio, nemiyinjiilo chiashio. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Meremotsi waUria waHakozi yali nakasinjia, narondokhaane ninabo. Meshulamu waBerekhia waMeshezabeli yarondokhana ninabo nakasinjia. Zadoki waBaana narondokhana ninabo nakasinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaTekoa barondokhana ninabo nibakasinjia; habula abamakuru babwe shibayeenjisiamwo emirwe khumilimo chiomwami wabwe ta.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoyada waPasea, naMeshulamu waBesodeya, bakasia Eshilibwa Eshikhulu. Beemekha emitiisi chiashio, nibasinjisia tsinzichi tsiashio, netsipata tsiashio, nemiyinjiilo chiashio. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melatia omuGibeoni yarondokhana ninabo nakasinjia, nende Yadoni omuMeronotsi, nabandu baGibeoni nabaMizipa, abali abomuburuchi bwomukafuna oweinjelekha womwalo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzieli waHarihaya, owokhubeeraanyi beitsahaabu, yarondokhana ninaye nakasinjia; mana Hanania, mulala owokhubakasii bamalesi keshing'aari, yarondokhana ninaye nakasinjia; nibakalusinjia Yerusalemu habwene okhuula khuLukoba Olubambalifu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Refaya waHuri, omusinjilili weshitonye shiolukongo IweYerusalemu, yarondokhana ninabo nakasinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yedaya waHarumafu yarondokhana ninabo nakasinjia ahahengana neinzuye. Naye Hatushi waHashabineya yarondokhana ninaye nakasinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malikhiya waHarimu naHashubu waPahatsi-moabu bakasinjia eshitonye shindi, nOmunaara kwAmayika. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu waHaloheshi, omusinjilili weshitonye shiolukongo IweYerusalemu, yarondokhana ninaye nakasinjia, ye nabakhaanabe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuni yakasia Eshilibwa shiomwIbanda halala nabaZanoa; bashiumbakha, nibasinjisia tsinzichi tsiashio, netsipata tsiashio, nemiyinjiilo chiashio, khandi nende eshitonye shiolukoba eshihela amakhono eshikhumila, okhuula khuShilibwa shiAmasingo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashio Eshilibwa shiAmasingo, Malikhiya waRekhabu, omusinjilili wolukongo lwaBetsi-hakharemu yashikasia; yashiumbakha, nasinjisia tsinzichi tsiashio, netsipata tsiashio, nemiyinjiilo chiashio.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashio Eshilibwa shieIsebele, Shalumu waKolihoze, omusinjilili wolukongo IweMizipa yashikasia; yashiumbakha, nashifwimba, nasinjisia tsinzichi tsiashio, netsipata tsiashio, nemiyinjiilo chiashio; niyoombakha nende olukoba IweLitiba liaShela, ahambi nolwanyi Iwomuruchi, okhuula khumaniinilo keshikholomokho eshirula mwItookho liaDaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nehemia waAzibuki omusinjilili weshitonye shiolukongo lwaBetsi-suri, yarondokhana ninaye nakasinjia, okhuula habundu ahahengana neshihembekho shiaDaudi okhuula khwitiba eliakholwayo, okhuula khunzu yabalulu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaLawi, mbu Rehumu waBani, barondokhana ninaye nibakasinjia. Hashabia, omusinjilili weshitonye shiolukongo lwaKeila, yarondokhana ninaye nakasinjia, nakholela olukongolwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana babwe, banga Bawai waHenadadi, omusinjilili weshitonye shiolukongo lwaKeila, barondokhana ninaye nibakasinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezeri waYeswa, omusinjilili waMizipa, yarondokhana ninaye nakasinjia khushitonye shindi ahahengana neshitikulukho shielibiishilo liebimanulwa, aha olukoba lukotolela. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barukhi waZebai yarondokhana ninaye nakasia eshitonye shindi, okhurula aha olukoba lukotolela, okhuula khumuliango kweinzu yaEliashibu omukuhani omukhulundu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
              "NEH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meremotsi waUria waHakozi yarondokhana ninaye nakasinjia eshitonye shindi, okhurula khumuliango kweinzu yaEliashibu okhuula khushihesi shieinzu yaEliashibu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakuhani, abomuhololookhwe, barondokhana ninaye nibakasinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benyamini naHashubu barondokhana ninabo, nibakasinjia ahahengana neinzu yabwe. Mana Azaria waMaaseya waAnania yarondokhana ninabo, nakasinjia ahambi nende inzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binui waHenadadi yarondokhana ninaye, nakasinjia eshitonye shindi, okhurula khunzu yaAzaria okhuula aha olukoba lukotolela, nokhuula khukoona. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palali waUzai yakasinjia ahahengana nende aha olukoba lukotolela, nomunaara okusongookha khunzu yemukulu yomuruchi, halwanyi lwabalindi. Naye Pedaya waParoshi yarondokhana ninayenakasinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abasumba bomuhekalu, abamenya eOfeli, bakasinjia okhuula ahahengana nEshilibwa shiAmatsi ebukwe, nomunaara omusongookhu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaTekoa barondokhana ninaye, nibakasinjia eshitonye shindi ahahengana nomunaara omukhongo omusongookhu, okhuula khulukoba lwaOfeli.",
          "type": "text",
