          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanania waShelamia naHanuni omwana wakhasasaba waZalafu barondokhana ninaye, nibakasinjia eshitony e shindi. Meshulamu waBerekhia yarondokhana ninaye, nakasinjia ahahengana neshisikashie. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
