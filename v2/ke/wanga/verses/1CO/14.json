          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi naba naluutsi mbu nomunabii, kata mbu ali nende ebihaanwa bieshiroho amanye khumakhuwa aka emuhandiichila shinga olwa kali lilako liOmwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi naba nakaleka, yesi alalekwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        }
      ]
    },
