{
  "id": "1CO.14",
  "number": "14",
  "bookId": "1CO",
  "reference": "1 Abakorinzo 14",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1CO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsinimi, nende okhulakula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulondachilile obuheeli; ne murekhwo omwoyo khubihaanwa bieshiroho; ne okhushila muno, mbu mulakulenje. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.1",
            "verseOrgIds": [
              "1CO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ouboolela mululimi shiaboolana nabandu ta, habula nende Nyasaye; okhuba abulaho ouhulila; ne aboola akamabiswi muroho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.2",
            "verseOrgIds": [
              "1CO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noyo oulakula aboolelana nende abandu amakhuwa akobuumbashi, akobuchesiyii, nakobulemia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.3",
            "verseOrgIds": [
              "1CO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouboolela mululimi yeeyumbakha omwene; ne oulakula yoombakha ikanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndakheenya mbu mwesi muboolele mutsinimi, nokhushila muno mbu mulakule; noyo oulakula ashila ulia ouboolela mutsinimi, habula naba nakalula, mbu ikanisa yumbakhwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho, baana beefwe, nimba nimwitsila nimboolelanga mutsinimi, ndakhamukaasila shiina, habula nimuboolela akobufwimbuli, kata akobumanyi, kata akobulakusi, kata akobwechesii? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ebindu nabindu, ebiamayoosi, kata nilili lilele kata litungu, nibiba nibiraahukhasinjia emioyo ta, olwimbo lwene olukhupwa khwilele kata khwitungu lulamanyikha lurie? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.7",
            "verseOrgIds": [
              "1CO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omwoyo kwolwika nikuba nikurahuliilikha bulayi ta, ali heena owakheerecheshela lihe? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.8",
            "verseOrgIds": [
              "1CO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu mwesi murio, nimuba nimurarumbulanga nende tsinimi tsieenywe amasungo akahuliilikha lwangu ta, akaboolwa kalamanyikha karie? Ne butswa mwakhaba nimuboolelanga butswa mushikhaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.9",
            "verseOrgIds": [
              "1CO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.9",
            "verseOrgIds": [
              "1CO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enduutsi mbu chiliho emioyo chietsimbia tsinyinji muno mushibala; ne kubulaho kata mulala okubula eshisina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.10",
            "verseOrgIds": [
              "1CO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nimba nindamanya eshisina shiomwoyo kwa oyo ouboola ta, ndakhabe khuye omuyobo, naye yesi yakhaba ario omuyobo khwisie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.11",
            "verseOrgIds": [
              "1CO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu mwesi murio, olwa muli abalumilifu khukhunyoola ebihaanwa bieshiroho, muchoome okhushilaana mubuumbashi bweikanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, oyo ouboolelanga mululimi asaaye mbu anyalilwe okhukalula; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.13",
            "verseOrgIds": [
              "1CO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba nimba nisaayila mululimi, roho yanje yisaaya, ne amachesi kanje kakumbahala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.14",
            "verseOrgIds": [
              "1CO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho karie? Ndalasaayanga nende roho, khandi ndalasaayanga nende amachesi; ndaleembanga nende roho, khandi ndaleembanga nende amachesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.15",
            "verseOrgIds": [
              "1CO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa omwitsoominjia Nyasaye nende roho, oyo ouli mubwikhalo bwomundu butswa alanyala arie okhukalusia mbu Amina olwa okhuupa orio, ne naramanyile aka oboola ta? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.16",
            "verseOrgIds": [
              "1CO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba toto, wakhaba nokhupanga orio bulayi, ne oundi ulia shiyoombakhwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuupila Nyasaye mbu orio, shichila emboolelanga mutsinimi okhumushila inywe mwesi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.18",
            "verseOrgIds": [
              "1CO.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa mukanisa ndakhachama okhuboola amakhuwa karaano namachesi mbu embeebaalile abandi, okhushila okhuboolela mululimi amakhuwa ebikhumila likhumi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana beefwe, murabeetsanga shia abaana mubuyililisii bweenywe ta; nebutswa mukobumayaanu mube shinga abaana, habula mubuyililisii mube abakhulile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumalako kahandiikwa mbu Omwami yasunga ari Ndalaboolelana nende abandu bano mubandu betsinimi tsinjeni, khandi muminwa chiabandu abacheni; ne kata kario shibalambulila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, tsinimi shitsili eshilolelo khubasuubili ta, habula khubarasuubila tawe; nabwo obulakusi shibuli khulwabo abarasuubila ta, habula khulwa abasuubili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ikanisa yosi niyiba niyikhung'aanila halala, bosi nibaboolelanga mutsinimi, mana abali abandu butswa, kata abarasuubila ta, nibaba nibeenjilamwo, shibalasunga mbu mulaluushe? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nibaba nibalakula bosi, oundi niyeenjilamwo ourasuubila ta, kata ouli omundu butswa ahulwa nabosi, ayaasibwa nabosi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.24",
            "verseOrgIds": [
              "1CO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "amabiso akomumwoyokwe nako nikabisukha; mana aleekhupa hasi mafumama namwinamila Nyasaye, narumbula mbu toto mwene, Nyasaye ali hakari mwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kosi kakholwe mubwanzi obulayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho karie, baana beefwe? Olwa mukhung'aananga halala buli mulala abeetsanga nende olwimbo, kata obwibaali, kata obufwimbulwi, kata olulimi, kata obukaluli. Amakhuwa kosi kachoome khubuumbashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.26",
            "verseOrgIds": [
              "1CO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi naba naboolela mululimi, babe babili bataru, barashila yaho ta, mulala mulala; mulala naye akalule; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.27",
            "verseOrgIds": [
              "1CO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne omukaluli naba nabulaho, aholeele mumukanda; yeeboolele omwene yenyene, nende Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.28",
            "verseOrgIds": [
              "1CO.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanabii nabo baboole babili bataru, abandi nibachela amakhuwa keene; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.29",
            "verseOrgIds": [
              "1CO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "oundi ouba niyeekhaaleho naba nafwimbulilwa likhuwa, owambeli aholeele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.30",
            "verseOrgIds": [
              "1CO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila mwesi munyala okhulakula, mulala mulala, mbu bosi beeche amakhuwa, khandi mbu bosi bachesiyibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.31",
            "verseOrgIds": [
              "1CO.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiroho tsiabanabii tsirukwe nabanabii beene; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.32",
            "verseOrgIds": [
              "1CO.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba Nyasaye shiali Nyasaye wobukoyaani ta, habula owomulembe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga olwa kali mukanisa tsiosi tsiabatakatifu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakhasi baholeelenje mumikhung'aano; shichila shibafuchiililwa okhuboola ta; bahulilenje nobwongoli, shinga amalako olwa kaboola. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nibaba nibeenya okhweka likhuwa, bareebelenje abasaatsa babwe mungo; shichila nelietsisoni omukhasi okhuboolela mukanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbula, mwinywe nimwo omwa likhuwa liaNyasaye liarula? Nohomba lioola khwinywe mwenyene?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        }
      ]
    },
