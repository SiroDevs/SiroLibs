          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula mbu amakhuwa kosi kakholwe shinga olwa kakhoyeele mubwanzi obulayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
