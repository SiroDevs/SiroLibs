            "number": "28",
            "style": "v",
            "sid": "1CO 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.28",
            "verseOrgIds": [
              "1CO.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana beefwe, elia emuboolela ndielino; mbu eshise shiimbichiite; kho okhurula olwa leelo abali nabakhasi babe shinga ababula ninabo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.29",
            "verseOrgIds": [
              "1CO.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo abalila, shinga abaralila ta; abeekhoya, shinga abareekhoya ta; abakulanga, shinga ababula emiandu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.30",
            "verseOrgIds": [
              "1CO.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata abo abeekhoonyela ebieshialo shinga abarabiikhoonyela muno ta; okhuba ikhola yeshibala shino yihweetsangaho.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.31",
            "verseOrgIds": [
              "1CO.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.31",
            "verseOrgIds": [
              "1CO.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndakheenya mbu mubule obuhendi bwosi. Oyo ourali nomukhasi ta ahendelanga akOmwami shinga olwa yakhanyala okhumuchamisia Omwami; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.32",
            "verseOrgIds": [
              "1CO.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne oyo ouli nomukhasi ahendelanga akeshialo, shinga olwa yakhachamisia omukhasiwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.33",
            "verseOrgIds": [
              "1CO.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomukhasiwe yesi abeetsanga niyeekabuule shikhabili mumwoyo. Ne omukhaana ourateeshibwa ta ahendelanga akOmwami, mbu abe omutakatifu omubili nende roho yosi; nebutswa oyo ouli nomusaatsa ahendelanga akeshialo, shinga olwa yakhachamisia omusaatsawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.34",
            "verseOrgIds": [
              "1CO.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano engaboola khulweenywe; shikali mbu emuboha buboha ta, habula khulwako akakhoyeele, khandi mbu mukhalabanilenje Omwami oburakoyakoyibungwa ta.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi naba naluutsi mbu shiamukholelanga omushisila omwitsawe akali habwene ta, obwikombibwe nibuba nibushilaana, akhole aka yeenya, nikaba nikakhoyeele kario. Bateeshanie; shibuli obwonooni ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oyo owa omwoyokwe kuralila, oubula okhuhachilisibwa, ne nali nobunyali okhwiruka okhwenyakhwe, ne namalile okhurakhwo omwoyo khwikhuwa lino mbu okhulinda omushisilawe, kho akhola bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho outeeshia omushisilawe akhola bulayi; khandi ouramuteeshia ta akhola bulayi okhushila.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        }
      ]
    },
