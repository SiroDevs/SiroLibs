          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuyabila Abineri muHeberoni; omuruchi naye nachinga omwoyo niyeekhuula hang'ani yaAbineri; abandu bosi nibeekhuula. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
