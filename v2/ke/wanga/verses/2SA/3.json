            }
          ]
        },
        {
          "text": "Nolwa Yoabu yali narulile ewaDaudi, yaruma abarume inyuma waAbineri, nibamukalusia okhurula khwiyabo liaSira; habula Daudi shiyamanya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.26",
            "verseOrgIds": [
              "2SA.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Abineri yali nakaluushe eHeberoni, Yoabu yamuyila elubeka, hakari haluyia, mbu asungane ninaye masilisi, namuupilayo munda, naye nafwa, khulwa amabanga kaAsaheli omwana wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.27",
            "verseOrgIds": [
              "2SA.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolunyumakhwo, olwa Daudi yahulilakhwo, yasunga mbu Isie nende aboburuchi bwanje khubula neshiuku shiamabanga kaAbineri waNeri, imbeli wOMWAMI, obushia nobushia; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "shikwe khumurwe kwaYoabu, khandi khubosi beinzu yasamwana; arakhachweya okhubamwo munzu yaYoabu omundu oweshisununu, kata owamachele, kata oukwanile butswa okhusiilila obuusi khumutunga, kata owirwa nolukanga, kata outamba eshiokhulia, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.29",
            "verseOrgIds": [
              "2SA.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yoabu nende Abishai omwana wabwe nibeera Abineri, shichila yali niyeerile Asaheli omwana wabwe mwihe eGibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        }
