{
  "id": "2SA.21",
  "number": "21",
  "bookId": "2SA",
  "reference": "2 Samweli 21",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2SA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaGibeoni bamalilwa eshikwoli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaliho inzala mundaalo tsiaDaudi emiyika chitaru, omuyika buli muyika; naye Daudi yakhaaba mumoni mwOMWAMI. OMWAMI nasunga mbu NakaSaulo, khandi akeinzuye yeshitsayi, shichila yeera abaGibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi yalanga abaGibeoni, nabasunjilakhwo. Ne abaGibeoni shibali abomubaIsiraeli ta, habula abomusikalo kwabaAmori; abaIsiraeli nabo bali nibalia ninabo omuuma; habula Saulo yateema okhubeera mubulumilifubwe khulwa abandu baIsiraeli nende Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nasunjila abaGibeoni ari Emukholele shiina? Khandi nishiina eshia ndaleetisila, mbu mana mubwitsoomie obulaame bwOMWAMI? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaGibeoni nibamukalusia bari Shikali amakhuwa keifeetsa kata itsahaabu hakari weefwe nende Saulo, kata abeinzuye, ta; kata shikali khwifwe okhwlra omundu yesi muIsiraeli tawe. Naye nasunga mbu Elia muboola, ndalamukholela. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusunjila omuruchi bari Omundu oyo owakhukhuya, narechekha amakhuwa khwifwe mbu khumululwe khuleshe okhutong'a munzakho tsiosi tsiaIsiraeli ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.5",
            "verseOrgIds": [
              "2SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "khuheebwe abasaatsa musaafu abomubaanabe khubahanishe hekulu imbeli w muGibea waSaulo, omulobole wOMWAMI. Omuruchi nasunga ari Ndalabahaana. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula omuruchi yalekha Mefiboshetsi waYonatsani waSaulo, khulwa omuuma kwOMWAMI okwali hakari wabwe, hakari waDaudi nende Yonatsani omwana waSaulo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi yabukula abaana babili baRizipa waAya, aba yeebula nende Saulo, mbu Arimoni nende Mefiboshetsi; nende abaana baraano baMerabu omukhaana waSaulo, aba yeebula nende Adirieli waBarizilai omuMeholatsi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabahaana mumakhono kabaGibeoni, nabo nibabahanikha mushikulu imbeli w, nibafwila bosi musaafu khulala; ne beerwa mundaalo tsielichesa, mundaalo tsiambeli, khukhuchaaka khwelichesa lieishayiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Rizipa omukhaana waAya yabukula ingubo yelikunia, nabambula khulwanda, okhurula khukhuchaaka khwelichesa okhuula olwa basundulilwa ifula okhurula mwikulu; narafuchiilila kata amanyonyi akokhwikulu okhubayeelakhwo mushiteere, kata tsisolo etsiomubulimo mushilo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi yaboolelwa aka Rizipa omukhaana waAya, omusuria waSaulo, yali niyakholilenje. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi yatsia nabukula amakumba kaSaulo nende amakumba kaYonatsani omwanawe mubeenetaala liaYabeshi-gileadi, abali nibakeeba mulwanyi lwaBetseshani, ewa abaFilisiti bali nibakahaniishe, khunyanga eyo olwa abaFilisiti beera Saulo muGiliboa; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "natikulusia amakumba kaSaulo nende amakumba kaYonatsani omwanawe okhurulayo; nibakhung'aasia nende amakumba kabeenabo abali nibahanikhwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibayabila amakumba kaSaulo nende Yonatsani omwanawe mushialo shiaBenyamini eZela, mushilindwa shiaKishi, samwana; bamala nibakhola kosi aka omuruchi yali nabalachilisiye. Nolunyuma lwa ako Nyasaye yafuchiilila okhusabwa khulwa eshialo eshio.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abishai yamureesia Daudi mumukhono kwokuRefai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olundi khandi abaFilisiti nibaseerana nende Isiraeli; Daudi naye nakholomokha, halala nende abasumbabe, nalasana nende abaFilisiti; ne Daudi yali nahweelelelanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ishibibenobu, owali owokhubaRefai, owa lifumolie liachelwa obusilo bwalio tsishekeli ebikhumi bitaru biemikasa, owali niyeeboyile olukanga oluyia, yateema okhumwira Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Abishai waZeruya yamuhabina, namuupa omuFilisiti oyo, namwira. Mana abandu baDaudi bamwitsubila bari Shiolarula okhutsia mwihe khandi nineefwe tawe, oleshe okhusimia itaha yaIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaRefai abeerwa nabandu baDaudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwamakhuwa ako lialiho lihe khandi liabaFilisiti eGobu; nilwo olwa Sibekai omuHushatsi yeera Safu, owali owokhubaRefai. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolundi khandi lialiho lihe liabaFilisiti eGobu; naye Elihanani waYairi omuBetselehemu yeera Goliatsi omuGiti, owa olubango Iweindoboye Iweengana shinga omusaala kwomulushi wetsingubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olundi lialiho lihe eGatsi, ewa omundu yali, omurambi muno, owali nali nende tsinzala tsisasaba khubuli mukhono, khandi tsinzala tsisasaba khubuli shilenje, amakhumi kabili natsine obukhumi bwatsio; naye yesi yeebulwa nende abaRefai abo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.20",
            "verseOrgIds": [
              "2SA.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yaseya Isiraeli, Yonatsani waShimeai, omwana wabwe Daudi, yamwira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
            "verseOrgIds": [
              "2SA.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bane abo beebulwa nende abaRefai abo muGatsi; ne bakwa khulwa omukhono kwaDaudi, nende khulwa amakhono kabasumbabe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.22",
            "verseOrgIds": [
              "2SA.21.22"
            ]
          }
        }
      ]
    }
  ],
