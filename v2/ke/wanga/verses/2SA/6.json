{
  "id": "2SA.6",
  "number": "6",
  "bookId": "2SA",
  "reference": "2 Samweli 6",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2SA 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi yatsia okhwenda Lisanduku li OMWAMI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olundi khandi Daudi yakhung'aasia abandu bosi abalobole baIsiraeli, abandu ebikhumila amakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
            "verseOrgIds": [
              "2SA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi narula, natsia halala nende abandu bosi aba yali ninabo, okhurula eBaaleyuda, okhutikulusia lisanduku liaNyasaye, okhuliyiniayo; nilio elilangwa Eliira lienelo, mbu eliira liOMWAMI omwene mahe, owikhalanga hekulu wabakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibarenjekha lisanduku liaNyasaye khwikaari liyia, nibalirusia munzu yaAbinadabu, eyali mushikulu; nabo Uza nende Ahio, abaana baAbinadabu, nibachesia likaari elo liyia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalirusia munzu yaAbinadabu eyali mushikulu, halala nende lisanduku liaNyasaye; naye Ahio yeemila imbeli welisanduku elo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi nende abeinzu yaIsiraeli yosi bali nibeekhoyelanga imbeli wOMWAMI nende amaani kabwe kosi, netsinyimbo, nende obukhana, namatungu, netsisukuti, netsinyengo, nende ebisili.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa boola halutse lwaNakoni, Uza yayila omukhono khwisanduku liaNyasaye, nalitiila; shichila tsing'ombe tsiali nitsiisichiraale. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.6",
            "verseOrgIds": [
              "2SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oburima bwOMWAMI bwamwashila Uza; Nyasaye namukhupilayo khulwa obuyungubafubwe; ne yafwila habwene yaho ahambi nende lisanduku liaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi yahuka shinga olwa OMWAMI yali naruliile khuUza; nakulikha habundu yaho mbu Perezuza, okhuula olwa leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi yaria OMWAMI inyanga eyo; nasunga mbu Ne lisanduku liOMWAMI lilanzitsila lirie? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi yakhaya okhulihuyia lisanduku liOMWAMI okhumwitsila ewuwe mwitookho liaDaudi; ne Daudi yaliyila elubeka naliinjisia munzu yaObededomu, omuGiti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisanduku liOMWAMI nilimenya munzu yaObededomu omuGiti oyo emiesi chitaru OMWAMI nabaheelesia Obededomu nende abeinzuye bosi ikhabi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisanduku lialeelwa eYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi Daudi yaboolelwa ari OMWAMI yaheelesiye abeinzu yaObededomu ikhabi, nende biosi ebia yali ninabio, khulwa lisanduku liaNyasaye. Kho Daudi yatsia natikulusia lisanduku liaNyasaye, naliyinia munzu yaObededomu, naliinjisia mwitookho liaDaudi nende okhwikhoya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandu abachinga lisanduku liaNyasaye olwa bali nibakhachenda amarambusio kasasaba, yamala omusango kweisurusi nende eshinulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nashina imbeli wOMWAMI nende amaanike kosi; ne Daudi yali niyeeboyile efoti yeikitani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio Daudi nende inzu yosi yaIsiraeli batikulusia lisanduku liOMWAMI nende amakhu nende oluyoka Iwolwika.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa lisanduku liOMWAMI liali niliinjila mwitookho liaDaudi, Mikali omukhaana waSaulo yahenjela mwitirisha, nalola omuruchi Daudi nasiilasiilanga nashina imbeli wOMWAMI; namuchaya mumwoyokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibeenjisia lisanduku liOMWAMI, nibalirenjekha habundu walio, mwiheema elia Daudi yali nalikhomeeleDaudi namala emisango emisambe nende emisango chiokhwishia imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Daudi yali namalile okhumala emisango emisambe nemisango chiokhwishia tsana, yasabila abandu ikhabi muliira liOMWAMI omwene mahe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nakabila abandu bosi, mubunji bwosi bwaIsiraeli, kata abasaatsa kata abakhasi, buli mundu omukaate, nomukabo kweinyama, nende libumbi lietsinzabibu tsinyumu. Mana abandu bosi nibeenyokha nibatsia buli mundu ebunangowe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi naye nakalukha okhusabila abeinzuye ikhabi. Ne Mikali omukhaana waSaulo narula okhumubukaanila Daudi, nasunga ari Toto, omuruchi waIsiraeli abeele woluyali leelo, olwa yeenaabuule mumoni tsiabakhaana abakholi babasumbabe, shinga omundu omusilusilu yesi olwa yeenaabulanga! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.20",
            "verseOrgIds": [
              "2SA.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi namusunjila Mikali ari Khubeele imbeli wOMWAMI, owandobola isie mushilenje shiaso, khandi mushilenje shiabeinzuye bosi, mbu ya'khole embe omukhulundu wabandu bOMWAMI, Isiraeli; niko akachila ndalasangalanga imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalameeta okhuchayikha, nindiitivibwa mumonitsio; ne halubeka lwabakhaana abakholi aba orumbuule yabo, balambeelesinjia oluyali. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.22",
            "verseOrgIds": [
              "2SA.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Mikali omukhaana waSaulo shiyalikhwo nende omwana yesi ta, okhuula olwa yafwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.23",
            "verseOrgIds": [
              "2SA.6.23"
            ]
          }
        }
      ]
    }
  ],
