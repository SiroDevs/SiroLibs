{
  "id": "2SA.12",
  "number": "12",
  "bookId": "2SA",
  "reference": "2 Samweli 12",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "2SA 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Natsani yamukondeshela Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne OMWAMI yaruma Natsani ewaDaudi. Niyoola ewa yali, namusunjila ari Bali nibaliho abasaatsa babili mwitaala elala; oundi omuyinda, noundi omumanani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.1",
            "verseOrgIds": [
              "2SA.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuyinda oyo yali nende amakondi nende tsing'ombe tsinyinji okhushila; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.2",
            "verseOrgIds": [
              "2SA.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omumanani shiyali nende eshindu ta, habula eshimeeme shielikondi eshisibini shilala eshitiiti, eshia yali niyakula, niyaayanga; nashio shiakhulilanga halala ninaye, nahalala nende abaanabe; shialiitsanga khukhaliibwa khekhe, nishinyweelanga mushikombe shishie, nishikona khushilifushie, nishimubeela shinga omwana omukhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.3",
            "verseOrgIds": [
              "2SA.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omubiri undi yoola ewomuyinda, naye yalekha okhubukula eshiomumakondi keke kata tsing'ombetsie, okhumusinzila omuchendi oyo owali niyoolile hawuwe, nebutswa yabukula eshimeeme shiomumanani oyo namusinzila omundu oyo owali niyoolile hawuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.4",
            "verseOrgIds": [
              "2SA.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oburima bwaDaudi bwamwashilakhwo omundu oyo muno; namusunjila Natsani ari Shinga OMWAMI olwa abeetsangaho mwoyo, omundu owakhola likhuwa lino akwanile okhufwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.5",
            "verseOrgIds": [
              "2SA.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi alarunga eshimeeme okhuula khane, shichila yakhola likhuwa elo, khandi shichila yabula nende eshisa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Natsani yamusunjila ari Niwe omundu tsana. Kano niko aka OMWAMI, Nyasaye waIsiraeli, asunga; mbu Ndakhutsushiilila amafura obe omuruchi waIsiraeli, nikhuhonia mumukhono kwaSaulo; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.7",
            "verseOrgIds": [
              "2SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi ndakhuheelesia inzu yomwamiwo, nende abakhasi bomwamiwo mushilifushio, nikhuheelesia nende inzu yaIsiraeli nende eyaYuda; nebio nibiba nibibeele ebituutu khwiwe, ndakhakhumeeteele ebindi khandi birio. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.8",
            "verseOrgIds": [
              "2SA.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nishiina eshiachila nofwola likhuwa liOMWAMI, nokhola akali amabii mumonitsie? Wamuupa Uria omuHiti nolukanga, nobukula omukhasiwe abe omukhasiwo, nomwira nende olukanga lwabaAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.9",
            "verseOrgIds": [
              "2SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, olukanga shilulirulakhwo munzuyo tawe; okhuba wafwola, nobukula omukhasi waUria omuHiti abe omukhasiwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI aboolambu Lola, ndalabuusia obubii khwiwe munzu yiyo omwene, ne ndalabukula abakhasibo mumonitsio, nimuheelesia owashio, naye alakona nende abakhasibo imbeli weliuba lino. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.11",
            "verseOrgIds": [
              "2SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba iwe wakhola masilisi; nasi ndalakhola likhuwa lino imbeli waIsiraeli yosi, khandi imbeli wOMWAMI eliuba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi namusunjila Natsani ari Ndnmwonooneele OMWAMI. Natsani namusunjila Daudi ari Khandi OMWAMI ayiniyeho eshionoonoshio; shiwitsa okhufwa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula, okhuba mushikhole shino omufwolile OMWAMI, kho omwana owa witsa okhwibula naye shialachweya okhufwa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.14",
            "verseOrgIds": [
              "2SA.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Natsani niyeenyokha natsia ingo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nakhupa omwana owa omukhasi ousika Uria yamwibulila Daudi, omwana nalwala muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iiho Daudi yasaaya Nyasaye muno khulwa omwana oyo; Daudi nahonga inzala, niyeenjila, nakona hasi eshilo tulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.16",
            "verseOrgIds": [
              "2SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakofu beinzuye nabo nibarula, nibasinjila ahambi ninaye, mbu bamubuusie ewa yali hasi; ne yakhaya, kata shiyalia ninabo ebiliibwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.17",
            "verseOrgIds": [
              "2SA.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomusaafu omwana yafwa. Abasumba baDaudi nabo nibana okkumuboolela shinga omwana olwa yali nafwile; shichila baboola bari Lola, omwana olwa abeele nashili mwoyo, khusunganenje ninaye, naye nararechelesia okhusunga khweefwe ta; kho nakhumuboolele khurie mbu omwana ufwile? Yakheekhola obubii. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.18",
            "verseOrgIds": [
              "2SA.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Daudi yalola shinga abasumbabe olwa bali nibahwehwelananga abeene nabeene, Daudi yeetsulila mbu omwana ufwile; mana Daudi nareeba abasumbabe ari Omwana afwile noho? Nabo nibakalusia bari Ufwile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.19",
            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi nabuukha okhurula hasi, niyeeyosia, niyeebakha amafura, nakalukhasia ebiifwalobie; niyeenjila munzu yOMWAMI, namwinamila; mana natsia ebunanzu wuwe omwene; nolwa yasaba ebiliibwa, bamurenjeshela, nalia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abasumbabe nibamureeba bari Nelikhuwa shiina lino elia okholile? Wahonjilenje inzala nomulilila omwana, olwa yabeelenje nashili mwoyo; ne bulaano olwa omwana afwile, obuushile nolia ebiliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.21",
            "verseOrgIds": [
              "2SA.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naboola mbu Olwa omwana yabeelenje nashili mwoyo, ndahonjilenje inzala nende okhulila, okhuba ndapaarilenje ndi Niwina ounyala okhumanya OMWAMI naba nalambeela tsimbabasi, omwana waba omulamu? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.22",
            "verseOrgIds": [
              "2SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano olwa afwile, nishiina eshiakhachila nihonga inzala? Enyala okhumukalusia noho? Isie ndilimutsiila, ne ye shialingalushila tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi namulemia Batsesheba omwoyo, namutsiila, nakona ninaye; naye niyeebula omwana omusiani, namukulikha eliira mbu Sulemani. OMWAMI naye namuheela omwana Oyo; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "naruma Natsani omunabii, namulachilisia okhumukulikha eliira mbu Yedidia, khulwa OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi yahula Raba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yoabu yaseera Raba yabaAmoni, nabukula litookho liomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoabu naruma abarume ewaDaudi, okhusunga mbu Ndaseerile Raba, khandi embukuule litaala elo liamatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, okhung'aasie abandu abatong'ile halala, okhome ikambiyo imbeli welitookho, olibukule; mbu isie endeshe okhubuleula litookho; liakhakulikhwa eliira lianje. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi yakhung'aasia abandu bosi halala, natsia eRaba, naliseera, nalibukula. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yabukula olusimbi Iwomuruchi wabwe khumurwe; nobusiro bwalwo bwachelwa italanda yeitsahaabu; ne lwalimwo inyuma yobukusi obutinyu; nalwo lwarenjekhwa khumurwe kwaDaudi. Naye yarusia ebiyaayo mwitookho, ebinji okhushila. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi narusia abandu abalimwo, nabara khumilimo chiemisumeno, nechiebibia ebimemu, nechietsihaywa tsiebibia, nabakhosia emilimo chiebilonjelo biamatofali; khandi nolwa yakholela zmataala kosi kabaAmoni. Mana Daudi nende abandu bosi nibakalukha eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.31",
            "verseOrgIds": [
              "2SA.12.31"
            ]
          }
        }
      ]
    }
