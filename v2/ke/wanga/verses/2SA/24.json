{
  "id": "2SA.24",
  "number": "24",
  "bookId": "2SA",
  "reference": "2 Samweli 24",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2SA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olundi oburima bwOMWAMI bwashila Isiraeli, namutsuuba Daudi khubo, nasunga mbu Tsia obale abaIsiraeli nende abaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.1",
            "verseOrgIds": [
              "2SA.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi namusunjila Yoabu nende abaseesia belihelie, aba yali ninabo, ari Tsie bulaano eBeerisheba, mubale abandu, emanye obukhumi bwabandu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.2",
            "verseOrgIds": [
              "2SA.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yoabu namusunjila omuruchi ari OMWAMI Nyasayewo yeenjiye abandu khandi eshikhumi, kata nibali banga, tsimoni tsiomwami wanje omuruchi natsio nitsishilola. Nebutswa, omwami wanje omuruchi, nishiina eshichila likhuwa lino nilikhuchamisia? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.3",
            "verseOrgIds": [
              "2SA.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula likhuwa liomuruchi liamushila Yoabu, nende abaseesia belihe. Nabo Yoabu nende abaseesia belihe barula ewomuruchi, okhubasia abandu baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibaambukha Yorodani, nibachaachila eAroeri, heetaala elili hakari mwibanda liaGadi, nende okhuula eYazeri; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.5",
            "verseOrgIds": [
              "2SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana niboola eGileadi, nende eshialo shiabaHiti, eKadeshi; niboola eDani, mana nibabotokhana okhuula eSidoni, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.6",
            "verseOrgIds": [
              "2SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "niboola khulukoba lwaTiro, nende khumataala kosi kabaHiwi, nende akabaKanaani; nibarula nibatsia eNegebu yaYuda, eBeerisheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.7",
            "verseOrgIds": [
              "2SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa bali nibamalile okhulambuula eshialo shiosi, boola eYerusalemu khubumalilishi bwemiesi shienda nende tsindaalo amakhumi kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.8",
            "verseOrgIds": [
              "2SA.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoabu naboolela omuruchi obukhumi bwobubasii bwabandu; nibabaho muIsiraeli abasaatsa abalulu abetsinganga ebikhumila ebikhumi munaane; abaYuda nibaba abasaatsa ebikhumila ebikhumi biraano.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ikholo yamurimukha Daudi olwa yali namalile okhubasia abandu. Daudi namusunjila OMWAMI ari Ndoonoonile muno khulia ekholile lino; ne bulaano, e OMWAMI, ekhusaaya mbu orusieho obumayaanu bwomusumbawo; okhuba ekholile akobusilu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.10",
            "verseOrgIds": [
              "2SA.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Daudi yabuukha mutsuli, likhuwa liOMWAMI liamwitsila omunabii Gadi, omulakusi waDaudi, liri ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsia oboolele Daudi mbu OMWAMI asunga ari nanwa, mbu Era imbeliwo amakhuwa kataru; wilobolele elala khuko, elia ekhukholela. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Gadi namutsiila Daudi, namuboolela, nasunga ari Emiyika chitaru chieinzala chikhwitsile mushialoshio? Nohomba wilushenje abasukubo emiesi chitaru, olwa balabeetsanga nibakhulonda? Nohomba oluumbe lubeho mushialoshio tsindaalo tsitaru? Kho oyililisie bulaano, nolola mbu nelikalusio shiina elia emukalusilie omwenoyo ourumile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.13",
            "verseOrgIds": [
              "2SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi namusunjila Gadi ari Kandinyiile muno; kho bulaano khukwe mumukhono kwOMWAMI; okhuba tsimbabasitsie netsinyinji; ne endeshe okhukwa mumukhono kwomundu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.14",
            "verseOrgIds": [
              "2SA.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.14",
            "verseOrgIds": [
              "2SA.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana OMWAMI yarumila Isiraeli oluumbe okhurula mutsuli okhuula khushise eshialachilisibwa; okhurula eDani okhuula eBeerisheeba abandu nibafwa, ebikhumila amakhumi musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.15",
            "verseOrgIds": [
              "2SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa malaika oyo yakololosia omukhonokwe nachoomia eYerusalemu okhulimulula, OMWAMI yatsuunwa omwoyo khulwa obubii obwo, nasunjila malaika owali namululanga abandu ari Kahelile; bulaano yeesia omukhonokwo. Ne malaika w yali nali ahambi nende olutse lwaArauna, omuYebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.16",
            "verseOrgIds": [
              "2SA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Daudi yalola malaika oyo owali narootsanga abandu, yasunjila OMWAMI ari Lola, nisie owayonoonile, khandi nisie owakholile obukhayikhanu; ne amakondi kano, nako kakholile shiina? Ekhusaaya mbu omukhonokwo kube khwisie, khandi khushilibwa shieefwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.17",
            "verseOrgIds": [
              "2SA.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.17",
            "verseOrgIds": [
              "2SA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Gadi yamutsiila Daudi inyanga eyo namuboolela ari Tsia osinjisilie OMWAMI eshimalilo shiemisango mulutse lwaArauna omuYebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.18",
            "verseOrgIds": [
              "2SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi natsia, shinga likhuwa liaGadi olwa liali, shinga olwa OMWAMI yali nalachile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
              "2SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Arauna nahenga elwanyi, nalola omuruchi nende abasumbabe nibeetsanga ewa yali; Arauna narula, niyeenama imbeli womuruchi nabunamia obwenibwe nasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
            "verseOrgIds": [
              "2SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Arauna nasunga mbu Nelikhuwa shiina elichilile omwami wanje omuruchi niyeetsile ewomusumbawe? Naye Daudi naboola mbu Enzitsile okhukula ninawe olutse, enyumbashilemwo OMWAMI eshimalilo shiemisango, mbu mana oluumbe luyinjilwe mubandu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna namusunjila Daudi ari Omwami wanje omuruchi abukule ebia achama, abimale emisango; tsing'ombe etsiomusango okwokhusambwa nzietsino, khandi ebihuulilo nende ebimanulwa bietsing'ombe bibe tsikhwi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.22",
            "verseOrgIds": [
              "2SA.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "bino biosi, e omuruchi, Arauna ahaanila omuruchi. Arauna namusunjila omuruchi ari OMWAMI Nyasayewo akhufuchiilile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
            "verseOrgIds": [
              "2SA.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi namusunjila Arauna mbu Tawe; habula ndalabikula ninawe obukusi; kata shindalamalila OMWAMI Nyasaye wanje emisango emisambe echia ndanyoolile butswa tawe. Nindio Daudi yakula olutse nende tsing'ombe etsio tsishekeli amakhumi karaano tsieifeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana Daudi niyoombashila OMWAMI eshimalilo shiemisango ebweneyo, namala emisango emisambe nende emisango chiokhwishia. Nindio OMWAMI yafuchiilila okhusaaywa khulwa eshialo oluumbe niluyinjilwa muIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.25",
            "verseOrgIds": [
              "2SA.24.25"
            ]
          }
        }
      ]
    }
  ],
