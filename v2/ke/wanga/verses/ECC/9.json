        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akomubulamu buno shikali amaleng'aanu ta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ako kosi ndarakhwo omwoyo okhukarunilisia; mbu abalunjishi, nabachesi, nebikhole biabwe, bili mumukhono kwaNyasaye; kata nibuli obuheeli kata obukiyi, omundu shiamanyanga ta. Kosi akali imbeli wabwe namakhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.1",
            "verseOrgIds": [
              "ECC.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa malala keetselanga bosi; buliho obumaliilishi bulala khubalunjishi khandi khubamayaanu; khubalayi nokhubabii; khubasiiye nokhubobukaali; khu oyo oumala omusango khandi khu oyo ouramala omusango ta; shinga omulayi olwa ali, nolwa omwonooni ali ario; khandi oyo owitsuba ali butswa shinga oyo ouriitsanga eshiitsubo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.2",
            "verseOrgIds": [
              "ECC.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nilio libii elinyoolekha mukosi akakholungwa hasi weliuba, mbu buliho obumaliilishi bulala khubosi; khandi mbu emioyo chiabandu chiitsulangamwo obubii, khandi amalalu kali mumioyo chiabwe olwa bashiliho mwoyo, kata nende olwa baliba nibatsiile mubafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.3",
            "verseOrgIds": [
              "ECC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ouba niyoongaane khubali mwoyo bosi, ali nobunaayi; shichila imbwa inamu yishila italanyi ifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.4",
            "verseOrgIds": [
              "ECC.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abali mwoyo bamanyanga mbu balifwa; nebutswa abafu shibamanyanga likhuwa liosi ta, kata shibaba namatani khandi ta; okhuba obwitsulilwi bwabwe bweebililwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.5",
            "verseOrgIds": [
              "ECC.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuheeli bwabwe halala nobukiyi bwabwe nokhukhalikha omukongo, biosi biasikha. Kata shibalikhwo nomukabo inziayo, mwikhuwa liosi liosi elikholwa hasi weliuba ta.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsia ewa otsia, oliitsenje ebiliibwabio nokhwikhoya, nonywa idivaiyo nomwoyo omutsatsahafu; okhuba Nyasaye wamala okhufuchiilila ebikholebio.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsingubotsio tsibeetsenje tsindafu tsindaalo tsiosi; omurwekwo nakwo kuleshe okhutamba amafura.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.8",
            "verseOrgIds": [
              "ECC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.8",
            "verseOrgIds": [
              "ECC.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyanga mubutsatsahafu halala nomukhasiwo owa oheelanga tsindaalo tsiosi tsiobulamubwo bwobukhaya, etsia yakhuheelesia hasi weliuba; okhuba okwo nikwo omukabokwo mubulamu, khandi mumilimochio chiosi echia onyakhanilangakhwo hasi weliuba. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.9",
            "verseOrgIds": [
              "ECC.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiosi eshia omukhonokwo kunyoola okhukhola, oshikhole namaaniko; okhuba shibulaho eshikhole, kata eshikulukunzo, kata obumanyi, kata obuchesi, eMakombe ewa otsia ta.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nindola, hasi weliuba, mbu omutiebano kwokhwilukhana shikukwa khuwetsimbilo, kata obusoolo okhukwa khuwamaani, kata ebiokhulia khumuchesi, kata emiandu khubandu abarechelefu, kata olukoosi khubasitsa ta; habula mbu induukho neikhabi bibakwilanga bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu shiamanyanga induukhoye ta; shinga tsinyeeni olwa tsitiilungwa mulukhanda olubii, kata shinga amanyonyi olwa kahambungwa mushireko, nolwa abaana babandu barekungwa munduukho imbii, olwa yibakwila meetsukhana.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuchesi bushila amaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalola obuchesi obufwana buli nanwa hasi weliuba, nibundoleshela nibuli obukhongo; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.13",
            "verseOrgIds": [
              "ECC.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu lialiho litaala liNutu, elialimwo abandu abatmltu butswa; mana omuruchi omukhongo niyeetsa okhuliseera, naliikalila, nabunjikha ebituuli ebikhongo okhuliseerela. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.14",
            "verseOrgIds": [
              "ECC.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulio omundu yanyoolekha, omumanani omuchesi; ne yahonia litaala elo nobuchesibwe; nebutswa yabulaho oweetsulila omumanani tsana ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.15",
            "verseOrgIds": [
              "ECC.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimboola mbu Obuchesi bushila amaani; nebutswa obuchesi bwomumanani uno bulekwa, amakhuwake nikarahulilwa ta.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.16",
            "verseOrgIds": [
              "ECC.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.16",
            "verseOrgIds": [
              "ECC.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa komuchesi akahulilwa mubuholeelefu kashila okhulanjisia khwomuruchi mubayingwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.17",
            "verseOrgIds": [
              "ECC.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuchesi bushila ebimanulwa lielihe; ne omwonooni mulala asishia obulayi obunji.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.18",
            "verseOrgIds": [
              "ECC.9.18"
            ]
          }
        }
      ]
    }
  ],
