            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu niyakhayindila emiyika eminji, achiikhoyele shiosi; nebutswa yeetsulilenje tsindaalo tsieshiilima, shichila tsiliba tsinyinji. Kosi akali okhwitsa namakhaya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwibaalilwi khubabuukha",
          "type": "text"
        }
      ]
    },
    {
