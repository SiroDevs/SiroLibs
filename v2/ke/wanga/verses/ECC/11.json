          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe omusooliili, wikhoyele oluraakalwo; omwoyokwo kukhutsatsahasie mundaalo tsiolusooliililwo; ochendenje khunjila yomwoyokwo, khandi mukhulola khwetsimonitsio; nebutswa manya mbu Nyasaye alakhuyaasia khulwa amakhuwa ako kosi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
