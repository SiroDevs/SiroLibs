        "style": "s1"
      },
      "items": [
        {
          "text": "Lishiesio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyirula khuSimoni Petero, omusumba khandi omurume waYesu Kristo; yule khubeenabo abanyoola nineefwe halala obusuubili bwolukoosi obuhelana nobweefwe, mubulunjishi bwaNyasaye weefwe khandi Omuhonia weefwe, Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukoosia nomulembe bimeeteshenje khwinywe mubumanyi bwaNyasaye nende obwaYesu Omwami weefwe.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulangwi nobulobolwi bweenywe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunyali bwobuNyasayebwe bwakhuheelesia amalayi kosi akeenyekha khulwa obulamu neidini, munjila yokhumumanya oyo owakhuIanga khulwa oluyalilwe nende obulayibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.3",
            "verseOrgIds": [
              "2PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne munjila yoluyalilwe nobulayibwe tsana yakhusuubisia obusuubisiebwe obukoosi, obushila obukhongo; mbu khulwabwo musanjilane khuburulanda bwobuNyasaye, nimwihonokooshe mubusasishi obuli mushialo khulwa obwikombi.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.4",
            "verseOrgIds": [
              "2PE.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.4",
            "verseOrgIds": [
              "2PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niko akachila mukhoyile okhurakhwo omwoyo okhutasa obulayi khubusuubili bweenywe; obulayi bweenywe nabwo bube nobumanyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.5",
            "verseOrgIds": [
              "2PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "obumanyi bweenywe bube nobwiruchi; obwiruchi bweenywe bube nobwisimilisii; obwisimilisii bweenywe bube nokhuria Nyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.6",
            "verseOrgIds": [
              "2PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuria Nyasaye khweenywe khube nobwenyani nabaana beefwe; obwenyani nabaana beefwe bube nobuheeli.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.7",
            "verseOrgIds": [
              "2PE.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.7",
            "verseOrgIds": [
              "2PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ako kosi nikaba nikali akeenywe, nikashilaananga, kamukhola mbu muraba abatofu kata ababula okhwama ebiamo ta, mubumanyi bwOmwami weefwe Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.8",
            "verseOrgIds": [
              "2PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba oubula ako nomubofu, ne alolanga akali ahambi konyene, niyeebiliile shinga olwa yasiiywa khubionoonobie biakhale. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.9",
            "verseOrgIds": [
              "2PE.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila, baana beefwe, rekhwo omwoyo muno okhutinyisia obuIangwi bweenywe nobulobolwi bweenywe; shichila nimuba nimukakholanga, shimulakwa nahatuutu ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.10",
            "verseOrgIds": [
              "2PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi murio mulaheebwa buha obwinjisibwi mubwami bwobumeli bwOmwami weefwe khandi Omuhonia weefwe Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.11",
            "verseOrgIds": [
              "2PE.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.11",
            "verseOrgIds": [
              "2PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila ndalabeetsanga nindirecheeshe tsindaalo tsiosi okhumwitsusmjia khumakhuwa ako, kata olwa mukamanyile nimuralisiibwe mubwatoto obwa muli ninabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.12",
            "verseOrgIds": [
              "2PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi enduutsi mbu nobulayi, olwa emba nishiliho mwitili lino, okhumubuusia nimwitsusinjia endio; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.13",
            "verseOrgIds": [
              "2PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimanyile mbu obwinaabuli bwelitili lianje buulanga bwangu, shinga Omwami weefwe Yesu Kristo olwa yamanyia. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereetsangakhwo omwoyo muno, mbu buli lwosi munyalilwe okhukeetsulila, olunyuma Iwokhwinyokha khwanje.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaloli bobukhulundu bwaKristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shikhwali nikhulondanga tsingano butswa etsiakunzwa nobuchesichesi ta, olwa khwamumanyia akobunyali bwOmwami weefwe Yesu Kristo nende akokhwitsakhwe; nebutswa ifwe khwali abaloli bobukhulundubwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila yanyoola okhurula khuNyasaye Samwana iruma noluyali, olwa omwoyo okwo kwamwitsila okhurula muluyali olukhulundu olwo, mbu Uno niye Omwana wanje omuheelwa; muye nimwo omwa enjamisilibungwa muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omwoyo okwo ifwe abeene khwakuhulila nikurula mwikulu, olwa khwali nikhuli ninaye mushikulu eshitakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khwatinyisilibwa khurio likhuwa liobulakusi; neenyu, bwakhaba bulayi nimuliirechelesia, shinga khutaha eyakhanga hashiilima, okhuula ebukwe olwa busheba, eyasulwe niyifwinda mumioyo chieenywe.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.19",
            "verseOrgIds": [
              "2PE.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.19",
            "verseOrgIds": [
              "2PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mumanye likhuwa lino mbeli, mbu mumahandiiko libulaho likhuwa liosi liobulakusi elirimbululwa shinga omundu mulala olwa yakhaba niyeenya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.20",
            "verseOrgIds": [
              "2PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olchuba bubulaho obulakusi bwosi obweetsa khulwa okhwenya khwomundu ta; habula abandu baboola akarula khuNyasaye, shinga olwa beemililwa nende Roho Omutakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.21",
            "verseOrgIds": [
              "2PE.1.21"
            ]
          }
        }
      ]
    }
  ],
