    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abanabii bobubeeyi, nabeechesia bobubeeyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abanabii bobubeeyi babuukha mubandu, shinga olwa baliba mwinywe abeechesia bobubeeyi, abalaleeranga mabiswi ameechesio kobubeeyi akaleera obutibi, nibeeyambakhana kata Omwami owabakula, nibeeleerela abeene obutibi bwakatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.1",
            "verseOrgIds": [
              "2PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abanji balilonda mubiima biabwe biobwilaasi; ne nibo abalichila injila yobulamu yilanyekwa.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.2",
            "verseOrgIds": [
              "2PE.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.2",
            "verseOrgIds": [
              "2PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa likhalikhali baliboola akobukaatii nibamukhola inywe okhuba ebiobukhala; ne bulaano eshiina shiabwe shiakhale shishishinda, kata obutibi bwabwe okhurenjeetsa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila Nyasaye shiyalekha abamalaika ta olwa boonoona, nebutswa yabafuuba muTarataro, nababiikha mubuko bweshiilima ti, okhulindiilila eshiina. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.4",
            "verseOrgIds": [
              "2PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shiyalekha eshialo shiakhale ta; habula yamuteetsa Noa, omurumbusi wobulunjishi, nabandi musaafu halala ninaye, olwa yaleera omuyembo kwamatsi khushialo shia abo abaramuria Nyasaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.5",
            "verseOrgIds": [
              "2PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yakwisia amatookho kaSodoma naGomora likoshe yakakhalachila eshiina shiokhumululwa, nakakholile okhuba eshilolelo khubeenabo abamenyanga nibaramuria Nyasaye ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.6",
            "verseOrgIds": [
              "2PE.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa yamuhonia Loti omulunjishi oyo, owali nachoonyiliibwe elala khulwa akobwilaasi bwabamayaanu; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.7",
            "verseOrgIds": [
              "2PE.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila omundu oyo omulunjishi, olwa yali namenyile hakari mubo, nalolanga nende okhuhulila, yasaalilanga omwoyokwe omulunjishi inyanga buli nyanga khulwa ebikhole biabwe biomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.8",
            "verseOrgIds": [
              "2PE.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami yamanya okhuhonia abo abariitsanga Nyasaye mukhuteemwa, nokhubabiikha ababula obulunjishi mubukuumwi okhuula khunduukho yeshiina; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.9",
            "verseOrgIds": [
              "2PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhushila muno abo abachenda mumela yomubili, mubwikombi obuleera akeshifwabwi, nibaleka oburuchi bwosi. Nabatsaalishi, abemirwe emiumu, abararia okhunyeka aboluyali ta ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa abamalaika, kata nibabashila amaani nobunyali, shibabakhalachila eshiina shiobunyechi imbeli wOmwami tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.11",
            "verseOrgIds": [
              "2PE.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.11",
            "verseOrgIds": [
              "2PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abo abeengana tsisolo nasolo etsibula obuchesi, etsioburulanda bwokhuyiimwa nitsisishibwa, abanyekanga khumakhuwa aka bakorwa eshisina shiako, balasishibwa mubusishibwi bulala bwenobwo, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.12",
            "verseOrgIds": [
              "2PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibanyoola amabii, omukabo kwobumayaanu bwabwe. Nabandu abatsatsahala okhumeelanga mushiteere. Bali butswa ebiroonyelesi netsimbala, abameelela emienya chiabwe abeene, olwa baliitsanga nineenywe mumasabo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.13",
            "verseOrgIds": [
              "2PE.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.13",
            "verseOrgIds": [
              "2PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsimoni tsiabwe tsikhaabanga omukhasi omuheyi, nitsirakonela okhwonoona ta; bahombelesinjia abemioyo emiteshele; emioyo chiabwe chianasibwa akelikhalikhali; beebulwa mushilaamo shiobubii. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.14",
            "verseOrgIds": [
              "2PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balekha injila yatoto, nibashiama, shichila balonda injila yaBalaamu waBeori, owachama omuleabo kwobumayaanu; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.15",
            "verseOrgIds": [
              "2PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne yakondesheelwa obukhayibwe; isishili isilu yaboola nomwoyo kwomundu, niyiikalila amalalu komunabii oyo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bali tsisebele etsibula amatsi, khandi linang'ong'we elichesibwa neimbumbuyeka; nibo aba eshiilima eshimali ti shiabiishilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.17",
            "verseOrgIds": [
              "2PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barumbulanga amakhuwa amakhongo akobwikhulumami akali butswa amakhaya, nibatsuuba abo ababa nibakheehonokokha mumakhono kabebiima ebirambaatsanu, mubwikombi bwomubili, nobwilaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.18",
            "verseOrgIds": [
              "2PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babasuubisia obulekhuule, olwa abeene bali abasumba bobusasishi; shichila omundu akwitsanga omusumba wakeenako akamuhula. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.19",
            "verseOrgIds": [
              "2PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abandu nibaba nibeehonokokha mukeshifwabwi shieshialo khulwa obumanyi bwOmwami khandi Omuhonia Yesu Kristo, mana bamala nibeetsoka muko khandi nibahulwa, kho obumaliilishi bwabwe buba obubii okhushila shinga olwa babeelenje. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.20",
            "verseOrgIds": [
              "2PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwakhabeele bulayi khubo nibarakhamanyile injila yobulunjishi ta, okhushila okhuchimanya mana nibashiukhana nibalekha lilako elo litakatifu elia bali nibaheebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.21",
            "verseOrgIds": [
              "2PE.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabeekholakhwo akaboolwa muluchelo olwatoto, mbu Imbwa yikalushiile amasasi kayo, nayo ingurwe eyosiibwe khukhukalakala mumatoyi.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.22",
            "verseOrgIds": [
              "2PE.2.22"
            ]
          }
        }
      ]
    }
  ],
