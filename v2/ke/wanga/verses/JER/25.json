    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaBabeli okhubamulula emiyika amakhumi musaafu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elieetsela Yeremia khukabandu bosi baYuda, mumuyika kwakhane kwaYehoyakimu waYosia, omuruchi waYuda; ne nikwo omuyika kwambeli kwaNebukhadineza omuruchi waBabeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eliene nilio elia Yeremia omunabii yaboolela abandu bosi baYuda, nende bosi abamenyanga muYerusalemu; ndielino, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Okhurula khumuyika kwekhumi nakhataru kwaYosia waAmoni omuruchi waYuda, okhuula olwa leelo, mbu emiyika amakhumi kabili nachitaru, likhuwa liOMWAMI linzitsilanga, nasi nimuboolelanga, nimboola khale nilumilila okhuboola; nebutswa shimuhulilanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI yamurumila abasumbabe abanabii bosi, nabarumanga khale nalumilila okhubaruma; nebutswa shimuhulilanga kata okhureka amarwi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibaboolanga mbu Bulaano kalushe buli mundu okhurula khunjilaye imbii, nokhurula khububii bwebikholebie, mumenye mushialo eshia OMWAMI yamuheelesia inywe nabakuuka beenywe, okhurula khale ne inziayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muralonda khubanyasaye bandi okhubakhalabanila nokhubeenamila, kata murasinyisia nebikhole biamakhono keenywe; mana isie shindalamukhupia khushibii tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shimwayambulila ta; nolwa OMWAMI aboola; mbu mana musinyisie nebikhole biamakhono keenywe, nimwichemela amabii.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako kano niko aka OMWAMI omwene mahe aboola; mbu Okhuba mwakhaya okhuhulila amakhuwa kanje, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lole, ndalarumana abetsimbia tsiosi tsiebunotsi, OMWAMI aboola, nende Nebukhadineza omuruchi waBabeli, omusumba wanje, nimbaseesia khushialo shino, nokhubamenyangamwo, nokhumahanga ako kosi akashibotokhana; ndalakatibilia elala, ningakhola kabe akamariisia, akokhunyokhoosibwa, kabe aketsisoni tsindaalo tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalarusilia elala muko omwoyo kwokhwikhoya nomwoyo kwobutsatsahaafu, omwoyo kwomwene shiselelo nomwoyo kwomweha, amayoosi ketsinjina, nobulafu bweitaha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.10",
            "verseOrgIds": [
              "JER.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo shino shiosi shilaba likunda, khandi eshiamariisia; amahanga ako nako kalasiobela omuruchi waBabeli emiyika amakhumi musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.11",
            "verseOrgIds": [
              "JER.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana emiyika echio amakhumi musaafu olwa chiliba nichihweele, ndalakuuma omuruchi waBabeli nende lihanga tsana neshialo shiabaKalidayo, OMWAMI aboola, khulwa obumayaanu bwabwe; ne ndalashikwisia likunda ebisoni nebisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.12",
            "verseOrgIds": [
              "JER.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalaleera khushialo tsana amakhuwa kanje kosi aka ndashirumbulila, niko kosi akahandiikwa mushitabu shino, aka Yeremia yarumbulila amahanga ako kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.13",
            "verseOrgIds": [
              "JER.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba amahanga amanji nabaruchi abakhongo balabakhola abasumba, kata bo abeene; nasi ndalabarunga ebikhole biabwe shinga olwa bili, khandi emilimo chiamakhono kabwe shinga olwa chili.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshikombe shioburima obululu khulwa amahanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI, Nyasaye waIsiraeli, yamboolela; mbu Bukula mumukhono kwanje eshikombe shino shieidivai yobululu, nonyweesia amahanga ako kosi aka ekhurumila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nako kalanywa, nikayingoya nikalalukha, khulwa olukanga olwa ndalaruma hakari wabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ndabukula eshikombe tsana mumukhono kwOMWAMI, ninyweesia amahanga ako kosi aka OMWAMI yarumakhwo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.17",
            "verseOrgIds": [
              "JER.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Yerusalemu, namatookho kaYuda, nabaruchi balio nabakhulundu balio, okhubakhola likunda, amariisia, akokhunyokhoosibwa, khandi eshilaka munwa, shinga olwa kali leelo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.18",
            "verseOrgIds": [
              "JER.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo Farao omuruchi waMisiri, nabasumbabe, nabakhulundube, nabandube bosi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.19",
            "verseOrgIds": [
              "JER.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabarende bosi abatsokana mubo; nabaruchi bosi beshialo shiaUzi, nabaruchi bosi beshialo shiabaFilisiti nabaAshekeloni, naGaza, naEkeroni, nomusikalo kwaAshidodi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu, naMoabu, nabaana baAmoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.21",
            "verseOrgIds": [
              "JER.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaruchi bosi baTiro, nabaruchi bosi baSidoni, nabaruchi bolukuku oluli injelekha weinyanza; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
            "verseOrgIds": [
              "JER.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dedani, naTema, naBuzi, nabosi abeebekanga lituma; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.23",
            "verseOrgIds": [
              "JER.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaruchi bosi bebuArabu, nabaruchi betsimbia etsitsokatsokaane abamenyanga mushitsiimi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.24",
            "verseOrgIds": [
              "JER.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaruchi bosi baZimiri, nabaruchi bosi baElamu, nabaruchi bosi bebuMedi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.25",
            "verseOrgIds": [
              "JER.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaruchi bosi bebunotsi, abehale nabahambi, nibalondana mulala mulala; naboburuchi bwosi bwebialo biosi, ebiliho khushialo eshilamba; mana omuruchi waBabeli alanywa inyuma wa abo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olabasunjila mbu Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Nywe, nimumeela, nimusala, nimukwa, nimurabuukha khandi ta, khulwa olukanga olwa ndalaruma hakari mwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        }
      ]
    },
