              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khushise eshio abandu bano nende abeYerusalemu balaboolelwa mbu Omuyeka kweshimiyu kurula khubutenje obukhaya bwebikulu ebiomushitsiimi nikuchooma khumukhaana wabandu banje; ne khulwa okhuseesa kata okhulabia ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
