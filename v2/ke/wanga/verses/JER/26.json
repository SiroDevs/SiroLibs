          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Ahikamu waShafani yamuterela Yeremia, mbu baleshe okhumuhaana mumukhono kwabandu okhwirwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.24",
            "verseOrgIds": [
              "JER.26.24"
            ]
          }
        }
      ]
