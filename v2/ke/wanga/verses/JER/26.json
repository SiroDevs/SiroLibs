    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abandu beenya okhwira Yeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho khukhuchaaka khwokhuruka khwaYehoyakimu waYosia, omuruchi waYuda likhuwa lino liarula khuMWAMI; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI aboola; mbu Sinjila mulwanyi Iweinzu yOMWAMI, nosunjila abomumataala kosi kaYuda abeetsa okhwinama munzu yOMWAMI, amakhuwa kosi aka ekhulaka okhubaboolela; orachweya okhuboola likhuwa kata elala ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haundi balahulila, nibashiukhana buli mundu okhurula khunjilaye imbii; mbu nzikalukhasie oburaleera obubii obwa ereelekhwo omwoyo okhubakholela khulwa obubii bwebikhole biabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obasunjile mbu Kano niko aka OMWAMI aboola; mbu Nimuba nimurambulila ta, okhuchenda mumalako kanje aka ndara imbeli weenywe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhuhulila amakhuwa kabasumba banje abanabii aba emurumilanga, kata nilumilila okhubaruma, ne shimwabahulila ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.5",
            "verseOrgIds": [
              "JER.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho ndalakhola inzu yino yibe shinga Shiilo; litookho iino nalio ndalalikhola libe eshilaka munwa khumahanga kosi akomushialo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abakuhani nabanabii nabandu bosi bahulila Yeremia naboola amakhuwa ako munzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Yeremia yali namalile okhuboola kosi aka OMWAMI yali namulachile okhuboolela abandu bosi, abakuhani abo nabanabii nabandu bosi bamuhamba, nibasunga mbu Oleerwa bwirwa ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nishiina eshichilile norumbulila muliira liOMWAMI, ori Inzu yino yilafwana shinga Shiilo, nalio litookho lino lilakwa likunda, aharali abamenyamwo? Ne abandu abo bosi bali nibakhung'aaniile Yeremia munzu yOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa abakhulundu baYuda bahulila amakhuwa ako baiikulukha nibarula ebunanzu yomuruchi okhuula khunzu yOMWAMI; nibeekhala mubwinjililo bwEshilibwa Eshiyia shieinzu YOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakuhani nabanabii nibasunjila abakhulundu tsana nende abandu bosi, bari Omundu uno akwanile okhufwa; okhuba arumbuule amakhuwa nafukula litookho lino, shinga olwa muhuliile namarwi keenywe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yeremia nasunjila abakhulundu bosi nende abandu bosi, ari OMWAMI yaruma okhurumbulila inzu yino nelitookho lino, amakhuwa ako kosi aka muhuliile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano kasie tsinjila tsieenywe nebikhole bieenywe, nimuhulila ' omwoyo kwOMWAMI Nyasaye weenywe; mana OMWAMI aleekalukhasia nalekha obubii obwa yali narumbuule khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi, lole, endi mumakhono keenywe; mukholele shinga olwa muluutsi mbu namalayi akakhoyeele. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.14",
            "verseOrgIds": [
              "JER.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mumanye tieeli mbu nimuba nimunzira muleetuukha amatsayi koubula eshikha khumirwe chieenywe, khandi khwitookho lino nokhubamenyangamwo; okhuba toto mwene OMWAMI yaruma okhuboola amakhuwa ako kosi mumarwi keenywe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakhulundu nabandu bosi nibasunjila abakuhani nabanabii mbu Omundu uno shiakwanile okhufwa ta; okhuba abooleelaane nineefu muliira liOMWAMI Nyasaye weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho abandi abokhubakofu beshialo nibabuukha, nibasunjila abomukhung'aano kwosi kwabandu, bari ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika oweMorashetsi yalakula mundaalo tsiaHezekia omuruchi waYuda, nasunjila abandu bosi baYuda ari Kano niko aka OMWAMI omwene mahe aboola; mbu",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaliho omundu owarumbulila muliira lOMWAMI, mbu Uria waShemaya oweKiriatsiyearimu; naye yarumbulila litookho lino neshialo shino amakhuwa malala nakaYeremia; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana olwa Yehoyakimu omuruchi halala nabalulube, nabakhulundu bosi, nibahulila amakhuwake, omuruchi yakhaaba okhumwira; ne olwa Uria yahulila yaria, niyeelukha natsia eMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.21",
            "verseOrgIds": [
              "JER.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yehoyakimu omuruchi yaruma abandu eMisiri, mbu Elinatsani waAlchibori nabandu bandi ninaye halala, okhutsia eMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.22",
            "verseOrgIds": [
              "JER.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibarusia Uria muMisiri, nibamuyila ewaYehoyakimu omuruchi; naye yamwira nolukanga, nasukuna omulambokwe mubilindwa biabandu butswa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        }
      ]
    },
