            "sid": "JER 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukabaana baAmoni; kano niko aka OMWAMI aboola; mbu",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.1",
            "verseOrgIds": [
              "JER.49.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.5",
            "verseOrgIds": [
              "JER.49.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olunyumakhwo ndalakalusia tsikhabi tsiabaana baAmoni, nilwo olwa OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.6",
            "verseOrgIds": [
              "JER.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulakusi khuEdomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.11",
            "verseOrgIds": [
              "JER.49.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI aboola; mbu Lola, abo abarakwanile okhunywa khushikombe eshio ta, okhuula balanywa; nawe wakhachweya okhukuumwa noho? Shiolachweya okhukuumwa ta; okhunywa olanywa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.12",
            "verseOrgIds": [
              "JER.49.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ndeetsuba khwisie omwene OMWAMI aboola, mbu Bozora lilakwa eliamariisia, nokhuseywa, eshindu eshikhaya, eshilaka munwa; amataala kalio kosi kalaba amakhaya inziayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.13",
            "verseOrgIds": [
              "JER.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.16",
            "verseOrgIds": [
              "JER.49.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 49:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu naye alaba owamariisia; buli mundu oubira alariisibwa, nanyokhoosia khulwa amanyasioke. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.17",
            "verseOrgIds": [
              "JER.49.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 49:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga olwa kali olwa Sodomu naGomora namataala akali ahambi ninako kakwisibwa, OMWAMI aboola, omundu yesi shialamenyayo kata omwana womundu okhuchenihamwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.18",
            "verseOrgIds": [
              "JER.49.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 49:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, atikulukha shinga italanyi eyirula mubitsakha bieYorodani khushimenyo eshirahwaho ta, nindio ndalamwilusia meetsukhana, amurulekhwo; ne owa ndalalobola niye owa ndaleemekha khuye; okhuba ali heena oufwanana ninasi? Ali heena oundaka isie inyanga? Ali heena omwayi owakheema imbeli wanje? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.19",
            "verseOrgIds": [
              "JER.49.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 49:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, hulile obuchesiyii bwOMWAMI, obwa yakasiye khuEdomu, nende tsiyemitsie etsia yakasiye khubamenyanga eTemani; mbu Kata abatuutu abomubiayo balakhweswa nibarusibwayo, toto mwene, kata obwayilo bwabwe bulariisibwa khulwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.20",
            "verseOrgIds": [
              "JER.49.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubuyoka bwokhukwa khwabwe eshialo shilarenga; oluyoka Iwetsimbungu tsiabwe lulahuliilishila haNyanza Inzakhanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.21",
            "verseOrgIds": [
              "JER.49.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 49:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, alakulukha napulukha shinga inditsu, nabambula tsimbahatsie okhufukula Bozora; khunyanga eyo emioyo chiabalulu baEdomu chilaba shinga omwoyo kwomukhasi oulumwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.22",
            "verseOrgIds": [
              "JER.49.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulakusi khuDamasiko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.27",
            "verseOrgIds": [
              "JER.49.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhukaKedari, nende khukobwami bwosi bwaHazori, obwa Nebukhadineza omuruchi waBabeli yarootsa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.28",
            "verseOrgIds": [
              "JER.49.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulakusi khuElamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 49:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI elieetsela Yeremia omunabii khukaElamu, khuchaaka khwoburuchi bwaZedekia omuruchi waYuda, ndielino; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
            "verseOrgIds": [
              "JER.49.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 49:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Kano niko aka OMWAMI omwene mahe aboola; mbu Lola, ndalafunaka obuyingo bwaElamu, obwambeli bwamaani kabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.35",
            "verseOrgIds": [
              "JER.49.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 49:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khuElamu ndalaleera emiyeka chiosi chine echirula khumbeka tsine tsielikulu, nimbasalaasia enemiyeka echio chiosi; kata shililabaho lihanga liosi elia abaare baElamu shibaleenjilamwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.36",
            "verseOrgIds": [
              "JER.49.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 49:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalachila abaElamu nibafwa omwoyo imbeli wabasuku babwe, neimbeli wa abo abayiima obulamu bwabwe; ndalabakhupia khushibii, mbu oburima bwanje obululu, OMWAMI aboola; ne ndalaruma olukanga okhubalondachilila, okhuula olwa ndalaba nimbatibiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.37",
            "verseOrgIds": [
              "JER.49.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 49:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalarenjekha eshifumbi shianje shioburuchi muElamu, nimululilamwo omuruchi nende abakhulundu bosi; nilwo olwa OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        }
      ]
    },
