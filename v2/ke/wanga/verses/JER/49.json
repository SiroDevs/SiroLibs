            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 49:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mundaalo tsiolunyuma ndalakalusia tsikhabi tsiaElamu; nilwo olwa OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.39",
            "verseOrgIds": [
              "JER.49.39"
            ]
