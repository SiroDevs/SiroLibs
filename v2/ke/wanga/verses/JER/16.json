    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuyaasii bwOMWAMI khubandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila khandi, liri ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orateeshia omukhasi, kata okhwibula abaana abasiani kata abakhaana habundu hano ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.2",
            "verseOrgIds": [
              "JER.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI aboola khukabaana abasiani nokhukabaana abakhaana ababa nibeebulilwa habundu hano, nokhukabanyinabwe ababa nibabeebula, nokhukabasaabwe ababa nibabeebula habundu hano; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Balafwa khulwa tsinyumbe; shibaleekhuulwa, kata shibalayabilwa ta; balaba shinga imbolela khwiloba; ne balatibibwa nolukanga, khandi neinzala; emilambo chiabwe chilakwa ebiliibwa biamanyonyi akomwikulu nende tsisolo etsiomushialo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI aboola; mbu Oreenjila munzu yetsimbungu, kata oratsia okhubeekhuula kata okhubabeelelela ta; okhuba ndayiniye omulembe kwanje mubandu bano, mbu obuheeli bwanje oburalilu netsimbabasi; nilwo olwa OMWAMI aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhongo nabatuutu bosi balafwila mushialo shino; shibalayabilwa ta, kata abandu shibalabeekhuula, kata okhwisalaka kata okhwibeka olubeko khulwabwe ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "omundu yesi shialamechela abeekhuuli eshiokhulia okhubalemia omwoyo khulwa abafu, ta; kata omundu yesi shialabaheelesia eshikombe shiobulemia mbu banywe khulwa basamwana kata khulwa banyina tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi oreenjila munzu yelisabo okhubuutsa ninabo, nokhulia nokhunywa, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
            "verseOrgIds": [
              "JER.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI omwene mahe, Nyasaye walsiraeli, aboola; mbu Lole, habundu hano, imbeli wetsimoni tsieenywe, mundaalo tsieenywe, ndalaakamia omwoyo kwokhwikhoya nomwoyo kwobutsatsahaafu, omwoyo kwomwene shiselelo nomwoyo kwomweha!",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa olaboolela abandu bano amakhuwa kano kosi, nabo nibakhureeba mbu Ne nishiina eshichila OMWAMI narumbula obubii buno obukhongo khwifwe? Kata obumayaanu bweefwe nishiina? Kata nishiina eshionoono shieefwe eshia khumwonooneele OMWAMI Nyasaye weefwe? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olababoolela mbu OMWAMI aboola mbu Shichila abakuuka beenywe bandekha, nibalonda khubanyasaye bandi, nibabakhalabanila, nibabeenamila, nibandekha, nibarahulila amalako kanje ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata inywe mwakholile obubii okhushila abakuuka beenywe; okhuba lole, muchendanga buli mundu mubutinyu bwomwoyokwe omubii, nimukhaya okhumbulila; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.12",
            "verseOrgIds": [
              "JER.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila ndalamukhuyungal okhurula mushialo shino, okhuula khushialo eshia muramanyile ta, kata inywe kata abakuuka beenywe; ne mushieneshio mulakhalabanilanga abanyasaye bandi eshiteere neshilo; okhuba shindalamukoosia obukoosia ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.13",
            "verseOrgIds": [
              "JER.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.13",
            "verseOrgIds": [
              "JER.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Khulwako, lole, tsindaalo tsiitsanga olwa shikalasungungwa khandi mbu Shinga OMWAMI olwa ali mwoyo, owatikulusia abaana baIsiraeli nabarusia mushialo shiaMisiri, ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula mbu Shinga OMWAMI olwa ali mwoyo, owatikulusia abaana baIsiraeli nabarusia mushualo shienotsi, nokhurula mubialo biosi ewa yali nabeelusiliyeyo; ne ndalabakalusia mushialo shiabwe eshia ndaheelesia abakuuka babwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Lole, ndalarumana abanaabi abanji, nabo balabanaaba; mana olunyumakhwo ndalarumana abayiitsi abanji, nabo balabayiima nibabarusia mubuli lukulu, nomubuli shikulu, nomumeena akomunyanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.16",
            "verseOrgIds": [
              "JER.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba tsimoni tsianje tsili khunjila tsiabwe tsiosi; shibabisikha mumoni tsianje, kata obumayaanu bwabwe shibufwimbwa mumoni tsianje ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.17",
            "verseOrgIds": [
              "JER.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwambeli ndalabarunga obumayaanu bwabwe nobwonooni bwabwe shikhabili; shichila boonooniye eshialo shianje nemilambo chiebisinyo biabwe, nibeetsusia obulaame bwanje ebindu biabwe ebiemisilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.18",
            "verseOrgIds": [
              "JER.16.18"
            ]
          }
        }
      ]
    },
    {
