              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, lola, ndalachila nibamanya; mbu luno lulala ndalachila nibamanya omukhono kwanje nende obunyali bwanje; kho balamanya mbu Yahweh nilio eliira lianje.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
