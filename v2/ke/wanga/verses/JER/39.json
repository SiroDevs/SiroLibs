    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhukwa khwaYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwashienda kwaZedekia omuruchi waYuda, mumwesi kwekhumi, Nebukhadineza omuruchi waBabeli nelihelie liosi nibeetsa okhuseera Yerusalemu, nibaliikalila; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.1",
            "verseOrgIds": [
              "JER.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mumuyika kwekhumi nalulala kwaZedekia, mumwesi kwakhane nikuli shienda, bakhupa eshibanga mulukoba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.2",
            "verseOrgIds": [
              "JER.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Yerusalemu yali niyibukuulwe, abakhulundu bosi bomuruchi waBabeli nibeenjila, nibeekhala hashilibwa shiahakari; mbabano, mbu Neribali-sharezeri Samugari-nebo, Sarisekhumu omurabusarisi, naNerigalisharezeri omurabumagi, halala na-bandi bosi abokhubakhulundu bomuruchi waBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Zedekia omuruchi waYuda nende abaseeri bosi babalola, kho beelukha, nibarula mwitookho mushilo, nibalonda khunjila yomukunda kwomuruchi, mushilibwa eshiali hakari wetsingoba tsibili; narula natsia enaAraba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.4",
            "verseOrgIds": [
              "JER.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa lihe liabaKalidayo liabalondachilila, nilimunyoolelesia Zedekia mumihololookhwe chieYeriko; nolwa bali nibamuhambile, bamutikulusia nibamuyila ewaNebukhadineza omuruchi waBabeli eRibila, mushialo shiaHamatsi; naye namukhalachila eshiina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.5",
            "verseOrgIds": [
              "JER.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi waBabeli niyeera abaana baZedekia imbeli wetsimonitsie; khandi omuruchi waBabeli niyeera abamakuru bosi baYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.6",
            "verseOrgIds": [
              "JER.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yamufutula Zedekia tsimoni, namuboha nebitiili okhumuyila eBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.7",
            "verseOrgIds": [
              "JER.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaKalidayo nibasamba inzu yomuruchi netsinzu tsiabandu nomulilo, nibalikulula olukoba lwosi IweYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.8",
            "verseOrgIds": [
              "JER.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nebuzaradani omwimilisi wabasikari abalindi yaara omusikalo kwabandu okwali nikushitong'a mwitookho nabayila eBabeli, halala nabahunzushi abahunzukha nibeeyunga khuye, nomusikalo kwabandu okwali nikushitong'a. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.9",
            "verseOrgIds": [
              "JER.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Nebuzaradani omwimilisi wabasikari abalindi yalekhayo abandi abokhubamanani mushialo shiaYuda, abo ababula eshindu, nabaheelesia emikunda chiemitsabibu nemikunda chindi mundaalo etsio.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nebukhadineza yalinda Yeremia namukholela amalayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Nebukhadineza omuruchi waBabeli yalachilisia Nebuzaradani omwimilisi wabasikari abalindi khumakhuwa kaYeremia, ari ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.11",
            "verseOrgIds": [
              "JER.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubukule, omulinde bulayi, ne oramukholela libii liosi ta; habula mbu omukholelenje shinga omwene olwa alakhusunjilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Nebuzaradani omwimilisi wabasikari abalindi naNebushazibani omurabusarisi, naNerigalisharezeri omurabumagi, nabakofu abakhulundu bomuruchi waBabeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "baruma abandu niba-yinia Yeremia mulwanyi lwabasikari abalindi, nibamuhaana mumukhono kwaGedalia waAhikamu waShafani, mbu amuyile ewuwe. Kho yamenya ario mubandu abo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
            "verseOrgIds": [
              "JER.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebedi-melekhiyasuubisibwa mbu alalindwa shisale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
            "verseOrgIds": [
              "JER.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho likhuwa liOMWAMI liamwitsila Yeremia olwa yali niyeekalilwa mulwanyi lwabasikari abalindi, liri ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.15",
            "verseOrgIds": [
              "JER.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsia osunjile Ebedimelekhu omuEtiopia ori Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola, mbu Lola, ndaloosia amakhuwa kanje khwitookho lino okhubakhupia khushibii, ne okhuleera amalayi ta; ne kaloosibwa imbeliwo khunduukho eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.16",
            "verseOrgIds": [
              "JER.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalakhuhonia iwe khunduukho eyo, OMWAMI aboola; kata shiolahaanwa mumakhono kabandu abo aba oriitsanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.17",
            "verseOrgIds": [
              "JER.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba okhuhonia ndalakhuhonia, kata shiolakwa khulwa olukanga ta; ne obulamubwo bulaba eshiyaayoshio; shichila wayandisiichilenje; nilwo olwa OMWAMI ahoola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.18",
            "verseOrgIds": [
              "JER.39.18"
            ]
          }
        }
      ]
    }
  ],
