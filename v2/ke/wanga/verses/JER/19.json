          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yeremia narula eTofetsi, ewa OMWAMI yali namurumile okhurumbula amakhuwake; nasinjila mulwanyi Iweinzu yOMWAMI, nasunjila abandu bosi ari ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Lole, ndalaleera khwitookho lino nokhumataala kalio kosi, amabii ako kosi aka ndarumbula khulio; shichila boomia amakosi, mbu baleshe okhuhulila amakhuwa kanje.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        }
      ]
