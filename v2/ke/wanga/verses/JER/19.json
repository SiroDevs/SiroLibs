          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olaaraka isiongo tsana, abandu aba otsia ninabo nibalola, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nobasunjila mbu Kano niko aka OMWAMI omwane mahe aboola; mbu Nolwa ndalaara abandu bano nelitookho lino, shinga omundu olwa yaara isiongo yomulonji, eyiranyala okhukasibwa khandi ta. Balayabilanga abafu muTofetsi, shichila habundu undi halabulaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Nolwa ndalakholela habundu hano, nabamenyangamwo, ningwisia litookho lino okhufwana shinga Tofetsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata tsinzu tsieYerusalemu, netsinzu tsiabaruchi baYuda, etsioonoonekha, tsilaba shinga habundu hano haTofetsi; mbu tsinzu tsiosi etsia basambilanga amalesi kelibuuliesi khubilama biatsio khulihe liosi liomwikulu, nibatsushila emisango chiokhutsushila khubanyasaye bandi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        }
      ]
    },
    {
