              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olabasunjila mbu Lino nilio lihanga elirahulila omwoyo kwOMWAMI Nyasaye wabwe, kata elirachesiha ta; obwatoto busishile; bukhaliishe muminwa chiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        }
