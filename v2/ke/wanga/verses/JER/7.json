    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kasia tsinjila tsieenywe nende ebikkole bieenywe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elieetsela Yeremia okhurula khuMWAMI ndielino; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sinjila mushilibwa shieinzu yOMWAMI, norumbulilayo likhuwa lino, ori Hulile likhuwa liOMWAMI, inywe mwesi baYuda abeenjilanga mubilibwa bino okhwinamila OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI omwene mahe Nyasaye waIsiraeli, aboola; mbu Kasie tsinjila tsieenywe nende ebikhole bieenywe, mana ndalamumenyia habundu hano. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murasuubilila amakhuwa kobubeeyi, mbu Yino neihekalu yOMWAMI, ihekalu yOMWAMI, ihekalu yOMWAMI, ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila nimuba nimukasilia elala tsinjila tsieenywe nebikhole bieenywe; nimuba nimukhalachilanga habwene amakhuwa hakari womundu nowashie; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.5",
            "verseOrgIds": [
              "JER.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimuba nimuramiinanga abarende, nabaana ababisandu, nabakhasi abalekhwa, kata okhwebeenia amabanga kababula eshikha habundu hano, kata okhulonda khubanyasaye bandi nimwichemela abeene amabii, ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.6",
            "verseOrgIds": [
              "JER.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho ndalamumenyia habundu hano, mushialo eshia ndaheelesia abakuuka beenywe, okhurula khale neinziayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.7",
            "verseOrgIds": [
              "JER.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.7",
            "verseOrgIds": [
              "JER.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, musuubililanga amakhuwa kobubeeyi; ne kabulamwo obukhoonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.8",
            "verseOrgIds": [
              "JER.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mwitsa okhwiba, nokhwira, nokhuheya, nokhwitsuba akobubeeyi, nokhusambila Baali amalesi kelibuuliesi, nokhulonda khubanyasaye bandi aba muramanya khale ta, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.9",
            "verseOrgIds": [
              "JER.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana nimwitsa okhusinjila imbeli wanje munzu yino, eyilangwa khuliira lianje, nimusunga mbu Khuhonile; mana nimushikholanoa akebismyo bino biosi, noho? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.10",
            "verseOrgIds": [
              "JER.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzu yino eyilangwa khuliira lianje yikhakwile imbinga yabanuuli mumoni tsieenywe noho? Lole, isie omwene engaluutsi; nilwo olwa OMWAMI aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutsie bulaano, mutsie habundu wanje ahalinji eShiilo, ewa ndamenyinjia eliira lianje olwambeli, mulole shinga olwa ndahakholela khulwa obubii bwabandu banje Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.12",
            "verseOrgIds": [
              "JER.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Ne bulaano, okhuba mwakholile ako kosi, nasi nimuboolelanga, nimboolanga khale ninumilila okhuboola, nebutswa nimurahulilakhwo ta; nimulanga, nebutswa nimurafuchila ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila ndalakholela inzu eyilangwa khuliira lianje, eya mwisiikanga, nende habundu tsana aha ndamuheelesia inywe nabakuuka beenywe, shinga olwa ndakholela Shiilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.14",
            "verseOrgIds": [
              "JER.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalamusukuna murule mumoni tsianje, shinga olwa ndasukuna abaana beenywe, mbu olwibulo lwosi lwaEfuraimu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburima bwaNyasaye khubwinamili bwabanyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, orasabila abandu bano, kata okhuchinga omwoyo kata lisaayo khulwabo, kata okhubalaamila ewanje ta, okhuba shindalakhuhulila tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.16",
            "verseOrgIds": [
              "JER.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shioluutsi aka bakholelanga mumataala kaYuda nomumihanda chieYerusalemu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.17",
            "verseOrgIds": [
              "JER.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana bareenya tsikhwi, basamwana babwana omulilo, abakhasi nabo nibanyooba eshinokho, okhuteeshela omuruchi weshikhasi owelikulu emikaate, nokhutsushila abanyasaye bandi emisango chiokhutsushila, okhunyasia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.18",
            "verseOrgIds": [
              "JER.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI areeba mbu Kho nisie owa banyasinjia noho? Shibeenyasia abeene, nibeehambia tsisoni bario? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, kano niko aka Omwami NYASAYE aboola; mbu Lole, oburima bwanje nobululu bwanje bulasundulilwa habundu hano; khubandu, khumiruko, khumisaala echiomubulimo, nokhubiamo bieliloba; bulaakha nibulasimikha ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaYuda bakuumwa khulwa induliyabwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI omwene mahe, Nyasaye walsiraeli, aboola; mbu Mutasekhwo emisango chieenywe emisambe khumisango chindi, mulie inyama yachio. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shindaboolela abakuuka beenywe kata okhubalaka, khunyanga eyo olwa ndabarusia mushialo shiaMisiri, khumakhuwa kemisango emisambe kata emisango chindi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.22",
            "verseOrgIds": [
              "JER.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula lino nilio elia ndabalaka; mbu Hulilenje omwoyo kwanje, nasi ndalabeetsanga Nyasaye weenywe, neenyu mulabeetsanga abandu banje; muchendenje khunjila yosi eya emulaka, mana mukaasenje. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shibahulila kata okhureka amarwi ta; habula bachenda mubuchesihanii bwabwe abeene, nomubutinyu bwemioyo chiabwe emibii, nibakalukha inyuma, oburatsiililila imbeli ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.24",
            "verseOrgIds": [
              "JER.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhurula khunyanga eyo olwa abakuuka beenywe barula mushialo shiaMisiri okhuula olwa leelo, ndamurumilenje abasumba banje bosi abanabii, nimbarumanga khale nilumilila khatsotselo okhubaruma; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.25",
            "verseOrgIds": [
              "JER.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa shibayambulila kata okhureka amarwi ta, ne boomia amakosi; bakhola obubii okhushila abakuuka babwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, olababoolela amakhuwa kano kosi; nebutswa shibalakhurechela amarwi ta; khandi olabalanga, nebutswa shibalafuchila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
            "verseOrgIds": [
              "JER.7.27"
