          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Okhuba abaana baYuda bakholile akali amabii mumoni tsianje; barenjeeshe ebisinyo biabwe munzu eyilangwa khuliira lianje okhushionoonia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boombashile habundu heechingu hosi haTofetsi, eyili mwibanda liomwana waHinomu, okhubisia abaana babwe abasiani nabakhaana mumulilo; ako shindalakakhwo, kata shikeenjila mumapaaro kanje ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI asunga mbu khulwako, lola, tsindaalo tsiitsanga olwa lirakhalangwe mbu Tofetsi, kata Libanda liomwana waHinomu, khandi ta, habula Libanda liObwiri; okhuba balayabilanga muTofetsi, shichila habundu undi halabulaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emilambo chiabandu bano nachio chilakwa ebiliibwa biamanyonyi akomwikulu nende tsisolo etsiomushialo; kata shialibaho outsiilusia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ndalaakamia mumataala kaYuda nomumihanda chieYerusalemu omwoyo kwokhwikhoya nomwoyo kwobutsatsahaafu, omwoyo kwomwene shiselelo nomwoyo kwomweha; okhuba eshialo shilakwa eshikhaya.",
          "type": "text",
