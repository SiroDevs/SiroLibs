    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaZedeha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekia yali owemiyika amakhumi kabili namulala olwa yachaaka okhuruka; naruchila eYerusalemu emiyika ekhumi namulala; ne eliira lianyina liali Hamutali waYeremia oweLibina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI, kosi aka Yehoyakimu yakhola shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khulwa oburima bwOMWAMI, amakhuwa kamala keekhole muYerusalemu nende Yuda mbu yabasukuna barule imbeliwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhukwa khwaYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Zedekia yakholela omuruchi waBabeli induli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumuyika kwashienda kwoburuchibwe, mumwesi kwekhumi khunyanga yekhumi eyomumwesi okwo, Nebukhadineza omuruchi waBabeli niyeetsa halala nelihelie liosi okhuseera Yerusalemu, nibakhupa ikambi yabwe imbeli walio; nibaswala ebituuli okhulifumbila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho litookho lieekalilwa lirio okhuula khumuyika kwekhumi nalulala kwomuruchi Zedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.5",
            "verseOrgIds": [
              "JER.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yashienda eyomumwesi kwakhane inzala yali ikhongo muno mwitookho; kata shishialiho eshiokhulia shiosi khulwa abeshialo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.6",
            "verseOrgIds": [
              "JER.52.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana eshibanga shieekulwa mwitookho, nabo abandu belihe bosi nibeelukha, nibarula mwitookho mushilo, nibalonda mushilibwa. Eshiali hakari wetsingoba tsibili, ahambi nolwanyi lwomuruchi; ne abaKalidayo bali nibafumbiile litookho; nibalonda khunjila yaAraba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa lihe liabaKalidayo lialondachila omuruchi Zedekia, nibamunyoola khumihololookhwe chieYeriko; lihelie liosi nilisalaasibwa nilimulekha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.8",
            "verseOrgIds": [
              "JER.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibamuhamba omuruchi, nibamuyila ewa omuruchi waBabeli yali eRibila, mushialo shiaHamatsi; naye namukhalachila eshiina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi waBabeli niyeera abaana baZedekia, omwene nalola; niyeerela nende abakhulundu bosi baYuda eRibila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.10",
            "verseOrgIds": [
              "JER.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namufutula Zedekia tsimoni; omuruchi waBabeli namuboha nebitiili, namuyila eBabeli, namura mucheela okhuula khunyanga yokhufwakhwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaYuda bayilwa mubuhambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumwesi kwakharaano, khunyanga yekhumi mumwesi, mumuyika kwekhumi nashienda kwomuruchi Nebukhadineza, omuruchi waBabeli, Nebuzaradani omwimilisi wabasikari abalindi, owakhalabanilanga omuruchi waBabeli, niyoola eYerusalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.12",
            "verseOrgIds": [
              "JER.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasamba inzu yOMWAMI, nende inzu yomuruchi; kata tsinzu tsiosi tsieYerusalemu, tsiosi etsiali tsikhongo, yatsisamba nomulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bosi abelihe liabaKalidayo aba omwimilisi wabasikari abalindi yali ninabo, balikulula olukoba lwosi lwaYerusalemu tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nebuzaradani omwimilisi wabasikari abalindi yahamba abokhubashila obumanani mushialo, nomusikalo kwabandu abali nibatong'ile mwitookho, nende abo abahunzukha nibeelushila ewomuruchi waBabeli, halala nende abomukanda abatong'a, nabayila mumbohe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Nebuzaradani omwimilisi wabasikari abalindi tsana yalekha abandi abokhubashila obumanani mushialo, okhulinda emitsabibu nokhulima emikunda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 52:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsisiilo tsana tsiomukasa etsiali nitsili munzu yOMWAMI, nende obwala, neinyanza yomukasa, ebiali nibili munzu yOMWAMI, abaKalidayo babisasaaka ebitonye ebitonye, nibayila omukasa kwabio kwosi eBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nende tsinyungu, nemiikho, namahana akokhusimilia omulilo, nebikaye, nebichiiko, nebimanulwa biosi biomukasa ebia beekhoonyelanga mubukhalabani, babiyila biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebikombe, netsindaabo tsiomulilo, nebikaye, netsinyungu, nebichibi bietsitaha, nemiendo, norubakuli; buli shindu eshiali shieitsahaabu, yabukula khulwa itsahaabu yashio; ne buli shindu eshiali shieifeetsa, yabukula khulwa ifeetsa yashio; omwimilisi wabasikari abalindi yabiyila biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio tsisiilo etsio tsibili, neinyanza ndala, netsing'ombe tsiomukasa ekhumi natsibili etsiali hasi weinyanza tsana, nobwala, ebia omuruchi Sulemani yakholela inzu yOMWAMI, obusiro bwomukasa kebimanulwa ebio biosi shibwachelekha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsio tsisiilo oburambi bwabuli siilo bwali amakhono ekhumi namunaane; nomukoye kwamakhono ekhumi nakabili kwahela okhubotokhana ndala; obukhomefu bwayo bwahela tsinzala tsine; ne mukari mwayo mwal i omukhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 52:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yalikhwo ingofia yomukasa; noburambi bweingofia bwali amakhono karaano; ingofia niyilikhwo eming'oono chietsikhanda namakomamanga tsimbeka tsiosi, chiosi nichili echiomukasa; nayo isiilo yakhabili niyili nende ebifwana birio, namakomamanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaliho amakomamanga amakhumi shienda nakasasaba elubeka eyi nende eyi; amakomamanga kosi akali khuming'oono chietsikhanda tsimbeka tsiosi kali eshikhumi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 52:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwimilisi wabasikari abalindi yabukula Seraya omukuhani omukhulundu nende Zefania omukuhani wakhabili, nende abalindi bomuliango bataru; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana okhurula mwitookho yabukula omukali omulate undi owali nasinjililanga abandu belihe, nende abandu musaafu beshiina shiomuruchi abanyoolwa nibali mwitookho; nende omuhandiichi womuseesia welihe owakhung'aasinjia abeshialo; nende abandi amakhumi kasasaba abokhubandu beshialo abanyoolwa nibali mwitookho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani omwimilisi wabasikari abalindi nabahamba, nabayila ewomuruchi waBabeli eRibila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi waBabeli nababukula, nabeerela eRibila mushialo shiaHamatsi. Nilwo olwa Yuda yaatisibwa mushialoshie nayilwa mubuhambe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
