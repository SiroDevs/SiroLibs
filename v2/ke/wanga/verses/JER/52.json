              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno nibwo obunji bwabandu aba Nebukhadineza yaara nabayila; mbu mumuyika kwomusaafu abaYahudi ebikhumila bitaru amakhumi kabili nabataru; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumuyika kwekhumi namunaane kwaNebukhadineza, yaara abandu ebikhumi munaane amakhumi kataru nababili nabarusia eYerusalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumuyika kwamakhumi kabili nakhataru kwaNebukhadineza, Nebuzaradani omwimilisi wabasikari abalindi yaara abokhubaYahudi abandu ebikhumi musaafu amakhumi kane nabaraano, nabayila; abandu abo bosi nibaba ebikhumila bine nende ebikhumi bisasaba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
