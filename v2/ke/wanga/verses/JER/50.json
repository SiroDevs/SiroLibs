      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elia OMWAMI yaboola khukaBabeli, khukeshialo shiabaKalidayo, mumunwa kwaYeremia omunabii, ndielino; mbu",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.1",
            "verseOrgIds": [
              "JER.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba okhurula enotsi lihanga liitsa okhumuseera, elilakwisia eshialoshie likunda, kata omundu yesi shialamenyamwo ta; abandu baleelukha nibahwaho nemiruko chiosi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.3",
            "verseOrgIds": [
              "JER.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.3",
            "verseOrgIds": [
              "JER.50.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio, nomushise eshio, OMWAMI aboola, abaana baIsiraeli baleetsa, bo halala nabaana baYuda, balatsia khunjila yabwe nibalila, nibakhaaba OMWAMI Nyasaye wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.4",
            "verseOrgIds": [
              "JER.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balareeba akeinjila yeSayuni nibachoomiyeyo tsimoni tsiabwe, bari Chende khuungane khuMwami neindakano eyirahwaho ta, elireebililwa inziayo ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.5",
            "verseOrgIds": [
              "JER.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.5",
            "verseOrgIds": [
              "JER.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu banje babeelenje amakondi akakora; abaayi babwe babashiamia nibababerusia mubikulu; barula khulukulu luno nibatsia khushilulu shilia; beebilila ikhonje yabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.6",
            "verseOrgIds": [
              "JER.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosi ababa-nyoola babaliitsanga; kata abasuku babwe baboola mbu Ifwe khubula eshikha, shichila bamwonoonela OMWAMI, eshimenyo shiatoto; niye OMWAMI, obunaayilo bwabakuuka babwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.7",
            "verseOrgIds": [
              "JER.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.7",
            "verseOrgIds": [
              "JER.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilushe murule hakari weBabeli, rule mushialo shiabaKalidayo, mube shinga tsikhole etsiimilila ebiayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.8",
            "verseOrgIds": [
              "JER.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lole, ndalayakula omukhung'aano kwamahanga amakhongo keshialo shienotsi, nimbatikulusia nimbaleera okhuseera Babeli; nabo baleerenjekha imbeliwe; nokhurula yaho alabukulwa; ebisele biabwe bilaba shinga ebiomululu omusitsa, ourakalukha amakhono amakhaya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.9",
            "verseOrgIds": [
              "JER.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalidayo shilakwa eshiyaayo; abo bosi abashiyaaya baleekura, OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.10",
            "verseOrgIds": [
              "JER.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.16",
            "verseOrgIds": [
              "JER.50.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli nelikondi eliokhukasalaanile, elia tsitalanyi tsiilusiye; olwambeli omuruchi waAshuru yamulia, nolunyumakhwo Nebukhadineza uno omuruchi waBabeli yamurabula amakumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.17",
            "verseOrgIds": [
              "JER.50.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako kano niko aka OMWAMI omwene mahe, omuruchi waIsiraeli, aboola; mbu Lole, ndalakuuma omuruchi waBabeli nende eshialoshie, shinga olwa ndakuuma omuruchi waAshuru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.18",
            "verseOrgIds": [
              "JER.50.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalakalusia Isiraeli mubwayilobwe, naye alaayilanga eKarameli neBashani; okhwenyakhwe khuleekusibwa khubikulu biaEfuraimu nomuGileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.19",
            "verseOrgIds": [
              "JER.50.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio, nomushise eshio, OMWAMI aboola, obumayaanu bwaIsiraeli bulakhaabwa, ne bulaba nibubulaho; kata nende ebionoono biaYuda, nibiranyoolekhakhwo ta; okhuba ndalabaleshela abo aba ndalalekha babe omusikalo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.20",
            "verseOrgIds": [
              "JER.50.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 50:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.27",
            "verseOrgIds": [
              "JER.50.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 50:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hulile! Oluyoka lwa abo abeelukha nibeehonokokha nibarula mushialo shiaBabeli, okhurumbula muSayuni akeshikwoli shiOMWAMI Nyasaye weefwe, mbu eshikwoli khulwa ihekaluye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.28",
            "verseOrgIds": [
              "JER.50.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 50:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.28",
            "verseOrgIds": [
              "JER.50.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 50:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lanje abalasi bobuyingo okhuseera Babeli, abo bosi abafumba obuyingo; mukhome ikambi okhumufumbila; omundu yesi owamwo aleshe okhwihonokokha; mumurunje ebikholebie shinga olwa bili; kosi aka yakholeele shinga olwa kali, mumukholele murio; okhuba yayeechinjimisiye nafukula OMWAMI, Omutakatifu waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.29",
            "verseOrgIds": [
              "JER.50.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila abasooliilibe balakwa mumihanda, abasaatsa belihe bosi nibaholelesilibwa mukhufwa inyanga eyo, OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
              "JER.50.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 50:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.32",
            "verseOrgIds": [
              "JER.50.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 50:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI omwene mahe aboola; mbu Abaana baIsiraeli nabaana baYuda bamiinungwa bosi halala; nabo bosi ababahamba babatiila butinyu; bakhaya okhubalekhuula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.33",
            "verseOrgIds": [
              "JER.50.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 50:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omununuli wabwe nowamaani; OMWAMI omwene mahe nilio eliiralie alafunaanila elala amakhuwa kabwe, mbu aheeiesie eshialo obuhuluushi, nobukoyaani khubamenyanga eBabeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.34",
            "verseOrgIds": [
              "JER.50.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 50:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.38",
            "verseOrgIds": [
              "JER.50.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 50:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila tsisolo etsiomushitsiimi nende amabwe kalamenyayo, amahuto nako nikamenyamwo; ne shishilaba nende abandu abamenyamwo khandi inziayo ta; kata shishilamenyangwamwo ebisoni nebisoni ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.39",
            "verseOrgIds": [
              "JER.50.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 50:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga olwa kali olwa Nyasaye yakwisia Sodomu naGomora, namataala akarondokhana ninabo, OMWAMI aboola, nindio omundu yesi shialamenyayo, kata omwana womundu okhuchenihamwo ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.40",
            "verseOrgIds": [
              "JER.50.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 50:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.43",
            "verseOrgIds": [
              "JER.50.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 50:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, atikulukha shinga italanyi eyirula mubitsakha bieYorodani khushimenyo eshirahwaho ta; okhuba ndalabeelusia meetsukhana bamurulekhwo; ne owa ndalalobola niye owa ndaleemekha khuye; okhuba ali heena oufwanana ninasi? Ali heena oundaka isie inyanga? Ali heena omwayi owakheema imbeli wanje? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.44",
            "verseOrgIds": [
              "JER.50.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JER 50:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, hulile obuchesiyii bwOMWAMI, obwa yakasiye khuBabeli, nende tsiyemitsie etsia yakasiye khushialo shiabaKalidayo, mbu Kata abatuutu abomubiayo balaknweswa nibarusibwayo; toto mwene, kata eshimenyo shiabwe shilariisibwa khulwabo. ",
          "type": "text",
          "attrs": {
