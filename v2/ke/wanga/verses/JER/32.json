    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremia yakula omukunda eAnatsotsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elieetsela Yeremia okhurula khuMWAMI mumuyika kwekhumi kwaZedekia omuruchi waYuda, ne nikwo omuyika kwekhumi namunaane kwaNebukhadineza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.1",
            "verseOrgIds": [
              "JER.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio lihe liomuruchi waBabeli liali niliikaliile Yerusalemu; naye Yeremia omunabii yali niyeekalilwa mulwanyi lwabalindi, olwali munzu yomuruchi waYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.2",
            "verseOrgIds": [
              "JER.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Zedekia omuruchi waYuda yali niyamwikaliile, naboola mbu Nishiina eshichila norumbulanga amakhuwa noboola mbu Kano niko aka OMWAMI aboola; mbu Lola, ndalahaana litookho lino mumukhono kwomuruchi waBabeli, naye alalibukula; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.3",
            "verseOrgIds": [
              "JER.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Zedekia omuruchi waYuda shialeehonokokha mumakhono kabaKalidayo ta; ne shialachweya okhuhaanwa mumukhono kwomuruchi waBabeli, nokhusungana ninaye omunwa khumunwa, nokhulolana ninaye tsimoni khumoni, tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.4",
            "verseOrgIds": [
              "JER.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye alayila Zedekia eBabeli, na alabayo okhuula olwa ndalamukoonya, OMWAMI aboola; mbu kata nimuseerana nabaKalidayo, shimulanyala ta?",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.5",
            "verseOrgIds": [
              "JER.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.5",
            "verseOrgIds": [
              "JER.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yeremia nakalusia mbu Likhuwa liOMWAMI lianzitsila; liri ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.6",
            "verseOrgIds": [
              "JER.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, Hanameli waShalumu so alakhwitsila nasunga ari Okule omukunda kwanje okuli eAnatsotsi; okhuba obununuli nobubwo, mbu okukule. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.7",
            "verseOrgIds": [
              "JER.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hanameli omwana weefwe niyeetsa, nindi mulwanyi lwabalindi, likhuwa liOMWAMI shinga olwa libeele; niyasunjila mbu Chama okule omukunda kwanje okuli eAnatsotsi, mushialo shiaBenyamini; okhuba obulaame nobubwo, khandi obununuIi nobubwo; wikulile omwene. Kho nimanya mbu lino nelikhuwa liOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.8",
            "verseOrgIds": [
              "JER.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.8",
            "verseOrgIds": [
              "JER.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ndakula omukunda okwo okwali eAnatsotsi nende Hanameli omwana weefwe, nimuchelela amapeesa, mbu tsishekeli ekhumi namusaafu tsieifeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.9",
            "verseOrgIds": [
              "JER.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nira iseeyi khubarwa yobukusii, ninzikala neshibalikho, nilanga abaloli, nimuchelela amapeesa khuratili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.10",
            "verseOrgIds": [
              "JER.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimbukula ibarwa yobukusii, eyeneyo eyeekalwa neshibalikho, eyiinoosia amakhuwa kosi kobukusii, nende ikopi yindi eyirayeekalwa ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.11",
            "verseOrgIds": [
              "JER.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nihaana ibarwa tsana yobukusii mumukhono kwaBarukhu waNeria waMaseya, Hanameli omwana weefwe naliho, nabaloli beene abara iseeyi khubarwa yobukusii bosi nibaliho, imbeli wabaYahudi bosi abeekhala mulwanyi lwabalindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.12",
            "verseOrgIds": [
              "JER.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimulachilisia Barukhu imbeli wabwe, mbu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.13",
            "verseOrgIds": [
              "JER.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Bukula tsibarwa tsino, mbu ibarwa yobukusii, eyeneyo eyeekalwa neshibalikho, nende ibarwa yino eyirayeekalwa ta, otsibiishe munyungu, mbu tsimenye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.14",
            "verseOrgIds": [
              "JER.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu tsinzu, nemikunda, nemikunda chiemitsabibu, bilakusibungwa khandi mushialo shino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa ndali nimuheelesiye Barukhu waNeria ibarwa tsana yobukusii, ndamusaaya OMWAMI, mbu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.16",
            "verseOrgIds": [
              "JER.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E OMWAMI Nyasaye! Lola, niwe owalonga likulu nende eshialo khulwa obunyalibwo obunji nomukhonokwo okunyiililwe. Libulaho litinyu liosi elikhukhaya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.17",
            "verseOrgIds": [
              "JER.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwe oulolosinjia obuheeli oburalilu khubandu ebikhumila, ne norunga obumayaanu bwabasamwana khubaana babwe munyuma wabwe; iwe omukhongo, Nyasaye wamaani, owa eliiralio niOMWAMI omwene mahe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.18",
            "verseOrgIds": [
              "JER.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli omukhongo mutsiyemitsio, nowamaani mubikholebio; tsimonitsio tsili khunjila tsiosi tsiabaana babandu, nokalusilinjia buli mundu akakhoyeele tsinjilatsie, nakakhoyeele ebiamo biebikholebie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.19",
            "verseOrgIds": [
              "JER.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walolosia ebilolelo nebiamakana mushibala shiaMisiri okhuula khunyanga yino, kata muIsiraeli kata mubandu bosi; niwikholela eliira shinga olwa lili kata bulaano. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.20",
            "verseOrgIds": [
              "JER.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warusia abandubo Isiraeli mushibala shiaMisiri nende ebilolelo, nebiamakana, nomukhono kwamaani, nomukhono okunyiililwe, nende oburisii obukhongo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.21",
            "verseOrgIds": [
              "JER.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nobaheelesia eshialo shino eshia weetsubila abakuuka babwe mbu wakhabaheelesia, eshialo eshiyembangamwo amabeele nende obuushi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.22",
            "verseOrgIds": [
              "JER.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo nibeenjilamwo nibahilia. Nebutswa shibahulila omwoyokwo, kata shibachendela mumeebaaloko ta, kata okhukhola likhuwa liosi liosi khukeenako kosi aka wabalaka okhukholanga; ne niko akachilile nobakhupia khushibii shino shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.23",
            "verseOrgIds": [
              "JER.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, ebituuli ebia abeekalili babunjikha biulile khwitookho, okhulibukula, litookho limalile okhuhaanwa mumakhono kabaKalidayo abaliseeranga, khulwa olukanga neinzala noluumbe. Aka waboola kamalile nikeekhola; nawe, lola, oluutsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.24",
            "verseOrgIds": [
              "JER.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, OMWAMI Nyasaye, wamboolela mbu Kula omukunda amapeesa, nolanga abaloli; ne khane litookho limalile okhuhaanwa mumakhono kabaKalidayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana likhuwa liOMWAMI nilimwitsila Yeremia, liri ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.26",
            "verseOrgIds": [
              "JER.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, isie nisie OMWAMI, Nyasaye wabandu bosi; liliho likhuwa liosi litinyu eliakhakhaya? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.27",
            "verseOrgIds": [
              "JER.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niko akachila kano niko aka OMWAMI aboola; mbu Lola, ndalahaana litookho lino mumakhono kabaKalidayo, nomumukhono kwaNebukhadineza omuruchi waBabeli, naye alalibukula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.28",
            "verseOrgIds": [
              "JER.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaKalidayo abaseera litookho lino baleetsa nibahambia litookho omulilo, nibalisamba, nende tsinzu tsana etsia basambilanga amalesi kelibuuliesi khubilama biatsio khuBaali, nibatsushilayo emisango chiokhutsushila khubanyasaye bandi, okhusinyisia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.29",
            "verseOrgIds": [
              "JER.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abaana baIsiraeli nabaana baYuda bakholelanga akali amabii konyene mumoni tsianje, okhurula khubwana bwabwe; okhuba abaana baIsiraeli basinyisinjia butswa nebikhole biamakhono kabwe, OMWAMI aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.30",
            "verseOrgIds": [
              "JER.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba litookho lino liambeelanga eliokhusinyisia nokhubuusia obululu bwanje okhurula khunyanga olwa baliumbakha okhuula olwa leero; ndakhachirusie mumoni tsianje, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.31",
            "verseOrgIds": [
              "JER.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulwa obubii bwosi bwabaana baIsiraeli nobwabaana baYuda, obwa bakholanga okhusinyisia, bo abeene, nabaruchi babwe, nabakhulundu babwe, nabakuhani babwe, nabanabii babwe, nabandu baYuda, nende abamenyanga muYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.32",
            "verseOrgIds": [
              "JER.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shibashiukhasiliye mumoni ta, habula ikhoono; ne kata okva ndabeechesinjia, nimbeechesia khale nilumilila okhubeechesia, khane shibarechile amarwi okhuhulila obwibaali ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.33",
            "verseOrgIds": [
              "JER.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa barenjekha ebisinyo biabwe munzu eyikulishilwa khuliira lianje, okhuchionoonia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi niboombakha habundu aheechingu haBaali hosi, ahali mwibanda liomwana waHinomu, okhubisilia Molekhu abaana babwe abasiani nabakhaana mumulilo; ne ako shindabalakakhwo, kata shikeenjila mumapaaro kanje ta, mbu bakhakhola likhuwa elo lieshisinyo, nibachila Yuda niyoonoona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, kano niko aka OMWAMI, Nyasaye waIsiraeli, aboola khukelitookho lino, elia muboolangakhwo mbu Liahaanilwe mumukhono kwomuruchi waBabeli, khulwa olukanga, nokhulwa inzala, nokhulwa oluumbe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Lola, ndalabakhung'aasia okhurula mubialo biosi ewa ndabeelusilia muburima bwanje nomubululu bwanje nomukhusinyikha khwanje okhunji; ndalabakalusia hano, nimbamenyiaho shisale; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne balaba abandu banje, nasi ndalaba Nyasaye wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalabaheelesia omwoyo mulala nende injila ndala, mbu bariitsenje obushia nobushia; khulwa amalayi akalaba khubo nokhubaana babwe inyuma wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalalakana ninabo indakano eyirakhwaho ta, mbu shindalashiukhana nimbalekha, oburabakholela amalayi ta; ne ndalachila emioyo chiabwe nichiria; mbu mana baleshe okhurulakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhwikhoya ndaleekhoyanga okhubakholela amalayi; khandi toto mwene ndalabaraaka mushialo shino, nomwoyo kwanie kwosi nende roho yanje Yosi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI aboola; mbu Shinga olwa ndaleereele abandu bano amabii kano amakhongo kosi, nolwa ndalabaleerela amalayi ako kosi aka ndabasuubisia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikunda chilakulungwa mushialo shino eshia musungangakhwo mbu Nelikunda, aharali abandu kata emiruko ta; shiahaanwa mumakhono kabaKalidayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu balakulanga emikunda amapeesa, nibara iseeyi khubarwa tsiobukusii, nibabalikhakhwo eshibalikho, nibalanga abaloli, mushialo shiaBenyamini, nomumbali tsieYerusalemu, nomumataala kaYuda, nomumataala keshialo shiebikulu, nomumataala keShefela, nomumataala kaNegebu; okhuba ndalakalusia tsikhabi tsiabwe; nilwo olwa OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
