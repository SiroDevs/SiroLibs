              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko amahandiiko ketsinzibulo tsiaAdamu. Khunyanga eyo eya Nyasaye yalonjelamwo omundu, khwikondo liaNyasaye nilio eliaya mukholelamwo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "omusaatsa nende omukhasi, nabalonga; nabaheelesia ikhabi, nabakulikha eliira liabwe mbu Adamu, khunyanga eya balonjelwamwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        }
      ]
    },
