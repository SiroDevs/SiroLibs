            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu nayindila emiyika eshikhumi nende amakhumi kataru, niyeebula omwana khwikondo lilie omwene, khukhufwanakhwe; namukulikha eliira mbu Setsi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "netsindaalo tsiaAdamu niyeebuule Setsi chiali emiyika ebikhumi munaane; niyeebula abaana abasiani nende abakhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netsindaalo tsiosi etsia Adamu yayindila tsiahela emiyika ebikhumi shienda nende amakhumi kataru; mana nafwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
      ]
    },
