          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Setsi niyeebuule Enoshi, yayindila emiyika ebikhumi munaane nende musaafu, niyeebula abaana abasiani nende abakhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
