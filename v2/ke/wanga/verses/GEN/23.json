            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nolwa omukunda kwaEferoni kwatinyisibwa, okwali muMakhapela, elubeka Iwebukwe weMamure, mbu omukunda kwene, nende imbinga eyalimwo, nende emisaala chiosi echiali mumukunda, echiali khulwakho tsimbeka tsiosi, biosi biatinyisibwa okhuba ebiaAburahamu imbeli wabaana baHetsi, imbeli wabosi abali nibeenjilanga mushilibwa shielitaalalie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olunyuma lwa ako, Aburahamu yamuyabila Sara omukhasiwe mumbinga yomukunda kwaMakhapela, elubeka Iwebukwe weMamure niyo Heberoni, mushibala shiaKanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.19",
            "verseOrgIds": [
              "GEN.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukunda nakwo, halala nende imbinga eyalimwo, nibitinyisibwa nende abaana baHetsi okhuba ebiaAburahamu, bibe eshianyishie shiebilindwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.20",
            "verseOrgIds": [
              "GEN.23.20"
            ]
          }
        }
      ]
    }
