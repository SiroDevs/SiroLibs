    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho likulu nende eshibala biamalilisibwa nende ebiamwo biosi shinga amahe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.1",
            "verseOrgIds": [
              "GEN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomusaafu Nyasaye yali namalile emilimochie echia yali nakholile, nahuluushila khunyanga yomusaafu khumilimochie chiosi echia yali nakholile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.2",
            "verseOrgIds": [
              "GEN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nachiheelesia ikhabi inyanga yomusaafu, nachiahula; shichila khunyanga yeneyo niyo eya yahuluushilamwo khumilimochie chiosi echia Nyasaye yali nalonjile nende okhukhola.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.3",
            "verseOrgIds": [
              "GEN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.3",
            "verseOrgIds": [
              "GEN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shino nishio eshinoko shielikulu nende shieshibala olwa bialongwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga eya OMWAMI Nyasaye yakholeIamwo eshibala nende likulu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "shiali nishishili okhubakhwo eshimela shiosi eshianabulimo khushibala, kata emiani chiosi echianabulimo chiali nichishili okhumelakhwo tawe; okhuba OMWAMI Nyasaye yali nashili okhukwisia ifula khushibala, kata shiyaliho omundu owokhulima liloba ta; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.5",
            "verseOrgIds": [
              "GEN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne linang'ong'we liabuukha khushialo nilinyisia liloba liosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.6",
            "verseOrgIds": [
              "GEN.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye nalonga omundu olufu lweliloba, nafuuramwo mumooluke emiuyachie chiobulamu, omundu naba omwoyo okuli nobulamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukunda kwaEdeni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye naraaka omukunda enabukwe, eEdeni; ne mubwenomwo naramwo omundu owa yali nalonjile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.8",
            "verseOrgIds": [
              "GEN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye yamesia khwiloba shia omusaala omukaasu okhulolekha khwakwo, khandi omulayi khulwa ebiokhulia; omusaala kwobulamu nakwo khandi hakari mumukunda, nende omusaala kwokhumanya obulayi nende obubii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.9",
            "verseOrgIds": [
              "GEN.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.9",
            "verseOrgIds": [
              "GEN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwalo kwarula muEdeni okhunyisia omukunda; nokhurula yaho kwakabukhana, nikwikhola emiombe chine. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.10",
            "verseOrgIds": [
              "GEN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliira liokwambeli niPishoni; nikwo okwabotokhana eshibala eshilamba shiaHawila, eshilimwo itsahaabu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.11",
            "verseOrgIds": [
              "GEN.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne itsahaabu yeshibala eshio neindayi; yiliho nende ibetolaS nende oruchina rwaonikisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.12",
            "verseOrgIds": [
              "GEN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliira liomuchela kwakhabili niGihoni; nikwo okwabotokhana eshibala eshilamba shiaEtiopia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.13",
            "verseOrgIds": [
              "GEN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neliira liomuchela kwakhataru niHidekela; nikwo okwabira imbeli waAshuru. Nomuchela kwakhane niEufurate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye nabukulu omundu oyo, namura mumukunda kwaEdeni, okhukulima nokhukulinda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.15",
            "verseOrgIds": [
              "GEN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye nalaka omundu oyo ari Khushia omusaala okwomumukunda, olie shinga olwa wenyile; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.16",
            "verseOrgIds": [
              "GEN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khumusaala okwokhumanya obulayi nende obubii, oraliakhwo tawe; shichila khunyanga eya olaliakhwo, okhuula ofwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye naboola ari Shibuli bulayi omundu uno okhuba yenyene ta; ndalamukholela omukhoonyi oumukhoyeele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.18",
            "verseOrgIds": [
              "GEN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhurula mwiloba OMWAMI Nyasaye yakhola shia eshilamu eshiomushitsiimi, nende shia linyonyi eliokhwikulu, naleerela omundu oyo alole shinga olwa yakhabikulikha ameera; mana eliira liosi elia omundu oyo yakulikha shia eshilimwoyo shiosi, lienelo niliba eliira liashio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.19",
            "verseOrgIds": [
              "GEN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo nakulikha tsisolo tsiosi ameera, nende amanyonyi akokhwikulu, nende shia eshilamu eshiomushitsiimi; ne shiyanyoolekhamwo omukhoonyi oumukhoyela Adamu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.20",
            "verseOrgIds": [
              "GEN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye naheelesia Adamu tsindoolo tsinyinji, nitsimuyila; mana nayinia olubafulwe lulala nakalusiaho inyama habundu hatsana; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.21",
            "verseOrgIds": [
              "GEN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolubafu olwa OMWAMI Nyasaye yali nayiniye muAdamu, nalulonga omukhasi, namuleerela Adamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.22",
            "verseOrgIds": [
              "GEN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Adamu naboola ari Uno bulaano nelikumba eliokhumakumba akomubili kwanje, khandi inyama eyokhunyama yomubili kwanje; akulikhwe mbu Omukhasi, shichila yayinibwa mu Omusaatsa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulweshio omusaatsa alalekhanga samwana nende nyina, ahambaane nende omukhasiwe; nabo balabeetsanga omubili mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.24",
            "verseOrgIds": [
              "GEN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bali eshihechenye bombi, Adamu nende omukhasiwe, ne shibalolakhwo tsisoni tawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.25",
            "verseOrgIds": [
              "GEN.2.25"
            ]
          }
        }
      ]
    }
  ],
