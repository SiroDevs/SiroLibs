    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulongwei bweshialo nende obwabandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho khukhuchaaka Nyasaye yalonga likulu nende eshibala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.1",
            "verseOrgIds": [
              "GEN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neshibala shishiali nende obukondo tawe, khandi shiali eshikhaya, eshiilima nashio shialiho hekulu wolusiba; Roho waNyasaye naye nabemba hekulu khumatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya saye naboola ari Obulafu bubeho; kho obulafu nibubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.3",
            "verseOrgIds": [
              "GEN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nalola obulafu, mbu nobulayi; Nyasaye niyaahukhasia obulafu nende eshiilima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.4",
            "verseOrgIds": [
              "GEN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nyasaye yalanga obulafu mbu Eshiteere, khandi eshiilima nashilanga mbu Eshilo. Nikubaho mungoloobe, nikubaho mukamba, inyanga ndala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naboola ari Eshilama eshibambukhu shibeho hakari wamatsi, okhwahukhasia amatsi yaka nende yaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.6",
            "verseOrgIds": [
              "GEN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nakhola eshilama eshibambukhu, niyaahukhasia amatsi akaliho hasi weshilama nende amatsi akaliho hekulu weshilama; nikaba kario. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.7",
            "verseOrgIds": [
              "GEN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nalanga eshilama eshio mbu Likulu. Nikubaho mungoloobe, nikubaho mukamba, inyanga yakhabili.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.8",
            "verseOrgIds": [
              "GEN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.8",
            "verseOrgIds": [
              "GEN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naboola ari Amatsi akali hasi welikulu kakhung'aasibwe halala, habundu ahoomu naho haloleshe; nikaba kario. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.9",
            "verseOrgIds": [
              "GEN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nalanga ahoomu mbu Eshibala; khandi okhukhung'aasibwa khwamatsi yalanga mbu Tsinyanza; Nyasaye nalola mbu nobulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naboola ari Eshibala shimele obunyasi, nemiani echibalusinjia tsimwo, nende shia omusaala kwebiamo okwamanga ebiamo ebieimbia yakwo, ebilimwo imwo yakwo, khushibala; nikaba kario. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.11",
            "verseOrgIds": [
              "GEN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshibala nishimela obunyasi nemiani echibalusinjia tsimwo tsieimbia yachio, nende shia omusaala okwamanga ebiamo, ebilimwo imwo yakwo, ebieimbia yakwo; Nyasaye nalola mbu nobulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.12",
            "verseOrgIds": [
              "GEN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikubaho mungoloobe, nikubaho mukamba, inyanga yakhataru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.13",
            "verseOrgIds": [
              "GEN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.13",
            "verseOrgIds": [
              "GEN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naboola ari Bibeho ebiashilo mushilama eshibambukhu shielikulu okhwahukhasia eshiteere nende eshilo; nabio bibe biebilolelo, ebietsinduukho, khandi ebietsindaalo nende emiyika; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.14",
            "verseOrgIds": [
              "GEN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabibe ebiashilo mushilama eshibambukhu shielikulu okhwashila eshialo; nikaba kario. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.15",
            "verseOrgIds": [
              "GEN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye yakhola ebiashilo ebikali bibili bienebio; eshiashilo eshikhongo okhuruka eshiteere, nende eshiashilo eshituutu okhuruka eshilo, khandi nende tsinyininyini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.16",
            "verseOrgIds": [
              "GEN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nabihaana mushilama eshibambukhu shielikulu mbu biashilenje eshialo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.17",
            "verseOrgIds": [
              "GEN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi nende okhuruka eshiteere nende eshilo, nende okhwahukhasia obulafu nende eshiilima; Nyasaye nalola mbu nobulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.18",
            "verseOrgIds": [
              "GEN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikubaho mungoloobe, nikubaho mukamba, inyanga yakhane.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naboola ari Mumatsi biselaselemwo ebilonje ebili nende obulamu, amanyonyi nako kapulushe ikulu weshibala mushilama eshibambukhu shielikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.20",
            "verseOrgIds": [
              "GEN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nalonga eminyeeni emikhongo, nende ebilimwoyo biosi ebimoolanga ebiselasela mumatsi, shinga olwa tsimbia tsiabio tsili, nende buli linyonyi elili nende tsimbaha, shinga olwa imbia yalio yili; Nyasaye nalola mbu nobulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.21",
            "verseOrgIds": [
              "GEN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nabiheelesia ikhabi, naboola ari Mwibulane nimwinjiha, nimwitsula mumatsi akali munyanza, amanyonyi nako keenjihe khushibala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.22",
            "verseOrgIds": [
              "GEN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikubaho mungoloobe, nikubaho mukamba, inyanga yakharaano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naboola ari Eshibala shirusie shia eshilimwoyo, shinga olwa imbia yashio yili, mbu tsisolo, nende shia eshimoolanga, nende shia eshilamu eshiokhushialo shinga olwa imbia yashio yili; nikaba kario. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.24",
            "verseOrgIds": [
              "GEN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nakhola shia eshilamu eshiokhushialo shinga olwa imbia yashio yili, netsisolo khumbia yatsio, nende shia eshimoolanga khwiloba khumbia yashio; Nyasaye nalola mbu nobulayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.25",
            "verseOrgIds": [
              "GEN.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.25",
            "verseOrgIds": [
              "GEN.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naboola ari Khukhole omundu khwikondo lieefwe, shinga okhufwana khweefwe; khandi baruchenje tsinyeeni etsiomunyanza, nende amanyonyi akokhwikulu, nende tsisolo, nende eshialo shiosi, nende buli shindu eshimoolanga khushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nalonga omundu khwikondo lilie omwene, khwikondo liaNyasaye nilio elia yamulonjelamwo; omusaatsa nende omukhasi yabalonga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nabaheelesia ikhabi; khandi Nyasaye yababoolela ari Mwibulane nimwinjiha, nimwitsula mushibala, nimushihula; khandi muruchenje tsinyeeni etsiomunyanza, nende amanyonyi akokhwikulu, nende buli shilimwoyo shiosi eshichendanga khushibala. ",
          "type": "text",
          "attrs": {
