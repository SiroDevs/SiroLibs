    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwonoonibwa khaDina khwamalilwa eshikwoli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Dina, omukhaaana waYakobo, owa Lea yeebula, yarula natsia okhukoonya abakhaana beshibala eshio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Shekhemu, omwana waHamori omuHiwi, omukhulundu weshibala, yamulola, namubukula, nakona ninaye, namwonoonia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.2",
            "verseOrgIds": [
              "GEN.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoyokwe nikuhanda khuDina omwana waYakobo, namuheela omukhaana oyo, nasungana ninaye amakhuwa amalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.3",
            "verseOrgIds": [
              "GEN.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Shekhemu naboolela Hamori samwana mbu Ukhweele omukhaana uno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.4",
            "verseOrgIds": [
              "GEN.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo nahulila shinga olwa yali namusasiye Dina omwanawe; abasianibe bali nibali nende emirukochie mubwayilo; kho Yakobo naholeela okhuula olwa bali nibacheleele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.5",
            "verseOrgIds": [
              "GEN.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Hamori samwana Shekhemu yarula natsia ewa Yakobo yali, mbu basungana ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.6",
            "verseOrgIds": [
              "GEN.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana baYakobo olwa bahulilakhwo, bachelela nibarula mubwayilo abasaatsa abo nibahuka, oburima nibubahamba; okhuba yali nakholile eshifwabwi muIsiraeli khulwa okhuba nende omukhaana waYakobo; nelikhuwa elo shilikhoyeele ta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Hamori nasungana ninabo, ari Omwoyo kwomwana wanje Shekhemu kwikomba omukhaana weenywe; nimuchamile, mumubashile; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.8",
            "verseOrgIds": [
              "GEN.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi muteeshaninjie nineefwe; mukhubashile abakhaana beenywe, nimukhwa abakhaana beefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.9",
            "verseOrgIds": [
              "GEN.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mulamenya nineefwe; neshibala shino shilabeetsanga shinga shieenywe; mumenyemwo nimukholelamwo obukhala, nimwinyoolela emiandu mwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shekhemu naye nasunjila samwana omukhaana nende abasiani babwe ari Mu'fuchiilile, mana eshia namusunjile shiosi, nemuheelesie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nimundaka ikhwe eyifwana yirie, nende ebiheetso ebifwana birie, nembinie shinga olwa namumboolele; habula mbu mumbeelesie omukhaana abe omukhasi wanje.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasiani baYakobo nibakalusia Shekhemu nende Hamori samwana khulwa obukaatii; nibaboola, shichila yali nasasiye Dina omukhaana wabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.13",
            "verseOrgIds": [
              "GEN.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibabasunjila bari Shikhunyala okhukhola likhuwa lino ta, okhubakha omukhaana weefwe khumundu omusinde; okhuba likhuwa lino liakhaba lietsisoni khwifwe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.14",
            "verseOrgIds": [
              "GEN.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula nimuba nimukhola muri nanwa khulamufuchiilila; nimuba shinga ifwe olwa khuli, mbu buli musaatsa mwinywe ashebwe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.15",
            "verseOrgIds": [
              "GEN.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho mana khulakhweelelananga nineenywe, nikhumenya halala nineenywe, nikhuba abandu balala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.16",
            "verseOrgIds": [
              "GEN.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nimuba nimuloba okhukhuhulila, nimurashebwa ta, khulabukula omukhaana weefwe nikhuhwaho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa kabwe nikachamisia Hamori, nende Shekhemu omwana waHamori. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.18",
            "verseOrgIds": [
              "GEN.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusooliili oyo shiyashinda okhukhola likhuwa elo ta, okhuba yali niyasangaalila omukhaana waYakobo; ne yali owoluyali okhushila bosi abomunzu yasamwana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.19",
            "verseOrgIds": [
              "GEN.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Hamori nende Shekhemu omwanawe nibeetsa niboola muluyia Iwelitaala liabwe, nibasungana nende abasaatsa belitaala liabwe, bari ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.20",
            "verseOrgIds": [
              "GEN.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bano bali nomulembe nineefwe; kho bamenye mushibala nibakholelamwo obukhala; shichila lole, eshibala shino neshikhongo eshibahela; khukhweelelanenje ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.21",
            "verseOrgIds": [
              "GEN.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhuba nikhukhola khuri nanwa, abasaatsa abo balafuchiilila okhumenya nineefwe, khube abandu balala, ne butswa ta; mbu buli musaatsa mwifwe ashebwe, shinga bo olwa bashebungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.22",
            "verseOrgIds": [
              "GEN.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsing'ombe tsiabwe nende emiandu chiabwe nende emiruko chiabwe chiosi, shibiakhaba ebieefwe? Khubafuchiilile butswa, mana balamenya nineefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.23",
            "verseOrgIds": [
              "GEN.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabahulila banga Hamori nende Shekhemu omwanawe, bosi ababiranga muluyia Iwelitaala; shia omusaatsa yesi nashebwa, bosi ababiranga muluyia Iwelitaalalie.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.24",
            "verseOrgIds": [
              "GEN.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.24",
            "verseOrgIds": [
              "GEN.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yakhataru, olwa bali nibashitsuunwa, babili abokhubaana baYakobo, mbu Simeoni nende Lawi, abasiani babwe Dina, nibabukula shia omundu olukangalwe, nibarulila khwitaala elo nende injinia, nibeera abeshisaatsa bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeera Hamori nende Shekhemu omwanawe netsinganga, nibabukula Dina munzu waShekhemu, nibarula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baYakobo nibabeetsela abali nibeerilwe, nibayaaya litaala, okhuba bali nibasasiye omuldlaana wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.27",
            "verseOrgIds": [
              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babukula ebiayo biabwe nende tsing'ombe tsiabwe nende tsisishili tsiabwe, nende buli shiosi eshiali mwitaala, nende buli shiosi eshiali mubwayilo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende obuyinda bwabwe bwosi, nende abayia babwe bosi nende abakhasi babwe, babahamba, nokhuyaaya biosi ebiali mutsinzu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo naboolela Simeoni nende Lawi mbu Munyasiye, nimuchila nimbunya obubolo mubeene eshibala shino, mubaKanaani nende abaPerizi; nasi, olwa abandu banje barali abanji ta, nabakhung'aanile nibakhupa; nesishibwe, isie nende inzu yanje. ",
