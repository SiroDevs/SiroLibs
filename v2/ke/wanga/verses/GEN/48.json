    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo yasabila Efuraimu naManase ikhabi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyuma lwamakhuwa ako oundi yamuboolela Yusufu mbu Lola, so nomulwale; naye nabukula abaalabe abo babili, Manase nende Efuraimu, natsia ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.1",
            "verseOrgIds": [
              "GEN.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oundi namuboolela Yakobo ari Lola, omwanawo Yusufu yeetsa khumubiliwo; naye Isiraeli niyeetinyilisia niyeekhala khushitali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.2",
            "verseOrgIds": [
              "GEN.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo namuboolela Yusufu mbu Nyasaye Ounyalabiosi yandoleshela eLuzu mushialo shiaIianaani, niyambeelesia ikhabi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.3",
            "verseOrgIds": [
              "GEN.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyasunjila mbu Lola, ndalakhunyalila okhwibulana muno, nikhwinjiyia, nikhukhola obe omukhung'aano kwetsimbia tsiabandu; khandi eshialo shino eheelesia olwibulolwo munyumawo, shibe eshiabwe okhuula khubisoni nebisoni; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.4",
            "verseOrgIds": [
              "GEN.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bulaano abaanabo babili aba weebulila mushibala shiaMisiri, isie olwa ndali nishili okhukhwitsila eMisiri, blaab abaanaa banje; Efuraimu nende Manase balaba abanje shinga Reubeni nende Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.5",
            "verseOrgIds": [
              "GEN.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwibulolwo olwa witsa okhwibula inyuma wabano, bo baliba abobo; mubilibwa biabaana babwe balikulishilwa mubulaame bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.6",
            "verseOrgIds": [
              "GEN.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi, olwa ndali nirula ePadani, Raheli ya'fwila nikhushili khunjila mushialo shiaKanaani, nilushisikala oluchendokhwo okhuula eEferati; nasi nimuyabilayo khunjila yeEfarati, nilio Betelehemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Isiraeli nalola abaana baYusufu, nareeba mbu Nibeena bano? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.8",
            "verseOrgIds": [
              "GEN.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu namuboolela samwana mbu Nibo abaana banje aba Nyasaye yambeelesia hano. Naye naboola ari Obaleere hano aha endi, nasi ndalabasabila ikhabi ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.9",
            "verseOrgIds": [
              "GEN.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsimoni tsiaIsiraeli tsiali nitsieelima khulwa obukofu, kata shiyanyala okhulola ta. Nabasitia ahambi ninaye; naye nabatsunzuuna, nabafumbeelela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.10",
            "verseOrgIds": [
              "GEN.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli namusunjila Yusufu ari Shindapaaranga mbu ndilikhulolakhwo mumonimwo ta; ne lola, Nyasaye yandolesiye nende olwibulolwo khandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.11",
            "verseOrgIds": [
              "GEN.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yusufu nabarusia mumakuluke; niyeenamia obwenibwe hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.12",
            "verseOrgIds": [
              "GEN.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nababukula bombi, Efuraimu mumukhonokwe musaatsa, okhuhengana nende omukhono mukhasi kwaIsiraeli, naye Manase mumukhonokwe mukhasi, okhuhengana nende omukhono musaatsa kwaIsiraeli, nabasitia ahambi ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.13",
            "verseOrgIds": [
              "GEN.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Isiraeli yanyiila omukhonokwe musaatsa nara khumurwe kwaEfuraimu, owali omushe, ne omukhonokwe mukhasi nara khumurwe kwaManase, nabisania amakhono nalola; okhuba Manase niye owali omukhulundu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.14",
            "verseOrgIds": [
              "GEN.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusabila Yusufu ikhabi, naboola mbu Nyasaye watsana owa abeebuli banje Aburahamu nende Isaka beechendelesinjia imbeliwe, Nyasaye watsana owandiisia tsindaalo tsianje tsiosi okhuula leelo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "malaika watsana owa'nunula mububii bwosi, abaheelesie ikhabi abayia bano; bakulishilwe mushilibwa shianje, nende mushilibwa shiabeebuli banje, Aburahamu nende Isaka; mana beenjihe muno, bashilane hakari weshialo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Yusufu yalola samwana nareele omukhonokwe musaatsa khumurwe kwaEfuraimu, nibuba obubii mumonitsie; nakuunula omukhono kwasamwana mbu akurusie khumurwe kwaEfuraimu nakura khumurwe kwaManase. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.17",
            "verseOrgIds": [
              "GEN.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu namusunjila samwana ari Tawe, papa; okhuba uno niye omukhulundu; ra omukhonokwo musaatsa khumurwe kukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.18",
            "verseOrgIds": [
              "GEN.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwana nakaana, naboola mbu Emanyile, omwana wanje, emanyile; naye yesi aliba oluyia, khandi yesi aliba omukhulundu; habula omwana wabwe omushe alimushila obukhulundu, nolwibulolwe nalwo luliba amahanga amanji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.19",
            "verseOrgIds": [
              "GEN.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasabila ikhabi inyanga eyo, naboola mbu Mwinywe nimwo omwa abaIsiraeli balisabilanga ikhabi, nibasunga bari Nyasaye akhukhole shinga Efuraimu khandi shinga Manase; namura Efuraimu imbeli waManase. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli namusunjila Yusufu ari Lola, isie efwa, ne Nyasaye alabeetsanga halala nineenywe, naye alimukalusia mushialo shiabakuuka beenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.21",
            "verseOrgIds": [
              "GEN.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ekhuheelesiye omukabo mulala okhushila abaana beenywe, okwa ndanuula mumukhono kwabaAmori nende olukanga lwanje khandi nende obuyingo bwanje.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.22",
            "verseOrgIds": [
              "GEN.48.22"
            ]
          }
        }
      ]
    }
  ],
