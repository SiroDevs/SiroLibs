          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nalola mbu Lea shiyaheelwa ta, namwikula olubeleshelo; ne Raheli yali omukumba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea nahela inda, niyeebula omwana omusiani, namukulikha eliira mbu Reubeni; okhuba yasunga mbu Shichila OMWAMI yahenjile okhusandibwa khwanje; bulaano omusaatsa wanje ala'heela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahela inda khandi, niyeebula omwana omusiani; naboola ari Shichila OMWAMI yahuliile shinga olwa ndaraheelwa ta, khulwako yambeele uno yesi; namukulikha eliira mbu Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nahela inda, niyeebula omwana omusiani; nasunga mbu Bulaano nilwo olwa omusaatsa wanje alahambana ninasi, okhuba emwibuliile abaana abasiani bataru; khulwako yakulikhwa eliira mbu Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nahela inda, niyeebula omwana omusiani; nasunga mbu Kho luno nalwo ndalamufumia OMWAMI; khulwako namukulikha eiiira mbu Yuda; mana nasinjila okhwibula.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
