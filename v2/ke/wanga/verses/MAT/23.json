          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woowe, inywe abahandiichi nende abaFarisayo, abeekaatii! Shichila mufwana shinga ebilirdwa ebihoomilwe lilongo, ebilolekha elwanyi shinga ebing'oonefu, ne mukari mubeetsanga nimwitsuulemwo amakumba kabandu abafwa nende eshifwabwi shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineenywe mwesi murio, elwanyi muloleshelanga abandu mbu muli abalunjishi, ne mukari mubeetsanga nimwitsuulemwo obukaatii nende obumayaanu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woowe, inywe abahandiichi nende abaFarisayo, abeekaatii! Shichila muumbakhanga ebilindwa biabanabii, nimung'oona ebilindwa biabalunjishi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.29",
            "verseOrgIds": [
              "MAT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimuboola muri, Khane nikhwakhabeeleho mundaalo tsiabakuuka, khane shikhwakhasanjilaane ninabo okhwebeenia amatsayi kabalakusi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho murio mwirumbulilanga abeene akobuloli, mbu muli abaana ba abo abeera abanabii. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.31",
            "verseOrgIds": [
              "MAT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana mwitsusie eshichelo shiabakuuka beenywe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.32",
            "verseOrgIds": [
              "MAT.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.32",
            "verseOrgIds": [
              "MAT.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe tsinzokha, inywe abaana bameeni, muleehonokokha murie mushiina shiaGehena? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
              "MAT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila, lola, emurumila abanabii, nende abachesi, nende abahandiichi; abandi khubo mulabeera, nimubabamba; nabandi khubo mulabarootsela mutsisinagogi tsieenywe nimubeelusia okhurula mwitaala lindi okhuula mulindi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.34",
            "verseOrgIds": [
              "MAT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mana eshiina shiamabanga kabalunjishi bosi akeebeena khushialo shibe khwinywe, okhurula khumabanga komulunjishi Abeli, okhuula khumabanga kaZakaria waBarakhia, owa mweera hakari weihekalu nende eshimalilo shiemisango. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela toto mbu amakhuwa ako kosi kaliikhola khubolwibulo luno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.36",
            "verseOrgIds": [
              "MAT.23.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yeekhuulila Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
