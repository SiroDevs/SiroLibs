{
  "id": "MAT.10",
  "number": "10",
  "bookId": "MAT",
  "reference": "Matsayo 10",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "MAT 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yalobola abeechi ekhumi nababili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yalanga abeechibe ekhumi nababili, nabaheelesia obunyali khubaroho beshifwabwi mbu babarusinjie, nende okhuhonia obuteshele bwetsimbia tsiosi nende obulwale bwetsimbia tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.1",
            "verseOrgIds": [
              "MAT.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.1",
            "verseOrgIds": [
              "MAT.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ameera kabeechi abo ekhumi nababili ngakano; owambeli, Simoni oulangwa mbu Petero, nende Anderea, omwana wabwe; Yakobo waZebedayo, nende Yohana, omwana wabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo, naBaritsolomayo; Tomasi, naMatsayo omusololi wobushuru; Yakobo waAlufayo, naTsadayo; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni omuKananayo, nende Yuda Isikariote, owatsana owamukhobana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.4",
            "verseOrgIds": [
              "MAT.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburume bwabeechi ekhumi nababili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.4",
            "verseOrgIds": [
              "MAT.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ekhumi nababili nibo aba Yesu yaruma, nabalachilisia, ari Muralondakhwo khunjila yosi eyitsia mumahanga, kata okhwinjila mwitookho liosi liabaSamaria tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.5",
            "verseOrgIds": [
              "MAT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa mubatsiile amakondi akakora akomushilibwa shiaIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.6",
            "verseOrgIds": [
              "MAT.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nimutsiitsanga, mwilwatse, nimuboola muri Obwami obwomwikulu busitile ahambi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.7",
            "verseOrgIds": [
              "MAT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Honinjie abalwale, lamusinjie abafwile, siiyenje abobuchele, rusinjie amadimoni; muheelwe butswa, muhaanenje butswa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.8",
            "verseOrgIds": [
              "MAT.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.8",
            "verseOrgIds": [
              "MAT.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murabukule itsahaabu kata ifeetsa kata tsisende mungubo tsieenywe ta; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.9",
            "verseOrgIds": [
              "MAT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "omufuuko kwoluchendo ta, kata tsingubo tsiomukari tsibili, kata ebilaaro, kata indabushi tawe; shichila omukholi wemilimo akwanile okhuheebungwa ebiokhuliabie.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.10",
            "verseOrgIds": [
              "MAT.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.10",
            "verseOrgIds": [
              "MAT.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mwitookho liosi kata mwitaala liosi elia muleenjilamwo, mukhaabemwo mbu niwina oukhoyeele; nimumenya mubwenomwo okhuula olwa murula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.11",
            "verseOrgIds": [
              "MAT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa mushiinjila mur zu, muchishiesie. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.12",
            "verseOrgIds": [
              "MAT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inzu eyo niyiba niyikhoyeele, omulembe kweenywe kube khuyo; ne niyiba niyirakhoyeele ta, omulembe kweenywe kumukalushile ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.13",
            "verseOrgIds": [
              "MAT.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi ouramwinjisia ta, kata okhuhulila aka muboola ta, olwa murula munzu omwo kata mwitaala omwo, muteng'ulule olufu olwokhubilenje bieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.14",
            "verseOrgIds": [
              "MAT.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela toto mbu amakhuwa kalibakhwo amaangu khulwa eshibala shiaSodomu nende Gomora khunduukho yeshiina okhushila shinga olwa kalibeela litaala lienelo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.15",
            "verseOrgIds": [
              "MAT.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusandibwi obuliitsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.15",
            "verseOrgIds": [
              "MAT.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, emuruma shinga amakondi hakari mubisuutse; kho mubeetsenje abachesi shinga tsinzokha, khandi abaholo shinga amahuusi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.16",
            "verseOrgIds": [
              "MAT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mwirecheshe khukabandu; shichila balamukhobana nibamuyila mubiina, kata mutsisinagogi tsiabwe balimunywekha; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.17",
            "verseOrgIds": [
              "MAT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi muliyilwa imbeli wabaami nende abaruchi khulwanje, mube oburumbusi khubo nende khuBamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.18",
            "verseOrgIds": [
              "MAT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa balamuyila, murahenda mbu namuboole murie, kata mbu namuboole shiina, tawe; shichila mulakaheebwa khushise shieneshio aka mwitsa okhuboola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.19",
            "verseOrgIds": [
              "MAT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila shimuli inywe abalaboola ta, habula Roho waSeenywe niye oulaboolela mwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.20",
            "verseOrgIds": [
              "MAT.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.20",
            "verseOrgIds": [
              "MAT.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu alakhoba omwana wabwe okhwirwa, ne samwana ario khumwanawe; abaana nabo balabuushila khubeebuli babwe, nibachila nibeerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.21",
            "verseOrgIds": [
              "MAT.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulakiywa nabandu bosi khulwa eliira lianje; nebutswa owifwila okhuula khushihesi, omwenoyo alahonibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.22",
            "verseOrgIds": [
              "MAT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bamusakania mwitaala lino, yilushile mulilia; okhuba emuboolela toto mbu muliba nimushili okhumalilisia amataala kaIsiraeli ta okhuula olwa Omwana wOmundu aliba niyeetsile.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.23",
            "verseOrgIds": [
              "MAT.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oukhoyile okhuriibungwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.23",
            "verseOrgIds": [
              "MAT.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwechibwa yesi shiashila omwechesiawe, kata omusumba yesi shiashila omwamiwe, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.24",
            "verseOrgIds": [
              "MAT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamuhela omwechibwa naba shinga omwechesiawe olwa ali, kata omusumba okhuba shinga omwamiwe. Nibaba nibamulanjile omwenengo mbu Beelezibuli, shibalashila okhulanga abomungoye bario! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.25",
            "verseOrgIds": [
              "MAT.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho murabariitsanga tawe; shichila libulaho elifuunikhwa elirafuunukha ta, kata elibiswa, elirabisukha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.26",
            "verseOrgIds": [
              "MAT.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka emuboolela mushiilima, mukasunje mubulatu; naka muhulila mushirwi, mukeelwatse ebulafu khubilama bietsinzu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.27",
            "verseOrgIds": [
              "MAT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata murabariitsanga abeera omubili nibaranyala okhwira omwoyo ta; nebutswa mutrmriitsenje omwenoyo ounyala okhutibia omwoyo nende omubili biosi muGehena.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.28",
            "verseOrgIds": [
              "MAT.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.28",
            "verseOrgIds": [
              "MAT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amarorelesi kabili shikakulwa isende ndala? Ne kata elala khuko shililakwa hasi Seenywe naramanyile ta; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.29",
            "verseOrgIds": [
              "MAT.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kata buli Iwoya Iweliswi lieenywe lwabalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.30",
            "verseOrgIds": [
              "MAT.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho murariitsanga tawe; inywe mushila amarorelesi amanji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.31",
            "verseOrgIds": [
              "MAT.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokwiyama Kristo imbeli wabandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.31",
            "verseOrgIds": [
              "MAT.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho buli mundu yesi oulandiyama isie imbeli wabandu, nasi ndaIamwiyama imbeli waPapa ouli mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.32",
            "verseOrgIds": [
              "MAT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi oulandiyambakhana imbeli wabandu, nasi ndalamwiyambakhana imbeli waPapa ouli mwikulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.33",
            "verseOrgIds": [
              "MAT.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omulembe ta, habula olukanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.33",
            "verseOrgIds": [
              "MAT.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murakaala mbu ndeetsa okhuleera omulembe mushialo tawe; shindayeetsa okhuleera omuIembe ta, habula olukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.34",
            "verseOrgIds": [
              "MAT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ndeetsa okhuleera oburambani hakari womwana nende samwana, kata omukhaana nende nyina, kata omukhaana nende nyakhufialanyene; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.35",
            "verseOrgIds": [
              "MAT.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabasuku bomundu nabomwitaalalie.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.36",
            "verseOrgIds": [
              "MAT.10.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.36",
            "verseOrgIds": [
              "MAT.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouheelanga samwana kata nyina okhuyomba shinga olwa yaheela isie, shiyangwanila tawe; kata ouheela omwanawe omusiani kata omukhaana okhuyomba isie shiyangwanila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.37",
            "verseOrgIds": [
              "MAT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noyo oureetuukha omusalabakwe walonda munyuma wanje, shiyangwanila isie ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.38",
            "verseOrgIds": [
              "MAT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oukhaabanga okhunyoola obulamubwe, alabukosia; noubukosia obulamubwe khulwanje alabunyoola.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.39",
            "verseOrgIds": [
              "MAT.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amatani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.39",
            "verseOrgIds": [
              "MAT.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oumwinjisia inywe yanzinjisia isie; nounzinjisia isie amwinjisia oyo owanduma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.40",
            "verseOrgIds": [
              "MAT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owinjisia omunabii muliira liomunabii alanyoola amatani komunabii; noyo owinjisia omundu omuIunjishi muliira liomundu omulunjishi alanyoola amatani komundu omulunjishi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.41",
            "verseOrgIds": [
              "MAT.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omundu yesi oulamuheelesia mulala khubatuutu bano kata eshikhombe shiamatsi amanyifu shionyene, mbu anywe, muliira liomwechi, emusunjila toto mbu shialachweya okhunyoola amatanike na hatuutu ta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.42",
            "verseOrgIds": [
              "MAT.10.42"
            ]
          }
        }
      ]
    }
