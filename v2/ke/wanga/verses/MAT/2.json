    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abachesi bebukwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa Yesu yeebulwa muBetselehemu ebuYahudi mundaalo tsiaHerode omuruchi, lola, abachesi khuketsinyininyini barula ebukwe nibeetsa eYerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.1",
            "verseOrgIds": [
              "MAT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibareebanga bari Ali heena owibuulwe abe omuruchi wabaYahudi? Okhuba khwalola inyininyini yiye ebukwe, ne khwitsile okhumwinamila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.2",
            "verseOrgIds": [
              "MAT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Herode omuruchi yahulilakhwo, ikholo niyimurimukha, halala nende abeYerusalemu bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.3",
            "verseOrgIds": [
              "MAT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nakhung'aasia halala abakhulundu babakuhani bosi nende abahandiichi abomubandu, nabareebelesia mbu Kristo yakheebulilwa heena? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.4",
            "verseOrgIds": [
              "MAT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamukalusia bari MuBetselehemu ebuYahudi; shichila kahandiikwa kari nanwa nende omunabii, mbu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.5",
            "verseOrgIds": [
              "MAT.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.6",
            "verseOrgIds": [
              "MAT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Herode nalanga abachesi khuketsinyininyini abo mabiswi, nanoonelesia kahala eshise eshia inyininyini yaloleshelakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.7",
            "verseOrgIds": [
              "MAT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaruma eBetselehemu, naboola mbu Tsie mureebelesie muno amakhuwa komwana oyo; nolwa muba mumunyoolile, mukhupile omunwa, mbu siesi enzie emwinamile.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.8",
            "verseOrgIds": [
              "MAT.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.8",
            "verseOrgIds": [
              "MAT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo olwa bali nibahuliile aka omuruchi yaboola, batsiililila khuluchendo lwabwe; ne lola, inyininyini eya bali nibaluutsi ebukwe yabeemilila, okhuula olwa yoola niyisinjila ikulu ewa omwana yali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.9",
            "verseOrgIds": [
              "MAT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa balola inyininyini, beekhoya omwikhoyo omukali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.10",
            "verseOrgIds": [
              "MAT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeenjila munzu, nibalola omwana nende Mariamu nyina; nibakwa mumakuluke nibamwinamila; nibaboholola amabiikho kabwe nibamuyiniliamwo ebihaanwa, mbu itsahaabu, nobubaane, namanemane. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.11",
            "verseOrgIds": [
              "MAT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa beebaalilwa nende Nyasaye mwilooro mbu baleshe okhukalukha ewaHerode, beenyoshela khunjila yindi nibakalukha ewabwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.12",
            "verseOrgIds": [
              "MAT.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwilushila eMisiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.12",
            "verseOrgIds": [
              "MAT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibeenyooshe, lola, malaika wOmwami yamuloleshela Yusufu mwilooro, nasunga ari Buukha, obukule omwana nende nyina, wilushe otsie eMisiri, omenyeyo okhuula olwa ndilikhukhupila omunwa; shichila Herode alakhaaba omwana mbu amwire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.13",
            "verseOrgIds": [
              "MAT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabuukha nabukula omwana nende nyina mushilo, natsia eMisiri; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.14",
            "verseOrgIds": [
              "MAT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabayo okhuula Herode olwa yafwa; mbu aka Omwami yaboola mumunwa kwomunabii koosibwe, mbu EMisiri newa ndamulanga omwana wanje.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.15",
            "verseOrgIds": [
              "MAT.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwirwi bwabaana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.15",
            "verseOrgIds": [
              "MAT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Herode olwa yalola shinga abachesi khuketsinyininyini abo olwa bali nibamukaatiye, yatiilwa oburima muno, naruma abandu mbu beere abaana abasiani bosi abali nibali muBetselehemu, nende mumbali tsialio tsiosi, abemiyika chibili nende abaleemakhwo, eshise shinga olwa shiali eshia yanoonelesia khubachesi abo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.16",
            "verseOrgIds": [
              "MAT.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana amakhuwa kali nikoosiibwe akasungwa nende Yeremia omunabii, ari",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.17",
            "verseOrgIds": [
              "MAT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhurula eMisiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Herode yali namalile okhufwa, lola, malaika wOmwami yamuloleshela Yusufu mwilooro eMisiri, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.19",
            "verseOrgIds": [
              "MAT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "naboola mbu Buukha, obukule omwana nende nyina, otsie mushibala shiaIsiraeli; shichila abali nibayimanga obulamu bwomwana bamalile okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.20",
            "verseOrgIds": [
              "MAT.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabuukha nabukula omwana nende nyina, natsia niyoola mushibala shiaIsiraeli ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.21",
            "verseOrgIds": [
              "MAT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yahulila mbu Arikhelao niye ourukanga ebuYahudi mushilenje shiaHerode samwana, yaria okhutsiayo; ne niyeebaalilwa nende Nyasaye mwilooro, yarulayo natsia mumbali tsieGalilaya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.22",
            "verseOrgIds": [
              "MAT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyoola khwitaala elilangwa mbu Nazareti, namenyamwo; mbu mana akasungwa nende abanabii koosibwe, mbu yakhalangwa mbu omunNazorayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.23",
            "verseOrgIds": [
              "MAT.2.23"
            ]
          }
        }
      ]
    }
  ],
