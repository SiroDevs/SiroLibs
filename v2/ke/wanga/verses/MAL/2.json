  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "MAL 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, inywe abakuhani, lilako lino lili khulweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.1",
            "verseOrgIds": [
              "MAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI omwene mahe aboola mbu Nimuba nimukhaya okhulihulila, kata nimukhaya okhulirakhwo omwoyo, okhuheelesia eliira lianje oluyali, kho ndalaruma eshilaamo shiobubii khwinywe, khandi ndalakwisia tsikhabi tsieenywe eshilaamo shiobubii; kata emalile okhutsikwisia endio, shichila shimureetsangakhwo omwoyo khulio ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.2",
            "verseOrgIds": [
              "MAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, ndalafwona amakhono keenywe, nimbakha amasingo mumoni mweenywe, mbu amasingo kebiemisango chieenywe; nimuyila halala ninachio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.3",
            "verseOrgIds": [
              "MAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mulamanya mbu ndamurumiile lilako lino, mbu indakano eya ndalakana nende Lawi yibeetsenjeho; nilwo olwa OMWAMI omwene mahe aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.4",
            "verseOrgIds": [
              "MAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indakano yanje ninaye yali eyobulamu nomulembe; ndabimuheelesia mbu arie; mana niyaria, natechelela eliira lianje. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.5",
            "verseOrgIds": [
              "MAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalako kobwatoto kali mumunwakwe, kata akobubii shikanyooleshela mumunwakwe ta; yachendanga ninasi mumulembe nobukololofu, nashiukhasia abanji okhurula khubumayaanu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.6",
            "verseOrgIds": [
              "MAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omunwa kwomukuhani kukhoyile okhulindanga obumanyi bulayi; abandu bakhoyile okhukhaabanga obwibaali khukomunwakwe; okhuba niye omurume w omwene mahe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.7",
            "verseOrgIds": [
              "MAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mushiamile nimurula khunjila; mwayeesichirasiye abanji nameebaalo keenywe; mwayoonooniye indakano yaLawi; nilwo olwa OMWAMI omwene mahe aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.8",
            "verseOrgIds": [
              "MAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niko akachila nimukhola inywe okhulekwa nokhufwolwa imbeli wabandu bosi, shinga olwa mwachweya okhulonda khunjila tsianjej ne nimukholanga ebiela mubandu mubwibaali bweenywe.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.9",
            "verseOrgIds": [
              "MAL.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "OMWAMI yakondeshela Isiraeli khulwa okhubula obwisiikwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.9",
            "verseOrgIds": [
              "MAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lfwe fwesi, seefwe shiali mulala? Nyasaye owakhulonga shiali mulala? Ne mbushiina nikhukhobananga, buli mundu nowashie, nikhwonoonia indakano yabakuuka beefwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.10",
            "verseOrgIds": [
              "MAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda wakhola akobukhobani; eshisinyo shikholungwa muIsiraeli nomuYerusalemu; okhuba Yuda wayoonoonia habundu ahatakatifu hOMWAMI, aha aheelanga; wateeshiye omukhaana womunyasaye omucheni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.11",
            "verseOrgIds": [
              "MAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oukhola ario, OMWAMI amukhalachekhwo owakhaboola akobuloli nomukalusii, bosi, mumaheema kaYakobo, kata oyo ouleerela OMWAMI omwene mahe eshihaanwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mukholanga muri nanwa; mbu mufuunikhanga eshimalilo shiOMWAMI amasika, namalilo, nokhubinda, shichila shiahenganga eshihaanwa shieenywe khandi ta, kata okhushifuchiilila nokhuchama mumakhono keenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.13",
            "verseOrgIds": [
              "MAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mureebanga muri Mbushiina? Shichila OMWAMI niye owali omuloli hakariwo nomukhasiwo omubula, owa wabulakhwo obwisiikwa khuye, kata olwa ali owashio, nomukhasiwo khulwa indakano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.14",
            "verseOrgIds": [
              "MAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye shiyalonga mulala, owali nomubili nende omuuya kwobulamu? Ne mulala oyo khulwa shi? Mbu yakhaaba olwibulo olurula khuNyasaye. Khulwako, rechelesinjie aketsiroho tsieenywe, omundu yesi aleshenje okhubula obwisiikwa khumukhasiwe omubula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.15",
            "verseOrgIds": [
              "MAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI, Nyasaye waIsiraeli, aboola mbu Okhuba engiyanga obukabukhani, nakokhufuunikha tsingubotsio amahababa, OMWAMI omwene mahe aboola; khulwako, mwirecheche muno ikhutsiroho tsieenywe, mbu mubeetsenje abeesiikwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inyanga yobuyaasii yili ahambi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwachoonyiye OMWAMI namakhuwa keenywe. Nebutswa mureebanga mbu Khumuchoonyiye khurie? Mbu nimusunganga muri Buli mundu oukhola obubii nomulayi mumoni tsiOMWAMI, naye abasangaalilanga. Kata nimureebanga mbu Nyasaye ouyaasinjia habwene ali heena?",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.17",
            "verseOrgIds": [
              "MAL.2.17"
            ]
          }
        }
      ]
    }
  ],
