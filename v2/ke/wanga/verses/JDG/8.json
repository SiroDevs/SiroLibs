          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Gideoni yali nafwile, abaana baIsiraeli bashiukhana bwangu, nibalonda khumiBaali shinga abaheyi, nibakhola Baali-beritsi abe nyasaye wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.33",
            "verseOrgIds": [
              "JDG.8.33"
            ]
          }
        },
        {
