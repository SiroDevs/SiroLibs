              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Midiani yahulwa yirio imbeli wabaana baIsiraeli, nibarachinguula omurwe khandi ta. Eshialo nishihuluukha emiyika amakhumi kane mundaalo tsiaGideoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        }
