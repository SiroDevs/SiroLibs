          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibareetsulila OMWAMI Nyasaye wabwe ta, owali nabarusiye mumakhono kabasuku babwe tsimbeka tsiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.34",
            "verseOrgIds": [
              "JDG.8.34"
            ]
          }
        },
        {
