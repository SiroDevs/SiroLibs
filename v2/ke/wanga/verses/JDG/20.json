          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lihe liabaBenyamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana baIsiraeli bosi nibarula, okhurula eDani okhuula eBeeri-sheba, neshialo shiaGileadi shiosi, omukhung'aano nikukhung'aanila OMWAMI eMizipa shinga emundu mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.1",
            "verseOrgIds": [
              "JDG.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abamakuru babandu bosi, abetsimbia tsiosi tsiaIsiraeli, nibasinjila imbeli welibukaana liabandu baNyasaye, abandu ebikhumila ebikhumi bine abetsinganga, abachendanga nebilenje. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.2",
            "verseOrgIds": [
              "JDG.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baBenyamini nibahulila shinga abaana baIsiraeli olwa bali nibatikuluushe nibatsia eMizipa. Abaana baIsiraeli nibareeba mbu Mukhuboolele, mbu obubii buno bweekhola burie? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.3",
            "verseOrgIds": [
              "JDG.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuLawi, omusaatsa womukhasi ulia oweerwa, nakalusia naboola mbu Isie ndatsia eGibea, elili liaBenyamini, isie nomusuria wanje okhukonayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.4",
            "verseOrgIds": [
              "JDG.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaatsa beGibea nabo nibambuushilakhwo, nibafumbila inzu tsimbeka tsiosi mushilo; isie omwene bali nibeenya okhunzira, naye omusuria wanje bamwonoonia, nafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.5",
            "verseOrgIds": [
              "JDG.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimbukula omusuria wanje, nimutonya ebitonye, niruma ebitonye tsana mushialo shiosi shiobulaame bwaIsiraeli; okhuba bakhola akobwilaasi neshifwabwi muIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.6",
            "verseOrgIds": [
              "JDG.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, inywe abaana baIsiraeli mwesi, obuchesiyii bweenywe bwakhaba burie, nende amapaaro keenywe?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi nibabuukha shinga omundu mulala, bari Omundu yesi khwifwe shialakalukha khwiheemalie kata okhukotola enanzuwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.8",
            "verseOrgIds": [
              "JDG.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano elia khulakholela Gibea ndielino; mbu khulatikulukha okhuliseera khulwa okhukhupa ikha; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.9",
            "verseOrgIds": [
              "JDG.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulabukula abandu ekhumi mushikhumi, nende eshikhumi mushikhumila, nende eshikhumila mubikhumila likhumi, mbu beendenje ebiokhulia biabandu, mbu mana olwa baloola eGibea liaBenyamini, babakalusilie akakhoyeele eshifwabwi eshia bakhola muIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.10",
            "verseOrgIds": [
              "JDG.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaIsiraeli bosi nibakhung'aana okhuseera litaala, nibaliimaanile shinga omundu mulala.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abetsimbia tsiaIsiraeli nibaruma abandu muluyia lwosi lwaBenyamini, okhureeba mbu Nelikhuwa shiina lioluswa lino eliikholile mwinywe? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.12",
            "verseOrgIds": [
              "JDG.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulaano muhaane abandu tsana, abamayaanu abeshifwabwi abali muGibea, mbu beerwe, khurusieho obubii obuli muIsiraeli. Ne Benyamini yakhaya okhuhulila amakhuwa kabaana babwe, abaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.13",
            "verseOrgIds": [
              "JDG.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baBenyamini nibakhung'aana halala okhurula mumataala, nibatsia eGibea, okhuseerana nabaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.14",
            "verseOrgIds": [
              "JDG.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baBenyamini abarula mumataala babalwa inyanga eyo, mbu abandu ebikhumila amakhumi kabili nabisasaba abetsinganga, khandi nende abeGibea, ababalwa abandu abalobole ebikhumi musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.15",
            "verseOrgIds": [
              "JDG.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mubandu abo bosi balimwo abandu ebikhumi musaafu abasaka, abomukaata; buli mulala khubo yali ounyala okhukhuyunga lichina neimburusi khulwoya, oburapaya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.16",
            "verseOrgIds": [
              "JDG.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaIsiraeli harali Benyamini ta, babalwa abandu ebikhumila ebikhumi bine abetsinganga; abo bosi bali abandu belihe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana baIsiraeli nibarula nibatsia eBeteli, nibareeba obwibaali ewOMWAMI; nibareeba mbu Niwina oularanjilila okhukhutikulushila mwihe, okhuseera abaana baBenyamini? OMWAMI naboola mbu Yuda aranjilile.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaana baIsiraeli nibarula mutsuli, nibakhupa ikambi ahahengana naGibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.19",
            "verseOrgIds": [
              "JDG.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu baIsiraeli nibarula okhuseera Benyamini lihe; abaIsiraeli nibaanza amahe okhubaseerela eGibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.20",
            "verseOrgIds": [
              "JDG.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana baBenyamini nibarula eGibea, nibamululila elala abaIsiraeli ebikhumila amakhumi kabili nabibili khunyanga eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.21",
            "verseOrgIds": [
              "JDG.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabandu abo, abaIsiraeli, nibooma ikholo, nibaanza khandi amahe habundu tsana ewa bali nibeeyanzile khunyanga yambeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.22",
            "verseOrgIds": [
              "JDG.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibatikulukha nibatsia nibalila imbeli w, okhuula olwa bweela; nibareeba OMWAMI bari Khusitekhwo khandi okhuseerana nabaana baBenyamini, abaana beefwe, noho? OMWAMI naboola mbu Tikulushe, mutsie mubaseere.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaana baIsiraeli nibasita ahambi okhuseera abaana baBenyamini khunyanga yakhabili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.24",
            "verseOrgIds": [
              "JDG.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Benyamini narula eGibea okhubaseera khunyanga eyo yakhabili, mana khandi nabamululila elala abaana baIsiraeli ebikhumila ekhumi namunaane; abo bosi bali abetsinganga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.25",
            "verseOrgIds": [
              "JDG.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana baIsiraeli bosi, oluyia lwosi, nibatikulukha nibatsia eBeteli, nibalila, nibeekhalayo imbeli wOMWAMI, nibahonga inzala inyanga eyo okhuula olwa bweela; nibamala emisango emisambe, nemisango chiokhwishia, imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibareeba OMWAMI; okhuba lisanduku lieindakano yOMWAMI liali ebweneyo mundaalo etsio ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.27",
            "verseOrgIds": [
              "JDG.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Finehasi waEleazari waHaruni yali nakhalabanilanga imbeli walio mundaalo etsio; nibareeba bari Erule khandi, enzie ol huseerana nabaana baBenyamini, omwana weefwe, nohomba endeshe? OMWAMI nasunga mbu Tikulukha; okhuba mukamba ndalamuhaana mumukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaIsiraeli nibaraho abakonesheli khuGibea, tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.29",
            "verseOrgIds": [
              "JDG.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana baIsiraeli nibatikulukha okhuseera abaana baBenyamini khunyanga yakhataru, nibeeyanza okhuseera Gibea, shinga olwa bakholanga buli lwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.30",
            "verseOrgIds": [
              "JDG.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baBenyamini nibarula okhuseerana nabandu tsana, nibakhweswa barule mwitaala; nibachaaka okhuupa nokhwira abandu, shinga olwa bakholanga buli lwosi, habulafu khumihanda chieyo, mulala okutikulukha nikutsia eBeteli, okundi nikutsia eGibea; nibeera abaIsiraeli shinga amakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.31",
            "verseOrgIds": [
              "JDG.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baBenyamini nibasunga mbu Mbabo, barootswa imbeli weefwe shinga olwambeli. Habula abaana baIsiraeli basunga mbu Khwilushe khubakhwese barule mwitaala, beetse khumihanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu baIsiraeli bosi nibasinjila ewa bali, nibeeyanza eBaalitamari; nabo abakonesheli baIsiraeli nibapububukha ewa bali, eGeba olubeka lwamumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.33",
            "verseOrgIds": [
              "JDG.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibatsia okhuseera Gibea, abandu abalobole ebikhumila likhumi abomuIsiraeli yosi, lihe niliba lilului habula abaBenyamini shibamanya shinga olwa libii liali nilili okhubakwila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.34",
            "verseOrgIds": [
              "JDG.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nahula Benyamini imbeli waIsiraeli; abaana baIsiraeli nibamalilala muBenyamini inyanga eyo abandu ebikhumila amakhumi kabili nabiraano nende eshikhumi; abo bosi bali abetsinganga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaBenyamini nibalola shinga olwa bamalile okhuhulwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaIsiraeli nibeelukha imbeli waBenyamini, okhuba bali nibeesiikanga abakonesheli babwe, aba baraho khuGibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abakonesheli nibaanguha nibatsia butinyu khuGibea; ahakonesheli nibasitakhwo, nibarootsa litaala liosi netsinganga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.37",
            "verseOrgIds": [
              "JDG.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neshilolelo eshia abaIsiraeli nabakonesheli bali nibalakaane shieshino, mbu okhutuumia omwosi omunji shinga lileesi mwitaala, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.38",
            "verseOrgIds": [
              "JDG.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho abaIsiraeli bakhashiukhana mwihe. Nabo abaBenyamini nibachaaka okhuupa nokhwira abaIsiraeli, abandu shinga amakhumi kataru; okhuba bapaara mbu Toto mwene, barootswa imbeli weefwe shinga olwa bali mwihe liambeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.39",
            "verseOrgIds": [
              "JDG.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa lileesi tsana liachaaka okhutuumuukha mwitaala shinga isiilo yomwosi, abaBenyamini bakhupa amashemo, nibalola litaala liosi nilituumuukha mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.40",
            "verseOrgIds": [
              "JDG.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaIsiraeli nibashiukhana, abaBenyamini nibang'ang'aala; okhuba balola mbu amabii kabakwiliile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.41",
            "verseOrgIds": [
              "JDG.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibafutarila abaIsiraeli khunjila eyitsia mushitsiimi; nebutswa obulasani nibubarakhwo olutsobi, nabo abarula mumataala nibabamalilana hakari wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.42",
            "verseOrgIds": [
              "JDG.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeekalila abaBenyamini tsimbeka tsiosi, nibabalonda nibabayiima, nibabaseenela habuhuluushilo bwabwe, okhuula habundu ahahengana naGibea ebukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.43",
            "verseOrgIds": [
              "JDG.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu ebikhumila ekhumi namunaane baBenyamini nibafwa; ne bosi bali abalulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.44",
            "verseOrgIds": [
              "JDG.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibashiukhana nibeelushila mushitsiimi, okhuula khulwanda lwaRimoni; nibabaremaka mumihanda, abandu ebikhumila biraano; nibahalondachilila muno okhuula eGidomu, nibeera abandu ebikhumila bibili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.45",
            "verseOrgIds": [
              "JDG.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaBenyamini abeerwa inyanga eyo bali abandu ebikhumila amakhumi kabili nabiraano abetsinganga, ne bosi bali abalulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abandu ebikhumi bisasaba bashiukhana, nibeelushila mushitsiimi okhuula khulwanda lwaRimoni, nibamenya halwanda lwaRimoni emiesi chine. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.47",
            "verseOrgIds": [
              "JDG.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaIsiraeli nibashiukhanila abaana baBenyamini khandi, nibabarootsa netsinganga, abeetaala bosi, nemiruko, nabiosi ebia banyoola; kata nende amataala kosi aka banyoola, bakahambia omulilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.48",
            "verseOrgIds": [
              "JDG.20.48"
            ]
          }
        }
      ]
    }
