        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyumakhwo, mundaalo tsielichesa lieingano, Samusoni yatsia okhukoonya omukhasiwe, nali neshimeeme shieimbusi; naboola mbu Enzia ewomukhasi wanje mushisika. Nebutswa samwana shiyamumoka okhwinjila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.1",
            "verseOrgIds": [
              "JDG.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwana naboola mbu Embaarile mbu toto mwene, omukiyiile elala; kho emubashiile owashio. Ne omukhaana wabwe omushe shiamushila eshiiso? Chama obukule oyo mushilenjeshie. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.2",
            "verseOrgIds": [
              "JDG.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samusoni nabasunjila mbu Kho luno ndalabula eshikha halubeka lwabaFilisiti olwa embakholela libii. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.3",
            "verseOrgIds": [
              "JDG.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Samusoni natsia nahamba amabwe ebikhumi bitaru, nabukula ebitseso, nakashiukhasia omushila khumushila, nara eshitseso hakari wabuli mishila chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.4",
            "verseOrgIds": [
              "JDG.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nahambiye ebitseso ebio omulilo, yakalekhuula katsie mumele eyali niyishisinjiile mumikunda chiabaFilisiti, nasamba ebinywa biene, neimele eyali niyishisinjiile, khandi nende emikunda chiemitseituni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.5",
            "verseOrgIds": [
              "JDG.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaFilisiti nibareeba mbu Oukholile lino niwina? Nibaboola bari NiSamusoni, nyakhufialanyene omuTimina, shichila yabukula omukhasiwe namubashila owashie. Kho abaFilisiti nibatikulushilayo nibamusamba nende omulilo, halala nasamwana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.6",
            "verseOrgIds": [
              "JDG.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni nabasunjila ari Olwa mukholanga murio, ndalamalila eshikwoli khwinywe, mana ndalalekha endio. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.7",
            "verseOrgIds": [
              "JDG.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabakhupa muno muno, obwiri obukhongo; mana natsia namenya mumbangatsi yolwanda lwaFtamu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.8",
            "verseOrgIds": [
              "JDG.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samusoni yahula abaFilisiti eLehi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.8",
            "verseOrgIds": [
              "JDG.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaFilisiti nibatikulukha nibakhupa ikambi muYuda, nibaseera Lehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.9",
            "verseOrgIds": [
              "JDG.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaYuda nibabareeba mbu Nishiina eshichilile nimwitsa okhukhuseera? Nabo bari Khwitsile okhumuboha Samusoni, okhumukholela shinga olwa yakhukholeele if we. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaYuda ebikhumila bitaru nibakholomokha nibatsia khumbangatsi yolwanda lwaEtamu, nibareeba Samusoni bari Shiomanyile mbu abaFilisiti nibo abakhuruka? Kho okhukholeele orie? Naye nabakalusia mbu Shinga olwa bayakholeele, nolwa embakholeele endio. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.11",
            "verseOrgIds": [
              "JDG.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusunjila mbu Khwitsile okhukhuboha, khukhuhaane mumukhono kwabaFilisiti. Samusoni nabakalusia mbu Munzitsubile mbu inywe abeene shimulangwakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.12",
            "verseOrgIds": [
              "JDG.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bari Nobulayi; habula khulakhuboha butinyu, kho khukhure mumukhono kwabwe; ne toto mwene, shikhulakhwira ta. Nibamuboha nende emikoye chibili emiyia, nibamutikulusia okhurula khulwanda tsana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.13",
            "verseOrgIds": [
              "JDG.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.13",
            "verseOrgIds": [
              "JDG.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yoola eLehi, abaFilisiti nibeetsa okhumwakaanila, nibachinga amakhu; Roho wOMWAMI niyeenjila muye namaani, emikoye echiali khumakhonoke nichikwa shiobuusi obuyiile mumulilo, ebibohelobie nibisalulukha butswa nibirula khumakhonoke. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.14",
            "verseOrgIds": [
              "JDG.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyoola oluseya olubisi Iweisishili, nanyiila omukhono nalutiila, niyeera abandu eshikhumila ninalwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.15",
            "verseOrgIds": [
              "JDG.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samusoni naboola mbu",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    }
  ],
