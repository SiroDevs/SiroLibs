        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tola naYeiri bayaasia Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana inyuma waAbimeleki, oundi yabuukha okhuhonia Isiraeli, mbu Tola waPua waDodo, omuIsakhari; yali namenyanga eShamiri, mushialo shiebikulu shiaEfuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.1",
            "verseOrgIds": [
              "JDG.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naba omuyaasii muIsiraeli emiyika amakhumi kabili nachitaru, mana nafwa, nayabilwa eShamiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana inyumawe Yairi emuGileadi nabuukha; naye naba omuyaasii muIsiraeli emiyika amakhumi kabili nachibili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.3",
            "verseOrgIds": [
              "JDG.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali nabaanabe abasiani amakhumi kataru, abachendela khubimoosi bietsisishili amakhumi kataru, nibali namataala amakhumi kataru, akalangwa mbu Hawotsiyairi okhuula olwa leelo, akali mushialo shiaGileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.4",
            "verseOrgIds": [
              "JDG.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yairi nafwa, nayabilwa eKamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaAmoni bamiina Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana baIsiraeli bakhola akali amabii mumoni tsiOMWAMI khandi, nibakhalabanila abaBaali, nabaAshitarotsi, nabanyasaye baSiria, nabanyasaye baSidoni, nabanyasaye baMoabu, nabanyasaye babaana baAmoni, nabanyasaye babaFilistini balekha OMWAMI, nibaramukhalabanila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburima bwOMWAMI nibwashila Isiraeli, nabakusia mumukhono kwabaFilisiti, khandi mumukhono kwabaana baAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.7",
            "verseOrgIds": [
              "JDG.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibasasaka abaana baIsiraeli, nibabasandia omuyika okwo; kata emiyika ekhumi namunaane basandinjia abaana baIsiraeli bosi abali injelekha weYorodani, mushialo shiabaAmori, eshili muGileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.8",
            "verseOrgIds": [
              "JDG.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaana baAmoni nabo nibaambukha Yorodani okhuseera Yuda naBenyamini neinzu yaEfuraimu; Isiraeli niyiba mumatinyu muno.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.9",
            "verseOrgIds": [
              "JDG.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.9",
            "verseOrgIds": [
              "JDG.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana baIsiraeli nibahaabila OMWAMI, bari Khukhwonooneele nikhulekha Nyasaye weefwe nikhukhalabaniia emiBaali. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.10",
            "verseOrgIds": [
              "JDG.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nasunjila abaana baIsiraeli ari Shindamuhonia mubaMisiri, nomubaAmori, nomubaana baAmoni, nomubaFilisiti? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.11",
            "verseOrgIds": [
              "JDG.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abaSidoni bosi, nabaAmaleki, nabaMaoni, bamusandinjia; neenyu nimuhaabila, nasi nimuhonia mumakhono kabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.12",
            "verseOrgIds": [
              "JDG.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mwandekha, nimukhalabanila abanyasaye bandi; niko akachila shindalamuhonia khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.13",
            "verseOrgIds": [
              "JDG.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsie muhaabile abanyasaye aba mwalobola; bo bamuhonie mumasila keenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.14",
            "verseOrgIds": [
              "JDG.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibasunjila OMWAMI bari Iihwoonoona; okhukholele aka oluutsi; nebutswa khukhusaaya mbu okhuhonie leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
              "JDG.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibarusiaho abanyasaye abacheni abali hakari wabwe, nibamukhalabanila OMWAMI; naye nabeelelela amatinyu kaIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana baAmoni nibakhung'aana halala, nibakhupa ikambi eGileadi. Nabo abaana baIsiraeli nibalchung'aana halala, nibakhupa ikambi eMizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.17",
            "verseOrgIds": [
              "JDG.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabandu abo, abakhulundu baGileadi, nibasungana abeene khubeene bari Niwina ounochaache okhuseera abaana baAmoni? Alaba omurwe kwabosi abamenya muGileadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.18",
            "verseOrgIds": [
              "JDG.10.18"
            ]
          }
        }
      ]
    }
  ],
