{
  "id": "JHN.16",
  "number": "16",
  "bookId": "JHN",
  "reference": "Yohana 16",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JHN 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa kano emubooleele, mbu muleshe okhwisichirasibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamurusia mutsisinagogi; toto, eshise shili okhwitsa olwa omundu yesi oumwira inywe alakaala mbu amukhalabanila Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.2",
            "verseOrgIds": [
              "JHN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namakhuwa ako balakhola shichila shibamumanya Papa kata isie ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.3",
            "verseOrgIds": [
              "JHN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kano emubooleele, mbu olwa eshise shiabwe shiba nishiulile, mukeetsulile, shinga olwa ndamuboolela.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.4",
            "verseOrgIds": [
              "JHN.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kano shindamuboolela okhurula khukhuchaaka ta, shichila ndali nineenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.4",
            "verseOrgIds": [
              "JHN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano enzia khu oyo owaruma; nabulaho mwinywe oureeba, mbu Otsia heena? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.5",
            "verseOrgIds": [
              "JHN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhuba emubooleele amakhuwa kano, eshibeela shiitsuule mumioyo chieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.6",
            "verseOrgIds": [
              "JHN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa emuboolela akatoto, mbu kamukhoyeele mbu nzinyoshe; okhuba nimba nindeenyokha ta, Omuhabini shialamwitsila tawe; ne nimba ninzia, ndalamuruma khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye olwa alaba niyeetsile alahula eshialo mushiina khumakhuwa kobwonooni, nende akobulunjishi, nende akobukhalachi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.8",
            "verseOrgIds": [
              "JHN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akobwonooni, shichila shiba'suubilila ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.9",
            "verseOrgIds": [
              "JHN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akobulunjishi, shichila enzia ewaPapa, neenyu shimulandola khandi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akobukhalachi, shichila omukhulundu weshialo shino amalile okhukhalachilwa eshiina.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshili nende amakhuwa amanji okhumuboolela, ne shimukanyala bulaano tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa ye, niye Roho wobwatoto, alaba niyeetsile, alamwibaalila mubwatoto bwosi; okhuba shialasunga khukeke omwene ta; ne akeenako kosi aka alahulilanga, niko aka alaboolanga; khandi alamurumbulila amakhuwa akeetsa okhwitsa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alambeelesia oluyali; okhuba alabukula khukanje, nakarumbulila inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.14",
            "verseOrgIds": [
              "JHN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosi aka Papa ali ninako, nakanje; niko akachila nimboola mbu abukulanga khukanje, nakarumbulila inywe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.15",
            "verseOrgIds": [
              "JHN.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshibeela okhukalulwa okhwikhoya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.15",
            "verseOrgIds": [
              "JHN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neshise eshitiiti butswa, mana shimulandola khandi ta; khandi neshise shindi eshitiiti, mana mulandola. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.16",
            "verseOrgIds": [
              "JHN.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandi abokhubeechibe nibareebana, bari Namakhuwa shiina kano aka akhuboolelanga, mbu Neshise eshitiiti butswa, nimurandola ta; khandi neshise shindi eshitiiti, mana mulandola; khandi mbu Shichila enzia khuPapa? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibareeba bari Nelikhuwa shiina lino elia aboolanga, mbu Eshise eshitiiti? Shikhumanyile elia aboola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yalola shinga olwa beenya okhumureeba, nabasunjila ari Mureebananga khwikhuwa elo elia emboolile, mbu Neshise eshitiiti butswa, mana nimurandola ta; khandi neshise shindi eshitiiti, mana mulandola? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, emusunjila mbu mulalila nimwikhuula, nashio eshialo shileekhoya; mulabeelela, ne eshibeela shieenywe shilakalulwa okhwikhoya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.20",
            "verseOrgIds": [
              "JHN.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhasi olwa alumwa okhwibula aba neshibeela, shichila eshiseshie shiulilene olwa aba namalile okhwibula omwana, shiyeetsulila amanyakhano ako khandi ta, khulwa okhwikhoyela omundu owibuulwe mushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.21",
            "verseOrgIds": [
              "JHN.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila inywe nimuli neshibeela bulaano; ne ndakhamulole khandi, mana emioyo chieenywe chiakheekhoye, ne abulaho oulamubukula okhwikhoya khweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.22",
            "verseOrgIds": [
              "JHN.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata khunyanga eyo shimula'reeba likhuwa liosi ta. Toto mwene, emusunjila mbu nimuba nimusaaya Papa likhuwa liosi, alamuheelesia muliira lianje. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
            "verseOrgIds": [
              "JHN.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuula bulaano mushili okhusaaya likhuwa liosi muliira lianje; sabe, ne mulanyoola, mbu okhwikhoya khweenywe khwitsule.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
            "verseOrgIds": [
              "JHN.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isie emalile okhuhula eshialo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
            "verseOrgIds": [
              "JHN.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa kano emubooleele munjelo; eshise shili okhwitsa olwa ndaramuboolela munjelo khandi ta, ne ndalamuboolela habulafu akaPapa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
              "JHN.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga eyo mulasaaya muliira lianje; nasi shimuboolela mbu ndalasaaya Papa khulweenywe ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
            "verseOrgIds": [
              "JHN.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba Papa omwene amuheelanga, shichila mwayaheelile isie, nimusuubila shinga olwa ndarula khuPapa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndarula ewaPapa, ninzitsa mushialo; khandi ndalalekha eshialo, ninzia ewa Papa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
            "verseOrgIds": [
              "JHN.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
            "verseOrgIds": [
              "JHN.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechibe nibasunga bari Lola, bulaano oboolanga habulafu, noraboola oluchelo lwosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
              "JHN.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulaano khumalile okhumanya mbu iwe wamanya amakhuwa kosi, kata shikakhoyeele mbu omundu yesi akhureebekhwo ta; niko akachila nikhusuubila mbu khane warula ewaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nabakalusia mbu Kho bulaano mwakhasuubila? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, eshise shili okhwitsa, toto, shimalile okhuula, olwa mulaba nimusalaanile, buli mundu natsiile ewabwe, nimundekha isie sienyene; nebutswa shindi sienyene ta, shichila Papa ali ninasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.32",
            "verseOrgIds": [
              "JHN.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa kano emubooleele, mbu mwisie mube nomulembe. Mushialo muli nende amasila; ne leme emioyo; isie emalile okhuhula eshialo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.33",
            "verseOrgIds": [
              "JHN.16.33"
            ]
          }
        }
      ]
    }
