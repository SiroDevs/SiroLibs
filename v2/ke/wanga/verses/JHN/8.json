{
  "id": "JHN.8",
  "number": "8",
  "bookId": "JHN",
  "reference": "Yohana 8",
  "verseCount": 59,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JHN 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukhasi owanyoolelesibwa naheyanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Nibatsia buli mundu ebunanzu wuwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.53",
            "verseOrgIds": [
              "JHN.8.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.53",
            "verseOrgIds": [
              "JHN.8.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu yatsia enashikulu shiFmitseituni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.1",
            "verseOrgIds": [
              "JHN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mumabwibwi niyeenjila khandi muhekalu, abandu bosi nibamwitsila; niyeekhala, nabeechesia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.2",
            "verseOrgIds": [
              "JHN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahandiichi nende abaFarisayo nibaleera omukhasi owanyoolelesibwa naheya; nibamusinjisia hakari, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.3",
            "verseOrgIds": [
              "JHN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibamusunjila bari Omwechesia, omukhasi uno yanyoolelesiibwe mukhukhola khwene naheya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.4",
            "verseOrgIds": [
              "JHN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mumalako Musa yakhulaka mbu khubalase abafwana bario namachina; kho nawe osunga orie khuye? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.5",
            "verseOrgIds": [
              "JHN.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne basunga bario nibamuteema, mbu babe nende elia bamwinjilila ninalio. Naye Yesu niyeenama hasi, nahandijka nende olwalalwe hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.6",
            "verseOrgIds": [
              "JHN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa balumilila okhumureeba, yachinguukha, nabasunjila ari Omundu khwinywe oubula eshionoono, abe ye ouranjilila okhumulasa nelichina. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.7",
            "verseOrgIds": [
              "JHN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyeenama khandi, nahandiika nende olwalalwe hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.8",
            "verseOrgIds": [
              "JHN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo olwa bahulila bario, barula mulala mulala, nibachaachila khuwashila obukofu, kata okhuula khuwamaliilikha; naye Yesu natong'a yenyene, nomukhasi ewa yali hakari yaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.9",
            "verseOrgIds": [
              "JHN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nachinguukha, namureeba ari Mama, bali heena? Shialiho omundu oukhukhalachila eshiina? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.10",
            "verseOrgIds": [
              "JHN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia ari Abulaho, Omwami. Yesu nasunga mbu Kata siesi shikhukhalachila eshiina ta; tsia butsia, nokhurula olwa leelo oroonoona khandi ta.]",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu niye obulafu bweshialo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yesu nabasunjila khandi, ari Isie nisie obulafu bweshialo; ounondakhwo shialachenda mushiilima ta, ne alaba nobulafu bwobulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.12",
            "verseOrgIds": [
              "JHN.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaFarisayo nibamusunjila mbu Wirumbulilanga omwene akobuloli; oburumbusibwo shibuli obwatoto ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.13",
            "verseOrgIds": [
              "JHN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nakalusia nabasunjila mbu Kata nindirumbulila omwene obuloli, obuloli, oburumbusi bwanje nobwatoto; okhuba emanyile ewa ndarula, nende ewa enzia; ne inywe shimumanyile ewa ndarula kata ewa enzia tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.14",
            "verseOrgIds": [
              "JHN.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe mukhalachilanga khukomubili; isie shikhalachilanga omundu yesi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.15",
            "verseOrgIds": [
              "JHN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto, ne nimba nikhalakanga, obukhalachi bwanje nobwatoto; okhuba shindi sienyene ta, habula isie halala nende Papa owaruma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.16",
            "verseOrgIds": [
              "JHN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto, ne mumalako keenywe kahandiikwa mbu oburumbusi bwobuloli bwabandu babili nobwatoto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.17",
            "verseOrgIds": [
              "JHN.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nisie omwenoyo owirumbulilanga omwene akobuloli, khandi Papa owaruma yandumbulila akobuloli. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.18",
            "verseOrgIds": [
              "JHN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamureeba bari So ali heena? Yesu nakalusia mbu Shimumanyile kata isie kata Papa ta; nimuba nimwakhamanyile isie mwakhamumanyile nende Papa yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.19",
            "verseOrgIds": [
              "JHN.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaboola amakhuwa ako olwa yali niyeechesinjia muhekalu, nali hebiishilo; ne yabulaho owamutiilakhwo, shichila eshiseshie shiali nishishili.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.20",
            "verseOrgIds": [
              "JHN.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ewa enzia, shimunyala okhwitsayo ta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.20",
            "verseOrgIds": [
              "JHN.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nabasunjila khandi, ari Isie nzinyokha, ne mula'khaaba; ne mulafwila mubwonooni bweenywe; ewa enzia, shimunyala okhwitsayo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.21",
            "verseOrgIds": [
              "JHN.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaYahudi nibasunga bari Yeetsa okhwiyira omwene noho? Shichila aboola mbu Ewa enzia, shimunyala okhwitsayo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.22",
            "verseOrgIds": [
              "JHN.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nababoolela mbu Inywe muli abahasi; isie endi oweikulu. Inywe muli abeshialo shino; isie shindi oweshialo shino tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.23",
            "verseOrgIds": [
              "JHN.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachilile nimusunjiile mbu mulafwila mubionoono bieenywe; shichila nimurasuubila mbu ISIE NISIE ta, mulafwila mubionoono bieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.24",
            "verseOrgIds": [
              "JHN.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamureeba bari Niwe wina? Yesu nababoolela mbu Kata nakeenako aka ndamubooleele okhurula khukhuchaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.25",
            "verseOrgIds": [
              "JHN.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endi nende amakhuwa amanji okhuboola nende okhukhalaka khwinywe; nebutswa owaruma nowatoto; nakeenako aka ndahulila okhurula khuye emboolela eshialo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.26",
            "verseOrgIds": [
              "JHN.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shibatiila khushisina, mbu yababoolela akaSamwana, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.27",
            "verseOrgIds": [
              "JHN.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yesu nasunga mbu Olwa muliba nimumuchinguulile Omwana wOmundu, habwenaho mulimanya mbu ISIE NISIE, khandi mbu shikholanga likhuwa liosi khubwanje ta, habula shinga Papa olwa yanzechesia, nolwa emboolanga amakhuwa kano. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.28",
            "verseOrgIds": [
              "JHN.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye owaruma ali ninasi; shiyayandekha sienyene ta; okhuba tsindaalo tsiosi ekholanga akeenako akamuchamisia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.29",
            "verseOrgIds": [
              "JHN.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yali nashiboola amakhuwa ako, abanji nibamusuubilila.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.30",
            "verseOrgIds": [
              "JHN.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwatoto bulamukhola abalekhuule",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.30",
            "verseOrgIds": [
              "JHN.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yesu yabasunjila abaYahudi abo abali nibamusuubiliile ari Nimuba nimumenya mwikhuwa lianje, kho muba abeechi banje toto; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.31",
            "verseOrgIds": [
              "JHN.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mulamanya obwatoto; nabwo obwatoto bulamukhola abalekhuule. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.32",
            "verseOrgIds": [
              "JHN.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibamukalusia bari Iwfe khuli olwibulo lwaAburahamu; khushili okhubakhwo mububohwi khumundu yesi tsindaalo tsiosi ta; nawe oboola orie mbu Mulakholwa abalekhuule? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.33",
            "verseOrgIds": [
              "JHN.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nabakalusia ari Toto mwene, emusur jila mbu buli mundu oukholanga ebionoono nomusumba wobwonooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.34",
            "verseOrgIds": [
              "JHN.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusumba shiamenya munzu obushia nobushia ta; omwana amenyanga obushia nobushia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.35",
            "verseOrgIds": [
              "JHN.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Omwana naba namukhola abalekhuule, mulaba abalekhuule toto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.36",
            "verseOrgIds": [
              "JHN.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emanyile shinga olwa muli olwibulo lwaAburahamu; ne mukhaabanga okhunzira, shichila likhuwa lianje shilinyoola obwiyangu mwinywe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.37",
            "verseOrgIds": [
              "JHN.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emboolanga akeenako aka ndaluutsi halala nende Papa; neenyu mwesi mukholanga akeenako aka mwahuliile khuseenywe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.38",
            "verseOrgIds": [
              "JHN.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Setani niye seenywe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.38",
            "verseOrgIds": [
              "JHN.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakalusia nibamusunjila mbu Seefwe niye Aburahamu. Yesu nabasunjila mbu Nimuba nimuli abaana baAburahamu, khole emilimo chiaAburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.39",
            "verseOrgIds": [
              "JHN.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano mukhaaba okhunzira isie, omundu oumubooleele akatoto, aka ndahulila okhurula khuNyasaye; Aburahamu shiyakhola ario ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.40",
            "verseOrgIds": [
              "JHN.8.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 8:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe mukholanga emilimo chiaseenywe. Nibamusunjila bari Ifwe shikhwayeebulwa mubuheyi ta; khuli nende Seefwe mulala, niye Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.41",
            "verseOrgIds": [
              "JHN.8.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 8:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nabasunjila ari Nyasaye alaba nali Seenywe, khane mwakha'heela isie; shichila ndarula khuNyasaye ninzitsa; okhuba kata shindayeetsa khubwanje ta, habula ye yaruma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.42",
            "verseOrgIds": [
              "JHN.8.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 8:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbushiina nimuratiila khushisina shiokhuboola khwanje ta? Mbula, shichila shimuhulilanga likhuwa lianje ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.43",
            "verseOrgIds": [
              "JHN.8.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 8:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe muli baseenywe Setani, nobwikombi bwaseenywe nibwo obwa mwenyanga okhukhola. Ye yalinji omwiri okhurula khukhuchaaka, narasinjila mubwatoto ta, shichila obwatoto bubula muye. Olwa aboola obubeeyi, aboola khukeke omwene; okhuba niye omubeeyi, khandi nomwibusi wabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.44",
            "verseOrgIds": [
              "JHN.8.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 8:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa okhuba emboolanga obwatoto, shimusuubilanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.45",
            "verseOrgIds": [
              "JHN.8.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 8:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwina khwinywe ouhula mushiina mbu endi omwonooni? Nimba nimboola obwatoto, mbushiina nimurasuubila ta? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.46",
            "verseOrgIds": [
              "JHN.8.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouli waNyasaye ahulilanga amakhuwa kaNyasaye; ne niko akachila nimurakahulilanga ta, mbu shimuli baNyasaye tawe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.47",
            "verseOrgIds": [
              "JHN.8.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu nende Aburahamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.47",
            "verseOrgIds": [
              "JHN.8.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 8:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaYahudi nabo nibakalusia nibamusunjila bari Shikhuboola habwene mbu oli omuSamaria, khandi oli nelidimoni? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.48",
            "verseOrgIds": [
              "JHN.8.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 8:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nakalusia ari Isie, lidimoni shilili mwisie ta; nebutswa isie eheelesinjia Papa oluyali, ne inywe mufwolanga oluyali lwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.49",
            "verseOrgIds": [
              "JHN.8.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 8:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi shikhaabanga oluyali lwanje omwene ta; aliho oukhaabanga nende okhuyaasia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.50",
            "verseOrgIds": [
              "JHN.8.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 8:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, emusunjila mbu omundu naba nahulila likhuwa lianje, shialalolakhwo khukhufwa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.51",
            "verseOrgIds": [
              "JHN.8.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 8:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaYahudi abo nibamusunjila bari Bulaano khumanyile shinga olwa oli nende lidimoni. Aburahamu yafwa, nende abanabii; nawe oboola mbu Omundu naba nahulila likhuwa lianje, shialakoonyelelakhwo khukhufwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.52",
            "verseOrgIds": [
              "JHN.8.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe oshila kuuka weefwe Aburahamu, owafwa, noho? Khandi abanabii nabo bafwa; wikhola wina? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.53",
            "verseOrgIds": [
              "JHN.8.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nakalusia mbu Nimba nindiheelesia oluyali, kho oluyali lwanje nibutswa; Papa niye oumbeelesia oluyali; owa neenyu muboolangakhwo mbu niye Nyasaye weenywe; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.54",
            "verseOrgIds": [
              "JHN.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JHN 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "khane shimumumanyile ta; nasi ndamumanya; ne kata nimba ningaana mbu shindamumanya tawe, ndakhaba omubeeyi shingana inywe; nebutswa ndamumanya, khandi embulilanga likhuwalie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.55",
            "verseOrgIds": [
              "JHN.8.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JHN 8:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuka weenywe Aburahamu yeekhoyela okhulola induukho yanje; nachilola, nasangaala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.56",
            "verseOrgIds": [
              "JHN.8.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JHN 8:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaYahudi nibamusunjila bari Iwe oshili okhuula khumiyika amakhumi karaano; ne wamulola Aburahamu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.57",
            "verseOrgIds": [
              "JHN.8.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JHN 8:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nababoolela ari Toto mwene, emusunjila mbu Olwa Aburahamu yali nashili okhubaho, ISIE NISIE. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.58",
            "verseOrgIds": [
              "JHN.8.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JHN 8:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibatoola amachina okhumulasa; ne Yesu niyeebisa, narula muhekalu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.59",
            "verseOrgIds": [
              "JHN.8.59"
            ]
          }
        }
      ]
    }
  ],
