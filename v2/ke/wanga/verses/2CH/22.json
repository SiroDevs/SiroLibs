    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaAhazia waYuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbeYerusalemu nibeemekha Ahazia omwanawe omushe, abe omuruchi mushilenjeshie; okhuba ing'anda yabandu abali nibeetsile nende abaArabu mukambi beera abaana babwe abakhulundu bosi. Kho Ahazia waYehoramu omuruchi waYuda naruka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia yali owemiyika amakhumi kane nachibili olwa yachaaka okhuruka; naruchila eYerusalemu omuyika mulala; ne eliira lianyina liali Atsalia, omwitsukhulu waOmiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye yesi nachenda munjila tsieinzu yaAhabu; okhuba nyina yamwibaalilanga okhukhola obubii. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola akali amabii mumoni tsiOMWAMI, shinga abeinzu yaAhabu olwa bakholaokhuba bo bali abeebaalibe olunyuma Iwokhufwa khwasamwana, akabwe nikamuleerela obwonooneshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yachenda mubwibaali bwabwe natsia naYehoramu waAhabu, omuruchi waIsiraeli, okhuseerela Hazaeli omuruchi waSiria eRamotsi-gileadi; abaSiria nibamufumira Yoramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalukha okhusilishilwa amafumireke eYezereeli, aka bamufumirila eRama olwa yaseera Hazaeli omuruchi waSiria. Naye Ahazia waYehoramu omuruchi waYuda nakholomokha, natsia okhukoonya Yehoramu waAhabu eYezereeli, shichila yali omulwale.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehu yeera Ahazia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhukwisibwa khwaAhazia khwarula khuNyasaye, olwa yatsia ewaYoramu; okhuba olwa yoolayo, yatsia nende Yehoramu okhuseera Yehu waNimishi, owa OMWAMI yali natsushiilekhwo amafura okhwakamia inzu yaAhabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Yehu yali nakuumanga inzu yaAhabu, yanyoola abakhulundu baYuda, nabaana babasiani babwe Ahazia, nibakhalabanilanga Ahazia; nabeera. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhaaba Ahazia, nibamuhamba olwa yali niyeebisile eSamaria, nibamuleera ewaYehu, nibamwira, nibamuyabila, okhuba basunga mbu Nomwana waYehoshafati, owakhaaba OMWAMI nomwoyokwe kwosi. Nebutswa inzu yaAhazia yabula omundu owakhanyala okhulinda oburuchi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atsalia yeeba oburuchi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa Atsalia nyina Ahazia yalola mbu omwanawe ufwile, varula natibia bosi abali bolwibulo Iwomuruchi, abeinzu yaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Yehoshabeatsi, omukhaana womuruchi, yabukula Yoashi waAhazia, namwiba namurusia mubaana bomuruchi abali nibali okhwirwa, namura mushisika shiokhukona, nomulesiwe yesi. Kho Yehoshabeatsi omukhaana womuruchi Yehoramu, mukha Yehoyada omukuhani, okhuba yali mbootsonyene Ahazia, yamubisa, Atsalia aleshe okhumunyoola; mbu mana aleshe okhumwira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali ninabo ario, nibabiswa munzu yOMWAMI emiyika chisasaba; naye Atsalia naruka eshialo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
      ]
    }
  ],
