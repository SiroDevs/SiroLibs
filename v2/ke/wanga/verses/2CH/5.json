      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio emilimo chiosi echia Sulemani yakholela inzu yOMWAMI chiamalilisibwa. Sulemani naleeramwo ebindu ebia Daudi samwana yali niyaahula; mbu ifeetsa, neitsahaabu, nebimanulwa biosi, nabibiikha mumabiishilo keinzu yaNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sulemani yeenjisia lisanduku muHekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Sulemani yakhung'aasia abakofu baIsiraeli, nabeemilisi bosi betsimbia, abakhulundu bebilibwa biabaana baIsiraeli, eYerusalemu, khulwa okhutikulusia lisanduku iieindakano yOMWAMI okhurula mwitookho liaDaudi, nilio Sayuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi baIsiraeli nibakhuewomng'aana uruchi khwisabo eliali mumwesi kwomusaafu ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakofu bosi baIsiraeli nibeetsa, abaLawi nabo nibachinga lisanduku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibatikulusia lisanduku, neliheema liokhwakaana, nebimanulwa ebitakatifu biosi ebiali nibili mwiheema; ebienebio biosi abakuhani nende abaLawi babileera. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi Sulemani, nomukhung'aano kwosi kwaIsiraeli, okwali nikukhung'aaniile ewuwe, bali imbeli welisanduku, nibamalanga emisango chiamakondi netsing'ombe, echirachelekha kata okhubalikha obunji bwachio ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abakuhani nibeenjisia lisanduku lieindakano yOMWAMI habundu walio, mushisika tsana shiomunzu mukari, habundu ahashila obutakatifu, hasi wetsimbaha tsiabakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abakerubi babambula tsimbaha tsiabwe ikulu wahabundu welisanduku, abakerubi nibafuunikha lisanduku netsinyanzo tsialio hekulu bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsio tsinyanzo tsana tsiali tsirambi muno, emirwe chiatsio nichiloleshela abali heesanduku imbeli weshisika shiahakari; ne shitsialolekha elwanyi ta; ne tsishiliyo tsirio okhuula olwa leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwisanduku shimwalimwo eshindu ta, habula orubaho rwamachina rubili orwa Musa yareelamwo eHorebu, ewa OMWAMI yalakana nabaana baIsiraeli indakano, olwa bali nibarulile mushialo shiaMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abakuhani bali nibarulile habundu ahatakatifu, okhuba abakuhani bosi abali nibaliyo bali nibeeyahuule abeene, nibaralonda khukemikanda chiabwe ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata nende abaLawi abali abeembi, bosi pe, banga Asafu, naHemani, naYedutsuni, nende abaana aba beebula, nabaana babwe, bali nibeefwalile ikitani indorotoro, nibali nebisili namatungu nobukhana; nibasinjila hashimalilo ebukwe, halala nabakuhani eshikhumi namakhumi kabili abakhupanga tsitarumbeta; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana aboopi betsitarumbeta nende abeembi bali shingana omulala, nibahulilisia omwoyo mulala mukhwitsoomia nokhuupila Nyasaye orio; kho olwa bachinguulila omwoyo halala netsitarumbeta nebisili nebikholelo biosi biobukhana, nibamwitsoomia OMWAMI, bari Okhuba niye omulayi, okhuba obuheelibwe oburalilu nobwobumeli; kho habwenaho inzu niyiitsulamwo lileesi, inzu yOMWAMI tsana, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuula olwa abakuhani bakhaywa okhusinjila okhukhalabana, khulwa lileesi; okhuba oluyali lwOMWAMI Iweetsula munzu yOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
      ]
    }
  ],
