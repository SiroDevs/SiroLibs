    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omunabii Yehu yamukondeshela Yehoshafati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehoshafati omuruchi waYuda nakalukha ebunanzuwe eYerusalemu shisale. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.1",
            "verseOrgIds": [
              "2CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yehu waHanani, omunabii narula natsia okhumubukaanila, nasunjila omuruchi Yehoshafati ari Kakhoyeele mbu ohabine ababii, nobaheela abo abamukiyanga OMWAMI, noho? Khulwa likhuwa elo, oburima buli khwiwe, oburula khuMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.2",
            "verseOrgIds": [
              "2CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa kaliho amalayi kandi akanyooleshela mwiwe, mbu warusiaho emiAshera mushialo, norakhwo omwoyo okhukhaaba Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoshafatiyaraho abayaasii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Ychoshafati yamenyanga eYerusalemu; narula khandi nachenda mubandu, okhurula eBeeri-sheba okhuula khushialo shiebikulu shiaEfuraimu, nabakalusia ewOMWAMI, Nyasaye wabakuuka babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.4",
            "verseOrgIds": [
              "2CH.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nara abayaasii mushialo, mumataala kosi ketsingoba kaYuda, elala elala, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.5",
            "verseOrgIds": [
              "2CH.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "naboolela abayaasii abo ari Yililisie khuka mukholanga; okhuba shimuyaasilinjia omundu namundu ta, habula OMWAMI; naye ali nineenywe mubuyaasii. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.6",
            "verseOrgIds": [
              "2CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano oburii bwOMWAMI bube khwinywe; mwirecheshe, mukhole; okhuba bubulaho obukhalachi obushiamu bwosi khuMWAMI Nyasaye weefwe, kata ebiela, kata okhubukula ebiomufuusi ta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi muYerusalemu Yehoshafati yaramwo abandi abokhubaLawi nabakuhani, nabokhubeemilisi bebilibwa biaIsiraeli, khulwa obuyaasii bwOMWAMI, khandi khulwa ebifunaane. Bali nibakalukhanga eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabalachilisia ari Mukholenje muri nanwa, muburii bwOMWAMI, mubwisiikwa, nende omwoyo kwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata buli lwosi olwa eshifunaane shilamwitsila okhurula mubaana beenywe abamenya mumataala kabwe, hakari wobwiri nobwiri bundi, hakari wameebaalo nelilako, hakari wakakachilisibwa nende akobukhalachi, mubachesiyie, baraba neshikha imbeli w, oburima nibumwitsila halala nabaana beenywe ta; kholenje murio, muleshe okhuba neshikha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi lole, Amaria omukuhani omukhulundu nomusinjilili weenywe mumakhuwa kosi kOMWAMI; naye Zebedia waIshmaeli, omukhulundu weinzu yaYuda, mumakhuwa kosi komuruchi; abaLawi nabo balaba abakali abamukhalabanila. Mwitinyie, mukhole; ne OMWAMI abe nende abalayi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        }
      ]
    }
  ],
