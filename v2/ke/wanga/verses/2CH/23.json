        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwomusaafu Yehoyada yooma ikholo, nalakana nende abaseesia bebikhumi, mbu Azaria waYerohamu, Ishmaeli waYehohanani, Azaria waObedi, Maaseya waAdaya, naElishafati waZikhiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibachenda muYuda yosi, nibakhung'aasia abaLawi abarula mumataala kosi kaYuda, nabeemilisi bebilibwa biaIsiraeli, niboola eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhung'aano kwosi nikulakana nende omuruchi indakano munzu yaNyasaye. Yehoyada nabasunjila mbu Lole, omwana womuruchi ngwowuno! Alaruka shinga OMWAMI olwa yaboola khukabaana baDaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka mulakhola; mbu abandi khwinywe, eshitonye shiakhataru, abokhubakuhani nabaLawi abeetsa khumilimo khusabato, babe abalindi bebilibwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.4",
            "verseOrgIds": [
              "2CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "eshitonye shindi shiakhataru babe enanzu womuruchi; neshitonye shindi shiakhataru babe haShilibwa shiOmuse, abandu bosi nabo babe munyanyi tsieinzu yOMWAMI ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi aleshe okhwinjila munzu yOMWAMI, habula abakuhani nende abaLawi abakhalabananga; bo beenjile, okhuba nabatakatifu; habula abandu bosi balalinda aka OMWAMI yalaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaLawi bamufumbile omuruchi tsimbeka tsiosi, buli mundu nende ebimanulwabie mumukhono; kata omundu yesi owinjila munzu, yeerwe; mube nomuruchi halala, mukhwinjilakhwe nomukhurulakhwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaLawi nabaYuda bosi bakhola kosi aka Yehoyada omukuhani yalaka shinga olwa kali; nibabukula buli mundu abandube, abo abali nibali okhwinjila khusabato, halala nende abo abali nibali okhurula khusabato; okhuba Yehoyada omukuhani shiyaseebula emikanda tsana ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.8",
            "verseOrgIds": [
              "2CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yehoyada omukuhani naheelesia abaseesia bebikhumi amafumo netsingabo nebikhumba ebiali nibili ebiomuruchi Daudi, nibili munzu yaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.9",
            "verseOrgIds": [
              "2CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naraho abandu bosi, buli mundu nali nebimanulwabie mumukhono, okhurula khulubeka Iwomukhono musaatsa Iweinzu okhuula khulubeka Iwomukhono mukhasi Iweinzu, hashimalilo shiemisango nende inzu yomuruchi, okhubibotokhana, nokhufumbila omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.10",
            "verseOrgIds": [
              "2CH.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibamurusia omwana womuruchi, nibamurakhwo olusimbi, nibamuheelesia eshioburumbusi, nibamwemekha abe omuruchi; Yehoyada nabaanabe nibamutsushiilila amafura; nibasunga mbu Omuruchi ayindile!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Atsalia yahulila obuyoka bwabandu nibeelukha nibamwitsoomia omuruchi, yatsia ewa abandu bali, niyeenjila munzu yOMWAMI; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nahenga, ne lola ngako, omuruchi nasinjiile hasiiloye mubwinjililo, nabaseesia nabetsitarumbeta ahambi nomuruchi; abandu bosi beshialo nibeekhoya, nibakhupa tsitarumbetaabeembi nabo nibakhupa ebimanulwa biobukhana, nibareleesia tsinyimbo tsiobwitsoomii. Mana Atsalia narandula tsingubotsie, nalanjisia mbu Nobukhobani! Nobukhobani! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.13",
            "verseOrgIds": [
              "2CH.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehoyada omukuhani narusia abaseesia abasinjililanga lihe, ari Mumurusie hakari wetsinyaali; ne omundu yesi oumulondakhwo, yeerwe nolukanga. Okhuba omukuhani yaboola mbu Muramwirila munzu yOMWAMI ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamuhamba; naye nabirila mubwinjililo bweshilibwa shietsifarasi shieinzu yomuruchi; nibamwirilayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.15",
            "verseOrgIds": [
              "2CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.15",
            "verseOrgIds": [
              "2CH.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehoyada nakhola indakano hakari wuwe omwene nabandu bosi nomuruchi, mbu babe abandu bOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi nibatsia enanzu yaBaali, nibachilikulula, nibasasaka ebimalilo biakwo nebifwanani biakwo ebitonye ebitonye, nibeerela Matani omwisaaliisii waBaali imbeli webimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.17",
            "verseOrgIds": [
              "2CH.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada naraho abasinjilili khunzu yOMWAMI, mubunyali bwabakuhani abaLawi, aba Daudi yali niyakabula munzu yOMWAMI, okhumalanga emisango emisambe ChiOMWAMI, shinga olwa kahandiikwa mumalako kaMusa, nokhwikhoya nende okhwimba, okhulonda khwilako liaDaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yaraho abalindi tsana habilibwa bieinzu yOMWAMI, mbu omundu owakhaba nali mwibilu khulwa likhuwa liosi liosi aleshe okhwinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
            "verseOrgIds": [
              "2CH.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukula abaseesia bebikhumi, naboluyali, nabakafuna babandu, nende abandu bosi beshialo; nibakholomosia omuruchi okhurula khunzu yOMWAMI; nibabirila mushilibwa shiemukulu, niboola enanzu womuruchi, nibeekhasia omuruchi khushifumbi shioburuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.20",
            "verseOrgIds": [
              "2CH.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu bosi beshialo nibeekhoya; litookho niliholeela, nibamwirile Atsalia nolukanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.21",
            "verseOrgIds": [
              "2CH.23.21"
            ]
          }
        }
      ]
    }
  ],
