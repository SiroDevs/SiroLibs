        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Asa yakololosia mushialo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho waNyasaye yeenjila muAzaria waOdedi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.1",
            "verseOrgIds": [
              "2CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye narula okhumubukaanila Asa, namusunjila mbu Mumbulile, inywe Asa naYuda yosi, naBenyamini; mbu OMWAMI ali nineenywe olwa inywe muli ninaye; nimuba nimumukhaaba, alamunyooleshela; ne nimuba nimumulekha, yesi alamulekha inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa eshise eshirambi Isiraeli yali niyirali naNyasaye watoto, niyirali nomukuhani omwechesia, niyirali namalako ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa bamushiukhanila OMWAMI, Nyasaye waIsiraeli, mumatinyu kabwe, nibamukhaaba, yabanyooleshela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsienetsio shikwaliho omulembe kwosi khu oyo owasamulanga kata khu oyo oweenjilanga ta; habula obukoyaani obukhongo bwali khubosi abamenya mubialo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhalikha ebitonye ebitonye, lihanga khwihanga lindi, litaala khwitaala lindi; okhuba Nyasaye yabakoyaasia nende amatinyu kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.6",
            "verseOrgIds": [
              "2CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muume ikholo, amakhono keenywe kaleshe okhutendeya; okhuba emilimo chieenywe chilanyoola omurungo kwachio.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa Asa yahulila amakhuwa ako, obulakusi bwaOdedi omunabii, yooma ikholo, narusiaho ebisinyo ebieenamilungwa mushialo shiosi shiaYuda naBenyamini, nomumataala aka yali nabukuule mushialo shiebikulu shiaEfurami; nakasia obuyia eshimalilo shiOMWAMI, eshiali imbeli weshirookoola shieinzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhung'aasia Yuda naBenyamini yosi, nende abo abamenyangakhwo ninabo, abali nibarula muEfuraimu naManase, nomuSimeoni; okhuba abanji bahunzukha muIsiraeli nibamulondakhwo, olwa balola mbu OMWAMI Nyasayewe yali ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibakhung'aanila eYerusalemu mumwesi kwakhataru okwomumuyika kwekhumi nakharaano kwoburuchi bwaAsa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamalila OMWAMI emisango khunyanga eyo, echiokhubiyaayo ebia baleera; mbu tsing'ombe ebikhumi musaafu, namakondi ebikhumila musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeenjila mundakano yokhukhaaba OMWAMI, Nyasaye wabakuuka babwe, nende omwoyo kwosi neshiimo shiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu omundu yesi oukhaya okhukhaaba OMWAMI, Nyasaye waIsiraeli, yeerwe bwirwa, kata nali omutuutu kata omukhongo, omusaatsa kata omukhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeetsubila OMWAMI nomwoyo omukhongo, nende amakhu, netsitarumbeta, netsinzika. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaYuda bosi nibeekhoyela eshiitsubo eshio; okhuba bali nibeetsubile nomwoyo kwosi, nibamukhaaba nokhwenya khwabwe khwosi pe; naye nabanyooleshela. OMWAMI nabaheelesia obuhuluushi tsimbeka tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nende Maaka nyinamwana Asa omuruchi, yamurusiakhwo idaraja yanyina-muruchi, okhuba yali niyakhola eshifwanani eshisinyo shiaAshera; Asa narema eshifwananishie tsana, nashitubulila elala, nashisambila hamuchela kwaKidironi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.16",
            "verseOrgIds": [
              "2CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula habundu aheechingu hosi, shiharusibwa muIsiraeli ta; nebutswa omwoyo kwaAsa kwali habwene tsindaalotsie tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yaleera munzu yOMWAMI ebindu tsana ebia samwana yali niyaahuule, kata nende ebia ye omwene yali niyaahuule, mbu ifeetsa, neitsahaabu, nebimanulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.18",
            "verseOrgIds": [
              "2CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obusoolo niburabaho khandi ta, okhuula khumuyika kwamakhumi kataru nakharaano kwoburuchi bwaAsa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.19",
            "verseOrgIds": [
              "2CH.15.19"
            ]
          }
        }
      ]
    }
  ],
