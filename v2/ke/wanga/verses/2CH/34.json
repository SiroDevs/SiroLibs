          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi narumana, nakhung'aasia abakofu bosi baYuda naYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi natikulukha natsia munzu yOMWAMI, halala nabaYuda bosi, nabeYerusalemu bosi, nabakuhani, nabaLawi, nabandu bosi, ari abakhongo ari abatiiti; nasoomela mumarwi kabwe amakhuwa kosi keshitabu shieindakano eshianyoolwa munzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
