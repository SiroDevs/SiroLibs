          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachila bosi abanyoolwa muYerusalemu naBenyamini bachisinjilila. Nabo abeYerusalemu nibakhola akeindakano yaNyasaye, Nyasaye wabakuuka babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
