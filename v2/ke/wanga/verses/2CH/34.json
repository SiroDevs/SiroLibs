          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nasinjila habunduwe, nakhola indakano imbeli w, mbu okhulondanga khuMWAMI, nokhulinda amalakoke, noburumbusibwe, naka alachilisia, nomwoyokwe kwosi neshiimoshie shiosi, okhukhola amakhuwa keindakano tsana akahandiikwa mushitabu eshio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
