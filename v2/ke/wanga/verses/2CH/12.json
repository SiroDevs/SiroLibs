    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shishaki yeenjila muYuda nanZaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa oburuchi bwaRehoboamu bwali niburaliile, naye naba owamaani, yalekha amalako kOMWAMI, naIsiraeli yosi halala ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.1",
            "verseOrgIds": [
              "2CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumuyika kwakharaano kwomuruchi Rehoboamu, Shishaki omuruchi waMisiri yatikulukha okhuseera Yerusalemu, shichila bali nibakhayile OMWAMI, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.2",
            "verseOrgIds": [
              "2CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nali nende amakaari eshikhumila nebikhumi bibili nabachendela khufarasi ebikhumila amakhumi kasasaba; abandu aba yarula ninabo eMisiri shibabalikha ta; mbu abaLubi, nabaSuki, nabaEtiopia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.3",
            "verseOrgIds": [
              "2CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabukula amataala ako ketsingoba, akali kaYuda, niyoola eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.4",
            "verseOrgIds": [
              "2CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Shemaya omunabii namwitsila Rehoboamu, niyeetsela abakhulundu baYuda abali nibakhung'aanile eYerusalemu khulwa akaShishaki, nababoolela ari Kano niko aka OMWAMI aboola; mbu Mwayandeshile, kho nasi siesi emuleshile, mumukhono kwaShishaki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.5",
            "verseOrgIds": [
              "2CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakhulundu baIsiraeli nende omuruchi nibeetuutuyia; nibasunga mbu OMWAMI nomulunjishi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.6",
            "verseOrgIds": [
              "2CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa OMWAMI yalola shinga olwa beetuutuyia, likhuwa liOMWAMI lieetsela Shemaya, liri Beetuutuyiye; shindalabamulula ta; ne ndalabaheelesiakhwo obuhonia hatiiti, kata oburima bwanje shibulatsushilwa Yerusalemu khulwa omukhono kwaShishaki ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.7",
            "verseOrgIds": [
              "2CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa balakwa abasumbabe, mbu bamanye obusumba bwanje, nobusumba bwobwami bwebialo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.8",
            "verseOrgIds": [
              "2CH.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.8",
            "verseOrgIds": [
              "2CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Shishaki omuruchi waMisiri yatikulukha naseera Yerusalemu, nabukula amabiikho akomunzu yOMWAMI, namabiikho akomunzu yomuruchi; yabibukula biosi pe; nabukula nende ebikhumba bieitsahaabu ebia Sulemani yali niyakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.9",
            "verseOrgIds": [
              "2CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mushilenje shiabio, omuruchi Rehoboamu yakhola ebikhumba biomukasa, nabihaana mumakhono kabaseesia babalindi, abalindanga omuliango kweinzu yomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
            "verseOrgIds": [
              "2CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana buli lwosi olwa omuruchi yatsiitsanga munzu yOMWAMI, abalindi tsana beetsanga nibabichinga, nibabikalusia khandi mushisika shiabalindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yeetuutuyia omwene, oburima bwOMWAMI bwashiukhana nibumurulakhwo, aleshe okhumumalilanila elala; khandi amalayi kanyooleshela muYuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Rehoboamu niyeemeeta amaani muYerusalemu, naruka. Rehoboamu yali owemiyika amakhumi kane namulala olwa yachaaka okhuruka; naruchila muYerusalemu emiyika ekhumi namusaafu, mwitookho elia OMWAMI yali niyalobola mumbia tsiosi tsiaIsiraeli, okhuramwo eliiralie; ne eliira lianyina liali Naama, omukooko omuAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.13",
            "verseOrgIds": [
              "2CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii, shichila shiyarakhwo omwoyo okhukhaaba OMWAMI ta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.14",
            "verseOrgIds": [
              "2CH.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.14",
            "verseOrgIds": [
              "2CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kaRehoboamu, okhurula khukambeli okhuula khukahelelesia, shikahandiikwa mumakhuwa kaShemaya omunabii, naka Ido omulakusi, khukobulondokhani bwetsinzibulo? Obusoolo bwabeetsangaho hakari waRehoboamu naYeroboamu tsindaalo tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.15",
            "verseOrgIds": [
              "2CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu nakona nalonda khubakuukanyene; nayabilwa mwitookho liaDaudi; naye Abiya omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.16",
            "verseOrgIds": [
              "2CH.12.16"
            ]
          }
        }
      ]
    }
