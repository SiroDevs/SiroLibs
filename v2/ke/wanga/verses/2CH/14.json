    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaAsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Abiya nakona nalonda khubakuukanyene, nibamuyabila mwitookho liaDaudi; naye Asa omwanawe naruka mushilenjeshie; mundaalotsie eshialo shialenjeela emiyika ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.1",
            "verseOrgIds": [
              "2CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa nakhola akali amalayi nikali habwene mumoni tsiOMWAMI Nyasayewe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba yarusiaho ebimalilo ebicheni nahabundu aheechingu, nalikulula tsisiilo naremaka emiAshera; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.3",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalaka Yuda okhukhaabanga OMWAMI, Nyasaye wabakuuka babwe, nokhukholanga akameebaalo nakelilako. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yarusia mumataala kosi kaYuda habundu hosi aheechingu, nebimalilo biamalesi kelibuuliesi; oburuchi nibulenjeela mumukhonokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.5",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyoombakha amataala ketsingoba muYuda; okhuba eshialo shiali eshilenjeefu, kata shiyalikhwo nelihe liosi mumiyika echio ta; shichila OMWAMI yali namuhuluusiye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.6",
            "verseOrgIds": [
              "2CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yamusunjila Yuda mbu Chende khuumbashe amataala kano, khukabotolihasiekhwo tsingoba, neminaara, nebilibwa, nemiyinjiilo; eshialo shishiliho imbeli weefwe, shichila khwamukhaabile OMWAMI Nyasaye weefwe; khwamukhaabile, naye wakhuheelesiye obuhuluushi tsimbeka tsiosi. Kho niboombakha, nibakaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.7",
            "verseOrgIds": [
              "2CH.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Asa yali nende abelihebe abachinganga tsingabo namafumo, abandu ebikhumila ebikhumi bitaru abomuYuda; nabomuBenyamini, abachinganga ebikhumba nibakhwesa obuyingo, ebikhumila ebikhumi bibili namakhumi munaane; aho hosi hali ahalulu heitswoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.8",
            "verseOrgIds": [
              "2CH.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.8",
            "verseOrgIds": [
              "2CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zera omuEtiopia yarula okhubaseera, nali nende lihe liabandu ebikhumila eshikhumila, namakaari ebikhumi bitaru; niyoola eMaresha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.9",
            "verseOrgIds": [
              "2CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Asa narula okhwakaana ninaye, nibaanza amahe mwibanda liaZefatsa, eMaresha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.10",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa namuhaabila OMWAMI Nyasayewe, ari OMWAMI, abulaho oukhuhabina norali iwe ta, hakari wabamaani nende ababula obunyali; e OMWAMI Nyasaye weefwe, okhuhabine; okhuba khukhwisiikanga, ne muliiralio khwitsile okhuseera omukanda kuno omukhongo. E OMWAMI, niwe Nyasaye weefwe; omundu namundu aleshe okhukhuhula. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI nahula abaEtiopia imbeli waAsa, neimbeli waYuda; abaEtiopia nibeelukha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Asa nabandu aba yali ninabo nibabalondachilila, okhuula eGerari; ne ebweneyo abaEtiopia bakwisibwa okhuula olwa baratong'akhwo abalanyala okhuhela obusimbiilo ta; okhuba bamalilanwa imbeli w neimbeli welihelie; abaYuda nibachinga ebiyaayo ebinji muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibarootsa amataala kosi akabotokhana Gerari, okhuba oburisii bwOMWAMI bwabatiila; nibayaaya amataala ako; okhuba kalimwo ebiyaayo ebinji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barootsa nende amaheema kabemiruko, nibabukula amakondi amanji netsingamia; mana nibakalukha eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.15",
            "verseOrgIds": [
              "2CH.14.15"
            ]
          }
        }
      ]
    }
  ],
