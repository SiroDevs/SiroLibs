          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatakatifu bosi bamushiesiye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        }
