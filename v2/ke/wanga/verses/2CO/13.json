        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukoosia bwOmwami Yesu Kristo, nobuheeli bwaNyasaye, nobusanjilani bwaRoho Omutakatifu, bubeetsenje nineenywe mwesi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.14",
            "verseOrgIds": [
              "2CO.13.14"
            ]
          }
        }
      ]
