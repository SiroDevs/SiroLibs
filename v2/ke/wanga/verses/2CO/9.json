        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwikholeelela ebihaanwa biabatakatifu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwikhuwa liokhukhalabanila abatakatifu shibulaho eshichila nimuhandiichila; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.1",
            "verseOrgIds": [
              "2CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila emanyile shinga olwa mweerechekha, kata ndiyitsialanga khulweenywe imbeli wabaMakedonia, ndi abaAkhaya bamala okhwirechekha omuyika omulamba; ne obulumilifu bweenywe bubuusiye obunji bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.2",
            "verseOrgIds": [
              "2CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa eruma abaana beefwe mbu okhwiyitsiala khweefwe khulweenywe khuleshe okhukwisibwa okhwabutswa mwikhuwa lino; khandi mbu shinga olwa ndaboola, mube nimwirecheeshe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.3",
            "verseOrgIds": [
              "2CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata mbu nimba ninzitsa nende abandi abaMakedonia nimunyoolekha nimureerecheeshe ta, ifwe (ne shimboola mbu inywe ta) khuleshe okhufwimbwa emirwe mubwisiichi buno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.4",
            "verseOrgIds": [
              "2CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila nindola mbu nobulayi okhusaaya abaana beefwe mbu ba'ranjilile okhwitsa ewa muli nibeekholeelela okhukasia ebiobuhaani bieenywe, ebia mwalaka khale, mbu bibe nibiarechekhwa, shinga olwa bili ebiobuhaani toto, nibiraba ebiobwimani ta.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.5",
            "verseOrgIds": [
              "2CO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.5",
            "verseOrgIds": [
              "2CO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne emboola mbu oumiitsa nolukhono alachesa ario nolukhono; ne oumiitsa nomukhono omusiro alachesa ario nomukhono omusiro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
            "verseOrgIds": [
              "2CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mundu akhole shinga tsiyemi etsiomumwoyo olwa tsili; arakhola nobumookooli, kata khulwa okhuhachilisibwa, ta; okhuba Nyasaye aheelanga omundu ouhaana nobusangaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.7",
            "verseOrgIds": [
              "2CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Nyasaye anyala okhumushilaasilia obunji bwosi bwobukoosia; mbu inywe olwa mubeetsanga nomwitsulu kwosi mubindu biosi tsindaalo tsiosi mushilaanile buli mulimo omulayi kwosi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.8",
            "verseOrgIds": [
              "2CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga olwa kahandiikwa, mbu",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noyo ouyinilinjia omumiitsi imwo, nende omukaate kwokhuliibwa, alamuyinilinjia namwinjiyilia imwo yeenywe eyokhumiitsa, natasakhwo ebiamo biobulunjishi bweenywe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.10",
            "verseOrgIds": [
              "2CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "neenyu nimuyindihasibungwa okhuula khubuhaani bwomukhono omusiro; nobwenobwo, obwa khumukholelanga, buchilanga Nyasaye nakhupilwa orio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.11",
            "verseOrgIds": [
              "2CO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba oburume bwobukhalabani buno shibwitsusinjia eshichelo shiobutambi bwabatakatifu butswa ta, ne bumeetekhanga khuNyasaye khulwa okhuupa orio khwabanji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.12",
            "verseOrgIds": [
              "2CO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khulwako akalolosilibwa mubukhalabani buno, bamwitsoomia Nyasaye shichila bulolosinjia obuhulili bweenywe khukeenako aka murumbulanga, akeiniiili yaKristo; khandi khulwa obuhaani bweenywe nimusanjilana ninabo, khandi nabandu bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.13",
            "verseOrgIds": [
              "2CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abeene bamulaamilanga muno nibaliibwa amahoofu nineenywe, khulwa obunji bwobukoosia bwaNyasaye obuli mwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.14",
            "verseOrgIds": [
              "2CO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye akhupilwe orio muno khulwa eshihaanwashie eshiraboolekha ta.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.15",
            "verseOrgIds": [
              "2CO.9.15"
            ]
          }
        }
      ]
    }
  ],
