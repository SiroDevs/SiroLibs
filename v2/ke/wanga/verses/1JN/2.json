          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuhandiichila inywe, orwana rwanje, okhuba mwamumanya Seefwe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
