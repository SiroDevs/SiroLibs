              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuhandiichila inywe, abasamwana baana, okhuba mwamumanya ye oubeetsangaho okhurula khukhuchaaka.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
