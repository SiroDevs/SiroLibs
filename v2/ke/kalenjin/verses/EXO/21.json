              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo yat chito keringet, anan ngo bal keringet ama koger, ak ngo rorokyi tany anan sigiriet, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
