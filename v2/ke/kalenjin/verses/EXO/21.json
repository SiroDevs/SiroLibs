          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kogeeri chitab kobo keringet; ak igochin chitab kobo tuguchoto siling’isiek, ak kobunji noto kagome chitab kobo keringet.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
