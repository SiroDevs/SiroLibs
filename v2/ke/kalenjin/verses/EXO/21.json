              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo bar kirgit kirgitab chito age kot kome; kealdoi noto sobei, ak kopchei tuguk che kagialdae, ak kopchei banyekab ne kame agine. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
