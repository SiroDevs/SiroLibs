  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "EXO 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng’atutik ak kayomisutik",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chu anyun kiruogutik che indechini tainywa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.1",
            "verseOrgIds": [
              "EXO.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngial otwogindet ne Hebranindet, koboisiei kenyisiek lo, ak eng’ kenyitab tisab komanda buch kotiagat. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.2",
            "verseOrgIds": [
              "EXO.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo kinyonei inegei, komandoi inegei: ago ngo kiga kotunis, komandoi ak osotiondennyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.3",
            "verseOrgIds": [
              "EXO.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngo kiigochin kiptaindennyi osotiot, ak kosikyi werik anan ko tibik; kobunjin osotiondonoto ak lagokyik kiptaiyandennyi, ak komanda chichoto inegei. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.4",
            "verseOrgIds": [
              "EXO.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo mwa komie otwogindet kole, Achame kiptaiyandennyu, ak osotiondennyu, ak lagokyuk; mamandoi, nganda atiagat: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.5",
            "verseOrgIds": [
              "EXO.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "komut anyun kiptaiyandennyi chichoto konyo taitab Kamuktaindet, ak komut konyo kurgat, anan tugatukyietab kurgat; ak kobarbar itinnyi kiptaiyandennyi eng’ katet; ak koot inendet agoi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.6",
            "verseOrgIds": [
              "EXO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.6",
            "verseOrgIds": [
              "EXO.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo alda chi cheptanyi koek otwogindet, ko mamandoi ko u otwogik che muren. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.7",
            "verseOrgIds": [
              "EXO.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo maibaibai cheboto kiptaiyandennyi, ne kilewen chichoto kole si tun koek osotiondennyi, kochamda kitiach: matinyei kimnatet koalda kwo bororiosiek alak, amu king’al inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.8",
            "verseOrgIds": [
              "EXO.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngogochi inendet werinnyi koek osotiondennyi, koyachi inendet ko u ye yachin tibikyik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.9",
            "verseOrgIds": [
              "EXO.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo sion, ko mat kochuchuch amitwogikyik, anan ngoroikyik, anan ko u ye nyoljin osotik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.10",
            "verseOrgIds": [
              "EXO.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo mayachi inendet tuguchoto somok, komuchi osotiondonoto komanda buch, ama eng’ alyet.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.11",
            "verseOrgIds": [
              "EXO.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.11",
            "verseOrgIds": [
              "EXO.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inendet ne birei chi kot kome, kebarei chichoto iman. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago chito ne kama kosetyin, ago kiigochi Kamuktaindet inendet konyo eunnyi: achobun ole mwechin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo wechi chito chitab kokwennyi eng’ menotet, kwo kobar inendet eng’ ng’alset; ing’usu eng’ kaptisisiennyu, si kebar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak inendet ne birei kwandanyi, anan kamet, kebarei iman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.15",
            "verseOrgIds": [
              "EXO.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.15",
            "verseOrgIds": [
              "EXO.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak inendet ne chorei chi, ak koalda, anan ngenam komi eunekyik, kebarei iman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak inendet ne sasei kwandanyi, anan kamet, kebarei iman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.17",
            "verseOrgIds": [
              "EXO.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.17",
            "verseOrgIds": [
              "EXO.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo borio bik, ak kewire age koita, anan ngo luch, ama kome, ago ngo ru eng’ itogunnyi konyagei, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago ngo ng’eet, kowendot kotebenoti kiroktanyi, keunda anyun ne kibirei: ago igochin tuguk che yamei betusiekyik che kibetyo buch, ak konya inendet komie agoi kosob.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo bir chi age tugul otwogindennyi ne muren, anan ne tie, eng’ kirokto, kot komechi eunekyik, kigeerjin chichoto yaitiennyi iman. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngot koeekyi betut agenge anan ko aeng’ ama me, ko ma kigeerjin kiy; amu kiga al.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo borio bik, kot kokwer osotiot ne tamano, ak kororok moet, ama koam kiy osotiondonoto: kogeerjin che yamegei ak che machei manong’otiotab osotiondonoto; igoitoi ko u ye kamwa kiruogik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngoyaak kiy ne ya, kigeeri sobondo eng’ sobondo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "konda eng’ konda, keldet eng’ keldet, eut eng’ eut, keldo eng’ keldo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
              "EXO.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "beelset eng’ beelset, kaguotenet eng’ kaguotenet, biret eng’ biret.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo kwer chi kondab otwogindennyi ne muren anan ne tie, kot kotui kong’ato; kounda kwo kotiagat amu kondanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo kwer keldetab otwogindennyi ne muren, anan otwogindennyi ne tie kot kochun; kounda kwo kotiagat amu keldannyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
    },
