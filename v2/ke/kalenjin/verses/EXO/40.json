          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kitebe boldetab Jehovah got barak bet, ak kimi mat boldonato kemoi kogeerei got komugul ne bo Israel, eng’ banwekwak tugul.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.38",
