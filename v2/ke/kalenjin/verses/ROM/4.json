{
  "id": "ROM.4",
  "number": "4",
  "bookId": "ROM",
  "reference": "Romanik 4",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ROM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kaborunetab Abraham",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwae nee anyun agobo Abraham, kwandanyo, kinyor nee eng’ atebetab borto? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.1",
            "verseOrgIds": [
              "ROM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu nda kiga kiityi Abraham imanda eng’ boisionik, kotinyei inendet ne ilosunegei; ago ma eng’ taitab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.2",
            "verseOrgIds": [
              "ROM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaei nee anyun sirutik? Kiiyan Abraham Jehovah, ak kigiityi inendet imanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago inendet ne boisiei, ko magiityin melekto kele bo mieindo, ago bo besendo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.4",
            "verseOrgIds": [
              "ROM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago eng’ inendet ne maboisiei, ago iyani inendet ne iityin imanda chi ne ya, kiiti kayanennyi kele bo imanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.5",
            "verseOrgIds": [
              "ROM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agot ko u ye kimwa Daudi agine agobo kaberuretab chito ne iityin Jehovah imanda ama eng’ boisionik, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.6",
            "verseOrgIds": [
              "ROM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kole,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.8",
            "verseOrgIds": [
              "ROM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tos kimwae kaberuroni agobo che kigimuratan, anan che ma kimuratan agichek? Amu kimwae kele, Kigiityi Abraham kayanennyi kobunji imanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.9",
            "verseOrgIds": [
              "ROM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigiityindo ano anyun? Ye kiga kimuratan anan ye kitom kimuratan? Ma eng’ kamuratanet, ago ye kitom kimuratan: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.10",
            "verseOrgIds": [
              "ROM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kitaach kaborunetab kamuratanet, ng’okset ne bo imandab kayanet ne kitinyei ye kitom kimuratan: si kobiit koek kwandab ichek tugul che kiyani, agot ye kitom kimuratan, si kobiit kiityi ichek imanda; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.11",
            "verseOrgIds": [
              "ROM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak koek kwandab che imuratanotin eng’ ichek che ma bo kamuratanet kityo, ago che bendi agichek eng’ tiegutikab kayanonoto bo kwandanyo Abraham ne kitinyei ye kitom kimuratan.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kima kigochi Abraham ak keswekyik arorutiet eng’ oret ne bo Ng’atutiet kele kobunji ng’ony, ago eng’ imanda ne bo kayanet. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ngot koek che namei tuguk, ichek che bo Ng’atutiet, ko kagoek buch kayanet, ak kageyai arorutiet koek ne matilei kiy: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu ibu Ng’atutiet neregek; ago ole mami ng’atutiet, ko mami bistoet.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bunu kayanet amu nito, si kobiit koek ne bo mieindo; si mawalak arorutiet eng’ iyotet tugul; ma choto bo Ng’atutiet kityo, ago choto agichek che bo kayanetab Abraham, ne kwandanyo achek tugul ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
              "ROM.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "(ko u ye sirat kole, Kaayain iegu kwandab bororiosiek che chang’) eng’ taitab ne kigoyan inendet, noto ko Jehovah, ne isoobi che kigobek, ak koguurei tuguk che mami, ko u che mi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.17",
            "verseOrgIds": [
              "ROM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiiyan eng’ kamang’unet ye kima komi kiy ne kimang’u, si kobiit koek kwandab bororiosiek che chang’, kiga kemwa ko u noto kele, Tenitu choto iyoteng’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kima nyalul eng’ kayanet ye kiibwati bortanyi ne u ne kigome, (ye kiga kotar olo bo kenyisiek bogol) ak Sara ne kiga kosiirto betusiekab iyotet: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
            "verseOrgIds": [
              "ROM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ee, kima sage kobistoe ye kiibwati arorutietab Jehovah, ago kitesak kogimit eng’ kayanet, kotorori Jehovah, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.20",
            "verseOrgIds": [
              "ROM.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiingen komie kole kit ne kiga koaror inendet, komuchi koyai kosulda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.21",
            "verseOrgIds": [
              "ROM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’ noto anyun, ko kigiityi inendet imanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.22",
            "verseOrgIds": [
              "ROM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kima kisir agobo inendet inegei, kele kigiityi inendet; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.23",
            "verseOrgIds": [
              "ROM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago amu achek agachek, che tun kiityin, che iyani inendet ne kiing’eet Jesu Kiptaiyandennyo komong’ eng’ che kibek, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.24",
            "verseOrgIds": [
              "ROM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kigigoito amu bistautikyok, ak kiging’eet si kobiit kiityech imanda.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.25",
            "verseOrgIds": [
              "ROM.4.25"
            ]
          }
        }
      ]
    }
  ],
