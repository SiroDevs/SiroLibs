              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ko u ye kiesio kotebe Jehovah naenywa, kobagakyi Jehovah ichek kabwatutik che kigong’emogis, si koyai tuguchoto che ma nyolu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
