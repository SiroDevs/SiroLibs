          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "che bo chemererosiek, che wechei Jehovah, che kolgolen, che menotik, che ichougei, taunikab tuguk che yaachen, che magase it sigik, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
