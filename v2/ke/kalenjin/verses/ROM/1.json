          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "che nganda ingen ng’atutietab Jehovah, ne len, nyoljin meet icheget che yaei tuguk che u chuto, ko mayaei kityo che u chuto, ago chamnyechin koboto icheget che yaei tuguchuto.",
          "type": "text",
