          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko nyiitat tuguk tugul che ma bo iman, sogornatet, kasetab miat, yaitiet; nyiitat ng’etkonda, rumisiet, boriet, kenisiet, suriet; chaamik, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
