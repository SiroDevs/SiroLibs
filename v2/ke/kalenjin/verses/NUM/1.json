              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ma kiitito choto Lawik ko u oretab kwanisiekwak. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
            ]
          }
        },
        {
