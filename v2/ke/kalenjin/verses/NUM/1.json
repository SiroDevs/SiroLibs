              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiek anyun tugul che kigiit che bo lagokab Israel ko u korikab kwanisiekwak, koboch che bo kenyisiek tiptem ak kwo tai, tugul che kiimuchi koba luget eng’ Israel, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
