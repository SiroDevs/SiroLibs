        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak lagokab Reuben, werit ne bo tai ne bo Israel, ibinwekwak, ko u ortinwekwak, ko u gorikab kwanisiekwak, ko u koitetab kainaik ko u metowekwak, muren age tugul ne bo kenyisiek tiptem ak kwo tai, tugul che kiimuchi koba luget. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choto che kigiit eng’ ichek, che bo oretab Reuben, ko ki elfusiek artam ak lo ak bogol mut.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
