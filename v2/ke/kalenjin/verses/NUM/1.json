            }
          ]
        },
        {
          "text": "Ak eng’ lagokab Simeon, ibinwekwak, ko u ortinwekwak, ko u gorikab kwanisiekwak, choto che kigiit eng’ ichek ko u koitetab kainaik, ko u metewekwak, muren age tugul ne bo kenyisiek tiptem ak kwo tai, tugul che kiimuchi koba luget. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choto che kigiit eng’ ichek che bo oretab Simeon, ko ki elfusiek konom ak sogol ak bogol somok.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
      ]
