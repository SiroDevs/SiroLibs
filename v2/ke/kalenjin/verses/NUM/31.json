          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak inemu eng’ kebebertab lagokab Israel, agenge eng’ konom, eng’ bik, eng’ akwotisiek, eng’ sigirok, ak eng’ nego, ak eng’ tuga tugul, ak igochi choto Lawik, che ribei boisietab gotab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiyai Musa ak Eleasar tisiindet ko u ye king’at Jehovah Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        }
      ]
    },
