          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koitetab kebeberta, noto bo bik che kiga ba luget, ko ki kechirek elfusiek bogol somok ak sosom ak tisab ak bogol mut: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
            "verseOrgIds": [
              "NUM.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ki bogol lo ak tamanwogik tisab ak mut aisurutab Jehovah ne bo kechirek. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
            "verseOrgIds": [
              "NUM.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiek che bo tuga elfusiek sosom ak lo; ak kiek aisurutab Jehovah eng’ choto, tamanwogik tisab ak aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
              "NUM.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak sigirok, ko ki elfusiek sosom ak bogol mut; ak kiek aisurutab Jehovah eng’ choto, tamanwogik lo ak agenge. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiek bik elfusiek taman ak lo; ak kiek aisurutab Jehovah eng’ choto bik sosom ak aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
              "NUM.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiigochi Musa Eleasar tisiindet kebeberta, kagochinet ne kinamjin barak, ne bo Jehovah, ko u ye king’at Jehovah Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
        }
