              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiweek kotogosta kobun oretab Basan: ak kimanda anyun Og laitoriatab Basan kwo kobargei ak ichek, inendet ak bikyik tugul, kibargei eng’ Edrei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.33",
            "verseOrgIds": [
              "NUM.21.33"
            ]
          }
        },
        {
          "name": "verse",
