              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiinem Musa kebebertab mwaata kiilse, ak kebebertab korotik che kimi kaptisisiet, ak kiise Aron ak ngoroikyik, ak werikyik ak ngoroikab werikyik; ak kiianyiny Aron, ak ngoroikyik, ak werikyik, ak ngoroikab werikyik.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
