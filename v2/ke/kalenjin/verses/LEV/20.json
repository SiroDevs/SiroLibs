            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibarei iman ne boisie oik, ne muren anan ne kobogorio, anan ne bonin; lachei ichek bichoto eng’ koik: tebe korotikwak ichek.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.27",
            "verseOrgIds": [
              "LEV.20.27"
            ]
          }
        }
      ]
    }
  ],
