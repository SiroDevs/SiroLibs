{
  "id": "LUK.19",
  "number": "19",
  "bookId": "LUK",
  "reference": "Luka 19",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "LUK 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sakayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimong’ji anyun Jeriko ak kobun kwenut. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.1",
            "verseOrgIds": [
              "LUK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ogeero, chito ne kiguure Sakayo; ak ki ne o inendet eng’ taagikab aisurut, ak ki magorio. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.2",
            "verseOrgIds": [
              "LUK.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kicheng’ei kole kogeer Jesu si konai kole ng’o inendet; ago kima imuch amu tuiyet, amu ki nwach. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.3",
            "verseOrgIds": [
              "LUK.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilabat kondo, kwo kolany mogoiywet si kogeer inendet: amu kinyo kosiirtoe oranato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.4",
            "verseOrgIds": [
              "LUK.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingoit Jesu yoto, konyal ketoto, ak kolenji, Sakayo, choruge, chogu; amu kanyolja aru gong’ung’ ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.5",
            "verseOrgIds": [
              "LUK.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kichok, kochorgei, ak kotaach inendet eng’ boiboindo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.6",
            "verseOrgIds": [
              "LUK.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingogeer bichoto, kong’unyng’ung’so tugul, kole, Kawa kotebi eng’ gotab chito ne kiptengekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.7",
            "verseOrgIds": [
              "LUK.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitonon Sakayo, ak kolenji Kiptaiyat, Keero, Kiptaiyandani, agochini kibananok kebebertab tugukyuk; ak ngo kiaibe chi age tugul kiy eng’ ng’alset, aweekyini konyil ang’wan. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.8",
            "verseOrgIds": [
              "LUK.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jesu, Kagonyo yetunet rani goi, amu weritab Abraham agine inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.9",
            "verseOrgIds": [
              "LUK.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kinyo Weritab chi kocheng’ ak kosor ne kiga kobet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalewenet agobo fedaisiek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingota kogasei ichek tuguchu, kotes komwa kalewenet, amu ki negit Jerusalem, ak kiibwati icheget kolen toogu bounatetab Jehovah ngunoto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwa anyun kole, Kiwa chi anum ne toogunot emet ne loo, kwo konam bounatet kobunji, ak koweek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.12",
            "verseOrgIds": [
              "LUK.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeityo koguur otwogikyik taman, ak kogochi fedaisiek taman, ak kolenji, Oboisie agoi tun aitu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.13",
            "verseOrgIds": [
              "LUK.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiwech inendet bikab emennyi, koyokto ng’olyot kosube inendet, kole, Magimache chichi koboiywech.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.14",
            "verseOrgIds": [
              "LUK.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.14",
            "verseOrgIds": [
              "LUK.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingoweek kogeny, ko kagonam bounatet, kong’at keguur otwogichoto, chu kiga kigochi fedaisiek, kobwa ole mi inendet, si kobiit konai che kinyor bichoto eng’ boisiet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.15",
            "verseOrgIds": [
              "LUK.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo tainnyi chito ne bo tai, kole, Kiptaiyandani, kigonyor fedaiyandeng’ung’ fedaisiek alak taman. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.16",
            "verseOrgIds": [
              "LUK.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji inendet, Kiiyai ne mie, otwogindoni mie: amu kiiegu ne kiyani eng’ kit ne ming’in mising’, bou nganasok taman. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.17",
            "verseOrgIds": [
              "LUK.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo ne bo aeng’, kole, Kiptaiyandani, kigonyor fedaiyandeng’ung’ fedaisiek mut alak. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.18",
            "verseOrgIds": [
              "LUK.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji noto agine, Bou nganasok mut aginye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.19",
            "verseOrgIds": [
              "LUK.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.19",
            "verseOrgIds": [
              "LUK.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo age, kole, Kiptaiyandani, keero, ineni fedaiyandeng’ung’ ne kigaratyi anget ak agonor: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.20",
            "verseOrgIds": [
              "LUK.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kiaiywein, amu i chi ne kolgol: inemu ne kima inde ng’ony, ak igese che kima igol. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.21",
            "verseOrgIds": [
              "LUK.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji anyun inendet, Aruogun agobo ne kemwa eng’ kuting’ung’, otwogindoni ya. Kiingen ile a chi ne kolgol, anemu ne kima ande ng’ony, ak agese che kima agol; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.22",
            "verseOrgIds": [
              "LUK.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kilya anyun si mende fedaisiekyuk ole kiwalawale, ta kaanyoru ko kaitu koboto che kitesak? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.23",
            "verseOrgIds": [
              "LUK.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi ichek che kitonondos eng’ ye negit, kolenji, Orebe inendet fedaiyat, ak ogochi inendet ne tinye fedaisiek taman. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.24",
            "verseOrgIds": [
              "LUK.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek inendet, Kiptaiyandani, tinyei inendet fedaisiek taman. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.25",
            "verseOrgIds": [
              "LUK.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwawok ale, chi age tugul ne tinyei, kigochin; ago inendet ne matinyei, kerebe agot ne tinyei. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.26",
            "verseOrgIds": [
              "LUK.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago omutu anyun bunichuchuk kobwa yu, che machamei aboi, si obar eng’ tainnyu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kowendi Jesu Jerusalem kilosunoti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kiga komwa ko u noto, kwo kondo, kotogostoi Jerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.28",
            "verseOrgIds": [
              "LUK.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingo kagorikta Betpage ak Betania, eng’ tulwet ne kiguure tulwetab Emitik, koyokto aeng’ che bo alamalyennyi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.29",
            "verseOrgIds": [
              "LUK.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolenji, Oba agoi oit nganaset ne mi taing’wong’; ak ye oit ogeer moitab sigiriet ne ratat, ne tom kolany chi: otiach, ak ogetu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.30",
            "verseOrgIds": [
              "LUK.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo teebenak chi age tugul, kole, Kalya si otiach? Olenji anyun, Makyingei Kiptaiyat.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koba anyun che kaga kiyokto, ak konyor ko u ye kaga mwachi inendet ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.32",
            "verseOrgIds": [
              "LUK.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kita kotiachi moitab sigiriet, kolenji bikab kobo, Kalya si otiach moitab sigiriet? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.33",
            "verseOrgIds": [
              "LUK.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji, Makyingei Kiptiyat. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.34",
            "verseOrgIds": [
              "LUK.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiget konyo ole mi Jesu: yeityo koiito ngoroikwak eng’ moata bo sigiriet, ak koganapchi Jesu barak. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.35",
            "verseOrgIds": [
              "LUK.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kiwendi, koiitoot ngoroikwak eng’ oret.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.36",
            "verseOrgIds": [
              "LUK.19.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.36",
            "verseOrgIds": [
              "LUK.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingorikta tegeiyatab tulwetab Emitik, kotoi tuiyet tugul ne bo alamalyet koboiboitu ak kolos Jehovah eng’ kutit ne o agobo boisionik tugul che bo kamuktaet che kiga kogeer; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.37",
            "verseOrgIds": [
              "LUK.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolen, Iberurot Laitoriat ne nyonei eng’ kainetab Kiptaiyat: kalyet eng’ kipsengwet, ak lilindo eng’ ole toror mising’.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.38",
            "verseOrgIds": [
              "LUK.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.38",
            "verseOrgIds": [
              "LUK.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Parisaik alage che bo tuiyet inendet, Konetindoni, ker kong’ alamalyeng’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
              "LUK.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwolji kolenji, Amwawok ale, ngot kosisyo chu, koboldos koik.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Korir jin Jesu Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingorik, kogeer nganaset ak korirji, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.41",
            "verseOrgIds": [
              "LUK.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolen, Nda kengen eng’ betuni, agot inye, tuguk che bo kalyet! Ago nguno ko kagoung’ogis eng’ konyeguk. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.42",
            "verseOrgIds": [
              "LUK.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu tun bwanjinin betusiek che teechei buniguk irimet koyiemin komoswek tugul, ak kogerjin go eng’ komosta age tugul, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.43",
            "verseOrgIds": [
              "LUK.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kowirjin ng’ony, ak lagoguk che mi oring’ung’; ama bagagun agot koita agenge ne mi baragutab age; amu kima inai betutab rutochineng’ung’.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kotilili Jesu hekalut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwa hekalut orit, ak kotoi koon komanda che kialdoisiei, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.45",
            "verseOrgIds": [
              "LUK.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolenji ichek, Kigisir kele, Egu gonnyu gotab saet: ago kaoyai koek kebenetab rebik.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.46",
            "verseOrgIds": [
              "LUK.19.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.46",
            "verseOrgIds": [
              "LUK.19.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiinetisiei betut age tugul eng’ hekalut. Ago kicheng’ tisiik che eechen ak sirik ak che toogunotin eng’ bik, kobar inendet: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak manyor kit ne kiimuchi koyai; amu kiepchin it bik tugul inendet mising’.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.48",
            "verseOrgIds": [
              "LUK.19.48"
            ]
          }
        }
      ]
    }
  ],
