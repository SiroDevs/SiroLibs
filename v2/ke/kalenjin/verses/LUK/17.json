          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwolji inendet kolenji, Ano, Kiptaiyandani? Ak kilenji, Ole mi musto, koyumjingei oloto motong’wek agichek.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
