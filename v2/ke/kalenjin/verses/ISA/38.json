{
  "id": "ISA.38",
  "number": "38",
  "bookId": "ISA",
  "reference": "Isaia 38",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
