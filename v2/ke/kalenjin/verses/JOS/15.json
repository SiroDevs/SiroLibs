          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekron, koboto nganasokyik ak nganasokyik che mengechen: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.45",
            "verseOrgIds": [
