          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asdod, nganasokyik ak nganasokyik che mengechen; Gasa, nganasokyik ak nganasokyik che mengechen; agoi ainetab Misri, ak nyanjet ne o, ak kiwotennyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.47",
