        },
        {
          "text": "Chuto ko borotosiek che kipchei Musa eng’ warengosiekab Moab, Jordan bitonin, eng’ Jeriko ne tokyingei kong’asis. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
