              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiboch kiwotenywa Maanaim, Basan tugul, bororiet tugul ne bo Og laitoriatab Basan, ak nganasok tugul che bo Jair, che mi Basan, nganasok che eechen tamanwogik lo: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
