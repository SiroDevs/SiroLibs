          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kebebertab Gilead, ak Astarot, ak Edrei, nganasok che eechen che bo bororietab Og eng’ Basan, kibunji chuto lagokab Makir weritab Manase, kebebertab lagokab Makir ko u ortinwekwak.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
