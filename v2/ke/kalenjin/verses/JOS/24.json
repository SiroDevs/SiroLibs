              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingobata tuguchuto, kome Josua weritab Nun otwogindetab Jehovah, ko bo kenyisiek bogol ak taman. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
