          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitub ichek inendet eng’ kiwotetab borotennyi eng’ Timnat-sera, ne mi emetab tulonok ne bo Epraim, eng’ murot ne bo katam ne bo tulwetab Gaas.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
