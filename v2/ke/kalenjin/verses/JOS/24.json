          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiboisiechi Israel Jehovah eng’ betusiek tugul che bo Josua, ak eng’ betusiek tugul che bo boisiek che kita komi ko kagome Josua, che kiingen boisiet tugul ne bo Jehovah, ne kiga koyai agobo Israel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
