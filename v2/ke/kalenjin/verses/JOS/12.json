          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "laitoriatab Taanak, agenge; laitoriatab Megido, agenge; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.21",
            "verseOrgIds": [
              "JOS.12.21"
            ]
          }
        },
