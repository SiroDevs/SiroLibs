          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "laitoriatab Madon, agenge; laitoriatab Hasor, agenge; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.19",
            "verseOrgIds": [
              "JOS.12.19"
            ]
          }
        },
