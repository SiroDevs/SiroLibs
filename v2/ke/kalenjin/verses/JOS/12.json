          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "laitoriatab Apek, agenge; laitoriatab Lasaron, agenge; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.18",
            "verseOrgIds": [
              "JOS.12.18"
            ]
