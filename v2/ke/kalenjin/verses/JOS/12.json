          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "laitoriatab Tapua, agenge; laitoriatab Heper, agenge; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.17",
            "verseOrgIds": [
              "JOS.12.17"
            ]
          }
        },
