        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bistoetab Basiti, ak keonei eng’ kalilanet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’ betusiekab Aasuerus (Aasuerus-nito ko ne kilaitorani koboch India agoi Etiopia, kobou emotinwek bogol ak tiptem ak tisab:) ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eng’ betusiechoto, ye kitebe laitoriat Aasuerus ng’echeretab laitornatet ne bo bounatennyi, ne kimi Susan, nganaset ne o; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "eng’ kenyit ne bo somok ne bo laitornatennyi, ko kiyachi igorta bounikyik tugul ak otwogikyik; komi tainnyi bik che toogunotin ak bounikab emotinwek, che ki kimnatetab Persia ak Media: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ye kingobiit tuguchoto kobarta magornatosiekab bounatennyi ne toror, ak teegistab etunatennyi ne siirtoot, eng’ betusiek che chang’, betusiek bogol ak tamanwogik sisiit.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogesgei betusiechuto, koyachi laitoriat igorta bik tugul che kimi Susan, nganaset ne o, che eechen koboto che mengechen, eng’ betusiek tisab eng’ seremutab mbaretab gotab laitoriat; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kimitei ngoroik che songinindos che ki leelach, ak che ki nyalilen, ak che ki tuuen ne nyalil, che kigirate boroonik che bo katanit ne kararan, ak ne arus ne birir, keratyi tamogok che bo feda eng’ tolochikab koik che leelach: ki bo tahabu ak feda itogusiek, kiginde ng’ony ole kigimale koik che biriren, ak che leelach, ak che sogionen, ak che tuuen. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiinaga ichek koee eng’ tuguk che bo tahabu, (ki terjin tuguchoto,) ak divaik che chang’ che bo laitoriat, ko u aiyebindab laitoriat. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kieei ko u ng’atutiet; kima kibirji chi: amu kiga kong’at laitoriat ko u noto agobo kiptainik tugul che bo gonnyi, kole koyai ko u ye machei chi tugul.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyachi agine Basiti, osotiotab laitoriat, igorta, kwonyik tugul che kimi gotab laitoriat che ki bo laitoriat Aasuerus.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’ betut ne bo tisab, ye kibaibai muguleldab laitoriat amu divaik, kong’at inendet Meuman, Bista, Harbona, Bigta, Abagta, Setar, ak Karkas, ribik tisab che kiboisiei eng’ taitab laitoriat Aasuerus, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "komut Basiti osotiotab laitoriat konyo taitab laitoriat kolaagonu nariet ne bo laitornatet, si koborji kororonindanyi bik ak bounik, amu ki kararan. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiesio Basiti osotiotab laitoriat konyo ye kingong’at laitoriat inendet eng’ kutitab ribik: kinerech anyun mising’ laitoriat, ak kilalyo neregekyik eng’ inendet.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji anyun laitoriat bik che ng’omen, che kiingen betusiek, (amu ki u noto ateptab laitoriat eng’ tugul che ingen ng’atutik ak kiruogutik: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak che kirubei inendet ko ki Karsena, Setar, Admata, Tarsis, Meres, Marsena, ak Memukan, bounik tisab che bo Persia ak Media, che kigeerei togetab laitoriat, che kisib kinde koek che eechen eng’ bounatet:) ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kile, Kiitoi nee Basiti osotiotab laitoriat ko u ye mwaei ng’atutik, amu ma yai kit ne king’at laitoriat Aasuerus ne kimwa eng’ ribik?",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwol Memukan eng’ taitab laitoriat ak bounik kole, Ma yachi ne ya Basiti, osotiondonoto bo laitoriat, laitoriat inegei, ago kayachi ne ya bounik tugul, ak bik tugul che mi emotinwek tugul che bo laitoriat Aasuerus. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu tun kasei kwonyik tugul boisionito bo osotiondonito, si koyai manong’otaikwak koek che kisasei eng’ tainywa, ye tun kagimwaita kele, King’at laitoriat Aasuerus kimut Basiti osotiondennyi konyo tainnyi, ago ma nyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak imuchi komwa ko u noto rani tibikab laitorinikab Persia ak Media che kagogas agobo boisietab osotiotab laitoriat, komwachi bounik tugul che bo laitoriat. Ak kobiit anyun sasisiet ne o ak neregek che chang’. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngot kocham anyun laitoriat, ko mie komwa inendet ng’atutiet ne bo laitornatet, ak ngesir koboto ng’atutikab Persik ak Medik, si ma kiwal, kele ma konyonei kogeny Basiti taitab laitoriat Aasuerus; ak ingogochi laitoriat etunatennyi ne bo laitornatet, chito age ne kaigai kosiir inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye tun kagimwaita ng’atutietab laitoriat ne tun yaei eng’ bounatennyi tugul, (amu o,) kogochi anyun osotik tugul manong’otaikwak teegisto, kogochi che eechen ak che mengechen.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiibaibai ng’olyondonoto laitoriat ak bounik; ak kiyai laitoriat ko u ng’olyotab Memukan: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.21",
            "verseOrgIds": [
              "EST.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kiiyokto baronok koba emotinwek tugul che bo laitoriat, koba emet age tugul ko u sirenywa, ak koba bororiet age tugul eng’ kutinywa, kole, koboi chi tugul gonnyi, ak komwaita eng’ kutitab bikyik.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.22",
            "verseOrgIds": [
              "EST.1.22"
            ]
          }
        }
      ]
    }
  ],
