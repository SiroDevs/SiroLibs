          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak eng’ En-rimon, ak eng’ Sora, ak eng’ Jarmut; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
