              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimeny lagokab Benjamin agichek koboch Geba ak kwo tai, eng’ Mikmas ak Aija, ak eng’ Bet-el ak nganasokyik; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
