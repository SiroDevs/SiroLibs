            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak eng’ Hasar-sual, ak eng’ Beer-seba ak nganasokyik, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.27",
            "verseOrgIds": [
              "NEH.11.27"
