          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanoa ak Adulam, ak nganasokwak, Lakis ak mbarenikyik, Aseka ak nganasokyik. Kimeny anyun koboch Beer-seba agoi atebwetab Hinom.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
