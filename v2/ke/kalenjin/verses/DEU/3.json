              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togoste Pisga barak, ak toben komostab cherongo, ak murot ne bo katam, ak murot ne bo tai, ak ole tokyingei kong’asis, ak igeerote eng’ konyeguk; amu melandoe Jordanini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
