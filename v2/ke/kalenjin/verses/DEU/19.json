{
  "id": "DEU.19",
  "number": "19",
  "bookId": "DEU",
  "reference": "Ng'Atutik 19",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
