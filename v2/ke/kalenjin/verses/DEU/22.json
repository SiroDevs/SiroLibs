          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngonyor mureno chepto ne bergeiyat, ne tom kigochi chi, ak kosuub, ak koruiyo tuwai, ak ngenyor; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingogochi murenonoto karuiyo tuwai kwandab cheboto sekelisiek konom che bo feda, ak koek osotiondennyi, amu koitewer; maimuchi kobagakta agoi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        }
      ]
