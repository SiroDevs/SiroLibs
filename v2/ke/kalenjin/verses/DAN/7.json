              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwa anyun ko u ni, kole, Egu tionyoto bo angwan bounatet ne bo ang’wan eng’ ng’ony, ne egu ne ter eng’ bounatosiek tugul, ak amei ng’ony komugul, ak kotiekyi ng’ony, ak kotonaton. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.23",
            "verseOrgIds": [
              "DAN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ kuinoichuto taman, komong’une bounatonito laitorinik tamanu: ak ye ibata komong’ age ne isubu ichek; ak egu ne ter eng’ che bo tai, ak koterter laitorinik somok. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.24",
            "verseOrgIds": [
              "DAN.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak komwa ng’alek che kirindoi Inendet ne Toror Mising’, ak koiim mising’ bik che tililen che bo Inendet ne Toror Mising’: ak kilen inendet kowal betusiek ak ng’atutik; ak kigochi koboi agoi kobek kenyit, ak kenyisiek, ak kebebertab kenyit. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kichobei kiruoget, ak kerebe bounatennyi, si koges ak kong’em agoi kagesunet. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.26",
            "verseOrgIds": [
              "DAN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak tun kigochin bikab bik che tililen che bo Inendet ne Toror Mising’, laitornatet ak bounatet, ak oindab laitornatosiek che mi kureretab kipsengwet komugul: laitornatennyi ko laitornatet ne bo koigeny, ak tun otei inendet bounatosiek tugul, ak kogase it.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        }
      ]
    },
