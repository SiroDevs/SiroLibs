          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyor chi tugul kaiyweisiet: ak kiyaak kwong’utik che chang’ ak kaborunoik eng’ che kiyoktoi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.43",
            "verseOrgIds": [
              "ACT.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi tugul kibagenge che kiga koyan, ak kiyamdoi tuguk tugul; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
              "ACT.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kialda mbarenikwak ak tuguk alak che kitinyei ak kopchechi ichek tugul che te che kinyalili chi age tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.45",
            "verseOrgIds": [
              "ACT.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi hekalut betut age tugul kotebyei eng’ kabwatet agenge, ak eng’ butuletab makatiat eng’ ga, ak kiamisiei eng’ kagasetab ge, ak eng’ muguleldo agenge, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.46",
            "verseOrgIds": [
              "ACT.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolosu Jehovah, ak kiiboiboi ichek bik tugul. Ak kitesyin Kiptaiyat betut age tugul icheget che nyoru sorunet.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.47",
            "verseOrgIds": [
