              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiigiiljingei ichek tugul konetisietab che kiyoktoi ak yamdaet, eng’ butuletab makatiat ak sautik.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
            "verseOrgIds": [
              "ACT.2.42"
