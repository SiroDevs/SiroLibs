          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibaorian eng’ ng’alek alak che chang’, ak kogiil, kolenji, Osoruge eng’ ibini kunur. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.40",
            "verseOrgIds": [
              "ACT.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigibatisan anyun icheget che kitaach ng’olyondennyi: ak kigitesyi ichek betunoto bik olo bo elfusiek somok.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.41",
            "verseOrgIds": [
              "ACT.2.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ole nyolu kotepto sobetab bikab Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
