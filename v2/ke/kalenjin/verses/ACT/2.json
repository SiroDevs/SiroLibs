          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu neng’wong’ kayomisoni, ak lagokwok, ak tugul che mi ole loo, ak tugul che ta koguurei Kiptaiyat Jehovah nenyo kobwanji inendet.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.39",
            "verseOrgIds": [
              "ACT.2.39"
            ]
          }
        }
