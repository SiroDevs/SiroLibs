            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilaune inendet mbartanyisiek, ak kotupchi nganasetab Juda koboto kwanisiekyik.",
          "type": "text",
