{
  "id": "2CH.4",
  "number": "4",
  "bookId": "2CH",
  "reference": "Ateptab Betusiek 2 4",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
