  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "MAT 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tuguk che nyolu keyai eng’ betutab sabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’ betusiechoto kobun Jesu mbarenikab bek eng’ betutab sabato; ak kiamei rubet alamalyennyi, ak kitoi kobach mesisekab bek, koam. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.1",
            "verseOrgIds": [
              "MAT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ye kingogeer Parisaik, kolenji inendet, Keero, yaei alamalyeng’ung’ ne ma chamdaat eng’ ng’atutik keyai eng’ sabato.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.2",
            "verseOrgIds": [
              "MAT.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.2",
            "verseOrgIds": [
              "MAT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kilenji ichek, Tom osoman kit ne kiyai Daudi ye kiamei rubo, ak che kimi ak inendet: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.3",
            "verseOrgIds": [
              "MAT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ye kingwo gotab Jehovah, ak koam makatinikab kabartaet, che kima ko chamdaat eng’ ng’atutik koam inendet, agot che kimi koboto inendet, kobate tisiik ichegei? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.4",
            "verseOrgIds": [
              "MAT.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anan tom osoman eng’ Ng’atutik, kele, ing’waniti tisiik sabato eng’ betutab sabato eng’ hekalut, ama kiityin ichek tengekto? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.5",
            "verseOrgIds": [
              "MAT.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago amwawok ale, mi eng’ oli ne o kosiir hekalut. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.6",
            "verseOrgIds": [
              "MAT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngo kionai ole teptoi ni, Amache rirenetab ge, mamache tiseiywo, ta kama ogikyini che matinyei tengek. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.7",
            "verseOrgIds": [
              "MAT.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kiptaiyat ne bo sabato Weritab chi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.8",
            "verseOrgIds": [
              "MAT.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kisoobi chi ne resot eut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.8",
            "verseOrgIds": [
              "MAT.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwa eng’ oloto, agoi sunagoginywa orit: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.9",
            "verseOrgIds": [
              "MAT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ogeero, kimi chi ne resot eut. Ak kiteebe ichek inendet, kolenji, Tos chamdaat eng’ ng’atutik kisoob chi eng’ betutab sabato? Si kobiit kong’ach inendet.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.10",
            "verseOrgIds": [
              "MAT.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.10",
            "verseOrgIds": [
              "MAT.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek, Ngoro chi eng’ okwek, ne tinyei kechiriet agenge, ak ngot kororokyi keringet betutab sabato, ko tos masutu komong’? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.11",
            "verseOrgIds": [
              "MAT.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siirtoot anyun ne tia chito eng’ kechiriet! Noto anyun, chamdaat keyai ne mie eng’ betutab sabato. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.12",
            "verseOrgIds": [
              "MAT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwachi anyun chito kolenji, Iite eung’ung’. Ak kiito: ak kosob, koigei eut nin age.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.13",
            "verseOrgIds": [
              "MAT.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kocheng’ei bik ole bartoi Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.13",
            "verseOrgIds": [
              "MAT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kimanda anyun Parisaik, ak koruoch agobo inendet, ole bartoi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.14",
            "verseOrgIds": [
              "MAT.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.14",
            "verseOrgIds": [
              "MAT.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingonai Jesu, kwo eng’ oloto: ak kiisub inendet che chang’; ak kiisoob ichek tugul, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.15",
            "verseOrgIds": [
              "MAT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak king’at ichek kole, si maibarta inendet: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.16",
            "verseOrgIds": [
              "MAT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "si kosulda ne kiga mwa maotiot Isaia, kole,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.17",
            "verseOrgIds": [
              "MAT.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kowolu Jesu kataamset ne kigimwa kele boisiei koboto setani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.21",
            "verseOrgIds": [
              "MAT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigimutyi anyun chito ne kitinyei oindet, ne korat ak ko namat kut: ak kiisoob inendet, kot kong’alal ak kogeerto chito ne namat kut. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.22",
            "verseOrgIds": [
              "MAT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokwong’io anyun tuiyosiek tugul, ak kole, Tos weritab Daudi nito? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.23",
            "verseOrgIds": [
              "MAT.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kingogas Parisaik, kole, Maonei chichi oik, kobate eng’ Beelsebul ne o ne bo oik.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.24",
            "verseOrgIds": [
              "MAT.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.24",
            "verseOrgIds": [
              "MAT.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingonai inendet kabwatutikwak kolenji, Ng’emaksei bororiet age tugul ne pchegei; ama tononi nganaset anan got age tugul ne pchegei: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.25",
            "verseOrgIds": [
              "MAT.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ngo on Setani Setani, ko kapcheigei inegei; tonondoi ano anyun bororiennyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.26",
            "verseOrgIds": [
              "MAT.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ndaone oik eng’ Beelsebul, koonei eng’ ng’o werikwok? Noto anyun egu ichek che iruokwok. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.27",
            "verseOrgIds": [
              "MAT.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngaone oik eng’ Tamirmirietab Jehovah, ko kagoitwak anyun bounatetab Jehovah.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.28",
            "verseOrgIds": [
              "MAT.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.28",
            "verseOrgIds": [
              "MAT.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anan imuktoi ano kwo chi gotab chito ne kim, si korebe tugukyik ngot ko ma rat korok chito ne kim? Si kouur anyun gonnyi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.29",
            "verseOrgIds": [
              "MAT.12.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.29",
            "verseOrgIds": [
              "MAT.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inendet ne magimi tuwai kogirindaa; ak inendet ne magiyumi tuwai koiyestooti. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.30",
            "verseOrgIds": [
              "MAT.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noto anyun amwawok ale, Kinyochin kaat bik tengekto age tugul ak ng’olyot age tugul ne ya, ago che mwaei ng’olyo ne ya agobo Tamirmiriet, ko maginyochin kaat. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.31",
            "verseOrgIds": [
              "MAT.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak age tugul ne mwaitoe yaitio Weritab chi, kenyochin kaat; ago age tugul ne mwaitoe yaitio Tamirmiriet, ko maginyochin kaat, agot eng’ ng’onyuni anan eng’ noto nyonei.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.32",
            "verseOrgIds": [
              "MAT.12.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.32",
            "verseOrgIds": [
              "MAT.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anan oyai ketit komieit, ak logoekyik; anan oyai ketit koyait, ak logoekyik; amu kinae ketit logoekyik. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.33",
            "verseOrgIds": [
              "MAT.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwek lagokab erenok che ng’wonen, omuktoi ano okwek, che o yaach, omwa tuguk che miach? Amu ng’alali kutit che nyiitat muguleldo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.34",
            "verseOrgIds": [
              "MAT.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibune chi ne mie tuguk che miach konoruennyi ne mie: ak ibune chi ne ya tuguk che yaach konoruennyi ne ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.35",
            "verseOrgIds": [
              "MAT.12.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.35",
            "verseOrgIds": [
              "MAT.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak amwawok ale, ng’olyot age tugul ne bo buch ne mwaei bik, ko tun tetu tuguchoto eng’ betutab kiruoget. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.36",
            "verseOrgIds": [
              "MAT.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kiityinin imanda eng’ ng’aleguk, ak kigikyinin eng’ ng’aleguk.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.37",
            "verseOrgIds": [
              "MAT.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koesioi Jesu kobor kaborunet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.37",
            "verseOrgIds": [
              "MAT.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwolji anyun alak che bo sirik ak Parisaik, kolenji, Konetindoni, kimache kegeer kaborunet ne iboruech. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.38",
            "verseOrgIds": [
              "MAT.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiwolji kolenji, Ibinda ne ya ne bo ibetab ge ne cheng’ei kaborunet; ak magigochin kaborunet kobate kaborunetab maotiot Jona: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.39",
            "verseOrgIds": [
              "MAT.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu ko u ye kimi Jona betusiek somok ak kemousiek somok moetab njiriot ne o mising’: ko u noto tun tebe Weritab chi betusiek somok ak kemousiek somok eng’ muguleldo ne bo ng’ony. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.40",
            "verseOrgIds": [
              "MAT.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tun tonondos murenik che bo Ninebe koboto ibini eng’ kiruoget, ak kogikyi: amu kisik eng’ mwaitaet ne bo Jona; ak ogeero, mi yu ne o kosiir Jona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.41",
            "verseOrgIds": [
              "MAT.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’eetei tun laitoriat kobogoriot ne bo murot komostab tai koboto ibini eng’ kiruoget, ak kogikyi: amu kibun tabanwekab ng’ony si kogas ng’omnatetab Solomon; ak ogeero, mi yu ne o kosiir Solomon.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.42",
            "verseOrgIds": [
              "MAT.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kanyol keripge agobo tililindo ne ma nyiitat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.42",
            "verseOrgIds": [
              "MAT.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ye kagomong’une chi tamirmiriet ne muruon, kwo kobunot oldinwek che yaamnyotin, kocheng’oti ole imuung’e, amanyor. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.43",
            "verseOrgIds": [
              "MAT.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeityo komwa kole, Kaweekyigei gonnyu ole kiamong’une: ak ye kingonyo, konyor ko mami kiy, ak kobugot, ak ko chobot. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.44",
            "verseOrgIds": [
              "MAT.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwo anyun komut tamirmirik alak tisab che yaach kosiir inendet, ak kochut ak komeny oloto: ak eng’ let koyaitu atebetab chichoto kosiir ne ki bo tai. Egu ko u noto agine eng’ ibini ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.45",
            "verseOrgIds": [
              "MAT.12.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tupchonatet ne bo iman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.45",
            "verseOrgIds": [
              "MAT.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingota kong’alaljin tuiyosiek, ogeero, kitonondos eng’ sang’ kamet ak che tupcho, kocheng’ei kong’alalji inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.46",
            "verseOrgIds": [
              "MAT.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi anyun chito age kolenji, Keero, tononi eng’ sang’ komet ak che otupche, cheng’ei kong’alalun. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.47",
            "verseOrgIds": [
              "MAT.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiwolji chito ne kimwachin inendet, kolenji, Ng’o kamennyu ak che kitupche? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.48",
            "verseOrgIds": [
              "MAT.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak koiito eunnyi kotokyi alamalyennyi, ak kole, Ogeero, chu kamennyu ak che kitupche! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.49",
            "verseOrgIds": [
              "MAT.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu age tugul ne yaei magetab Baba ne mi kipsengwet, noto werit ne kitupche ak chepto ne kitupche, ak kamennyu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.50",
            "verseOrgIds": [
              "MAT.12.50"
            ]
          }
        }
      ]
    }
  ],
