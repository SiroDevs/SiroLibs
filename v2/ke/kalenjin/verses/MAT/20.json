{
  "id": "MAT.20",
  "number": "20",
  "bookId": "MAT",
  "reference": "Matayo 20",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "MAT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalewenet agobo bik che kiboisiei eng’ mbaretab sabibuk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kergei bounatetab kipsengwet ak chitab kobo got, ne kimusta karon koguur meek kobwa mbarennyi ne bo sabibuk. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingo kagochamnyechi ak meechoto kogochi denarit agenge eng’ betut agenge, koyokto koba mbarennyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.2",
            "verseOrgIds": [
              "MAT.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimanda ko negit sait somok, ak kogeer alak kotonondos eng’ oldab aldaisiet ama tinyei boisiet; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.3",
            "verseOrgIds": [
              "MAT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kilenji, Oba ak okwek mbaretab sabibuk si agonok ne nyolu. Ak kiba anyun. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.4",
            "verseOrgIds": [
              "MAT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimanda kogeny ko negit sait lo ak eng’ sait sogol, ak kiyai ko u noto. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.5",
            "verseOrgIds": [
              "MAT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimanda kogeny olo bo sait taman ak agenge, ak konyor alak kotonondos; ak kilenji ichek, Kalya si otonone oli betut komugul amotinye boisio? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.6",
            "verseOrgIds": [
              "MAT.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji anyun bichoto inendet, Amu ma kuurech chi. Kolenji, Oba ak okwek mbaretab sabibuk.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.7",
            "verseOrgIds": [
              "MAT.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.7",
            "verseOrgIds": [
              "MAT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingoek koskoleny, komwachi chitab kobo mbaretab sabibuk kiboitiondennyi ne o kolenji, Kuur meek, si igochi melekwekwak, itaune ne bo let agoi ne bo tai. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.8",
            "verseOrgIds": [
              "MAT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingobwa ichek che kiga kiguur ko negit sait taman ak agenge, konyor chi tugul denarit agenge. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.9",
            "verseOrgIds": [
              "MAT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingobwa che bo tai, kolen nyoru che siirei; ak kinyor agichek denarit agenge chi tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.10",
            "verseOrgIds": [
              "MAT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingotaach, kong’unyng’ung’ji chitab kobo got, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.11",
            "verseOrgIds": [
              "MAT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kole, Kabois chu bo let sait agenge kityo, ak kairogenech bichoto achek che kagibirtege betut komugul eng’ asista ne ng’wan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.12",
            "verseOrgIds": [
              "MAT.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.12",
            "verseOrgIds": [
              "MAT.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiwolji kolenji age eng’ ichek, Choruani, ma ayaun kiy ne ya: kama kichamnyechi tuwai denarit agenge? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.13",
            "verseOrgIds": [
              "MAT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nam neng’ung’, ak iwe oreng’ung’; magennyu agochi chichito bo let ko u ye kagonin inye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.14",
            "verseOrgIds": [
              "MAT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tos manyoljina ayai ne amache eng’ tugukyuk? Anan ya kondang’ung’, amu a mie?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.15",
            "verseOrgIds": [
              "MAT.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.15",
            "verseOrgIds": [
              "MAT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egu anyun che bo let che bo tai, ak egu che bo tai che bo let.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.16",
            "verseOrgIds": [
              "MAT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sib komwaei Jesu ne bo somok agobo meennyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.16",
            "verseOrgIds": [
              "MAT.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kitogostoi Jesu kowendi Jerusalem, komut alamalyet taman ak aeng’ koba taban ichegei, ak kolenji ichek eng’ oret, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeero, kitogosyini Jerusalem; si kinde Weritab chi eunekab tisiik che eechen ak sirik; ak kiruokyi kome, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kogoito kochurachur Bororiosiek, ak kobire kipcharitit, ak kogartat eng’ kimurtoiyot: ak king’eet inendet eng’ betutab somok.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Somset agobo teegisto ne bo ng’ony",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyonji anyun inendet kametab werikab Sebedi koboto werikyik, ak kogutung’ji, ak kosom inendet kiy. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji, Imache nee? Kolenji, Ng’at ile kotebe werichuchuk aeng’u, age eung’ung’ ne bo tai, ak age eung’ung’ ne bo katam, eng’ bounateng’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiwol Jesu kole, Mongen ne osome. Omuchi okwek oee kikombet ne negit aee? Kolenji inendet, Kimuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji ichek, Oee iman kikombennyu: ago ma nenyu agochi kotebe eunnyu ne bo tai, ak eunnyu ne bo katam, ago bo ichek che kachopchi Baba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingogas chun tamanu, konyit agobo choto aeng’ che tupcho.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etunatet ne bo iman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiguur Jesu kobwanji inendet, ak kole, Ongen ole bou eng’ kimnatet bounikab Bororiosiek, ak bou ichek bikwak che eechen. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma u noto eng’ okwek: ago age tugul ne machei koek ne o eng’ kwenung’wong’ koek kiboitiondeng’wong’; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak age tugul ne machei koek ne bo tai eng’ kwenung’wong’ koek otwogindeng’wong’: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "agot ko u noto, kima nyo Weritab chi keboisiechi, ago si kobois inendet, ak kogoito sobondanyi koek kit ne kitiage che chang’.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.28",
            "verseOrgIds": [
              "MAT.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keyatyin konyek kipkoratinik aeng’",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.28",
            "verseOrgIds": [
              "MAT.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingomandoi ichek eng’ Jeriko, kosubi inendet tuiyet ne o. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeero, kipkoratinik aeng’ che kitebyei eng’ oret taban, ye kingogas kole siirtoi Jesu, kowaach, kole, Kiptaiyandani, rireneige, ee weritab Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiger kong’ tuiyet bichoto kole, kosisyo: ago kites kowaach, kole, Kiptaiyandani, rireneige, ee weritab Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotonon Jesu, ak koguur ichek, ak kolenji, Omache ayaiywok nee? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji inendet, Kiptaiyandani, kimache keyatwech konyekyok. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kirirge Jesu, ak kitwa konyekwak: ak kogeerto eng’ yoto ak kosub inendet.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
            "verseOrgIds": [
              "MAT.20.34"
            ]
          }
        }
      ]
    }
