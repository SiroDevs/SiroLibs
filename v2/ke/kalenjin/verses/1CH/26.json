        },
        {
          "text": "Kiyaei Kenania ak werikyik, che bo Isarik, boisionikab sang’ che bo Israel, koek kiptainik ak kiruogik.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
