{
  "id": "1CH.26",
  "number": "26",
  "bookId": "1CH",
  "reference": "Ateptab Betusiek 1 26",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "1CH 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiboitinik che terotin che bo hekalut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pcheutikab ribikab kurget ko: che bo Koraik ko ki: Meselemia weritab Kore, che bo werikab Asap. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.1",
            "verseOrgIds": [
              "1CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitinyei werik Meselemia, Sekaria taita, Jediael ne bo aeng’, Sebadia ne bo somok, Jatniel ne bo ang’wan; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elam ne bo mut, Jeohanan ne bo lo, Eliehenai ne bo tisab.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitinyei werik Obed-edom; Semaia taita, Jeosabad ne bo aeng’, Joa ne bo somok, ak Sakar ne bo ang’wan, Netanel ne bo mut. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amiel ne bo lo, Isakar ne bo tisab, Peuletai ne bo sisiit: amu kiiberur Kamuktaindet inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigisikyi werik Semaia agine, che kibou gotab kwandanywa: amu ki bik che kimen che nyigonen.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.6",
            "verseOrgIds": [
              "1CH.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.6",
            "verseOrgIds": [
              "1CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werikab Semaia ko ki: Otni, Repael, Obed, Elsabad, che ki bik che ki nyigonen tupchosiekwak, Eliu ak Semakia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.7",
            "verseOrgIds": [
              "1CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuto tugul ko ki werikab Obed-edom: icheget ak werikwak ak tupchosiekwak ko ki bik che kimen eng’ kimnatet agobo otisiet; ki bik tamanwogik lo ak aeng’ che bo Obed-edom. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.8",
            "verseOrgIds": [
              "1CH.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitinyei Meselemia werik ak che tupcho, bik che nyigonen, taman ak sisiit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.9",
            "verseOrgIds": [
              "1CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitinyei Hosa agine, ne bo lagokab Merari, werik; ki ne o Simri, (nganda kima ko taita inendet, ko kiyai kwandanyi inendet koek ne o;) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.10",
            "verseOrgIds": [
              "1CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilkia ne bo aeng’, Tebalia ne bo somok, Sekaria ne bo ang’wan: ki taman ak somok werik tugul che bo Hosa koboto tupchosiekyik.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi eng’ chuto pcheutikab bik che kiribei kurget, bik che eechen, kotinyei ripsosiek che u che bo tupchosiekwak, si kobois eng’ gotab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.12",
            "verseOrgIds": [
              "1CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiser barbarek, bik che mengechen ak che eechen, kobee gorikab kwanisiekwak, agobo ormarichet age tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.13",
            "verseOrgIds": [
              "1CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibunji barbariat ne kitokyigei kong’asis Selemia. Yeityo koser barbarek agobo Sekaria werinnyi, kiruogindet ne ng’om; ak kimong’ barbariandennyi kotokyigei murot ne bo katam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.14",
            "verseOrgIds": [
              "1CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki bo Obed-edom ne kitokyigei murot ne bo tai; ak kibunji werikyik got ne kigonore tuguk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.15",
            "verseOrgIds": [
              "1CH.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibunji Supim ak Hosa ne kitokyigei cherongo, ole negite ormarichetab Saleket, eng’ ole kitogostoe, kotokyindos ribik. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.16",
            "verseOrgIds": [
              "1CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Lawik lo komostab kong’asis, komi ang’wanu komostab murot ne bo katam betut age tugul, komi komostab murot ne bo tai ang’wanu betut age tugul, ak ki aeng’ aeng’ che bo got ne kigonore tuguk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi bik ang’wanu ye kitogostoe eng’ Parbar, komostab cherongo, komi aeng’ Parbar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.18",
            "verseOrgIds": [
              "1CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuto ko ki pcheutikab ribikab kurget che bo werikab Koraik, ak che bo werikab Merari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ Lawik, ko kiribei Aija tuguk che bo ole kigonore tuguk che bo gotab Kamuktaindet, koboto ole kigonore tuguk che itabanotin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.20",
            "verseOrgIds": [
              "1CH.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werikab Ladan: werikab Gersonik che bo Ladan, kandoikab gorikab kwanisiek che bo Ladan Gersonindet, ko Jeieli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.21",
            "verseOrgIds": [
              "1CH.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.21",
            "verseOrgIds": [
              "1CH.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werikab Jeieli ko ki: Setam ak Joel ng’etab kamet, che kibou ole kigonore tugukab gotab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.22",
            "verseOrgIds": [
              "1CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Che bo Amramik, che bo Isarik, che bo Hebronik, che bo Usielik:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.23",
            "verseOrgIds": [
              "1CH.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.23",
            "verseOrgIds": [
              "1CH.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kibou Sebuel weritab Gersom, weritab Musa, ole kigonore tuguk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
            "verseOrgIds": [
              "1CH.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak tupchosiekyik: kisich Elieser Reabia werinnyi, Jesaia werinnyi, Joram werinnyi, Sikri werinnyi, ak Selomot werinnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibou Selomotinito ak tupchosiekyik komoswek tugul ole kigonore tuguk che itabanotin, che kiga kotaban laitoriat Daudi, koboto kandoikab gorikab kwanisiek, ak kiptainikab elfusiek, ak che bo bogolwogik, ak kiptainikab luget. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiitaban che bo barunenik tuguk che kigibaru eng’ lugosiek, si keteege ole kigobutok eng’ gotab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
            "verseOrgIds": [
              "1CH.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibou Selomot ak tupchosiekyik tuguk tugul che kiga kotaban Samuel keerindet, ak Saul weritab Kis, ak Abner weritab Ner, ak Joab weritab Seruia, koboto kiy age tugul ne kiga kotaban chi age tugul.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
