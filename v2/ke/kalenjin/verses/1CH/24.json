{
  "id": "1CH.24",
  "number": "24",
  "bookId": "1CH",
  "reference": "Ateptab Betusiek 1 24",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
