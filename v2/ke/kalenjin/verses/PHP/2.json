              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kimian iman, kot ko negit kome: ago kirire Jehovah inendet; ago ma eng’ inendet kityo, ago eng’ ane agane, si manyoru arogenet eng’ arogenet. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.27",
