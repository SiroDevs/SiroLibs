              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayogu inendet anyun eng’ kagiiletab ge ne o, si, ye ogeer inendet kogeny, omuchi oboiboitu, si kowisisit arogenennyu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.28",
            "verseOrgIds": [
