              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaach inendet anyun eng’ Kiptaiyat eng’ boiboiyet tugul; ak ogonyit che u noto: ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.29",
            "verseOrgIds": [
              "PHP.2.29"
            ]
          }
        },
