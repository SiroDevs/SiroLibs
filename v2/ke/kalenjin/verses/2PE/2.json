{
  "id": "2PE.2",
  "number": "2",
  "bookId": "2PE",
  "reference": "Petero 2 2",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
