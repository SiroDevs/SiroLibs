              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak chu kainaikab kiruogik che kimong’une Esau, ko u ortinwekwak, ko u korotinwekwak, ko u kainaikwak: kiruogindet Timna, kiruogindet Alba, kiruogindet Jetet; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
