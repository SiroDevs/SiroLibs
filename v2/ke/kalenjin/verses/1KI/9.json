{
  "id": "1KI.9",
  "number": "9",
  "bookId": "1KI",
  "reference": "Laitorinik 1 9",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
