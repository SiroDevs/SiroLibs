          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak boisionik che ng’etunotin che bo Reoboam, ak tuguk tugul che kiyai, ko tos ma kisirji bukuitab ateptab betusiek ne bo laitorinikab Juda? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
