          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kicham komi luget eng’ kwenutab Reoboam ak Jeroboam kotugul. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
