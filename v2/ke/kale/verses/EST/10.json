            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "King’at laitoriat Aasuerus aisurut eng’ emet, ak eng’ ngegusiekab nyanjet. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak boisionik tugul che bo kimnatennyi ak kamugennyi, ak ng’alek tugul che bo oindab Mordekai ko u ye kiieet laitoriat inendet, ko tos ma kisirji bukuitab ateptab betusiek ne bo laitorinikab Media ak Persia? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kirubei Mordekai Yahudiot laitoriat Aasuerus, ak ki o eng’ Yahudik, ak kichamak eng’ tupchosiekyik che chang’; kicheng’ei kit ne mie agobo bikyik, ak kong’alaljin iyotennyi tugul agobo kalyet.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
