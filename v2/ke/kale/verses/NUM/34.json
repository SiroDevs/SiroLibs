          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi Jehovah Musa kolenji, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chu kainaikab bik che pcheiywok emet koek boroteng’wong’: Eleasar tisiindet, ak Josua weritab Nun. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak onam bounindet ne bo oret age tugul, si kopchei emet koek borotet. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainaikab bichoto chu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        }
      ]
    }
