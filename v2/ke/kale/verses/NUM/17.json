        "style": "s1"
      },
      "items": [
        {
          "text": "Siaritab Aron Kong’oti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi Jehovah Musa kolenji, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.1",
            "verseOrgIds": [
              "NUM.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’alalji lagokab Israel, ak iibune siarisiek, siarit agenge eng’ got age tugul ne bo kwanisiekwak, eng’ bounikwak, ko u gorikab kwanisiekwak, egu siarisiek taman ak aeng’. Sirji kainetab chi age tugul siarinnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.2",
            "verseOrgIds": [
              "NUM.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak isirji siaritab Lawi kainetab Aron: amu bunjin siarit agenge bounindet age tugul ne bo gorikab kwanisiekwak. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.3",
            "verseOrgIds": [
              "NUM.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeityo igonor siarisiechoto eng’ emait ne kituiyechin eng’ taitab baornatet, ole kituiyechini ak okwek. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.4",
            "verseOrgIds": [
              "NUM.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeityo kong’at siaritab chito ne aleweni; ak awong’u eng’ tainnyu kang’unyng’ung’et ne ing’unyng’ung’jinok lagokab Israel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’alalji Musa lagokab Israel, ak kiigochi bounikwak tugul siarisiek, siarit agenge eng’ bounindet age tugul, ko u gorikab kwanisiekwak, siarisiek taman ak aeng’: ak kimitei siaritab Aron koboto siarisiekwak. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.6",
            "verseOrgIds": [
              "NUM.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigonor Musa siarisiechoto eng’ taitab Jehovah eng’ emaitab baornatet.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ betut ne kiisubi betunoto, kwo Musa emaitab baornatet orit; ak ogeero, kogong’at siaritab Aron ne bo oretab Lawi, ak koyesio taptok, ak kogoi lagoek che ruriotin che kiguure almond. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.8",
            "verseOrgIds": [
              "NUM.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiib Musa siarisiek tugul kobunu taitab Jehovah si konde taitab lagokab Israel tugul: ak kigeer, ak kiinem chi age tugul siarinnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jehovah Musa, Ketite siaritab Aron kwo taitab baornatet, si kegonor koek kaborunet amu lagokab ngelelik; si kobiit iwong’u kang’unyng’ung’enywa ne ing’unyng’ung’jina, si mabek. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyai anyun Musa ko u noto: ko u ye king’at Jehovah, kiyai ko u noto.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi lagokab Israel Musa kolenji, Keero, kagibegu, kagilusye, kagilusye tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meei chi age tugul ne rikyin gotab Jehovah: tos kiwong’uge achek tugul?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.13",
            "verseOrgIds": [
              "NUM.17.13"
            ]
          }
        }
      ]
    }
  ],
