          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nito boisiet ne bo gorikab werikab Merari, ko u boisienywa tugul, eng’ emait ne kituiyechin, ne bou Itamar weritab Aron tisiindet.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
