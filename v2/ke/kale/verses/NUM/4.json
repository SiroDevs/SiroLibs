          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ng’atutietab laisenywa, ko u boisienywa tugul eng’ emait ne kituiyechin; baoinik che bo got, ak rateiywekyik, ak lumeiywekyik ak kelongonikyik che tononie; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
