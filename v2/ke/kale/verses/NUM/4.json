          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak lumeiywek che yiemei seremut kotuiyo, ak kelongonikwak, ak tigongenikwak, ak boroonikwak, koboto tugukwak tugul ak boisienywa: ak oborji chi age tugul kainetab kit ne laei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
              "NUM.4.32"
            ]
          }
        },
        {
