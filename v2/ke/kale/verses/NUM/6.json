        "style": "s1"
      },
      "items": [
        {
          "text": "Bitonwekab Nasaretik",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
