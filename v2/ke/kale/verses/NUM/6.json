            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "King’alalji anyun Jehovah Musa kolenji, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwachi Aron ak werikyik ilenji, Oberur lagokab Israel ko u ni; olenjini ichek,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
