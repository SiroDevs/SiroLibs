          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ng’atutietab Nasiritindet ne ibortae kayosiennyi, ak ne bo kagochinennyi ne igochin Jehovah ne bo katabanennyi, koboto tuguk alak che imuchi konyor; ko u kayosiennyi, nyolu anyun koyai ko u ng’atutietab katabanennyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kaberuroik che kiging’at tisiik koberure bik",
          "type": "text"
        }
      ]
    },
