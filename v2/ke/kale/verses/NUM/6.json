              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeityo konem tisiindet kusto ne kagiyo ne bo mengit, ak konem eng’ kerebet makatiat agenge ne ming’in ne ma kinde mermerek, ak makatiat agenge ne terter, ne ma kinde mermerek, ak konde tukchoto eunekab Nasiritindet, ye kagonem metit agobo katabanennyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak koongoi tisiindet choto koek kagochinet ne kiongoi eng’ taitab Jehovah; tilil nito, bo tisiindet, koboto tagatet ne kiongoi ak chatit ne kinamjin barak; ak ye ibata noto anyun komuch Nasiritindet koee divaik.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
