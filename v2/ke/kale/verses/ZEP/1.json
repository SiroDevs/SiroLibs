          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyonjin kiruogetab Jehovah Juda ak Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’olyotab Jehovah ne kinyonji Sepania weritab Kusi, weritab Gedalia, weritab Amaria, weritab Hesekia, eng’ betusiekab Josia weritab Amon, laitoriatab Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agesu tuguk tugul eng’ ng’ony, mwaei Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agesu chi ak tiony; agesu taritikab barak, ak njirenikab nyanjet, koboto kanagutik ak kiptengeginik; ak abar bik eng’ ng’ony, mwaei Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak atokyini eunnyu Juda, ak bik tugul che menyei Jerusalem; ak abar che king’et che bo Baal eng’ olito, koboto kainetab Kemarik ak tisiik; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ichek che ilosu tuguk tugul che bo kipsengwet, eng’ gorik barak; koboto icheget che ilosu, che iyosiechin Jehovah, ak koyostos eng’ kainetab Malkam; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ichek che kiweek kometo Jehovah; koboto ichek che ma cheng’ Jehovah, anan koteepse inendet.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sis eng’ taitab Kiptaiyat Jehovah: amu kagorik betutab Jehovah: amu kagochob Jehovah tiseiywot, kagoanyiny toekyik. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak tun abire eng’ betutab tiseiywotab Jehovah, bounik, werikab laitoriat, koboto ichek tugul che ilaachi ngoroikab toek. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak abire eng’ betunoto tugul che torombenjin tugatuk, che inyiiti gotab kiptaiyandenywa koromnatet ak ng’alset. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaei Jehovah kole, Tun biitu eng’ betunoto waagatab rirek ne bunu ormarichetab njirenik, ak waagat ne bunu kebebertab nganaset, koboto cheet ne o ne bunu tulonok che mengechen. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owaach okwek bik che omenye Maktes, amu kabek chemung’arainik tugul: ak kibarei ichek tugul che kitinyei fedaisiek ng’isiat. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak asiach Jerusalem eng’ betusiechoto akweng’ate; ak abir bik che kigotepto kimnatenywa ko u divaik che mi ak misigikyik, che mwaei eng’ mugulelwekwak kole, Mayaei Jehovah ne mie, ama yaei yaitiet. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak keluul magornatenywa, ak koguber gorikwak: ee, teechei gorik, ago mamenyei; ak komin mbarenikab sabibuk, ago maeei divaikwak.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.13",
            "verseOrgIds": [
              "ZEP.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.13",
            "verseOrgIds": [
              "ZEP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karik betut ne o ne bo Jehovah, negit ak kochogu mising’, agot twegunetab betutab Jehovah; rirei eng’ ng’wanindo eng’ oloto chito ne kim. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.14",
            "verseOrgIds": [
              "ZEP.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egu betunoto betutab neregek, betutab nyalilda ak bichiindo, betutab ng’emisiet ak kubernatet, betutab mesundeito ak tuuindo, betutab bolik ak mesundeito ne nyigis. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.15",
            "verseOrgIds": [
              "ZEP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Betutab iriaget ak waagat, agobo nganasok che ng’ototin, ak irimoik che tororen. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.16",
            "verseOrgIds": [
              "ZEP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aipchi bik bichiindo, kot kobendat ko u bik che koriotin, amu kigoyachi Jehovah tengekto: ak ketumda korotikwak ko u temburiek, ak keranda borwekwak ko u ng’atatek. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.17",
            "verseOrgIds": [
              "ZEP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama imuchi fedaisiekwak anan tahabusiekwak kosor ichek eng’ betutab neregekab Jehovah; ago kibeelei emet komugul eng’ matab ng’etkondanyi: igesu, ee, igesu eng’ kamuiset, ichek tugul che menyei emet.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.18",
            "verseOrgIds": [
              "ZEP.1.18"
            ]
          }
        }
      ]
    }
  ],
