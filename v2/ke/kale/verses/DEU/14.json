{
  "id": "DEU.14",
  "number": "14",
  "bookId": "DEU",
  "reference": "Ng'Atutik 14",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "DEU 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kanyol keistoegei bitonwekab bororiosiek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O lagokab Jehovah Kamuktaindeng’wong’: amowat borwekwok, amobiorgei amu ne kame. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu i bororiet ne tilil eng’ Jehovah Kamuktaindeng’ung’, ak kigolewenin Jehovah iegu bororiennyi ne itabanat kosiir bororiosiek tugul che mi ng’ony.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat iam kiy age tugul ne kiwechei. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.3",
            "verseOrgIds": [
              "DEU.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chu tiong’ik che oame: teta, kechiriet, ng’ororiet, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.4",
            "verseOrgIds": [
              "DEU.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak che u teweretiot, cheptirgichet, ak chemnyogoset: ak ng’ororietab timin ak kiplelgutiet, ak kenyelet ak sitwet. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.5",
            "verseOrgIds": [
              "DEU.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak tiony age tugul ne pcheotin siok, che kipcheunegei aeng’, ne itori baroi eng’ tiong’ik, oam noto. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.6",
            "verseOrgIds": [
              "DEU.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago amat oam chu eng’ che itori baroi, anan che betotin siok: tambesiet, kiblengwet, keneriet, amu itori baroi ago ma pcheotin siok, ng’wonen eng’ okwek. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.7",
            "verseOrgIds": [
              "DEU.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak toret, amu betotin siok ago maitori baroi, ng’wan noto eng’ okwek: amat oam banyekwak; amotwa ye kame.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chu che oame eng’ che mi beek: oam age tugul ne tinyei kebebaik ak berik. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.9",
            "verseOrgIds": [
              "DEU.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago mat oam age tugul ne matinyei kebebaik ak berik; ng’wan noto eng’ okwek.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuchi oam taritik alak tugul che miachen. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.11",
            "verseOrgIds": [
              "DEU.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago amat oam chu: kipsichit, ak motonda, ak chelogomiet; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.12",
            "verseOrgIds": [
              "DEU.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "chepkupkupchiet ak chesireret, ak keeret ak tugul che kergei; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.13",
            "verseOrgIds": [
              "DEU.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak chepkuginik ak tugul che kergei; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.14",
            "verseOrgIds": [
              "DEU.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak tiondab songolik, ak keeretab kemoi, ak taritiet ne leel ne bo nyanjet, ak keeret ak che kergei; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.15",
            "verseOrgIds": [
              "DEU.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak sugurut ne ming’in, ak sugurut ne o, ak sugurut ne tinyei kuinoik; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.16",
            "verseOrgIds": [
              "DEU.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak chebokibabaa, ak chepsengwet, ak taritietab nyanjet; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.17",
            "verseOrgIds": [
              "DEU.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kong’onyot ak chelogomiet ak che kergei, ak chesululit, ak reresiet. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.18",
            "verseOrgIds": [
              "DEU.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’wonen eng’ okwek tuguk tugul che ing’onioti che tinyei kebebaik: magiamei. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.19",
            "verseOrgIds": [
              "DEU.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuchi oam taritik alak tugul che miachen. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.20",
            "verseOrgIds": [
              "DEU.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat oam ne kame inegei: imuchi igochi kipsagarindet ne mi kurgotiguk koam; anan ialdochi toondet: amu i bororiet ne tilil eng’ Jehovah Kamuktaindeng’ung’. Amat iyoe aruetab ng’oror chegab kamet.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng’atutik agobo kebeberwekab taman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igoite iman kebebertab taman ne bo iyotet tugul ne bo kesweguk che biitu eng’ mbar kenyit age tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.22",
            "verseOrgIds": [
              "DEU.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iamisiei eng’ taitab Jehovah Kamuktaindeng’ung’, eng’ ole leweni konde kainennyi komeny oloto, kebebertab taman ne bo beguk, ak divaiguk, ak mwaniguk, ak che twatei akweng’ung’, ak kechireguk; si inetge iywei Jehovah Kamuktaindeng’ung’ kotugul. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
            "verseOrgIds": [
              "DEU.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo uuit banda eng’ inye, amu kebeberwechoto amu loo eng’ inye oloto leweni Jehovah Kamuktaindeng’ung’ konde kainennyi, ye tun iberurin Jehovah Kamuktaindeng’ung’;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ialde anyun koek fedaisiek, ak irat si iib eng’ eung’ung’, ak iwe komosta ne leweni Jehovah Kamuktaindeng’ung’: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak iale fedaisiechoto kit age tugul ne machei muguleldang’ung’, ngo tuga, anan kechirek, anan divaik, anan maiyek, anan kiy age tugul ne machei sobondang’ung’: ak iam eng’ oloto eng’ taitab Jehovah Kamuktaindeng’ung’, ak ibaibaitu, inye, ak bikab gong’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amebagakte Lawindet ne mi kurgotiguk; amu matinyei kebeberta anan borotet koboten. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye igesgei kenyit age tugul ne bo somok inemu kebeberwekab taman che bo rurateng’ung’ tugul eng’ kenyinoto, ak igonore oldang’ung’: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "si konyo Lawindet amu matinyei kebeberta anan borotet koboten, ak toondet, ak ne matinyei kwanda, ak mosok, choto mi kurgotiguk nyo koamis ak kobiyong’so; si koberurin Jehovah Kamuktaindeng’ung’ eng’ boisiet tugul ne bo euneguk.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
          }
        }
      ]
    }
  ],
