              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chubot chi ne ibegei ak osotiotab kwandanyi; amu kang’any ach ngorietab kwandanyi. Ak kole bik tugul, Amen.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
