              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chubot chi ne imaasi kiruogetab ne toondet, ak ne matinyei kwanda, ak mosoget. Ak kole bik tugul, Amen.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
