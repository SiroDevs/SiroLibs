          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
