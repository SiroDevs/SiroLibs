            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amemwa kainetab Jehovah Kamuktaindeng’ung’ eng’ tangoi: amu iityin Jehovah ng’ogisto ne mwaei kainennyi eng’ tangoi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rib betutab sabato, itaban, ko u ye king’atin Jehovah Kamuktaindeng’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iboisiei eng’ betusiek lo, ak iyai boisioniguk tugul: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago betutab tisab ko sabato ne bo Jehovah Kamuktaindeng’ung’: ameyai boisiet betunoto, inye, anan wering’ung’, anan cheptang’ung’, anan otwogeng’ung’ ne muren, anan otwogeng’ung’ ne tie, anan eitang’ung’, anan sigirieng’ung’, anan tuguk, anan toondeng’ung’ ne mi kurgotiguk; si komuuny otwogeng’ung’ ne muren ak otwogeng’ung’ ne tie ko u inye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ibwat ile ki i otwoget eng’ emetab Misri, ago kiimoong’un Jehovah Kamuktaindeng’ung’ eng’ oloto, eng’ eut ne kim, ak eng’ eut ne chuulat: king’atin anyun eng’ noto Jehovah Kamuktaindeng’ung’ irib betutab sabato.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
