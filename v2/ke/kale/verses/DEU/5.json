            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwachi Jehovah tuiyeng’wong’ komugul ng’alechuto tugul eng’ tulwet eng’ mat, ak eng’ boldet, ak imenindo ne o, eng’ kutit ne o: ak kima tes alak. Ak kisirji koik aeng’ che lebelen, ak kogona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        }
      ]
