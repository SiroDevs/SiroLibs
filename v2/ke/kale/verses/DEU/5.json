            "number": "32",
            "style": "v",
            "sid": "DEU 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orib anyun si oyai ko u ye king’atak Jehovah Kamuktaindeng’wong’: amomaste obe tai anan katam. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obun ortinwek tugul che king’atak Jehovah Kamuktaindeng’wong’, si osopche, ak komieit eng’ okwek, ak kochang’ait betusiekwok eng’ emet ne oname kobunjok.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        }
      ]
