          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amegase miat osotiotab chitab kokweng’ung’; anan imakyige gotab chitab kokweng’ung’, anan emennyi, anan otwogennyi ne muren, anan ne tie, anan eitanyi, anan sigiriennyi, anan kiy age tugul ne bo chitab kokweng’ung’.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
