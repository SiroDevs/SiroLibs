              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiguut kweanaichoto somogu igondisiek, ak kotui terenik, ak koname eunekab katam kegenganikab mat, ak konam igondisiek eng’ eunekwak che bo tai si koguut: ak kiwaach kole, Rotwetab chok ne bo Jehovah ak ne bo Gideon.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.20",
            "verseOrgIds": [
              "JDG.7.20"
            ]
          }
        }
