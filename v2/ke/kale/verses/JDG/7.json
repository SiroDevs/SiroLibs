          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiguut igondisiechoto bogol somok, ak kogochi Jehovah kobar chi age tugul chito ne kaonei, ak kobargei ak luget tugul: ak kimwei luget kot koit Bet-sita kotokyigei Serera, kot koit kiwotetab Abel-meola, ole negite Tabat.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        }
      ]
