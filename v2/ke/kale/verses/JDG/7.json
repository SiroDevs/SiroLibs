          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitonon chi tugul eng’ komostanyi ko kayiem nganaset: ak kiibokto luget tugul: ak kowaach ak koon bichoto.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.21",
            "verseOrgIds": [
              "JDG.7.21"
            ]
          }
        }
      ]
