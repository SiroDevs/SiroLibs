            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilanda anyun Jepta kwo ole mi lagokab Amon, kobargei ak ichek; ak kiinde Jehovah ichek eunekyik. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibar ichek, kong’eete Aroer kot koit Minit, nganasok tiptem, kot koit Abel- keramim, kibar eng’ baret ne o kot. Kigiterter anyun lagokab Amon eng’ taitab lagokab Israel.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.33",
            "verseOrgIds": [
              "JDG.11.33"
            ]
          }
        }
      ]
    },
