              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiteekyi anyun Josua Jehovah Kamuktaindetab Israel, kaptisisiet eng’ tulwetab Ebal, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko u ye king’at Musa otwogindetab Jehovah lagokab Israel, ko u ye kigisir eng’ bukuitab Ng’atutikab Musa, kaptisisietab koik che ma kiwai, che ma wai chi eng’ karna: ak kiigochi eng’ yoto Jehovah kagochinoik che kibeelei, ak kieng’ji kagochinoikab kalyet. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
