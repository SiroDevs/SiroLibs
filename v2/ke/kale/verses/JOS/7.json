{
  "id": "JOS.7",
  "number": "7",
  "bookId": "JOS",
  "reference": "Josua 7",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
