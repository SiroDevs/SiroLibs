              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.33",
            "verseOrgIds": [
              "JOS.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiigochi ortinwekab lagokab Merari, che ichek che king’et eng’ Lawik, eng’ bororietab Sebulun, Jokneam koboto emotinwekyik che kiyagisie, ak Karta koboto emotinwekyik che kiyagisie, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.34",
            "verseOrgIds": [
              "JOS.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimna koboto emotinwekyik che kiyagisie, Naalal koboto emotinwekyik che kiyagisie; nganasok ang’wan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.35",
            "verseOrgIds": [
              "JOS.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ bororietab Reuben, ko ki Beser koboto emotinwekyik che kiyagisie, ak Jahas koboto emotinwekyik che kiyagisie, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
              "JOS.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedemot koboto emotinwekyik che kiyagisie, ak Mepaat koboto emotinwekyik che kiyagisie; nganasok ang’wan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ bororietab Gad, ko ki Ramot eng’ Gilead koboto emotinwekyik che kiyagisie, noto ko ki nganaset ne mwachin rumindet, ak Maanaim koboto emotinwekyik che kiyagisie; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesbon koboto emotinwekyik che kiyagisie, Jaser koboto emotinwekyik che kiyagisie; nganasok ang’wan tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
            "verseOrgIds": [
              "JOS.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuto tugul ko ki nganasokab lagokab Merari ko u ortinwekwak, koboto che king’et eng’ ortinwekab Lawik; ak barbariandenywa ko ki nganasok taman ak aeng’.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganasok tugul che bo Lawik eng’ kwenutab emetab lagokab Israel ko ki nganasok artam ak sisiit koboto emotinwekwak che kiyagisie. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitinyei age tugul eng’ nganasochuto emotinwekyik che kiyagisie che kiyiem: ki u noto eng’ nganasochuto tugul.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiigochi anyun Jehovah Israel emet tugul ne kiiyosiechi kwanisiekwak kole tun igochin; ak kinam kobunji, ak komeny; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiigochi Jehovah ichek kamuung’et eng’ komoswek tugul, ko u tugul che kiiyosiechi kwanisiekwak: ak ma biit chi eng’ bunikwak tugul ne kiimuch kotonon eng’ tainywa; kiinde Jehovah bunikwak tugul eunekwak. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma bet ng’olyo agot agenge ne mie ne kiga komwachi Jehovah gotab Israel; kiisulda tugul.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
