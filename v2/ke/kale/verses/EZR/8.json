        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kebe anyun eng’ ainetab Ahaba eng’ betutab taman ak aeng’ ne bo arawet ne bo tai, kebe Jerusalem: ak kimi kobotech eutab Kamuktaindennyo, ak kisoruech eng’ eutab bunyot, ak ne kisapchinech eng’ oret. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigibwa Jerusalem, ak ketebe yoto betusiek somok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ betut ne bo ang’wan ko kigiger feda ak tahabu ak terenik eng’ gotab Kamuktaindennyo, kigigochi Meremot weritab Uria tisiindet; ak kimi koboto inendet Eleasar weritab Pineas; ak kimi koboto ichek Josabad weritab Jesua, ak Noadia weritab Binui, Lawik; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kigiit tuguk tugul ak keger: ak kigisir ole ki te nyigisindo eng’ betunoto.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        }
