          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitaach anyun tisiik ak Lawik ole ki te nyigisindab feda ak tahabu, ak terenik, si koib kobwa Jerusalem gotab Kamuktaindennyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
