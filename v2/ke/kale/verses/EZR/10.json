          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ werikab Satu ko ki Elioenai, Eliasib, Matania, Jeremot, Sabad, ak Asisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.27",
