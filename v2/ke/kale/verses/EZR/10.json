          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ werikab Bani ko ki Mesulam, Maluk, Adaia, Jasub, Seal ak Jeremot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.29",
