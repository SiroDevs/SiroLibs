          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ werikab Harim ko ki Elieser, Isija, Malkija, Semaia, Shimeon; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.31",
            "verseOrgIds": [
