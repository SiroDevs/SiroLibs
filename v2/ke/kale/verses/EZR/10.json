          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ werikab Bebai ko ki Jeohanan, Hanania, Sabai, Atlai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.28",
            "verseOrgIds": [
