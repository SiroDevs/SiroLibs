          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ werikab Pahat-moab ko ki Adna, Kelal, Benaia, Maaseia, Matania, Besalel, Binui, ak Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.30",
