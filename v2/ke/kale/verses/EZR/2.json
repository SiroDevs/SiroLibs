          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Besai ko ki bogol somok ak tiptem ak somok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.17",
            "verseOrgIds": [
              "EZR.2.17"
            ]
