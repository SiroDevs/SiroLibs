            "number": "14",
            "style": "v",
            "sid": "EZR 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Bigbai ko ki elfusiek aeng’ ak konom ak lo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.14",
            "verseOrgIds": [
              "EZR.2.14"
