        {
          "text": "Mbartanyisiekwak ko ki bogol tisab ak sosom ak lo; ak nyumbusiekwak ko ki bogol aeng’ ak artam ak mut; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.66",
