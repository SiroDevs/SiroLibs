          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Adonikam ko ki bogol lo ak tamanwogik lo ak lo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.13",
            "verseOrgIds": [
              "EZR.2.13"
            ]
