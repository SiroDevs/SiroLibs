              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netinik tugul, ak lagokab otwogikab Solomon, ko ki bogol somok ak tamanwogik sogol ak aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.58",
