              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiek tuiyet tugul elfusiek artam ak aeng’ ak bogol somok ak tamanwogik lo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.64",
            "verseOrgIds": [
