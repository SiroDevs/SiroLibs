              "type": "text"
            }
          ]
        },
        {
          "text": "tambesikwak ko ki bogol ang’wan ak sosom ak mut; sigirok ko ki elfusiek lo ak bogol tisab ak tiptem.",
          "type": "text",
          "attrs": {
