        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chu anyun ko bikab emonoto, che kiga togos kobunu ole kiga kiluulji, che bo che kiga kiluul, che kiga luul Nebukadnesar laitoriatab Babulon koba Babulon, che kiweek koba Jerusalem ak Juda, kiwa chi tugul nganasennyi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "che kigabwa koboto Serubabel, Jesua, Neemia, Seraia, Reelaia, Mordekai, Bilsan, Mispar, Bigbai, Reum, ak Baana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koitetab murenikab bikab Israel: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Paros ko ki elfusiek aeng’ ak bogol ak tamanwogik tisab ak aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.3",
            "verseOrgIds": [
              "EZR.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Sepatia ko ki bogol somok ak tamanwogik tisab ak aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.4",
            "verseOrgIds": [
              "EZR.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Ara ko ki bogol tisab ak tamanwogik tisab ak mut. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.5",
            "verseOrgIds": [
              "EZR.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Pahat-moab, eng’ lagokab Jesua ak Joab, ko ki elfusiek aeng’ ak bogol sisiit ak taman ak aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.6",
            "verseOrgIds": [
              "EZR.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Elam ko ki elfut agenge ak bogol aeng’ ak konom ak ang’wan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.7",
            "verseOrgIds": [
              "EZR.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Satu ko ki bogol sogol ak artam ak mut. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.8",
            "verseOrgIds": [
              "EZR.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Sakai ko ki bogol tisab ak tamanwogik lo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.9",
            "verseOrgIds": [
              "EZR.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Bani ko ki bogol lo ak artam ak aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.10",
            "verseOrgIds": [
              "EZR.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Bebai ko ki bogol lo ak tiptem ak somok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.11",
            "verseOrgIds": [
              "EZR.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagokab Asgad ko ki elfut agenge ak bogol aeng’ ak tiptem ak aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.12",
            "verseOrgIds": [
              "EZR.2.12"
            ]
          }
