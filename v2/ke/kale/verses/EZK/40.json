          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiek kakwautik tiptem che bo eut koindab keterut, koek kakwautik taman ak agenge che bo eut tebeesindo; ak kimi tuguk tamanu che kigitiegoti ketogosyin yoto: ak kimi tolochik ole negite tugatugik, kimi age komosi, komi age komosin.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.49",
            "verseOrgIds": [
              "EZK.40.49"
            ]
