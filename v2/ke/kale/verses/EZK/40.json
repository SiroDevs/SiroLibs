          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiimutwa anyun anyo keterutab got, ak kiikwa tugatukyet age tugul ne bo keterut, kiek kakwautik mut che bo eut komosi, koek kakwautik mut che bo eut komosin: ak kiek tebeesindab ormarichet kakwautik somok che bo eut komosi koek kakwautik somok komosin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.48",
            "verseOrgIds": [
              "EZK.40.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
