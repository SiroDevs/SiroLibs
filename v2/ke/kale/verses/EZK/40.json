          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi got ne bo orit koboto kurgennyi ye negite tugatugikab ormarichok; kigiune yoto kagochinet ne kibeelei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.38",
            "verseOrgIds": [
