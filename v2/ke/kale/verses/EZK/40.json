              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi keterut komoswek tugul, ne ki kakwautik tiptem ak mut che bo eut koindo, ak ki kakwautik mut che bo eut tebeesindo. ",
          "type": "text",
          "attrs": {
