        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 40:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi ye negite keterutab ormarichet, mesosiek aeng’u eng’ komosi ak aeng’ eng’ komosin, che kieng’jin kagochinet ne kibeelei, ak kagochinetab tengekto, ak kagochinetab chalwokto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.39",
            "verseOrgIds": [
              "EZK.40.39"
            ]
