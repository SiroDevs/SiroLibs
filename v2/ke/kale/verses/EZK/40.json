          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi ormarichet ne kebunei kebendi seremut ne bo orit ne tokyingei murot ne bo tai: ak kiikwa kong’eete ormarichet age agoi ormarichet age kotokyigei murot ne bo tai, koek kakwautik bogol che bo eut.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.27",
            "verseOrgIds": [
              "EZK.40.27"
            ]
          }
        }
