              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi long’eiywot ne tinyei tuguk tisab che kitiegoti, ketogostoi, ak kimi keterut tainywa: ak kitinyei tugatugikyik itonwekab tironik komosi ak komosin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.26",
            "verseOrgIds": [
              "EZK.40.26"
            ]
          }
        },
        {
