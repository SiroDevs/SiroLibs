              "type": "text"
            }
          ]
        },
        {
          "text": "Ago, keero, inye weritab chi, ratenen bichoto boroonik, ak koratin eng’ tuguchoto si memande ole mi ichek: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
