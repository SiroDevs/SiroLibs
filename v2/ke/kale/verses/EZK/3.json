            }
          ]
        },
        {
          "text": "Kichuta anyun tamirmiriet, ak konama atonon; ak king’alalwa, kolenja, Ui, kerjige gong’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.24",
