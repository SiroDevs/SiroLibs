            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ chito ne bo bororiosiek, ne ma bo biguk Israel, ngo nyo eng’ emet ne loo agobo kaineng’ung’ ne o, ak agobo eung’ung’ ne kim, ak eung’ung’ ne chuulat; ye bwa ak kosa kotokyigei goi: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "igas anyun eng’ kipsengwet eng’ oldang’ung’ ole imenye, ak iyai ko u tuguk tugul che kaguurjin chichoto bo bororiosiek; si kobiit konai kaineng’ung’ bik tugul che bo ng’ony, ak koiywein, ko u ye iywein biguk Israel, ak si kobiit konai kole goi kiateech kemwaitoe kaineng’ung’.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
