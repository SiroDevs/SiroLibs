          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitogosta anyun laitoriatab Israel ak Jeosapat laitoriatab Juda koba Ramot- gilead. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.28",
            "verseOrgIds": [
              "2CH.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenji laitoriatab Israel Jeosapat, Awalegei aegu age, ak awe luget; ago ilaach inye ngoroik che bo laitornatet. Kowalgei anyun laitoriatab Israel koek age, ak koba luget.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
