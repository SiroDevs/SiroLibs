{
  "id": "JHN.10",
  "number": "10",
  "bookId": "JHN",
  "reference": "Johana 10",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JHN 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mestowot ne Mie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwawok, iman, iman, ale, Chorin ak ko rebin inendet ne mabunei kurgetab biutab kechirek, ne lanyei oldo age. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.1",
            "verseOrgIds": [
              "JHN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago mestowotab kechirek inendet ne bunei kurget. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.2",
            "verseOrgIds": [
              "JHN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatyin inendet ribindetab kurget; ak kasei kechirek kutinnyi: ak kuurei kechirekyik eng’ kainaikwak, ak kondoe ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.3",
            "verseOrgIds": [
              "JHN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kagomaanda inendet chechiget tugul koba sang’, kondoe, ak kosub kechirek inendet: amu ingen kutinnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.4",
            "verseOrgIds": [
              "JHN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak machamei kosub toondet, ago mwee: amu manaei kutuswekab toek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.5",
            "verseOrgIds": [
              "JHN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komwachi Jesu ichek kalewenoni: ago ma iguiyo ichek kole nee tuguchoto kiga mwachi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.6",
            "verseOrgIds": [
              "JHN.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.6",
            "verseOrgIds": [
              "JHN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji anyun Jesu ichek kogeny, Amwawok, iman, iman, ale, A kurgetab kechirek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.7",
            "verseOrgIds": [
              "JHN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chorik ak ko rebik tugul che kiindounena: ago ma kas kechirek ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.8",
            "verseOrgIds": [
              "JHN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kurget: ngwo chi age tugul go ne buna ane, kesoru, ak kwo go, ak komanda sang’, ak konyor ole kiyage. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.9",
            "verseOrgIds": [
              "JHN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyonei chorindet si kochor, ak kobar, ak kong’em kityo: kianyo si kobiit konyor sobondo, ak kotepto sobonato inne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.10",
            "verseOrgIds": [
              "JHN.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.10",
            "verseOrgIds": [
              "JHN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mestowot ne mie: igoitoi mestowot ne mie sobondanyi agobo kechirek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.11",
            "verseOrgIds": [
              "JHN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago inendet ne otwogin, ne ma mestowot, ne ma chitab kobo kechirek, kogeerei konyonei suiyot, ak kobagakta kechirek, ak komwei, ak konam anyun suiyot ichek, ak koiyesta: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.12",
            "verseOrgIds": [
              "JHN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "komwei inendet amu otwogin, ak mamage kiy kechirek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.13",
            "verseOrgIds": [
              "JHN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mestowot ne mie; ak angen chechuk, ak kongena chechuk, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.14",
            "verseOrgIds": [
              "JHN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko u ye ingena Kwanda, ak angen Kwanda; ak agoitoi sobondanyu agobo kechirek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.15",
            "verseOrgIds": [
              "JHN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak atinye kechirek alak, che ma bo biuni: kanyol aget choto agichek, si kogas kutinnyu: ak koek akwet agenge, ak mestowot agenge.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.16",
            "verseOrgIds": [
              "JHN.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.16",
            "verseOrgIds": [
              "JHN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chama anyun Kwanda amu noto, amu agoitoi sobondanyu, si kobiit anam kogeny. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.17",
            "verseOrgIds": [
              "JHN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marebena chi, ago agoitoi anege. Atinye kimnatet agoito, ak atinye kimnatet anam kogeny. Kiataach ng’atutioni eng’ Baba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.18",
            "verseOrgIds": [
              "JHN.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.18",
            "verseOrgIds": [
              "JHN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibiit toiyet kogeny eng’ Yahudik agobo ng’alechuto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.19",
            "verseOrgIds": [
              "JHN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile che chang’ eng’ ichek, Tinyei oindet, ak koamei iywek; kalya si ogas inendet? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.20",
            "verseOrgIds": [
              "JHN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole alage, Ma bo ng’alechu chi ne tinyei oindet. Tos imuchi oindet koyat konyekab chito ne korat?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.21",
            "verseOrgIds": [
              "JHN.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu eng’ igortab katabanet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.21",
            "verseOrgIds": [
              "JHN.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi igortab katabanet eng’ Jerusalem: ak ki betusiekab kaititindo; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.22",
            "verseOrgIds": [
              "JHN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiwendot Jesu eng’ hekalut eng’ keterut ne bo Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.23",
            "verseOrgIds": [
              "JHN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibwa anyun Yahudik koyiem inendet, kolenji, Igonech kigenisie eng’ saget kot kotianit? Ngo i Kristo, imwawech komie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.24",
            "verseOrgIds": [
              "JHN.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji Jesu kolenji, Kiamwawok, amoyani: boisiosiek che ayae eng’ kainetab Baba ko choto che baorianjina. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.25",
            "verseOrgIds": [
              "JHN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago moyani, amu mobo kechirekyuk. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.26",
            "verseOrgIds": [
              "JHN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasei kutinnyu kechirekyuk, ak angen ichek, ak kosuba: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.27",
            "verseOrgIds": [
              "JHN.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak agochini ichek sobondab koigeny; ak magoi lusyo, ama rebena chi ichek eng’ eunnyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.28",
            "verseOrgIds": [
              "JHN.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Baba, ne kigona ichek, kosiir tugul; ama mi chi ne imuchi koreb ichek eng’ eutab Baba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.29",
            "verseOrgIds": [
              "JHN.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ane ak Kwanda, ko ki agenge.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.30",
            "verseOrgIds": [
              "JHN.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koromnatetab Yahudik",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.30",
            "verseOrgIds": [
              "JHN.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinam anyun Yahudik koik kogeny kolen kolach inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.31",
            "verseOrgIds": [
              "JHN.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji Jesu kolenji, Koaboruok boisiosiek che chang’ che miach che bunu Kwanda; olacha agobo boisio nee eng’ choto? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.32",
            "verseOrgIds": [
              "JHN.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji Yahudik inendet kolenji, Magilachin amu boisiet ne mie, ago amu chotisiet; ak amu inye ne i chi, iyaege iegu Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.33",
            "verseOrgIds": [
              "JHN.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji Jesu bichoto, kolenji, Tos ma sirat eng’ Ng’atutieng’wong’ kele, Kiamwa ale, O cheptalelisiek? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.34",
            "verseOrgIds": [
              "JHN.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo kigoguure inendet ichek cheptalelisiek, icheget che kinyonji ng’olyotab Jehovah (ama imugaksei kebut sirutiet), ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.35",
            "verseOrgIds": [
              "JHN.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "tos omwae agobo inendet, ne kiitaban Kwanda ak koyokto kwo ng’ony, olenjini, Ichotisiei; amu kiale, A Weritab Jehovah? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.36",
            "verseOrgIds": [
              "JHN.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngot ko mayai boisiosiekab Kwandanyu, ko mat oyana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.37",
            "verseOrgIds": [
              "JHN.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngayai, ko agot ngo moyana, oyan boisiosiek: si kobiit onai ak oyan ole mi Kwanda eng’ ane, ak ane eng’ Kwanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.38",
            "verseOrgIds": [
              "JHN.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicheng’ anyun kogeny konam inendet: ago kibetito eng’ eunekwak.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwa kogeny Jordan komosin ole kiibatisanisie Johana eng’ tai; ak kitebi eng’ oloto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibwanji che chang’ inendet; ak kole, Kima yai Johana kaborunet; ago tuguk alak tugul che kimwa Johana agobo chichi ko bo iman. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyan inendet che chang’ eng’ oloto.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
          }
        }
      ]
    }
