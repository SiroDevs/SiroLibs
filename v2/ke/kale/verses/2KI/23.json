          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki bo kenyisiek tiptem ak mut Jeoiakim ye kitau kolaitorani; ak kilaitoran kenyisiek taman ak agenge eng’ Jerusalem: ak kainetab kamennyi ko ki Sebida cheptab Pedaia ne bo Ruma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
