            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiigochi Jeoiakim feda ak tahabu Parao; ago king’at emet kogon fedaisiek ko u ng’atutietab Parao: kimage feda ak tahabu bik che bo emet, chi age tugul ko u ye kiging’at, si kogochi Parao-neko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
