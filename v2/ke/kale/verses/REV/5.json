          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng’ang’utiet agobo Aruetab Jehovah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiageer eng’ eutab tai ne bo inendet ne kitebe ng’echeranato bo laitornatet, bukuit ne kigisir orit ak batai, ne kiging’och kogerak eng’ ng’oksosiek tisab. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiageer malaikaiyat ne kim komwaitoi eng’ kutit ne o, kole, Ng’o ne nyolu koyat bukuit ak kotiach ng’oksosiekyik? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kima komi chi kipsengwet, anan ng’ony, anan kureret ne bo ng’ony ne kiimuchi koyat bukuinoto, anan kogeer orit. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiarir mising’, amu kima biit chi ne nyolu koyat bukuinoto, anan kogeer orit: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kilenja age eng’ boisiechugai, Merire: keero, kigoterter Ng’etundo ne bo oretab Juda, Tigitiot ne bo Daudi, si kobiit koyat bukuinoto ak ng’oksosiechoto tisab.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiageer eng’ kwenutab ng’echeranato bo laitornatet ak tiong’ichoto ang’wan soptos, ak eng’ kwenutab boisiechoto, kotonone Aruet, ko u ne kageeny, kotinyei kuinoik tisab, ak konyek tisab, che Tamirmirik tisab che bo Jehovah, che kigiyokto koba ng’ony komugul. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo, ak koib bukuit eng’ eutab tai ne bo inendet ne tebe ng’echeranato bo laitornatet. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingo kagoib bukuinoto, kobutyi taitab Aruet tiong’ichoto ang’wanu soptos ak boisiechoto tiptem ak ang’wan, kotinyei age tugul ketubet, ak tabok che bo tahabu che nyiitotin nyamdutik che kebeelei, che choto ko sautikab bik che tililen. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kotieni tiendo ne leel, kolen, Nyoljinin inam bukuit, ak iyat ng’oksosiekyik: amu kigibarin, ak kiialji Jehovah eng’ korotiguk bik che bo bororiet age tugul, ak che bo kutit age tugul, ak che bo bik alak tugul, ak che bo emet age tugul, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiiyai ichek koek bororiet ak tisiik eng’ Jehovah nenyo; ak kobounisiei eng’ ng’ony.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.10",
            "verseOrgIds": [
              "REV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.10",
            "verseOrgIds": [
              "REV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiageer ak agas kutitab malaikaisiek che chang’ ko kayiem ng’echeranato bo laitornatet ak tiong’ichu kasoptos ak boisiechugai; ak koitenywa ko ki elfusiek taman konyil elfusiek taman, ak elfusiek konyil elfusiek; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "komwaei eng’ kutit ne o kole, Nyoljin Aruet ne kigibar konyor kimnatet, ak magornatosiek ak ng’omnatet, ak kamuktaet, ak teegisto, ak torornatet, ak kaberuret. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiagas kit age tugul ne kigiyai ne mi kipsengwet, ak ne mi ng’ony, ak ne mi kureretab ng’ony, ak eng’ nyanjet, ak tuguk tugul che mi orinywa, kolen, Ingobunji inendet ne tebe ng’echeretab laitornatet, ak Aruanato, kaberuret, ak teegisto, ak torornatet, ak bounatet, koigeny ak koigeny.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwa tiong’ichoto ang’wanu soptos kole, Amen. Ak kobutyi ng’ony boisiechoto ak kolos.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.14",
            "verseOrgIds": [
              "REV.5.14"
            ]
          }
        }
      ]
    }
