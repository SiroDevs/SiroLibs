          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak inendet ne iterteri, ak koribei boisionikyuk agoi kagesunet, kotun agochini kimnatet koboi bororiosiek: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
