          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak abare lagokyik meet; ak konai kanisosiek tugul kole anendet ne isiachi kabwatutik ak mugulelwek: ak agochini age tugul eng’ okwek ko u boisionikwok.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        }
