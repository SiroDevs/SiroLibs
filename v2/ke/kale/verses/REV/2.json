          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago amwawok okwek che o ng’etunotin eng’ Tuatera, tugul che matinyei konetisioni, che maingen tuguk che bo orit che bo Setani, ko u ye mwaei ichek; ale maandook milet age. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago onam mising’ noto otinye kot aitu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
            ]
          }
        }
      ]
