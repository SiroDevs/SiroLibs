          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak koboi eng’ koroktab karnet; ko u ye kituei terenikab cheptereniot komengegitu; ko u ye kiataach agane eng’ Baba: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
            "verseOrgIds": [
              "REV.2.27"
            ]
          }
        },
