            "number": "26",
            "style": "v",
            "sid": "HEB 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibagakta Misri eng’ kayanet, amaiywei neregekab laitoriat: amu kimuita, ko u ye keerei inendet ne ma toogu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.27",
            "verseOrgIds": [
              "HEB.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyai paska eng’ kayanet, ak isisietab korotik, si matwa ichek ne kibarei werik che bo tai.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.28",
            "verseOrgIds": [
              "HEB.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.28",
            "verseOrgIds": [
              "HEB.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilandae Nyanjet ne Birir eng’ kayanet ko u ye bunei emet ne yaamat; ak ye kilen kotiem Misrik koyai ko u noto kelugui.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’ kayanet ko kilulyo irimoikab Jeriko, kingo kageyiem betusiek tisab. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.30",
            "verseOrgIds": [
              "HEB.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’ kayanet ko ma me chepkugoniot Rahab koboto ichek che ki ngelelik, amu kiga taach segeik eng’ kalyet.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.31",
            "verseOrgIds": [
              "HEB.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
