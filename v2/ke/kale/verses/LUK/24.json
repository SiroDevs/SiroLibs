{
  "id": "LUK.24",
  "number": "24",
  "bookId": "LUK",
  "reference": "Luka 24",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "LUK 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keririt ne kima komi kiy",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ betut ne bo tai ne bo wigit, ko kaeech emet, kobwa kererit, koibu nyamdutik che kiga kochob. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.1",
            "verseOrgIds": [
              "LUK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyor ko kagemilda koita eng’ kererit. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.2",
            "verseOrgIds": [
              "LUK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiba orit, amanyor bortab Kiptaiyat Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.3",
            "verseOrgIds": [
              "LUK.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingab kagerer met agobo noto, ogeero, kitonondos eng’ ye negit ichek murenik aeng’u che tinyei ngoroik che lilei bich: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.4",
            "verseOrgIds": [
              "LUK.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kingoiyweis, kong’uruk, kotiing’e togochikwak ng’ony, kolenji ichek, Amu nee si ocheng’e ne sobei eng’ oldab che kigobek? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.5",
            "verseOrgIds": [
              "LUK.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma komi yu, ago kagong’eet: obwat kit ne kimwawok kota komi Galili, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.6",
            "verseOrgIds": [
              "LUK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolen kanyol kinde eunekab bikab tengek Weritab chi, ak kigartat, ak kong’eet eng’ betutab somok.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.7",
            "verseOrgIds": [
              "LUK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.7",
            "verseOrgIds": [
              "LUK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobwat anyun ng’alekyik, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.8",
            "verseOrgIds": [
              "LUK.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak koweektagei eng’ kererit, ak komwachi taman ak agenge, ak chun tugul alak. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.9",
            "verseOrgIds": [
              "LUK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki Maria Magdalene, ak Joana, ak Maria kametab Jakobo, ak kobogorisiek alak che kimi koboto ichek, che kimwachi che kiyoktoi tuguchoto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.10",
            "verseOrgIds": [
              "LUK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigeer bichoto ng’alechato ko u tangoi; ak kima iyan ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.11",
            "verseOrgIds": [
              "LUK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago king’eet Petero, ak kolabat kererit; kiing’uruk koiit orit, kogeer ngoroik ichegei; ak kwo, kokwong’oti agobo tuguk che kagoyagis.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koborugei Jesu eng’ oret kowendi Emau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ogeero, kibendi aeng’u eng’ icheget betunoto nganaset age ne kiguure Emau, ne ki bandab maelisiek tisab ak nusu kong’eete Jerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.13",
            "verseOrgIds": [
              "LUK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’alaljinotegei agobo ng’alechuto tugul koyaagis. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.14",
            "verseOrgIds": [
              "LUK.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingota kong’alaljinotegei ak koteebegei, korikyi Jesu ichek ak koba tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.15",
            "verseOrgIds": [
              "LUK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kigerogis konyekwak si manai inendet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.16",
            "verseOrgIds": [
              "LUK.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.16",
            "verseOrgIds": [
              "LUK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek, Nee ng’alechu omwachinotige okwege obendi? Ak kitononso, kosiriny togochikwak. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.17",
            "verseOrgIds": [
              "LUK.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwolji age eng’ ichek, ne keguure Kleopa, kolenji, Tos i too inye eng’ Jerusalem si menai tuguk che koyaagis eng’ oloto eng’ betusiechu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.18",
            "verseOrgIds": [
              "LUK.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek, Nee tuguchoto? Ak kilenji, Tuguk che kiyaak agobo Jesu ne bo Nasaret ne ki maotiot ne kim eng’ boisiet ak ng’olyot eng’ taitab Jehovah and eng’ bik tugul: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.19",
            "verseOrgIds": [
              "LUK.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ko u ole kiigoito tisiik che eechen ak bounikyok si kiruokyi kiruoget ne bo meet, ak kigartat. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.20",
            "verseOrgIds": [
              "LUK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kogimang’u kelen inendet ne itiachi Israel. Ee, ak koboto choto tugul ko betutab somok rani koboch ngab kobata ng’alechuto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.21",
            "verseOrgIds": [
              "LUK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kagonech kobogorisiek alak che kagimi tugul kekwong’, che kaga musta kererit; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.22",
            "verseOrgIds": [
              "LUK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ye kamata konyor bortanyi, kobwa, kole, kamong’ji ichek malaikaisiek, che kamwa kole, sobei inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.23",
            "verseOrgIds": [
              "LUK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kaba alak kererit che kami kobotech, konyor ko u noto ko u ye kaga mwa kobogorisiek: ago ma keer inendet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.24",
            "verseOrgIds": [
              "LUK.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.24",
            "verseOrgIds": [
              "LUK.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji anyun bichoto, Ee, che berberen, ak ko tamusen mugulelwek kot ko mata koyan tuguk tugul che kimwa maotik! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.25",
            "verseOrgIds": [
              "LUK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kima nyolji Kristo konyalil eng’ tuguchu, si komong’ji torornatennyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.26",
            "verseOrgIds": [
              "LUK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitoi koboch Musa ak maotik tugul, ak kiiarorji ichek eng’ sirutik tugul ng’alek agobo inendet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.27",
            "verseOrgIds": [
              "LUK.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.27",
            "verseOrgIds": [
              "LUK.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingorikta nganaset ole kibendi koigei inendet ne machei kosiirto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.28",
            "verseOrgIds": [
              "LUK.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiisimji, kole, Tebi kobotech: amu karikta koimen, ak machei koratarat. Ak kiwa go kotebi tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.29",
            "verseOrgIds": [
              "LUK.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingo kagotebi ng’ony tugul koamisiei, konam makatiat, koberur, kobutul, ak kogochi ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.30",
            "verseOrgIds": [
              "LUK.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiyatogis konyekwak, ak konai inendet; kobetito eng’ tainywa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.31",
            "verseOrgIds": [
              "LUK.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenjigei ichegei, Tos kama lal mat eng’ mugulelwekyok, yu kang’alalwech eng’ oret, kong’ang’wech sirutik? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.32",
            "verseOrgIds": [
              "LUK.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’eetyo eng’ sainato, koweektagei Jerusalem, ak kinyor taman ak agenge ko katuiyo, ak che kimi koboto ichek, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.33",
            "verseOrgIds": [
              "LUK.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kole, Kang’eet Kiptaiyat iman, ak kang’ang’jigei Simon. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.34",
            "verseOrgIds": [
              "LUK.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi ng’alek che kayaak eng’ oret, ak ko u ye kagonyit inendet kobutuli makatiat.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koborjingei Jesu che kiyoktoi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingota komwaei tuguchu, kotonon inendet eng’ kwenunywa, ak kolenji ichek, Ingoteb kalyet eng’ okwek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.36",
            "verseOrgIds": [
              "LUK.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiarogenso ak koiyweis, ak kilen kageer tamirmir. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.37",
            "verseOrgIds": [
              "LUK.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek, Koarogenji nee? Ak amu nee si kong’eetyo kererwekab met eng’ mugulelwekwok? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.38",
            "verseOrgIds": [
              "LUK.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeer eunekyuk ak kelyekyuk, ole a inendet: osapsaba, ak ogeer; amu matinyei tamirmiriet borto ak kowek, ko u yu ogeere atinye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.39",
            "verseOrgIds": [
              "LUK.24.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.39",
            "verseOrgIds": [
              "LUK.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kiga komwa ni, koborji eunekyik ak kelyekyik. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.40",
            "verseOrgIds": [
              "LUK.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingo tom koyan ichek amu boiboiyet, ak kwong’et, kolenji, Otinye eng’ yu kiy ne kiamei? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.41",
            "verseOrgIds": [
              "LUK.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiigochi kebebertab njiriot ne kagiwatan. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.42",
            "verseOrgIds": [
              "LUK.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinam ak koam eng’ tainywa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.43",
            "verseOrgIds": [
              "LUK.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek, Chu ko ng’alekyuk che kigamwawok, ye kingota ami kobotok, ko u ye kanyol kosulda tuguk tugul, che kigisir eng’ Ng’atutik che bo Musa, ak eng’ maotik, ak eng’ tienwogikab kalosunet, agobo ane.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.44",
            "verseOrgIds": [
              "LUK.24.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.44",
            "verseOrgIds": [
              "LUK.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyat anyun ng’omnatosiekwak, si kobiit konai sirutik; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.45",
            "verseOrgIds": [
              "LUK.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kilenji ichek, Kigisir ko u noto, kele, nyoljin Kristo konyalil, ak kong’eet kogeny eng’ che kigobek eng’ betutab somok; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.46",
            "verseOrgIds": [
              "LUK.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak keamdaat eng’ bororiosiek tugul sigunet ak nyoetab kaat ne bo tengekwogik eng’ kainennyi, kitaune Jerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.47",
            "verseOrgIds": [
              "LUK.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "O baorinikab tuguchuto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.48",
            "verseOrgIds": [
              "LUK.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ogeero, ayogu kayomisetab Baba kotebi eng’ okwek: ago otebi okwek eng’ nganaset, agoi kilaakwok kimnatet ne bunu barak.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kotogostoi Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiindochi ichek agoi koit Betania: ak kinamji barak eunekyik, ak koberur ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.50",
            "verseOrgIds": [
              "LUK.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingota koberuri ichek, kobesiegei anyun, ak kigimut kwo kipsengwet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.51",
            "verseOrgIds": [
              "LUK.24.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 24:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiilos inendet, ak koweektagei Jerusalem eng’ boiboindo ne o: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.52",
            "verseOrgIds": [
              "LUK.24.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 24:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kimi kotugul hekalut, kolosu Jehovah.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.53",
            "verseOrgIds": [
              "LUK.24.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "END OF BOOK",
          "type": "text"
        }
      ]
    }
