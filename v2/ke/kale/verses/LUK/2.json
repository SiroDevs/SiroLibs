          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.50",
            "verseOrgIds": [
              "LUK.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichorgei anyun koboto icheget, ak kiit Nasaret; ak kigase it ichek: ak kigonor kamet ng’alechato tugul eng’ muguleldanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 2:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitesak ng’omnatetab Jesu, ak etunatet, ak mieindo eng’ Jehovah ak eng’ bik.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
            "verseOrgIds": [
              "LUK.2.52"
            ]
          }
        }
      ]
