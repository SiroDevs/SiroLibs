              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.38",
            "verseOrgIds": [
              "LUK.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingo kagoges tugul ko u Ng’atutietab Kiptaiyat, koweektagei koba Galili, agoi nganasenywa Nasaret. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiner lakwet, ak kotesak kimnatet, ak kinyi ng’omnatet: ak kimi mieindab Jehovah koboto inendet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ming’inatetab Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicham kobendi sigikyik kenyit age tugul Jerusalem eng’ igorta ne bo paska. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.41",
            "verseOrgIds": [
              "LUK.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye ki bo kenyisiek taman ak aeng’, kotogosta ichek koba Jerusalem ko u biteet ne bo igorta; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.42",
            "verseOrgIds": [
              "LUK.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ye kingowong’ betusiek, ye kiweeksei, kong’et lakwet Jesu eng’ Jerusalem: ak kima nai sigikyik; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.43",
            "verseOrgIds": [
              "LUK.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago kilen mi koboto bik che kibendi tugul, koba anyun bandab betut komugul; ak kicheng’ inendet eng’ kwenutab bikab orenywa ak che kiingengei: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.44",
            "verseOrgIds": [
              "LUK.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ye kimanyor inendet, koweektagei Jerusalem, kocheng’at.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.45",
            "verseOrgIds": [
              "LUK.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
