{
  "id": "LUK.18",
  "number": "18",
  "bookId": "LUK",
  "reference": "Luka 18",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "LUK 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiruogindet ne kima ko bo imanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwachi anyun kalewenet kole, Kanyol kosa betusiek tugul, amat chorirenso; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.1",
            "verseOrgIds": [
              "LUK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolenji, Kimitei nganaset age kiruogindo, ne kima koiywei Jehovah, ak kima koiiti chi: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.2",
            "verseOrgIds": [
              "LUK.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kimi mosoget age nganasanato; ne kinyonei ole mi kotugul, kolen, Ibesiewa kiruoget ne bo iman eng’ bunyondennyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.3",
            "verseOrgIds": [
              "LUK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiesio eng’ betusiek alak: ago eng’ let, komwa eng’ orinnyi kole, Agot ngo maiywei Jehovah, amaiiti chi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.4",
            "verseOrgIds": [
              "LUK.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago amu inyalila mosogani, abesiechini anyun, si ma konyonei kotugul koiima.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.5",
            "verseOrgIds": [
              "LUK.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.5",
            "verseOrgIds": [
              "LUK.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile Kiptaiyat, Ogas kit ne kimwa kiruogindet ne ma bo imanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.6",
            "verseOrgIds": [
              "LUK.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tos mayachin Jehovah imanda che lewenotin, che rirjin inendet bet ak kemoi, ak muitoi inendet eng’ ichek? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.7",
            "verseOrgIds": [
              "LUK.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwawok ale, yachin inendet ichek imanda kochokyin. Ago ye tun nyo Weritab chi, ko tos nyoru kayanet eng’ ng’ony?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.8",
            "verseOrgIds": [
              "LUK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Parisaindet ak taagindetab aisurut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.8",
            "verseOrgIds": [
              "LUK.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi kogeny kalewenoni alak che kiimang’ugei kole, ki bo imanda, ak kosasei bik tugul, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.9",
            "verseOrgIds": [
              "LUK.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolenji, Kitogosta bik aeng’u hekalut koba kosa; Parisaindet age, ko taagindetab aisurut age. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.10",
            "verseOrgIds": [
              "LUK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitonon Parisaindet kosa kong’alal inegei ko u ni kole, Jehovah, amwaun kongoi, amu ma ki kergei ak bik alak, che rebik, che ma bo iman, che ibegei, anan taagindoni bo aisurut. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.11",
            "verseOrgIds": [
              "LUK.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arugutige konyil aeng’ eng’ wigit; agoitoi kebeberta ne bo taman eng’ tuguk tugul che anyoru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.12",
            "verseOrgIds": [
              "LUK.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kitonon taagindetab aisurut eng’ ye loo, ak ma cham agot konyal kipsengwet, ago kiluch tegennyi, kole, Jehovah, rirena, a kiptengekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.13",
            "verseOrgIds": [
              "LUK.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwawok ale, kichortagei chichoto gonnyi ko kagoek ne bo imanda kosiir nin age: amu chi age tugul ne itororigei kiming’ini; ak age tugul ne iming’inigei ko tun kitorori.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.14",
            "verseOrgIds": [
              "LUK.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koberuri Jesu manyurunik",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.14",
            "verseOrgIds": [
              "LUK.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiimutyi bik inendet manyurunik, si kobiit kotwa ichek: ago ye kingogeer alamalyet, koger kong’. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiguur Jesu ichek kobwanji, ak kolenji, Ochamji lagok che mengech kobwanja, amat oete: amu bo che u chu bounatetab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwawok iman ale, Age tugul ne mataachei bounatetab Jehovah ko u lakwet ne ming’in, ko magoi mong’ji oloto matiny.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sobondab koigeny; imuchi magornatosiek konach bich",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiteebe inendet bounindet age, kole, Konetindoni mie, ayai nee si kobiit anyor sobondab koigeny? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.18",
            "verseOrgIds": [
              "LUK.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jesu, Amu nee si iguurena ne mie? Mami ne mie, kobate agenge, noto ko Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.19",
            "verseOrgIds": [
              "LUK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingen Ng’atutik, Amoipge, Amerumisie, Amechorse, Amebaorian lembech, Teech kwandang’ung’ ak komet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.20",
            "verseOrgIds": [
              "LUK.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile, Kiarib tuguchuto tugul koboch ko a neran. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.21",
            "verseOrgIds": [
              "LUK.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingogas Jesu, kolenji, Ta ko rartaat kit agenge eng’ inye: alde tugul che itinye, ak ipchechi kibananok, si inyoru konoruet eng’ kipsengwet: ak inyo, isubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.22",
            "verseOrgIds": [
              "LUK.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ye kingogas inendet tuguchu, koarogen mising’; amu ki magorio kot.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.23",
            "verseOrgIds": [
              "LUK.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.23",
            "verseOrgIds": [
              "LUK.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogeer Jesu inendet, komwa kole, Bichii ne tia eng’ che tinyei magornatosiek komong’ji bounatetab Jehovah! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.24",
            "verseOrgIds": [
              "LUK.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu nyamnyum eng’ tambesiet kochut kondab katet, kosiir komong’ji magoriot bounatetab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.25",
            "verseOrgIds": [
              "LUK.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwa anyun che kigasei, kole, Ng’o anyun ne kesoru? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.26",
            "verseOrgIds": [
              "LUK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kile, Tuguk che maimugaksei eng’ bik komugaksei eng’ Jehovah.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.27",
            "verseOrgIds": [
              "LUK.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.27",
            "verseOrgIds": [
              "LUK.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole Petero, Keero, kigebagakte tugukyok, ak kisubun. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.28",
            "verseOrgIds": [
              "LUK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek, Amwawok iman ale, Mami chi ne kibagakta got, anan osotiot, anan che tupcho, anan sigik, anan lagok, agobo bounatetab Jehovah, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne manyoru che chang’ kosiir eng’ betusiechu, ak sobondab koigeny eng’ betusiek che tun bwanei.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.30",
            "verseOrgIds": [
              "LUK.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sib komwaei Jesu ne bo somok agobo meennyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.30",
            "verseOrgIds": [
              "LUK.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiimut taman ak aeng’ kobwa ole mi, ak kolenji, Ogeero, kitogostoi Jerusalem, ak kosulda tuguk tugul che kisir maotik agobo Weritab chi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kindoi inendet eunekab Bororiosiek, si kechurachur, ak kitewer, ak kesing’ilji: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.32",
            "verseOrgIds": [
              "LUK.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kobire kipcharitit, ak kobar: ak kong’eet kogeny eng’ betutab somok. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.33",
            "verseOrgIds": [
              "LUK.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kima iguiyo icheget tuguchuto, agot agenge; ak kiung’ak mwaonito eng’ ichek, ak kima ibesio tuguk che kiga kimwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kosoobi Jesu kipkoratiat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingorikyi Jeriko, ko kitebyei ng’ony kipkoratia eng’ oret taban kosomsei: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.35",
            "verseOrgIds": [
              "LUK.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kingogas kosiirtoi tuiyet, koteeb kole, Nee chu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.36",
            "verseOrgIds": [
              "LUK.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi ichek inendet kolenji, Jesu ne bo Nasaret ne siirtoi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.37",
            "verseOrgIds": [
              "LUK.18.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwaach, kole, Jesu, Weritab Daudi, rirena. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.38",
            "verseOrgIds": [
              "LUK.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiger kong’ inendet anyun che kiindoi, kole kosis: ago kites kowaach mising’ kole, Weritab Daudi, rirena. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.39",
            "verseOrgIds": [
              "LUK.18.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitonon Jesu, ak kong’at kimut inendet kwo ole mi: ak ye kiga rik, koteebe inendet, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.40",
            "verseOrgIds": [
              "LUK.18.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "kole, Imache ayaun nee? Ak kile, Kiptaiyandani, amache ageerto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.41",
            "verseOrgIds": [
              "LUK.18.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jesu, Keerte: kagosoobin kayaneng’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.42",
            "verseOrgIds": [
              "LUK.18.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigeerto anyun ngunoto, ak kosub inendet, kolosunoti Jehovah: ak kingogeer tuiyet komugul, kogonyit Jehovah.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.43",
            "verseOrgIds": [
              "LUK.18.43"
            ]
          }
        }
      ]
    }
  ],
