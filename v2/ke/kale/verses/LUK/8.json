              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kinam inendet eutab cheboto, ak koguur, kole, Chebi, ng’eet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.54",
            "verseOrgIds": [
