          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koweek anyun tamirmiriennyi, ak kong’eet ngunoto: ak king’at kole, kigochi kiy ne amei. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.55",
