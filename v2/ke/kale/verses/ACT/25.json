  "reference": "Boisionikab Che Kiyoktoi 25",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
