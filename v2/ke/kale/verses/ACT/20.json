          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "koarogendos kosiir agobo ng’olyot ne kiga komwa, kole matun kogeerei togennyi kogeny. Ak kiiyomis inendet kowendi kolanyei melit.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
