            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye kingogas anyun agobo ng’eetyetab che kibek, kochombil alage; ago kile alak, Ta kegasun nito betut age. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimanda anyun Paulo eng’ kwenunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kinamgei bik alak ak inendet, ak koyan; ki age eng’ icheget Dionusio Areopagindet, ak kobogoriot ne kiguure Damaris, ak alak che kimi koboto icheget.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.34",
            "verseOrgIds": [
              "ACT.17.34"
            ]
          }
        }
