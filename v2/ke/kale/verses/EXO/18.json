  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "EXO 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koitu Jetro, ak ng’alek che kimwachi Musa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigas anyun Jetro, tisiindetab Midian, kabyugoitab Musa, tugul che kigoyachi Kamuktaindet Musa, ak bikyik Israel, ole kiimutunda Jehovah Israel komong’une Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiimut Jetro, kabyugoitab Musa, Sipora, osotiotab Musa, amu kiga koweekta inendet kwo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak werikyik aeng’; kigiguure age Gerson; amu kile, Kiaegunote kiprutoiyo eng’ emetab bororiosiek alak: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kigiguure age Elieser; amu kile, Kiek toretindennyu Kamuktaindet ne bo baba, ak kisorua eng’ rotwetab chok ne bo Parao: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiit anyun Jetro, kabyugoitab Musa, koboto werikab Musa ak osotiondennyi, ole mi Musa eng’ ong’atet, ole kiimuung’e eng’ tulwetab Kamuktaindet: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.5",
            "verseOrgIds": [
              "EXO.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kilenji inendet Musa, Kaaitu oling’ung’ ane Jetro kabyugoing’ung’, koboto osotiondeng’ung’, ak werikyik aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.6",
            "verseOrgIds": [
              "EXO.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimanda anyun Musa kwo kotorokta kabyugoinnyi, ak kiing’uruk ak kong’utut; ak kiteebegei ole chamdogei; ak kimanda emait orit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.7",
            "verseOrgIds": [
              "EXO.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi Musa anyun kabyugoinnyi tuguk tugul che kigoyachi Jehovah Parao ak Misrik agobo Israel, ak nyalilwogik tugul che kiyor eng’ oret, ak ole kisorundo Jehovah ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.8",
            "verseOrgIds": [
              "EXO.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibaibait Jetro amu mieindo tugul ne kigoyachi Jehovah Israel, amu kisor ichek komong’une eunekab Misrik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.9",
            "verseOrgIds": [
              "EXO.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile Jetro, Iberurot Jehovah, ne kisoruok eng’ eunekab Misrik, ak eng’ eutab Parao; ne kisor bik komong’une bounatetab Misrik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.10",
            "verseOrgIds": [
              "EXO.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angen nguno anyun ale o Jehovah kosiir cheptalelisiek tugul: ee, eng’ kit ne kiyai bichoto eng’ menotet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinam anyun Jetro kabyugoitab Musa kagochinet ne kibeelei ak tiseiywek koeng’ji Kamuktaindet: ak kinyo Aron, koboto boisiek tugul che bo Israel, koamis ak kabyugoitab Musa eng’ taitab Kamuktaindet.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ karonet ne bo aeng’, koteb ng’ony Musa koruoksechi bik: ak kitononso bik eng’ ole mi Musa kong’eete karon agoi koimen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.13",
            "verseOrgIds": [
              "EXO.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingogeer kabyugoitab Musa tuguk tugul che kiyachin Musa bik, kole, Nee ni iyachini bik? Amu nee si itebi inyege, ak kotonondos bik tugul ko kayiemin koboch karon agoi koimen? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.14",
            "verseOrgIds": [
              "EXO.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Musa kabyugoinnyi, Amu bwanjina bik koteepse Jehovah: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.15",
            "verseOrgIds": [
              "EXO.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ye tinyei ng’olyo, kobwanjina; ak abesiechini chi tugul ak chitab kokwennyi, ak aneti ichek konai konetisiosiekab Jehovah, ak ng’atutikyik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji kabyugoinnyi Musa, Ma mie kii iyae. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.17",
            "verseOrgIds": [
              "EXO.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwong’ugei kimnateng’ung’, inye, ak bichu omitei tugul: amu siirei kimnateng’ung’ nito; memuchi iyai inyege. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
            "verseOrgIds": [
              "EXO.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kas anyun ng’olyondennyu, aborun kit ne iyae, ak ingoteb Kamuktaindet koboten: mie iegu ne iipchini Kamuktaindet ng’alekab bik, ak iipchini Kamuktaindet ng’alekwak; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.19",
            "verseOrgIds": [
              "EXO.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak inet ichek konetisiosiek ak ng’atutik, ak iborji oret ne kanyolji kosub, ak boisiet ne kanyolji koyai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.20",
            "verseOrgIds": [
              "EXO.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyolu kogeny ilewenote, eng’ bik tugul, bik che kimen, che iywei Kamuktaindet, bikab imanit, che wechei tugukab ng’wen, ak inde ichek koboi bik, koek bounikab elfusiek, ak che bo bogolwogik, ak che bo konomusiek, ak che bo tamanusiek: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.21",
            "verseOrgIds": [
              "EXO.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ingoruoksechi bik bichoto eng’ betusiek tugul: si koibun ng’olyot age tugul ne uui, ago ingobesiechigei ichegei ng’olyot age tugul ne ming’in: si kobiit konyamnyumun, ak ogesen tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.22",
            "verseOrgIds": [
              "EXO.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngot iyai kiito anyun, ak ngo ng’atin Kamuktaindet ko u noto, imuch anyun itonon, ak koba bichu tugul agichek oldanywa eng’ kalyet.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigas anyun Musa ng’alekab kabyugoinnyi, ak kiyai choto tugul kamwachi inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.24",
            "verseOrgIds": [
              "EXO.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilewenot Musa bik che kimen eng’ Israel tugul, ak kiinde koboi bik, koek bounik che bo elfusiek, ak che bo bogolwogik, ak che bo konomusiek, ak che bo tamanusiek. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.25",
            "verseOrgIds": [
              "EXO.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiruoksechi bik eng’ betusiek tugul: kiipchi Musa ng’alek che uuen, ago kiibesiechigei ichegei ng’olyot age tugul ne ming’in. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.26",
            "verseOrgIds": [
              "EXO.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kichamji Musa kabyugoinnyi kwo; ak kiwa anyun bandanyi agoi emennyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.27",
            "verseOrgIds": [
              "EXO.18.27"
            ]
          }
        }
      ]
    }
  ],
