              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigonor anyun Aron eng’ taitab Baornatet kole kerib, ko u ye king’at Jehovah Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
