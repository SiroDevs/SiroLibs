          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiam lagokab Israel mana kenyisiek artam, agoi koit emet ne menyei bik; kiam mana agoi koit kiwotisiekab emetab Kanan. ",
          "type": "text",
          "attrs": {
