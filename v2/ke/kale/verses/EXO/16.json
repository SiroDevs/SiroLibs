              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiguure gotab Israel amitwogichoto Mana: ki kergei tuguchoto ak bek che mubere che leelach; ak kichamu makatinik che mengechen che kigikwanda kumiat. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
