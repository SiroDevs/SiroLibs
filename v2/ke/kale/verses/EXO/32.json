              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ betut ne kiisubi betunoto, kolenji Musa bik, Kioyai tengekto ne o: katogoste anyun nguno awe ole mi Jehovah: tamangab ayai kagaigaet agobo tengektang’wong’. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiweekyigei Musa Jehovah, ak kolenji, Bwa, kiyai bichu tengekto ne o mising’, ak kigoyachigei kanamwet ne bo tahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago nguno, ngicham inyochi kaat tengektanywa; ak ngo ma u noto asomin ale, iistaa eng’ bukuing’ung’ ne kiisir. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jehovah Musa, Aistoi eng’ bukuinnyu age tugul ne kigoyaiywa tengekto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ui anyun, nguno, indochi bik koba kot koit ole kiamwaun: keero, indoun malaikaiyandennyu: agot nganda u noto, ko eng’ betut ne aruokyini, aruokyini amu tengektanywa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
      ]
