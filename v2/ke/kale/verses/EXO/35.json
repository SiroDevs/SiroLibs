          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Musa lagokab Israel, Ogeero, kagoguur Jehovah Besalel, komwa kainennyi, inendet ko weritab Uri, weritab Hur, ne bo oretab Juda; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kagonyiit inendet Tamirmirietab Kamuktaindet, eng’ ng’omnatet, ak kaguiyet, ak naet, ak konai ole teptoi boisiet age tugul ne bo musognatet; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kobwat ole choptoi boisionikab musognatet, si koboisie tahabu, ak feda, ak sugunonik, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kowai koik che kitetyin kelongonik, ak koyai ketik kobois eng’ boisiet tugul ne bo musognatet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiinde ng’omnatet muguleldanyi si komuch konet inendet, koboto Oholiab, weritab Aisamak, ne bo oretab Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigonyiit inendet ng’omnatet mugulelwekwak, si koyai boisiet tugul ne bo musognatet, ne bo waindet, ak ne bo laindet ne ng’om, ak ne bo nabindet ne nabei kondoi lelesta, eng’ che tuuen ne nyalil, ak eng’ che arusen ne birir, ak eng’ che biriren, ak eng’ katanit ne kararan, agot ne bo regerindet, agot ne bo ichek che yaei boisiet age tugul, ak ne bo icheget che ibwati ole choptoi boisietab musoknatet.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
              "EXO.35.35"
            ]
          }
