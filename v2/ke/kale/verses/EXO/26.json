          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak inab ngorioet ne kigere kurgetab emait, ne tuui ne nyalil, ak ne arus ne birir, ak ne birir, ak katanit ne kararan ne kigila, boisietab chito ne nabei kondoi lelesta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
        {
