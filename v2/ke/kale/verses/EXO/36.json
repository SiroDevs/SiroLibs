          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak lumeiywekwak mut, ak ireusiekwak: ak kiiliige tahabu metowekab lumeiywek, koboto rateiywekwak che kituiye: ak kong’ikwak mut ko ki bo sugunonik.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
