          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimanda Musa eng’ nganaset kwo eng’ ole mi Parao, ak kiitochi eunekyik Jehovah: ak kisisio tulosiek ak koikab ropta, ak mata korobonji ng’ony. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
