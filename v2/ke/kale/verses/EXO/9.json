          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiuuiit muguleldab Parao, ak kima igochi lagokab Israel koba; ko u ye kiga komwa Jehovah eng’ Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
