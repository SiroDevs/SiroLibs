  "reference": "Korintoek 1 2",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
