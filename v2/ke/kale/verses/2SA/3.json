          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lagokab Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibiit boriet eng’ betusiek che chang’ eng’ gotab Saul ak gotab Daudi: ak kigimit Daudi kotesak, ago kichecheiyot kimnatetab gotab Saul kwo let.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigisikyi Daudi werik eng’ Hebron: ak taitanyi ko ki Amnon, ne kisiche Ainoam Jesreelyot; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.2",
            "verseOrgIds": [
              "2SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak werinnyi ne bo aeng’ ko ki Kileab, ne kisichei Abigail ne ki osotiotab Nabal Karmelindet; ak ne bo somok ko ki Absalom ne kisichei Maaka cheptab Talmai laitoriatab Gesur; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ne bo ang’wan ko ki Adonija weritab Hagit; ak ne bo mut ko ki Sepatia weritab Abital; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ne bo lo ko ki Itream ne kisichei Egla osotiotab Daudi. Kigisikyi chuto Daudi eng’ Hebron.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kowendi Abner komostab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kibortos gotab Saul ak gotab Daudi, koyaigei Abner kogimit eng’ gotab Saul.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitinyei Saul chebaigeiyat, ne kigiguure kainennyi Rispa, cheptab Aia: ak kilenji Is-boset Abner, Amu nee si obaige ak chebaigeiyatab baba? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinerech anyun mising’ Abner amu ng’alekab Is-boset, ak kile, A metitab sesetab Juda? Aborjini mieindo rani gotab Saul kwandang’ung’, ak tupchosiekyik, ak choronokyik, ak ma andein eutab Daudi, ago keruokwa rani ile kalel agobo kwonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingoyachi Kamuktaindet ko u noto Abner, ak kotes, ngot ko mayachi ane Daudi ko u ye kiiyosiechi Jehovah inendet; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "auto bounatet eng’ gotab Saul, ak alumde ng’echeretab laitornatet ne bo Daudi koboi Israel ak Juda, koboch Dan agoi Beer-seba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimata komuch kowolji Abner ng’olyot age, amu kiiywei inendet.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyokto bik Abner koba oldab Daudi ne kita wendi inendet kolenji, Bo ng’o emet? Ak kile, Ngeyai tuwai arorutiet kiyomege, ak keero, mi eunnyu koboten, si amutun Israel tugul kobwa ole imi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.12",
            "verseOrgIds": [
              "2SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile Daudi, Mie; ayae arorutiet koboten: ago kit agenge ne amagenen, noto ko ni, megeere togennyu, agoi imutu korok Mikal cheptab Saul, ye inyone igeera. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.13",
            "verseOrgIds": [
              "2SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyokto Daudi bik koba oldab Is-boset weritab Saul, kolenji, Kona osotiondennyu Mikal, ne kianyonune koito irirenik bogol che bo Pilistik. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.14",
            "verseOrgIds": [
              "2SA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyokto Is-boset bik koba komutune manong’otiondennyi, noto ko Paltiel weritab Lais. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.15",
            "verseOrgIds": [
              "2SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiba ak monong’otiondennyi koriroti manong’otiondennyi, ak kiisub kwonyoto kot koit Baurim. Kilenji anyun Abner inendet, Ui, iweektege: ak kiweek.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’alal Abner ak boisiekab Israel, kole, Kiocheng’e koek laitoriandeng’wong’ Daudi eng’ betusiek che kigosiirto: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.17",
            "verseOrgIds": [
              "2SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ara anyun oyai: amu kigomwa Jehovah agobo Daudi kole, Asoru bikyuk Israel eng’ otwogindennyu Daudi eng’ eunekab Pilistik, ak eng’ eunekab bunikwak tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’alalji Abner Benjamin agine kogas: ak kogeny ko kiwa Abner komwachi Daudi kogas eng’ Hebron tuguk tugul che kigeerei Israel ak gotab Benjamin tugul, kole nyolu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.19",
            "verseOrgIds": [
              "2SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiit anyun Abner ole mi Daudi eng’ Hebron, koboto bik tiptem. Ak kiyachi igorta Daudi Abner koboto murenjoto kimi koboto inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.20",
            "verseOrgIds": [
              "2SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Abner Daudi, Ang’eete awendi, ak ayumji Israel tugul kiptaiyandennyu laitoriat, si kobiit koyai arorutiet koboten, ak si kobiit ilaitorane che machei muguleldang’ung’. Ak kimwachi Daudi Abner kwo; ak kiwa eng’ kalyet.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobarei Joab Abner eng’ neregek che ng’wonen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ogeero, kibwa otwogikab Daudi ak Joab luget, ak kiib barunenik che chang’: ago kima komi Abner koboto Daudi eng’ Hebron; amu kiga komwachi kwo, ak kiga wa eng’ kalyet. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.22",
            "verseOrgIds": [
              "2SA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingoit Joab ak luget tugul ne kimi ak inendet, kemwachi Joab kelenji, Kanyo Abner weritab Ner ole mi laitoriat, ak kagolenji kwo, ak kakwa eng’ kalyet. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.23",
            "verseOrgIds": [
              "2SA.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyo anyun Joab ole mi laitoriat, ak konyo kolenji, Nee ne kaiyai? Keero, kanyo Abner oldang’ung’; amu nee si iunde kwo, ak kakwa iman? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.24",
            "verseOrgIds": [
              "2SA.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingen inye Abner weritab Ner ile kanyo koberberin, si konai mandaeng’ung’ ak nyonuneng’ung’, ak konai tuguk tugul che iyae.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingonyo Joab eng’ oldab Daudi, koyokto bik kosub Abner, ak koweech inendet eng’ keringetab beek ne bo Sira: ago ma nai Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.26",
            "verseOrgIds": [
              "2SA.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingo kagoweek Abner konyo Hebron, komut Joab inendet kwo taban agoi kwenutab ormarichet, kwo kong’alalji mutyo, ak kitoor inendet moet eng’ yoto, ak kime, agobo korotikab Asael, ng’etab kamet. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.27",
            "verseOrgIds": [
              "2SA.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogas Daudi eng’ let, komwa kole, Matinye ane ng’ogisto ak bounatennyu eng’ taitab Jehovah koigeny eng’ korotikab Abner weritab Ner: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingotebe metitab Joab, ak kotebe gotab kwandanyi tugul; amat kobet eng’ gotab Joab chi ne tinyei kuseret, anan ne tinyei mogondos, anan ne tebenoti kirokto, anan ne kibarei eng’ rotwetab chok, anan ko ne matinyei amitwogik. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.29",
            "verseOrgIds": [
              "2SA.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibar anyun Joab ak Abisai ng’etab kamet, Abner, amu kiga kobar Abner Asael werit ne tupcho, eng’ Gibeon eng’ luget. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Daudi Joab, koboto bik tugul che kimi ak inendet, Ogerer ngoroikwok, ak ogermenege kuniok, ak oteiye eng’ taitab Abner. Ak kiisubi Daudi kit ne kigisute. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitupchi Abner Hebron: ak kiwaach laitoriat eng’ kutit ne o, ak korir eng’ kereritab Abner; ak kiririo bik tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kirir laitoriat agobo Abner kole,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    }
