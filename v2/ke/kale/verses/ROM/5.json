{
  "id": "ROM.5",
  "number": "5",
  "bookId": "ROM",
  "reference": "Romanik 5",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ROM 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kit ne biitune kayanet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitinye kalyet ak Jehovah eng’ Kiptaiyandennyo Jesu Kristo amu kigiityech imanda eng’ kayanet; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.1",
            "verseOrgIds": [
              "ROM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kigenyoru eng’ inendet agine kemong’ji eng’ kayanet mieinoto kitonone; ak ongeboiboitu eng’ kamang’unetab torornatetab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ma u noto kityo, ago ongeboiboitu eng’ nyalilwogikyok: kingen kele ibu nyalilda muitaet; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.3",
            "verseOrgIds": [
              "ROM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ibu muitaet tiemisiet; ak ibu tiemisiet kamang’unet: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.4",
            "verseOrgIds": [
              "ROM.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "magonu kamang’unet kililan; amu kigerong’ji chamnyetab Jehovah mugulelwekyok eng’ Tamirmiriet ne Tilil ne kigegonech.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiboru chamnyetab Jehovah eng’ meetab Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ye kita ko ki nyalulyotin, kome Kristo agobo che yaachen eng’ betut ne kiga kelewen. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.6",
            "verseOrgIds": [
              "ROM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu bichii kome chi agobo chi ne bo imanda: ago abere kanyei chito age kome agobo chi ne mie. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.7",
            "verseOrgIds": [
              "ROM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago iboruech achek Jehovah chamnyennyi, amu ye kita ko ki kiptengeginik, kome Kristo agobo achek. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.8",
            "verseOrgIds": [
              "ROM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ne siirei mising’ anyun, ko kagiityech imanda eng’ korotikyik, kesoruech eng’ neregekab Jehovah eng’ inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.9",
            "verseOrgIds": [
              "ROM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ye kita ko ki bunik, ko kigituiyech ak Jehovah eng’ meetab Werinnyi, ne siirei mising’ anyun, koga kituiyech, kesoruech eng’ sobondanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.10",
            "verseOrgIds": [
              "ROM.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ma u noto kityo, ago kiboiboi agachek eng’ Jehovah eng’ Kiptaiyandennyo Jesu Kristo, amu kigenyoru eng’ inendet katuiyet.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.11",
            "verseOrgIds": [
              "ROM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Begu bik eng’ Adam, soptos bik eng’ Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.11",
            "verseOrgIds": [
              "ROM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noto anyun, ko u ye kimong’ji ng’ony tengek eng’ chito agenge, ak meet amu tengek; koityi anyun meet bik tugul, amu kiyai tugul tengek - ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.12",
            "verseOrgIds": [
              "ROM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kimi ng’ony tengek agoi koit Ng’atutik: ago magiiti tengek ye mami ng’atutik. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.13",
            "verseOrgIds": [
              "ROM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiboi meet koboch Adam agoi Musa, agot eng’ ichek che kima yai tengekto ne kergei ak bistoetab Adam, ne ki itondab inendet ne ki tun konyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ma u bistoet, konunetab chamnyet. Amu ngo kibek che chang’ eng’ bistoetab agenge, ko kitesak mising’ kosiir eng’ che chang’, mieindab Jehovah, ak konunet eng’ mieindab chito agenge, Jesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.15",
            "verseOrgIds": [
              "ROM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ma kergei kit ne biitune konunet ak kit ne biitune tengektab chito agenge: amu kinyo kiruoget eng’ agenge agoi kagikyinet, ago kinyo konunetab chamnyet eng’ bistautik che chang’ agoi kaiityinetab imanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.16",
            "verseOrgIds": [
              "ROM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ngo kiboi meet eng’ bistoetab agenge; ne siirei mising’ anyun, kobou eng’ sobondo ichek che taachei chang’indab mieindo ak konunet ne bo imanda eng’ agenge, noto Jesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noto anyun, ko u ye kinyonji bik tugul kiruoget agoi kagikyinet eng’ bistoetab agenge; ko u noto kinyonji bik tugul konunet ne kigoitoi buch, agoi kaiityinetab imanda ne bo sobondo eng’ bistoet agenge ne bo imanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.18",
            "verseOrgIds": [
              "ROM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ko u ye kiek che chang’ kiptengeginik eng’ bistoetab chito agenge, ko u noto kiyaei che chang’ kobunji imanda eng’ kasetab it ne bo agenge.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.19",
            "verseOrgIds": [
              "ROM.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.19",
            "verseOrgIds": [
              "ROM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo Ng’atutiet, si kobiit kotesak bistoet; ago ye kitesak tengekto, ko kitesak mieindo mising’ kosiir: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.20",
            "verseOrgIds": [
              "ROM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "si, ko u ye kiboi tengekto eng’ meet, ko u noto bou mieindo eng’ imanda agoi sobondab koigeny eng’ Jesu Kristo Kiptaiyandennyo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.21",
            "verseOrgIds": [
              "ROM.5.21"
            ]
          }
        }
      ]
    }
  ],
