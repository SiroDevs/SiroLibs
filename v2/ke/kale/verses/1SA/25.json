            "number": "38",
            "style": "v",
            "sid": "1SA 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.38",
            "verseOrgIds": [
              "1SA.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogas Daudi kole, kagome Nabal, kole, Iberurot Jehovah, ne kigoruokyinewa Nabal agobo chubet ne kichuba, ak kiete otwogindennyi yaitiet: ak kiweekyi Jehovah metitab Nabal yaitiennyi ne kiyai. Ak kiiyokto Daudi keng’alalji Abigal, si komut koek osotiondennyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.39",
            "verseOrgIds": [
              "1SA.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingoit otwogikab Daudi ole mi Abigail eng’ Karmel, kong’alalji, kolenji, Kagoyokwech Daudi kebwa ole imi, si kimutin iegu osotiondennyi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.40",
            "verseOrgIds": [
              "1SA.25.40"
            ]
          }
        }
      ]
    },
