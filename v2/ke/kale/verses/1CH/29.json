          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak boisionikab laitoriat Daudi, che bo tai ak che bo let, ogeero, sirotin eng’ ng’alekab Samuel keerindet, ak eng’ ng’alekab Natan maotiot, ak eng’ ng’alekab Gad keerindet; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
