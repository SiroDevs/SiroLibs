              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "koboto laitornatennyi tugul ak kimnatennyi, ak betusiekab sobennyi, ak che bo Israel, ak che bo bounatosiek tugul che bo emotinwek.",
