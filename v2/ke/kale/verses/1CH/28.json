  "reference": "Ateptab Betusiek 1 28",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
