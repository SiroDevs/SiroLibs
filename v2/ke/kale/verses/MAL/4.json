          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwat Ng’atutietab Musa otwogindennyu, ne kiang’at inendet eng’ Horeb agobo Israel tugul, noto ko ng’atutik ak kiruogutik.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        }
