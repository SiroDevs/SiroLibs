              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingoabuch lolotinwekwak, ogeero, kimi fedaisiek che bo chi tugul lolennyi ko ratotin: ak ye kingogeer ichek koboto kwandanywa fedaisiekwak che ratotin, koarogenso. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
