          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Reuben kwandanyi, Tun ibar werikyuk aeng’ ngo mamutun inendet kogeny: kona kotebe eunekyuk, ak amutun inendet kogeny. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
              "GEN.42.37"
            ]
