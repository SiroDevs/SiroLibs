          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jakobo kwandanywa, Kiobetena lagokyuk, mami Josep, ak mami Simeon, ak omache omutena Benjamin agine: kabwanja tuguchu tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
