          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kialda Midianik Josep kwo Misri, koal Potipar, kiboitiotab Parao, kiptaiyatab ribik.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
