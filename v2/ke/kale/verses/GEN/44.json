            "number": "34",
            "style": "v",
            "sid": "GEN 44:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu amuktoi ano anyun awo atogosta oldab baba, ama kimi ak lakwet? Si mageer yaitiet ne tun nyoru baba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.34",
