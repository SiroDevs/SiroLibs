          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo keer tisiindet kole ma tesoksei koroyoto eng’ ngoriet, ngo eng’ usisiek che kigitoor anan che kigimur, anan eng’ kiy age tugul ne bo magatet; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
