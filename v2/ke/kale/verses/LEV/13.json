          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "kong’at anyun tisiindet kole, kemwet kioto tinyei koroito, ak kogonor kioto eng’ betusiek tisab alak: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kogeer tisiindet, ko kagiundo koroyoto: ak ngo mawalak koroyoto eng’ saleiywekyik, amainenderi koroyoto, ko ng’wan anyun; ibeel eng’ ma: ng’emindet noto, ngo mitune churatet orit anan sang’.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        }
      ]
    },
    {
