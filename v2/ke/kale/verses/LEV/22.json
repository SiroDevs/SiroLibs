  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "LEV 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bitonwek alak agobo tisiik ak tiseiywek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi Jehovah Musa kolenji, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilenji Aron ak werikyik, kotabanegei tuguk che tililen che bo lagokab Israel, che itabanwa, si mareny kainennyu ne tilil: a Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilenji, King’etoi eng’ tainnyu chi age tugul ne bo iyoteng’wong’ tugul eng’ ibinekwok tugul, ne rikyin tuguk che tililen, che itabanjin lagokab Israel Jehovah, kotinyei muruonindanyi: a Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat koam tuguk che tililen chi age tugul eng’ lagokab Aron ne tinyei mogondos, anan ne tinyei ole mandae tugun, agoi kotililit. Ak age tugul ne twaei ne kigonyor simwo amu musto, anan chito ne mandae keswekab iyotet; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.4",
            "verseOrgIds": [
              "LEV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "anan age tugul ne twaei ne ichuutegei ng’ony, ne ing’waniti chi, anan chi ne imuchi kong’wanit inendet, eng’ muruonindo age tugul ne tinyei; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng’wanitu agoi koimen ne twaei age eng’ choto, ak maamei tuguk che tililen, ngot ko tom koungei. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak koanyinyit, ko karorokto asis; ak yeityo koam tuguk che tililen, amu amitwogikyik choto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat koam banyekab tiong’ik che begu ichegei, anan che tonatoni tiong’ik, si mat kong’wanitgei eng’ choto: a Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ribei anyun kotigonutikyuk, si manam ichek tengektab tuguchoto, ak kobekyi tuguchoto ngo reny: ane Jehovah ne atabani ichek.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maamei kipsagarin age tugul tuguk che tililen: maamei bunotyot ne bo tisiindet, anan otwogindet ne nyoru melekto, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago ngo al tisiindet chi, koale siling’isiekyik, koamei noto tuguchoto; ak che kisikyin gonnyi, amei choto amitwogikyik. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngotun cheptab tisiindet kipsagarin, ko maamei cheboto kagochinet ne kinamjin barak, ne bo tuguk che tililen. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngo mosok cheptab tisiindet, anan ngo kion manong’otiot, ama sich lakwa, ak koweektagei gotab kwandanyi: ko u ye kita koming’in, koamei inendet amitwogikab kwandanyi: ago maamei kipsagarindet age tugul choto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngo am chi age tugul tuguk che tililen ama nai, kotesyin choto anyun kebebertab mut, ak kogochi tisiindet kioto tilil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat koreny tuguk che tililen che bo lagokab Israel, che igochin Jehovah; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "si konyor ng’ogisto, ye amei tugukwak che tililen: amu ane Jehovah ne atilili ichek.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’alalji Jehovah Musa kolenji, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwachi Aron, ak werikyik, ak lagokab Israel tugul, ilenji ichek, Age tugul ne bo gotab Israel, anan che bunotik eng’ Israel, ne igoitoi kagochinennyi, ngo bo kagochinonoto age tugul eng’ arorutikwak, anan ko age tugul eng’ kagochinoikwak che bo chamnyet ne igochin Jehovah koek kagochinet ne kibeelei; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "si kobiit ketaachak, ogoitoi kagochinet ne kirgit ne libwob eng’ tuga, anan eng’ kechirek, anan eng’ ng’ororek. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago amat ogoite ne ma libwob; amu magitaachei noto agobo okwek. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak chi age tugul ne igoitoi tiseiywot ne bo kagochinoikab kalyet kogochin Jehovah, si kobiit koyai kosulda noto ne kiga koaror, anan kagochinetab chamnyet, ne bo tuga, anan ko ne bo kechirek, kanyol koek ne igesunotgei si kobiit ketaach; ne mabiitune berutiet age tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat ogochi Jehovah chu: ne korat, anan ne kigoil, anan ne kigonyor berut, anan ne rootei tugun, anan ne tinyei kochek, anan ne tinyei kacheet, amoyai koek kagochinet ne bunei mat eng’ kaptisisiet, kele kigochi Jehovah eng’ choto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imuchi igoite koek kagochinetab chamnyet kirgit anan aruetab kechir ne tinyei tuguk che u kunduenik, anan kebeberta ne mami eng’ bortanyi; ago magitaachei ngo bo kit ne kigiaror. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat ogochi Jehovah ne kigibir kitik, anan ne kigitui, anan ne kigong’etyo, anan ne kigitil; amat oyai ko u noto eng’ emeng’wong’. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amotaach eng’ eutab kipsagarin amitwogikab Kamuktaindeng’wong’, alak tugul eng’ chu, ole, si ogoite; amu mi ng’emisienywa ichek, tinyei berutik: magitaachei choto agobo okwek.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi Jehovah Musa kolenji, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye kagii kirgit, anan kechiriet, anan ng’ororiet, kotebyei ak kamet betusiek tisab; ak eng’ betut ne bo sisiit ak kwo tai, ketaachei koek kagochinet ne bunei ma ne kigochin Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat oeny teta ne kotoy anan kechiriet ne kotoy, koboto moitanyi anan aruennyi betunak. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye oeng’ji Jehovah tiseiywotab kongoi, oeng’ji si kobiit ketaachak. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiamei eng’ betunoto; amotuuch kiy kot koeekyi: a Jehovah.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
