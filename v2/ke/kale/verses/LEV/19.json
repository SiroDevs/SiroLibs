              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoyai ne ma bo iman eng’ kiruoget anan ye okwai eng’ koindo, anan ye ogere eng’ nyigisindo, anan eng’ karogutik che bo tuguk che bei. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboisie kerutik che aechin che bo iman, ak kamanutik che bo iman eng’ nyigisindo, ak epah ne bo iman; ak hin ne bo iman; a Jehovah Kamuktaindeng’wong’ ne kiamutwak omong’une emetab Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
