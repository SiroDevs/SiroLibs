              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amat oam kiy age tugul koboto korotikyik: amoboisie bonisiet, anan ong’orse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
