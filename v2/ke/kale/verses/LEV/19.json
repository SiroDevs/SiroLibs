              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameyachi ne ya toondet ne mi koboten eng’ emeng’wong’. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.33",
            "verseOrgIds": [
