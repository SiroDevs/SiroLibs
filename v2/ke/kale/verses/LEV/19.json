              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amegoite cheptang’ung’, koyait, koek chepkugonio; si maisub emet kugoinatet, ak konyi emet tengekto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
