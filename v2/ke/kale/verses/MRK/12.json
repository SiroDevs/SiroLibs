  "copyright": "PUBLIC DOMAIN",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "MRK 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalewenet agobo mbaret ne bo sabibuk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitoi kong’alalji ichek eng’ kalewenaik kole, Kiminji chito age sabibuk mbaret, ak kong’ot, ak kobal keringet ole kirurung’e sabibuk, ak koteech got ne koi, ak komanakyi meek, ak kwo emet age. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.1",
            "verseOrgIds": [
              "MRK.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingoit betusiekab kesisiet, koyokto otwogindet kwo ole mi meek, si kobiit konyorune meechoto logoek che bo mbaretab sabibuk. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.2",
            "verseOrgIds": [
              "MRK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinam inendet, ak kobir, ak koon kwo buch. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.3",
            "verseOrgIds": [
              "MRK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyokyi kogeny otwogindet age; ak kibir metinnyi, ak kotewer. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.4",
            "verseOrgIds": [
              "MRK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyokto age; ak kobar inendet: ak kiiyokto alak che chang’; kobir alak, kobar alak. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.5",
            "verseOrgIds": [
              "MRK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kita kotinyei anyun agenge, noto werinnyi ne chamat: kiiyokto inendet eng’ let kwo ole mi ichek, kole, Teechei werinnyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.6",
            "verseOrgIds": [
              "MRK.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago king’alalso meechoto ichegei, kolen, Nito ne namei tuguk; obwa, kebar inendet, si kindii tuguk. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.7",
            "verseOrgIds": [
              "MRK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinam inendet, ak kobar, ak kowirta komanda eng’ mbaret ne bo sabibuk.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.8",
            "verseOrgIds": [
              "MRK.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.8",
            "verseOrgIds": [
              "MRK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaei nee anyun chitab kobo mbaret ne bo sabibuk? Nyonei anyun kobarei meechoto, ak komanakyi meek alak mbaranato bo sabibuk. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.9",
            "verseOrgIds": [
              "MRK.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tom osoman sirutichu;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.10",
            "verseOrgIds": [
              "MRK.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.10",
            "verseOrgIds": [
              "MRK.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibunu ng’olyondoni Kiptaiyat, ak ko kwong’ut eng’ konyekyok?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.11",
            "verseOrgIds": [
              "MRK.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.11",
            "verseOrgIds": [
              "MRK.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kicheng’ei ole namdoi inendet; ago kiiywei tuiyet; amu kinai kole kamwa kalewenoni agobo ichek: ak kibagakta inendet, ak koba.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.12",
            "verseOrgIds": [
              "MRK.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng’olyot ne kigiteeb agobo tuguk che kigochin Kaisari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.12",
            "verseOrgIds": [
              "MRK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyokyi Parisaik alak ak che bo Herodik, si korate ng’alekyik. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.13",
            "verseOrgIds": [
              "MRK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingobwa, kolenji inendet, Konetindoni, kingen kele i bo iman, ameiti chi age tugul: amu megeere itondab chi, ago ineti iman oretab Jehovah: Tos chamdoi ng’atutik kigochi kodi Kaisari, anan machamdoi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.14",
            "verseOrgIds": [
              "MRK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigoite anan acha? Ago kinai inendet chombilenywa, ak kolenji ichek, Kalya si otiema? Oibwa denarit ageer. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.15",
            "verseOrgIds": [
              "MRK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiipchi. Ak kilenji ichek, Bo ng’o itoni ak sironi? Ak kolenji, Bo Kaisari. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.16",
            "verseOrgIds": [
              "MRK.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jesu, Ogochi Kaisari tuguk che bo Kaisari, ak ogochi Jehovah tuguk che bo Jehovah. Ak kikwong’io mising’ agobo inendet.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.17",
            "verseOrgIds": [
              "MRK.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng’olyot ne kigiteeb agobo ng’eetyet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.17",
            "verseOrgIds": [
              "MRK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibwanji inendet Sadukaik, che mwaei kole, mami ng’eetyet, ak koteebe inendet, kole, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.18",
            "verseOrgIds": [
              "MRK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konetindoni, kisirwech Musa kole, Ngo me ng’etab kametab chi, ak kobagakta osotiondennyi, ama sich lakwa, kondii ng’etab kamet osotiondonoto, si kobiit kolalji mat ng’etab kamet. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.19",
            "verseOrgIds": [
              "MRK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi werik tisabu che kitupcho: ak kiitunis werit ne o, kome ama sich lakwa; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.20",
            "verseOrgIds": [
              "MRK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiindi agine ne bo aeng’, kome ama sich lakwa; ak kiigei noto agine ne bo somok: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.21",
            "verseOrgIds": [
              "MRK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ma biitune tugul tisab lakwa. Let kome agine kobogoriondonoto. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.22",
            "verseOrgIds": [
              "MRK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tun eng’ ng’eetyet kobunjin ng’o eng’ ichek osotiondonoto? Amu kiga kobunji choto tisab. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.23",
            "verseOrgIds": [
              "MRK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jesu ichek, Ma noto ne kigonok olel, amu mongen sirutik, anan kimnatetab Jehovah? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.24",
            "verseOrgIds": [
              "MRK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ye tun ng’eetyo ichek komong’ eng’ che kibek, ko maitunisiei, ama kituni; ago tebyei ko u malaikaisiek eng’ kipsengwet. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.25",
            "verseOrgIds": [
              "MRK.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago agobo bik che kigobek, kele tun ng’eetos, ko tom osoman eng’ bukuitab Musa, eng’ ole kimi Ketit, ko u ye kimwachi Jehovah inendet, kolenji, A Jehovah ne bo Abraham, ak a Jehovah ne bo Isak, ak a Jehovah ne bo Jakobo? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.26",
            "verseOrgIds": [
              "MRK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inendet ko ma Jehovah ne bo che kigobek, ago bo che soptos: olele mising’.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng’olyot ne kigiteeb agobo ng’atutiet ne o eng’ tugul",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo age eng’ sirik, ak kogas koteebegei, ak kingonai kole kawolji ichek komie, koteebe inendet, kole, Nee ng’atutiet ne bo tai eng’ tugul? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji Jesu kolenji, Ne bo tai ni, Ogaso, ee, Israel; Kiptaiyat Jehovah nenyo, ko Kiptaiyat agenge: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak icham Kiptaiyat Jehovah neng’ung’ eng’ muguleldang’ung’ komugul, ak eng’ sobondang’ung’ komugul, ak eng’ ng’omnateng’ung’ komugul, ak eng’ kimnateng’ung’ komugul. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.30",
            "verseOrgIds": [
              "MRK.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bo aeng’ ko ni, Cham chitab kokweng’ung’ ko u ole ichamdoige. Mamitei ng’atutiet age ne o kosiir chu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji sirindet, Iman, Konetindoni, kaimwa komie, ile, inendet ko agenge; ama mi age kobate inendet: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.32",
            "verseOrgIds": [
              "MRK.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ngocham inendet eng’ muguleldo komugul, ak eng’ kaguiyet komugul, ak eng’ kimnatet komugul, ak ngo cham chitab kokwet ko u ole chamdogei, kosiirei noto kagochinoik tugul che kibeelei ak tiseiywek. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogeer Jesu kole kawol eng’ ng’omnatet, kolenji, Ma i loo eng’ bounatetab Jehovah. Ak mata kogany chi koteebe ng’olyo age tugul.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristo Weritab Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kiinetisiei Jesu eng’ hekalut, komwa kole, Lyon si komwaei sirik kole, Kristo ko weritab Daudi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.35",
            "verseOrgIds": [
              "MRK.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwa Daudi inendet eng’ Tamirmiriet ne Tilil, kole,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuure Daudi inendet Kiptaiyat; koegundoi ano anyun werinnyi? Ak kiepchin it tuiyet ne o inendet eng’ boiboindo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.37",
            "verseOrgIds": [
              "MRK.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kanyol keribege sirik",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.37",
            "verseOrgIds": [
              "MRK.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ konetisiennyi, kolenji, Oribege sirik, che chamei kobendat kolaachi ngoroik che koen, ak kagatosiek eng’ oldinwekab aldaisiet, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.38",
            "verseOrgIds": [
              "MRK.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ng’echerok che bo tai eng’ sunagogisiek, ak oldinwek che bo tai eng’ igorwek: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.39",
            "verseOrgIds": [
              "MRK.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak korebe ichek mosogik gorikwak, ak kosaei sautik che koen kong’alsei; nyoru bichu kiruoget ne o kosiir.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.40",
            "verseOrgIds": [
              "MRK.12.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tuguk che kiigoito mosoget",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.40",
            "verseOrgIds": [
              "MRK.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiteb ng’ony kotokyigei ole kiyumjin tuguk che kigoitoi, kogeer ole indoitoi tuiyet sendeisiek ole kiyumjin: ak kiinde magorek alak sendeisiek che chang’. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.41",
            "verseOrgIds": [
              "MRK.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo mosoget age ne kibanania, ak konde sendeisiek aeng’, che u kebeberta ne ming’in ne bo denarit. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.42",
            "verseOrgIds": [
              "MRK.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiguur alamalyennyi anyun kobwa ole mi inendet, ak kolenji, Amwawok iman ale, Kagonde mosogani banan che siirei che kagonde bik tugul che indoi tugukwak ole kiyumjin: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.43",
            "verseOrgIds": [
              "MRK.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kagonde ichek tugul che bo chang’indab tugukwak; ago kagonde inendet che bo banandanyi, tugul che katinyei, agot che kosobe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.44",
            "verseOrgIds": [
              "MRK.12.44"
            ]
          }
        }
      ]
    }
  ],
