{
  "id": "ISA.13",
  "number": "13",
  "bookId": "ISA",
  "reference": "Isaia 13",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
