          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kitonatoni Suriek eng’ twegunetab Jehovah, ne birei eng’ kirokto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
        {
