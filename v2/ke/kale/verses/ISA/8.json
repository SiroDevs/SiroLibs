{
  "id": "ISA.8",
  "number": "8",
  "bookId": "ISA",
  "reference": "Isaia 8",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ISA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kaborunet agobo Maer-salal-hasbas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenja Jehovah, Ipchige kit ne o ne kisirei, ak isire kalamitab chito, Agobo Maer-salal-hasbas; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "si kobiit acheng’jige baorinik che kiyani, kosir tuguk che biitu, Uria tisiindet, ak Sekaria weritab Jeberekia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiawe anyun oldab chebioset ne maotio; ak kimanach, ak kosich werit. Kilenja Jehovah anyun, Tochi kainennyi Maer-salal-hasbas. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kotom komuch lakwanato kotwek kole, Baba, ak Eiyo, koluulei laitoriatab Asuria magornatosiekab Damasko ak barunenikab Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehovah ak bunikab Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’alalwa Jehovah kogeny, kole, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.5",
            "verseOrgIds": [
              "ISA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kiesio bichu beekab Siloa che rootei mutyo, ak koboiboitune Resin ak weritab Remalia; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "keero, ipchin anyun Kiptaiyat ichek beekab Ainet, che chang’ che kimen, noto ko laitoriatab Asuria koboto torornatennyi tugul: ak kotogosyi inendet ainosiekyik tugul, ak kosiir ngegusiekyik tugul: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kobokto kwo Juda; ak koyom kosiir oloto; nyiiei kot koit kaatit; ak konyiiei kaiitoetab kebebaikyik tebeesindab emeng’ung’, ee Imanuel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owaach, ee bororiosiechu, si kobiit ketonatonak; ak oeb it, ee okwek tugul che o bo emotinwek che looen: ogermenge, si ketonatonak; ogermenge anyun, si ketonatonak. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oruoch tugul, si koek buch; omwa ng’olyot, ama tononi: amu mi Kamuktaindet kobotech.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu king’alalwa Jehovah ko u noto eng’ eut ne kim, ak kotigona si mawendate ortinwekab bichu, kole, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
            "verseOrgIds": [
              "ISA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amomwa ole, Chaamset, agobo tugul che mwaei bichu kole, Chaamset; amoiywei kit ne iywei icheget, anan oarogen. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu Jehovah ne bo lugosiek inegei ne ogonyiti; ak ingoek inendet ne oiywei, ak koek inendet ne konok oiyweisie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak koek inendet ole tilil; ago egu koita ne inachi bich ak ruandet ne riichei bich eng’ gorik tuwai che bo Israel, koek mestet ak mestet age ne ter eng’ bik che menyei Jerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinachi che chang’ eng’ oloto, ak kobutyo, ak koilyo, ak kename mestet, ak kimut.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.15",
            "verseOrgIds": [
              "ISA.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.15",
            "verseOrgIds": [
              "ISA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rat anyun baornatet, ng’och ng’atutik eng’ kwenutab alamalyennyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
            "verseOrgIds": [
              "ISA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si agen Jehovah, ne unyei togennyi si mageer gotab Jakobo, ak amang’u inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.17",
            "verseOrgIds": [
              "ISA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeero, ane ak lagok che kigona Jehovah ko ki kaborunoik ak kwong’utik eng’ tugul, che bunu Jehovah ne bo lugosiek, ne menyei tulwetab Sion. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye mwawok kole, Ocheng’ate ichek che boisie oik ak bonik, che twegu ko u taritik ak che nyeanyei ng’alek: tos manyoljin bik kocheng’ Kamuktaindenywa? Tos nyoljin kocheng’at che kigobek agobo che soptos? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.19",
            "verseOrgIds": [
              "ISA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onamge ak ng’atutik ak baornatet! Ngot ko mang’alal ichek kosub ng’olyondonito, ko amu mami lapkeiyet eng’ ichek.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak tun siirtoe yoto, konyalildos ak koamei rubet: ak ye tun kaam rubet, konerekso, ak kosas laitoriandenywa ak Kamuktaindenywa, ak konyal barak: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.21",
            "verseOrgIds": [
              "ISA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kogeer ng’ony, ak ogeero, mi bichiindo ak mesundeito, mesundeito ne bo ndara; ak keonji ichek mesundeito ne o.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.22",
            "verseOrgIds": [
              "ISA.8.22"
            ]
          }
        }
      ]
    }
  ],
