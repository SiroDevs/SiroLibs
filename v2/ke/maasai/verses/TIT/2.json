            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " oishorua kewan te nkaraki iyiook, pee elaku iyiook aitung'uaa entorroni pooki neitisinyaki kewan iltung'ana lenyena. Lelo ooata enyuaata te nkaraki nkiasin sidain.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
    {
