              "items": [
                {
                  "text": "1 Ilai 18.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neaku eidipe ina siaai pooki apa nataasa Solomon tenkaraki enkaji o Laitoriani. Neyau Solomon aitijing'u nena tokitin apa naaitisinya Daudi papaai lenye, neshum ina osholai, o sahabu, o masaa pooki teneshumishoreki e nkaji e Nkai.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyauaki osanduku lo lning'o lo sotua atua enkaji e Nkai",
          "type": "text"
        }
      ]
    },
