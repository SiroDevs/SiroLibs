              "2CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa pee eipang'u ilapolosak teine wueji sinyati (amu ore apa lelo apolosak pooki ootii ine neitisinya ate, meshilaa ilturrurri lenye; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore lelo aranyak pooki le Lawi, o Asaf, o Heman, o Yedutum, o layiok lenye o lalashera lenye, neishop ilkilani sidain, neeta inkinantani dapashi, o nkai oo sinkolioitin, o lwululi loo usin, neitashe te nkalo o loo saen lo lperere lo lasar, tenebo ilapolosak iip nabo o tikitam ookut ntarumpetani.) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
