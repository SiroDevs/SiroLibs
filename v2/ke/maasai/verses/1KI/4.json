                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eiroro sii ndung'eta e rashe nkalifuni uni; ore isinkoliotin lenyena naa enkalifu nabo o imiet. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
