        },
        {
          "text": "Neisho Enkai Solomon engeno nagut o ening'unoto nemeimakinoyu, neiputaki engeno naba anaa osinyai le naiposha, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
