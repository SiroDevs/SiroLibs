                "loc": "2SA.20.1"
              },
              "items": [
                {
                  "text": "2 Sam 20.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore ake pee edol Isiraeli pooki aajo eitu ening olaiguanani ninche, newaliki olorere olaiguanani, aajoki,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.16",
            "verseOrgIds": [
              "1KI.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.17",
            "verseOrgIds": [
              "1KI.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki olaiguanani Rehoboam airriwaa Adoram, laa ninye apa olaitasheikinoni le siaai oo nkaik. Nenang iltung'ana pooki loo Siraeli ninye too soito ometua. Neisarisaraki olaiguanani Rehoboam aked engari enye oo mbartan, neisikaki Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.18",
            "verseOrgIds": [
              "1KI.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku etekepari apa Isiraeli aagilunore enkaji e Daudi ometabaiki ena olong.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.19",
            "verseOrgIds": [
              "1KI.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.19",
            "verseOrgIds": [
              "1KI.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee ening iltung'ana pooki loo siraeli nchere etorrinyunye Yeroboam, neirriwaa olkilikuai aaipotu ninye meeu eumata, neitaa ninye olaiguanani te shumata Isiraeli pooki. Meetae hoo obo otusujayie enkaji e Daudi, meteleku ake olosho le Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.20",
            "verseOrgIds": [
              "1KI.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enaibon e Shemaia",
          "type": "text"
        }
      ]
    },
