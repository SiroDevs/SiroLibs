          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
            "verseOrgIds": [
              "1KI.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Yeroboam ashet Shekem teina kop oo ldoinyo e Efraim, nelo abik teine, neitoki alo teine nelo ashet Penuel. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
            "verseOrgIds": [
              "1KI.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo Yeroboam to ltau lenye, “Kerrinyunye taata enkitoria alotu enkaji e Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
            "verseOrgIds": [
              "1KI.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "teneilep kulo tung'ana aapuo aaitayu ilasarri te nkaji e Nkai te Yerusalem. Neitoki iltauja le kulo tung'ana aaibelekenyakino olkitok lenye, Rehoboam olaiguanani le Yuda, naar ninche nanu matua nerrinyokino Rehoboam olaiguanani le Yuda.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        }
      ]
    },
