            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13+EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Ena 12.1-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore te nkolong e tomon oo nguan o lapa le dukuya, neibung lelo apa ootorrinyunye te yararoto pasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.19",
            "verseOrgIds": [
              "EZR.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu eitisinya apa ilapolosak o Lawi ate tenebo; etaa apa pooki ilemeiduruk. Neaku eteyiang'a ninche olkuoo lenye le pasaka tenkaraki lelo pooki ootorrinyunye te yararoto, te nkaraki lelo apolosak alashera lenye, o tenkaraki ninche maate, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.20",
            "verseOrgIds": [
              "EZR.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "einosa apa ina pasaka iltung'ana loo Siraeli ootorrinyunye te yararoto, o pooki ng'ae oibung'are ninche, neitalam kewan olduruk loo ltung'ana leina kop, neserem Olaitoriani, Enkai e Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.21",
            "verseOrgIds": [
              "EZR.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
