                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Saka 1.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore apa iloibonok le Nkai, Hagai o Sakaria olayioni le Ido, neibonoki Ilyahudi ootii Yuda o Yerusalem, te nkarna e Nkai e Israel natii shumata ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.12"
              },
              "items": [
                {
                  "text": "Hag 1.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.6+ZEC.4.7+ZEC.4.8+ZEC.4.9"
              },
              "items": [
                {
                  "text": "Saka 4.6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neitoki Serubabel olayioni le Shealtiel o Yeshua olayioni le Yehosadak aadumunye neiteru aashet enkaji e Nkai natii Yerusalem; ore tenebo ninche netii iloibonok le Nkai, eretito ninche.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore teina kata ake nelotu Tartenai, ilo balusui lo lkerenket otii teidia alo olkeju o Shetar-bosenai tenebo lelo le ncholuek enye neirorie aajoki nji, “Kaing'ae oishoo ntae enkitanapata nishetietie ena aji nindipidipi olchetei lenye?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.3",
            "verseOrgIds": [
              "EZR.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyaakita sii aaikilikuan ninche ena, “Kakua nkarn e kulo tung'ana ooshetita ena aji?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.4",
            "verseOrgIds": [
              "EZR.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etii apa enkong'u e Nkai enye shumata lelo payiani loo Lyahudi, neitu ninche eibooyo ninche ometabaiki ilo omoni Darias nerrinyuni ewalata naipirta ina te palai.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore entashati eina palai nairriwakita Tartanai, ilo balusui lo lpolosie otii teidia alo olkeju o Shotar-bosnai o lelo le ncholuek enye, lelo balusuni apa ootii olkerenket otii lido kekun olkeju, o Darias olaiguanani; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.6",
            "verseOrgIds": [
              "EZR.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "neirriwaki ninche ninye olomoni, oigerore kuna baa: “Enetii Darias olaiguanani, eseriani te pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.7",
            "verseOrgIds": [
              "EZR.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchoo metayiolouni to laiguanani nchere kishomo iyiook olkerenket le Yuda, enkaji e Nkai kitok. Eshetitae ninye too soito sapuki, netipikaki isunta enyena mbaoi, eloito ena siaai dukuya aponari easita nkaik enye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.8",
            "verseOrgIds": [
              "EZR.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikintoki iyiook aaikilikuan lelo payiani nikirorie iyiook ninche aajoki nji, ‘Kaing'ae oishoo intae enkitanapata pee ishetishete ena aji, nindipidipi olchetei lenye?’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.9",
            "verseOrgIds": [
              "EZR.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyaakita sii aaikilikuan ninche nkarn enye, pee itum atayiolo, nikitum aaigero nkarn e lelo tung'ana too lukuny enye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.10",
            "verseOrgIds": [
              "EZR.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ena apa ninche etawalikitia iyiook, ‘Kira iyiook isinkan le Nkai e keper o enkop, naa eikingil iyiook aashet ena aji apa nateshetaki too larin kumok ootulusoitie, apa natesheta olaiguanani le Israel kitok neidip. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.11",
            "verseOrgIds": [
              "EZR.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11+2KI.25.12"
              },
              "items": [
                {
                  "text": "2 Ilai 25.8-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20"
              },
              "items": [
                {
                  "text": "2 Int 36.17-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.12+JER.52.13+JER.52.14+JER.52.15"
              },
              "items": [
                {
                  "text": "Yer 52.12-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kake ore enkaraki apa naitagoro loo papa Enkai e keper, neishooyo ninye ninche apik enkaina e Nebukadnesa olaiguanani le Babilon, o Lkaldayo, laa ninche apa ooidaikie ena aji neya iltung'ana Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.2+EZR.1.3+EZR.1.4+EZR.1.5+EZR.1.6+EZR.1.7+EZR.1.8+EZR.1.9+EZR.1.10+EZR.1.11"
              },
              "items": [
                {
                  "text": "Esr 1.2-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore ake eyia neijia, to lari le dukuya le nkitoria e Sairos olaiguanani le Babilon, neitayu Sairos ilo aiguanani enkitanapata, nchere pee eitokini aashet ena aji e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nena masaa e sahabu o ne nkosholai e nkaji e Nkai, apa naaitayio Nebukadnesa teina aji e Nkai natii Yerusalem, neyau ina aji e nkai e Babilon, eyaua Sairos olaiguanani kuna aitupuku te nkaji e nkai e Babilon nepiki enkaina e obo oji enkarna Sheshbasa, laa ninye apa eitaa olbalusui; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.14",
            "verseOrgIds": [
              "EZR.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nejoki olaiguanani ninye, Iwa kuna masaa, shomo tipika ninche atua enkaji e Nkai natii Yerusalem, naa nchoo enkaji e Nkai eitokini aashet te wueji enye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.15",
            "verseOrgIds": [
              "EZR.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki alotu ilo oji Sheshbasa neshet olkitamanyunoto le nkaji e Nkai natii Yerusalem; ore ebaiki ina kata o taata etaa ina aji enateshete, neitu eidipayu.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.16",
            "verseOrgIds": [
              "EZR.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore enkaraki ina te nelioo aa sidai to laiguanani, nchoo ejurruni to lchumati loo mbaa musan o laiguanani teidie te Babilon, pee edoli tenaa keitayio apa Sairos olaiguanani enkitanapata nashetieki ina aji e Nkai natii Yerusalem. Naa nchoo olaiguanani eirriwaki iyiook enaitiship ninye tialo ena bae.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.17",
            "verseOrgIds": [
              "EZR.5.17"
            ]
          }
        }
      ]
    }
  ],
