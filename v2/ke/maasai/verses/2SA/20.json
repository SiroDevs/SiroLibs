                "loc": "2KI.10.16"
              },
              "items": [
                {
                  "text": "2 Ilai 10.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore apa, netumi oltung'ani lemeeta tipat, oji enkarna enye Sheba, olayioni le Bikiri, lo losho le Benchamen neosh ninye emowuo nejo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku etung'uaitie iltung'ana pooki loo Siraeli Daudi, nesuj Sheba olayioni le Bikiri; kake etusuja iltung'ana le Yuda olaiguanani lenye aakurraki ebaiki Yordan o metabaiki Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.22"
              },
              "items": [
                {
                  "text": "2 Sam 16.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nelotu Daudi enkaji enye te Yerusalem; neya olaiguanani nkapiak tomon apa naatung'uayie meing'ura enkaji, nepik ninche atua enkaji narripitoi, neitoti ninche, kake eitu elo atua enetii ninche. Neaku eikenoyioki ninche o metabaiki enkolong e keeya enye, etoni anaa nkolia.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki olaiguanani Amasa, “Mpoto iltung'ana le Yuda te nebo meetu enatii ti atua nkolong'i uni, nitii iyie ene makewan.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku eshomo Amasa aipot Yuda; kake eimutie ninye aitogiroo enkata apa natudung'okoki apa nategelakaki ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Daudi Abishai, “Ore taata keitaas iyiook Sheba olayioni le Bikiri entorrono alang Absalom; iwa isinkan lo lkitok lino tusujai ninye, meisho ake kewan nkanas naasheta isunta too soito nepik iyiook enyamali.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neipang aapuo aasujaa Abishai, Yoab o lelo Sheriti o lelo Peleti, o lelo tung'ana pooki magil; neipang ninche aapuo aaing'uaa Yerusalem aasujaa Sheba olayioni le Bikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore etii ninche osoit sapuk otii Gibeon, nelotu Amasa anang'are ninche. Neishopito apa Yoab olkila lo ltung'ani le njore, ore ti oriong ninye netii enkimeita te nebo olalem ti atua enchashur eteenaki aakurraki te mpolos enye; ore eloito ninye dukuya nedoyio. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Yoab Amasa, “Iserian iyie, olalashe lai?” Neibung Yoab Amasa olmunyei lenye te nkaina enye e tatene pee eng'utut ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eitu edol Amasa olalem otii enkaina e Yoab; neaku ninye etaremie Yoab ninye enkoshoke, nebuloki imonyit enyena enkop, neye ninye eitu eigilieki ai oshoto.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore Yoab o Abishai olalashe lenye nesujaa Sheba olayioni le Bikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore obo loo ltungana le Yoab, neitashe te mbata e Amasa nejo, “Ore olonyor Yoab anaa ole nkalo e Daudi, nchoo ninye esujaa Yoab.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore Amasa neirrag akurro tiaatua o sarge lenye te mpolos enkoitoi. Ore pooki ng'ae ogiroo, nedol ninye, neitashe; ore pee edol ilo tung'ani ajo eitasheito iltung'ana pooki, nenap ninye Amasa aitung'uaa enkoitoi apik ong'ata, nenang'aki enkila shumata ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee eyae aaitung'uaa enkoitoi, nepuo iltung'ana pooki aasuj Yoab esujaa olayioni le Bikiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neim Sheba atua iloshon pooki loo Isiraeli o meshomo Abel e Bet-maka, ore lelo Bikiri pooki neiturrurro, nesujaa ninye atua. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo tung'ana pooki apa ootii te nebo Yoab nepuonu aang'adu ninye ti atua Abel e Bet-maka; neitayu ninche olkiu te mbata e nkang, neitashe ninye aipirakinore esuntai; neoshito apa ninche esuntai pee euroo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neipotisho enkitok ang'eni ti atua enkanasa ejo, “Entoning! Entoning! Entiaaki Yoab, ‘Wou ene, pee aatum nanu airorie iyie.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelotu ninye ataaniki ninye; nejo ina kitok, “Ira iyie Yoab?” Newaliki ninye, “Ara nanu.” Neitoki ajoki ninye, “Toning'o irorei le sinka ino.” Newaliki ninye, “Aning'ito nanu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki ninye ajo, “Ore apa naa keji, ‘Nchoo ninche eikilikuanu enkoo te Abel’; neidip ninche olomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ara nanu nabo e nekua nemeetayie olomang'ati neisiligayu too Siraeli amaa ing'oru iyie aidaikie enkanasa naa ninye ng'otonye ti atua Israel; kainyoo pee iijoo iyie ina jung'ore o Laitoriani?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newal Yoab, “Kikoino maatalama ena nchere kaijoo nanu arashu aidaikie! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesipa ina. Kake oltung'ani le nkop oo ldoinyo e Efraim, oji Sheba olayioni le Bikiri, oilepie enkaina enye aarare olaiguanani Daudi; enchoru ninye ake, naa kalo nanu aing'uaa enkanasa.” Nejoki ina kitok Yoab, “Ng'ura, eikinang'akini iyie endukuya enye aaitadooki te suntai.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelo ina kitok enetii iltung'ana pooki te ng'eno enye. Nedung'u ninche endukuya e Sheba olayioni le Bikiri nenang'u auluo enetii Yoab. Neosh ninye emowuo, neidapasha ninche aaing'uaa enkanasa, oltung'ani ake nelo enkang enye. Nerrinyo Yoab alo Yerusalem enetii olaiguanani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilkituaak le njore le Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
