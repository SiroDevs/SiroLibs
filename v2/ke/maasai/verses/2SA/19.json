              "2SA.19.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.5+2SA.16.6+2SA.16.7+2SA.16.8+2SA.16.9+2SA.16.10+2SA.16.11+2SA.16.12+2SA.16.13"
              },
              "items": [
                {
                  "text": "2 Sam 16.5-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore Shimei olayioni le Gera, ilo lo losho le Benchamen, oing'uaa Bahurim, neisarisaru adou te nebo iltung'ana le Yuda pee enang'are olaiguanani Daudi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.16",
            "verseOrgIds": [
              "2SA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore te nebo ninye netii iltung'ana enkalifu ooing'uaa Benchamen. Ore Siba osinka le nkaji e Saul, te nebo ilayiok lenyena tomon o imiet, o sinkan lenyena tikitam, nekuet aadoyio aapuo Yordan dukuya olaiguanani, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.17",
            "verseOrgIds": [
              "2SA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelang ninche te lang'ata aariku enkaji o laiguanani, neas ninche ina nayieu ninye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.18",
            "verseOrgIds": [
              "2SA.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eing'urrie Daudi Shimei",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore Shimei olayioni le Gera nebatata te dukuya olaiguanani, etaa kejo ninye pee elang Yordan, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.18",
            "verseOrgIds": [
              "2SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nejoki olaiguanani, “Mincho olkitok lai aaibung nanu te ntorroni arashu edamu eneikuna osinka lino pee eas entorrono ina olong apa naing'uaa olkitok lai olaiguanani Yerusalem; mincho olaiguanani enap too ndamunot enyena. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.19",
            "verseOrgIds": [
              "2SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu eyiolo osinka lino nchere ataasa nanu eng'oki; metaa, ng'ura, aewuo nanu ena olong, ole dukuya te nkaji pooki e Yosef otadowuo alotu anang'are olkitok lai olaiguanani.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.20",
            "verseOrgIds": [
              "2SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaliki Abishai olayioni le Seruiya ajoki, “Aimeari Shimei metua tena, enkaraki netediaa ninye ilo otubukoko Olaitoriani eilata?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.21",
            "verseOrgIds": [
              "2SA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etejo Daudi, “Kaa nanu aaporoki intae, intae ilayiok le Seruiya, nchere itiuu intae ena olong anaa ilmang'ati te nanu? Keari pooki ng'ae metua te Israel ena olong? Amu aimayiolo nanu nchere ara nanu ena olong olaiguanani le Israel?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.22",
            "verseOrgIds": [
              "2SA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki olaiguanani Shimei, “Miye iyie.” Neisho olaiguanani ninye olmumai lenye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.23",
            "verseOrgIds": [
              "2SA.19.23"
            ]
          }
        }
      ]
    },
