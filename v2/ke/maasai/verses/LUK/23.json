  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "LUK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etorikoki Yesu enetii Pilato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedumunye olorora pooki, nerikokini Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.1",
            "verseOrgIds": [
              "LUK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiter aaitang'or ninye, ejo, “Kineputua ele tung'ani eiwushie olorere lang nemitiki iyiook kincho Kaisari kodi, nejo kewan Kristo naa olaiguanani.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.2",
            "verseOrgIds": [
              "LUK.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neikilikuan Pilato ninye ajoki, “Ai yie doi Olaiguanani lo Lyahudi?” Newaliki ajoki, “Iyie otejo neijia.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Pilato lapolosak kituaak o lorora, “Eitu atum entiyoto te le tung'ani.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.4",
            "verseOrgIds": [
              "LUK.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eitirrishakita ejo, “Keing'oling'ol olorere, eiteng'enita te Yudea pooki, ebaiki Galilaya o meeu ene.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etorikokoki Yesu Herode",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ening Pilato ina, neikilikuan te na kole Galilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.6",
            "verseOrgIds": [
              "LUK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ening ajo ole nkalo naitore Herode, neirriwaki Herode etii ninye Yerusalem ina kata. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.7",
            "verseOrgIds": [
              "LUK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee edol Herode Yesu, neshipa oleng, amu keyieu apa nedol te nkata naado, amu ketoning'o imbaa enyena, nejo sii pee edol neas embae e nking'asia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.8",
            "verseOrgIds": [
              "LUK.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkaraki ina neikilikuanishore te nkata naado; kake eitu ewaliki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.9",
            "verseOrgIds": [
              "LUK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitashoo lapolosak kituaak o lasirak aaitirrishaki aaitang'or ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.10",
            "verseOrgIds": [
              "LUK.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nesul Herode o sikarini lenyena, neikordod; neitoki neishopoki olkila nerrinyoki Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.11",
            "verseOrgIds": [
              "LUK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku lchoreta Herode o Pilato ade ina olong, amu ore eton eitu ebau ena, neeta apa ninche mang'atisho pokira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etudung'okoki Yesu enkiguana pee eari metua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Pilato aipot ilapolosak kituaak o laitoriak lo lorere ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.13",
            "verseOrgIds": [
              "LUK.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nejoki ninche, “Intae likitorikokito ele tung'ani anaa oloiwushie olorere; naiguanare te dukuya intae, ng'ura, eitu atumie ele tung'ani entiyoto hoo nabo te nitipika; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.14",
            "verseOrgIds": [
              "LUK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "eitu sii atumie Herode amu etorrinyoko iyiook. Ng'ura, eitu hoo eas ai nairirikino keeya; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.15",
            "verseOrgIds": [
              "LUK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "metaa kaitame naisho elo.” [",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.16",
            "verseOrgIds": [
              "LUK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemeeta kata ake nemelaaki Pilato ninche oltung'ani obo te ilo sirua.] ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.17",
            "verseOrgIds": [
              "LUK.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etabuakutua pooki te nebo ejo, “Iwuang'ie ele tung'ani, naa Barabas talaaki iyiook” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.18",
            "verseOrgIds": [
              "LUK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "oltung'ani taa otanang'akaki korokoroni, te nkaraki enkitarrikinoto natijing'a ina anasa, o te nkaraki natarishe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.19",
            "verseOrgIds": [
              "LUK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Pilato airorie, eyieu nelaku Yesu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.20",
            "verseOrgIds": [
              "LUK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake nebuaku ninche aajo, “Tasho ninye tasho!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.21",
            "verseOrgIds": [
              "LUK.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neigilie ene uni ajoki, “Ainyoo kaa torroni eitayio? Eitu atumie nanu ninye entiyoto nairirikino keeya; metaa kaitame nalak.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.22",
            "verseOrgIds": [
              "LUK.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eitirrishakita nekurraki to ltoilo sapuk ejo metashei. Neidimu oltoilo lenye ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.23",
            "verseOrgIds": [
              "LUK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedung'oki Pilato enkiguana meitaasi ina nayieu ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.24",
            "verseOrgIds": [
              "LUK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelaku ilo tung'ani otanang'akaki korokoroni te nkaraki enkitarrikinoto o te nkaraki natarishe, ilo oipotutuo, kake eishoyie Yesu meitaasi ina nayieu ninche.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etashoki Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore erikitoi, neibung'i oltung'ani obo oji Simon le Kirene, oewuo eing'uaa nkurman, neitanapa osalaba, metanapa esujita Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.26",
            "verseOrgIds": [
              "LUK.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.26",
            "verseOrgIds": [
              "LUK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nesuj olorora kitok le lelo tung'ana, o nkituaak naaishiraki eoshiosh ilgooitie. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.27",
            "verseOrgIds": [
              "LUK.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eibelekenye Yesu aing'or nejoki, “Na toyie e Yerusalem, emikinchiraki nanu, kake ate enchiraki o nkera inyi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.28",
            "verseOrgIds": [
              "LUK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu ng'ura, kepuonu nkolong'i naaku keji, ‘Emayiana nkolupeno, nemayiana nkoishuaa neitu eisho, nemayiana ilki leitu enaki!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.29",
            "verseOrgIds": [
              "LUK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.10.8"
              },
              "items": [
                {
                  "text": "Hos 10.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.16"
              },
              "items": [
                {
                  "text": "Emb 6.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neaku kejokini ldoinyo, ‘Entuurokinoto iyiook,’ nejokini ndoinyo, ‘Entoipoi iyiook.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.30",
            "verseOrgIds": [
              "LUK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu, pasa taa eikoni nji olchani onyori, kaji eikoni olotoyio?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.31",
            "verseOrgIds": [
              "LUK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.31",
            "verseOrgIds": [
              "LUK.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neriki sii kulikae wushuush aare, metari te nebo ninye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.32",
            "verseOrgIds": [
              "LUK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.32",
            "verseOrgIds": [
              "LUK.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ebaiki ewueji naji Emborbor, neshe ninye te ine, o lelo maisero, atii obo te tatene netii olikae te kedianye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.33",
            "verseOrgIds": [
              "LUK.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.18"
              },
              "items": [
                {
                  "text": "Olke 22.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nejo Yesu, “Papa, tapalaki ninche, amu ai meyiolo enaasita.” Neosh ninche enkukuo pee etum aatoor nkilani enyena. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.34",
            "verseOrgIds": [
              "LUK.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.7"
              },
              "items": [
                {
                  "text": "Olke 22.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neitashoo ltung'ana te ine, aaing'or; kake kesurdaany ilaitoriak, ejo, “Eitajeuo kulikae, nchoo naa eitajeu kewan te naa ai ninye doi Kristo le Nkai, ilo gelunoti lenye.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.35",
            "verseOrgIds": [
              "LUK.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Olke 69.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nesurdaany sii ninche isikarini, epuonu aayaki enaisho naisuijo ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.36",
            "verseOrgIds": [
              "LUK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ejo, “Te naa ira Olaiguanani loo Lyahudi, intajeu kewan!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.37",
            "verseOrgIds": [
              "LUK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etisiraki sii olkigeroto te shumata elukunya enye ojo, “Ele Olaiguanani loo Lyahudi.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemor obo le lelo wushuush ootashoki te nebo ninye, ejo, “Ai mira doi Kristo? Intajeu kewan o iyiook!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.39",
            "verseOrgIds": [
              "LUK.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neisikong olikae ajoki, “Ai miure iyie Enkai, nidol ajo ina kiguana kitudung'okoki sii iyie? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.40",
            "verseOrgIds": [
              "LUK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neishiaakino ninche iyiook; amu inikitaasa eitalakitae iyiook; kake meeta hoo ele entorrono nataasa.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.41",
            "verseOrgIds": [
              "LUK.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki, “Yesu, tadamuaki nanu te nilotu te ngolon ino e nkitoria.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.42",
            "verseOrgIds": [
              "LUK.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Yesu ninye, “Esipa aajoki iyie, ejing ade Paradiso te nebo nanu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etua Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku ina kata enaipirie enkolong, nerip enaimin enkop pooki o metabaiki saa naaudo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.44",
            "verseOrgIds": [
              "LUK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Ena 26.31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " neimis ewang'an e nkolong; nepolosa olkarasha orish enkaji e Nkai aaku are. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.45",
            "verseOrgIds": [
              "LUK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.31.5"
              },
              "items": [
                {
                  "text": "Olke 31.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore Yesu, nebuaku to ltoilo sapuk, nejo, “Papa, inkaik inono apik enkiyang'et ai!” Ore pee ejo neijia nedung'o tau. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee edol olkitok loo sikarini enatotiwuo, neisis Enkai, nejo, “Edede meeta hoo ele tung'ani entiyoto!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.47",
            "verseOrgIds": [
              "LUK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo orora pooki ooetuo enking'urare, pee edol enatotiwuo, nerrinyo nkang'itie enye eoshiosh ilgooitie eisina. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.48",
            "verseOrgIds": [
              "LUK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.2+LUK.8.3"
              },
              "items": [
                {
                  "text": "Lk 8.2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore ilooyiolore pooki o nkituaak naatusujutua eing'uaa Galilaya neitashe te nelakua aadol kuna baa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etunukayioki Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 23:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netii apa oltung'ani oji Yosef le nkang oo Lyahudi naji Arimatea. Naa obo ninye lo lkiama, naa oltung'ani supat asipani, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.50",
            "verseOrgIds": [
              "LUK.23.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 23:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "leitu enyorraa ninye ina nayieu o enataasa ninche, amu keanyita enkitoria e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.51",
            "verseOrgIds": [
              "LUK.23.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 23:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelo ilo tung'ani enetii Pilato aomonu osesen le Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.52",
            "verseOrgIds": [
              "LUK.23.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 23:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitadou neirin to lkarasha le kitani, neirragie te nkurare naguetuno to soit, neitu ai kata epiki likae. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.53",
            "verseOrgIds": [
              "LUK.23.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 23:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa enkolong e Nkitobirare, etaa keiteru sabato abau. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 23:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nesuj nkituaak naairiamunore Yesu eing'uaa Galilaya, nedol enkurare, nedol eneikunakaki; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.55",
            "verseOrgIds": [
              "LUK.23.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 23:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.10"
              },
              "items": [
                {
                  "text": "Ena 20.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.14"
              },
              "items": [
                {
                  "text": "Enkig 5.14",
                  "type": "text"
                }
              ]
            }
          ]
