              "items": [
                {
                  "text": "Mat 2.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore pee eidip aaitabai inaaitanapishoteki pooki, too nkitanapat o Laitoriani, nerrinyo aapuo Galilaya, enkang enye te Nasaret. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebulu ina kerai negolu, neiput eng'eno nagut, netii enkirotetisho e Nkai shumata ninye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshomo Yesu enkaji e Nkai aa enkayioni",
          "type": "text"
        }
      ]
    },
