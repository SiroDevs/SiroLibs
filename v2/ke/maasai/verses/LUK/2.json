              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedou Yesu airiamunore ninche nebau Nazaret, nening ninye ninche. Neshum ng'otonye nena baa pooki to ltau lenye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
