              },
              "items": [
                {
                  "text": "Mat 8.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ore te ine ninchirishiri nionyionyo lala, idolidolo Abraham o Isaak o Yakobo o loibonok le Nkai pooki etii enkitoria e Nkai nimanikiki ate etanang'ayioki ntae auluo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa kepuonu ltung'ana ooing'uaa enkilepunoto o endoyioroto, o looing'uaa kopikop o moikuape aatoni te mesa ti atua enkitoria e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
