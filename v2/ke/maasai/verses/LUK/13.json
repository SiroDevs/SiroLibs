                  "text": "Mk 10.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naa ng'ura, ketii ile siadi ooaku le dukuya, netii ile dukuya ooaku le siadi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
