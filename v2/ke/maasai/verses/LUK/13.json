              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te ina saa ake nepuonu embata oo Ilfarisayo, nejoki, “Inyo shomo te ne amu keyieu Herode nikiaar tua.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki ninye ninche, “Enchom entiaaki ilo barie, ‘Ng'ura, aaraa nanu loiriruani naishiunye iltamuoyia taata o taaisere o te nkolong e uni; naidip inkolati aainei. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore etiu neijia enkoitoi ai ake asuj taata o taaisere o idia olong; amu meidimayu metaa kenang oloiboni le Nkai dikae neme Yerusalem.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
              "LUK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ooi Yerusalem, Yerusalem naar iloibonok le Nkai ninang too soito lelo likirriwakini. Aikat aja pasa ejo aiturrur inkera inono te nebo anaa enkuku naiturrur inkuoo enyena ti abori inaipuko enyena nimiyieu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Olke 118.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ng'ura eitaa Enkai enkaji ino mijooni. Naajoki meekure kintoki ae kata adol o tejo, ‘Emayiana ilo olotu te nkarna o Laitoriani!’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.35",
            "verseOrgIds": [
              "LUK.13.35"
            ]
          }
        }
