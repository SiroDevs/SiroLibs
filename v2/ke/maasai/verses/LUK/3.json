              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore elimana ltung'ana eanyita enaaku, neitiko ltauja le pooki te nkaraki Yohana, emusumusu aajo ebaiki naa Kristo ninye, ana mme ninye, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "newaliki Yohana ninche pooki ajoki, “Esipa aibatisa nanu intae te nkare, kake kelotu ologol te nanu lemeishiaakino nalak enkeene e namuke enye. Ilo oibatisa intae te Nkiyang'et Sinyati o te nkima; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "neibung'ita ninye esilet enye te nkaina pee eor asip katukul olkurroto lenye oidong'ishoreki, nesotoki enkano empeche",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.17",
              "type": "text"
            },
            {
              "text": "empeche",
              "type": "text"
            },
            {
              "text": "enkaji napiki endaa, olkompe, sitoo",
              "type": "text"
            }
          ]
        },
        {
          "text": "; kake ore suut, nepej te nkima nemearayu ntarasi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
