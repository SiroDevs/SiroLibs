          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te kulie kumok nereiki aikok olorere eliki lomon supati. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.3+MAT.14.4"
              },
              "items": [
                {
                  "text": "Mat 14.3-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.17+MRK.6.18"
              },
              "items": [
                {
                  "text": "Mk 6.17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kake ore Herode ilo balusui pee eisikong ninye te nkaraki nayama Herodias enkitok o lalashe lenye, o sii te nkaraki kulie bususi naataasa Herode, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "neponiki ena nena pooki neikenoo Yohana te korokoroni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
    },
