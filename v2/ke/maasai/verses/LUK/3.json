          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eibatisaki iltung'ana pooki neidipaki aaibatisa sii ninye Yesu, eomonito Enkai nebolo shumata, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
