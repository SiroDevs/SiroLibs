              "items": [
                {
                  "text": "Yer 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ejoki ninche, “Etisiraki aajo, ‘Ore enkaji ai keaku ene nkomono;’ kake intaa intae enkapune oo laisimak.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.46",
            "verseOrgIds": [
