          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku ore esiana pooki oo ltung'ana le Israel, too nkajijik oo loo menye, ebaiki ilarin tikitam neilep, pooki ng'ae ooidim ashomo enjore te Israel ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
