              "type": "text"
            }
          ]
        },
        {
          "text": "Kulo apa lelo laa ninche eikenaki, laa ninche eikena Musa o Aron te retoto oo lpayiani le Israel, iltung'ana tomon o are, ore ake oltung'ani netii te rishata e nkaji e papaai lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.44",
            "verseOrgIds": [
