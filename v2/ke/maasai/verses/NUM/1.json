          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too ltung'ana le Gad, iishoritin enye, too lmareita lenye, too nkajijik oo loo menye, te risioroto e siana oo nkarn ebaiki ilarin tikitam neilep, lelo pooki ooidim aashom enjore: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nera esiana o losho le Gad nkalifuni artam o imiet o iip ile o onom.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.25",
            "verseOrgIds": [
              "NUM.1.25"
            ]
          }
        }
      ]
    },
