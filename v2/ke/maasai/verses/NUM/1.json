              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eitu apa eikenari ile Lawi aaitusuj iloshon loo loomenye te nebo ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
            ]
          }
        },
