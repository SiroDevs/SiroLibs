          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too ltung'ana le Yuda, iishoritin enye, too lmareita lenye, too nkajijik oo loo menye, te risioroto e siana oo nkarn, ebaiki ilarin tikitam neilep ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.26",
            "verseOrgIds": [
              "NUM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nera esiana o losho le Yuda nkalifuni ntomoni naapishana oo ong'uan o iip ile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.27",
            "verseOrgIds": [
              "NUM.1.27"
            ]
          }
        }
      ]
