              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa lelo tung'ana ooshomo te nebo ninye nejo, “Mikindim iyiook aashom aairisha ilo orere; amu kegol ninche aalang iyiook.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.31",
            "verseOrgIds": [
