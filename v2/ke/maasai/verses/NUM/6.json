              "NUM.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.23+ACT.21.24"
              },
              "items": [
                {
                  "text": "Iat 21.23-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Naa ena enkitanapata e ilo lo lmumai, te nelulung'ayu enkata enye e nkiteng'elata: neyauni ninye kutuk aji e ilo ng'obor le ntumo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitarasaki ninye enkishoroto enye Olaitoriani, olkuo obo le ker sitima lemeeta entioto te nkaraki olasar opejori, o esupen nabo e ker o lari obo nemeeta entioto naaku olasar loo ngok, o lmeregesh obo lemeeta entioto oaku olasar le seriani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "o enkikapu oo mukateni neitu eisuijieki, o mukateni e ntapa napuyiapui naipurjaki te ilata, o mukateni naapejo naaelieki eilata, o lasar lenye le ntapa o lasar lenye ooki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitarasaa olapolosani ninche te dukuya Olaitoriani, neitayu olasar lenye le ngoki o lasar lenye opejori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitayu ninye olmeregesh metaa olasar le seriani to Laitoriani, tenebo enkikapu oo mukateni neitu eisuijieki, neyau sii olapolosani olasar le ntapa o lasar ooki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo lo lmumai nebarn ina dukuya enye naitisinyaki te kutuk aji e ilo ng'obor le ntumo, neya ninye lelo papit le ndukuya enye naitisinyaki nelo apik enkima ti abori ilo asar le seriani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitayu olapolosani orony le ilo meregesh eidipaki aaitokitokie, neitayu emukate nabo neitu eisuishieki ti atua enkikapu o emukate nabo napejo neitu eisuishieki nepik ninche aiteleiki nkaik e ilo lo lmumai. Ore ake pee eidip ninye atabarnoi ilpapit le nkitisinyata enye, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyuk olapolosani ninche metaa olasar oyuki te dukuya Olaitoriani, neaku kuna daiki erubata nasinya to lapolosani te nebo oloikulu oyoki o ina muro naishoruaki; ore te siadi ina neidim ilo lo lmumai atooko enaisho oo sabibu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ena ninye enkitanapata eilo oinos olmumai. Ore olasar lenye oishori Olaitoriani neitorisiokini olmumai lenye anaa oloinos olmumai te nebo pooki toki ake ninye naba anaa enaata ninye te risioroto e ilo mumai oinos ninye, neiko ninye nejia te risioroto e nkitanapata e nkiteng'elata enye olmumai eitisinyaki kewan Olaitoriani.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emayianata oo lapolosak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
