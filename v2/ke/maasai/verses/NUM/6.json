            "sid": "NUM 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Olaitoriani ajoki Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.1",
            "verseOrgIds": [
              "NUM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiaki iltung'ana le Israel, te nelo nenya oltung'ani olmumai, olee aashu enkitok, te dukuya Olaitoriani, pee eaku osinyati to Laitoriani, neiteng'elaki kewan o Laitoriani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.15"
              },
              "items": [
                {
                  "text": "Lk 1.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nchoo eiteng'el kewan te naisho oo sabibu o te naisho napi, meok ninye ae toki naironyuaki too sabibu aashu enaisho napi; nemeinos isabibu ooshal aashu ilootoito. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nena nkolong'i pooki e nkiteng'elata enye nemeinos ninye ae toki naitobiruaki too sabibu o metabaiki ninye ilanterera lenyena aashu nkabobok enyena.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore nkolong'i pooki e ilo mumai lenye le nkiteng'elata meiseyie olmurunya endukuya enye; o metaba anaa neishunye ina kata apa naiteng'elaka ninye kewan Olaitoriani. Keaku ninye sinyati; keisho ninye iyenat oo lpapit lenyena metoodorito.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore te nena olong'i pooki naaiteng'elaki ninye kewan Olaitoriani nemenyikaki olmeneng'ani",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.6",
              "type": "text"
            },
            {
              "text": "olmeneng'ani",
              "type": "text"
            },
            {
              "text": "oltung'ani otua",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa olayioni le menye aashu olayioni le ng'otonye, aashu olo lalashe aashu enkanashe, te neye ninche. Kepik ninye kewan eleyiata; enkaraki natii enkiteng'elata naiteng'elaka kewan Olaitoriani shumata endukuya enye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.7",
            "verseOrgIds": [
              "NUM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too nkolong'i pooki naaiteng'elaka ninye kewan Olaitoriani naa kesinya ninye to Laitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naa te neye oltung'ani nabo kata etashare ninye, nepik eleyiata ina dukuya enye naiteng'elakaki Olaitoriani, nelo ninye abarn endukuya enye te nkolong e nkitukuo; te nkolong e naapishana elo ninye abarn. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkolong e isiet, neyau ninye nturkuluoni are aashu ntaritik are ayaki olapolosani te kutuk aji e ilo ng'obor le ntumo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nepolos olapolosani nabo te nkaraki olasar loo ngok, nepolos enkae te nkaraki olasar opejori, neitobir olning'o lo sotua te nkaraki ninye, enkaraki nataasa ninye engoki aiseyie ilo meneng'ani. Neitisiny ninye endukuya enye ina olong ake, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitengelaki kewan Olaitoriani too nkolong'i enyena e nkiteng'elata, neyau olkuo le ker sitima lo lari obo te nkaraki olasar le nkitarruoroto; kake ore enaduoo kata e dukuya neaku pesho, amu ore enkiteng'elata enye neidurukieki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
