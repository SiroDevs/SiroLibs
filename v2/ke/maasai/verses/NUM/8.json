                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.37.17+EXO.37.18+EXO.37.19+EXO.37.20+EXO.37.21+EXO.37.22+EXO.37.23+EXO.37.24"
              },
              "items": [
                {
                  "text": "37.17-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neitoki apa Olaitoriani ajoki Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.1",
            "verseOrgIds": [
              "NUM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiaki Aron, ti nindip atipika iltaai nkitasheta, ore lelo taai oopishana neitawang'isho te dukuya ina kitashet oo ltaai.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiko neijia Aron; nepik ninye iltaai lenyena meitawang'a dukuya ina kitashet oo ltaai, anaa enaitanapa Olaitoriani Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ena apa enkitobirunoto e ilo iket lo ltaa, naa sahabu naidongoki ebaiki entonata enye o metabaiki ntapuka enyena esiaai e nkidong'ore, te risioroto e ilo rrekie otuutaka Olaitoriani Musa. Neaku eitobirua ninye ilo iket.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esilata o enkitisinyata oo le Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Olaitoriani ajoki Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.5",
            "verseOrgIds": [
              "NUM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Toriko ile Lawi intung'uai iltung'ana le Israel, nintuku ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.6",
            "verseOrgIds": [
              "NUM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa neijia nkuna ninche, ntukuo ninche, isuaaki ninche enkare enkitisinyata, nebarn ninche iseseni lenye, neituku nkilani enye, neitisiny ate. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.7",
            "verseOrgIds": [
              "NUM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchoo ninche eya oloti oing'oni o lasar lenye le ntapa napuyiapui naipurjaki te ilata, nintoki aya likae oti oing'oni oaku olasar le ngoki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.8",
            "verseOrgIds": [
              "NUM.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyau iyie lelo le Lawi meetu dukuya ilo ng'obor le ntumo, ninturrur ina umata pooki oo ltung'ana le Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.9",
            "verseOrgIds": [
              "NUM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee iyau lelo le Lawi dukuya Olaitoriani, ore iltung'ana le Israel, neiteleiki nkaik enye lelo le Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.10",
            "verseOrgIds": [
              "NUM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neishooyo Aron ile Lawi te dukuya Olaitoriani pee eaku olasar oyuki oing'uaa iltung'ana le Israel pee eaku enenye enkisiaayiare o Laitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.11",
            "verseOrgIds": [
              "NUM.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki lelo Lawi aaiteleiki nkaik enye ilukuny e lelo oing'ok; nipolos iyie obo pee eaku olasar le ngoki ore olikae neaku olasar opejori oishori Olaitoriani, pee eitobir osotua lo lning lo Laitoriani too le Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchoo iyie ile Lawi meetu abori Aron o layiok lenyena, pee eishooyo ninche anaa olasar oyuki to Laitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Neijia nkuna nteng'ela ile Lawi ntung'uai atua iltung'ana le Israel, neaku ile Lawi ilaainei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.14",
            "verseOrgIds": [
              "NUM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te siadi ine nepuo ile Lawi atua aaisiaisho ti atua ilo ng'obor le ntumo, te nindip iyie aitukuo ninche ninchooyo ninche anaa olasar oyuki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.15",
            "verseOrgIds": [
              "NUM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu aaishooki nanu ninche tukul iltung'ana le Israel; te rishata oo lkikaunot pooki le Israel, ore ilkikaunot pooki loo ltung'ana le Israel aawa nanu makewan ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.16",
            "verseOrgIds": [
              "NUM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Ena 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu ore ilkikaunot pooki loo ltung'ana le Israel naa laainei, o lo ltung'ani o le ng'ues; ore apa teina olong nataara nanu metuata ilkikaunot pooki te nkop e Misiri aitisinyaka nanu ninche kewan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.17",
            "verseOrgIds": [
              "NUM.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "naawa nanu ile Lawi te rishata oo lkikaunot pooki ti atua iltung'ana le Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.18",
            "verseOrgIds": [
              "NUM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naishooyie nanu ile Lawi anaa enkishoroto aisho Aron o layiok lenyena, aitung'uaa iltung'ana le Israel, pee eas enkisiaayiare te nkaraki iltung'ana le Israel ti atua ilo ng'obor le ntumo, neitobir osotua lo lningo te nkaraki iltung'ana le Israel, pee mejing ake olmeitai",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.19",
              "type": "text"
            },
            {
              "text": "Olmeitai:",
              "type": "text"
            },
            {
              "text": "mutai - enkeeya torrono namutisho olkiye.",
              "type": "text"
            }
          ]
        },
        {
          "text": " atua iltung'ana le Israel te nelo nenyikaki iltung'ana le Israel enkaji e Nkai.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina apa eitaasa Musa o Aron o lturrur pooki loo ltung'ana le Israel ile Lawi; ore te risioroto e ina pooki naitanapa Olaitoriani Musa too naaipirta ile Lawi neitaas ninche iltung'ana le Israel ina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.20",
            "verseOrgIds": [
              "NUM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitisiny ile Lawi ate aalam ingok, neituku nkilani enye; neishooyo Aron ninche anaa olasar oyuki te dukuya Olaitoriani, neitobir Aron osotua lo lningo te nkaraki ninche eituku ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te siadi ina nepuo ile Lawi atua aas enkisiaayiare enye ti atua ilo ng'obor le ntumo, aasisho ti abori Aron o layiok lenyena. Ore anaa enaitanapa Olaitoriani Musa too naaipirta ile Lawi ina ninye eitaasa ninche.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Olaitoriani ajoki Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.23",
            "verseOrgIds": [
              "NUM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuna baa naaishiakino too le Lawi: ore ebaiki ilarin tikitam o imiet neilep kepuo ninche aas enkisiaayiare ti atua ilo ng'obor le ntumo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.24",
            "verseOrgIds": [
              "NUM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa ore ebaiki ilarin onom neing'uaa ninche enkisiaayiare nemeitoki aaisiaaisho, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.25",
            "verseOrgIds": [
              "NUM.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
