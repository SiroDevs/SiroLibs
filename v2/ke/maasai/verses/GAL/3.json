          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu te nkirukoto irara nkera e Enkai ti atua Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
              "GAL.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GAL 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore intae lelo pooki ooibatisaki aapik atua Kristo ninchopo Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
            "verseOrgIds": [
              "GAL.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GAL 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meitokini aata Olyahudi anaa Olyunani, orrindik arashu ololakuno, olee arashu eng'oruoi; irara pooki nabo ti atua Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
            ]
          }
        },
