              "items": [
                {
                  "text": "Iat 9.3-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.6+ACT.22.7+ACT.22.8+ACT.22.9+ACT.22.10"
              },
              "items": [
                {
                  "text": "22.6-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.13+ACT.26.14+ACT.26.15+ACT.26.16+ACT.26.17+ACT.26.18"
              },
              "items": [
                {
                  "text": "26.13-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kake Enkai naategelua apa eton maino naaipot aimunye empiris enye. Neaku ore pee edutaa ninye ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ajo kaaboloki ilo Inoti lenye peyie atum atolikioi Lomon Supati ti atua Loreren, eitu aikilikuanishore likae tung'ani loo nkiri o sarge. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keitu doi ninye alo Yerusalem enetii lelo apa oora lkipaareta eitu aaku nanu. A'a, Arabia atang'asa alo naitoki ashukunye alotu Dameski.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        }
      ]
    },
    {
