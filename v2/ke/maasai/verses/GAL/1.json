        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo olkipaaret leme ltung'ana ooitaa neme ltung'ana eimua, kake Yesu Kristo eimua o Enkai Papa, oitopiwuo ninye aitung'uaa ilootuata ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.1",
            "verseOrgIds": [
              "GAL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "o kulo alashera ootii te nebo nanu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.2",
            "verseOrgIds": [
              "GAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirito e Galatia aigeroki: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.2",
            "verseOrgIds": [
              "GAL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meeu empiris o eseriani atua intae eing'uaa Enkai Papa o Laitoriani lang Yesu Kristo ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.3",
            "verseOrgIds": [
              "GAL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilo oishorua kewan te nkaraki ng'ok ang pee esaru iyiook te na towuo arruoni te risioroto eyieunuto e Enkai ang naa Papa; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.4",
            "verseOrgIds": [
              "GAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa enenye enkitoo ntarasi o ntarasi. Esai.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ororei supat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aing'asia nanu eji intae lelo oosioki aaing'uaa Ilo oipoto intae te mpiris e Kristo aaibelekenyakino kulikae omon oopaashari ooji supati. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.6",
            "verseOrgIds": [
              "GAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meetae kulikae omon supati. Iltung'ana ooetuo aaliman intae eyieu neitapong'oo Lomon Supati le Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.7",
            "verseOrgIds": [
              "GAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake te naa doi napaji eiyiook aashu olmalaika ooing'uaa shumata oopuonu aaliki intae kulikae “omon supati” leme lapa likitolikitio intae, nchoo ilo metaa kediaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.8",
            "verseOrgIds": [
              "GAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kindipa apa aatejo naa kaitoki ake nanu ajo, te naa keetae oltung'ani olikioo kulikae “omon supati” leme lapa litang'amutua, nchoo ilo metaa kediaa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketiu pasa ena anaa kenkisisa oo ltung'ana aing'oru ana kene Nkai? Katiu pasa anaa eiltung'ana ayieu naitiship? Te naa ltung'ana napaji ayieu naitiship, nemaitoki aaku olaisiaayiani le Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eneikuna Paulo pee eaku olkipaaret",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu, lalashera laainei ayieu niyiolouwu, nchere, ore lelo Omon Supati latolikio intae mme oltung'ani otang'asua. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.11",
            "verseOrgIds": [
              "GAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitu ang'amu te likae tung'ani, neitu aautaki likae tung'ani. Yesu Kristo laataboloko makewan.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
            "verseOrgIds": [
              "GAL.1.12"
            ]
          }
        }
      ]
    },
