                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore to lari li okuni le nkitoria e Yohoiakim olaiguanani le Yuda, nelotu Nebukadnesa olaiguanani le Babilon, Yerusalem nemuat ninye near. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.17+2CH.20.18"
              },
              "items": [
                {
                  "text": "2 Int 20.17-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.10+2CH.24.11+2CH.24.12+2CH.24.13+2CH.24.14+2CH.24.15+2CH.24.16"
              },
              "items": [
                {
                  "text": "24.10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Int 36.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.39.7+ISA.39.8"
              },
              "items": [
                {
                  "text": "Isa 39.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neishooyo Olaitoriani Yohoiakim olaiguanani le Yuda apik atua inkaik enyena, te nebo embata oo masaa e nkaji e Nkai, neyau ninye ninche enkop e Shinari atua enkaji e Nkai enye, nepik nena masaa e wueji neshumieki ntokitin e tipat e nkai enye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki olaiguanani aitanap Ashpenas, ilo aitasheikinoni lenye kitok sunash ogelema, pee eyau embata oo ltung'ana le Israel, lelo le nkaji e nkitoo o lelo kituaak, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilbarnot lemeeta leyiat, shaati",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.4",
              "type": "text"
            },
            {
              "text": "shaati",
              "type": "text"
            },
            {
              "text": "supati aashu sidain",
              "type": "text"
            }
          ]
        },
        {
          "text": " naa arriyiak te ng'eno pooki nagut, ooishoro eyiolounoto, o enkibung'ata e nkiteng'enata, oodupa te nkisiayiare e nkaji o laiguanani, pee eiteng'eni ninche isirat o enkutuk oo Lkaldayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedung'oki olaiguanani ninche erubata e anaa ake e ndaa sidai naa ninye apa einos olaiguanani, o ene naisho oo sabibu naa ninye eok. Naa kepuoi apa aaiteng'en ninche ilarin okuni, ore te siadi ina kata nepuo ninche aaitashe te dukuya olaiguanani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te kulo naa Daniel, o Hanania, o Mishael, o Asaria lo losho le Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo kitok loo laitasheikinok loo sunaishi oogelema nedung'oki ninche nkarn: nejo Daniel Belteshasa, ore Hanania nejo Shadrak, ore Mishael nejo Meshak, ore Asaria nejo Abednego.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etumuta Daniel nchere meyieu neisarkionie kewan te ndaa o laiguanani aashu te ina aisho oo sabibu apa naok ninye; neaku eikilikuana apa ninye ilo kitok loo laitasheikinok loo sunaishi oogelema pee enyorraa ninye, pee meisarkionie kewan. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neisho Olaitoriani Daniel omom o lng'ur too nkonyek e ilo kitok loo laitasheikinok loo sunaishi oogelema; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nejoki ilo kitok loo laitasheikinok sunash ogelema Daniel, “Kaureisho nanu, medol ake olkitok lai olaiguanani, laa ninye likitegelaka endaa ino o entoki niok, ajo ira menati alang lelo barnot lerisiori ino. Neaku ipik iyie enkishui ai batisho ti alo olaiguanani.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Daniel ajoki ilo aitasheikinoni laa ninye apa etegelua ilo kitok loo laitasheikinok sunash ogelema meing'ura Daniel, o Hanania, o Mishael o Asaria; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tujurro isinkan linono too nkolong'i tomon; nchoo eishori iyiook mbenek mainosa o enkare nikiok. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitum taa aing'ura empukunoto ang o ene lelo barnot ooinos endaa sidai o laiguanani, naa ore te risioroto e mbae naba anaa enidol neijia ntaasa isinkan linono.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku etoning'o apa ninye ninche tena bae, nejur ninche nkolong'i tomon. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te siadi nkolong'i tomon nedoli aajo ninche oopir naa biot aalang lelo barnot pooki ooinos endaa sidai o laiguanani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku eiwuang'ie ilo aitasheikinoni ina daa enye sidai o ina aisho oo sabibu apa naji pee eok ninche, neisho ninche mbenek.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore kulo barnot pokira oong'uan, neisho Enkai ninche enkiteng'enata o enkarriyiano too sirat pooki o te ng'eno; neeta apa Daniel eyiolounoto too nduaat pooki o te ng'eno nagut. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te siadi ina kata, eidipa olaiguanani aitanapisho nchere meitijing'uni ninche atua aji, neyau ilo kitok loo laitasheikinok sunaishi oogelema ninche atua aji dukuya Nebukadnesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.18",
            "verseOrgIds": [
              "DAN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirorie olaiguanani ninche, ore te ninche pooki meetae hoo obo onotoki onyaanyukie Daniel, o Hanania, o Mishael o Asaria; neaku eitasheito ninche te dukuya olaiguanani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.19",
            "verseOrgIds": [
              "DAN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ore te pooki bae e ng'eno o eyiolounoto naipirta enaikilikuana olaiguanani ninche, nedol ajo kelang ninche katitin tomon ilkuyantik pooki o lasakutok ootii atua enkitoria enye pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.20",
            "verseOrgIds": [
              "DAN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neton Daniel o metabau olari le dukuya lo laiguanani Sairos.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.21",
            "verseOrgIds": [
              "DAN.1.21"
            ]
          }
        }
      ]
    }
  ],
