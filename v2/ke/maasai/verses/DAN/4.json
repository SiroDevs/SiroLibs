            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Metaa naa laaiguanani nchoo enkikoo ai eng'amaroyu te iyie; nturrai ing'ok inono te asata e sipata, o ntorrok inono te nkitodolunoto o lng'ur too looitorogonyaki, pee ebaiki neponari nkolong'iinono e seriani.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeuo ena pooki shumata olaiguanani Nebukadnesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te siadi ilapaitin tomon o are neloito ninye te nchumata e nkaji e nkitoo e Babilon, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nejo olaiguanani, “Aimekitok ena Babilon natesheta nanu te ngolon ai kitok metaa enkaji e nkitoo nairragie o te nkitoo e nkitoria ai.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eton epuku kulo rorei te nkutuk o laiguanani, nedou oltoilo oing'uaa shumata, “Olaiguanani Nebukadnesa, kirorieki iyie: Kishomo enkitoria aing'uaa iyie, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa aikiarari iyie aaitung'uaa iltung'ana, ore emanyisho ino naa keaku te nebo ing'uesi e ntim; naa keaku inos iyie nkujit anaa olkiteng; naa eikigiroo iyie ilarin naapishana, o metaba anaa niyiolou nchere ilo otii shumata aisul oitore enkitoo etung'ana, neisho ninye ilo oyieu.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ina kata ake neitabari ilo rorei to laiguanani Nebukadnesa. Nearari ninye aaitung'uaa iltung'ana, neinos nkujit anaa olkiteng, neshalu osesen lenye, te nkoileelio e shumata o metubulu ilpapit lenyena te nkadoro anaa nkopir o lkurragos, netiu iloisotok lenyena anaa loo lmotonyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eisisa Nebukadnesa Enkai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te siadi nena olong'i, nashumu nanu Nebukadnesa nkonyek aainei aing'or shumata, naarrinyokino nanu ndamunot aainei, naisis nanu ilo otii shumata aisul, naisis nayanyitu ilo oishu ntarasi;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te ina kata ake naarrinyokino nanu endamunoto ai; ore te nkaraki enkitoo e nkitoria ai naarrinyokini enkisisa o enkishiaa. Naaing'oru ilaikook o lkituaak laainei, naapiki nanu atua enkitoria ai, naaponikini nanu enkitoo sapuk. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nanu Nebukadnesa naisis naserem nayanyitu ilo Aiguanani le shumata; amu ore isiaaitin enyena pooki naa neitoriori. Ore nkoitoi enyena nesipa. Naa ore lelo oopuo to lwuasa eidim ninye aitadou.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.37"
            ]
          }
        }
      ]
    }
