              "items": [
                {
                  "text": "Emb 22.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kake ore lelo sinyat le ilo Otii Shumata Aisul naa keng'amu enkitoria, neaku enkitoria enenye ntarasi, o ntarasi o ntarasi.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        }
