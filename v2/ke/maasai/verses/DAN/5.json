          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Neaku te ine netii ninye eirriwuaki ina aina, nesiri ele kigeroto. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
            "verseOrgIds": [
              "DAN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ele kigeroto otisiraki: MENE, MENE, TEKEL, o PARSIN. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena enkibalakinoto ena bae: MENE, eikena Enkai nkolong'i e nkitoria ino neyau ninye enkiting'oto; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "TEKEL, kineneng'aki iyie te ntemet naineneng'ishoreki nedoli aajo ing'or. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.27",
            "verseOrgIds": [
              "DAN.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "PERES, etooroki enkitoria ino neishori ile Mede o le Parsia.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.28",
            "verseOrgIds": [
              "DAN.5.28"
            ]
          }
        }
