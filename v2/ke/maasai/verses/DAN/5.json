              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ina kewarie ake neari Belshasa ilo aiguanani loo Lkaldayo metua. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
