        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Osirua le Belshasa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitobir apa olaiguanani Belshasa osirua kitok te nkaraki ilkituaak lenyena enkalifu nabo, neok ninye enaisho oo sabibu te dukuya lelo enkalifu nabo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.1",
            "verseOrgIds": [
              "DAN.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.1",
            "verseOrgIds": [
              "DAN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee eishamisham Belshasa enaisho, neitanapisho nchere ore nena masaa e sahabu o nenkosholai apa naaitayio Nebukadnesa papaai lenye ti atua enkaji e Nkai te Yerusalem meyauni, pee etum olaiguanani o lkituaak lenyena o nkituaak enyena o nkapiak",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.2",
            "verseOrgIds": [
              "DAN.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.2",
              "type": "text"
            },
            {
              "text": "nkapiak",
              "type": "text"
            },
            {
              "text": "enkitok naboitare olee kake meyama naa enkaji enye etii te nkaraki enkisiaayiare",
              "type": "text"
            }
          ]
        },
        {
          "text": " enyena aatookishore ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.2",
            "verseOrgIds": [
              "DAN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyau ninche nena masaa e sahabu o nenkosholai apa naaitayioki ti atua enkaji e Nkai, te ina aji e Nkai te Yerusalem. Neokishore olaiguanani ninche, o lkituaak lenyena, o nkituaak enyena o nkapiak enyena. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.3",
            "verseOrgIds": [
              "DAN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neok ninche enaisho oo sabibu, nerrep nkaitin nena aitin e sahabu, o nenkosholai, o nosuyai, o nesekenkei, o enosoit.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nabo kata neliooyu ilkimojik le nkaina e tung'ani neiger enturoto naelare esuntai e nkaji o laiguanani enkipirakinoto oiket lo ltaa; nedol olaiguanani ina aina eigerisho. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.5",
            "verseOrgIds": [
              "DAN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neibelekenya emua o laiguanani, neitanyamal ninye ndamunot enyena, nelepori irubat osesen lenye neikirikira nkung aaosho. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.6",
            "verseOrgIds": [
              "DAN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyietu olaiguanani abuaku pee eyakini iloibonok, o Lkaldayo o laduaak. Nejoki olaiguanani lelo tung'ana ang'eni le Babilon, “Ore oloba anaa oloisoma ele sirata nelimu enajo ninye, naaitodol nanu enkibalakinoto enye neishopokini olkila sintet nepiki olpisiai le sahabu aaitaman emurt enye, nelo ninye aaku oloitoreisho liokuni te nkitoria.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.7",
            "verseOrgIds": [
              "DAN.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.7",
            "verseOrgIds": [
              "DAN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejing'u lelo ang'eni pooki lo laiguanani, kake meidim ninche aaisoma ilo sirata aashu eitayiolo olaiguanani enkibalakinoto. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.8",
            "verseOrgIds": [
              "DAN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyamalu oleng ilo aiguanani Belshasa neibelekenya emua enye, neiputukuny lelo kituaak lenyena.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.9",
            "verseOrgIds": [
              "DAN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.9",
            "verseOrgIds": [
              "DAN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkitok o laiguanani, te nkaraki irorei lo laiguanani o lelo kituaak lenyena, nelotu olgilata oitoomonishoreki, nejo ina kitok olaiguanani, “La aiguanani, tobiko ntarasi! Mincho ndamunotinono kintanyamal aashu emua ino eibelekenya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.10",
            "verseOrgIds": [
              "DAN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etii atua enkitoria ino oltung'ani otii atua ninye enkiyang'et oo nkaitin sinyat. Ore apa too nkolong'i e papaai lino, nenotoki ti atua ninye ewang'an, o eyiolounoto o eng'eno natiu anaa eng'eno oo nkaitin, ore apa olaiguanani Nebukadnesa, papaai lino, neitaa ninye olkitok loo lkuyantik, oloo ntalengo, Ilkaldayo o laing'urak loo lakir, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.11",
            "verseOrgIds": [
              "DAN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "enkaraki naa ore oltau sidai, o eng'eno, o ening'unoto nalimunye enkibalakinoto oo nkidetidetat oo iloyiotiaa neiwuang'ie inyamalitin nenotoki tele tung'ani oji Daniel, apa oishoo olaiguanani enkarna ajo Belteshasa. Nchoo naa Daniel eipotuni pee eitodolu ninye enkibalakinoto ele sirata.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etolimuo Daniel enautu ilo kigeroto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitijing'uni Daniel meeu dukuya olaiguanani. Nejoki olaiguanani Daniel, “Ira iyie lido Daniel, apa ora obo loo yarunot le Yuda, apa oyaua olaiguanani papa lai te Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.13",
            "verseOrgIds": [
              "DAN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atoning'o ilomon linono nchere etii enkiyang'et oo nkaitin sinyat atua iyie nenotoki sii ewang'an, o eyiolounoto o eng'eno nagut ti atua iyie. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.14",
            "verseOrgIds": [
              "DAN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etorikuoki taata ilang'eni o loo ntalengo meetu dukuya nanu pee eisom ele kigeroto naaitayiolo nanu enkibalakinoto enye; kake meidim ninche aaitodolu enkibalakinoto ena bae. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.15",
            "verseOrgIds": [
              "DAN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake atoning'o nanu nchere indim iyie atolimu nkibalakinot niwuang'ie enyamali. Ore naa taata ti nindim iyie aisoma ele kigeroto nikintayiolo nanu enkibalakinoto, nikinchopokini olkila sintet, nikipiki olpisiai le sahabu aaitaman emurt ino, niaaku oliokuni oitoreisho te nkitoria.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newal Daniel te dukuya olaiguanani ajo, “Nchoo nkishorot inono eaku nkuninono, naa nchoo nena kishorot inono likae; ore ake eyia kaisomaki nanu olaiguanani ilo kigeroto naitayiolo ninye enkibalakinoto e ilo kigeroto. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "La aiguanani, eishoo Enkai kitok oleng Nebukadnesa, papaai lino enkitoria o enkisisa o esikar; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
            "verseOrgIds": [
              "DAN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa ore enkaraki ina kitoo naishoo Enkai ninye eikirikirate iltung'ana pooki, o loreren, o lng'ejepa neureishoyu te dukuya ninye; ore oloyieu near metua near metua; ore oloyieu neitopok neitopok; ore ilo oyieu neilepie, neilepie, ore oloyieu neitadou neitadou. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.19",
            "verseOrgIds": [
              "DAN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore ake pee eilepunye oltau lenye neitagol oltau metaa keasisho to lwuasa neiwuang'ieki ninye te ilo orika lenye le nkitoo, neyae enkitoo enye aaitung'uaa ninye; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.20",
            "verseOrgIds": [
              "DAN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nerei ninye aitung'uaa iltung'ana, neitotiuni ndamunot enyena anaa ineng'ues, ore emanyisho enye neaku te nebo isirkon le ntim; neitoti ninye too nkujit anaa olkiteng, neshalu osesen lenye te nkoliolio e shumata, o metaba anaa neyiolou ninye nchere Ina Ai natii shumata aisul naitore enkitoria e tung'ana, nepik shumata ninye ilo oyieu ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.21",
            "verseOrgIds": [
              "DAN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ore iyie, olayioni lenye, Belshasa, eitu intobor oltau lino hoo niyiolo kuna pooki, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
            "verseOrgIds": [
              "DAN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake ilepunye kewan nigilunore Olaitoriani le shumata; ore nena masaa e nkaji enye neitijing'uaki aayau dukuya iyie, ore iyie o lkituaak linono, o nkituaak inono o nkapiak inono nitookie ninche enaisho oo sabibu, nirrepirrepe intae nena aitin e nkosholai o nesahabu o nosuyai, o nesekenkei, o nenchata, o nosoit, nena nemedolisho aashu ening'isho aashu eyiolo, kake ore ina Ai naa enkaina enye etii enkiyang'et ino netii inkoitoi inono pooki neitu iyie iyanyit.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.23",
            "verseOrgIds": [
              "DAN.5.23"
            ]
          }
        }
      ]
    },
