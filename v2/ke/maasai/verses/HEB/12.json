              "type": "text"
            }
          ]
        },
        {
          "text": "Kake Oldoinyo le Sion ietuo intae o enkanasa e Enkai naishu, Yerusalem e keper, o enetii ilmalaika lemeikenayu ooiturrurro eikodoki, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
