          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nietuo eumata oo lkikaunot ooigero te shumata, nietuo enetii olarishani laa ninye Enkai e pooki; o enetii inkiyang'eta oo ltung'ana sinyat ooitabayioki, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
