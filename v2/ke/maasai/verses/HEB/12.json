          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ena bae najo aigil ena nabo, neitodolu inchere keiwuang'ieki ina apa naikirikirieki, neitodulu ena entoki naitobiraki, pee eing'uari ina nemeikirikirieki. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkaraki ina emanoto iyiook enashe kitang'amutua enkitoria nemeidimi aaigusugusie, naa emaishoo Enkai eseremata nang'amaroyu, natii enkanyit o lturiaki; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
              "HEB.12.28"
            ]
          }
