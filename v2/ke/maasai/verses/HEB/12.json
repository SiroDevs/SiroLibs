              "items": [
                {
                  "text": "5.22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu mme doi entoki naiseyieki ietuo enetii, enkima nayupuyup, o enaimin o entoki naitureisho, o lkutati, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ltoilo le ntarumpeta o ltoilo laa ore nkirorot enyena neitureita lelo apa ootoning'o metasaisho aajo pee meitokini aaigilie kulie kirorot. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.12+EXO.19.13"
              },
              "items": [
                {
                  "text": "Ena 19.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu meitieu apa ninche aating'iria enkitoria naishooki, “Te neiseyie ninye eng'ues ele doinyio, neari too soito.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
