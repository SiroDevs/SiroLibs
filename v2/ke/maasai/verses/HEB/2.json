              },
              "items": [
                {
                  "text": "Olke 22.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ejo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        }
