          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.16",
            "verseOrgIds": [
              "HEB.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkaraki e ina pee eishooki metotiwuo anaa lalashera lenyena too mpukunot pooki, pee etum ataa olapolosani oata olng'ur neisiligayu te siaai e Enkai, netum aitayu enkitukuoroto oo ng'ok oo ltung'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.17",
            "verseOrgIds": [
              "HEB.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore enkaraki natamio ninye makewan netetemaki, ekeidim ninye atareto lelo ootemi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.18",
            "verseOrgIds": [
              "HEB.2.18"
            ]
          }
        }
