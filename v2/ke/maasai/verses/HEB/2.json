          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore naa enkaraki nang'ar nkera nkiri o sarge, etang'arie sii ninye makewan ina pukunoto, paa te keeya etum ninye aitarruoi ilo oata engolon e nkeeya, aa ninye Sheitani, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.14",
            "verseOrgIds": [
              "HEB.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "netum atokordu lelo pooki ooena te nkishui enye pooki enkaraki naure enkeeya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.15",
            "verseOrgIds": [
              "HEB.2.15"
            ]
          }
        }
      ]
    },
