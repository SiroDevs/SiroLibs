          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu esipa nchere mme lmalaika doi eimaki kake eishoi e Abraham.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.16",
            "verseOrgIds": [
              "HEB.2.16"
            ]
          }
        }
